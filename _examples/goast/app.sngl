component main {
    var (
        source = "package main"
        nodes list<string> = null
        parseError = ""
        parseGoAST func(string) -> list<string> extern
    )

    vbox(style={gap=12, padding=16}) {
        text(value="Go AST Explorer", style={fontSize=24, fontWeight="bold"})
        text(value="Enter Go source code and click Parse to see the AST.")
        textarea(placeholder="Enter Go code...", rows=10, value=source, @input={ source = event.value })
        button(text="Parse AST", @click={ nodes = parseGoAST(source) })
        if parseError != "" {
            text(value=parseError, style={color=#c62828})
        }
        vbox(style={gap=2}) {
            for node in nodes {
                text(value=node, style={fontSize=13})
            }
        }
    }
}
