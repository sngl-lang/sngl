{
  "name": "SNGL",
  "scopeName": "source.sngl",
  "fileTypes": ["sngl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#import" },
    { "include": "#component-declaration" },
    { "include": "#struct-declaration" },
    { "include": "#enum-declaration" },
    { "include": "#unit-declaration" },
    { "include": "#style-declaration" },
    { "include": "#output-declaration" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#colors" },
    { "include": "#events" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sngl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sngl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "import": {
      "match": "\\b(import)\\s+(\"[^\"]*\")",
      "captures": {
        "1": { "name": "keyword.control.import.sngl" },
        "2": { "name": "string.quoted.double.sngl" }
      }
    },
    "component-declaration": {
      "match": "\\b(component)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.component.sngl" },
        "2": { "name": "entity.name.type.component.sngl" }
      }
    },
    "struct-declaration": {
      "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.struct.sngl" },
        "2": { "name": "entity.name.type.struct.sngl" }
      }
    },
    "enum-declaration": {
      "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.enum.sngl" },
        "2": { "name": "entity.name.type.enum.sngl" }
      }
    },
    "unit-declaration": {
      "match": "\\b(unit)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.unit.sngl" },
        "2": { "name": "entity.name.type.unit.sngl" }
      }
    },
    "style-declaration": {
      "match": "\\b(style|styles)\\b",
      "name": "keyword.declaration.style.sngl"
    },
    "output-declaration": {
      "match": "\\b(output)\\b",
      "name": "keyword.declaration.output.sngl"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.sngl",
          "match": "\\b(param|var|const|computed|prop|event|children)\\b"
        },
        {
          "name": "keyword.control.sngl",
          "match": "\\b(if|for|in)\\b"
        },
        {
          "name": "keyword.other.sngl",
          "match": "\\b(extern|trigger|func)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sngl",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.sngl",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sngl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sngl",
          "match": "\\\\[nrt\"\\\\{]"
        },
        {
          "name": "meta.interpolation.sngl",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.sngl" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.sngl" }
          },
          "patterns": [
            { "include": "#constants" },
            { "include": "#numbers" },
            { "include": "#operators" },
            { "include": "#identifiers" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.unit.sngl",
          "match": "-?[0-9]+(\\.[0-9]+)?[a-zA-Z]+"
        },
        {
          "name": "constant.numeric.float.sngl",
          "match": "-?[0-9]+\\.[0-9]+"
        },
        {
          "name": "constant.numeric.integer.sngl",
          "match": "-?[0-9]+"
        }
      ]
    },
    "colors": {
      "name": "constant.other.color.sngl",
      "match": "#[0-9a-fA-F]{3,8}"
    },
    "events": {
      "match": "(@)([a-zA-Z_][a-zA-Z0-9_-]*)",
      "captures": {
        "1": { "name": "punctuation.definition.event.sngl" },
        "2": { "name": "entity.other.attribute-name.event.sngl" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.sngl",
          "match": "[+\\-*/%]?="
        },
        {
          "name": "keyword.operator.comparison.sngl",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.sngl",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.sngl",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.toggle.sngl",
          "match": "!!"
        },
        {
          "name": "keyword.operator.ternary.sngl",
          "match": "[?:]"
        },
        {
          "name": "keyword.operator.arrow.sngl",
          "match": "->"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.sngl",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.sngl",
          "match": "\\."
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\(|\\{)",
          "captures": {
            "1": { "name": "entity.name.tag.sngl" }
          }
        },
        {
          "match": "([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(?==)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.sngl" }
          }
        },
        {
          "match": "\\b([a-z][a-zA-Z0-9_-]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.sngl" }
          }
        }
      ]
    }
  }
}
