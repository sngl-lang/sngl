A test reaching through a library component the program renders at several
sites reaches that site's copy. TestTestReachLibrarySitesRun runs it on all six
targets; sngl:blip is handed to the check as library source, which a script
cannot do.

-- blip.sngl --
import ui "sngl:ui"

component badge(label string) ui.node {
    var hits = 0
    func reset() {
        hits = 0
    }
    ui.text #shown(value="{label}:{hits}")
    ui.button #hit(text="hit", @click {
        hits = hits + 1
    })
}
-- main.sngl --
import ui "sngl:ui"
import test "sngl:test"
import blip "sngl:blip"

component main ui.node {
    var show = true
    var names list[string] = ["x", "y"]
    ui.vbox {
        if show {
            blip.badge #a(label="a")
        }
        blip.badge #b(label="b")
        for var n = names {
            blip.badge #r(label=n)
        }
    }
}

func testSites(t test.Test, c main) {
    if c.a != null {
        c.a.hit.click()
        t.assert(c.a.hits == 1)
    }
    c.b.reset()
    t.assert(c.b.shown.value == "b:0")
    c.r[1].hit.click()
    t.assert(c.r[1].hits == 1)
}

ui.window {
    main
}
