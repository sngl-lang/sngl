import . "sngl:ui"
import nav "sngl:ui/nav"

// docbrowser drives `sngl doc --tui` and `sngl doc --http`. Bubbletea
// renders the top-level main body; html route mode serves a route per page of
// the stack inside the `platform html` guard. State (path + up to two
// idents) is local to main — lookup re-runs on every render.
output {
    go {
        bubbletea(package="docbrowser")
        html(package="docbrowser")
    }
}

import "go:git.duckfam.us/jonathan/sngl/docs/lookup"
import "../docui"
import "sngl:platform/html"

// The route parameters each page takes. A page's params all travel in its
// path, so each struct names what its path does.
struct PkgParams {
    pkg string
}

struct DeclParams {
    pkg string
    name string
}

var path = "sngl"
var ident1 = ""
var ident2 = ""
func entry() => lookup.Resolve(path, ident1, ident2)
if PLATFORM == html.platform {
    window(title=pages.current.title) {
        nav.stack #pages {
            nav.page #home(href="/", title="SNGL Docs") {
                hbox {
                    docui.Sidebar(homeHref="/") {
                        for var p = lookup.Packages() {
                            docui.NavItem(text=p.title, href="/p/" + p.path)
                        }
                    }
                    vbox(style={padding=24px, flex=1}) {
                        text(
                            value="SNGL Documentation",
                            style={fontSize=28px, fontWeight=bold},
                        )
                        docui.EntryView(path="sngl")
                    }
                }
            }

            nav.page #pkg(href=`/p/{pkg}`, title="Package — SNGL Docs", params=PkgParams{}) {
                component content(v) {
                    hbox {
                        docui.Sidebar(homeHref="/") {
                            for var p = lookup.Packages() {
                                docui.NavItem(
                                    text=p.title,
                                    href="/p/" + p.path,
                                    active=p.path == v.pkg,
                                )
                            }
                        }
                        vbox(style={padding=24px, flex=1}) {
                            docui.EntryView(path=v.pkg, hrefPrefix="/p/" + v.pkg + "/")
                        }
                    }
                }
            }

            nav.page #decl(href=`/p/{pkg}/{name}`, title="Decl — SNGL Docs", params=DeclParams{}) {
                component content(v) {
                    hbox {
                        docui.Sidebar(homeHref="/") {
                            for var p = lookup.Packages() {
                                docui.NavItem(
                                    text=p.title,
                                    href="/p/" + p.path,
                                    active=p.path == v.pkg,
                                )
                            }
                        }
                        vbox(style={padding=24px, flex=1}) {
                            docui.EntryView(
                                path=v.pkg,
                                ident1=v.name,
                                hrefPrefix="/p/" + v.pkg + "/",
                            )
                        }
                    }
                }
            }
        }
    }
} else {
    // The TUI has one window, which is the whole terminal.
    window(title="SNGL Docs") {
        // TUI body — single full-width page. The top row is the navigation bar
        // (three bound inputs); below it we render whatever the current Entry
        // resolves to. No sidebar.
        vbox(style={padding=1px}) {
            hbox(style={gap=1px}) {
                input(:value=path, placeholder="import path")
                input(:value=ident1, placeholder="decl")
                input(:value=ident2, placeholder="field/prop")
            }

            if !entry().found && entry().error != "" {
                vbox {
                    text(value="Not found", style={fontWeight=bold})
                    text(value=entry().error, style={color="#888"})
                }
            }

            if entry().kind == "index" {
                vbox {
                    text(value=entry().index.title, style={fontWeight=bold})
                    text(value=entry().index.description, style={color="#aaa"})
                    if entry().index.isNative && entry().index.nativeImportPath != "" {
                        text(
                            value="Import: " + entry().index.nativeImportPath,
                            style={color="#888", fontFamily="monospace"},
                        )
                    }
                    text(value="")

                    text(value="COMPONENTS", style={fontWeight=bold, color="#888"})
                    for var c = entry().index.components {
                        text(value="  " + c.name + " — " + c.doc)
                    }

                    text(value="")
                    text(value="TYPES", style={fontWeight=bold, color="#888"})
                    for var t = entry().index.types {
                        text(value="  " + t.name + " — " + t.doc)
                    }

                    text(value="")
                    text(value="ENUMS", style={fontWeight=bold, color="#888"})
                    for var e = entry().index.enums {
                        text(value="  " + e.name + " — " + e.doc)
                    }

                    text(value="")
                    text(value="FUNCTIONS", style={fontWeight=bold, color="#888"})
                    for var f = entry().index.functions {
                        text(value="  " + f.name + " — " + f.doc)
                    }

                    text(value="")
                    text(value="CONSTANTS", style={fontWeight=bold, color="#888"})
                    for var c = entry().index.constants {
                        text(value="  " + c.name + " — " + c.doc)
                    }

                    text(value="")
                    text(value="DATA", style={fontWeight=bold, color="#888"})
                    for var d = entry().index.data {
                        text(value="  " + d.name + " — " + d.doc)
                    }
                }
            }

            if entry().kind == "component" {
                vbox {
                    text(value=entry().componentDoc.name, style={fontWeight=bold})
                    text(value=entry().componentDoc.doc)
                    text(value="PROPS", style={fontWeight=bold, color="#888"})
                    for var p = entry().componentDoc.props {
                        text(value="  " + p.name + "  " + p.type + "  " + p.doc)
                    }
                    text(value="SLOTS", style={fontWeight=bold, color="#888"})
                    for var sl = entry().componentDoc.slots {
                        text(value="  " + sl.name + "  " + sl.type)
                    }
                    text(value="EVENTS", style={fontWeight=bold, color="#888"})
                    for var e = entry().componentDoc.events {
                        text(value="  @" + e.name + "  " + e.payload)
                    }
                }
            }

            if entry().kind == "type" {
                vbox {
                    text(value=entry().typeDoc.name, style={fontWeight=bold})
                    text(value=entry().typeDoc.doc)
                    text(value="FIELDS", style={fontWeight=bold, color="#888"})
                    for var f = entry().typeDoc.fields {
                        text(value="  " + f.name + "  " + f.type)
                    }
                    text(value="METHODS", style={fontWeight=bold, color="#888"})
                    for var m = entry().typeDoc.methods {
                        text(value="  ." + m.short + "  " + m.doc)
                    }
                }
            }

            if entry().kind == "enum" {
                vbox {
                    text(value=entry().enumDoc.name, style={fontWeight=bold})
                    text(value=entry().enumDoc.doc)
                    for var m = entry().enumDoc.members {
                        text(value="  • " + m.name)
                    }
                }
            }

            if entry().kind == "func" {
                vbox {
                    text(value=entry().funcDoc.name, style={fontWeight=bold})
                    text(value=entry().funcDoc.signature, style={fontFamily="monospace"})
                    text(value=entry().funcDoc.doc)
                }
            }

            if entry().kind == "value" {
                vbox {
                    text(value=entry().valueDoc.name, style={fontWeight=bold})
                    text(value=entry().valueDoc.type, style={color="#888"})
                    text(value=entry().valueDoc.doc)
                }
            }

            if entry().kind == "prop" {
                vbox {
                    text(
                        value=entry().propDoc.componentName + "." + entry().propDoc.name,
                        style={fontWeight=bold},
                    )
                    text(value=entry().propDoc.type)
                    text(value=entry().propDoc.doc)
                }
            }

            if entry().kind == "field" {
                vbox {
                    text(
                        value=entry().fieldDoc.type + "." + entry().fieldDoc.name,
                        style={fontWeight=bold},
                    )
                    text(value=entry().fieldDoc.expr)
                }
            }

            if entry().kind == "member" {
                vbox {
                    text(
                        value=entry().memberDoc.enumName + "." + entry().memberDoc.name,
                        style={fontWeight=bold},
                    )
                    text(value=entry().memberDoc.doc)
                }
            }
        }

        // HTTP route mode (sngl doc --http). docui.EntryView + Sidebar handle
        // cross-platform styling for the web surface.
    }
}
