output {
    go {
        bubbletea(package="docbrowser")
        http(package="docbrowser")
    }
}

import "go://git.duckfam.us/jonathan/sngl/docs"
import "../docui"

component main {
    var selectedIndex = 0

    func currentName() => docs.Components()[selectedIndex].name
    func currentDoc() => docs.Components()[selectedIndex].doc
    func currentTier() => docs.Components()[selectedIndex].tier
    func currentChildren() => docs.Components()[selectedIndex].children

    // TUI layout (used by bubbletea)
    hbox {
        vbox(style={width=200, padding=8}) {
            text(value="SNGL Components", style={fontWeight="bold"})
            text(value="")
            for comp, index = docs.Components() {
                text(value=index == selectedIndex ? "> " + comp.name : "  " + comp.name)
            }
        }
        vbox(style={padding=8}) {
            text(value=currentName, style={fontWeight="bold"})
            text(value="[" + currentTier() + "]")
            text(value="")
            text(value=currentDoc)
            text(value="")
            text(value="Children: " + currentChildren())
        }
    }

    // HTTP routes (used by http platform)
    window index(title="SNGL Documentation", href="/") {
        hbox {
            docui.Sidebar {
                for comp = docs.Components() {
                    docui.NavItem(text=comp.name, href="/" + comp.name)
                }
            }
            vbox(style={padding=24, gap=16}) {
                text(value="SNGL Documentation", style={fontSize=24, fontWeight="bold"})
                text(value="Select a component from the sidebar.")
            }
        }
    }

    window detail(title="Component — SNGL Docs", href="/{name}") {
        hbox {
            docui.Sidebar {
                for comp = docs.Components() {
                    docui.NavItem(text=comp.name, href="/" + comp.name, active=comp.name == name)
                }
            }
            vbox(style={padding=24}) {
                docui.Detail(name=name)
            }
        }
    }
}
