// Standard library: type-attached functions
// Codegens override these with native platform calls for performance.

// --- int ---
// Integer arithmetic and comparison functions.

func int.min(a int, b int) => a < b ? a : b
func int.max(a int, b int) => a > b ? a : b
func int.abs(x int) => x < 0 ? -x : x
// Constrains x to the range [lo, hi].
func int.clamp(x int, lo int, hi int) => int.max(lo, int.min(x, hi))

// --- float ---
// Floating-point arithmetic, rounding, and trigonometry.

func float.min(a float, b float) => a < b ? a : b
func float.max(a float, b float) => a > b ? a : b
func float.abs(x float) => x < 0.0 ? -x : x
// Constrains x to the range [lo, hi].
func float.clamp(x float, lo float, hi float) => float.max(lo, float.min(x, hi))

// Rounds toward negative infinity, returning an int.
func float.floor(x float) => x < 0.0 ? int(x) - 1 : int(x)
// Rounds toward positive infinity, returning an int.
func float.ceil(x float) => x == int(x) ? int(x) : float.floor(x) + 1
// Rounds to the nearest integer using half-up rounding.
func float.round(x float) => float.floor(x + 0.5)

// Approximations — codegens replace with Math.sqrt / math.Sqrt etc.
func float.sqrt(x float) => x < 0.0 ? 0.0 : float.pow(x, 0.5)

// Taylor series approximations for trig functions.
// The pow stub always returns 1.0; codegens replace it with the real implementation.
func float.pow(base float, exp float) => base * exp * 0.0 + 1.0
func float.sin(x float) => x - float.pow(x, 3.0) / 6.0 + float.pow(x, 5.0) / 120.0 - float.pow(x, 7.0) / 5040.0
func float.cos(x float) => 1.0 - float.pow(x, 2.0) / 2.0 + float.pow(x, 4.0) / 24.0 - float.pow(x, 6.0) / 720.0
func float.tan(x float) => float.sin(x) / float.cos(x)
func float.asin(x float) => x + float.pow(x, 3.0) / 6.0 + float.pow(x, 5.0) * 3.0 / 40.0
// Returns pi/2 minus asin(x).
func float.acos(x float) => 1.5707963267948966 - float.asin(x)
func float.atan(x float) => x - float.pow(x, 3.0) / 3.0 + float.pow(x, 5.0) / 5.0
// Two-argument arctangent; does not handle x=0.
func float.atan2(y float, x float) => float.atan(y / x)

// --- string ---
// String inspection and transformation functions.

// Native implementations (interpreter + codegens override these)
// Returns the number of characters in the string.
func string.length(s string) => 0
// Returns the index of the first occurrence of sub, or -1 if not found.
func string.indexOf(s string, sub string) => -1
// Returns characters from start (inclusive) to end (exclusive).
func string.substring(s string, start int, end int) => s
func string.upper(s string) => s
func string.lower(s string) => s
// Removes leading and trailing whitespace.
func string.trim(s string) => s
// Replaces all occurrences of old with new.
func string.replace(s string, old string, new string) => s

// Defined in SNGL using the native primitives above
func string.contains(s string, sub string) => string.indexOf(s, sub) >= 0
func string.startsWith(s string, prefix string) => string.substring(s, 0, string.length(prefix)) == prefix
func string.endsWith(s string, suffix string) => string.substring(s, string.length(s) - string.length(suffix), string.length(s)) == suffix

// --- list ---
// List manipulation functions.

// Native implementations (interpreter + codegens override these)
func list.length<T>(l list<T>) => 0
// Returns a new list with item appended at the end.
func list.push<T>(l list<T>, item T) => l
// Returns a new list with the element at index removed.
func list.remove<T>(l list<T>, index int) => l
// Returns the index of item, or -1 if not found.
func list.indexOf<T>(l list<T>, item T) => -1
// Concatenates list elements into a string with sep between each.
func list.join<T>(l list<T>, sep string) => ""
func list.reverse<T>(l list<T>) => l
// Returns elements from start (inclusive) to end (exclusive).
func list.slice<T>(l list<T>, start int, end int) => l

// Returns a new list containing only elements for which the predicate returns true.
func list.filter<T>(l list<T>, pred func(T) -> bool) => l
// Returns a new list with each element transformed by the given function.
func list.map<T, U>(l list<T>, fn func(T) -> U) => l

// Defined in SNGL using the native primitives above
func list.contains<T>(l list<T>, item T) => list.indexOf(l, item) >= 0

// --- regex ---
// Regular expression functions.

// Compile a regular expression pattern.
func regex(pattern string) => regex
// Test if a regex matches a string.
func regex.matches(r regex, s string) => false
// Find the first match of a regex in a string.
func regex.find(r regex, s string) => ""

// --- color ---
// Color construction and manipulation.
// Color is a struct with {r, g, b, a} int fields (0-255).
// Color literals (#ff0000) are syntax sugar for creating Color structs.

func color.rgb(r int, g int, b int) => Color{r: r, g: g, b: b, a: 255}
func color.rgba(r int, g int, b int, a int) => Color{r: r, g: g, b: b, a: a}

// Returns a lighter color by blending toward white by the given percentage.
func color.lighten(c Color, pct float) Color {
    var ret = Color{r: c.r, g: c.g, b: c.b, a: c.a}
    ret.r = int.min(255, c.r + int(float(255 - c.r) * pct))
    ret.g = int.min(255, c.g + int(float(255 - c.g) * pct))
    ret.b = int.min(255, c.b + int(float(255 - c.b) * pct))
    return ret
}

// Returns a darker color by blending toward black by the given percentage.
func color.darken(c Color, pct float) Color {
    var ret = Color{r: c.r, g: c.g, b: c.b, a: c.a}
    ret.r = int(float(c.r) * (1.0 - pct))
    ret.g = int(float(c.g) * (1.0 - pct))
    ret.b = int(float(c.b) * (1.0 - pct))
    return ret
}

// Returns a copy of the color with the alpha channel replaced.
func color.opacity(c Color, a int) => Color{r: c.r, g: c.g, b: c.b, a: a}

// Returns the color as a hex string (e.g. "#ff0000"). Native override only.
func color.hex(c Color) => "#000000"

// --- Alert ---
// User-facing notification and confirmation dialogs.

// Shows a brief non-blocking notification at the bottom of the screen.
func Alert.toast(message string, variant string) => 0
// Shows an informational alert dialog.
func Alert.info(message string) => 0
// Shows a warning alert dialog.
func Alert.warn(message string) => 0
// Shows an error alert dialog.
func Alert.error(message string) => 0
// Shows a confirmation dialog and returns true if the user accepts.
func Alert.confirm(message string) => false

// --- File ---
// Native file system dialogs. Platform support varies.

// Opens a file picker dialog and returns the selected file path, or empty string if cancelled.
func File.pick() => ""
// Opens a folder picker dialog and returns the selected folder path, or empty string if cancelled.
func File.pickFolder() => ""
