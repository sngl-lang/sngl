// --- Core ---

// Vertical box layout container. Children are stacked top to bottom.
component vbox(
    style Style,
    scroll bool,
    refreshing bool,
    @refresh RefreshEvent,
) list<component> {}

// Horizontal box layout container. Children are placed side by side.
component hbox(
    style Style,
    scroll bool,
) list<component> {}

// Layered container where children overlap.
component stack(
    style Style,
) list<component> {}

// Displays a text string.
component text(
    style Style,
    value string,
    selectable bool,
    @click ClickEvent,
) {}

// Clickable button that triggers an action.
component button(
    style Style,
    text string,
    disabled bool,
    @click ClickEvent,
    @longPress LongPressEvent,
) list<component> {}

// Single-line text input field.
component input(
    style Style,
    :value string,
    placeholder string,
    disabled bool,
    readonly bool,
    type string,
    maxLength int,
    @input InputEvent,
    @change ChangeEvent,
    @focus FocusEvent,
    @blur FocusEvent,
    @submit SubmitEvent,
) {}

// Displays an image from a URL or asset path.
component image(
    style Style,
    src string,
    alt string,
    fit ObjectFit,
    @click ClickEvent,
    @load LoadEvent,
    @error ErrorEvent,
) {}

// Scrollable viewport.
component scroll(
    style Style,
    direction string,
    scrollX float,
    scrollY float,
    showScrollbar string,
    @scroll ScrollEvent,
    @scrollEnd ScrollEvent,
) component {}

// Flexible empty space.
component spacer(
    style Style,
    size string,
) {}

// Boolean toggle rendered as a checkmark box.
component checkbox(
    style Style,
    :checked bool,
    label string,
    disabled bool,
    @change ChangeEvent,
) {}

// Placeholder for projected content in custom component definitions.
component slot() {}

// Periodic callback.
component timer(
    interval duration,
    enabled bool,
    @tick,
) {}

// --- Input ---

// Group of mutually exclusive options.
component radio(
    style Style,
    value string,
    options list<string>,
    disabled bool,
    direction string,
    @change ChangeEvent,
) {}

// On/off switch control.
component toggle(
    style Style,
    :checked bool,
    label string,
    disabled bool,
    @change ChangeEvent,
) {}

// Dropdown selection control.
component select(
    style Style,
    :value string,
    options list<string>,
    placeholder string,
    disabled bool,
    multiple bool,
    @change ChangeEvent,
    @focus FocusEvent,
    @blur FocusEvent,
) {}

// Multi-line text input field.
component textarea(
    style Style,
    :value string,
    placeholder string,
    disabled bool,
    readonly bool,
    rows int,
    maxLength int,
    @input InputEvent,
    @change ChangeEvent,
    @focus FocusEvent,
    @blur FocusEvent,
) {}

// --- Feedback & Navigation ---

// Determinate progress indicator.
component progress(
    style Style,
    value float,
    max float,
    label string,
    variant string,
    showValue bool,
) {}

// Indeterminate loading indicator.
component spinner(
    style Style,
    label string,
    variant string,
    size string,
) {}

// Small status label.
component badge(
    style Style,
    value string,
    variant string,
    size string,
) {}

// Tabbed navigation.
component tabs(
    style Style,
    items list<string>,
    selected int,
    variant string,
    @change SelectEvent,
) list<component> {}

// Navigational hyperlink.
component link(
    style Style,
    href string,
    text string,
    target string,
    disabled bool,
    @click ClickEvent,
) {}

// Visual separator line.
component divider(
    style Style,
    direction string,
    label string,
) {}

// --- Overlays & Layout ---

// Dialog overlay.
component modal(
    style Style,
    open bool,
    title string,
    closable bool,
    size string,
    @close DismissEvent,
) list<component> {}

// Slide-out panel.
component drawer(
    style Style,
    open bool,
    side string,
    size string,
    @close DismissEvent,
) list<component> {}

// Informational popup on hover or focus.
component tooltip(
    style Style,
    text string,
    position string,
    delay int,
) component {}

// Floating content panel.
component popover(
    style Style,
    open bool,
    position string,
    openOn string,
    @close DismissEvent,
) list<component> {}

// Expandable/collapsible sections.
component accordion(
    style Style,
    items list<string>,
    expanded list<int>,
    multiple bool,
    @change ExpandEvent,
) list<component> {}

// Resizable two-pane layout.
component splitview(
    style Style,
    direction string,
    position float,
    minPosition float,
    maxPosition float,
    resizable bool,
    @resize ResizeEvent,
) list<component> {}

// --- Data & Desktop ---

// Tabular data display.
component table(
    style Style,
    columns list<string>,
    rows dyn,
    selectable bool,
    selected int,
    sortable bool,
    sortColumn string,
    sortDirection string,
    @select SelectEvent,
    @sort ChangeEvent,
) {}

// Hierarchical data display.
component tree(
    style Style,
    items list<string>,
    selected string,
    expanded list<int>,
    @select SelectEvent,
    @expand ExpandEvent,
) {}

// Context or dropdown menu.
component menu(
    style Style,
    items list<string>,
    open bool,
    @select MenuEvent,
    @close DismissEvent,
) {}

// Horizontal menu bar.
component menubar(
    style Style,
    items list<string>,
    @select MenuEvent,
) {}

// Horizontal bar of action buttons.
component toolbar(
    style Style,
    items list<string>,
    @select MenuEvent,
) list<component> {}

// --- Mobile & Specialized ---

// Calendar-based date selection.
component datepicker(
    style Style,
    value date,
    min date,
    max date,
    disabled bool,
    placeholder string,
    @change DateEvent,
    @focus FocusEvent,
    @blur FocusEvent,
) {}

// Compact interactive tag.
component chip(
    style Style,
    label string,
    variant string,
    removable bool,
    selected bool,
    disabled bool,
    @click ClickEvent,
    @remove DismissEvent,
) {}

// User profile image with fallback.
component avatar(
    style Style,
    src string,
    alt string,
    initials string,
    size string,
    variant string,
    @click ClickEvent,
) {}

// Styled container for grouping related content.
component card(
    style Style,
    variant string,
    clickable bool,
    @click ClickEvent,
) list<component> {}

// --- Examples ---

component example_vbox {
    vbox(style={gap=8, padding=16}) {
        text(value="First")
        text(value="Second")
        text(value="Third")
    }
}

component example_hbox {
    hbox(style={gap=8, padding=16}) {
        text(value="Left")
        text(value="Center")
        text(value="Right")
    }
}

component example_stack {
    stack {
        text(value="Behind", style={padding=16})
        text(value="In front", style={padding=32, color=#FF0000})
    }
}

component example_text {
    vbox(style={gap=8, padding=16}) {
        text(value="Hello, World!", style={fontSize=24, fontWeight="bold"})
        text(value="Regular text")
        text(value="Colored text", style={color=#0066CC})
    }
}

component example_button {
    var count = 0
    vbox(style={gap=8, padding=16}) {
        hbox(style={gap=8}) {
            button(text="Click me", @click { count += 1 })
            button(text="Reset", @click { count = 0 })
            button(text="Disabled", disabled=true)
        }
        text(value="Clicked " + string(count) + " times")
    }
}

component example_input {
    var name = ""
    vbox(style={gap=8, padding=16}) {
        input(placeholder="Enter your name", value=name, @input(e) { name = e.value })
        input(placeholder="Password", type="password")
        input(placeholder="Search...", type="search")
        text(value="Hello, " + name)
    }
}

component example_image {
    vbox(style={gap=8, padding=16}) {
        image(src="https://placehold.co/200x100", alt="Placeholder image", fit="contain")
    }
}

component example_scroll {
    scroll(direction="vertical", style={height=120}) {
        vbox(style={gap=4, padding=8}) {
            text(value="Line 1")
            text(value="Line 2")
            text(value="Line 3")
            text(value="Line 4")
            text(value="Line 5")
            text(value="Line 6")
            text(value="Line 7")
            text(value="Line 8")
        }
    }
}

component example_spacer {
    hbox(style={padding=16}) {
        text(value="Left")
        spacer
        text(value="Right")
    }
}

component example_checkbox {
    var darkMode = false
    vbox(style={gap=8, padding=16}) {
        checkbox(checked=darkMode, label="Dark mode", @change { darkMode!! })
        text(value=darkMode ? "Dark mode on" : "Dark mode off")
    }
}

component example_radio {
    var size = "medium"
    vbox(style={gap=8, padding=16}) {
        radio(options=["small", "medium", "large"], value=size, direction="horizontal")
        text(value="Selected: " + size)
    }
}

component example_toggle {
    var notifications = false
    vbox(style={gap=8, padding=16}) {
        toggle(checked=notifications, label="Notifications", @change { notifications!! })
        text(value=notifications ? "Enabled" : "Disabled")
    }
}

component example_select {
    var fruit = ""
    vbox(style={gap=8, padding=16}) {
        select(options=["Apple", "Banana", "Cherry"], placeholder="Pick a fruit", value=fruit)
        text(value="Selected: " + fruit)
    }
}

component example_textarea {
    var notes = ""
    vbox(style={gap=8, padding=16}) {
        textarea(placeholder="Write some notes...", rows=4, value=notes, @input(e) { notes = e.value })
        text(value="Length: " + string(notes.length()))
    }
}

component example_progress {
    vbox(style={gap=8, padding=16}) {
        progress(value=0.7, max=1, label="70% complete", showValue=true)
        progress(value=3, max=10)
    }
}

component example_spinner {
    hbox(style={gap=16, padding=16, alignItems="center"}) {
        spinner(label="Loading...")
        spinner(variant="circle", size="large")
    }
}

component example_badge {
    hbox(style={gap=8, padding=16, alignItems="center"}) {
        badge(value="3", variant="primary")
        badge(value="New", variant="success")
        badge(value="Error", variant="error")
    }
}

component example_tabs {
    var selected = 0
    vbox(style={padding=16}) {
        tabs(items=["Overview", "Details", "Settings"], selected=selected) {
            text(value="Overview content")
            text(value="Detail content")
            text(value="Settings content")
        }
    }
}

component example_link {
    hbox(style={gap=16, padding=16}) {
        link(href="https://example.com", text="Example Site")
        link(href="https://example.com", text="New Tab", target="blank")
    }
}

component example_divider {
    vbox(style={gap=8, padding=16}) {
        text(value="Section 1")
        divider
        text(value="Section 2")
        divider(label="OR")
        text(value="Section 3")
    }
}

component example_modal {
    var showModal = false
    vbox(style={padding=16}) {
        button(text="Open Modal", @click { showModal = true })
        modal(open=showModal, title="Example Modal", closable=true) {
            text(value="Modal content goes here.")
            button(text="Close", @click { showModal = false })
        }
    }
}

component example_drawer {
    var showDrawer = false
    vbox(style={padding=16}) {
        button(text="Open Drawer", @click { showDrawer = true })
        drawer(open=showDrawer, side="right") {
            vbox(style={gap=8, padding=16}) {
                text(value="Drawer Content", style={fontWeight="bold"})
                button(text="Close", @click { showDrawer = false })
            }
        }
    }
}

component example_tooltip {
    vbox(style={padding=16}) {
        tooltip(text="This is a tooltip") {
            button(text="Hover me")
        }
    }
}

component example_popover {
    var showPop = false
    vbox(style={padding=16}) {
        popover(open=showPop, position="bottom", openOn="click") {
            button(text="Toggle", @click { showPop!! })
        }
    }
}

component example_accordion {
    vbox(style={padding=16}) {
        accordion(items=["Section 1", "Section 2", "Section 3"]) {
            text(value="Content for section 1")
            text(value="Content for section 2")
            text(value="Content for section 3")
        }
    }
}

component example_splitview {
    splitview(direction="horizontal", style={height=120}) {
        vbox(style={padding=12}) {
            text(value="Left pane")
        }
        vbox(style={padding=12}) {
            text(value="Right pane")
        }
    }
}

component example_table {
    vbox(style={padding=16}) {
        table(columns=["Name", "Role", "Status"])
    }
}

component example_tree {
    vbox(style={padding=16}) {
        tree(items=["Documents", "Photos", "Music", "Videos"])
    }
}

component example_menu {
    var showMenu = false
    vbox(style={padding=16}) {
        button(text="Show Menu", @click { showMenu = true })
        menu(items=["Cut", "Copy", "Paste"], open=showMenu)
    }
}

component example_menubar {
    vbox(style={padding=16}) {
        menubar(items=["File", "Edit", "View", "Help"])
    }
}

component example_toolbar {
    vbox(style={padding=16}) {
        toolbar {
            button(text="New")
            button(text="Open")
            button(text="Save")
            spacer
            button(text="Settings")
        }
    }
}

component example_datepicker {
    vbox(style={padding=16}) {
        datepicker(placeholder="Select a date")
    }
}

component example_chip {
    hbox(style={gap=8, padding=16}) {
        chip(label="Tag")
        chip(label="Removable", removable=true)
        chip(label="Success", variant="success")
    }
}

component example_avatar {
    hbox(style={gap=8, padding=16}) {
        avatar(initials="JD")
        avatar(initials="AB", variant="square")
        avatar(initials="XY", size="large")
    }
}

component example_card {
    hbox(style={gap=16, padding=16}) {
        card(variant="outlined") {
            text(value="Outlined", style={fontWeight="bold"})
            text(value="With a border")
        }
        card(variant="elevated") {
            text(value="Elevated", style={fontWeight="bold"})
            text(value="With a shadow")
        }
    }
}
