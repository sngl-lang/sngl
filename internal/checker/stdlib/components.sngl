// --- Core ---

// Vertical box layout container. Children are stacked top to bottom.
component vbox(
    // Enable vertical scrolling for overflow content.
    scroll bool,
    // Whether a pull-to-refresh gesture is active.
    refreshing bool,
    @refresh RefreshEvent,
) list<component> {}

// Horizontal box layout container. Children are placed side by side, left to right.
component hbox(
    // Enable horizontal scrolling for overflow content.
    scroll bool,
) list<component> {}

// Layered container where children overlap. Later children render on top.
component stack() list<component> {}

// Displays a text string. Supports styling but has no child elements.
component text(
    value string,
    // Allow the user to select and copy the text.
    selectable bool,
    @click ClickEvent,
) {}

// Clickable button that triggers an action. Supports text label or custom children.
component button(
    text string,
    disabled bool,
    @click ClickEvent,
    @longPress LongPressEvent,
) list<component> {}

// Single-line text input field with keyboard type variants.
component input(
    :value string,
    placeholder string,
    disabled bool,
    readonly bool,
    // Keyboard and validation type for the input.
    type string enum(text, password, number, email, url, tel, search),
    // Maximum number of characters allowed.
    maxLength int,
    @input InputEvent,
    @change ChangeEvent,
    @focus FocusEvent,
    @blur FocusEvent,
    @submit SubmitEvent,
) {}

// Displays an image from a URL or asset path.
component image(
    src string,
    // Accessible description of the image content.
    alt string,
    // How the image is scaled to fit its container.
    fit string enum(contain, cover, fill, none, scaleDown),
    @click ClickEvent,
    @load LoadEvent,
    @error ErrorEvent,
) {}

// Scrollable viewport that wraps a single child element.
component scroll(
    direction string enum(vertical, horizontal, both),
    // Current horizontal scroll offset as a fraction (0.0 to 1.0).
    scrollX float,
    // Current vertical scroll offset as a fraction (0.0 to 1.0).
    scrollY float,
    showScrollbar string enum(auto, always, never),
    @scroll ScrollEvent,
    @scrollEnd ScrollEvent,
) component {}

// Flexible empty space used to push siblings apart in a layout.
component spacer(
    // Fixed size (CSS length) instead of flex-growing.
    size string,
) {}

// Boolean toggle rendered as a checkmark box with an optional label.
component checkbox(
    :checked bool,
    label string,
    disabled bool,
    @change ChangeEvent,
) {}

// Placeholder for projected content in custom component definitions.
component slot() {}

// --- Tier 1: Core Input ---

// Group of mutually exclusive options rendered as radio buttons.
component radio(
    // Currently selected option value.
    value string,
    // List of option values or {label, value} objects.
    options list<string>,
    disabled bool,
    direction string enum(vertical, horizontal),
    @change ChangeEvent,
) {}

// On/off switch control with an optional label.
component toggle(
    :checked bool,
    label string,
    disabled bool,
    @change ChangeEvent,
) {}

// Dropdown selection control for picking one or more options from a list.
component select(
    :value string,
    // List of option values or {label, value} objects.
    options list<string>,
    placeholder string,
    disabled bool,
    // Allow selecting multiple options.
    multiple bool,
    @change ChangeEvent,
    @focus FocusEvent,
    @blur FocusEvent,
) {}

// Multi-line text input field.
component textarea(
    :value string,
    placeholder string,
    disabled bool,
    readonly bool,
    // Number of visible text rows.
    rows int,
    maxLength int,
    @input InputEvent,
    @change ChangeEvent,
    @focus FocusEvent,
    @blur FocusEvent,
) {}

// --- Tier 2: Feedback & Navigation ---

// Determinate progress indicator showing completion toward a max value.
component progress(
    value float,
    max float,
    label string,
    variant string enum(bar, circular),
    // Display the numeric value alongside the indicator.
    showValue bool,
) {}

// Indeterminate loading indicator for operations with unknown duration.
component spinner(
    label string,
    variant string enum(dots, line, circle, pulse),
    size string enum(small, medium, large),
) {}

// Small status label for counts, labels, or state indicators.
component badge(
    value string,
    variant string enum(default, primary, success, warning, error),
    size string enum(small, medium, large),
) {}

// Tabbed navigation that switches between child panels by index.
component tabs(
    // List of tab labels or {label, icon} objects.
    items list<string>,
    // Zero-based index of the active tab.
    selected int,
    variant string enum(line, enclosed, pill),
    @change SelectEvent,
) list<component> {}

// Navigational hyperlink to an external URL or internal route.
component link(
    href string,
    text string,
    // Whether to open in the same window or a new tab.
    target string enum(self, blank),
    disabled bool,
    @click ClickEvent,
) {}

// Visual separator line between sections of content.
component divider(
    direction string enum(horizontal, vertical),
    // Optional text label displayed in the middle of the divider.
    label string,
) {}

// --- Tier 3: Overlays & Layout ---

// Dialog overlay that appears above page content with a backdrop.
component modal(
    open bool,
    title string,
    // Whether the modal can be dismissed by the user.
    closable bool,
    size string enum(small, medium, large, fullscreen),
    @close DismissEvent,
) list<component> {}

// Slide-out panel anchored to an edge of the screen.
component drawer(
    open bool,
    side string enum(left, right, top, bottom),
    // Width or height of the drawer (CSS length).
    size string,
    @close DismissEvent,
) list<component> {}

// Small informational popup shown on hover or focus over its child element.
component tooltip(
    text string,
    position string enum(top, bottom, left, right),
    // Delay in milliseconds before the tooltip appears.
    delay int,
) component {}

// Floating content panel anchored to its child element, toggled on click or hover.
component popover(
    open bool,
    position string enum(top, bottom, left, right),
    openOn string enum(click, hover),
    @close DismissEvent,
) list<component> {}

// Expandable/collapsible sections. Each item can be toggled open or closed.
component accordion(
    // List of section headers or {title, content} objects.
    items list<string>,
    // List of currently expanded section indices.
    expanded list<int>,
    // Allow more than one section to be open simultaneously.
    multiple bool,
    @change ExpandEvent,
) list<component> {}

// Resizable two-pane layout divided by a draggable handle.
component splitview(
    direction string enum(horizontal, vertical),
    // Divider position as a fraction (0.0 to 1.0).
    position float,
    minPosition float,
    maxPosition float,
    resizable bool,
    @resize ResizeEvent,
) list<component> {}

// --- Tier 4: Data & Desktop ---

// Tabular data display with optional sorting and row selection.
component table(
    // List of column definitions ({key, label, width}).
    columns list<string>,
    // List of row data objects.
    rows dyn,
    selectable bool,
    selected int,
    sortable bool,
    sortColumn string,
    sortDirection string enum(asc, desc),
    @select SelectEvent,
    @sort ChangeEvent,
) {}

// Hierarchical data display with expandable nodes.
component tree(
    // List of tree node objects ({label, children, id}).
    items list<string>,
    // ID of the currently selected node.
    selected string,
    // List of currently expanded node IDs.
    expanded list<int>,
    @select SelectEvent,
    @expand ExpandEvent,
) {}

// Context or dropdown menu displaying a list of actionable items.
component menu(
    // List of menu items ({label, icon, action}) or separator strings.
    items list<string>,
    open bool,
    @select MenuEvent,
    @close DismissEvent,
) {}

// Horizontal menu bar typically used at the top of a desktop-style application.
component menubar(
    // List of top-level menu definitions ({label, items}).
    items list<string>,
    @select MenuEvent,
) {}

// Horizontal bar of action buttons, typically displayed below a menubar.
component toolbar(
    // List of toolbar button definitions ({label, icon, action}).
    items list<string>,
    @select MenuEvent,
) list<component> {}

// --- Tier 5: Mobile & Specialized ---

// Calendar-based date selection input.
component datepicker(
    value date,
    // Earliest selectable date.
    min date,
    // Latest selectable date.
    max date,
    disabled bool,
    placeholder string,
    @change DateEvent,
    @focus FocusEvent,
    @blur FocusEvent,
) {}

// Compact interactive tag used for filters, selections, or labels.
component chip(
    label string,
    variant string enum(default, primary, success, warning, error),
    // Show a remove button on the chip.
    removable bool,
    selected bool,
    disabled bool,
    @click ClickEvent,
    @remove DismissEvent,
) {}

// Circular or shaped user profile image with fallback to initials.
component avatar(
    src string,
    alt string,
    // Fallback text shown when no image is available.
    initials string,
    size string enum(small, medium, large, xlarge),
    variant string enum(circle, square, rounded),
    @click ClickEvent,
) {}

// Styled container for grouping related content with an optional click action.
component card(
    variant string enum(outlined, elevated, filled),
    // Make the entire card a clickable target.
    clickable bool,
    @click ClickEvent,
) list<component> {}

// --- Examples ---

component example_vbox {
    vbox(style={gap=8, padding=16}) {
        text(value="First")
        text(value="Second")
        text(value="Third")
    }
}

component example_hbox {
    hbox(style={gap=8, padding=16}) {
        text(value="Left")
        text(value="Center")
        text(value="Right")
    }
}

component example_stack {
    stack {
        text(value="Behind", style={padding=16})
        text(value="In front", style={padding=32, color=#FF0000})
    }
}

component example_text {
    vbox(style={gap=8, padding=16}) {
        text(value="Hello, World!", style={fontSize=24, fontWeight="bold"})
        text(value="Regular text")
        text(value="Colored text", style={color=#0066CC})
    }
}

component example_button {
    var count = 0
    vbox(style={gap=8, padding=16}) {
        hbox(style={gap=8}) {
            button(text="Click me", @click={ count += 1 })
            button(text="Reset", @click={ count = 0 })
            button(text="Disabled", disabled=true)
        }
        text(value="Clicked " + string(count) + " times")
    }
}

component example_input {
    var name = ""
    vbox(style={gap=8, padding=16}) {
        input(placeholder="Enter your name", value=name, @input={ name = event.value })
        input(placeholder="Password", type="password")
        input(placeholder="Search...", type="search")
        text(value="Hello, " + name)
    }
}

component example_image {
    vbox(style={gap=8, padding=16}) {
        image(src="https://placehold.co/200x100", alt="Placeholder image", fit="contain")
    }
}

component example_scroll {
    scroll(direction="vertical", style={height=120}) {
        vbox(style={gap=4, padding=8}) {
            text(value="Line 1")
            text(value="Line 2")
            text(value="Line 3")
            text(value="Line 4")
            text(value="Line 5")
            text(value="Line 6")
            text(value="Line 7")
            text(value="Line 8")
        }
    }
}

component example_spacer {
    hbox(style={padding=16}) {
        text(value="Left")
        spacer
        text(value="Right")
    }
}

component example_checkbox {
    var darkMode = false
    vbox(style={gap=8, padding=16}) {
        checkbox(checked=darkMode, label="Dark mode", @change={ darkMode!! })
        text(value=darkMode ? "Dark mode on" : "Dark mode off")
    }
}

component example_radio {
    var size = "medium"
    vbox(style={gap=8, padding=16}) {
        radio(options=["small", "medium", "large"], value=size, direction="horizontal")
        text(value="Selected: " + size)
    }
}

component example_toggle {
    var notifications = false
    vbox(style={gap=8, padding=16}) {
        toggle(checked=notifications, label="Notifications", @change={ notifications!! })
        text(value=notifications ? "Enabled" : "Disabled")
    }
}

component example_select {
    var fruit = ""
    vbox(style={gap=8, padding=16}) {
        select(options=["Apple", "Banana", "Cherry"], placeholder="Pick a fruit", value=fruit)
        text(value="Selected: " + fruit)
    }
}

component example_textarea {
    var notes = ""
    vbox(style={gap=8, padding=16}) {
        textarea(placeholder="Write some notes...", rows=4, value=notes, @input={ notes = event.value })
        text(value="Length: " + string(notes.length()))
    }
}

component example_progress {
    vbox(style={gap=8, padding=16}) {
        progress(value=0.7, max=1, label="70% complete", showValue=true)
        progress(value=3, max=10)
    }
}

component example_spinner {
    hbox(style={gap=16, padding=16, alignItems="center"}) {
        spinner(label="Loading...")
        spinner(variant="circle", size="large")
    }
}

component example_badge {
    hbox(style={gap=8, padding=16, alignItems="center"}) {
        badge(value="3", variant="primary")
        badge(value="New", variant="success")
        badge(value="Error", variant="error")
    }
}

component example_tabs {
    var selected = 0
    vbox(style={padding=16}) {
        tabs(items=["Overview", "Details", "Settings"], selected=selected) {
            text(value="Overview content")
            text(value="Detail content")
            text(value="Settings content")
        }
    }
}

component example_link {
    hbox(style={gap=16, padding=16}) {
        link(href="https://example.com", text="Example Site")
        link(href="https://example.com", text="New Tab", target="blank")
    }
}

component example_divider {
    vbox(style={gap=8, padding=16}) {
        text(value="Section 1")
        divider
        text(value="Section 2")
        divider(label="OR")
        text(value="Section 3")
    }
}

component example_modal {
    var showModal = false
    vbox(style={padding=16}) {
        button(text="Open Modal", @click={ showModal = true })
        modal(open=showModal, title="Example Modal", closable=true) {
            text(value="Modal content goes here.")
            button(text="Close", @click={ showModal = false })
        }
    }
}

component example_drawer {
    var showDrawer = false
    vbox(style={padding=16}) {
        button(text="Open Drawer", @click={ showDrawer = true })
        drawer(open=showDrawer, side="right") {
            vbox(style={gap=8, padding=16}) {
                text(value="Drawer Content", style={fontWeight="bold"})
                button(text="Close", @click={ showDrawer = false })
            }
        }
    }
}

component example_tooltip {
    vbox(style={padding=16}) {
        tooltip(text="This is a tooltip") {
            button(text="Hover me")
        }
    }
}

component example_popover {
    var showPop = false
    vbox(style={padding=16}) {
        popover(open=showPop, position="bottom", openOn="click") {
            button(text="Toggle", @click={ showPop!! })
        }
    }
}

component example_accordion {
    vbox(style={padding=16}) {
        accordion(items=["Section 1", "Section 2", "Section 3"]) {
            text(value="Content for section 1")
            text(value="Content for section 2")
            text(value="Content for section 3")
        }
    }
}

component example_splitview {
    splitview(direction="horizontal", style={height=120}) {
        vbox(style={padding=12}) {
            text(value="Left pane")
        }
        vbox(style={padding=12}) {
            text(value="Right pane")
        }
    }
}

component example_table {
    vbox(style={padding=16}) {
        table(columns=["Name", "Role", "Status"])
    }
}

component example_tree {
    vbox(style={padding=16}) {
        tree(items=["Documents", "Photos", "Music", "Videos"])
    }
}

component example_menu {
    var showMenu = false
    vbox(style={padding=16}) {
        button(text="Show Menu", @click={ showMenu = true })
        menu(items=["Cut", "Copy", "Paste"], open=showMenu)
    }
}

component example_menubar {
    vbox(style={padding=16}) {
        menubar(items=["File", "Edit", "View", "Help"])
    }
}

component example_toolbar {
    vbox(style={padding=16}) {
        toolbar {
            button(text="New")
            button(text="Open")
            button(text="Save")
            spacer
            button(text="Settings")
        }
    }
}

component example_datepicker {
    vbox(style={padding=16}) {
        datepicker(placeholder="Select a date")
    }
}

component example_chip {
    hbox(style={gap=8, padding=16}) {
        chip(label="Tag")
        chip(label="Removable", removable=true)
        chip(label="Success", variant="success")
    }
}

component example_avatar {
    hbox(style={gap=8, padding=16}) {
        avatar(initials="JD")
        avatar(initials="AB", variant="square")
        avatar(initials="XY", size="large")
    }
}

component example_card {
    hbox(style={gap=16, padding=16}) {
        card(variant="outlined") {
            text(value="Outlined", style={fontWeight="bold"})
            text(value="With a border")
        }
        card(variant="elevated") {
            text(value="Elevated", style={fontWeight="bold"})
            text(value="With a shadow")
        }
    }
}
