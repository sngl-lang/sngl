// Style property definitions. The fields of this struct define all valid
// style properties and their types. All fields are optional so that unset
// properties can be distinguished from zero values, enabling style cascading.
struct Style {
    // Sizing
    width option<measurement>
    height option<measurement>
    minWidth option<measurement>
    minHeight option<measurement>
    maxWidth option<measurement>
    maxHeight option<measurement>
    aspectRatio option<float>

    // Padding
    padding option<measurement>
    paddingTop option<measurement>
    paddingRight option<measurement>
    paddingBottom option<measurement>
    paddingLeft option<measurement>
    paddingX option<measurement>
    paddingY option<measurement>

    // Margin
    margin option<measurement>
    marginTop option<measurement>
    marginRight option<measurement>
    marginBottom option<measurement>
    marginLeft option<measurement>
    marginX option<measurement>
    marginY option<measurement>

    // Flex layout
    flex option<float>
    flexGrow option<float>
    flexShrink option<float>
    flexBasis option<measurement>
    flexWrap option<string>
    alignItems option<string>
    justifyContent option<string>
    alignSelf option<string>

    // Spacing
    gap option<measurement>
    rowGap option<measurement>
    columnGap option<measurement>

    // Positioning
    position option<string>
    top option<measurement>
    right option<measurement>
    bottom option<measurement>
    left option<measurement>
    zIndex option<int>

    // Text
    color option<color>
    fontSize option<float>
    fontWeight option<string>
    fontStyle option<string>
    fontFamily option<string>
    textAlign option<string>
    lineHeight option<float>
    textOverflow option<string>
    maxLines option<int>

    // Visual
    background option<color>
    borderColor option<color>
    borderWidth option<float>
    borderRadius option<measurement>
    opacity option<float>
    overflow option<string>

    // Input
    placeholderColor option<color>
}
