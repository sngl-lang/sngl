# SNGL v2 Grammar for modernc.org/egg
#
# Terminals are sentinel bytes defined in token.go (TokenType constants).
# Each token in the stream is encoded as [byte(TokenType), 0x20] by adapter.go.
# Egg's white_space production matches the 0x20 separator and skips it automatically.
#
# Terminal name → byte (hex) → v2 token
# ──────────────────────────────────────
# semi          0x02  SEMICOLON (explicit or ASI-inserted)
# ident         0x03  IDENT
# int_lit       0x04  INT
# float_lit     0x05  FLOAT
# str_full      0x06  STR_FULL      "text"
# triple_full   0x07  TRIPLE_FULL   """text"""
# raw_str       0x08  RAW_STRING
# (0x09 retired — # tokens unified as hash)
# unit_lit      0x0A  UNIT_LITERAL
# hash          0x0B  HASH (#rrggbb / #ident)
# lparen        0x0C  LPAREN  (
# rparen        0x0D  RPAREN  )
# lbrace        0x0E  LBRACE  {
# rbrace        0x0F  RBRACE  }
# lbracket      0x10  LBRACKET [
# rbracket      0x11  RBRACKET ]
# comma         0x12  COMMA   ,
# dot           0x13  DOT     .
# colon         0x14  COLON   :
# assign        0x15  ASSIGN  =
# at            0x16  AT      @
# arrow         0x18  ARROW   ->
# fat_arrow     0x19  FAT_ARROW =>
# ellipsis      0x1A  ELLIPSIS ...
# plus          0x1B  PLUS    +
# minus         0x1C  MINUS   -
# star          0x1D  STAR    *
# slash         0x1E  SLASH   /
# percent       0x1F  PERCENT %
# (0x20 reserved: stream separator / white_space)
# bang          0x21  BANG    !
# bangbang      0x22  BANGBANG !!
# question      0x23  QUESTION ?
# eq            0x24  EQ      ==
# neq           0x25  NEQ     !=
# lt            0x26  LT      <
# gt            0x27  GT      >
# lte           0x28  LTE     <=
# gte           0x29  GTE     >=
# land          0x2A  AND     &&
# lor           0x2B  OR      ||
# plus_assign   0x2C  PLUS_ASSIGN   +=
# minus_assign  0x2D  MINUS_ASSIGN  -=
# star_assign   0x2E  STAR_ASSIGN   *=
# slash_assign  0x2F  SLASH_ASSIGN  /=
# pct_assign    0x30  PERCENT_ASSIGN %=
# kw_import     0x31  KW_IMPORT
# plus_plus     0x32  PLUS_PLUS     ++
# kw_struct     0x33  KW_STRUCT
# kw_enum       0x34  KW_ENUM
# kw_const      0x35  KW_CONST
# kw_var        0x36  KW_VAR
# minus_minus   0x37  MINUS_MINUS   --
# kw_component  0x38  KW_COMPONENT
# kw_if         0x39  KW_IF
# kw_for        0x3A  KW_FOR
# kw_else       0x3B  KW_ELSE
# kw_func       0x3C  KW_FUNC
# kw_unit       0x3D  KW_UNIT
# kw_slot       0x3E  KW_SLOT
# kw_return     0x40  KW_RETURN
# slashdash     0x46  SLASHDASH /-
# str_start        0x49  STR_START         "text{
# str_end          0x4A  STR_END           }text"
# str_resume       0x4B  STR_RESUME        }text{
# triple_start     0x4C  TRIPLE_START      """text{
# triple_end       0x4D  TRIPLE_END        }text"""
# amp              0x4E  AMP               &
# i18n_str_full    0x50  I18N_STR_FULL     $"text"
# i18n_str_start   0x51  I18N_STR_START    $"text{
# i18n_str_end     0x52  I18N_STR_END      }text"   (i18n)
# i18n_str_resume  0x53  I18N_STR_RESUME   }text{   (i18n)
# i18n_triple_full 0x54  I18N_TRIPLE_FULL  $"""text"""
# i18n_triple_start 0x55 I18N_TRIPLE_START $"""text{
# i18n_triple_end  0x56  I18N_TRIPLE_END   }text"""  (i18n)
# i18n_case_full   0x57  I18N_CASE_FULL    {body}    (no nested placeholders)
# i18n_case_start  0x58  I18N_CASE_START   {body{    (opening segment with nested placeholder)
# i18n_case_end    0x59  I18N_CASE_END     }body}    (closing segment of case body)
# attr_open        0x5A  ATTR_OPEN         #[        (start of macro attribute)
# native_value     0x5B  NATIVE_VALUE      (native-value mode sentinel)

# ── Terminal definitions ─────────────────────────────────────────────────────

white_space  = ` ` .

semi         = `\x02` .
ident        = `\x03` .
int_lit      = `\x04` .
float_lit    = `\x05` .
str_full     = `\x06` .
triple_full  = `\x07` .
raw_str      = `\x08` .
unit_lit     = `\x0A` .
hash         = `\x0B` .
lparen       = `\x0C` .
rparen       = `\x0D` .
lbrace       = `\x0E` .
rbrace       = `\x0F` .
lbracket     = `\x10` .
rbracket     = `\x11` .
comma        = `\x12` .
dot          = `\x13` .
colon        = `\x14` .
assign       = `\x15` .
at           = `\x16` .
fat_arrow    = `\x19` .
ellipsis     = `\x1A` .
plus         = `\x1B` .
minus        = `\x1C` .
star         = `\x1D` .
slash        = `\x1E` .
percent      = `\x1F` .
bang         = `\x21` .
bangbang     = `\x22` .
question     = `\x23` .
eq           = `\x24` .
neq          = `\x25` .
lt           = `\x26` .
gt           = `\x27` .
lte          = `\x28` .
gte          = `\x29` .
land         = `\x2A` .
lor          = `\x2B` .
plus_assign  = `\x2C` .
minus_assign = `\x2D` .
star_assign  = `\x2E` .
slash_assign = `\x2F` .
pct_assign   = `\x30` .
kw_import    = `\x31` .
plus_plus    = `\x32` .
kw_struct    = `\x33` .
kw_enum      = `\x34` .
kw_const     = `\x35` .
kw_var       = `\x36` .
minus_minus  = `\x37` .
kw_component = `\x38` .
kw_if        = `\x39` .
kw_for       = `\x3A` .
kw_else      = `\x3B` .
kw_func      = `\x3C` .
kw_unit      = `\x3D` .
kw_slot      = `\x3E` .
kw_return    = `\x40` .
slashdash    = `\x46` .
str_start    = `\x49` .
str_end      = `\x4A` .
str_resume   = `\x4B` .
triple_start = `\x4C` .
triple_end   = `\x4D` .
amp               = `\x4E` .
i18n_str_full     = `\x50` .
i18n_str_start    = `\x51` .
i18n_str_end      = `\x52` .
i18n_str_resume   = `\x53` .
i18n_triple_full  = `\x54` .
i18n_triple_start = `\x55` .
i18n_triple_end   = `\x56` .
i18n_case_full    = `\x57` .
i18n_case_start   = `\x58` .
i18n_case_end     = `\x59` .
attr_open         = `\x5A` .
native_value      = `\x5B` .

# ── String interpolation ────────────────────────────────────────────────────

InterpStr    = str_start Expr { str_resume Expr } str_end .
TripleInterp = triple_start Expr { str_resume Expr } triple_end .

# ── Translatable strings ─────────────────────────────────────────────────────

I18nInterpStr = i18n_str_start I18nPlaceholder { i18n_str_resume I18nPlaceholder } i18n_str_end .
I18nTriple    = i18n_triple_start I18nPlaceholder { i18n_str_resume I18nPlaceholder } i18n_triple_end .

# The 1-3 fields inside a {...} placeholder.
I18nPlaceholder = Expr [ comma ident [ comma I18nThirdArg ] ] .

# Third arg: either a bare style ident (e.g. short, medium, currency)
# or a MsgFormatBody (one or more selector{body} cases).
# Left-factored on the leading ident to resolve LL(1) ambiguity:
#   ident MsgBody ...  → the ident is a Selector; MsgBodyTail consumes the rest
#   ident              → the ident is a Style (no body follows)
#   assign int_lit ... → numeric selector, must be followed by MsgBody
I18nThirdArg = ident [ MsgBodyTail ] | assign int_lit MsgBody { MsgCase } .
MsgBodyTail  = MsgBody { MsgCase } .

# Plural / select / selectordinal cases (space-separated per ICU spec).
MsgCase   = Selector MsgBody .
Selector  = ident | assign int_lit .

# Case body: literal text only, or text + nested placeholders.
MsgBody = i18n_case_full
        | i18n_case_start I18nPlaceholder { i18n_str_resume I18nPlaceholder } i18n_case_end .

# ── Document ─────────────────────────────────────────────────────────────────

MacroAttr = attr_open ident [ dot ident ] [ lparen [ Expr { comma Expr } ] rparen ] rbracket .

# A native value — one expression an encoder wrote, see checker.CheckNativeValue
# — is the second thing a Document can be. Only the native-value lexer emits the
# sentinel, so ordinary source can never take that branch.
Document = native_value Expr [ semi ] | { [ slashdash ] { MacroAttr } Stmt [ semi ] } .

# ── Statements ────────────────────────────────────────────────────────────────
#
# Removed from keywords (now plain identifiers): output, timer, true, false, null.
# Emit statements and visual nodes both parse as VisualOrStmt.
# Scope/position enforcement is deferred to the IR lifter.
#
# Stmt first-token sets (all disjoint):
#   kw_import     → ImportDecl
#   kw_struct     → StructDecl
#   kw_enum       → EnumDecl
#   kw_unit       → UnitDecl
#   kw_const      → ConstDecl
#   kw_var        → VarDecl
#   kw_func       → FuncDecl  (excluded from StatementPrimary)
#   kw_component  → ComponentDecl
#   kw_return     → return statement
#   kw_if         → IfNode
#   kw_for        → ForNode
#   everything else → VisualOrStmt (visual nodes, calls, assignments, emits)

Stmt =
      ImportDecl
    | StructDecl
    | EnumDecl
    | UnitDecl
    | ConstDecl
    | VarDecl
    | FuncDecl
    | ComponentDecl
    | SlotNode
    | kw_return [ Expr ]
    | IfNode
    | ForNode
    | VisualOrStmt
    .

StmtBlock = lbrace { [ slashdash ] { MacroAttr } Stmt [ semi ] } rbrace .

# ── Imports ───────────────────────────────────────────────────────────────────

ImportDecl = kw_import [ ident | dot ] str_full [ fat_arrow str_full ] .

# ── Type declarations ─────────────────────────────────────────────────────────

StructDecl = kw_struct [ ident ] [ TypeParamList ] lbrace { StructBodyItem [ semi ] } rbrace .

StructBodyItem = { MacroAttr } StructBodyDecl .

StructBodyDecl = FuncDecl | StructField .

StructField = IdentList Type [ assign Expr ] .

# Enum body accepts members and nested funcs, separated by comma or semi.
EnumDecl = kw_enum [ ident ] lbrace [ EnumBodyItem { (comma | semi) EnumBodyItem } [ comma | semi ] ] rbrace .

EnumBodyItem = FuncDecl | EnumMember .

EnumMember = ident [ assign Expr ] .

# Unit suffixes use the same brace list: unit Length{px, em, rem=16}
UnitDecl = kw_unit [ ident ] lbrace [ ArgList ] rbrace .

# ── Style ─────────────────────────────────────────────────────────────────────

# style is no longer a keyword — style blocks parse as ident StmtBlock via VisualOrStmt.

# ── Constants ─────────────────────────────────────────────────────────────────

ConstDecl =
      kw_const ConstSpec
    | kw_const lparen { ConstSpec [ comma | semi ] } rparen
    .

ConstSpec = IdentList [ Type ] assign Expr .

IdentList = ident { comma ident } .

# ── Variables ─────────────────────────────────────────────────────────────────

VarDecl =
      kw_var VarSpec
    | kw_var lparen { VarSpec [ comma | semi ] } rparen
    .

VarSpec = IdentList [ Type ] [ assign Expr ] { VarHandler } .

# Left-factored: both forms start with 'at ident'; lparen vs lbrace disambiguates.
VarHandler = at ident [ lparen [ IdentList ] rparen ] StmtBlock .

# ── Functions ─────────────────────────────────────────────────────────────────
#
# Two forms:
#   func name [<T>] [params] => Expr          (expression body)
#   func name [<T>] [params] [Type] { }   (statement body, optional return type)
#
# LL(1) after params: fat_arrow → expr body; ident|kw_func → Type; lbrace → StmtBlock.

FuncDecl = kw_func FuncName [ TargetIndex ] FuncTail .

# The target a declaration overrides, indexed off the name it overrides:
# `component sngl.button[html.platform](text) { ... }`. The expression must
# fold to a target identity, which only a target's own package can supply.
TargetIndex = lbracket Expr rbracket .

FuncTail =
      lparen [ ParamList ] rparen FuncBodyTail
    | FuncBodyTail
    .

FuncBodyTail =
      fat_arrow Expr
    | [ Type ] StmtBlock
    .

# FuncName encodes all name/type-param combinations inside a single non-terminal.
# Moving all TypeParamLists inside FuncName ensures `lt` is never in FOLLOW(FuncName),
# keeping the grammar LL(1).
#
# Supported forms:
#   func name(...)                  → ident
#   func name<T>(...)               → ident TypeParamList
#   func recv.method(...)           → ident dot ident
#   func recv.method<T>(...)        → ident dot ident TypeParamList
#   func recv<T>.method(...)        → ident TypeParamList dot ident
#   func recv<T>.method<U>(...)     → ident TypeParamList dot ident TypeParamList
#
# LL(1) disambiguation after leading ident:
#   lt  → TypeParamList branch; if dot follows it is receiver-level, else function-level
#   dot → method branch; trailing TypeParamList (if lt present) is method-level
#   else → bare function name
FuncName = ident [ TypeParamList [ dot ident [ TypeParamList ] ] | dot ident [ TypeParamList ] ] .

TypeParamList = lt ident { comma ident } gt .

ParamList = Param { comma Param } .

Param = { MacroAttr } ident [ Type ] [ assign Expr ] .

# ── Components ────────────────────────────────────────────────────────────────

ComponentDecl = kw_component ident [ dot ident ] [ TargetIndex ] [ lparen [ CompParamList ] rparen ] [ Type ] StmtBlock .

CompParamList = CompParam { comma CompParam } [ comma ] .

# CompParam first tokens: colon → binding :field, at → event @event, ident → regular param.
# Attrs are hoisted ahead of the alternation so all three forms accept them
# without repeating the repetition in each branch.
CompParam = { MacroAttr } CompParamBody .

CompParamBody =
      colon ident [ Type ] [ assign Expr ]
    | at ident [ Type ]
    | SlotParam
    | ident [ CompParamTail ]
    .

# A slot: a region of UI the caller supplies, declared alongside the props and
# events so a component's whole API is one list. Parenthesised types are what the
# slot is *invoked* with; the trailing Type is what it *accepts*, and its shape
# bounds the count — list<T> any, option<T> none-or-one, bare T exactly one.
#
# The default slot is named `_`, so every slot has the one shape and the name is
# never optional: `slot` followed by an optional name would be ambiguous with a
# type, since both are idents. It is filled by the caller's ordinary children
# rather than by a population, so it takes no invocation parameters.
SlotParam = kw_slot ident [ lparen [ TypeList ] rparen ] [ Type ] .

CompParamTail =
      assign Expr
    | Type [ assign Expr ]
    .

# ── Visual nodes + expression statements ──────────────────────────────────────
#
# VisualOrStmt unifies: visual node declarations, function/emit calls, assignments,
# and toggles. All parse as StatementPrimary followed by PostfixOps.
#
# Emits and element-ref event calls carry no sigil: they parse as ordinary
# calls (save(count), c.inc.click()) and the checker resolves the name to a
# declared event. The '@' sigil survives only on event declarations
# (@click in CompParam), handlers (@click { } in ArgList), and VarHandler.
#
# StmtBlock is a PostfixOp, so trailing bodies attach naturally:
#   Button { Text("hi") }           → ident + StmtBlock postfix
#   Button(text="hi") { }           → ident + call postfix + StmtBlock postfix
#   output { go { bubbletea { } } } → ident primary + StmtBlock postfix (nested)
#   timer(interval=1s, @tick { })   → ident + call postfix (with @tick in ArgList)
#
# kw_func is excluded from StatementPrimary — handled by FuncDecl in Stmt.

VisualOrStmt = StatementPrimary { StmtPostfixOp } [ AssignOp Expr | bangbang | IncDecOp ] .

IncDecOp = plus_plus | minus_minus .

StatementPrimary =
      int_lit
    | float_lit
    | unit_lit
    | str_full
    | triple_full
    | raw_str
    | InterpStr
    | TripleInterp
    | i18n_str_full
    | i18n_triple_full
    | I18nInterpStr
    | I18nTriple
    | hash
    | lparen Expr rparen
    | lbracket ListBody rbracket
    | AnonStructLit
    | ident
    .


# ── Control flow ──────────────────────────────────────────────────────────────

IfNode = kw_if CondExpr StmtBlock [ kw_else ( IfNode | StmtBlock ) ] .

ForNode = kw_for [ amp ] ident [ comma [ amp ] ident ] assign CondExpr StmtBlock [ kw_else StmtBlock ] .

# `slot` in statement position. Bare, it is the anonymous slot's insertion point
# — the one place the keyword means "render here". Named, it populates a slot of
# the component whose block this is, and the marker is what says the node is
# being supplied rather than rendered (a named slot renders as `name(args)`,
# ordinary node syntax, with no keyword at all).
#
# The parenthesised list is expressions at both sites: insertion passes values,
# population binds names, and an ident is an expression — so one production
# parses both and the checker rules on which site it is.
SlotNode = kw_slot [ ident [ lparen [ SlotArgList ] rparen ] ] [ StmtBlock ] .

SlotArgList = Expr { comma Expr } [ comma ] .

AssignOp = assign | plus_assign | minus_assign | star_assign | slash_assign | pct_assign .

# ── Expressions ───────────────────────────────────────────────────────────────

Expr = TernaryExpr .

TernaryExpr = OrExpr [ question Expr colon Expr ] .

OrExpr  = AndExpr  { lor  AndExpr  } .
AndExpr = EqExpr   { land EqExpr   } .
EqExpr  = CmpExpr  { EqOp  CmpExpr  } .
CmpExpr = AddExpr  { CmpOp AddExpr  } .
AddExpr = MulExpr  { AddOp MulExpr  } .
MulExpr = UnaryExpr { MulOp UnaryExpr } .

EqOp  = eq | neq .
CmpOp = lt | lte | gt | gte .
AddOp = plus | minus .
MulOp = star | slash | percent .

UnaryExpr =
      PostfixExpr
    | bang  UnaryExpr
    | minus UnaryExpr
    | amp   UnaryExpr
    | star  UnaryExpr
    | kw_const UnaryExpr
    .

PostfixExpr = PrimaryExpr { ExprPostfixOp } .

# ── Condition expressions ────────────────────────────────────────────────────
# Restricted expression chain for contexts where Expr is followed by StmtBlock
# (if condition, for iterator). Uses StatementPrimary (no bare ident{...} struct
# lits) and CondPostfixOp (no StructLitBody, no StmtBlock) to avoid lbrace
# ambiguity with the following StmtBlock.

CondExpr        = CondOrExpr [ question Expr colon Expr ] .
CondOrExpr      = CondAndExpr  { lor  CondAndExpr  } .
CondAndExpr     = CondEqExpr   { land CondEqExpr   } .
CondEqExpr      = CondCmpExpr  { EqOp  CondCmpExpr  } .
CondCmpExpr     = CondAddExpr  { CmpOp CondAddExpr  } .
CondAddExpr     = CondMulExpr  { AddOp CondMulExpr  } .
CondMulExpr     = CondUnaryExpr { MulOp CondUnaryExpr } .
CondUnaryExpr   = CondPostfixExpr | bang CondUnaryExpr | minus CondUnaryExpr | amp CondUnaryExpr | star CondUnaryExpr | kw_const CondUnaryExpr .
CondPostfixExpr = StatementPrimary { CondPostfixOp } .

# Condition context: no StructLitBody (lbrace is the following StmtBlock),
# no StmtBlock (not a statement).
CondPostfixOp =
      dot ident
    | lbracket Expr rbracket
    | lparen [ ArgList ] rparen
    .

# Expression context: struct lit available via dot-ident, NO StmtBlock.
# lbrace never appears in ExprPostfixOp FIRST set, so ident [ StructLitBody ]
# in PrimaryExpr is LL(1) conflict-free.
ExprPostfixOp =
      dot ident [ StructLitBody ]
    | lbracket Expr rbracket
    | lparen [ ArgList ] rparen
    .

# Statement context: StmtBlock for visual node bodies, NO struct lit.
# `hash` here is the element-reference declaration tag (`name #id(...)`),
# not a selector — it names the enclosing node (see build.go).
StmtPostfixOp =
      dot ident
    | hash
    | lbracket Expr rbracket
    | lparen [ ArgList ] rparen
    | [ lparen [ ArgList ] rparen ] StmtBlock
    .

PrimaryExpr =
      int_lit
    | float_lit
    | unit_lit
    | str_full
    | triple_full
    | raw_str
    | InterpStr
    | TripleInterp
    | i18n_str_full
    | i18n_triple_full
    | I18nInterpStr
    | I18nTriple
    | hash
    | lparen Expr rparen
    | lbracket ListBody rbracket
    | AnonStructLit
    | FuncLit
    | at ident
    | ImportExpr StructLitBody
    | ident [ StructLitBody ]
    .

# An import in expression position names a foreign declaration: the string is
# the scheme import, the selector the type in it. Nothing here holds it to a
# native-value parse; buildPrimaryInner does.
ImportExpr = kw_import lparen str_full rparen dot ident .

ListBody = [ ListElem { comma ListElem } [ comma ] ] .

ListElem = ellipsis Expr | Expr .

# Named struct literal body: Point{x=1, y=2} or pkg.Point{x=1, y=2}.
# Used after ident in PrimaryExpr and after dot-ident in ExprPostfixOp.
StructLitBody = lbrace [ AnonField { ( comma | semi ) AnonField } [ comma | semi ] ] rbrace .

# Anonymous struct literal: {field = expr, …}  — starts with lbrace, unambiguous.
AnonStructLit = lbrace [ AnonField { ( comma | semi ) AnonField } [ comma | semi ] ] rbrace .

AnonField =
      ellipsis Expr
    | Expr assign Expr
    .

# Inline function literal: func(params) => Expr  or  func(params) [ReturnType] { … }
FuncLit = kw_func [ lparen [ ParamList ] rparen ] FuncBodyTail .

# ── Argument list (unified: positional, named, binding, event) ────────────────
#
# Named args (foo=value) → struct literal syntax: Foo(x=1, y=2)
# Binding args (:field)  → visual node prop binding
# Event args (@event { }) → event handlers; StmtBlock attaches via PostfixOp
#
# Left-factored on 'ident' to resolve the predict conflict between:
#   named arg:       ident assign Expr
#   positional expr: ident (anything else)

ArgList = Arg { (comma | semi) Arg } [ comma | semi ] .

Arg =
      colon ident [ Type ] [ assign Expr ]
    | ellipsis Expr
    | ident IdentArgCont
    | bang UnaryExpr ArgExprCont
    | minus UnaryExpr ArgExprCont
    | amp UnaryExpr ArgExprCont
    | star UnaryExpr ArgExprCont
    | kw_const UnaryExpr ArgExprCont
    | NonIdentPrimary { StmtPostfixOp } ArgExprCont
    .

# After consuming 'ident':
#   assign → named arg
#   lbrace → struct literal (not in ExprPostfixOp FIRST)
#   else   → expression postfix chain (ExprPostfixOp handles dot-ident + struct lit)
IdentArgCont =
      assign Expr
    | StructLitBody { ExprPostfixOp } ArgExprCont
    | { ExprPostfixOp } ArgExprCont
    .

# Flattened binary + ternary suffix after a PostfixExpr.
# Each operator level uses a disjoint first-token set → LL(1) clean.
ArgExprCont =
      { MulOp UnaryExpr }
      { AddOp MulExpr }
      { CmpOp AddExpr }
      { EqOp CmpExpr }
      { land EqExpr }
      { lor AndExpr }
      [ question Expr colon Expr ]
      .

# All PrimaryExpr alternatives except 'ident' (handled separately above).
# Includes 'at ident' so event args (@click { }) parse as NonIdentPrimary + PostfixOps.
NonIdentPrimary =
      int_lit
    | float_lit
    | unit_lit
    | str_full
    | triple_full
    | raw_str
    | InterpStr
    | TripleInterp
    | i18n_str_full
    | i18n_triple_full
    | I18nInterpStr
    | I18nTriple
    | hash
    | lparen Expr rparen
    | lbracket ListBody rbracket
    | AnonStructLit
    | FuncLit
    | at ident
    .

# ── Types ─────────────────────────────────────────────────────────────────────

Type =
      ident [ dot ident [ lt TypeList gt ] | lt TypeList gt ]
    | kw_component
    | kw_func lparen [ FuncTypeParamList ] rparen [ Type ]
    | StructDecl
    | EnumDecl
    | UnitDecl
    .

TypeList = Type { comma Type } .

FuncTypeParamList = FuncTypeParam { comma FuncTypeParam } .

FuncTypeParam =
      ident [ dot ident [ lt TypeList gt ] | lt TypeList gt | Type ]
    | kw_func lparen [ FuncTypeParamList ] rparen [ Type ]
    | StructDecl
    | EnumDecl
    | UnitDecl
    .
