// GTK4 platform package.
//
// Each component below overrides the corresponding stdlib abstract component
// with a GTK4-native implementation. The widget types those bodies are written
// against — `GtkButton`, `GtkLabel`, one per GTK class — are the other half of
// this package: the platform generates them from the `Gtk-4.0.gir`
// introspection data installed on the machine, since the widget set is a
// property of the host and not of this repository. A GIR property becomes a
// typed prop, a GLib signal an event, and `#[intrinsic("gtk4:<CType>")]` names
// the C type the emitter reads the class's C API back out of the same GIR
// under. With no GIR file the platform reports itself unavailable and
// contributes nothing, this file included.
//
// Inside a `platform gtk4 { ... }` body a native widget tag needs its `gtk4.`
// prefix (e.g. `gtk4.GtkBox`): the stdlib component it overrides is in scope
// too, and carries a body of its own.
//
// The view renderer walks each component body, finds the root
// VisualNode, reads its widget type and prop/event bindings, and emits the
// corresponding GTK4 Go code.

import ui "sngl:ui"
import . "sngl:macro"

#[options]
struct Options {
    package string
    main bool
    gir string
}

// --- Leaf widgets ---

component ui.text[platform] {
    gtk4.GtkLabel(label=value, style={...style}) {}
}

component ui.button[platform] {
    gtk4.GtkButton(label=text, style={...style}, @clicked { click() }) {}
}

component ui.checkbox[platform] {
    gtk4.GtkCheckButton(label=label, active=checked, style={...style}, @toggled { change() }) {}
}

component ui.image[platform] {
    gtk4.GtkImage(file=src, style={...style}) {}
}

component ui.input[platform] {
    gtk4.GtkEntry(text=value, style={...style}, @changed { input() }) {}
}

// gtk4 has no lightweight multi-line entry; map textarea to GtkEntry so
// the value binding + changed handler compile and round-trip. (Rich
// multi-line GtkTextView support is a future enhancement.)
component ui.textarea[platform] {
    gtk4.GtkEntry(text=value, style={...style}, @changed { input() }) {}
}

// --- Container widgets ---

component ui.vbox[platform] {
    gtk4.GtkBox(orientation="vertical", spacing=6, style={...style}) {
        children
    }
}

component ui.hbox[platform] {
    gtk4.GtkBox(orientation="horizontal", spacing=6, style={...style}) {
        children
    }
}

component ui.scroll[platform] {
    gtk4.GtkScrolledWindow(style={...style}) {
        content
    }
}

// --- Indicators ---

// GtkProgressBar's fraction is 0.0-1.0, which is the range the stdlib
// `value` carries when `max` is left at its default. A `max` other than 1
// would need `value/max`, and a division nothing guards against a zero
// denominator is worse than the scale being wrong.
component ui.progress[platform] {
    // GTK's fraction is 0..1, so the value is measured against max here
    // rather than passed through as if it already were one.
    gtk4.GtkProgressBar(fraction=value / max, text=label, showText=showValue, style={...style}) {}
}

component ui.spinner[platform] {
    gtk4.GtkSpinner(spinning=true, tooltipText=label, style={...style}) {}
}

// `direction` is not forwarded: orientation is a GtkOrientation, and the
// only SNGL value that reaches a GTK enum is a string literal naming one of
// its members (see enumValueArg) — a prop reference has no compile-time
// member to name. A separator is therefore horizontal, which is what
// `direction` defaults to.
component ui.divider[platform] {
    gtk4.GtkSeparator(style={...style}) {}
}

component ui.link[platform] {
    gtk4.GtkLinkButton(uri=href, label=text, sensitive=(disabled == false), style={...style}, @clicked { click() }) {}
}

// GtkSwitch reports its own changes through `state-set`, which returns a
// gboolean, and through GObject's notify — neither of which the fixed
// (instance, user_data) → void trampoline can carry. So `active` is bound
// one way and `@change` is not connected; a toggle renders and follows the
// model, and a user flip does not reach it.
component ui.toggle[platform] {
    gtk4.GtkSwitch(active=checked, sensitive=(disabled == false), style={...style}) {}
}

// `value`, `min` and `max` are `date`, a builtin struct with no fields, and
// GtkCalendar takes the day, month and year as three separate ints (its own
// `date` property is a GLib.DateTime, which no SNGL expression produces).
// So the calendar is shown and its selection reported, and the bound value
// does not reach it.
component ui.datepicker[platform] {
    gtk4.GtkCalendar(sensitive=(disabled == false), style={...style}, @daySelected { change() }) {}
}

// --- Layout ---

component ui.spacer[platform] {
    gtk4.GtkBox(hexpand=true, vexpand=true, style={...style}) {}
}

// The same shape html uses: a wrapper carrying the tooltip text, with the
// wrapped content inside it.
component ui.tooltip[platform] {
    gtk4.GtkBox(tooltipText=text, style={...style}) {
        trigger
    }
}

component ui.card[platform] {
    gtk4.GtkFrame(style={...style}) {
        content
    }
}

component ui.stack[platform] {
    gtk4.GtkStack(style={...style}) {
        layers
    }
}

// `open` reaches the popover as widget visibility rather than as
// gtk_popover_popup: the emitter has one setter path per property and
// popup/popdown is a pair of calls chosen by the value. `position` is a
// GtkPositionType, so it is unreachable for the same reason as divider's
// orientation.
component ui.popover[platform] {
    gtk4.GtkPopover(visible=open, autohide=true, style={...style}, @closed { close() }) {
        content
    }
}

