import . "sngl:ui"

// GettingStarted is the "Your First App" tutorial. Built as a single SNGL
// component (not markdown) so it renders on every platform website.sngl
// targets — html today, android / fyne / bubbletea later. All language- and
// platform-specific instructions are gated by reactive `var` state and `if`
// branches; no JS hacks, no innerHTML escape paths for the prose.
import "internal/docui"

component GettingStarted() node {
    var runPlatform = "html"
    var generateLang = "go"
    var embedLang = "go"

    vbox(style={gap=8, padding=8, maxWidth=820}) {

        docui.Heading1(value="Your First App")
        docui.Paragraph(value="This tutorial walks through building a SNGL app from a one-line Hello World up to a full todo list with persistence and code embedding. Every snippet is real SNGL and type-checks; copy one into a file and run it. The only exceptions are marked: a `// ...` elides code shown earlier, and the persistence example imports a Go package you supply.")

        docui.Heading2(value="Hello, World")
        docui.Paragraph(value="A SNGL app is a tree of components rooted at one called `main`. The smallest app is a single text node:")
        docui.CodeBlock(code=`import . "sngl:ui"

component main node {
    text(value="Hello, World!")
}`, language="sngl")
        docui.Paragraph(value="Save it as `hello.sngl` and run:")
        docui.CodeBlock(code="sngl run hello.sngl", language="bash")

        docui.Heading2(value="Reactive state and binding")
        docui.Paragraph(value="State is declared with `var` (mutable) or zero-arg `func` (derived). The `:value` prefix on a prop is two-way binding: changes flow both ways.")
        docui.CodeBlock(code=`import . "sngl:ui"

component main node {
    var name = "World"
    func greeting() => "Hello, {name}!"
    vbox(style={gap=8, padding=16}) {
        text(value=greeting)
        input(:value=name)
    }
}`, language="sngl")
        docui.Paragraph(value="When the user types in the input, `name` updates, `greeting` recomputes, and the text re-renders. No subscriptions to wire up.")

        docui.Heading2(value="Run it on any platform")
        docui.Paragraph(value="Pick a target. The same source compiles to all of them:")
        hbox(style={gap=8, paddingTop=4, paddingBottom=8}) {
            button(text="HTML", @click { runPlatform = "html" })
            button(text="BubbleTea (TUI)", @click { runPlatform = "bubbletea" })
            button(text="Fyne (Desktop)", @click { runPlatform = "fyne" })
            button(text="Android", @click { runPlatform = "android" })
        }
        if runPlatform == "html" {
            docui.CodeBlock(code="sngl run hello.sngl --platform html", language="bash")
            docui.Paragraph(value="Starts a local HTTP server (default :8080) serving a static page. Edit-and-refresh — no rebuild step.")
        }
        if runPlatform == "bubbletea" {
            docui.CodeBlock(code="sngl run hello.sngl --platform bubbletea", language="bash")
            docui.Paragraph(value="Compiles to a Bubbletea program and runs it inline in your terminal. Quit with Ctrl-C.")
        }
        if runPlatform == "fyne" {
            docui.CodeBlock(code="sngl run hello.sngl --platform fyne", language="bash")
            docui.Paragraph(value="Builds a native desktop window via Fyne. Requires the OS GUI toolchain (XQuartz on macOS, etc.).")
        }
        if runPlatform == "android" {
            docui.CodeBlock(code="sngl run hello.sngl --platform android", language="bash")
            docui.Paragraph(value="Generates an Android Compose project, builds the APK, and installs it to the connected device or emulator.")
        }

        docui.Heading2(value="Generate code you can wrap")
        docui.Paragraph(value="`sngl run` is for iteration. To produce code you can ship inside a larger project, use `sngl generate`. Pick a host language:")
        hbox(style={gap=8, paddingTop=4, paddingBottom=8}) {
            button(text="Go", @click { generateLang = "go" })
            button(text="JavaScript", @click { generateLang = "js" })
            button(text="Kotlin", @click { generateLang = "kotlin" })
        }
        if generateLang == "go" {
            docui.CodeBlock(code="sngl generate hello.sngl --lang go --platform html", language="bash")
            docui.Paragraph(value="Emits a Go package containing the rendered HTML, an `http.Handler`, and any data structs. Drop it into your existing Go project and call `NewHandler()`.")
        }
        if generateLang == "js" {
            docui.CodeBlock(code="sngl generate hello.sngl --lang js --platform html", language="bash")
            docui.Paragraph(value="Emits a static `index.html` plus inline JS for the reactive runtime. Host on any static server.")
        }
        if generateLang == "kotlin" {
            docui.CodeBlock(code="sngl generate hello.sngl --lang kotlin --platform android", language="bash")
            docui.Paragraph(value="Emits a Compose package — components, view models, and a `Root` composable you can mount inside an existing Android Activity.")
        }

        docui.Heading2(value="Pre-configure with `output`")
        docui.Paragraph(value="Repeating `--lang` and `--platform` flags is tedious. An `output` block in the source declares the targets up front; bare `sngl run` and `sngl generate` then pick them up automatically.")
        docui.CodeBlock(code=`output {
    js { html }
    go { bubbletea(package="main") }
    kotlin { android }
}`, language="sngl")
        docui.Paragraph(value="Each language–platform pair in the block becomes one build artifact. Same source, three outputs.")

        docui.Heading2(value="Build a todo app")
        docui.Paragraph(value="Now the full thing: a list of todos with an input field, an add button, and a checkbox per item. Walk through it section by section — every line is part of the running app.")
        docui.CodeBlock(code=`import . "sngl:ui"

struct Todo {
    text string = ""
    done bool = false
}

component main node {
    var (
        newTodo = ""
        todos list<Todo> = []
    )
    func status() => "Todo List ({todos.length()} items)"

    vbox(style={gap=12, padding=16}) {
        text(value=status, style={fontWeight="bold", fontSize=24})
        hbox(style={gap=8, alignItems="center"}) {
            input(:value=newTodo, placeholder="Buy eggs", style={flex=1})
            button(text="Add", @click {
                todos.push(Todo{text=newTodo, done=false})
                newTodo = ""
            })
        }
        vbox(style={gap=4}) {
            for var index, item = todos {
                checkbox(checked=item.done, label=item.text,
                    @change { todos[index].done!! })
            }
        }
    }
}`, language="sngl")
        docui.Paragraph(value="`struct Todo` is the data shape. `var todos list<Todo> = []` starts empty and is what the UI iterates. `func status()` is derived — the count updates whenever `todos` changes.")
        docui.Paragraph(value="`@click` is an event handler running a statement block; `todos.push(...)` mutates the bound list, which triggers a rerender. The trailing `done!!` in the checkbox is the toggle operator — flips a bool in place.")

        docui.Heading2(value="Persist state with a Go import")
        docui.Paragraph(value="The Todo list lives in memory. To save it across runs, import a Go package — any type-safe Go function becomes a SNGL function with the same signature.")
        docui.CodeBlock(code=`import . "sngl:ui"
import "go:myapp/store"

component main node {
    var todos list<Todo> = store.Load() @change {
        store.Save(todos)
    }
    // ... rest of UI as before
}`, language="sngl")
        docui.Paragraph(value="`@change` is a data event on the variable: it re-runs whenever `todos` changes. Any exported Go function becomes a SNGL function with the same signature, so `store.Load` and `store.Save` are ordinary calls. The import only compiles when the host language is Go; on other platforms, swap in a platform-appropriate persistence package.")

        docui.Heading2(value="Embed generated code in a host app")
        docui.Paragraph(value="The generator can omit a `main()` so the output is a library, not an app. Pick a host language:")
        hbox(style={gap=8, paddingTop=4, paddingBottom=8}) {
            button(text="Go", @click { embedLang = "go" })
            button(text="Kotlin (Android)", @click { embedLang = "kotlin" })
        }
        if embedLang == "go" {
            docui.CodeBlock(code="sngl generate todo.sngl --lang go --platform html --opt main=false -o ./generated", language="bash")
            docui.Paragraph(value="Then write your own `main` that mounts the handler:")
            docui.CodeBlock(code=`package main

import (
    "net/http"

    sngl "./generated"
)

func main() {
    http.Handle("/", sngl.NewHandler())
    http.ListenAndServe(":8080", nil)
}`, language="go")
        }
        if embedLang == "kotlin" {
            docui.CodeBlock(code="sngl generate todo.sngl --lang kotlin --platform android --opt main=false -o ./app/src/main/sngl", language="bash")
            docui.Paragraph(value="Then attach the generated `Root` composable in your existing Android `Application`:")
            docui.CodeBlock(code=`package com.example.todo

import android.app.Application
import sngl.generated.Root

class TodoApp : Application() {
    override fun onCreate() {
        super.onCreate()
        Root.attach(this)
    }
}`, language="kotlin")
        }

        docui.Heading2(value="Where next")
        docui.Paragraph(value="That's a complete app touching every part of the language. Take the interactive Tour for a guided walkthrough of more features, or jump to the Reference for the full standard library, language spec, and platform/language matrices.")
    }
}
