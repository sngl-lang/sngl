caps: NoInlineComponents
-- input.sngl --
import . "sngl:ui"
import . "sngl:time"
import . "sngl:app"

component Ticker(rate duration = 1s) node {
    var tick = 0
    timer(interval=rate, @tick { tick = tick + 1 })
    text(value=string(tick))
}
component main node {
    Ticker(rate=2s)
}
-- expected.sngl --
import . "sngl:ui"
import . "sngl:time"
import . "sngl:app"
component main node {
    var tick__inst0 int = 0
    timer(interval=2s, @tick {
        tick__inst0 = tick__inst0 + 1
    })
    text(value=string(tick__inst0))
}
