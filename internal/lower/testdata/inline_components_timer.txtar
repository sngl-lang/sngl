caps: NoInlineComponents
-- input.sngl --
import . "sngl://std"

component Ticker(rate = 1s) {
    var tick = 0
    timer(interval=rate) { tick = tick + 1 }
    text(value=string(tick))
}
component main {
    Ticker(rate=2s)
}
-- expected.sngl --
import . "sngl://std"
component main {
    var tick__inst0 int = 0
    timer(2s) {
        tick__inst0 = tick__inst0 + 1
    }
    text(value=string(tick__inst0))
}
context #locale(i18n.defaultLocale())
