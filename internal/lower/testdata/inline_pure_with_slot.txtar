-- input.sngl --
import . "sngl:ui"

component card(children ...component) ui {
    vbox(style={padding=16}) {
        children
    }
}

component main ui {
    card() {
        text(value="hello")
    }
}
-- expected.sngl --
import . "sngl:ui"
component card(children ...component) ui {
    vbox(style=Style{padding=16}) {
        children
    }
}
component main ui {
    vbox(style=Style{padding=16}) {
        text(value="hello")
    }
}
