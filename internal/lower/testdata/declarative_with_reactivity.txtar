caps: NoDeclarative, NoReactivity
-- input.sngl --
import . "sngl://std"

component main {
    var n int = 0
    text(value=string(n))
    button(text="+", @click { n = n + 1 })
}
-- expected.sngl --
import . "sngl://std"
component main {
    var n int = 0
    func __n1_click_handler() {
        n = n + 1
        __n0.value = string(n)
    }
    var __n0 text = lower.CreateNode("text")
    __n0.value = string(n)
    var __n1 button = lower.CreateNode("button")
    __n1.text = "+"
    lower.AttachHandler(__n1, "click", __n1_click_handler)
}
context #locale(i18n.defaultLocale())
