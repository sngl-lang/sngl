caps: NoEnum
-- input.sngl --
enum Color {
    red
    green
    blue
}

component main {
    var c Color = Color.red

    if c == Color.green {
        text(value="is green")
    } else {
        text(value="other")
    }
}
-- expected.sngl --
enum Color {
    red
    green
    blue
}
component main {
    var c Color = 0
    if c == 1 {
        text(value="is green")
    } else {
        text(value="other")
    }
}
context #locale(i18n.defaultLocale())
