caps: NoEnum
-- input.sngl --
import . "sngl:ui"

enum Color {
    red
    green
    blue
}

component main ui {
    var c Color = Color.red

    if c == Color.green {
        text(value="is green")
    } else {
        text(value="other")
    }
}
-- expected.sngl --
import . "sngl:ui"
enum Color {
    red
    green
    blue
}
component main ui {
    var c Color = 0
    if c == 1 {
        text(value="is green")
    } else {
        text(value="other")
    }
}
