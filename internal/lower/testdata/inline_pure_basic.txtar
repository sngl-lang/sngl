-- input.sngl --
import . "sngl:ui"
import "sngl:i18n"

component greet(name string) {
    text(value=$"Hello, {name}!")
}

component main {
    greet(name="Alice")
}
-- expected.sngl --
import . "sngl:ui"
import i18n "sngl:i18n"
component greet(name string = "") {
    text(value=i18n.trInline("Hello, \{name\}!", "Hello, \{name\}!", {"name"=name}))
}
component main {
    text(value=i18n.trInline("Hello, \{name\}!", "Hello, \{name\}!", {"name"="Alice"}))
}
