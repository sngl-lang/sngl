caps: NoTimer, NoUnit
-- input.sngl --
import . "sngl:ui"
import . "sngl:time"
import . "sngl:app"

component main {
    var n int = 0

    timer(interval=1s) {
        n = n + 1
    }

    text(value=string(n))
}
-- expected.sngl --
import . "sngl:ui"
import . "sngl:time"
import . "sngl:app"
component main {
    var n int = 0
    func __timer0_handler() void {
        n = n + 1
    }
    lower.scheduleTimer(0, 1000, __timer0_handler)
    text(value=string(n))
}
