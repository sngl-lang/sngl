-- input.sngl --
import . "sngl:ui"

component counter() node {
    var count int = 0
    button(text=string(count), @click { count = count + 1 })
}

component main node {
    counter()
}
-- expected.sngl --
import . "sngl:ui"
component counter node {
    var count int = 0
    button(text=string(count), @click {
        count = count + 1
    })
}
component main node {
    counter
}
