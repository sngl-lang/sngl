-- input.sngl --
import . "sngl:ui"

component counter() ui {
    var count int = 0
    button(text=string(count), @click { count = count + 1 })
}

component main ui {
    counter()
}
-- expected.sngl --
import . "sngl:ui"
component counter ui {
    var count int = 0
    button(text=string(count), @click {
        count = count + 1
    })
}
component main ui {
    counter
}
