caps: NoInlineComponents
-- input.sngl --
import . "sngl:ui"

component Counter(start = 0) node {
    var n = start
    text(value=string(n))
}
component Page(initial = 0) node {
    Counter(start=initial)
    Counter(start=initial + 10)
}
component main node {
    Page(initial=1)
}
-- expected.sngl --
import . "sngl:ui"
component main node {
    var n__inst0 int = 1
    var n__inst1 int = 1 + 10
    text(value=n__inst0.format(base=10, width=0, pad=" "))
    text(value=n__inst1.format(base=10, width=0, pad=" "))
}
