-- input.sngl --
import . "sngl:ui"

component main {
    var n int = 0

    func bump() {
        n = n + 1
    }

    text(value=string(n))
    button(text="bump", @click { bump() })
}
-- expected.sngl --
import . "sngl:ui"
component main {
    var n int = 0
    func bump(this main) {
        n = n + 1
        __n0.value = string(n)
        __n0.value = string(n)
    }
    text #__n0(value=string(n))
    button(text="bump", @click {
        main.bump()
    })
}
