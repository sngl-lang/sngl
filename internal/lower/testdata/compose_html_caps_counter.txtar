caps: NoReactivity
-- input.sngl --
import . "sngl:ui"

component main node {
    var n int = 0
    text(value=string(n))
    badge(value=string(n))
    button(text="+", @click { n = n + 1 })
}
-- expected.sngl --
import . "sngl:ui"
component main node {
    var n int = 0
    text #__n0(value=n.format(base=10, width=0, pad=" "))
    text #__n1(value=n.format(base=10, width=0, pad=" "), style=Style{
        display = inlineBlock,
        paddingY = 2px,
        paddingX = 8px,
        borderRadius = 12px,
        ...Style{},
    })
    button(text="+", @click {
        n = n + 1
        __n0.value = n.format(base=10, width=0, pad=" ")
        __n1.value = n.format(base=10, width=0, pad=" ")
    })
}
