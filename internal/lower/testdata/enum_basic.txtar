caps: NoEnum
-- input.sngl --
import . "sngl:ui"

enum Status {
    active
    inactive
    archived
}

component main node {
    var s Status = Status.inactive
    text(value=string(s))
}
-- expected.sngl --
import . "sngl:ui"
enum Status {
    active
    inactive
    archived
}
component main node {
    var s Status = 1
    text(value=string(s))
}
