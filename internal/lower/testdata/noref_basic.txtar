caps: NoRef
-- input.sngl --
import . "sngl:ui"

component main {
    var n int = 0
    var p ref<int> = &n
    func get() int {
        return *p
    }
    func set(x int) {
        n = x + *p
    }
}
-- expected.sngl --
import . "sngl:ui"
struct __ref_int {
    value int
}
component main {
    var n __ref_int = __ref_int{value=0}
    var p __ref_int = n
    func get(this main) int {
        return p.value
    }
    func set(this main, x int) {
        n.value.value = x + p.value
    }
}
