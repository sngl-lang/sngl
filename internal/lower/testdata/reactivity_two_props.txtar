caps: NoReactivity
-- input.sngl --
import . "sngl:ui"

component main ui {
    var n int = 0
    text(value=string(n))
    text(value=string(n + 1))
    button(text="+", @click { n = n + 1 })
}
-- expected.sngl --
import . "sngl:ui"
component main ui {
    var n int = 0
    text #__n0(value=string(n))
    text #__n1(value=string(n + 1))
    button(text="+", @click {
        n = n + 1
        __n0.value = string(n)
        __n1.value = string(n + 1)
    })
}
