caps: NoInlineComponents
-- input.sngl --
import . "sngl://std"

component Tree(name = "leaf") {
    text(value=name)
    Tree(name="child")
}
component main {
    Tree(name="root")
}
-- expected.sngl --
import . "sngl://std"
component Tree(name string = "leaf") {
    text(value=name)
    Tree(name="child")
}
component main {
    Tree(name="root")
}
