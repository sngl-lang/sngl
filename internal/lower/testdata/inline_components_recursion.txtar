caps: NoInlineComponents
-- input.sngl --
import . "sngl:ui"

component Tree(name = "leaf") {
    text(value=name)
    Tree(name="child")
}
component main {
    Tree(name="root")
}
-- expected.sngl --
import . "sngl:ui"
component Tree(name string = "leaf") {
    var __prop_name string = name
    func __set_name(__v string) void {
        __prop_name = __v
    }
    text(value=__prop_name)
    Tree(name="child")
}
component main {
    Tree(name="root")
}
