caps: NoInlineComponents
-- input.sngl --
import . "sngl:ui"

component Tree(name = "leaf") node {
    text(value=name)
    Tree(name="child")
}
component main node {
    Tree(name="root")
}
-- expected.sngl --
import . "sngl:ui"
component Tree(name string = "leaf", __depth int = 0) node {
    text(value=name)
    if __depth >= 512 {
        error.raise(message="Tree: recursion exceeded 512 nested instances", kind="recursion")
    } else {
        Tree(name="child", __depth=__depth + 1)
    }
}
component main node {
    Tree(name="root", __depth=0)
}
