caps: NoUnit
-- input.sngl --
import . "sngl://std"

unit length { px, em = 16px }

struct Box {
    width length
    height length
}

component main {
    var b Box = Box{width=100px, height=50px}
}
-- expected.sngl --
import . "sngl://std"
struct Box {
    width length = 0
    height length = 0
}
unit length {
    px
    em = 16
}
component main {
    var b Box = Box{
        width = 100,
        height = 50,
    }
}
context #locale(i18n.defaultLocale())
