-- input.sngl --
import . "sngl:ui"

unit length { px, em = 16px }

struct Box {
    width length
    height length
}

component main node {
    var b Box = Box{width=100px, height=50px}
}
-- expected.sngl --
import . "sngl:ui"
struct Box {
    width length
    height length
}
unit length {
    px
    em = 16
}
component main node {
    var b Box = Box{
        width = 100,
        height = 50,
    }
}
