-- input.sngl --
import . "sngl:ui"

component clicker(@click) ui {
    button(text="click", @click { click() })
}

component main ui {
    var count int = 0
    clicker(@click { count = count + 1 })
}
-- expected.sngl --
import . "sngl:ui"
component clicker(@click dyn) ui {
    button(text="click", @click {
        click()
    })
}
component main ui {
    var count int = 0
    button(text="click", @click {
        count = count + 1
    })
}
