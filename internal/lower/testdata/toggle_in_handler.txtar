caps: NoToggle
-- input.sngl --
component main {
    var on bool = true
    var ready bool = false

    func toggleBoth() {
        on!!
        ready!!
    }

    button(@click { toggleBoth() })
}
-- expected.sngl --
import stdlib "internal://stdlib"
import alert "internal://alert"
import file "internal://file"
component main {
    var on bool = true
    var ready bool = false
    func toggleBoth() {
        on = !on
        ready = !ready
    }
    button(@click {
        toggleBoth()
    })
}
