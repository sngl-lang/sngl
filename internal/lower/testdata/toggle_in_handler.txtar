caps: NoToggle
-- input.sngl --
import . "sngl://std"

component main {
    var on bool = true
    var ready bool = false

    func toggleBoth() {
        on!!
        ready!!
    }

    button(@click { toggleBoth() })
}
-- expected.sngl --
import . "sngl://std"
component main {
    var on bool = true
    var ready bool = false
    func toggleBoth(this main) {
        on = !on
        ready = !ready
    }
    button(@click {
        main.toggleBoth()
    })
}
