caps: NoToggle
-- input.sngl --
component main {
    var on bool = true
    var ready bool = false

    func toggleBoth() {
        on!!
        ready!!
    }

    button(@click { toggleBoth() })
}
-- expected.sngl --
func main.toggleBoth(this main) {
    on = !on
    ready = !ready
}
component main {
    var on bool = true
    var ready bool = false
    func main.toggleBoth(this main) {
        on = !on
        ready = !ready
    }
    button(@click {
        main.toggleBoth()
    })
}
context #locale(i18n.defaultLocale())
