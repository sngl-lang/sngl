caps: NoToggle, NoEnum
-- input.sngl --
import . "sngl:ui"

enum Mode {
    off
    on
}

component main {
    var m Mode = Mode.off
    var ready bool = false

    func tick() {
        ready!!
    }

    button(@click { tick() })
}
-- expected.sngl --
import . "sngl:ui"
enum Mode {
    off
    on
}
component main {
    var m Mode = 0
    var ready bool = false
    func tick(this main) {
        ready = !ready
    }
    button(@click {
        main.tick()
    })
}
