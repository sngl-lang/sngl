caps: NoReactivity
-- input.sngl --
import . "sngl:ui"

component main node {
    var n int = 0
    text(value=string(n))
    button(text="+", @click { n = n + 1 })
}
-- expected.sngl --
import . "sngl:ui"
component main node {
    var n int = 0
    text #__n0(value=n.format(base=10, width=0, pad=" "))
    button(text="+", @click {
        n = n + 1
        __n0.value = n.format(base=10, width=0, pad=" ")
    })
}
