caps: NoTimer, NoUnit
-- input.sngl --
import . "sngl://std"

component main {
    var running bool = false
    var n int = 0

    timer(interval=500ms, enabled=running) {
        n = n + 1
    }

    button(@click { running = true })
}
-- expected.sngl --
import . "sngl://std"
component main {
    var running bool = false
    var n int = 0
    func __timer0_handler() void {
        n = n + 1
    }
    if running {
        lower.scheduleTimer(0, 500, __timer0_handler)
    }
    button(@click {
        running = true
        if running {
            lower.scheduleTimer(0, 500, __timer0_handler)
        } else {
            lower.cancelTimer(0)
        }
    })
}
