import . "sngl:ui"
import "sngl:platform/html"

// Simple table layout — uses platform bodies for cross-platform rendering.
// Children should be Row components.
component Table(rows ...component) node {
    if PLATFORM == html.platform {
        html.table {
            rows
        }
    } else {
        vbox(style={gap=0}) {
            rows
        }
    }
}

// Table header row.
component HeaderRow(cells ...component) node {
    if PLATFORM == html.platform {
        html.thead {
            html.tr {
                cells
            }
        }
    } else {
        hbox(style={fontWeight="bold", gap=16, padding=4, borderBottom="1px solid #ddd"}) {
            cells
        }
    }
}

// Table body row.
component Row(cells ...component) node {
    if PLATFORM == html.platform {
        html.tr {
            cells
        }
    } else {
        hbox(style={gap=16, padding=4}) {
            cells
        }
    }
}

// Table cell.
component Cell(value = "") node {
    if PLATFORM == html.platform {
        html.td(innerText=value)
    } else {
        text(value=value, style={minWidth=80})
    }
}

// Table header cell.
component HeaderCell(value = "") node {
    if PLATFORM == html.platform {
        html.th(innerText=value)
    } else {
        text(value=value, style={minWidth=80, fontWeight="bold"})
    }
}

// Code-styled table cell (for property names etc.)
component CodeCell(value = "") node {
    if PLATFORM == html.platform {
        html.td {
            html.code(innerText=value)
        }
    } else {
        text(value=value, style={minWidth=80, fontFamily="monospace"})
    }
}
