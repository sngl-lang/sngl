import . "sngl:ui"
import "go:git.duckfam.us/jonathan/sngl/docs"
import "sngl:platform/html"

// CodeBlock renders a fenced-code-block-style snippet. Source is run through
// chroma at compile time using the named lexer (sngl, go, kotlin, bash, js,
// …); unknown languages fall back to plain-text rendering. The optimizer
// folds docs.Highlight(code, language) to a literal HTML string when both
// args are const, so the page ships pre-rendered markup with no runtime
// highlighting work.
component CodeBlock(code = "", language = "") ui {
    if PLATFORM == html.platform {
        html.div(innerHTML=docs.Highlight(code, language), class="hl-code")
    } else {
        text(value=code, style={fontFamily="monospace", padding=12, background="#1e1e1e", color="#d4d4d4"})
    }
}
