import . "sngl:ui"
import "sngl:platform/html"

component NavItem(href = "", text = "", active = false) node {
    if PLATFORM == html.platform {
        html.li {
            html.a(href=href, class=active ? "active" : "", innerText=text)
        }
    } else {
        link(text=text, href=href, style={
            fontWeight = active ? bold : normal,
            paddingY = 4px,
            paddingX = 8px,
        })
    }
}

component NavGroup(title = "", href = "", children ...component) node {
    if PLATFORM == html.platform {
        html.li {
            html.a(href=href, class="nav-group-title", innerText=title)
            html.ul {
                children
            }
        }
    } else {
        vbox(style={gap=2px, paddingTop=8px}) {
            text(value=title, style={fontWeight=bold, fontSize=14px, paddingY=4px, paddingX=8px, color="#666"})
            vbox(style={gap=1px, paddingLeft=8px}) {
                children
            }
        }
    }
}
