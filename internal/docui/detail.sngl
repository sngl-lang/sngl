import . "sngl:std"
import "go:git.duckfam.us/jonathan/sngl/docs"

component Detail(name string) {
    vbox(style={gap=12}) {
        text(value=docs.StdlibLookup(name).name, style={fontSize=24, fontWeight="bold"})
        badge(value=docs.StdlibLookup(name).tier, style={background="#d29922", color="#fff"})
        text(value=docs.StdlibLookup(name).doc)
        text(value="Children: " + docs.StdlibLookup(name).children, style={color="#888"})
    }
}
