// Heading renders a section header. Three flavors are exposed as separate
// components so the html platform can emit the correct semantic tag without
// the codegen having to evaluate a reactive `level` param at compile time.

import . "sngl:ui"
import "sngl:platform/html"

component Heading1(value = "") node {
    if PLATFORM == html.platform {
        html.h1(innerText=value)
    } else {
        text(value=value, style={fontWeight=bold, fontSize=28px, paddingBottom=8px})
    }
}

component Heading2(value = "") node {
    if PLATFORM == html.platform {
        html.h2(innerText=value)
    } else {
        text(value=value, style={fontWeight=bold, fontSize=22px, paddingTop=16px, paddingBottom=8px})
    }
}

component Heading3(value = "") node {
    if PLATFORM == html.platform {
        html.h3(innerText=value)
    } else {
        text(value=value, style={fontWeight=bold, fontSize=18px, paddingTop=12px, paddingBottom=6px})
    }
}
