import . "sngl:ui"
import "sngl:platform/html"

// Paragraph renders a block of prose. Generic platforms get a styled text
// node; html emits a real <p> so default browser typography (margins, line
// height) applies.
component Paragraph(value = "") node {
    if PLATFORM == html.platform {
        html.p(innerText=value)
    } else {
        text(value=value, style={paddingTop=4px, paddingBottom=4px})
    }
}
