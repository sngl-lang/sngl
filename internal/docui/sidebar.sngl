import . "sngl:ui"
import "sngl:platform/html"

component Sidebar(homeHref = "/", logo = "") list<component> {
    if PLATFORM == html.platform {
        html.nav {
            html.div(class="sidebar-header") {
                html.a(href=homeHref, class="nav-brand") {
                    html.img(src=logo, alt="SNGL")
                    html.span(innerText="SNGL")
                }
                html.button(id="theme-toggle", class="theme-toggle", type="button", title="Toggle theme", innerHTML="&#9788;")
            }
            slot
        }
    } else {
        vbox(style={width=260, padding=8, gap=4}) {
            link(text="SNGL", href=homeHref, style={fontWeight="bold", fontSize=16, padding=8})
            divider
            slot
        }
    }
}
