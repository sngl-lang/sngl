import . "sngl://std"
import "go://git.duckfam.us/jonathan/sngl/docs"

const searchFilterJS = `window.snglFilterSearch = function(input) {
  var q = input.value.trim().toLowerCase();
  var box = input.closest('.search-box');
  var res = box.querySelector('.search-results');
  if (!q) { res.hidden = true; return; }
  res.hidden = false;
  var hits = res.querySelectorAll('.search-hit');
  for (var i = 0; i < hits.length; i++) {
    var h = hits[i];
    h.style.display = (h.textContent.toLowerCase().indexOf(q) >= 0) ? '' : 'none';
  }
};`

// SearchBox renders a docs-search input with a results list. The caller
// passes a compile-time const list of entries; the html codegen unrolls
// the for-loop into static <a class="search-hit"> siblings, and the inline
// JS hides/shows them client-side as the user types.
component SearchBox(entries list<docs.SearchEntry> = []) {
    var query = ""

    vbox(style={gap=4, padding=4}) {
        input(:value=query, placeholder="Search docs…", type="search")
        if query != "" {
            vbox(style={gap=2}) {
                for entry = entries {
                    SearchHit(entry=entry, query=query)
                }
            }
        }
    }

    platform html {
        html.div(class="search-box") {
            html.input(class="search-input", type="search", placeholder="Search docs…", autocomplete="off", spellcheck="false",
                oninput="window.snglFilterSearch(this)")
            html.div(class="search-results", hidden="") {
                for entry = entries {
                    html.a(href=entry.href, class="search-hit") {
                        html.div(innerText=entry.title, class="hit-title")
                        html.div(innerText=entry.crumb, class="hit-crumb")
                        html.div(innerText=entry.blurb, class="hit-blurb")
                    }
                }
            }
            html.script(innerHTML=searchFilterJS)
        }
    }
}

component SearchHit(entry docs.SearchEntry, query = "") {
    func matches() => query != "" && string.contains(string.lower(entry.title + " " + entry.crumb + " " + entry.blurb), string.lower(query))

    vbox(style={gap=2, padding=4, display=matches ? "flex" : "none"}) {
        text(value=entry.title, style={fontWeight="bold"})
        if entry.crumb != "" {
            text(value=entry.crumb, style={color="#888", fontSize=12})
        }
        if entry.blurb != "" {
            text(value=entry.blurb, style={color="#aaa", fontSize=12})
        }
    }

    platform html {
        html.a(href=entry.href, class="search-hit", style={display = matches ? "block" : "none"}) {
            html.div(innerText=entry.title, class="hit-title")
            if entry.crumb != "" {
                html.div(innerText=entry.crumb, class="hit-crumb")
            }
            if entry.blurb != "" {
                html.div(innerText=entry.blurb, class="hit-blurb")
            }
        }
    }
}
