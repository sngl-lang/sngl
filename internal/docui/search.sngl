import . "sngl:ui"
import "go:duckfam.us/sngl/docs"
import "sngl:platform/html"

// SearchBox renders a docs-search input with a results list over a
// compile-time const list of entries.
component SearchBox(entries list<docs.SearchEntry> = []) node {
    var query = ""

    vbox(style={gap=4px, padding=4px}) {
        input(:value=query, placeholder="Search docs…", type="search")
        if query != "" {
            vbox(style={gap=2px}) {
                for var entry = entries {
                    SearchHit(entry=entry, query=query)
                }
            }
        }
    }
}

// The hits are a loop over what the input typed, not over entries: a loop over
// a const is unrolled into every page that holds one, and a docs site is a
// thousand pages each holding the whole index. Read at render time instead,
// the const is written once to a shared asset every page loads.
component SearchBox[html.platform] {
    var typed = ""

    html.div(class="search-box") {
        html.input(class="search-input", type="search", placeholder="Search docs…", autocomplete="off", spellcheck="false",
            @input(e) { typed = string.trim(e.value) })
        html.div(class="search-results", hidden=typed == "") {
            for var entry = searchHits(entries, typed) {
                html.a(href=entry.href, class="search-hit") {
                    html.div(innerText=entry.title, class="hit-title")
                    html.div(innerText=entry.crumb, class="hit-crumb")
                    html.div(innerText=entry.blurb, class="hit-blurb")
                }
            }
        }
    }
}

func searchHits(entries list<docs.SearchEntry>, query string) list<docs.SearchEntry> {
    var q = string.lower(query)
    if q == "" {
        return []
    }
    return entries.filter(func(e docs.SearchEntry) => string.contains(string.lower(e.title + " " + e.crumb + " " + e.blurb), q))
}

component SearchHit(entry docs.SearchEntry, query = "") node {
    func matches() => query != "" && string.contains(string.lower(entry.title + " " + entry.crumb + " " + entry.blurb), string.lower(query))

    if PLATFORM == html.platform {
        html.a(href=entry.href, class="search-hit", style={display = matches ? block : none}) {
            html.div(innerText=entry.title, class="hit-title")
            if entry.crumb != "" {
                html.div(innerText=entry.crumb, class="hit-crumb")
            }
            if entry.blurb != "" {
                html.div(innerText=entry.blurb, class="hit-blurb")
            }
        }
    } else {
        vbox(style={gap=2px, padding=4px, display=matches ? flex : none}) {
            text(value=entry.title, style={fontWeight=bold})
            if entry.crumb != "" {
                text(value=entry.crumb, style={color="#888", fontSize=12px})
            }
            if entry.blurb != "" {
                text(value=entry.blurb, style={color="#aaa", fontSize=12px})
            }
        }
    }
}
