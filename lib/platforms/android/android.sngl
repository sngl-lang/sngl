// Android (Jetpack Compose) platform package.
// Raw Compose composables (Column, Row, Text, Button, etc.) are implicitly
// available via APIResolver — any identifier is a valid @Composable.
//
// Each component sngl.X() overrides the stdlib abstract component with a
// Compose-native implementation. Props are inherited from the stdlib
// definition and available as local variables in the body.

import sngl "sngl://std"
import . "sngl://platforms"

#[options]
struct Options {
    // Kotlin package / Android application ID.
    package string
    // Display name used in AndroidManifest.xml.
    appName string
    // Path to a launcher icon asset.
    icon string
    // Emit a full Gradle project or just Compose sources.
    main bool
    // Include Gradle wrapper + build scripts (default: true; set "false" to skip).
    gradle bool
    // Theme accent color (hex).
    color string
    // Absolute path to the project root. Set automatically by `sngl generate`; used to resolve relative asset paths.
    projectDir string
    // Which Android runtime to test against under `sngl test`.
    //   "robolectric": JVM simulation, fast, no emulator (default).
    //   "device":      APK on a real emulator/device via adb.
    testRunner string
    // Toolchain combo — a known-good set of Gradle/AGP/Kotlin/Compose/SDK
    // versions (see internal/androidtc). "stable" (default) or "next".
    toolchain string
    // Override compileSdk / targetSdk (0 = combo default).
    sdk int
    // Override minSdk (0 = default 26).
    minSdk int
    // Override the Gradle distribution version (unset = combo default).
    gradleVersion string
}

// ComposableProp is a key-value pair for composable lambda parameters.
struct ComposableProp {
    key string
    value dyn
}

// Composable describes a composable lambda to emit for a Compose parameter
// that expects @Composable () -> Unit. The codegen detects this struct in
// prop values and emits { Name(key1 = val1, ...) } instead of a data value.
struct Composable {
    name string
    props list<ComposableProp>
}

// --- Core Layout ---

component sngl.vbox() {
    Column {
        slot
    }
}

component sngl.hbox() {
    Row {
        slot
    }
}

component sngl.stack() {
    Box {
        slot
    }
}

component sngl.spacer() {
    Spacer {}
}

component sngl.scroll() {
    Column {
        slot
    }
}

// --- Core Text & Media ---

component sngl.text() {
    Text(text=value) {}
}

component sngl.button() {
    Button {
        Text(text=text) {}
    }
}

component sngl.image() {
    Box {
        Text(text=alt) {}
    }
}

component sngl.input() {
    OutlinedTextField(value=value) {}
}

component sngl.checkbox() {
    Row {
        Checkbox(checked=checked, ) {}
        if label != "" {
            Text(text=label) {}
        }
    }
}

// --- Tier 1: Core Input ---

component sngl.radio() {
    Column {
        slot
    }
}

component sngl.toggle() {
    Row {
        Switch(checked=checked, ) {}
        if label != "" {
            Text(text=label) {}
        }
    }
}

component sngl.select() {
    OutlinedTextField(value=value, readOnly=true) {}
}

component sngl.textarea() {
    OutlinedTextField(value=value, minLines=3, @onValueChange { input() }) {}
}

component sngl.datepicker() {
    OutlinedTextField(value=value, readOnly=true) {}
}

// --- Tier 2: Feedback & Navigation ---

component sngl.progress() {
    LinearProgressIndicator {}
}

component sngl.spinner() {
    CircularProgressIndicator {}
}

component sngl.badge() {
    Badge {
        Text(text=value) {}
    }
}

component sngl.divider() {
    HorizontalDivider {}
}

component sngl.card() {
    Card {
        slot
    }
}

component sngl.chip() {
    AssistChip(label=Composable{name="Text", props=[{key="text", value=label}]}) {}
}

component sngl.link() {
    TextButton(@onClick { click() }) {
        Text(text=text) {}
    }
}

component sngl.tabs() {
    Column {
        slot
    }
}

component sngl.modal() {
    if open {
        Dialog(onDismissRequest=func(){}) {
            Card {
                Column {
                    if title != "" {
                        Text(text=title) {}
                    }
                    slot
                }
            }
        }
    }
}

component sngl.drawer() {
    Column {
        slot
    }
}

component sngl.tooltip() {
    Box {
        slot
    }
}

component sngl.popover() {
    DropdownMenu(expanded=open, onDismissRequest=func(){}) {
        slot
    }
}

component sngl.splitview() {
    Row {
        slot
    }
}

component sngl.table() {
    Column {
        slot
    }
}

component sngl.tree() {
    Column {
        slot
    }
}

component sngl.menu() {
    DropdownMenu(expanded=open, onDismissRequest=func(){}) {
        slot
    }
}

component sngl.menubar() {
    Row {
        slot
    }
}

component sngl.toolbar() {
    Row {
        slot
    }
}

component sngl.avatar() {
    Box {
        Text(text=initials) {}
    }
}
