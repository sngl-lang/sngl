// --- Button ---

component button(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewButton",
            goType="*widget.Button",
        },
        reactive=[
            Reactive{prop="text", target=".SetText", transform="fmt.Sprint"},
        ],
        events=[
            Event{prop="click", target=".OnTapped", signature="func()"},
        ],
        style={...style},
    ) {}
}

// --- Hyperlink ---

component link(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewHyperlink",
            goType="*widget.Hyperlink",
            imports=["net/url"],
        },
        style={...style},
    ) {}
}

// --- Image ---

component image(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="canvas.NewImageFromURI",
            goType="*canvas.Image",
            imports=["fyne.io/fyne/v2/canvas"],
        },
        style={...style},
    ) {}
}

// --- Checkbox / Toggle ---

component checkbox(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewCheck",
            goType="*widget.Check",
        },
        style={...style},
    ) {}
}

component toggle(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewCheck",
            goType="*widget.Check",
