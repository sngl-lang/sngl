// --- Spacer ---

component spacer(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="layout.NewSpacer",
            goType="fyne.CanvasObject",
            imports=["fyne.io/fyne/v2/layout"],
        },
        style={...style},
    ) {}
}

// --- Label-rendered widgets ---

component text(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewLabel",
            goType="*widget.Label",
        },
        reactive=[
            Reactive{prop="value", target=".SetText", transform="fmt.Sprint"},
        ],
        style={...style},
    ) {}
}

component badge(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewLabel",
            goType="*widget.Label",
        },
        reactive=[
            Reactive{prop="value", target=".SetText", transform="fmt.Sprint"},
        ],
        style={...style},
    ) {}
}

component divider(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewLabel",
            goType="*widget.Label",
        },
        reactive=[
            Reactive{prop="label", target=".SetText", transform="fmt.Sprint"},
        ],
        style={...style},
    ) {}
}

component progress(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewLabel",
            goType="*widget.Label",
        },
        reactive=[
            Reactive{prop="value", target=".SetText", transform="fmt.Sprint"},
