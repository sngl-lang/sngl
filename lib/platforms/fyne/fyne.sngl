// Fyne platform package.
//
// Each component declares a blueprint — structured render directives the codegen
// reads at platform load off the single `widget` primitive the body renders. The
// renderer walks each component body, picks the first VisualNode (or the node
// inside a top-level `if`), and reads its args. No platform Go code branches on
// component name.
//
// These are stand-alone declarations, not `component sngl.X { platform fyne }`
// extensions: the renderer reads the body as data, and an extension body is
// instead *inlined* into the program (dropping the caller's props, children and
// handlers, which a blueprint carries as data rather than as expressions).
//
// Imports:
//   The renderer always emits "fmt", "fyne.io/fyne/v2", "fyne.io/fyne/v2/widget",
//   "fyne.io/fyne/v2/container" — these baselines cover the BuildUI fallbacks
//   and the multi-root path. Components that need anything else (canvas, layout,
//   net/url, etc.) declare it via the Constructor.imports field; the renderer
//   collects the union across rendered components.
//
// Blueprint:
//   Constructor{goFn, goType, imports}         the Go constructor to call
//   Init{prop, target, transform}              one-shot setter
//   Reactive{prop, target, transform}          setter + dep-tracked updater
//   Event{prop, target, signature, bindParam,  closure assigned after ctor
//         bindProp}
//
// Top-level args on the `widget` primitive:
//   constructor       Constructor{...}
//   init/reactive/    the three binding kinds, each keyed by prop name
//     events

import sngl "sngl://std"
import . "sngl://platforms"
import . "sngl://internal/marks"

#[options]
struct Options {
    package string
    main bool
}

// --- Blueprint vocabulary ---

struct Constructor {
    goFn string
    goType string
    imports list<string>
}

struct Init {
    prop string
    target string
    transform string
}

struct Reactive {
    prop string
    target string
    transform string
}

struct Event {
    prop string
    target string
    signature string
    bindParam string
    bindProp string
}

// The one platform primitive. Every component below renders exactly one of
// these; its props are the blueprint the Go renderer reads.
#[intrinsic("fyne:widget")]
component widget(
    constructor Constructor,
    init list<Init>,
    reactive list<Reactive>,
    events list<Event>,
    style sngl.Style,
) {}

// --- VBox-style containers ---

component vbox(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="container.NewVBox",
            goType="*fyne.Container",
        },
        style={...style},
    ) {}
}

component stack(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="container.NewVBox",
            goType="*fyne.Container",
        },
        style={...style},
    ) {}
}

