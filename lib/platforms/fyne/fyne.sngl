// Fyne platform package.
//
// The `#[intrinsic("fyne:<Name>")]` components below are the Fyne widgets this
// platform can build — one per Go constructor, twelve of them for the
// thirty-four stdlib components that reach them. Each declares the props and
// events the widget actually supports, and `widgets.go` holds the one Go table
// that says, per intrinsic id, which constructor to call, which Go type it
// returns, and which setter or callback field each prop and event becomes. The
// id is the dispatch key, so no Go code in this package matches a component
// name.
//
// Every stdlib component is then a `component sngl.X { platform fyne { ... } }`
// override whose body instantiates one of those intrinsics. That body is
// *inlined* into the caller by `passInlinePure`, so a prop is an expression the
// inliner substitutes — `text=value` reads the stdlib component's own `value`
// prop — rather than a string naming one. An override that named its props as
// data would lose the caller's props, children and handlers, which is what the
// earlier blueprint form did and why it needed a decoder of its own.
//
// Imports:
//   Nothing here declares a Go import. `nativeCall` resolves a constructor's
//   selector (`widget`, `container`, `layout`, `canvas`) through
//   `fyneFrameworkPkgs`, and `OnCreateNode` does the same for the selector in
//   the widget's Go type, so the emitted file imports exactly the packages the
//   rendered widgets name.
//
// Style:
//   Every intrinsic takes a `style` so an override can forward the stdlib
//   component's `style` through, but Fyne has no style surface the setter table
//   can reach: the prop carries no setter, so the assignment is dropped. It is
//   declared because the data is what a future theme/layout implementation
//   needs, not because anything reads it today.

import sngl "sngl://std"
import . "sngl://platforms"
import . "sngl://internal/marks"

#[options]
struct Options {
    package string
    main bool
}

// --- The intrinsics ---
//
// Twelve widgets, one per Go constructor. A prop appears here only when
// `widgets.go` gives it a setter; an event only when it gives it a callback
// field. `Hyperlink` and `Image` therefore declare no props beyond `style`:
// `widget.Hyperlink` exposes its text as a struct field rather than a setter,
// and `canvas.Image` is constructed from a URI this platform has no expression
// to build.

#[intrinsic("fyne:Label")]
component Label(text string, style sngl.Style) {}

#[intrinsic("fyne:Button")]
component Button(text string, style sngl.Style, @click sngl.ClickEvent) {}

#[intrinsic("fyne:Entry")]
component Entry(text string, placeholder string, style sngl.Style, @input sngl.InputEvent) {}

#[intrinsic("fyne:MultiLineEntry")]
component MultiLineEntry(text string, placeholder string, rows int, style sngl.Style, @input sngl.InputEvent) {}

#[intrinsic("fyne:Check")]
component Check(text string, checked bool, style sngl.Style, @change sngl.ChangeEvent) {}

#[intrinsic("fyne:Select")]
component Select(selected string, style sngl.Style, @change sngl.ChangeEvent) {}

#[intrinsic("fyne:Hyperlink")]
component Hyperlink(style sngl.Style) {}

#[intrinsic("fyne:Image")]
component Image(style sngl.Style) {}

#[intrinsic("fyne:Spacer")]
component Spacer(style sngl.Style) {}

#[intrinsic("fyne:VBox")]
component VBox(style sngl.Style) list<component> {}

#[intrinsic("fyne:HBox")]
component HBox(style sngl.Style) list<component> {}

#[intrinsic("fyne:VScroll")]
component VScroll(style sngl.Style) component {}

// --- Layout containers ---

component sngl.vbox {
    platform fyne {
        VBox(style={...style}) {
            slot
        }
    }
}

component sngl.hbox {
    platform fyne {
        HBox(style={...style}) {
            slot
        }
    }
}

// Fyne has no layered container in the widget set this platform builds from,
// so a stack is a vertical box: the children are all present and in order,
// they just do not overlap.
component sngl.stack {
    platform fyne {
        VBox(style={...style}) {
            slot
        }
    }
}

component sngl.scroll {
    platform fyne {
        VScroll(style={...style}) {
            slot
        }
    }
}

component sngl.spacer {
    platform fyne {
        Spacer(style={...style}) {}
    }
}

component sngl.card {
    platform fyne {
        VBox(style={...style}) {
            slot
        }
    }
}

component sngl.splitview {
    platform fyne {
        HBox(style={...style}) {
            slot
        }
    }
}

// --- Overlays ---
//
// `open` is not forwarded: Fyne's overlay lifecycle is a canvas-level
// push/pop rather than a property, and the setter table has one setter per
// prop. So an overlay renders inline with its content visible, which is what
// the blueprint form did too.

component sngl.modal {
    platform fyne {
        VBox(style={...style}) {
            slot
        }
    }
}

component sngl.drawer {
    platform fyne {
        VBox(style={...style}) {
            slot
        }
    }
}

component sngl.popover {
    platform fyne {
        VBox(style={...style}) {
            slot
        }
    }
}

// The shape html uses: a box carrying the tooltip text, with the wrapped
// content inside it.
component sngl.tooltip {
    platform fyne {
        VBox(style={...style}) {
            slot
        }
    }
}

// --- Navigation ---
//
// A tab strip, menu bar and toolbar are all a row of their entries. Fyne's
// own AppTabs/MainMenu/Toolbar take their items as constructor arguments,
// which the create-then-set sequence this platform emits cannot supply.

component sngl.tabs {
    platform fyne {
        HBox(style={...style}) {
            slot
        }
    }
}

component sngl.toolbar {
    platform fyne {
        HBox(style={...style}) {
            slot
        }
    }
}

component sngl.menubar {
    platform fyne {
        HBox(style={...style}) {}
    }
}

component sngl.menu {
    platform fyne {
        VBox(style={...style}) {}
    }
}

// --- Data display ---
//
// `table`, `tree` and `radio` take their contents as a list prop rather than
// as children, and Fyne's Table/Tree/RadioGroup read theirs through a
// callback or a constructor argument. Each renders as its container, empty,
// until this platform can emit that.

component sngl.table {
    platform fyne {
        VBox(style={...style}) {}
    }
}

component sngl.tree {
    platform fyne {
        VBox(style={...style}) {}
    }
}

component sngl.radio {
    platform fyne {
        VBox(style={...style}) {}
    }
}

// --- Text ---

component sngl.text {
    platform fyne {
        Label(text=value, style={...style}) {}
    }
}

component sngl.badge {
    platform fyne {
        Label(text=value, style={...style}) {}
    }
}

component sngl.chip {
    platform fyne {
        Label(text=label, style={...style}) {}
    }
}

component sngl.divider {
    platform fyne {
        Label(text=label, style={...style}) {}
    }
}

// `initials` rather than `src`: `canvas.Image` needs a URI, and the fallback
// is the half of an avatar this platform can render.
component sngl.avatar {
    platform fyne {
        Label(text=initials, style={...style}) {}
    }
}

component sngl.spinner {
    platform fyne {
        Label(text=label, style={...style}) {}
    }
}

// `value` is a float and the label is text, so the conversion is spelled
// here rather than left to a transform in the setter table.
component sngl.progress {
    platform fyne {
        Label(text=string(value), style={...style}) {}
    }
}

// `value`, `min` and `max` are `date`, which no SNGL expression converts to a
// string, so the picker shows its `placeholder` and its selection does not
// reach the bound value.
component sngl.datepicker {
    platform fyne {
        Label(text=placeholder, style={...style}) {}
    }
}

// --- Controls ---

component sngl.button {
    platform fyne {
        Button(text=text, style={...style}, @click { click() }) {}
    }
}

// `href` and `text` are not forwarded: `widget.Hyperlink` exposes both as
// struct fields, and this platform's setter table calls methods.
component sngl.link {
    platform fyne {
        Hyperlink(style={...style}) {}
    }
}

component sngl.image {
    platform fyne {
        Image(style={...style}) {}
    }
}

component sngl.checkbox {
    platform fyne {
        Check(text=label, checked=checked, style={...style}, @change { change() }) {}
    }
}

// Fyne's Check is the switch affordance too: `widget.Switch` is not in the
// widget set this platform builds from.
component sngl.toggle {
    platform fyne {
        Check(text=label, checked=checked, style={...style}, @change { change() }) {}
    }
}

// `options` is not forwarded: `widget.Select` takes its choices as a
// constructor argument, which the create-then-set sequence cannot supply.
component sngl.select {
    platform fyne {
        Select(selected=value, style={...style}, @change { change() }) {}
    }
}

// --- Text entry ---

component sngl.input {
    platform fyne {
        Entry(text=value, placeholder=placeholder, style={...style}, @input { input() }) {}
    }
}

component sngl.textarea {
    platform fyne {
        MultiLineEntry(text=value, placeholder=placeholder, rows=rows, style={...style}, @input { input() }) {}
    }
}
