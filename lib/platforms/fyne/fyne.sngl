// --- Select ---

component select(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewSelect",
            goType="*widget.Select",
        },
        style={...style},
    ) {}
}

// --- Modal ---

component modal(open bool, style sngl.Style) {
    if open {
        widget(
            constructor=Constructor{
                goFn="container.NewVBox",
                goType="*fyne.Container",
            },
            style={...style},
        ) {}
    }
}

// --- Entry inputs ---

component input(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewEntry",
            goType="*widget.Entry",
        },
        init=[
            Init{prop="placeholder", target=".SetPlaceHolder"},
            Init{prop="value", target=".SetText", transform="fmt.Sprint"},
        ],
        reactive=[
            Reactive{prop="value", target=".SetText", transform="fmt.Sprint"},
        ],
        events=[
            Event{prop="input", target=".OnChanged", signature="func(s string)", bindParam="s", bindProp="value"},
        ],
        style={...style},
    ) {}
}

component textarea(style sngl.Style) {
    widget(
        constructor=Constructor{
            goFn="widget.NewMultiLineEntry",
            goType="*widget.Entry",
        },
        init=[
            Init{prop="placeholder", target=".SetPlaceHolder"},
            Init{prop="rows", target=".SetMinRowsVisible"},
            Init{prop="value", target=".SetText", transform="fmt.Sprint"},
        ],
        reactive=[
            Reactive{prop="value", target=".SetText", transform="fmt.Sprint"},
        ],
        events=[
            Event{prop="input", target=".OnChanged", signature="func(s string)", bindParam="s", bindProp="value"},
        ],
        style={...style},
    ) {}
}
