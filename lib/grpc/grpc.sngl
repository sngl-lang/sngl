import async "sngl:async"
import ir "sngl:internal/ir"
import marks "sngl:internal/marks"

// Names the protobuf message a struct is: `#[grpc.message("library.v1.Book")]`.
// A struct reached by a call's request or response carries one.
func message(name string) ir.Macro

// Gives a struct field its protobuf field number and, where SNGL's type says
// less than the wire does, its kind: `#[grpc.field(2, int32)]`. An `int` is an
// `int64` unless the mark says otherwise, a `float` a `double`; a `list` is a
// repeated field of its element's kind.
func field(number int, kind Kind = Kind.inferred) ir.Macro

// Gives an enum member its protobuf number: `#[grpc.value(1)]`. A member
// written without one is numbered by its place.
func value(number int) ir.Macro

// How a field is written on the wire, as `.proto` spells its type.
enum Kind {
    // Whatever the field's SNGL type is written as: `int64` for an `int`,
    // `double` for a `float`, and the only kind a `bool`, a `string`, an enum
    // or a struct has.
    inferred
    int32
    int64
    uint32
    uint64
    sint32
    sint64
    fixed32
    fixed64
    sfixed32
    sfixed64
    float
    double
    // A string holding the bytes' base64, as proto3's JSON writes them.
    bytes
}

// Calls one unary method of a gRPC service at server, `host:port`, and waits
// for its answer: the response message, or the failure the call ended in, its
// code the gRPC status number (`"5"`) for `classify` to read. method is the
// path a call is made to, `/library.v1.Library/GetBook`.
//
// descriptor is the serialized `FileDescriptorSet` declaring the method, as
// base64: what a target that runs protoc's own generation hands it. A target
// that writes the messages from the structs' marks needs none.
#[marks.intrinsic("grpc.call", async)]
func call[Req anyStruct, Resp anyStruct](
    server     string,
    method     string,
    request    Req,
    descriptor string = "",
    life       async.Lifetime = async.forever,
) async.Result[Resp]

// The gRPC status names, by number: `codes[5]` is `NOT_FOUND`.
const codes = [
    "OK",
    "CANCELLED",
    "UNKNOWN",
    "INVALID_ARGUMENT",
    "DEADLINE_EXCEEDED",
    "NOT_FOUND",
    "ALREADY_EXISTS",
    "PERMISSION_DENIED",
    "RESOURCE_EXHAUSTED",
    "FAILED_PRECONDITION",
    "ABORTED",
    "OUT_OF_RANGE",
    "UNIMPLEMENTED",
    "INTERNAL",
    "UNAVAILABLE",
    "DATA_LOSS",
    "UNAUTHENTICATED",
]

// The failure a call's status says, its code the status's name: what a
// program should do next decides the kind. `UNAVAILABLE` and any failure of
// the server's own are `server`, `DEADLINE_EXCEEDED` `timeout`,
// `UNAUTHENTICATED` and `PERMISSION_DENIED` `auth`, `CANCELLED` `cancelled`,
// and what the server refused as sent -- `INVALID_ARGUMENT`, `NOT_FOUND`,
// `FAILED_PRECONDITION` and the like -- `request`. A failure whose code is no
// status number -- the response did not decode -- is handed back as it came.
// Written here rather than answered by each host, so every target classifies
// alike.
const func classify(f async.Failure) async.Failure {
    var n = -1
    for var i, name = codes {
        if f.code == "{i}" {
            n = i
        }
    }
    if n < 0 {
        return f
    }
    var kind = async.FailureKind.server
    if n == 1 {
        kind = async.FailureKind.cancelled
    } else if n == 4 {
        kind = async.FailureKind.timeout
    } else if n == 7 || n == 16 {
        kind = async.FailureKind.auth
    } else if n == 3 || n == 5 || n == 6 || n == 9 || n == 11 || n == 12 {
        kind = async.FailureKind.request
    }
    return {kind=kind, message=f.message, code=codes[n]}
}
