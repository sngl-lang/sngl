// Package intl declares the locale-aware formatting primitives backing
// sngl://i18n's wrappers.
//
// Each body here is a placeholder: the result comes from the target's own
// implementation of the marked id, and a backend that implements none of
// them has nothing correct to fall back to.

import . "sngl://internal/marks"

#[intrinsic("DefaultLocale", readonly)]
func DefaultLocale() string { return "" }

#[intrinsic("Translate")]
func Translate(locale string, key string, inlinedTemplate string, args map<string, dyn>) string { return "" }

#[intrinsic("Format")]
func Format(locale string, template string, args map<string, dyn>) string { return "" }

#[intrinsic("NumberInt")]
func NumberInt(locale string, n int, style string) string { return "" }

#[intrinsic("NumberFloat")]
func NumberFloat(locale string, n float, style string) string { return "" }

#[intrinsic("Date")]
func Date(locale string, d dyn, style string) string { return "" }

#[intrinsic("Time")]
func Time(locale string, t dyn, style string) string { return "" }

#[intrinsic("DateTime")]
func DateTime(locale string, dt dyn, dateStyle string, timeStyle string) string { return "" }

#[intrinsic("Select")]
func Select(locale string, value string, cases map<string, string>) string { return "" }

// PluralKey identifies a CLDR plural category or an exact numeric match. It
// lives here, beside the primitives that take it, rather than in sngl://std —
// std imports this package, so the type could not be named from here if it
// were declared up there.
//
// Write the predeclared constants (i18n.zero, i18n.one, …, i18n.other) or
// i18n.exactly(n); the fields are the runtime's business.
struct PluralKey {
    n int
    exact bool
}

#[intrinsic("Plural")]
func Plural(locale string, count int, forms map<PluralKey, string>) string { return "" }

#[intrinsic("SelectOrdinal")]
func SelectOrdinal(locale string, count int, forms map<PluralKey, string>) string {}
