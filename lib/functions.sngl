import "internal://stdlib"
import "internal://alert"
import "internal://file"

// --- int ---

// Returns the smaller of two integers. Ties return a (which equals b
// for integers, so the distinction is vacuous).
func int.min(a int, b int) => a < b ? a : b

// Returns the larger of two integers. Ties return a.
func int.max(a int, b int) => a > b ? a : b

// Returns the absolute value of an integer. Behavior on the minimum
// representable value is platform-defined (may overflow).
func int.abs(x int) => x < 0 ? -x : x

// Clamps x to the inclusive range [lo, hi]. If hi < lo the result
// follows `max(lo, min(x, hi))` — i.e. lo wins, which is the
// documented contract for malformed ranges.
func int.clamp(x int, lo int, hi int) => int.max(lo, int.min(x, hi))

// --- float ---

// Returns the smaller of two floats. NaN handling is platform-defined
// — prefer explicit NaN checks when either operand may be NaN.
func float.min(a float, b float) => a < b ? a : b

// Returns the larger of two floats. See `float.min` for NaN caveats.
func float.max(a float, b float) => a > b ? a : b

// Returns the absolute value of a float. Preserves +0.0 / -0.0
// equivalence.
func float.abs(x float) => x < 0.0 ? -x : x

// Clamps x to the inclusive range [lo, hi]. If hi < lo the lo bound
// wins (see `int.clamp`).
func float.clamp(x float, lo float, hi float) => float.max(lo, float.min(x, hi))

// Largest integer value not greater than x, as a float. For negative
// non-integers this rounds away from zero (e.g. floor(-1.5) == -2.0).
func float.floor(x float) => stdlib.MathFloor(x)

// Smallest integer value not less than x, as a float. For negative
// non-integers this rounds toward zero (e.g. ceil(-1.5) == -1.0).
func float.ceil(x float) => stdlib.MathCeil(x)

// Nearest integer value to x, as a float. Halves round away from zero
// (half-away-from-zero / "commercial" rounding), e.g. round(0.5) == 1.0
// and round(-0.5) == -1.0.
func float.round(x float) => stdlib.MathRound(x)

// Raises base to the power exp. Integer powers are exact up to float
// precision; fractional powers of negative bases yield NaN.
func float.pow(base float, exp float) => stdlib.MathPow(base, exp)

// Non-negative square root of x. Returns NaN for negative x.
func float.sqrt(x float) => stdlib.MathSqrt(x)

// Sine of x, where x is in radians.
func float.sin(x float) => stdlib.MathSin(x)

// Cosine of x, where x is in radians.
func float.cos(x float) => stdlib.MathCos(x)

// Tangent of x, where x is in radians. Undefined (±Inf / large finite)
// near odd multiples of π/2.
func float.tan(x float) => stdlib.MathTan(x)

// Arcsine of x, result in radians within [-π/2, π/2]. Returns NaN for
// |x| > 1.
func float.asin(x float) => stdlib.MathAsin(x)

// Arccosine of x, result in radians within [0, π]. Returns NaN for
// |x| > 1.
func float.acos(x float) => stdlib.MathAcos(x)

// Arctangent of x, result in radians within [-π/2, π/2]. Use
// `float.atan2` when you have separate y and x and need to recover
// the quadrant.
func float.atan(x float) => stdlib.MathAtan(x)

// Arctangent of y/x using signs of both arguments to pick the correct
// quadrant. Result is in radians within [-π, π]. `atan2(0, 0)` returns
// 0. This is the correct function for converting Cartesian (x, y)
// into an angle.
func float.atan2(y float, x float) => stdlib.MathAtan2(y, x)

// --- string ---

// Number of Unicode characters in s (not bytes).
func string.length(s string) => stdlib.StrLength(s)

// Index of the first occurrence of sub in s, or -1 if absent. The
// index is a character index, matching `string.substring`.
func string.indexOf(s string, sub string) => stdlib.StrIndexOf(s, sub)

// Substring of s from start (inclusive) to end (exclusive). Both
// bounds are character indices; negative or out-of-range values are
// clamped to [0, length(s)].
func string.substring(s string, start int, end int) => stdlib.StrSubstring(s, start, end)

// Uppercased copy of s using the platform's Unicode case mapping.
func string.upper(s string) => stdlib.StrUpper(s)

// Lowercased copy of s using the platform's Unicode case mapping.
func string.lower(s string) => stdlib.StrLower(s)

// Copy of s with leading and trailing whitespace removed. Whitespace
// follows the platform's Unicode whitespace definition.
func string.trim(s string) => stdlib.StrTrim(s)

// Copy of s with every occurrence of old replaced by new. Replacement
// is non-overlapping — after each match, scanning resumes after the
// replacement (not after old).
func string.replace(s string, old string, new string) => stdlib.StrReplace(s, old, new)

// Splits s on every occurrence of sep and returns the pieces. An
// empty s returns a list with a single empty string; consecutive
// separators produce empty pieces.
func string.split(s string, sep string) => stdlib.StrSplit(s, sep)

// True if sub appears anywhere in s. Equivalent to
// `string.indexOf(s, sub) >= 0`.
func string.contains(s string, sub string) => string.indexOf(s, sub) >= 0

// True if s begins with prefix. An empty prefix always matches.
func string.startsWith(s string, prefix string) => string.substring(s, 0, string.length(prefix)) == prefix

// True if s ends with suffix. An empty suffix always matches.
func string.endsWith(s string, suffix string) => string.substring(s, string.length(s) - string.length(suffix), string.length(s)) == suffix

// --- list ---

// Number of items in l.
func list.length<T>(l list<T>) => stdlib.ListLength(l)

// Returns a new list with item appended to the end of l. Lists are
// immutable values — the original l is unchanged.
func list.push<T>(l list<T>, item T) => stdlib.ListPush(l, item)

// Returns a new list with the item at index removed from l.
// Out-of-range indices leave the list unchanged.
func list.remove<T>(l list<T>, index int) => stdlib.ListRemove(l, index)

// Index of the first occurrence of item in l (by equality), or -1 if
// absent.
func list.indexOf<T>(l list<T>, item T) => stdlib.ListIndexOf(l, item)

// Joins the items of l into a single string, separated by sep. Items
// are coerced via the platform's default string conversion.
func list.join<T>(l list<T>, sep string) => stdlib.ListJoin(l, sep)

// Returns a copy of l with items in reverse order.
func list.reverse<T>(l list<T>) => stdlib.ListReverse(l)

// Returns a new list containing items from start (inclusive) to end
// (exclusive). Bounds are clamped to [0, length(l)].
func list.slice<T>(l list<T>, start int, end int) => stdlib.ListSlice(l, start, end)

// Returns a new list containing the items of l for which pred returns
// true. Item order is preserved.
func list.filter<T>(l list<T>, pred func(T) bool) => stdlib.ListFilter(l, pred)

// Returns a new list built by applying fn to each item of l. The
// result's length equals the input's.
func list.map<T, U>(l list<T>, fn func(T) U) => stdlib.ListMap(l, fn)

// True if item appears in l (by equality). Equivalent to
// `list.indexOf(l, item) >= 0`.
func list.contains<T>(l list<T>, item T) => list.indexOf(l, item) >= 0

// --- color ---

// Builds an opaque color from 0-255 RGB components. Values outside
// that range are clamped by downstream consumers; pass literal ints.
func color.rgb(r int, g int, b int) => color{r=r, g=g, b=b, a=255}

// Builds a color from 0-255 RGB components and an explicit 0-255
// alpha. Use when transparency is needed; otherwise prefer
// `color.rgb` for clarity.
func color.rgba(r int, g int, b int, a int) => color{r=r, g=g, b=b, a=a}

// Returns a copy of c with alpha replaced by a (0-255). Useful for
// deriving translucent variants of a base color while keeping the
// hue stable.
func color.opacity(c color, a int) => color{r=c.r, g=c.g, b=c.b, a=a}

// Renders c as a `#RRGGBB` hex string. Alpha is not included in the
// output; use `color.rgba` values directly when alpha must survive
// round-tripping.
func color.hex(c color) => stdlib.ColorHex(c)

// Mixes c toward white by pct (0.0-1.0) on each RGB channel,
// preserving alpha. `lighten(c, 0.0)` returns c; `lighten(c, 1.0)`
// returns opaque white at c's alpha.
func color.lighten(c color, pct float) color {
    var ret = color{r=c.r, g=c.g, b=c.b, a=c.a}
    ret.r = int.min(255, c.r + int(float(255 - c.r) * pct))
    ret.g = int.min(255, c.g + int(float(255 - c.g) * pct))
    ret.b = int.min(255, c.b + int(float(255 - c.b) * pct))
    return ret
}

// Mixes c toward black by pct (0.0-1.0) on each RGB channel,
// preserving alpha. `darken(c, 0.0)` returns c; `darken(c, 1.0)`
// returns black at c's alpha.
func color.darken(c color, pct float) color {
    var ret = color{r=c.r, g=c.g, b=c.b, a=c.a}
    ret.r = int(float(c.r) * (1.0 - pct))
    ret.g = int(float(c.g) * (1.0 - pct))
    ret.b = int(float(c.b) * (1.0 - pct))
    return ret
}

// --- Alert ---

// Shows a short transient toast tagged with variant ("info",
// "success", "warning", "error") appropriate to the platform. The
// toast dismisses automatically after the platform's default
// duration.
func Alert.toast(message string, variant string) => alert.Toast(message, variant)

// Shows an informational alert. Equivalent to `Alert.toast(message,
// "info")` on platforms that render toasts, or a modeless info
// dialog on desktop platforms.
func Alert.info(message string) => alert.Info(message)

// Shows a warning alert. The rendering elevates severity compared
// to `Alert.info` — a colored toast or a dismissible warning
// dialog depending on the platform.
func Alert.warn(message string) => alert.Warn(message)

// Shows an error alert. Rendered with the platform's error styling
// and typically stays visible until dismissed.
func Alert.error(message string) => alert.Error(message)

// Prompts the user to confirm or cancel. Blocks until a choice is
// made and returns true on confirm, false on cancel. On platforms
// without a native confirm dialog, falls back to a modal overlay.
func Alert.confirm(message string) => alert.Confirm(message)

// --- File ---

// Opens a file-picker dialog and returns the chosen path, or an
// empty string if cancelled. The dialog style (native, in-app) is
// platform-defined. Not all platforms expose a file system — web
// platforms may return a synthetic handle.
func File.pick() => file.Pick()

// Opens a folder-picker dialog and returns the chosen path, or an
// empty string if cancelled. Same platform caveats as `File.pick`.
func File.pickFolder() => file.PickFolder()

// --- map ---

// Number of entries currently in m.
func map.length(m dyn) => stdlib.MapLength(m)

// List of keys in m in unspecified order.
func map.keys(m dyn) => stdlib.MapKeys(m)

// List of values in m in unspecified order.
func map.values(m dyn) => stdlib.MapValues(m)

// True iff key exists in m.
func map.contains(m dyn, key dyn) => stdlib.MapContains(m, key)

// Lookup with default — returns the value if key is present in m,
// otherwise returns the default value. Both are coerced to match the
// declared value type.
func map.get(m dyn, key dyn, default dyn) => stdlib.MapGet(m, key, default)

// --- error ---

// Raises a runtime error. The error propagates to the nearest
// enclosing `errorBoundary` ancestor, whose `@error` handler
// receives an `ErrorEvent{message, kind}`. Without a boundary the
// error terminates the containing evaluation with a platform-default
// handler. `kind` lets handlers dispatch programmatically (e.g.
// "network", "validation", "internal").
func error.raise(message string, kind string) => stdlib.ErrorRaise(message, kind)
