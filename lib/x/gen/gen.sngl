import ir "sngl:internal/ir"
import marks "sngl:internal/marks"
import tree "sngl:tree"

// A SNGL construct a target may emit without help.
//
// Most name a lowering pass that does *not* run when the target claims it, and
// the list is closed: a capability nothing reads is a word with no consequence.
//
// Five are read somewhere other than a pass gate, and are here because a target
// still has to be able to say them. `viewStatements` is the build's: withheld, it
// unrolls the target's view loops after lowering, one window at a time.
// `instanceState` is the inliner's: withheld, a component with state of its own
// is spliced where it is written and keeps a cell per copy of the loops around
// it, rather than being built at run time.
// `insertBefore`, `inlineSlots`, `asyncPost` and `asyncSpawn` are grants rather
// than withdrawals -- the platform's container can place a child, a span can
// hold a render slot, the platform can reach its drawing thread, the language
// can spawn -- and a pass reads each to choose what to emit rather than whether
// to run.
//
enum Capability { toggle, ternary, lambda, ref, unitType, enumType, asyncReactive, asyncCalls, computed, listLambdas, reactivity, declarative, inlineComponents, implicitRecv, structSpread, viewStatements, instanceState, insertBefore, inlineSlots, asyncPost, asyncSpawn, effects, navigation }

// What a *primitive* can do with the nodes it renders, as against what a
// target can do with the language. Written on an `#[intrinsic]` component
// rather than on a build-target node, which is the finer grain the tier
// exists for: html renders `element`, which retains what it draws, beside
// `draw`, which does not -- one platform, one family, two answers.
enum Rendered {
    // A `#id` on a node this primitive renders names something that is still
    // there while the program runs, so a read of one of its props asks the
    // host. Withheld -- the default, as everywhere here -- the node is gone by
    // the time anything could hold it, and a prop read is answered at build
    // time with the expression the prop was given.
    //
    // A widget claims it: a text field the user typed into holds a value the
    // program never wrote, and reconstructing the declared one would render
    // something that was true once. A drawing does not: `passShapeDraw`
    // splices a shape into the calls that paint it, so `circle #dot(r=5.0)`
    // leaves nothing for `dot.r` to read, and 5.0 is not an approximation of
    // the answer -- with no object to mutate, it *is* the answer.
    identity
    // Each node this primitive renders is a surface of its own: a toplevel the
    // target draws a render tree in, standing at the root of a file as a
    // member of `root`. A target whose view is markup writes its document
    // from the first one that no `if` over state and no `for` can take away,
    // and shows every other inside it -- html's Window, the `<dialog>`s of
    // its page. Navigation reads it too: a stack in the document is the
    // target's to answer, and one in any other surface navigates in place.
    surface
}

// A lowering pass a target asks for.
//
// Distinct from a capability, and the distinction is the one `caps.go` made in
// prose and could not spell: these request a rewrite the target *wants*
// rather than confessing to something it cannot do. A platform asking for
// `canvas` is not admitting a limitation.
//
// `navigationHrefs` is for a target whose pages are addresses, one that
// declares `navigation` and serves a page at its href: a `nav.link` becomes a
// `ui.link` to the page's address, and a `go` passing no params passes the
// page's own.
enum Pass { structComponents, stdlibContextParam, focusOrder, canvas, reactiveCanvas, navigationHrefs }

// Says the target emits each named construct natively, so the pass that would
// lower it does not run.
//
// On a language node it is the language's own answer; on a platform node it
// overrules the language's, per capability, which is what lets html take back
// the ternary Go withdrew — the language emits route mode's server half and
// not the markup, so a restriction that exists because Go lacks a construct
// does not apply to what html itself renders.
func can(caps list<Capability>) ir.Macro

// Says the target cannot emit each named construct, so the pass that lowers it
// runs.
//
// Redundant against the default, which already holds nothing, and written
// anyway where a target is refusing something it would otherwise inherit: a
// platform overruling a language's `can`. Naming one capability both ways on
// one declaration is an error rather than a precedence rule.
func cannot(caps list<Capability>) ir.Macro

// Asks for each named lowering pass.
func wants(passes list<Pass>) ir.Macro

// Names a build-target node for everything outside SNGL that looks a target
// up by string: `sngl generate --platform html`, and the generator a plugin
// registers under that name.
//
// The node itself is named for its tier by convention -- a platform package
// declares `component platform(…) build.platform`, a language package
// `component language(…) build.language` -- so inside the package an override
// says `[platform]` and a program says `[html.platform]`. Both name the node,
// and the node is the target: nothing else carries its identity. Every
// build-target node carries one of these.
func name(target string) ir.Macro

// Says the nodes this primitive renders support each named thing.
//
// The one mark here written on something other than a build-target node, and
// the only one that takes `Rendered` rather than `Capability` -- so naming a
// target capability here, or a rendered one in `can`, is refused by the
// argument check with a list of what the enum does accept.
func renders(these list<Rendered>) ir.Macro

// How a family's override generates the family, written as the whole of the
// override's body. The build walks each place the program renders the family
// -- a component whose rest slot takes it -- and each member supplies its own
// part with `node`, so nothing here asks what kind of member it is looking at.
// There are two ways to say what the walk produces.
//
// **A file**, named `file`: `open`, then what each member's `node` writes,
// then `close`, all at build time.
//
//     component block[go.language] {
//         gen.emit(file="blocks.txt", open="[\n", close="]\n")
//     }
//
// A member's props are read at build time, so what reaches the file is a
// value the build can compute: a prop, an `if` or a `for` reading state is
// refused where it is written.
//
// **Code the program runs**, when `render` is given: the content may read
// state. Each member contributes a value of `T` -- its `node`'s `value` -- and
// the members are what the host's content holds *now*, in the order it is
// written, `if`s and `for`s included. `render` turns them into text, and must
// be a pure function of them: it is what the program re-evaluates when state
// the members read changes, and `@change` runs with the text each time it
// differs. `@start` runs once, when the program starts, and is handed the
// members to read again later -- which is how a handler a member carries is
// reached, from a click the program learns of some other way.
//
//     component block[go.language] {
//         gen.emit(
//             render=encode,
//             @start(members) { async.spawn(func() { readClicks(members) }) },
//             @change(line) { print(line) },
//         )
//     }
//
// The build compiles that as SNGL: it writes a function returning the
// members' values and instantiates this component where the host stood,
// handing it that function as `members`. The body below is the whole of what
// it means, so a target compiles it with nothing to learn. `members` is the
// build's to supply and a program does not write it.
#[marks.builtin("genEmit")]
#[tree.none]
component emit<T = struct {}>(
    file string = "",
    open string = "",
    close string = "",
    // The defaults are never read: code mode needs a `render`, and the build
    // always supplies `members`. They are typed by T's default because a
    // default is checked against what T stands for in the declaration.
    render func(members list<T>) string = func(members list<struct {}>) => "",
    members func() list<T> = func() list<struct {}> {
        return []
    },
    @start(members func() list<T>),
    @change(text string),
) {
    effect(@mount {
        start(members)
    })
    effect(on=render(members()), @mount(text) {
        change(text)
    })
}

// What one member writes, written as the whole body of the member's override
// for a target whose family emits.
//
// For a file, `open` is written where the member is reached, then whatever its
// children write, then `close`; both are evaluated with the member's props in
// scope, which is how a member says what it holds:
//
//     component text[go.language] {
//         gen.node(open="{name}: {full}\n")
//     }
//
// For code, `value` is what the member contributes, also read with its props
// in scope -- and its events, each a func running the handler the call site
// wrote for it, or nothing where it wrote none:
//
//     component text[go.language] {
//         gen.node(value=Entry{full=full, click=click})
//     }
#[marks.builtin("genNode")]
#[tree.none]
component node<T = struct {}>(open string = "", close string = "", value T = {}) {}
