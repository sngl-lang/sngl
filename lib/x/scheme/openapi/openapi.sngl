import gen "sngl:x/gen"
import marks "sngl:internal/marks"

// `openapi:` imports an OpenAPI 3 document, YAML or JSON, as a package of
// the types it declares and the requests it describes:
//
//     import poke "openapi:./pokeapi.yml"
//
// The path is the project's own file, relative to the import root, read
// through the project: one outside it, or a symlink out of it, is refused.
// What the package holds:
//
//   - **A declaration per schema**: an object is a struct, a string enum an
//     enum; a property neither required nor nullable, or nullable, is an
//     option, an array a list, `additionalProperties` a map keyed by
//     string, a `$ref` the declaration it names and an `allOf` its parts'
//     fields merged. An integer is an `int` whatever its format, a number a
//     float, a `date` or `date-time` string a `time.date` or a `datetime`.
//     A field's name is its key in camelCase, with `#[json.identifier]`
//     naming the key where the two differ.
//   - **A function per operation**, named for its `operationId` with `Call`
//     after it, `pokemonRetrieveCall`: its path parameters, then its query's
//     -- with the spec's default, or as an option -- then a JSON body. It
//     answers `async.Result` of the response's type: the value, or the
//     failure that kept it from arriving, the status said, or its JSON did
//     not match.
//   - **A component per `GET`**, named for the bare `operationId`, over
//     `async.query`: asked when it mounts and whenever a parameter changes,
//     its `value`, `pending` and `failure` the query's, handed through. It
//     renders nothing, so it goes in any tree.
//   - **`server`**, a context holding the spec's first server: provide
//     another around a subtree, or in a test with `t.setContext`, to send
//     its requests somewhere else.
//
// What no declaration spells -- an `anyOf`, a `oneOf` other than a schema
// or null, a discriminator, a header or cookie parameter, a body that is
// not JSON -- leaves out the field or the operation that reaches it, and
// the import says so in a warning. So does a name the import had to change.
gen.scheme(name="openapi", @generate(out, importPath) {
    // The document is one of the project's own files, read through the
    // project, so the repository naming it reaches nothing outside it.
    if importPath.startsWith("/") || importPath == ".." || importPath.startsWith("../") || importPath.contains("/../") {
        error.raise("openapi:" + importPath + " is outside the project: the document is read from the project's own files", "import")
        return
    }
    var text = ""
    for var line = gen.lines(importPath) {
        text = text + line + "\n"
    }
    var spec = parse(text)
    for var n = spec.notes {
        out.note(n)
    }
    out.write(fileName(importPath), source(spec, importPath))
})

// What a value of a Type is.
enum Kind { text, integer, number, boolean, date, datetime, named, array, dict }

// A schema as the type a declaration spells.
struct Type {
    kind  Kind
    // A named type's declaration.
    name  string
    // A list's element, or a map's key and value.
    elems list[Type]
}

// One property of an object.
struct Field {
    wire     string
    name     string
    type     Type
    optional bool
    doc      string
}

// One value of a string enum.
struct Member {
    wire string
    name string
}

// One declaration: a struct, or an enum.
struct Schema {
    name    string
    doc     string
    isEnum  bool
    fields  list[Field]
    members list[Member]
}

// A piece of a path: text, or the parameter it is filled from.
struct Segment {
    text  string
    param string
    kind  Kind
}

// One parameter of an operation.
struct Param {
    wire     string
    name     string
    inPath   bool
    type     Type
    optional bool
    // The spec's default, as the document spells the scalar.
    default  option[string]
    doc      string
}

// One request the package can make.
struct Operation {
    method   string
    path     string
    segments list[Segment]
    call     string
    // The component over async.query, or "" for none.
    adapter  string
    summary  string
    doc      string
    params   list[Param]
    // The declared struct the query is, or "" for an anonymous one.
    query    string
    body     option[Type]
    bodyName string
    result   Type
}

// A document, read.
struct Spec {
    title      string
    server     string
    schemas    list[Schema]
    operations list[Operation]
    notes      list[string]
    usesTime   bool
}

// The document's text, read. Answered by Go, which reads YAML and JSON and
// decides what each schema is.
#[marks.intrinsic("openapi.parse", build)]
func parse(text string) Spec

// The file an import writes: the document's own name, as a .sngl file.
func fileName(path string) string {
    var base = path
    for var part = path.split("/") {
        base = part
    }
    var dot = base.indexOf(".")
    if dot > 0 {
        base = base.substring(0, dot)
    }
    return base + ".sngl"
}

// The package's source.
func source(spec Spec, from string) string {
    var src = "// Code generated by the openapi: scheme from " + from + ". DO NOT EDIT.\n\n"
    src = src + `import async "sngl:async"` + "\n"
    src = src + `import http "sngl:http"` + "\n"
    src = src + `import json "sngl:json"` + "\n"
    if spec.usesTime {
        src = src + `import time "sngl:time"` + "\n"
    }
    src = src + "\n"
    if spec.title.length() > 0 {
        src = src + "// Where " + spec.title + " is: the spec's first server. Provide another to\n"
    } else {
        src = src + "// Where the API is: the spec's first server. Provide another to\n"
    }
    src = src + "// point a subtree, or a test, somewhere else.\n"
    src = src + "context #server(" + quote(spec.server) + ")\n"
    for var s = spec.schemas {
        src = src + "\n" + schema(s)
    }
    for var op = spec.operations {
        if op.query.length() > 0 {
            src = src + "\n" + queryStruct(op)
        }
    }
    src = src + "\n" + answered
    for var op = spec.operations {
        src = src + "\n" + call(op)
    }
    for var op = spec.operations {
        if op.adapter.length() > 0 {
            src = src + "\n" + adapter(op)
        }
    }
    return src
}

const answered = `// What a request answered, where it arrived with a 2xx status: the response,
// or the failure that kept it from arriving or that its status says.
func _answered(r async.Result[http.Response]) async.Result[http.Response] {
    match var got = r {
        failed { return {failed=got} }
        ok { return got.checked() }
    }
}
`

// A declaration.
func schema(s Schema) string {
    var src = comment(s.doc, "")
    if s.isEnum {
        src = src + "enum " + s.name + " \{\n"
        for var m = s.members {
            if m.wire != m.name {
                src = src + "    #[json.identifier(" + quote(m.wire) + ")]\n"
            }
            src = src + "    " + m.name + "\n"
        }
        return src + "\}\n"
    }
    if s.fields.length() == 0 {
        return src + "struct " + s.name + " \{\}\n"
    }
    var width = 0
    for var f = s.fields {
        if f.name.length() > width {
            width = f.name.length()
        }
    }
    src = src + "struct " + s.name + " \{\n"
    for var f = s.fields {
        src = src + comment(f.doc, "    ")
        if f.wire != f.name {
            src = src + "    #[json.identifier(" + quote(f.wire) + ")]\n"
        }
        src = src + "    " + pad(f.name, width) + " " + fieldType(f.type, f.optional) + "\n"
    }
    return src + "\}\n"
}

// The struct an operation's query is, where a parameter's name on the wire
// is not its SNGL name.
func queryStruct(op Operation) string {
    var width = 0
    for var p = op.params {
        if !p.inPath && p.name.length() > width {
            width = p.name.length()
        }
    }
    var src = "// The query of " + op.method.upper() + " " + op.path + ".\n"
    src = src + "struct " + op.query + " \{\n"
    for var p = op.params {
        if p.inPath {
            continue
        }
        if p.wire != p.name {
            src = src + "    #[http.identifier(" + quote(p.wire) + ")]\n"
        }
        src = src + "    " + pad(p.name, width) + " " + fieldType(p.type, p.optional) + "\n"
    }
    return src + "\}\n"
}

// An operation's function.
func call(op Operation) string {
    var src = "// " + op.method.upper() + " " + op.path + "\n"
    if op.summary.length() > 0 {
        src = src + "//\n// " + op.summary + "\n"
    }
    if op.doc.length() > 0 && op.doc != op.summary {
        src = src + "//\n" + comment(op.doc, "")
    }
    var params list[string] = []
    for var p = op.params {
        params.push(param(p))
    }
    if op.body != null {
        params.push(op.bodyName + " " + spell(op.body))
    }
    src = src + "func " + op.call + "(" + params.join(", ") + ") async.Result[" + spell(op.result) + "] \{\n"
    var args list[string] = ["url=" + url(op)]
    if hasQuery(op) {
        args.push("query=" + query(op))
    }
    var request = ""
    if op.method == "get" {
        request = "http.get(" + args.join(", ") + ")"
    } else {
        var sent list[string] = ["method=http.Method." + op.method]
        for var a = args {
            sent.push(a)
        }
        if op.body != null {
            sent.push(`headers={"Content-Type"="application/json"}`)
            sent.push("body=json.encode(" + op.bodyName + ")")
        }
        request = "http.send(" + sent.join(", ") + ")"
    }
    src = src + "    match var r = _answered(" + request + ") \{\n"
    src = src + "        failed \{ return \{failed=r\} \}\n"
    src = src + "        ok \{ return json.decode[" + spell(op.result) + "](r.body) \}\n"
    src = src + "    \}\n"
    return src + "\}\n"
}

// An operation's component over async.query.
func adapter(op Operation) string {
    var names list[string] = []
    for var p = op.params {
        names.push(p.name)
    }
    var src = "// " + op.method.upper() + " " + op.path
    if names.length() > 0 {
        src = src + ", asked again whenever " + names.join(" or ") + " changes"
    }
    src = src + ".\n"
    if op.summary.length() > 0 {
        src = src + "//\n// " + op.summary + "\n"
    }
    var result = spell(op.result)
    var width = ":failure".length()
    for var p = op.params {
        if p.name.length() > width {
            width = p.name.length()
        }
    }
    src = src + "component " + op.adapter + "[F any](\n"
    for var p = op.params {
        src = src + "    " + pad(p.name, width) + " " + declared(p) + ",\n"
    }
    src = src + "    " + pad(":value", width) + " option[" + result + "] = null,\n"
    src = src + "    " + pad(":pending", width) + " bool = false,\n"
    src = src + "    :failure option[async.Failure] = null,\n"
    src = src + "    @load(value " + result + "),\n"
    src = src + "    @fail(f async.Failure),\n"
    src = src + ") F \{\n"
    src = src + "    async.query(\n"
    if op.params.length() == 0 {
        src = src + "        on = 0,\n"
        src = src + "        fetch = func(k int) => " + op.call + "(),\n"
    } else if op.params.length() == 1 {
        src = src + "        on = " + op.params[0].name + ",\n"
        src = src + "        fetch = " + op.call + ",\n"
    } else {
        var on list[string] = []
        var passed list[string] = []
        var keyWidth = 0
        for var p = op.params {
            on.push(p.name + "=" + p.name)
            passed.push(p.name + "=k." + p.name)
            if p.name.length() > keyWidth {
                keyWidth = p.name.length()
            }
        }
        src = src + "        on = \{" + on.join(", ") + "\},\n"
        src = src + "        fetch = func(k struct \{\n"
        for var p = op.params {
            src = src + "            " + pad(p.name, keyWidth) + " " + fieldType(p.type, p.optional) + "\n"
        }
        src = src + "        \}) => " + op.call + "(" + passed.join(", ") + "),\n"
    }
    src = src + "        :value = value,\n"
    src = src + "        :pending = pending,\n"
    src = src + "        :failure = failure,\n"
    src = src + "        @load \{ load() \},\n"
    src = src + "        @fail \{ fail() \},\n"
    src = src + "    )\n"
    return src + "\}\n"
}

// A parameter as a function declares it.
func param(p Param) string {
    return p.name + " " + declared(p)
}

// What follows a parameter's name: its type, and its default.
func declared(p Param) string {
    if p.optional {
        return fieldType(p.type, true) + " = null"
    }
    if p.default != null {
        return spell(p.type) + " = " + literal(p.default, p.type)
    }
    return spell(p.type)
}

func hasQuery(op Operation) bool {
    for var p = op.params {
        if !p.inPath {
            return true
        }
    }
    return false
}

// The request's URL: the server, and the path with each parameter filled
// in, a string one escaped so it stays one segment.
func url(op Operation) string {
    var src = `"{server}`
    for var s = op.segments {
        if s.param.length() == 0 {
            src = src + escape(s.text)
        } else if s.kind == Kind.text {
            src = src + "\{http.pathEscape(" + s.param + ")\}"
        } else {
            src = src + "\{" + s.param + "\}"
        }
    }
    return src + `"`
}

// The query, as a struct of its parameters.
func query(op Operation) string {
    var fields list[string] = []
    for var p = op.params {
        if !p.inPath {
            fields.push(p.name + "=" + p.name)
        }
    }
    return op.query + "\{" + fields.join(", ") + "\}"
}

// The type a field or a parameter is declared with.
func fieldType(t Type, optional bool) string {
    if optional {
        return "option[" + spell(t) + "]"
    }
    return spell(t)
}

// The type t is, as the package spells it.
const func spell(t Type) string {
    match t.kind {
        text { return "string" }
        integer { return "int" }
        number { return "float" }
        boolean { return "bool" }
        date { return "time.date" }
        datetime { return "time.datetime" }
        named { return t.name }
        array { return "list[" + spell(t.elems[0]) + "]" }
        dict { return "map[" + spell(t.elems[0]) + ", " + spell(t.elems[1]) + "]" }
    }
}

// A default as a literal of its type.
func literal(v string, t Type) string {
    if t.kind == Kind.text {
        return quote(v)
    }
    if t.kind == Kind.number && v.indexOf(".") < 0 {
        return v + ".0"
    }
    return v
}

// text as line comments, each line after indent.
func comment(text string, indent string) string {
    if text.length() == 0 {
        return ""
    }
    var src = ""
    for var line = text.split("\n") {
        if line.trim().length() == 0 {
            src = src + indent + "//\n"
        } else {
            src = src + indent + "// " + line.trim() + "\n"
        }
    }
    return src
}

func pad(s string, width int) string {
    var out = s
    for out.length() < width {
        out = out + " "
    }
    return out
}

const func quote(s string) => `"` + escape(s) + `"`

// s as the inside of a string literal, written as it reads.
const func escape(s string) => s.replace(`\`, `\\`).replace(`"`, `\"`).replace("\{", `\{`).replace("\}", `\}`).replace("\n", `\n`)
