struct _p_GTypeInstance {}

#[c.native("GTypeInstance *", cast)]
const func _as_GTypeInstance(p c.pointer) _p_GTypeInstance

// A C string list, which no call here hands one but `null`.
#[c.native("char **")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.PStrv")]
struct _p_strv {}

#[c.native("GClosure *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.PGClosure")]
struct _p_GClosure {}

