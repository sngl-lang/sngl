import c "sngl:x/c"
import go "sngl:language/go"

// GTK's and GLib's own functions the platform's SNGL calls, beyond the ones
// widgets.sngl declares to make, fill and write a widget: what the runtime
// asks of a widget, written once in SNGL rather than in rt/'s C. Each is
// declared as the C function it is, and a class's pointer and cast are
// widgets.sngl's.

