// Runs set with each handler of signal o has, on detail where it is not "",
// blocked: what the program sets is no input, and reports nothing.
func _quietly(o c.pointer, signal string, on _c_GType, detail string, set func()) {
    var obj = _as_gpointer(o)
    var id = _g_signal_lookup(signal, on)
    var mask = detail == "" ? _matchID : _matchID + _matchDetail
    var q = _g_quark_from_string(detail)
    _g_signal_handlers_block_matched(obj, mask, id, q, null, null, null)
    set()
    _g_signal_handlers_unblock_matched(obj, mask, id, q, null, null, null)
}

