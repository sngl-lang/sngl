// GLib's type of a class, which a signal is looked up on.
#[c.native("GType")]
struct _c_GType = int

// GLib's interned string, which names a signal's detail.
#[c.native("GQuark")]
struct _c_GQuark = int

// GLib's untyped pointer, which cgo holds apart from C's `void *`.
#[c.native("gpointer")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CGpointer")]
struct _c_gpointer {}

#[c.native("gpointer", cast)]
const func _as_gpointer(p c.pointer) _c_gpointer

// What a block matches a handler by: G_SIGNAL_MATCH_ID and
// G_SIGNAL_MATCH_DETAIL.
#[c.native("GSignalMatchType")]
struct _c_GSignalMatchType = int

