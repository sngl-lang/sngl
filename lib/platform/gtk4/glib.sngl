#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GQuarkFromString")]
func _g_quark_from_string(s string) _c_GQuark

const _matchID = 1

const _matchDetail = 2

#[c.native("g_signal_handlers_block_matched")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GSignalHandlersBlockMatched")]
func _g_signal_handlers_block_matched(
    o       _c_gpointer,
    mask    _c_GSignalMatchType,
    id      _c_guint,
    detail  _c_GQuark,
    closure option[_p_GClosure],
    fn      option[_c_gpointer],
    data    option[_c_gpointer],
) _c_guint

#[c.native("g_signal_handlers_unblock_matched")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GSignalHandlersUnblockMatched")]
func _g_signal_handlers_unblock_matched(
    o       _c_gpointer,
    mask    _c_GSignalMatchType,
    id      _c_guint,
    detail  _c_GQuark,
    closure option[_p_GClosure],
    fn      option[_c_gpointer],
    data    option[_c_gpointer],
) _c_guint

