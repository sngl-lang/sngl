// GLib's connection flags, none of which a handler here asks for.
#[c.native("GConnectFlags")]
struct _c_GConnectFlags = int

// Connects fn to a property's change on o: GLib calls it with the object and
// the property's spec, then the context.
#[c.native("g_signal_connect_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GSignalConnectData")]
func _g_signal_connect_notify(
    o      _c_gpointer,
    signal string,
    #[c.type("GCallback")] fn func(o _p_GObject, spec _p_GParamSpec),
    #[c.context] ctx _c_gpointer,
    #[c.type("GClosureNotify")] #[c.release] rel c.pointer,
    flags  _c_GConnectFlags,
)

