// A scroll's report posted and not run: the idle source, held on the scroll
// and destroyed as it is let go.
#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.HoldSource")]
func _holdSource(o _Object, key string, data _Pointer, #[c.type("GDestroyNotify")] #[c.static] gone func(p _Pointer))

// What the program says of a scroll -- the axis its end is read on, 0 down,
// 1 across and 2 both ways, read down, and what runs as the end arrives --
// and what the scroll read last: whether the end showed, and the content's
// length then, -1 before it was measured.
struct _ScrollState {
    axis     int = 0
    near     bool = false
    content  int = -1
    reachEnd func() = func() {}
}

// What a scroll's probe keeps: whether the scroll's end is read across,
// and the content's natural length along that axis as the probe was last
// allocated, -1 before it has been.
struct _ProbeState {
    across  bool = false
    content int = -1
}

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdScroll(o _Object, key string, #[c.type("gpointer")] s c.held[_ScrollState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldScroll(o _Object, key string) option[c.held[_ScrollState]]

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdProbe(o _Object, key string, #[c.type("gpointer")] s c.held[_ProbeState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldProbe(o _Object, key string) option[c.held[_ProbeState]]

func _scrollOf(sw Widget) option[_ScrollState] {
    return _heldScroll(_object(sw), "sngl-scroll")
}

func _setScroll(sw Widget, s _ScrollState) {
    _holdScroll(_object(sw), "sngl-scroll", s)
}

func _probeOf(probe Widget) option[_ProbeState] {
    return _heldProbe(_object(probe), "sngl-probe-state")
}

func _setProbe(probe Widget, s _ProbeState) {
    _holdProbe(_object(probe), "sngl-probe-state", s)
}

// The probe a scroll holds.
func _probeIn(sw Widget) option[Widget] {
    return _dataWidget(_object(sw), "sngl-probe")
}

// Forgets what the probe measured: its content is new, or read another way.
func _probeForget(probe Widget) {
    var p = _probeOf(probe)
    if p != null {
        _setProbe(probe, _ProbeState{across=p.across, content=-1})
    }
}

func _sourceGone(p _Pointer) {
    var s = _sourceOf(p)
    _sourceDestroy(s)
    _sourceUnref(s)
}

// The report the idle source posts: run as the main loop is next idle,
// rather than as the adjustment changes, since that is while GTK
// allocates, and a handler adding rows then would change the tree
// mid-allocation. It runs once.
func _scrollReport(data _Pointer) bool {
    var sw = _pointed(data)
    _setData(_object(sw), "sngl-asked", null)
    var s = _scrollOf(sw)
    if s != null {
        s.reachEnd()
    }
    return false
}

// Reads the scroll's end afresh, posting a report where it came within
// half a viewport of showing, or the content grew while it showed.
func _scrollChanged(sw Widget) {
    var s = _scrollOf(sw)
    if s != null {
        var a = s.axis == 1 ? _scrolledAcross(_scrolledOf(sw)) : _scrolledDown(_scrolledOf(sw))
        var upper = _adjustmentUpper(a)
        var value = _adjustmentValue(a)
        var page = _adjustmentPage(a)
        if page <= 0.0 {
            return
        }
        var near = upper - (value + page) <= page / 2.0
        var content = -1
        var probe = _probeIn(sw)
        if probe != null {
            var p = _probeOf(probe)
            if p != null {
                content = p.content
            }
        }
        var fire = near && (!s.near || content > s.content)
        _setScroll(sw, _ScrollState{axis=s.axis, near=near, content=content, reachEnd=s.reachEnd})
        if fire && _data(_object(sw), "sngl-asked") == null {
            var source = _idleSource()
            _sourceSetCallback(source, _scrollReport, _pointer(sw), null)
            _sourceAttach(source, null)
            _holdSource(_object(sw), "sngl-asked", _sourcePointer(source), _sourceGone)
        }
    }
}

// An adjustment of the scroll changed: gobject is the scroll, which the
// connection lives no longer than.
func _scrollAdjusted(adjustment _Pointer, gobject _Pointer) {
    _scrollChanged(_pointed(gobject))
}

// Whether the scroll whose probe w is reads its end across.
func _probeAcross(w Widget) bool {
    var p = _probeOf(w)
    return p != null && p.across
}

// The probe was allocated, its content natural long along the axis the
// end is read on: a change is the scroll's to read.
func _probeMeasured(w Widget, natural int) {
    var p = _probeOf(w)
    if p != null {
        if natural != p.content {
            _setProbe(w, _ProbeState{across=p.across, content=natural})
            var sw = _ancestorOf(w, _scrolledType())
            if sw != null {
                _scrollChanged(sw)
            }
        }
    }
}

// The scrolled window's policies, and its scrollable's, for the axis it
// moves along. GTK_POLICY_AUTOMATIC is 1, _NEVER 2 and _EXTERNAL 3;
// GTK_SCROLL_MINIMUM is 0 and _NATURAL 1.
func _scrollPolicies(sw Widget) {
    var axis = 0
    var s = _scrollOf(sw)
    if s != null {
        axis = s.axis
    }
    _scrolledSetPolicy(_scrolledOf(sw), _Policy(axis == 0 ? 3 : 1), _Policy(axis == 1 ? 2 : 1))
    _scrolledSetNaturalWidth(_scrolledOf(sw), axis == 0)
    var c = _scrolledChild(_scrolledOf(sw))
    if c != null {
        if _isScrollable(c) {
            _scrollablePolicies(c, axis)
        } else {
            var up = _parentOf(c)
            if up != null {
                if _isScrollable(up) {
                    _scrollablePolicies(up, axis)
                }
            }
        }
    }
}

func _isScrollable(w Widget) bool {
    return _isA(_instanceOf(_pointer(w)), _scrollableType())
}

func _scrollablePolicies(w Widget, axis int) {
    _scrollableSetDown(_scrollableOf(w), _ScrollablePolicy(axis != 1 ? 1 : 0))
    _scrollableSetAcross(_scrollableOf(w), _ScrollablePolicy(axis != 0 ? 1 : 0))
}

// A child set that is not the probe is the content, and goes in the probe,
// which becomes the child.
func _scrollChild(sw Widget) {
    _scrollPolicies(sw)
    var probe = _probeIn(sw)
    var set = _scrolledChild(_scrolledOf(sw))
    if probe != null && set != null {
        if set != probe {
            if _isA(_instanceOf(_pointer(set)), _viewportType()) {
                var inner = _viewportChild(_viewportOf(set))
                if inner != null {
                    if inner != probe {
                        _scrollTake(sw, probe, inner)
                    }
                }
            } else {
                _scrollTake(sw, probe, set)
            }
        }
    }
}

// Puts content in the probe, in place of what it held, and the probe in
// the scroll.
func _scrollTake(sw Widget, probe Widget, content Widget) {
    _ref(_pointer(content))
    var emptied = false
    for !emptied {
        var k = _firstChild(probe)
        if k != null {
            _boxRemove(_boxOf(probe), k)
        } else {
            emptied = true
        }
    }
    _probeForget(probe)
    _scrolledSetChild(_scrolledOf(sw), probe)
    _boxAppend(_boxOf(probe), content)
    _unref(_pointer(content))
}

func _rtScrollNew(layout LayoutManager) Scroll {
    var sw = _scrolledNew()
    _setScroll(sw, _ScrollState{})
    var probe = _boxNew(1, 0)
    _setLayoutManager(probe, layout)
    _setProbe(probe, _ProbeState{})
    _refSink(_pointer(probe))
    _holdData(_object(sw), "sngl-probe", _pointer(probe), _unrefData)
    _rtNotifyConnect(_asScroll(sw), "notify::child", func() { _scrollChild(sw) })
    var down = _adjustmentPointer(_scrolledDown(_scrolledOf(sw)))
    var across = _adjustmentPointer(_scrolledAcross(_scrolledOf(sw)))
    _connectObject(down, "changed", _scrollAdjusted, _pointer(sw), _ConnectFlags(0))
    _connectObject(down, "value-changed", _scrollAdjusted, _pointer(sw), _ConnectFlags(0))
    _connectObject(across, "changed", _scrollAdjusted, _pointer(sw), _ConnectFlags(0))
    _connectObject(across, "value-changed", _scrollAdjusted, _pointer(sw), _ConnectFlags(0))
    _scrollPolicies(sw)
    return _asScroll(sw)
}

// Sets the scroll's content, leaving content its probe already holds where
// it is.
func _rtScrollSetChild(scroll Scroll, child ui.node) {
    var sw = _handle(scroll)
    var probe = _probeIn(sw)
    var up = _parentOf(_handle(child))
    if probe != null && up != null {
        if up == probe {
            return
        }
    }
    _scrolledSetChild(_scrolledOf(sw), _handle(child))
}

// "horizontal" moves across and "both" both ways; anything else down. A
// scroll turned reads its end afresh.
func _rtScrollSetDirection(scroll Scroll, direction string) {
    var sw = _handle(scroll)
    var axis = 0
    if direction == "horizontal" {
        axis = 1
    } else if direction == "both" {
        axis = 2
    }
    var s = _scrollOf(sw)
    if s != null {
        _setScroll(sw, _ScrollState{axis=axis, near=false, content=-1, reachEnd=s.reachEnd})
    }
    _scrollPolicies(sw)
    var probe = _probeIn(sw)
    if probe != null {
        _setProbe(probe, _ProbeState{across=axis == 1, content=-1})
        _queueAllocate(probe)
    }
}

func _rtScrollOnReachEnd(scroll Scroll, reachEnd func()) {
    var sw = _handle(scroll)
    var s = _scrollOf(sw)
    if s != null {
        _setScroll(sw, _ScrollState{axis=s.axis, near=s.near, content=s.content, reachEnd=reachEnd})
    }
}

// Runs the scroll's handler, as a test does.
func _rtScrollReachEnd(scroll Scroll) {
    var s = _scrollOf(_handle(scroll))
    if s != null {
        s.reachEnd()
    }
}

#[gen.protocol(create)]
func _create_Scroll() Scroll {
    return _rtScrollNew(_customLayout(_probeMode, _probeMeasure, _probeAllocate))
}

#[gen.protocol(append)]
func _append_Scroll(parent Scroll, child ui.node) {
    _rtScrollSetChild(parent, child)
}

#[gen.protocol(set)]
func _set_Scroll_direction(w Scroll, direction string) {
    _rtScrollSetDirection(w, direction)
}

#[gen.protocol(set)]
func _set_Scroll_look(w Scroll, look Look) {
    _setLook(w, look)
}

#[gen.protocol(on)]
func _on_Scroll(sw Scroll, reachEnd func()) {
    _rtScrollOnReachEnd(sw, reachEnd)
}

#[gen.fires("reachEnd")]
func _fire_Scroll_reachEnd(sw Scroll) {
    _rtScrollReachEnd(sw)
}

const component ui.scroll[platform](style, direction, @reachEnd, content) {
    Scroll(direction=string(direction), look=lookOf(style), @reachEnd { reachEnd() }) {
        content
    }
}

// A `ui.tabs`: a box of a GtkNotebook (see "A tabs" below). Each
// TabPage it holds is a page of the notebook, and `selected` the one shown.
#[marks.intrinsic("gtk4:Tabs")]
component Tabs(
    selected int,
    look     Look,
    pages    ...component ui.node,
) ui.node

// One tab: its panel, a page the notebook shows a tab titled `title` for.
// The user choosing it is no GTK signal on it but the notebook's page
// changing, which the runtime reports as `@change`, and only the user's.
// Named for the tabs' event it raises, which is what a test's press of it
// calls.
#[marks.intrinsic("gtk4:TabPage")]
component TabPage(
    title    string,
    disabled bool = false,
    @change(),
    content  ...component ui.node,
) ui.node

// --- A tabs, with no struct of its own ---
//
// A tabs is a box holding a GtkNotebook, its one child, whose pages are the
// tab pages the box is handed, in the order it was handed them: a page
// appended or inserted into the box is appended to the notebook, and
// removing one takes it out. What the program says of the tabs -- the page
// it selected -- is a value C holds on the box, and of a page -- its title,
// whether it is disabled and what runs as the user chooses it -- one held on
// the page. The runtime's box calls, which a slot renders through, hand a
// tabs's append and remove to the two functions sngl_tabs_hooks is handed.

#[c.native("GtkNotebook *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Notebook")]
struct _Notebook {}

#[c.native("GtkNotebook *", cast)]
func _notebookOf(w Widget) _Notebook

#[c.native("GtkBox *", cast)]
func _boxOf(w Widget) _p_GtkBox

#[c.native("GtkWidget *", cast)]
func _asTabs(w Widget) Tabs

#[c.native("GtkWidget *", cast)]
func _asTabPage(w Widget) TabPage

#[c.native("gtk_notebook_get_type")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookGetType")]
func _notebookType() _Type

// What the program says of a tabs: the page it selected, and whether the
// runtime is changing the page shown, which GTK reports as it would the
// user's.
struct _TabsState {
    selected int = 0
    quiet    bool = false
}

// What the program says of a tab page: its tab's title, whether it is
// disabled, and what runs as the user chooses it.
struct _TabPageState {
    title    string = ""
    disabled bool = false
    shown    func() = func() {}
}

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdTabs(o _Object, key string, #[c.type("gpointer")] s c.held[_TabsState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldTabs(o _Object, key string) option[c.held[_TabsState]]

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdTabPage(o _Object, key string, #[c.type("gpointer")] s c.held[_TabPageState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldTabPage(o _Object, key string) option[c.held[_TabPageState]]

#[c.native("gtk_box_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.BoxNew")]
func _boxNew(orientation Orientation, spacing int) Widget

#[c.native("gtk_box_append")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkBoxAppend")]
func _boxAppend(box _p_GtkBox, child Widget)

#[c.native("gtk_notebook_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookNew")]
func _notebookNew() Widget

#[c.native("gtk_notebook_set_scrollable")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookSetScrollable")]
func _notebookSetScrollable(nb _Notebook, scrollable bool)

#[c.native("gtk_notebook_get_n_pages")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookGetNPages")]
func _notebookPages(nb _Notebook) int

#[c.native("gtk_notebook_get_nth_page")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookGetNthPage")]
func _notebookPage(nb _Notebook, at int) option[Widget]

#[c.native("gtk_notebook_page_num")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookPageNum")]
func _notebookPageNum(nb _Notebook, page Widget) int

#[c.native("gtk_notebook_get_current_page")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookGetCurrentPage")]
func _notebookCurrent(nb _Notebook) int

#[c.native("gtk_notebook_set_current_page")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookSetCurrentPage")]
func _notebookSetCurrent(nb _Notebook, at int)

#[c.native("gtk_notebook_append_page")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookAppendPage")]
func _notebookAppend(nb _Notebook, page Widget, label option[Widget]) int

#[c.native("gtk_notebook_remove_page")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookRemovePage")]
func _notebookRemove(nb _Notebook, at int)

#[c.native("gtk_notebook_get_tab_label")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookGetTabLabel")]
func _notebookTabLabel(nb _Notebook, page Widget) option[Widget]

#[c.native("gtk_notebook_set_tab_label_text")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookSetTabLabelText")]
func _notebookSetTabText(nb _Notebook, page Widget, text string)

#[c.native("gtk_widget_get_parent")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetParent")]
func _parentOf(w Widget) option[Widget]

#[c.native("gtk_widget_get_ancestor")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetAncestor")]
func _ancestorOf(w Widget, of _Type) option[Widget]

#[c.native("gtk_widget_set_sensitive")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SetSensitive")]
func _setSensitive(w Widget, sensitive bool)

// Hands the runtime's box calls the functions a tabs's append and remove
// are, each answering whether the box is a tabs.
#[c.native("sngl_tabs_hooks")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglTabsHooks")]
func _tabsHooks(
    #[c.type("SnglTabsHook")] #[c.static] add func(box Widget, child Widget) bool,
    #[c.type("SnglTabsHook")] #[c.static] remove func(box Widget, child Widget) bool,
)

func _tabsOf(box Widget) option[_TabsState] {
    return _heldTabs(_object(box), "sngl-tabs")
}

func _setTabs(box Widget, t _TabsState) {
    _holdTabs(_object(box), "sngl-tabs", t)
}

func _tabPageOf(page Widget) option[_TabPageState] {
    return _heldTabPage(_object(page), "sngl-tab-page")
}

func _setTabPage(page Widget, s _TabPageState) {
    _holdTabPage(_object(page), "sngl-tab-page", s)
}

// The notebook a tabs holds, which a box it let go of no longer does.
func _notebookIn(box Widget) option[Widget] {
    return _firstChild(box)
}

// Sets whether the runtime is changing the page shown.
func _tabsQuiet(box Widget, quiet bool) {
    var t = _tabsOf(box)
    if t != null {
        _setTabs(box, _TabsState{selected=t.selected, quiet=quiet})
    }
}

// Shows the page the program selected, where there is one.
func _tabsShow(box Widget) {
    var t = _tabsOf(box)
    var nb = _notebookIn(box)
    if t != null && nb != null {
        if t.selected >= 0 && t.selected < _notebookPages(_notebookOf(nb)) {
            _tabsQuiet(box, true)
            _notebookSetCurrent(_notebookOf(nb), t.selected)
            _tabsQuiet(box, false)
        }
    }
}

// A disabled page's tab is insensitive. GTK still lets the user click it,
// and _tabsShown puts the program's page back.
func _tabsSensitive(nb _Notebook) {
    var n = _notebookPages(nb)
    var i = 0
    for i < n {
        var page = _notebookPage(nb, i)
        if page != null {
            var s = _tabPageOf(page)
            var label = _notebookTabLabel(nb, page)
            if label != null {
                _setSensitive(label, !(s != null && s.disabled))
            }
        }
        i += 1
    }
}

// The notebook showing another page: the user's choice, unless it is a
// disabled page's, which the program's own page replaces. A notebook its
// box let go of is being torn down, and the pages it drops as it goes are
// no one's choice.
func _tabsShown(box Widget) {
    var t = _tabsOf(box)
    var nb = _notebookIn(box)
    if t != null && nb != null {
        var k = _notebookCurrent(_notebookOf(nb))
        if t.quiet || _parentOf(nb) == null || k < 0 || k == t.selected {
            return
        }
        var shown = _notebookPage(_notebookOf(nb), k)
        if shown != null {
            var s = _tabPageOf(shown)
            var chosen = false
            if s != null {
                if !s.disabled {
                    _setTabs(box, _TabsState{selected=k, quiet=t.quiet})
                    s.shown()
                    chosen = true
                }
            }
            if !chosen {
                _tabsShow(box)
            }
        }
    }
}

// The notebook reports the page it shows through its `page` property,
// after the change, where `switch-page` fires before it.
func _rtTabsNew() Tabs {
    _tabsHooks(_tabsAdd, _tabsRemove)
    var box = _boxNew(1, 0)
    var nb = _notebookNew()
    _notebookSetScrollable(_notebookOf(nb), true)
    _boxAppend(_boxOf(box), nb)
    _setTabs(box, _TabsState{})
    _rtNotifyConnect(_asTabs(nb), "notify::page", func() { _tabsShown(box) })
    return _asTabs(box)
}

func _rtTabsSetSelected(tabs Tabs, k int) {
    var box = _handle(tabs)
    var t = _tabsOf(box)
    if t != null {
        _setTabs(box, _TabsState{selected=k, quiet=t.quiet})
        _tabsShow(box)
    }
}

// A box's append where it is a tabs, and whether it is: page becomes the
// notebook's last, once.
func _tabsAdd(box Widget, page Widget) bool {
    var nb = _notebookIn(box)
    if _tabsOf(box) != null && nb != null {
        var s = _tabPageOf(page)
        if s != null {
            if _notebookPageNum(_notebookOf(nb), page) < 0 {
                _tabsQuiet(box, true)
                _notebookAppend(_notebookOf(nb), page, null)
                _tabsQuiet(box, false)
                _notebookSetTabText(_notebookOf(nb), page, s.title)
                _tabsSensitive(_notebookOf(nb))
                _tabsShow(box)
            }
        }
        return true
    }
    return false
}

// A box's remove where it is a tabs, and whether it is.
func _tabsRemove(box Widget, page Widget) bool {
    var nb = _notebookIn(box)
    if _tabsOf(box) != null && nb != null {
        var at = _notebookPageNum(_notebookOf(nb), page)
        if at >= 0 {
            _tabsQuiet(box, true)
            _notebookRemove(_notebookOf(nb), at)
            _tabsQuiet(box, false)
            _tabsSensitive(_notebookOf(nb))
            _tabsShow(box)
        }
        return true
    }
    return false
}

// The notebook showing page as one of its own, where one does.
func _hostOf(page Widget) option[Widget] {
    var nb = _ancestorOf(page, _notebookType())
    if nb != null {
        if _notebookPageNum(_notebookOf(nb), page) >= 0 {
            return nb
        }
    }
    return null
}

func _rtTabPageNew() TabPage {
    var page = _boxNew(1, 0)
    _setTabPage(page, _TabPageState{})
    return _asTabPage(page)
}

func _rtTabPageSetTitle(p TabPage, title string) {
    var page = _handle(p)
    var s = _tabPageOf(page)
    if s != null {
        _setTabPage(page, _TabPageState{title=title, disabled=s.disabled, shown=s.shown})
        var nb = _hostOf(page)
        if nb != null {
            _notebookSetTabText(_notebookOf(nb), page, title)
        }
    }
}

func _rtTabPageSetDisabled(p TabPage, disabled bool) {
    var page = _handle(p)
    var s = _tabPageOf(page)
    if s != null {
        _setTabPage(page, _TabPageState{title=s.title, disabled=disabled, shown=s.shown})
        var nb = _hostOf(page)
        if nb != null {
            _tabsSensitive(_notebookOf(nb))
        }
    }
}

// What runs as the user chooses the page.
func _rtTabPageOnShown(p TabPage, shown func()) {
    var page = _handle(p)
    var s = _tabPageOf(page)
    if s != null {
        _setTabPage(page, _TabPageState{title=s.title, disabled=s.disabled, shown=shown})
    }
}

// Runs the page's handler as the user choosing it does, as a test does.
func _rtTabPageShow(p TabPage) {
    var s = _tabPageOf(_handle(p))
    if s != null {
        if !s.disabled {
            s.shown()
        }
    }
}

#[gen.protocol(create)]
func _create_Tabs() Tabs {
    return _rtTabsNew()
}

#[gen.protocol(append)]
func _append_Tabs(parent Tabs, page ui.node) {
    _sngl_box_append(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(page)))
}

#[gen.protocol(insertBefore)]
func _insert_Tabs(parent Tabs, page ui.node, before ui.node) {
    _sngl_box_insert_before(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(before)), _as_GtkWidget(_widget(page)))
}

#[gen.protocol(remove)]
func _remove_Tabs(parent Tabs, page ui.node) {
    _rtBoxRemove(parent, page)
}

#[gen.protocol(set)]
func _set_Tabs_selected(t Tabs, selected int) {
    _rtTabsSetSelected(t, selected)
}

#[gen.protocol(set)]
func _set_Tabs_look(t Tabs, look Look) {
    _setLook(t, look)
}

#[gen.protocol(create)]
func _create_TabPage() TabPage {
    return _rtTabPageNew()
}

#[gen.protocol(append)]
func _append_TabPage(parent TabPage, child ui.node) {
    _sngl_box_append(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(child)))
}

#[gen.protocol(insertBefore)]
func _insert_TabPage(parent TabPage, child ui.node, before ui.node) {
    _sngl_box_insert_before(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(before)), _as_GtkWidget(_widget(child)))
}

#[gen.protocol(remove)]
func _remove_TabPage(parent TabPage, child ui.node) {
    _rtBoxRemove(parent, child)
}

#[gen.protocol(set)]
func _set_TabPage_title(p TabPage, title string) {
    _rtTabPageSetTitle(p, title)
}

#[gen.protocol(set)]
func _set_TabPage_disabled(p TabPage, disabled bool) {
    _rtTabPageSetDisabled(p, disabled)
}

#[gen.protocol(on)]
func _on_TabPage(p TabPage, change func()) {
    _rtTabPageOnShown(p, change)
}

#[gen.fires("change")]
func _fire_TabPage_change(p TabPage) {
    _rtTabPageShow(p)
}

// A tab is a page of a GtkNotebook, which shows a tab for it. `variant` is
// the notebook's look, which GTK's theme draws.
const component ui.tabs[platform](selected, style, @change, items) {
    Tabs(selected=selected, look=lookOf(style)) {
        for var k, t = items {
            TabPage(title=t.label, disabled=t.disabled, @change {
                selected = k
                change(k)
            }) {
                t.content
            }
        }
    }
}

// --- Indicators ---

// GtkProgressBar's fraction is 0..1, so the value is measured against max here
// rather than passed through as if it already were one.
//
// GTK spells indeterminate as repeated gtk_progress_bar_pulse() calls rather
// than as a property, and an override has no clock to drive them, so a bar
// given no value is an empty one. Written as two calls rather than as one with
// a ternary because a ternary is lowered to a temporary on a language with no
// conditional expression, and that happens before the fold that would have
// settled it -- `C.double(__lt0)` where `__lt0 = (2 / 10)`, which is Go
// integer division.
const component ui.progress[platform](style, value, max, label, showValue) {
    if value != null {
        GtkProgressBar(fraction=value / max, text=label, showText=showValue, look=lookOf(style)) {}
    } else {
        GtkProgressBar(fraction=0.0, text=label, showText=showValue, look=lookOf(style)) {}
    }
}

const component ui.spinner[platform](label, style) {
    GtkSpinner(spinning=true, tooltipText=label, look=lookOf(style)) {}
}

// `direction` is not forwarded: orientation is a GtkOrientation, and the
// only SNGL value that reaches a GTK enum is a string literal naming one of
// its members, which the prop's set folds to the member's value where it is
// written — a prop reference has no compile-time member to name. A separator is therefore horizontal, which is what
// `direction` defaults to.
const component ui.divider[platform](style) {
    GtkSeparator(look=lookOf(style)) {}
}

const component ui.link[platform](text, href, disabled, focusable, style, @click) {
    GtkLinkButton(uri=href, label=text, sensitive=(disabled == false), canFocus=focusable, look=lookOf(style), @clicked { click() }) {}
}

// A flip reaches the program through `notify::active`: GtkSwitch's own
// `state-set` returns a gboolean, which the connect trampoline cannot carry.
const component ui.toggle[platform](checked, disabled, focusable, style, @change) {
    GtkSwitch(active=checked, sensitive=(disabled == false), canFocus=focusable, look=lookOf(style), @notifyActive(s) {
        if switchActive(s) != checked {
            checked = switchActive(s)
            change(checked)
        }
    }) {}
}

// One calendar, which a bound date selects whenever it changes. With no date
// it shows GTK's own, today: a calendar always has a day selected.
const component ui.datepicker[platform](value, disabled, style, @change) {
    GtkCalendar #cal(sensitive=(disabled == false), look=lookOf(style), @daySelected(c) {
        value = calendarDate(c)
        change(value)
    }) {}
    effect(on=value, @mount(v) {
        if v != null {
            selectDay(cal, v.year(), v.month(), v.day())
        }
    })
}

// --- Layout ---

const component ui.spacer[platform](style) {
    GtkBox(look=lookOf({flex=1, ...style})) {}
}

// The same shape html uses: a wrapper carrying the tooltip text, with the
// wrapped content inside it.
const component ui.tooltip[platform](style, text, trigger) {
    GtkBox(tooltipText=text, look=lookOf(style)) {
        trigger
    }
}

// A clickable card is its frame inside a frameless GtkButton, which gives it
// the hover, the press and the focus stop a button has.
const component ui.card[platform](style, clickable, @click, content) {
    if clickable {
        GtkButton(hasFrame=false, look=lookOf(style), @clicked { click() }) {
            GtkFrame(look=innerFrameLookOf(style)) {
                content
            }
        }
    } else {
        GtkFrame(look=lookOf(style)) {
            content
        }
    }
}

const component ui.stack[platform](style, layers) {
    GtkStack(look=lookOf(style)) {
        layers
    }
}

// `open` reaches the popover as widget visibility rather than as
// gtk_popover_popup: the emitter has one setter path per property and
// popup/popdown is a pair of calls chosen by the value. `position` is a
// GtkPositionType, so it is unreachable for the same reason as divider's
// orientation.
const component ui.popover[platform](style, open, @close, content) {
    GtkPopover(visible=open && shown(style), autohide=true, look=lookBesideVisible(style), @closed { close() }) {
        content
    }
}

// A check button's `active` marks a table's or a tree's selection. Clicking
// the selected one unchecks it on screen and changes nothing, since GTK has no
// way here to refuse the toggle.

// A row per box, each homogeneous so every cell takes an equal share and the
// columns line up. GtkColumnView is GTK's table, but it is fed through a list
// model and item factories, which nothing here can declare. A selectable table
// leads each row with a check button that selects it; a sortable header's
// cells are buttons reporting the column.
const component ui.table[platform](style, columns, selectable, selected, sortable, @select, @sort, rows) {
    GtkBox(orientation="vertical", look=boxLookOf(style, 0)) {
        GtkBox(orientation="horizontal", homogeneous=true) {
            if selectable {
                GtkLabel(label="") {}
            }
            for var col = columns {
                if sortable {
                    GtkButton(label=col, @clicked { sort(col) }) {}
                } else {
                    GtkLabel(label=col, xalign=0.0) {}
                }
            }
        }
        GtkSeparator() {}
        for var k, row = rows {
            GtkBox(orientation="horizontal", homogeneous=true) {
                if selectable {
                    GtkCheckButton(active=(k == selected), @toggled(b) {
                        if checkActive(b) && selected != k {
                            selected = k
                            select()
                        }
                    }) {}
                }
                for var cell = row.cells {
                    GtkLabel(label=cell, xalign=0.0) {}
                }
            }
        }
    }
}

// A tree's row: a node's label, and the spaces that indent it to its depth.
struct _TreeRow {
    label  string
    indent string
}

// A tree's rows in traversal order, each node's below it and indented one step
// further.
const func _treeRows(items list[ui.treeItem], indent string) list[_TreeRow] {
    var out list[_TreeRow] = []
    for var it = items {
        out = [...out, _TreeRow{label=it.label, indent=indent}, ..._treeRows(it.children, indent + "    ")]
    }
    return out
}

// Every node is shown, expanded or not: a row cannot be hidden and shown by
// its parent's state without a var, which a const component has none of.
const component ui.tree[platform](style, selected, @select, items) {
    GtkBox(orientation="vertical", look=boxLookOf(style, 0)) {
        for var row = _treeRows(items, "") {
            GtkCheckButton(label=row.indent + row.label, active=(row.label == selected), @toggled(b) {
                if checkActive(b) && selected != row.label {
                    selected = row.label
                    select()
                }
            }) {}
        }
    }
}

const component ui.radio[platform](value, disabled, direction, style, @change, options) {
    // A choice of the option holding `v`, a button's or a test's.
    func pickValue(v T) {
        if v != value {
            value = v
            change(v)
        }
    }
    if direction == ui.Orientation.horizontal {
        GtkBox(orientation="horizontal", sensitive=(disabled == false), look=boxLookOf(style, 6)) {
            for var opt = options {
                GtkCheckButton(label=opt.label, active=(opt.value == value), @toggled(b) {
                    if checkActive(b) {
                        pickValue(opt.value)
                    }
                }) {}
            }
        }
    } else {
        GtkBox(orientation="vertical", sensitive=(disabled == false), look=boxLookOf(style, 6)) {
            for var opt = options {
                GtkCheckButton(label=opt.label, active=(opt.value == value), @toggled(b) {
                    if checkActive(b) {
                        pickValue(opt.value)
                    }
                }) {}
            }
        }
    }
}

// A test picks the option holding `value` as pressing its button does.
func ui.radio[T].change[platform](value) {
    pickValue(value)
}

// One drop-down, offered the choices' labels whenever they change and
// selecting the label of the bound value whenever it does. `placeholder` and
// the focus events have nothing to reach.
const component ui.select[platform](value, disabled, focusable, style, @change, options) {
    GtkDropDown #drop(sensitive=(disabled == false), canFocus=focusable, look=lookOf(style), @notifySelected(d) {
        var at = ui.choiceLabeled(options, dropDownLabel(d))
        if at >= 0 && options[at].value != value {
            value = options[at].value
            change(options[at].value)
        }
    }) {}
    // Keyed on the drop-down as well as its labels, so a render that builds
    // the drop-down afresh offers the new one its choices: an effect whose
    // key reads a node mounts again wherever the node is built.
    effect(on={labels=options.map(func(o) => o.label).format("\n"), drop=drop}, @mount(k) {
        offerChoices(drop, k.labels, ui.choiceLabel(options, value))
    })
    effect(on=value, @mount(v) {
        offerChoices(drop, options.map(func(o) => o.label).format("\n"), ui.choiceLabel(options, v))
    })
}

// A test picks the choice holding `value` through the drop-down, which
// knows its choices by label.
func ui.select[T].change[platform](value) {
    selectLabel(drop, ui.choiceLabel(options, value))
}

// A menu's top-level entries, as html shows them; a submenu has nowhere to
// open without a var.
const component ui.menubar[platform](style, items) {
    GtkBox(orientation="horizontal", look=boxLookOf(style, 4)) {
        for var it = items {
            GtkButton(label=it.label, sensitive=(it.disabled == false), @clicked { it.select() }) {}
        }
    }
}

const component ui.menu[platform](style, open, items) {
    if open {
        GtkBox(orientation="vertical", look=boxLookOf(style, 0)) {
            for var it = items {
                GtkButton(label=it.label, sensitive=(it.disabled == false), @clicked { it.select() }) {}
            }
        }
    }
}

const component ui.toolbar[platform](style, controls) {
    GtkBox(orientation="horizontal", look=boxLookOf(style, 4)) {
        controls
    }
}

// GtkPaned holds exactly two panes, so the panes share a box evenly instead
// and `position` and its bounds have nothing to reach.
const component ui.splitview[platform](style, direction, panes) {
    if direction == "vertical" {
        GtkBox(orientation="vertical", homogeneous=true, look=lookOf(style)) {
            panes
        }
    } else {
        GtkBox(orientation="horizontal", homogeneous=true, look=lookOf(style)) {
            panes
        }
    }
}

const component ui.drawer[platform](style, open, content) {
    GtkBox(orientation="vertical", visible=open && shown(style), look=boxLookBesideVisible(style, 6)) {
        content
    }
}

// Shown in place rather than in a window of its own, as html shows it in the
// page.
const component ui.modal[platform](style, open, title, closable, @close, content) {
    GtkFrame(visible=open && shown(style), look=lookBesideVisible(style)) {
        GtkBox(orientation="vertical", spacing=6) {
            if title != "" || closable {
                GtkBox(orientation="horizontal", spacing=6) {
                    GtkLabel(label=title, xalign=0.0, hexpand=true) {}
                    if closable {
                        GtkButton(label="Close", @clicked { close() }) {}
                    }
                }
            }
            content
        }
    }
}

// --- Rich text ---

// A flow is one GtkLabel, and the spans in it its Pango markup, which nests
// as they do: `<b><i>x</i></b>` is what `bold { italic { … } }` means, so
// Pango resolves the cascade. A span is no widget: it holds its words, its
// link and the tags its style opens and closes, which _rtSpanStyle writes
// from what the style sets; any change to one sets its flow's markup again
// (the functions below, under "A span, with no class of its own").
#[marks.intrinsic("gtk4:Flow")]
component Flow(
    look    Look,
    content ...component markup.span,
) ui.node

#[marks.intrinsic("gtk4:Span")]
component Span(
    words     string = "",
    href      string = "",
    spanStyle markup.SpanStyle,
    content   ...component markup.span,
) markup.span

#[c.native("sngl_flow_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglFlowNew")]
func _rtFlowNew() Flow

// --- A span, with no class of its own ---
//
// A span is no widget and no GObject subclass: it is a GListStore, the
// spans in it, with what it says kept on it as a value C holds, and the
// span or flow it is in as a pointer it does not hold. It is handed about
// as every node is, as a GtkWidget pointer, and is one only to the
// functions here. A flow holds its spans in a store of its own. Any change
// sets its flow's markup again, whole.
#[c.native("GObject *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Object")]
struct _Object {}

#[c.native("GListStore *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Store")]
struct _Store {}

#[c.native("gpointer", pointer)]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Pointer")]
struct _Pointer {}

#[c.native("GListModel *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Model")]
struct _Model {}

#[c.native("GType")]
struct _Type = int

#[c.native("guint")]
struct _Count = int

#[c.native("GObject *", cast)]
func _object(w Widget) _Object

#[c.native("GListStore *", cast)]
func _store(w Widget) _Store

#[c.native("GListModel *", cast)]
func _model(s _Store) _Model

#[c.native("gpointer", cast)]
func _pointer(w Widget) _Pointer

#[c.native("GtkWidget *", cast)]
func _pointed(p _Pointer) Widget

#[c.native("GtkWidget *", cast)]
func _storeWidget(s _Store) Widget

#[c.native("GtkWidget *", cast)]
func _spanHandle(s markup.span) Widget

#[c.native("GtkWidget *", cast)]
func _asSpan(w Widget) Span

#[c.native("g_object_get_type")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetType")]
func _objectType() _Type

#[c.native("g_list_store_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GListStoreNew")]
func _storeNew(of _Type) _Store

#[c.native("g_list_store_append")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GListStoreAppend")]
func _storeAppend(s _Store, item _Pointer)

#[c.native("g_list_store_insert")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GListStoreInsert")]
func _storeInsert(s _Store, at _Count, item _Pointer)

#[c.native("g_list_store_remove")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GListStoreRemove")]
func _storeRemove(s _Store, at _Count)

#[c.native("g_list_store_find")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GListStoreFind")]
func _storeFind(s _Store, item _Pointer, at ref[_Count]) bool

#[c.native("g_list_model_get_n_items")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GListModelGetNItems")]
func _modelCount(m _Model) _Count

// The item, which the caller holds: it lets it go.
#[c.native("g_list_model_get_item")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GListModelGetItem")]
func _modelItem(m _Model, at _Count) _Pointer

#[c.native("g_object_ref")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectRef")]
func _ref(p _Pointer)

#[c.native("g_object_unref")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectUnref")]
func _unref(p _Pointer)

#[c.native("g_object_set_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SetData")]
func _setData(o _Object, key string, data option[_Pointer])

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Data")]
func _data(o _Object, key string) option[_Pointer]

// A flow's store, let go with the label through a function of this
// package's: GTK hands it the store and nothing else.
#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.HoldData")]
func _holdData(o _Object, key string, data _Pointer, #[c.type("GDestroyNotify")] #[c.static] gone func(p _Pointer))

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdSpan(o _Object, key string, #[c.type("gpointer")] s c.held[_SpanState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldSpan(o _Object, key string) option[c.held[_SpanState]]

#[c.native("GtkLabel *", cast)]
func _labelOf(w Widget) _p_GtkLabel

#[c.native("gtk_label_set_markup")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkLabelSetMarkup")]
func _setMarkup(l _p_GtkLabel, markup string)

// What a span says: its words, its link, the tags its style opens and
// closes, and whether a parent has held it yet.
struct _SpanState {
    words string = ""
    href  string = ""
    open  string = ""
    close string = ""
    sunk  bool = false
}

func _spanOf(w Widget) option[_SpanState] {
    return _heldSpan(_object(w), "sngl-span")
}

func _setSpan(w Widget, s _SpanState) {
    _holdSpan(_object(w), "sngl-span", s)
}

func _unrefData(p _Pointer) {
    _unref(p)
}

func _rtSpanNew() Span {
    var w = _storeWidget(_storeNew(_objectType()))
    _setSpan(w, _SpanState{})
    return _asSpan(w)
}

// The spans parent holds: a span's own store, or a flow's, made on first
// use and let go with the label.
func _spanKids(parent Widget) _Store {
    if _spanOf(parent) != null {
        return _store(parent)
    }
    var held = _data(_object(parent), "sngl-spans")
    if held != null {
        return _store(_pointed(held))
    }
    var made = _storeNew(_objectType())
    _holdData(_object(parent), "sngl-spans", _pointer(_storeWidget(made)), _unrefData)
    return made
}

func _spanParent(w Widget) option[Widget] {
    var p = _data(_object(w), "sngl-parent")
    if p != null {
        return _pointed(p)
    }
    return null
}

func _markupEscape(s string) => s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("'", "&apos;").replace("\"", "&quot;")

func _kidsMarkup(kids _Store) string {
    var out = ""
    var n = int(_modelCount(_model(kids)))
    var i = 0
    for i < n {
        var item = _modelItem(_model(kids), _Count(i))
        _unref(item)
        out += _spanMarkup(_pointed(item))
        i += 1
    }
    return out
}

func _spanMarkup(w Widget) string {
    var s = _spanOf(w)
    if s != null {
        var inner = s.open + _markupEscape(s.words) + _kidsMarkup(_store(w)) + s.close
        if s.href != "" {
            return "<a href=\"{_markupEscape(s.href)}\">{inner}</a>"
        }
        return inner
    }
    return ""
}

// Sets the markup of the flow a span is in, if it is in one yet.
func _spanChanged(from Widget) {
    if _spanOf(from) != null {
        var up = _spanParent(from)
        if up != null {
            _spanChanged(up)
        }
        return
    }
    _setMarkup(_labelOf(from), _kidsMarkup(_spanKids(from)))
}

// Puts child in parent before `before`, or last: a span a parent holds
// already moves, as a keyed loop's kept row does. The first parent to hold
// a span takes the reference it was made with.
func _spanInsert(parent Widget, child Widget, before option[Widget]) {
    var kids = _spanKids(parent)
    var at = _Count(0)
    var s = _spanOf(child)
    if s != null {
        if s.sunk {
            _ref(_pointer(child))
        } else {
            _setSpan(child, _SpanState{words=s.words, href=s.href, open=s.open, close=s.close, sunk=true})
        }
    }
    var old = _spanParent(child)
    if old != null {
        var from = _spanKids(old)
        if _storeFind(from, _pointer(child), &at) {
            _storeRemove(from, at)
        }
    }
    _setData(_object(child), "sngl-parent", _pointer(parent))
    var placed = false
    if before != null {
        if _storeFind(kids, _pointer(before), &at) {
            _storeInsert(kids, at, _pointer(child))
            placed = true
        }
    }
    if !placed {
        _storeAppend(kids, _pointer(child))
    }
    _unref(_pointer(child))
    _spanChanged(parent)
}

func _spanRemove(parent Widget, child Widget) {
    var kids = _spanKids(parent)
    var at = _Count(0)
    if _storeFind(kids, _pointer(child), &at) {
        _setData(_object(child), "sngl-parent", null)
        _storeRemove(kids, at)
        _spanChanged(parent)
    }
}

func _rtSpanAppend(parent ui.node, child markup.span) {
    _spanInsert(_handle(parent), _spanHandle(child), null)
}

func _rtSpanInsert(parent ui.node, child markup.span, before markup.span) {
    _spanInsert(_handle(parent), _spanHandle(child), _spanHandle(before))
}

func _rtSpanRemove(parent ui.node, child markup.span) {
    _spanRemove(_handle(parent), _spanHandle(child))
}

func _rtSpanAppendIn(parent markup.span, child markup.span) {
    _spanInsert(_spanHandle(parent), _spanHandle(child), null)
}

func _rtSpanInsertIn(parent markup.span, child markup.span, before markup.span) {
    _spanInsert(_spanHandle(parent), _spanHandle(child), _spanHandle(before))
}

func _rtSpanRemoveIn(parent markup.span, child markup.span) {
    _spanRemove(_spanHandle(parent), _spanHandle(child))
}

func _spanSaid(w Widget) _SpanState {
    var s = _spanOf(w)
    if s != null {
        return s
    }
    return _SpanState{}
}

func _rtSpanWords(span Span, words string) {
    var w = _spanHandle(span)
    var s = _spanSaid(w)
    _setSpan(w, _SpanState{words=words, href=s.href, open=s.open, close=s.close, sunk=s.sunk})
    _spanChanged(w)
}

func _rtSpanHref(span Span, href string) {
    var w = _spanHandle(span)
    var s = _spanSaid(w)
    _setSpan(w, _SpanState{words=s.words, href=href, open=s.open, close=s.close, sunk=s.sunk})
    _spanChanged(w)
}

// A style as the Pango a run's words are wrapped in: Pango's own elements
// for a weight, a slant, a line and a monospace family, and a span's
// attributes for the rest. What the style leaves alone writes nothing, so
// the run inherits it from the span around it, as the cascade asks. The
// weights and slants are markup's, inherit first: normal 1, bold 2, lighter
// 3, bolder 4, and normal 1, italic 2, oblique 3.
func _rtSpanStyle(
    span      Span,
    r         int,
    g         int,
    b         int,
    a         int,
    size      float,
    weight    int,
    slant     int,
    underline bool,
    strike    bool,
    family    string,
) {
    var mono = family == "monospace"
    var attrs = ""
    if weight == 1 || weight == 3 {
        attrs += " weight=\"normal\""
    }
    if slant == 1 {
        attrs += " style=\"normal\""
    }
    if family != "" && !mono {
        attrs += " font_family=\"{_markupEscape(family)}\""
    }
    if a != 0 {
        var color = r.format(16, 2, "0") + g.format(16, 2, "0") + b.format(16, 2, "0")
        attrs += " foreground=\"#{color.upper()}\""
    }
    if size > 0 {
        attrs += " font_desc=\"{size}px\""
    }
    var bold = weight == 2 || weight == 4
    var italic = slant == 2 || slant == 3
    var open = ""
    var close = ""
    if bold {
        open += "<b>"
    }
    if italic {
        open += "<i>"
    }
    if underline {
        open += "<u>"
    }
    if strike {
        open += "<s>"
    }
    if mono {
        open += "<tt>"
    }
    if attrs != "" {
        open += "<span{attrs}>"
        close += "</span>"
    }
    if mono {
        close += "</tt>"
    }
    if strike {
        close += "</s>"
    }
    if underline {
        close += "</u>"
    }
    if italic {
        close += "</i>"
    }
    if bold {
        close += "</b>"
    }
    var w = _spanHandle(span)
    var s = _spanSaid(w)
    _setSpan(w, _SpanState{words=s.words, href=s.href, open=open, close=close, sunk=s.sunk})
    _spanChanged(w)
}

