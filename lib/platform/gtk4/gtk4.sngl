func _connectKidsChanged(instance _Pointer, signal string, #[c.type("GCallback")] #[c.static] handler func(m _Pointer, at int, removed int, added int, box _Pointer), gobject _Pointer, flags _ConnectFlags) _Handler

#[c.native("gulong")]
struct _Handler = int

#[c.native("g_signal_handler_disconnect")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GSignalHandlerDisconnect")]
func _disconnectHandler(instance _Pointer, handler _Handler)

// GTK tells a box nothing when a child is added, so a box aligning its
// children watches its own list of them. GTK warns that the list costs
// bookkeeping on every change, which only a box with an alignItems pays.
func _lookSetCross(w Widget, cross int) {
    var l = _lookOf(w)
    if cross != l.cross {
        l.cross = cross
        var kids = _data(_object(w), "sngl-look-kids")
        if cross != 0 && kids == null {
            var m = _observeChildren(w)
            l.kidsHandler = int(_connectKidsChanged(_modelPointer(m), "items-changed", _lookKidsChanged, _pointer(w), _ConnectFlags(0)))
            _holdData(_object(w), "sngl-look-kids", _modelPointer(m), _unrefData)
        } else if cross == 0 && kids != null {
            _disconnectHandler(kids, _Handler(l.kidsHandler))
            _setData(_object(w), "sngl-look-kids", null)
        }
        _setLookState(w, l)
        _placeKids(w)
    }
}

