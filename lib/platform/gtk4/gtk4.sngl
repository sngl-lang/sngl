// G_SIGNAL_MATCH_ID, and G_SIGNAL_MATCH_DETAIL beside it.
const _matchID = 1
const _matchIDAndDetail = 3

// GTK_INVALID_LIST_POSITION: no choice.
const _noPosition = 4294967295

// n in decimal, zeros before it up to width digits.
func _padded(n int, width int) string {
    var s = "{n}"
    for s.length() < width {
        s = "0" + s
    }
    return s
}

// The day a calendar has selected as a date's text, YYYY-MM-DD.
func _rtCalendarDay(c ui.node) string {
    var t = _calendarDate(_calendarOf(_handle(c)))
    var day = "{_padded(_dateYear(t), 4)}-{_padded(_dateMonth(t), 2)}-{_padded(_dateDay(t), 2)}"
    _dateTimeUnref(t)
    return day
}

// The day a calendar has selected. A calendar always has one, so this is null
// only where GTK reports no date at all.
func calendarDate(c ui.node) option[time.date] {
    return time.parseDate(_rtCalendarDay(c))
}

// Selects y-m-d on a calendar as a click on the day does, without reporting
// it: "day-selected" is blocked, and a test's fire emits it itself after
// selecting. A day no month has selects nothing.
func selectDay(cal ui.node, y int, m int, d int) {
    var day = _dateTimeUTC(y, m, d, 0, 0, 0.0)
    if day != null {
        var w = _handle(cal)
        var id = _signalLookup("day-selected", _calendarType())
        _blockMatched(_pointer(w), _matchID, id, 0, null, null, null)
        _calendarSelectDay(w, day)
        _unblockMatched(_pointer(w), _matchID, id, 0, null, null, null)
        _dateTimeUnref(day)
    }
}

// The labels an offer joins with newlines, as GLib's g_strsplit splits them:
// none at all in "".
func _labelsOf(labels string) list[string] {
    if labels == "" {
        return []
    }
    return labels.split("\n")
}

// Whether m is a string list holding exactly labels.
func _holds(m option[_Model], labels list[string]) bool {
    if m != null {
        if !_isA(_modelInstance(m), _stringListType()) {
            return false
        }
        var n = labels.length()
        if int(_modelCount(m)) != n {
            return false
        }
        var i = 0
        for i < n {
            if _stringListString(_stringListOf(m), _Count(i)) != labels[i] {
                return false
            }
            i += 1
        }
        return true
    }
    return false
}

// Offers a drop-down the labels `labels` joins with newlines, and selects
// `chosen` where one of them is it and nothing where none is, so a label
// holding a newline is offered as two choices. A drop-down takes its choices
// as a GListModel: a GtkStringList, replaced only for labels that differ,
// which would otherwise drop the popup a user has open. Neither is a choice
// anyone made, so `notify::selected` is blocked meanwhile. A drop-down a
// render has not built yet is offered nothing: a settle the render's own
// instances ask for runs before it, and the drop-down's build mounts the
// offer again.
func offerChoices(d ui.node, labels string, chosen string) {
    if _builtDropDown(d) {
        var w = _handle(d)
        var drop = _dropDownOf(w)
        var notify = _signalLookup("notify", _objectType())
        var selected = _quark("selected")
        _blockMatched(_pointer(w), _matchIDAndDetail, notify, selected, null, null, null)
        var split = _labelsOf(labels)
        if !_holds(_dropDownModel(drop), split) {
            var made = _stringListNew(null)
            for var s = split {
                _stringListAppend(made, s)
            }
            _dropDownSetModel(drop, _stringListModel(made))
            _unref(_stringListPointer(made))
        }
        var at = _noPosition
        var i = split.length() - 1
        for i >= 0 {
            if split[i] == chosen {
                at = i
            }
            i -= 1
        }
        _dropDownSetSelected(drop, _Count(at))
        _unblockMatched(_pointer(w), _matchIDAndDetail, notify, selected, null, null, null)
    }
}

// Selects the choice labeled `label`, as a pick does: unlike an offer, the
// drop-down notifies, so its @notifySelected handler runs. A label among none
// of its choices selects nothing. The handler may render the page the
// drop-down is on afresh, which drops the drop-down while GTK is still
// setting it, so it is held until the selection is done.
func selectLabel(d ui.node, label string) {
    var w = _handle(d)
    var drop = _dropDownOf(w)
    var m = _dropDownModel(drop)
    if m != null {
        if _isA(_modelInstance(m), _stringListType()) {
            var n = int(_modelCount(m))
            var i = 0
            for i < n {
                if _stringListString(_stringListOf(m), _Count(i)) == label {
                    _ref(_pointer(w))
                    _dropDownSetSelected(drop, _Count(i))
                    _unref(_pointer(w))
                    return
                }
                i += 1
            }
        }
    }
}

// The label a drop-down has selected, or "" where it has none.
func dropDownLabel(d ui.node) string {
    var item = _dropDownSelectedItem(_dropDownOf(_handle(d)))
    if item != null {
        if _isA(_instanceOf(item), _stringObjectType()) {
            return _stringObjectString(_stringObjectOf(item))
        }
    }
    return ""
}

// A test's fire of an event whose handler reads a value off the widget puts
// the value there first, as the user's flip, typing or click on a day does.
// A flip to the state w is already in changes nothing, so it reports itself:
// a switch through `notify::active`, a check button through "toggled".
func _rtFireFlip(w ui.node, v int) {
    var h = _handle(w)
    var on = v != 0
    if _isA(_instanceOf(_pointer(h)), _switchType()) {
        var s = _as_GtkSwitch(_widget(w))
        if _switchActive(s) != on {
            _gtk_switch_set_active(s, _to_gboolean(v != 0 ? 1 : 0))
        } else {
            _notify(_object(h), "active")
        }
    } else {
        var b = _as_GtkCheckButton(_widget(w))
        if _checkButtonActive(b) != on {
            _gtk_check_button_set_active(b, _to_gboolean(v != 0 ? 1 : 0))
        } else {
            _rtSignalEmit(w, "toggled")
        }
    }
}

func _rtFireText(e ui.node, text string, signal string) {
    setEntryText(e, text)
    _rtSignalEmit(e, signal)
}

// `day` is a date's text, or "" to select nothing first.
func _rtFireDay(c ui.node, day string) {
    if day != "" {
        var at = time.parseDate(day)
        if at != null {
            selectDay(c, at.year(), at.month(), at.day())
        }
    }
    _rtSignalEmit(c, "day-selected")
}

#[c.native("gtk_drop_down_get_type")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkDropDownGetType")]
func _dropDownType() _Type

// Whether n is a drop-down a render has built: one it has not is NULL,
// which GLib's check answers false for.
func _builtDropDown(n ui.node) bool {
    return _isA(_instanceOf(_pointer(_handle(n))), _dropDownType())
}

#[gen.fires("toggled")]
func _fire_GtkCheckButton_toggled(b GtkCheckButton, checked bool) {
    _rtFireFlip(b, checked ? 1 : 0)
}

#[gen.fires("notifyActive")]
func _fire_GtkSwitch_notifyActive(s GtkSwitch, checked bool) {
    _rtFireFlip(s, checked ? 1 : 0)
}

#[gen.fires("changed")]
func _fire_GtkEntry_changed(e GtkEntry, text string) {
    _rtFireText(e, text, "changed")
}

#[gen.fires("activate")]
func _fire_GtkEntry_activate(e GtkEntry, text string) {
    _rtFireText(e, text, "activate")
}

#[gen.fires("daySelected")]
func _fire_GtkCalendar_daySelected(c GtkCalendar, day option[time.date]) {
    _rtFireDay(c, day == null ? "" : day.format())
}

// What GTK says a widget is in: GTK_STATE_FLAG_ACTIVE and
// GTK_STATE_FLAG_PRELIGHT among them.
#[c.native("GtkStateFlags")]
struct _c_GtkStateFlags = int

#[c.native("gtk_widget_set_state_flags")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetSetStateFlags")]
func _gtk_widget_set_state_flags(w _p_GtkWidget, flags _c_GtkStateFlags, clear bool)

// Puts w in the state a pointer resting on it puts it in, which its look
// draws: what a test snapshots to see a button shaded as it is hovered. GTK
// takes the state back once a pointer moves, and a test has none.
func hover(w ui.node) {
    _gtk_widget_set_state_flags(_as_GtkWidget(_widget(w)), 2, false)
}

// Puts w in the state a press holding it down puts it in, as hover does.
func press(w ui.node) {
    _gtk_widget_set_state_flags(_as_GtkWidget(_widget(w)), 1, false)
}

// A text is the runtime's GtkLabel, starting at the left of its box as
// html's does, and pressed through a click gesture, which a label has no
// signal for.
#[marks.intrinsic("gtk4:Text")]
component Text(value string, look Look, @click()) ui.node

#[c.native("sngl_text_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglTextNew")]
func _rtTextNew() Text

#[c.native("sngl_text_set_value")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglTextSetValue")]
func _rtTextSetValue(w Text, value string)

#[gen.protocol(create)]
func _create_Text() Text {
    return _rtTextNew()
}

#[gen.protocol(set)]
func _set_Text_value(w Text, value string) {
    _rtTextSetValue(w, value)
}

#[gen.protocol(set)]
func _set_Text_look(w Text, look Look) {
    _setLook(w, look)
}

#[gen.protocol(on)]
func _on_Text_click(w Text, click func()) {
    _rtOnClick(w, click)
}

#[gen.fires("click")]
func _fire_Text_click(w Text) {
    _rtClick(w)
}

const component ui.text[platform](value, style, @click) {
    Text(value=value, look=lookOf(style), @click { click() }) {}
}

// A control written `focusable=false` is given `can-focus` false, which keeps
// focus off the widget and off what it holds -- an entry's focus is on the
// text widget inside it, and a drop-down's on its button -- by Tab and by a
// click alike, and a click still presses it.
const component ui.button[platform](text, focusable, style, @click) {
    GtkButton(label=text, canFocus=focusable, look=lookOf(style), @clicked { click() }) {}
}

const component ui.checkbox[platform](label, checked, focusable, style, @change) {
    GtkCheckButton(label=label, active=checked, canFocus=focusable, look=lookOf(style), @toggled(b) {
        if checkActive(b) != checked {
            checked = checkActive(b)
            change(checked)
        }
    }) {}
}

// The value is pushed by an effect rather than bound: setting an entry's text
// deletes and reinserts it, firing "changed" for each, so writing back the
// text "changed" just reported re-entered the handler until the stack
// overflowed. Only a value the entry does not already show is written.
const component ui.input[platform](value, focusable, style, @input, @change) {
    GtkEntry #entry(
        canFocus = focusable,
        look = lookOf(style),
        @changed(e) {
            if entryText(e) != value {
                value = entryText(e)
                input(value)
            }
        },
        @activate(e) {
            value = entryText(e)
            change(value)
        },
    ) {}
    effect(on=value, @mount(v) {
        if entryText(entry) != v {
            setEntryText(entry, v)
        }
    })
}

// gtk4 has no lightweight multi-line entry; map textarea to GtkEntry so
// the value binding + changed handler compile and round-trip. (Rich
// multi-line GtkTextView support is a future enhancement.)
const component ui.textarea[platform](value, focusable, style, @input, @change) {
    GtkEntry #entry(
        canFocus = focusable,
        look = lookOf(style),
        @changed(e) {
            if entryText(e) != value {
                value = entryText(e)
                input(value)
            }
        },
        @activate(e) {
            value = entryText(e)
            change(value)
        },
    ) {}
    effect(on=value, @mount(v) {
        if entryText(entry) != v {
            setEntryText(entry, v)
        }
    })
}

// --- Container widgets ---

const component ui.vbox[platform](style, children) {
    GtkBox(orientation="vertical", look=boxLookOf(style, 6)) {
        children
    }
}

const component ui.hbox[platform](style, children) {
    GtkBox(orientation="horizontal", look=boxLookOf(style, 6)) {
        children
    }
}

// A grid is a GtkBox the runtime lays out a row at a time, so its children come
// and go as a box's do. GtkFlowBox wraps each child in one of its own, which
// a render slot's anchor is no sibling of, and GtkGrid places each by a
// position a child append cannot give it.
const component ui.grid[platform](columns, style, children) {
    GtkBox(orientation="horizontal", look=gridLookOf(style, columns)) {
        children
    }
}

// A scroll is a GtkScrolledWindow, which moves along `direction` and
// reports the end of its content coming within half a viewport of showing
// -- as it arrives, and when the content changes size while it is there
// (see "A scroll" below). GTK has no signal saying so; the changes of the
// adjustment along the axis the end is read on are what answer it.
#[marks.intrinsic("gtk4:Scroll")]
component Scroll(
    direction string,
    look      Look,
    @reachEnd(),
    content   ...component option[ui.node],
) ui.node

// A GtkLayoutManager: what measures and places a widget's children.
#[c.native("GtkLayoutManager *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.LayoutManager")]
struct LayoutManager {}

#[c.native("GtkOrientation")]
struct Orientation = int

// Pointers GTK takes NULL for: a baseline nobody asks after, and no
// transform.
#[c.native("int *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.IntPointer")]
struct IntPointer {}

#[c.native("GskTransform *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Transform")]
struct Transform {}

// What a layout's measure answers, which GTK reads through the four
// pointers it hands one: -1 is no baseline.
struct Measured {
    minimum         int
    natural         int
    minimumBaseline int
    naturalBaseline int
}

// A layout whose three functions GTK calls with the widget and nothing
// else: each is a function of this package, which reads what it needs off
// the widget.
#[c.native("gtk_custom_layout_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkCustomLayoutNew")]
func _customLayout(
    #[c.type("GtkCustomRequestModeFunc")] #[c.static] mode func(w Widget) int,
    #[c.type("GtkCustomMeasureFunc")] #[c.static] #[c.outs] measure func(w Widget, orientation int, forSize int) Measured,
    #[c.type("GtkCustomAllocateFunc")] #[c.static] allocate func(w Widget, width int, height int, baseline int),
) LayoutManager

#[c.native("gtk_widget_get_first_child")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetFirstChild")]
func _firstChild(w Widget) option[Widget]

#[c.native("gtk_widget_should_layout")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetShouldLayout")]
func _shouldLayout(w Widget) bool

#[c.native("gtk_widget_get_request_mode")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetRequestMode")]
func _requestMode(w Widget) int

#[c.native("gtk_widget_measure")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetMeasure")]
func _measureWidget(w Widget, orientation Orientation, forSize int, minimum ref[int], natural ref[int], minimumBaseline option[IntPointer], naturalBaseline option[IntPointer])

#[c.native("gtk_widget_allocate")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetAllocate")]
func _allocateWidget(w Widget, width int, height int, baseline int, transform option[Transform])

// A scroll's probe is laid out as its one child is, the scroll's content,
// and tells the scroll the content's natural length along the axis its end
// is read on each time it is allocated. GTK_SIZE_REQUEST_CONSTANT_SIZE is 2.
func _probeMode(w Widget) int {
    var child = _firstChild(w)
    if child != null {
        return _requestMode(child)
    }
    return 2
}

func _probeMeasure(w Widget, orientation int, forSize int) Measured {
    var minimum = 0
    var natural = 0
    var child = _firstChild(w)
    if child != null {
        if _shouldLayout(child) {
            _measureWidget(child, orientation, forSize, &minimum, &natural, null, null)
        }
    }
    return Measured{minimum=minimum, natural=natural, minimumBaseline=-1, naturalBaseline=-1}
}

func _probeAllocate(w Widget, width int, height int, baseline int) {
    var child = _firstChild(w)
    if child != null {
        if _shouldLayout(child) {
            _allocateWidget(child, width, height, baseline, null)
            var minimum = 0
            var natural = 0
            if _probeAcross(w) {
                _measureWidget(child, 0, height, &minimum, &natural, null, null)
            } else {
                _measureWidget(child, 1, width, &minimum, &natural, null, null)
            }
            _probeMeasured(w, natural)
        }
    }
}

// --- A scroll, with no struct of its own ---
//
// A scroll is a GtkScrolledWindow whose child is its probe, a box laid out
// by _probeMode, _probeMeasure and _probeAllocate, holding the content. What
// the program says of the scroll -- the axis its end is read on and what
// runs as the end arrives -- is a value C holds on it, beside whether the
// end showed when last read and how long the content was then; what the
// probe measured last is one held on the probe. The probe is held on the
// scroll, and a report posted and not yet run is the idle source held on
// it, destroyed with the scroll.

