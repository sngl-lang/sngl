#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglSpanSetWords")]
func _rtSpanWords(w Span, words string)

#[c.native("sngl_span_set_href")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglSpanSetHref")]
func _rtSpanHref(w Span, href string)

// A run's style: its color's channels, its size in px (0 unset), its weight
// and slant as markup's enums, `inherit` first, its lines and its family.
#[c.native("sngl_span_set_style")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglSpanSetStyle")]
func _rtSpanStyle(
    w         Span,
    r         int,
    g         int,
    b         int,
    a         int,
    size      float,
    weight    int,
    slant     int,
    underline bool,
    strike    bool,
    family    string,
)

