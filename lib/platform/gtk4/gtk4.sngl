func _sizeRequest(w Widget, width ref[int], height ref[int])

#[c.native("gtk_widget_set_size_request")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetSetSizeRequest")]
func _setSizeRequest(w Widget, width int, height int)

#[c.native("gtk_widget_set_cursor_from_name")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetSetCursorFromName")]
func _setCursorName(w Widget, name string)

#[c.native("gtk_widget_set_cursor_from_name")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.ClearCursorName")]
func _clearCursorName(w Widget, name option[string])

// Gives w its look, each widget's `look` set: its CSS, size, flex,
// alignment, spacing and a box's layout.
func _setLook(n ui.node, look Look) {
    _applyLook(_handle(n), look)
}

func _applyLook(w Widget, look Look) {
    var width = int(look.width + 0.5)
    var height = int(look.height + 0.5)
    if !_hasLook(w) && look.css == "" && width == 0 && height == 0 && look.grow <= 0.0 && look.cross == 0 && look.textAlign == 0 && look.lines == 0 && look.wrap == 0 && !look.hidden && look.cursor == "" && look.justify == 0 && !look.grid {
        if look.spaced && _isBox(w) {
            _boxSetSpacing(_boxOf(w), look.spacing)
        }
        return
    }
    var given = look
    given.width = float(width)
    given.height = float(height)
    var l = _lookOf(w)
    if l.isGiven && l.given == given {
        return
    }
    l.given = given
    l.isGiven = true
    _setLookState(w, l)
    _lookSetCss(w, look.css)
    var s = _lookOf(w)
    if (width != 0 || height != 0) && !s.sized {
        s.sized = true
        var width0 = 0
        var height0 = 0
        _sizeRequest(w, &width0, &height0)
        s.width0 = width0
        s.height0 = height0
    }
    if s.sized {
        _setSizeRequest(w, width > 0 ? width : s.width0, height > 0 ? height : s.height0)
    }
    s.width = width
    s.height = height
    s.grow = look.grow
    _setLookState(w, s)
    if look.grow > 0.0 || width != 0 || height != 0 {
        _watchParent(w)
    }
    _lookPlace(w)
    var box = _growBox(w)
    if box != null {
        _boxUpdate(box)
    }
    _lookSetSpacing(w, look.spaced, look.spacing)
    var j = _lookOf(w)
    j.justify = look.justify
    _setLookState(w, j)
    _lookSetGrid(w, look.grid, look.columns)
    _boxUpdate(w)
    _lookSetCross(w, look.cross)
    _lookSetText(w, look.textAlign, look.lines, look.wrap)
    _lookSizeLabel(w, look.wrap)
    var h = _lookOf(w)
    if look.hidden && !h.hidden {
        h.visible0 = _visible(w)
        _setVisible(w, false)
    } else if !look.hidden && h.hidden {
        _setVisible(w, h.visible0)
    }
    h.hidden = look.hidden
    if look.cursor != "" {
        _setCursorName(w, look.cursor)
    } else if h.cursor {
        _clearCursorName(w, null)
    }
    h.cursor = look.cursor != ""
    _setLookState(w, h)
}

