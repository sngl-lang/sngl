import ui "sngl:ui"
import build "sngl:build"
import marks "sngl:internal/marks"
import macro "sngl:macro"
import gen "sngl:x/gen"
import c "sngl:x/c"
import go "sngl:language/go"
import time "sngl:time"
import draw "sngl:ui/draw"
import family "sngl:family"
import math "sngl:math"
import markup "sngl:ui/markup"

// The runtime every gtk4 program links: the toplevels and the application,
// the look and the layout of a box's children, in C, which each language
// compiles into the program.
c.link(include="sngl_gtk.h", pkgConfig=["gtk4", "libcurl"], ldflags=["-lm"], library="gtk-4", sources=["rt/sngl_gtk.c", "rt/sngl_gtk.h", "rt/look.c", "rt/keys.c", "rt/choose.c", "rt/image.c", "sngl:language/c/rt/sngl_http.c", "sngl:language/c/rt/sngl_http.h"])

// The `gtk4` node of a build directive: `output { c { gtk4() } }`.
//
// Every node is a GTK widget and every operation on one a protocol function,
// here or in widgets.sngl, so the platform asks for `placement`, and each
// language writes the program whole. GTK owns its widgets and diffs nothing,
// so the tree is flattened and each write is explicit.
#[gen.can(insertBefore, asyncPost, instanceState)]
#[gen.cannot(reactivity, declarative, inlineComponents, structSpread)]
#[gen.wants(placement, stdlibContextParam, canvas, reactiveCanvas)]
#[gen.name("gtk4")]
#[gen.native("gtk4")]
component platform(
    // Go package name for the generated files.
    const package       string,
    // Emit a standalone main() or a library-style module.
    const main          bool,
    // The process start, wrapped: what the handler does before calling `run`
    // happens before the event loop, and what it does after, once the loop
    // has exited. `run` presents the windows and runs the loop. A handler
    // that never calls it gets a process whose loop still runs -- timers,
    // effects, posted work -- with no window on screen, which `quit` ends.
    // The application has torn down when `run` returns, and a second call
    // ends the process. `args` is the command line after the program's name.
    @run(args list[string], run func()),
    // Which introspection data a program's `gir:Gtk-4.0` import is declared
    // from: "builtin" for the bundled subset, a path to a `Gtk-4.0.gir`, or
    // unset to probe the system locations and fall back to the bundled
    // subset. The platform's own widgets are the bundled subset's whatever
    // it says.
    const gir           string,
    // What its generated code introduces beside a program's names: the
    // runtime's prefix, the program's entry, and the runtime calls a Go
    // program makes as functions of its own (codegen/platform/gtk4's
    // shimFile).
    const reservedNames list[string] = [
        "sngl_gtk",
        "sngl_app",
        "sngl_build",
        "sngl_main",
        "main",
        "snglGtkMain",
        "snglGtkInit",
        "snglGtkHold",
        "snglGtkPresent",
        "snglGtkRun",
        "snglGtkStep",
        "snglGtkReset",
        "snglGtkCaptureFile",
        "snglGtkCarryFile",
        "snglPost",
    ],
) build.platform

// Every node is a widget, held as its pointer. A protocol function handing a
// node to GTK reaches the pointer through this.
#[c.native("GtkWidget *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Widget")]
struct Widget {}

#[c.native("GtkWidget *", cast)]
#[gen.protocol(handle)]
func _handle(n ui.node) Widget

// A node the program holds at its root, a window, is put on screen when the
// program attaches it and destroyed, with everything in it, when it detaches
// it.
#[c.native("sngl_app_attach")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglAppAttach")]
func _rtAttach(n ui.node)

#[c.native("sngl_app_detach")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglAppDetach")]
func _rtDetach(n ui.node)

#[gen.protocol(attach)]
func _attach(n ui.node) {
    _rtAttach(n)
}

#[gen.protocol(detach)]
func _detach(n ui.node) {
    _rtDetach(n)
}

// What a component renders several nodes, or a slot, at its top into: a box
// down the page. A window among them is no child of it but a toplevel the
// application shows, which the box keeps, so a root component's windows come
// and go with it (rt's sngl_box_append).
#[marks.intrinsic("gtk4:Contents")]
component Contents(content ...component ui.node) ui.node

#[c.native("sngl_box_remove")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglBoxRemove")]
func _rtBoxRemove(box ui.node, child ui.node)

#[gen.protocol(contents)]
func _contents() Contents {
    return _rtContents()
}

#[c.native("sngl_slot_anchor")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglSlotAnchor")]
func _rtSlotAnchor(box ui.node, anchor ui.node) ui.node

// A render slot's entries go before an anchor the runtime keeps in its
// container, so a slot emptied and filled again comes back in its place.
#[gen.protocol(anchor)]
func _anchor(parent ui.node, anchor ui.node) ui.node {
    return _rtSlotAnchor(parent, anchor)
}

#[gen.protocol(create)]
func _create_Contents() Contents {
    return _rtContents()
}

#[gen.protocol(append)]
func _append_Contents(parent Contents, child ui.node) {
    _sngl_box_append(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(child)))
}

#[gen.protocol(insertBefore)]
func _insert_Contents(parent Contents, child ui.node, before ui.node) {
    _sngl_box_insert_before(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(before)), _as_GtkWidget(_widget(child)))
}

#[gen.protocol(remove)]
func _remove_Contents(parent Contents, child ui.node) {
    _rtBoxRemove(parent, child)
}

// Every widget's handlers are GLib signals.
#[gen.protocol(connect)]
func _connect(w ui.node, signal string, handler func()) {
    signalConnect(w, signal, handler)
}

// What a widget's style asks of GTK (_setLook): its CSS, its least
// size, its share of a box's spare room, and how a box lays out what it
// holds.
struct Look {
    css       string
    width     float
    height    float
    grow      float
    cross     int
    textAlign int
    lines     int
    wrap      int
    hidden    bool
    cursor    string
    justify   int
    spaced    bool
    spacing   int
    grid      bool
    columns   int
}

// --- A widget's look ---
//
// What a Look asks of a widget beside its CSS (_setLook): its least size, its
// share of a box's spare room, how a box aligns and lays out its children, its
// text's alignment, and whether it shows. What the look set, and what it found
// there to give back, is a _LookState kept on the widget; what GTK must hold a
// reference to -- the box layout kept aside, the list of a box's children it
// watches -- is kept on the widget beside it, let go with the widget.

// What a widget's look set, and what it found there to give back.
struct _LookState {
    // The look last given, with its size rounded: a row a list sets again
    // with what it already has, as every row is each time the list's value
    // changes, then costs a comparison rather than a relayout.
    given         Look = Look{}
    isGiven       bool = false
    width         int = 0
    height        int = 0
    // Whether the look sized the widget, and its size request before.
    sized         bool = false
    width0        int = 0
    height0       int = 0
    grow          float = 0.0
    // The axis the widget grows along in its box, -1 where it grows in none,
    // and its expand on that axis before.
    growAxis      int = -1
    expand0       bool = false
    expandSet0    bool = false
    // How many children growing in a box pin it, and its expand before the
    // first did.
    growers       int = 0
    boxExpand0    bool = false
    boxExpandSet0 bool = false
    watching      bool = false
    // Whether the box the widget is in aligns it, across which axis, and its
    // alignment there before.
    aligned       bool = false
    alignAxis     int = 0
    align0        int = 0
    cross         int = 0
    // The handler of the list of children a box aligning them watches.
    kidsHandler   int = 0
    textSaved     bool = false
    xalign0       float = 0.0
    justify0      int = 0
    wrap0         bool = false
    lines0        int = 0
    ellipsize0    int = 0
    labelSized    bool = false
    // The size a label sized by its look measures as, which its layout
    // reads.
    labelWidth    int = 0
    labelHeight   int = 0
    hidden        bool = false
    visible0      bool = false
    cursor        bool = false
    justify       int = 0
    spaced        bool = false
    spacing       int = 0
    // A box that is no box of the program's: its grow is its children's.
    contents      bool = false
    // A box that is sngl:ui's grid, laid out a row at a time: `columns` to
    // a row, or flowing where it is zero.
    grid          bool = false
    columns       int = 0
}

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdLook(o _Object, key string, #[c.type("gpointer")] s c.held[_LookState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldLook(o _Object, key string) option[c.held[_LookState]]

func _hasLook(w Widget) bool {
    return _heldLook(_object(w), "sngl-look") != null
}

// What w's look set, or nothing set where it has none.
func _lookOf(w Widget) _LookState {
    var l = _heldLook(_object(w), "sngl-look")
    if l != null {
        return l
    }
    return _LookState{}
}

func _setLookState(w Widget, l _LookState) {
    _holdLook(_object(w), "sngl-look", l)
}

// Gives w a look where it has none.
func _lookEnsure(w Widget) {
    if !_hasLook(w) {
        _setLookState(w, _LookState{})
    }
}

// A widget kept on another under key without a reference, which reads as
// none once it is gone, and is let go by setting the key to null: rt's
// look.c, since g_object_add_weak_pointer writes through a pointer no SNGL
// value has.
#[c.native("sngl_weak_set")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglWeakSet")]
func _weakSet(o _Object, key string, w Widget)

#[c.native("sngl_weak")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglWeak")]
func _weak(o _Object, key string) option[Widget]

// The box a widget growing in it pins.
func _growBox(w Widget) option[Widget] {
    return _weak(_object(w), "sngl-grow-box")
}

#[c.native("gpointer", cast)]
func _layoutPointer(l LayoutManager) _Pointer

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.DataLayout")]
func _dataLayout(o _Object, key string) option[LayoutManager]

#[c.native("g_object_steal_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectStealData")]
func _stealLayout(o _Object, key string) option[LayoutManager]

#[c.native("gtk_widget_get_layout_manager")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetLayoutManager")]
