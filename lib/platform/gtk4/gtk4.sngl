#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoPaint")]
func _cairoPaint(cr CairoContext)

#[c.native("gdk_display_get_default")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GdkDisplayGetDefault")]
func _defaultDisplay() _Display

