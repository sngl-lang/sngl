#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCairoLineCap")]
func CairoContext.setLineCap(cap int)

#[c.native("sngl_cairo_line_join")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCairoLineJoin")]
func CairoContext.setLineJoin(join int)

#[c.native("cairo_rectangle")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoRectangle")]
func CairoContext.rectangle(x float, y float, w float, h float)

#[c.native("cairo_new_sub_path")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoNewSubPath")]
func CairoContext.newSubPath()

