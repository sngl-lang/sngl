func _setData(o _Object, key string, data option[_Pointer])

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Data")]
func _data(o _Object, key string) option[_Pointer]

// A flow's store, let go with the label through a function of this
// package's: GTK hands it the store and nothing else.
#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.HoldData")]
func _holdData(o _Object, key string, data _Pointer, #[c.type("GDestroyNotify")] #[c.static] gone func(p _Pointer))

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdSpan(o _Object, key string, #[c.type("gpointer")] s c.held[_SpanState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.HeldSpan")]
func _heldSpan(o _Object, key string) option[c.held[_SpanState]]

#[c.native("GtkLabel *", cast)]
func _labelOf(w Widget) _p_GtkLabel

#[c.native("gtk_label_set_markup")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkLabelSetMarkup")]
func _setMarkup(l _p_GtkLabel, markup string)

// What a span says: its words, its link, the tags its style opens and
// closes, and whether a parent has held it yet.
struct _SpanState {
    words string = ""
    href  string = ""
    open  string = ""
    close string = ""
    sunk  bool = false
}

func _spanOf(w Widget) option[_SpanState] {
    return _heldSpan(_object(w), "sngl-span")
}

func _setSpan(w Widget, s _SpanState) {
    _holdSpan(_object(w), "sngl-span", s)
}

func _unrefData(p _Pointer) {
    _unref(p)
}

func _rtSpanNew() Span {
    var w = _storeWidget(_storeNew(_objectType()))
    _setSpan(w, _SpanState{})
    return _asSpan(w)
}

// The spans parent holds: a span's own store, or a flow's, made on first
// use and let go with the label.
func _spanKids(parent Widget) _Store {
    if _spanOf(parent) != null {
        return _store(parent)
    }
    var held = _data(_object(parent), "sngl-spans")
    if held != null {
        return _store(_pointed(held))
    }
    var made = _storeNew(_objectType())
    _holdData(_object(parent), "sngl-spans", _pointer(_storeWidget(made)), _unrefData)
    return made
}

func _spanParent(w Widget) option[Widget] {
    var p = _data(_object(w), "sngl-parent")
    if p != null {
        return _pointed(p)
    }
    return null
}

func _markupEscape(s string) => s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("'", "&apos;").replace("\"", "&quot;")

func _kidsMarkup(kids _Store) string {
    var out = ""
    var n = int(_modelCount(_model(kids)))
    var i = 0
    for i < n {
        var item = _modelItem(_model(kids), _Count(i))
        _unref(item)
        out += _spanMarkup(_pointed(item))
        i += 1
    }
    return out
}

func _spanMarkup(w Widget) string {
    var s = _spanOf(w)
    if s != null {
        var inner = s.open + _markupEscape(s.words) + _kidsMarkup(_store(w)) + s.close
        if s.href != "" {
            return "<a href=\"{_markupEscape(s.href)}\">{inner}</a>"
        }
        return inner
    }
    return ""
}

// Sets the markup of the flow a span is in, if it is in one yet.
func _spanChanged(from Widget) {
    if _spanOf(from) != null {
        var up = _spanParent(from)
        if up != null {
            _spanChanged(up)
        }
        return
    }
    _setMarkup(_labelOf(from), _kidsMarkup(_spanKids(from)))
}

// Puts child in parent before `before`, or last: a span a parent holds
// already moves, as a keyed loop's kept row does. The first parent to hold
// a span takes the reference it was made with.
func _spanInsert(parent Widget, child Widget, before option[Widget]) {
    var kids = _spanKids(parent)
    var at = _Count(0)
    var s = _spanOf(child)
    if s != null {
        if s.sunk {
            _ref(_pointer(child))
        } else {
            _setSpan(child, _SpanState{words=s.words, href=s.href, open=s.open, close=s.close, sunk=true})
        }
    }
    var old = _spanParent(child)
    if old != null {
        var from = _spanKids(old)
        if _storeFind(from, _pointer(child), &at) {
            _storeRemove(from, at)
        }
    }
    _setData(_object(child), "sngl-parent", _pointer(parent))
    var placed = false
    if before != null {
        if _storeFind(kids, _pointer(before), &at) {
            _storeInsert(kids, at, _pointer(child))
            placed = true
        }
    }
    if !placed {
        _storeAppend(kids, _pointer(child))
    }
    _unref(_pointer(child))
    _spanChanged(parent)
}

func _spanRemove(parent Widget, child Widget) {
    var kids = _spanKids(parent)
    var at = _Count(0)
    if _storeFind(kids, _pointer(child), &at) {
        _setData(_object(child), "sngl-parent", null)
        _storeRemove(kids, at)
        _spanChanged(parent)
    }
}

func _rtSpanAppend(parent ui.node, child markup.span) {
    _spanInsert(_handle(parent), _spanHandle(child), null)
}

func _rtSpanInsert(parent ui.node, child markup.span, before markup.span) {
    _spanInsert(_handle(parent), _spanHandle(child), _spanHandle(before))
}

func _rtSpanRemove(parent ui.node, child markup.span) {
    _spanRemove(_handle(parent), _spanHandle(child))
}

func _rtSpanAppendIn(parent markup.span, child markup.span) {
    _spanInsert(_spanHandle(parent), _spanHandle(child), null)
}

func _rtSpanInsertIn(parent markup.span, child markup.span, before markup.span) {
    _spanInsert(_spanHandle(parent), _spanHandle(child), _spanHandle(before))
}

func _rtSpanRemoveIn(parent markup.span, child markup.span) {
    _spanRemove(_spanHandle(parent), _spanHandle(child))
}

func _spanSaid(w Widget) _SpanState {
    var s = _spanOf(w)
    if s != null {
        return s
    }
    return _SpanState{}
}

func _rtSpanWords(span Span, words string) {
    var w = _spanHandle(span)
    var s = _spanSaid(w)
    _setSpan(w, _SpanState{words=words, href=s.href, open=s.open, close=s.close, sunk=s.sunk})
    _spanChanged(w)
}

func _rtSpanHref(span Span, href string) {
    var w = _spanHandle(span)
    var s = _spanSaid(w)
    _setSpan(w, _SpanState{words=s.words, href=href, open=s.open, close=s.close, sunk=s.sunk})
    _spanChanged(w)
}

// A style as the Pango a run's words are wrapped in: Pango's own elements
// for a weight, a slant, a line and a monospace family, and a span's
// attributes for the rest. What the style leaves alone writes nothing, so
// the run inherits it from the span around it, as the cascade asks. The
// weights and slants are markup's, inherit first: normal 1, bold 2, lighter
// 3, bolder 4, and normal 1, italic 2, oblique 3.
func _rtSpanStyle(
    span      Span,
    r         int,
    g         int,
    b         int,
    a         int,
    size      float,
    weight    int,
    slant     int,
    underline bool,
    strike    bool,
    family    string,
) {
    var mono = family == "monospace"
    var attrs = ""
    if weight == 1 || weight == 3 {
        attrs += " weight=\"normal\""
    }
    if slant == 1 {
        attrs += " style=\"normal\""
    }
    if family != "" && !mono {
        attrs += " font_family=\"{_markupEscape(family)}\""
    }
    if a != 0 {
        var color = r.format(16, 2, "0") + g.format(16, 2, "0") + b.format(16, 2, "0")
        attrs += " foreground=\"#{color.upper()}\""
    }
    if size > 0 {
        attrs += " font_desc=\"{size}px\""
    }
    var bold = weight == 2 || weight == 4
    var italic = slant == 2 || slant == 3
    var open = ""
    var close = ""
    if bold {
        open += "<b>"
    }
    if italic {
        open += "<i>"
    }
    if underline {
        open += "<u>"
    }
    if strike {
        open += "<s>"
    }
    if mono {
        open += "<tt>"
    }
    if attrs != "" {
        open += "<span{attrs}>"
        close += "</span>"
    }
    if mono {
        close += "</tt>"
    }
    if strike {
        close += "</s>"
    }
    if underline {
        close += "</u>"
    }
    if italic {
        close += "</i>"
    }
    if bold {
        close += "</b>"
    }
    var w = _spanHandle(span)
    var s = _spanSaid(w)
    _setSpan(w, _SpanState{words=s.words, href=s.href, open=open, close=close, sunk=s.sunk})
    _spanChanged(w)
}

#[gen.protocol(create)]
func _create_Flow() Flow {
    return _rtFlowNew()
}

#[gen.protocol(set)]
func _set_Flow_look(w Flow, look Look) {
    _setLook(w, look)
}

#[gen.protocol(append)]
func _append_Flow(parent Flow, child markup.span) {
    _rtSpanAppend(parent, child)
}

#[gen.protocol(insertBefore)]
func _insert_Flow(parent Flow, child markup.span, before markup.span) {
    _rtSpanInsert(parent, child, before)
}

#[gen.protocol(remove)]
func _remove_Flow(parent Flow, child markup.span) {
    _rtSpanRemove(parent, child)
}

#[gen.protocol(create)]
func _create_Span() Span {
    return _rtSpanNew()
}

#[gen.protocol(append)]
func _append_Span(parent Span, child markup.span) {
    _rtSpanAppendIn(parent, child)
}

#[gen.protocol(insertBefore)]
func _insert_Span(parent Span, child markup.span, before markup.span) {
    _rtSpanInsertIn(parent, child, before)
}

#[gen.protocol(remove)]
func _remove_Span(parent Span, child markup.span) {
    _rtSpanRemoveIn(parent, child)
}

#[gen.protocol(set)]
func _set_Span_words(w Span, words string) {
    _rtSpanWords(w, words)
}

#[gen.protocol(set)]
func _set_Span_href(w Span, href string) {
    _rtSpanHref(w, href)
}

#[gen.protocol(set)]
func _set_Span_spanStyle(w Span, spanStyle markup.SpanStyle) {
    _rtSpanStyle(w, int(spanStyle.color.r), int(spanStyle.color.g), int(spanStyle.color.b), int(spanStyle.color.a), px(spanStyle.fontSize), int(spanStyle.fontWeight), int(spanStyle.fontStyle), spanStyle.underline, spanStyle.strike, spanStyle.fontFamily)
}

const component markup.richText[platform](style, content) {
    Flow(look=lookOf(style)) {
        content
    }
}

const component markup.text[platform](value) {
    Span(words=value) {}
}

const component markup.run[platform](style, content) {
    Span(spanStyle=style) {
        content
    }
}

// Pango has `<a href>` and GtkLabel follows one when it is clicked, so this
// is the one target besides html where a link is a link.
const component markup.link[platform](href, content) {
    Span(href=href) {
        content
    }
}

// Pango takes a foreground and nothing a theme could answer, so the fallback
// is a palette rather than the host: the light one, since the theme GTK
// ships with is light.
const component markup.token[platform](kind, content) {
    Span(spanStyle={color=markup.colorOf(markup.palette, markup.lightPalette, kind)}) {
        content
    }
}

// Pango markup has no image, and a GtkLabel holds text. So the description
// is what an image is here, in the brackets that say a picture stood where
// they are.
const component markup.image[platform](alt) {
    Span(words="[{alt}]") {}
}

// --- Images ---

// An image is the runtime's box holding the source it shows, fitted as `fit`
// says, or the placeholder where it holds none (rt's image.c). A source is a
// GtkPicture showing the texture its picture or its drawing make, and
// reporting to the image holding it whether the picture arrived: `@load` is
// its picture shown, and `@failed` its picture failing, why being
// imageFailure's. Appended to a window, a source is the window's icon. A
// width and a height in its style are its size, whatever its picture's.
#[marks.intrinsic("gtk4:Image")]
component Image(
    fit     string,
    look    Look,
    @click(),
    @load(),
    @failed(),
    content ...component option[ui.imageSource],
) ui.node

