#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.DataCss")]
func _dataCss(o _Object, key string) option[_CssProvider]

// A provider restyling w alone, attached and detached through the style
// context GTK deprecated (rt's look.c).
#[c.native("sngl_style_add")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglStyleAdd")]
func _styleAdd(w Widget, css _CssProvider)

#[c.native("sngl_style_remove")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglStyleRemove")]
func _styleRemove(w Widget, css _CssProvider)

// The provider's rules made rule, as the GTK it is built against takes them
// (rt's look.c).
#[c.native("sngl_css_load")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCssLoad")]
func _cssLoad(css _CssProvider, rule string)

// One rule naming the widget's own node, so a node it draws inside itself
// (a check button's check) is not restyled with it, in a provider of the
// widget's own: style classes would put every distinct look in one
// display-wide sheet and restyle every widget whenever a look changed;
// this restyles one. A provider reaches the nodes of its own widget and not
// another's: a popover draws its body on its contents, a widget of its own,
// and its arrow on a node of the popover's, so its rule is on both and
// names both, as the theme's does.
func _lookCss(w Widget, rule string) {
    var css = _dataCss(_object(w), "sngl-look-css")
    if rule == "" {
        if css != null {
            _styleRemove(w, css)
            _popoverStyle(w, css, false)
            _setData(_object(w), "sngl-look-css", null)
        }
    } else if css != null {
        _cssLoad(css, rule)
    } else {
        var made = _cssProviderNew()
        _holdData(_object(w), "sngl-look-css", _cssPointer(made), _unrefData)
        _styleAdd(w, made)
        _popoverStyle(w, made, true)
        _cssLoad(made, rule)
    }
}

#[c.native("gtk_widget_get_css_name")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetCssName")]
func _cssName(w Widget) string

// Attaches css to a popover's contents, or detaches it.
func _popoverStyle(w Widget, css _CssProvider, add bool) {
    if _is(w, _popoverType()) {
        var done = false
        for var c = _childrenOf(w, false) {
            if !done && _cssName(c) == "contents" {
                done = true
                if add {
                    _styleAdd(c, css)
                } else {
                    _styleRemove(c, css)
                }
            }
        }
    }
}

func _lookSetCss(w Widget, decls string) {
    if decls == "" {
        _lookCss(w, "")
    } else {
        var name = _cssName(w)
        var rule = "{name} \{ {decls} \}"
        if _is(w, _popoverType()) {
            rule = "popover > contents, popover > arrow \{ {decls} \}"
        }
        // The rule outranks the theme's in every state, so a button given a
        // background shades it itself when hovered and pressed, as the
        // theme would. style.sngl writes `background` only for a Style's.
        if _is(w, _buttonType()) && decls.contains("background") {
            rule = rule + " {name}:hover \{ background-image: image(alpha(currentColor, 0.1)); \} {name}:active, {name}:checked \{ background-image: image(alpha(currentColor, 0.2)); \}"
        }
        _lookCss(w, rule)
    }
}

