#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkBoxGetType")]
func _boxType() _Type

#[c.native("gtk_box_layout_get_type")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkBoxLayoutGetType")]
