#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkPopoverGetType")]
func _popoverType() _Type

func _is(w Widget, t _Type) bool {
    return _isA(_instanceOf(_pointer(w)), t)
}

func _isBox(w Widget) bool {
    return _is(w, _boxType())
}

func _isBoxLayout(l LayoutManager) bool {
    return _isA(_instanceOf(_layoutPointer(l)), _boxLayoutType())
}

#[c.native("gtk_widget_get_hexpand")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetHexpand")]
func _hexpand(w Widget) bool

#[c.native("gtk_widget_get_vexpand")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetVexpand")]
func _vexpand(w Widget) bool

#[c.native("gtk_widget_get_hexpand_set")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetHexpandSet")]
func _hexpandSet(w Widget) bool

#[c.native("gtk_widget_get_vexpand_set")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetVexpandSet")]
func _vexpandSet(w Widget) bool

#[c.native("gtk_widget_set_hexpand")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SetHexpand")]
func _setHexpand(w Widget, on bool)

#[c.native("gtk_widget_set_vexpand")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SetVexpand")]
func _setVexpand(w Widget, on bool)

#[c.native("gtk_widget_set_hexpand_set")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetSetHexpandSet")]
func _setHexpandSet(w Widget, on bool)

#[c.native("gtk_widget_set_vexpand_set")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetSetVexpandSet")]
func _setVexpandSet(w Widget, on bool)

#[c.native("gtk_widget_compute_expand")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetComputeExpand")]
func _computeExpand(w Widget, o Orientation) bool

func _expand(w Widget, axis int) => axis == 0 ? _hexpand(w) : _vexpand(w)

func _expandSet(w Widget, axis int) => axis == 0 ? _hexpandSet(w) : _vexpandSet(w)

func _setExpand(w Widget, axis int, on bool) {
    if axis == 0 {
        _setHexpand(w, on)
    } else {
        _setVexpand(w, on)
    }
}

func _setExpandSet(w Widget, axis int, on bool) {
    if axis == 0 {
        _setHexpandSet(w, on)
    } else {
        _setVexpandSet(w, on)
    }
}

#[c.native("gtk_widget_get_halign")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetHalign")]
func _halign(w Widget) _Align

#[c.native("gtk_widget_get_valign")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetValign")]
func _valign(w Widget) _Align

#[c.native("gtk_widget_set_valign")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetSetValign")]
func _setValign(w Widget, align _Align)

func _alignOn(w Widget, axis int) => axis == 0 ? int(_halign(w)) : int(_valign(w))

func _setAlignOn(w Widget, axis int, align int) {
    if axis == 0 {
        _setHalign(w, _Align(align))
    } else {
        _setValign(w, _Align(align))
    }
}

#[c.native("gtk_widget_queue_resize")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetQueueResize")]
func _queueResize(w Widget)

#[c.native("gtk_widget_get_visible")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetGetVisible")]
func _visible(w Widget) bool

// The children of box, in order: the ones a layout places, or every one.
func _childrenOf(box Widget, laidOut bool) list[Widget] {
    var kids list[Widget] = []
    _childrenInto(&kids, _firstChild(box), laidOut)
    return kids
}

func _childrenInto(kids ref[list[Widget]], c option[Widget], laidOut bool) {
    if c != null {
        if !laidOut || _shouldLayout(c) {
            kids.push(c)
        }
        _childrenInto(kids, _nextSibling(c), laidOut)
    }
}

// The children of box a layout places, in order.
func _layoutKids(box Widget) list[Widget] {
    return _childrenOf(box, true)
}

// The axis of a box. GtkBox keeps its orientation in its layout manager, so
// once the runtime has given a box a layout of its own, the box answers
// through one that is not a GtkBoxLayout -- horizontal, with a critical on
// stderr -- and its own, kept aside, is what knows.
func _boxAxis(box Widget) Orientation {
    var own = _dataLayout(_object(box), "sngl-box-layout")
    if own != null {
        return _orientation(_layoutOrientable(own))
    }
    return _orientation(_widgetOrientable(box))
}

// The space between a box's children, which its look holds while the
// runtime lays the box out.
func _boxSpacing(box Widget) int {
    var l = _lookOf(box)
    if l.spaced {
        return l.spacing
    }
    var own = _dataLayout(_object(box), "sngl-box-layout")
    if own != null {
        return int(_boxLayoutSpacing(_asBoxLayout(own)))
    }
    return _boxGetSpacing(_boxOf(box))
}

// The share of the spare room a child takes: its look's flex, or one share
// where it expands itself, as a GIR widget given `hexpand` does. An expand
// GTK carries up from something the child holds is no share: a CSS flex
// item grows by its own flex, never by what is inside it, so a box holding
// such a widget is its content's size.
func _lookWeight(c Widget, o Orientation) float {
    var l = _lookOf(c)
    if l.grow > 0.0 {
        return l.grow
    }
    var own = int(o) == 0 ? _hexpand(c) : _vexpand(c)
    return own ? 1.0 : 0.0
}

// Where a box puts what its children leave of it: 0 the start, 1 the
// center, 2 the end, 3 between them, 4 around them and 5 evenly.
func _lookJustify(box Widget) => _lookOf(box).justify

// A grid's columns, 0 where it flows.
func _lookColumns(box Widget) => _lookOf(box).columns

// The width a box's look asks for, 0 for none.
func _lookWidth(box Widget) => _lookOf(box).width

// Whether the children's shares are not what GTK's box would give them: two
// weights that differ, or a weight beside a child GTK would grow for what
// it holds. A box with no weight at all is left to GTK's, carried expands
// and all.
func _weightsUneven(box Widget) bool {
    var o = _boxAxis(box)
    var first = 0.0
    var carried = false
    var uneven = false
    for var c = _layoutKids(box) {
        var w = _lookWeight(c, o)
        if w <= 0.0 {
            carried = carried || _computeExpand(c, o)
        } else if first == 0.0 {
            first = w
        } else if w != first {
            uneven = true
        }
    }
    return uneven || carried && first > 0.0
}

// Keeps a box's own layout aside, while the runtime's lays it out.
func _keepBoxLayout(box Widget, own LayoutManager) {
    _ref(_layoutPointer(own))
    _holdData(_object(box), "sngl-box-layout", _layoutPointer(own), _unrefData)
}

// Lays a box out as a grid, its own layout kept aside for its axis and its
// spacing.
func _lookSetGrid(box Widget, grid bool, columns int) {
    if grid && _isBox(box) {
        var l = _lookOf(box)
        var changed = l.columns != columns
        var was = l.grid
        l.columns = columns
        l.grid = true
        _setLookState(box, l)
        if !was {
            // The flex layout had it, and kept GTK's aside already.
            if _dataLayout(_object(box), "sngl-box-layout") == null {
                var own = _layoutManagerOf(box)
                if own != null {
                    if _isBoxLayout(own) {
                        _keepBoxLayout(box, own)
                    }
                }
            }
            _setLayoutManager(box, _gridLayout(_gridMode, _gridMeasure, _gridAllocate))
        } else if changed {
            _queueResize(box)
        }
    }
}

// Gives a box GTK's own layout back, spaced as its look says.
func _boxRelease(box Widget) {
    var own = _stealLayout(_object(box), "sngl-box-layout")
    if own != null {
        var l = _lookOf(box)
        if l.spaced {
            _boxLayoutSetSpacing(_asBoxLayout(own), _Count(l.spacing))
        }
        _setLayoutManager(box, own)
    }
}

// A box whose look justifies, or whose growing children ask for unequal
// shares, is laid out by the runtime's flex layout; one that asks for
// neither has GTK's own back.
func _boxUpdate(box Widget) {
    if _isBox(box) {
        var l = _lookOf(box)
        var ours = _dataLayout(_object(box), "sngl-box-layout") != null
        if l.grid {
            _queueResize(box)
        } else {
            var need = l.justify != 0 || _weightsUneven(box)
            if need && !ours {
                var own = _layoutManagerOf(box)
                if own != null {
                    if _isBoxLayout(own) {
                        _lookEnsure(box)
                        _keepBoxLayout(box, own)
                        _setLayoutManager(box, _flexLayout(_flexMode, _flexMeasure, _flexAllocate))
                    }
                }
            } else if !need && ours {
                _boxRelease(box)
            } else if ours {
                _queueResize(box)
            }
        }
    }
}

// A box's spacing, which its look holds while the runtime lays the box
// out.
func _lookSetSpacing(w Widget, spaced bool, spacing int) {
    if spaced && _isBox(w) {
        var l = _lookOf(w)
        l.spaced = true
        l.spacing = spacing
        _setLookState(w, l)
        if _dataLayout(_object(w), "sngl-box-layout") != null {
            _queueResize(w)
        } else {
            _boxSetSpacing(_boxOf(w), spacing)
        }
    }
}

// A growing child pins the box it is in, which counts it, so that GTK
// hands the child's expand no further up: a CSS flex item grows no box.
// The last one out gives the box back what it had.
func _pin(box Widget, w Widget, axis int) {
    var bl = _lookOf(box)
    if bl.growers == 0 {
        bl.boxExpand0 = _expand(box, axis)
        bl.boxExpandSet0 = _expandSet(box, axis)
        if !bl.boxExpandSet0 {
            _setExpand(box, axis, false)
        }
    }
    bl.growers += 1
    _setLookState(box, bl)
    _weakSet(_object(w), "sngl-grow-box", box)
    _boxUpdate(box)
    _contentsUpdate(box)
}

func _unpin(w Widget, axis int) {
    var box = _growBox(w)
    if box != null {
        _setData(_object(w), "sngl-grow-box", null)
        if _hasLook(box) {
            _boxUpdate(box)
            // The contents gives its own grow back before the box its
            // expand, which the grow was set over.
            var bl = _lookOf(box)
            bl.growers -= 1
            _setLookState(box, bl)
            _contentsUpdate(box)
            if bl.growers <= 0 {
                _setExpand(box, axis, bl.boxExpand0)
                _setExpandSet(box, axis, bl.boxExpandSet0)
            }
        }
    }
}

func _restoreExpand(w Widget) {
    var axis = _lookOf(w).growAxis
    if axis >= 0 {
        _unpin(w, axis)
        var l = _lookOf(w)
        _setExpand(w, axis, l.expand0)
        _setExpandSet(w, axis, l.expandSet0)
        l.growAxis = -1
        _setLookState(w, l)
    }
}

// The alignment across a box its alignItems asks of a child: GtkAlign's
// start, center, end and baseline, which GTK 4.12 renamed BASELINE_FILL
// and kept the value of, or fill.
func _crossAlign(cross int) int {
    if cross == 1 {
        return 1
    } else if cross == 2 {
        return 3
    } else if cross == 3 {
        return 2
    } else if cross == 4 {
        return 4
    }
    return 0
}

func _unalign(w Widget) {
    var l = _lookOf(w)
    if l.aligned {
        _setAlignOn(w, l.alignAxis, l.align0)
        l.aligned = false
        _setLookState(w, l)
    }
}

// What the box a widget sits in reads off it: a share along the box's
// axis, and an alignment across it from the box's alignItems, or the start
// where a stretching box holds a child of fixed size, as CSS places one.
func _lookPlace(w Widget) {
    var parent = _parentOf(w)
    var mainAxis = -1
    var cross = 0
    if parent != null {
        if _is(parent, _orientableType()) {
            mainAxis = int(_boxAxis(parent)) == 0 ? 0 : 1
        }
        cross = _lookOf(parent).cross
    }
    if _hasLook(w) {
        var l = _lookOf(w)
        if l.growAxis >= 0 && (l.grow <= 0.0 || l.growAxis != mainAxis) {
            _restoreExpand(w)
        }
        var g = _lookOf(w)
        if g.grow > 0.0 && mainAxis >= 0 && g.growAxis < 0 && parent != null {
            g.growAxis = mainAxis
            g.expand0 = _expand(w, mainAxis)
            g.expandSet0 = _expandSet(w, mainAxis)
            _setLookState(w, g)
            _setExpand(w, mainAxis, true)
            _pin(parent, w, mainAxis)
        }
    }
    var l = _lookOf(w)
    var fixed = mainAxis == 1 ? l.width > 0 : l.height > 0
    if mainAxis < 0 || cross == 0 && !fixed {
        _unalign(w)
    } else {
        var axis = mainAxis == 1 ? 0 : 1
        _lookEnsure(w)
        _watchParent(w)
        if _lookOf(w).aligned && _lookOf(w).alignAxis != axis {
            _unalign(w)
        }
        var a = _lookOf(w)
        if !a.aligned {
            a.aligned = true
            a.alignAxis = axis
            a.align0 = _alignOn(w, axis)
            _setLookState(w, a)
        }
        _setAlignOn(w, axis, cross == 0 ? 1 : _crossAlign(cross))
    }
}

func _lookParentChanged(o _Pointer, spec _Pointer, data _Pointer) {
    _lookPlace(_pointed(o))
}

#[c.native("g_signal_connect_object")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GSignalConnectObject")]
func _connectParentNotify(instance _Pointer, signal string, #[c.type("GCallback")] #[c.static] handler func(o _Pointer, spec _Pointer, data _Pointer), gobject _Pointer, flags _ConnectFlags) _Handler

func _watchParent(w Widget) {
    var l = _lookOf(w)
    if !l.watching {
        l.watching = true
        _setLookState(w, l)
        _connectParentNotify(_pointer(w), "notify::parent", _lookParentChanged, _pointer(w), _ConnectFlags(0))
    }
}

// A contents grows by the most any child growing in it asks, in the box it
// sits in, as CSS's display: contents makes its children that box's items.
// The child still grows in the contents, which is then all of its room.
func _contentsUpdate(box Widget) {
    var l = _lookOf(box)
    if l.contents {
        var grow = 0.0
        for var c = _childrenOf(box, false) {
            var cl = _lookOf(c)
            var in = _growBox(c)
            if in != null {
                if in == box && cl.grow > grow {
                    grow = cl.grow
                }
            }
        }
        if grow != l.grow {
            l.grow = grow
            _setLookState(box, l)
            if grow > 0.0 {
                _watchParent(box)
            }
            _lookPlace(box)
            var up = _growBox(box)
            if up != null {
                _boxUpdate(up)
            }
        }
    }
}

func _placeKids(box Widget) {
    for var c = _childrenOf(box, false) {
        _lookPlace(c)
    }
}

func _lookKidsChanged(m _Pointer, at int, removed int, added int, box _Pointer) {
    if added > 0 {
        _placeKids(_pointed(box))
    }
}

