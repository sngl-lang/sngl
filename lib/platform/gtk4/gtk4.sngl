// Connects an action's activate to handler for as long as the entry it
// picks lives, handing it the entry.
#[c.native("g_signal_connect_object")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.ConnectActivate")]
func _connectActivate(instance _Pointer, signal string, #[c.type("GCallback")] #[c.static] handler func(action _Pointer, parameter _Pointer, entry _Pointer), entry _Pointer, flags _ConnectFlags)

// Hands the runtime's box calls and its window the functions a window's
// menu and way back are: building the window's menu afresh, telling a box
// an entry or a way back came or went, pressing the window's way back,
// answering whether there was one, and forgetting the bar of a window
// destroyed.
#[c.native("sngl_menu_hooks")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglMenuHooks")]
func _menuHooks(
    #[c.type("SnglMenuHook")] #[c.static] apply func(box Widget),
    #[c.type("SnglMenuMovedHook")] #[c.static] moved func(box Widget, child Widget),
    #[c.type("SnglMenuBackHook")] #[c.static] back func(box Widget) bool,
    #[c.type("SnglMenuHook")] #[c.static] forget func(box Widget),
)

// What a menu entry says: its label, set or not, whether it is disabled or
// checked, and what runs as it is picked.
struct _MenuEntryState {
    label    string = ""
    labeled  bool = false
    disabled bool = false
    checked  bool = false
    select   func() = func() {}
}

// What runs as a way back is pressed.
struct _BackState {
    press func() = func() {}
}

// A window's bar: the header bar holding the back button and the menu
// button, decided once as the window is made, since GTK sets a title bar
// only on a window not yet shown. Each is a pointer the box keeps and does
// not hold, under "sngl-header", "sngl-header-back" and
// "sngl-header-menu", and "sngl-header-decided" is set once it is decided.
// A widget kept on o under key, which o does not hold.
#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.DataWidget")]
func _dataWidget(o _Object, key string) option[Widget]

#[c.native("g_object_set_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetData")]
func _setDataTo(o _Object, key string, data _Pointer)

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdMenuEntry(o _Object, key string, #[c.type("gpointer")] s c.held[_MenuEntryState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldMenuEntry(o _Object, key string) option[c.held[_MenuEntryState]]

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdBack(o _Object, key string, #[c.type("gpointer")] s c.held[_BackState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldBack(o _Object, key string) option[c.held[_BackState]]

func _menuEntryOf(w Widget) option[_MenuEntryState] {
    return _heldMenuEntry(_object(w), "sngl-menu-entry")
}

func _setMenuEntry(w Widget, e _MenuEntryState) {
    _holdMenuEntry(_object(w), "sngl-menu-entry", e)
}

func _backOf(w Widget) option[_BackState] {
    return _heldBack(_object(w), "sngl-back")
}

// The bar's widget the box keeps under key.
func _barPart(box Widget, key string) option[Widget] {
    return _dataWidget(_object(box), key)
}

func _setBarPart(box Widget, key string, w Widget) {
    _setDataTo(_object(box), key, _pointer(w))
}

func _isToplevel(box Widget) bool {
    return _data(_object(box), "sngl-toplevel") != null
}

func _menuHooksSet() {
    _menuHooks(_menuApply, _menuMoved, _windowBack, _barForget)
}

func _rtToplevelNew() Toplevel {
    _menuHooksSet()
    return _rtToplevelMake()
}

func _rtMenuEntryNew() MenuEntry {
    _menuHooksSet()
    var box = _boxNew(1, 0)
    _setVisible(box, false)
    _setMenuEntry(box, _MenuEntryState{})
    return _asMenuEntry(box)
}

// The window whose menu the entry holding p is in, through the entries
// holding it, from p up.
func _menuHostFrom(p option[Widget]) option[Widget] {
    if p != null {
        if _isToplevel(p) {
            return p
        }
        if _menuEntryOf(p) == null {
            return null
        }
        return _menuHostFrom(_parentOf(p))
    }
    return null
}

func _entryChanged(w Widget) {
    var host = _menuHostFrom(_parentOf(w))
    if host != null {
        _menuApply(host)
    }
}

func _rtMenuEntrySetLabel(entry MenuEntry, label string) {
    var w = _handle(entry)
    var e = _menuEntryOf(w)
    if e != null {
        if !e.labeled || e.label != label {
            _setMenuEntry(w, _MenuEntryState{label=label, labeled=true, disabled=e.disabled, checked=e.checked, select=e.select})
            _entryChanged(w)
        }
    }
}

func _rtMenuEntrySetDisabled(entry MenuEntry, disabled bool) {
    var w = _handle(entry)
    var e = _menuEntryOf(w)
    if e != null {
        if e.disabled != disabled {
            _setMenuEntry(w, _MenuEntryState{label=e.label, labeled=e.labeled, disabled=disabled, checked=e.checked, select=e.select})
            _entryChanged(w)
        }
    }
}

func _rtMenuEntrySetChecked(entry MenuEntry, checked bool) {
    var w = _handle(entry)
    var e = _menuEntryOf(w)
    if e != null {
        if e.checked != checked {
            _setMenuEntry(w, _MenuEntryState{label=e.label, labeled=e.labeled, disabled=e.disabled, checked=checked, select=e.select})
            _entryChanged(w)
        }
    }
}

func _rtMenuEntryOnSelect(entry MenuEntry, select func()) {
    var w = _handle(entry)
    var e = _menuEntryOf(w)
    if e != null {
        _setMenuEntry(w, _MenuEntryState{label=e.label, labeled=e.labeled, disabled=e.disabled, checked=e.checked, select=select})
    }
}

// Picks the entry, as the user's picking it in the menu does.
func _menuEntrySelect(w Widget) {
    var e = _menuEntryOf(w)
    if e != null {
        if !e.disabled {
            e.select()
        }
    }
}

func _rtBackNew() Back {
    _menuHooksSet()
    var w = _labelNew(null)
    _setVisible(w, false)
    _holdBack(_object(w), "sngl-back", _BackState{})
    return _asBack(w)
}

func _rtBackOnPress(back Back, press func()) {
    var w = _handle(back)
    if _backOf(w) != null {
        _holdBack(_object(w), "sngl-back", _BackState{press=press})
    }
}

func _backPress(w Widget) {
    var b = _backOf(w)
    if b != null {
        b.press()
    }
}

func _rtBackPress(back Back) {
    _backPress(_handle(back))
}

// The first way back from c on among its siblings.
func _backFrom(c option[Widget]) option[Widget] {
    if c != null {
        if _backOf(c) != null {
            return c
        }
        return _backFrom(_nextSibling(c))
    }
    return null
}

// Presses the first way back among a window's content, and whether there
// was one.
func _windowBack(box Widget) bool {
    var b = _backFrom(_firstChild(box))
    if b != null {
        _backPress(b)
        return true
    }
    return false
}

// How many menu entries there are from c on among its siblings.
func _entriesFrom(c option[Widget]) int {
    if c != null {
        var rest = _entriesFrom(_nextSibling(c))
        if _menuEntryOf(c) != null {
            return rest + 1
        }
        return rest
    }
    return 0
}

// A window destroyed takes its bar with it, and a back button in it: the
// next window decides its own. One over the content stays there.
func _barForget(box Widget) {
    if _barPart(box, "sngl-header") != null {
        _setData(_object(box), "sngl-header-back", null)
    }
    _setData(_object(box), "sngl-header", null)
    _setData(_object(box), "sngl-header-menu", null)
    _setData(_object(box), "sngl-header-decided", null)
}

// The back button goes in the bar, or over the content of a window made
// without one, and shows while a way back is among the content.
func _barApply(box Widget) {
    var win = _toplevelWindow(box)
    if win != null {
        _barApplyTo(box, win)
    }
}

func _barApplyTo(box Widget, win _Window) {
    var entries = _entriesFrom(_firstChild(box))
    var canBack = _backFrom(_firstChild(box)) != null
    if _data(_object(box), "sngl-header-decided") == null {
        _setDataTo(_object(box), "sngl-header-decided", _pointer(box))
        if entries > 0 || canBack {
            var made = _headerBarNew()
            _setBarPart(box, "sngl-header", made)
            _setTitlebar(win, made)
            var button = _menuButtonNew()
            _setBarPart(box, "sngl-header-menu", button)
            _menuButtonSetIcon(_menuButtonOf(button), "open-menu-symbolic")
            _headerBarPackEnd(_headerBarOf(made), button)
        }
    }
    if _barPart(box, "sngl-header-back") == null && canBack {
        var button = _buttonFromIcon("go-previous-symbolic")
        _setBarPart(box, "sngl-header-back", button)
        _rtSignalConnect(_asBack(button), "clicked", func() { _windowBack(box) })
        var header = _barPart(box, "sngl-header")
        if header != null {
            _headerBarPackStart(_headerBarOf(header), button)
        } else {
            _setHalign(button, _Align(1))
            _boxPrepend(_boxOf(box), button)
        }
    }
    var back = _barPart(box, "sngl-header-back")
    if back != null {
        _setVisible(back, canBack)
    }
    var menu = _barPart(box, "sngl-header-menu")
    if menu != null {
        _setVisible(menu, entries > 0)
    }
}

func _menuActivate(action _Pointer, parameter _Pointer, entry _Pointer) {
    _menuEntrySelect(_pointed(entry))
}

// Adds the entry w to menu as the action named for n in group, and answers
// the next n.
func _menuAdd(menu _Menu, group _ActionGroup, n int, w Widget, checkable bool) int {
    var e = _menuEntryOf(w)
    if e != null {
        var name = "e{n}"
        var a = _simpleAction(name, null)
        if checkable {
            a = _statefulAction(name, null, _variantBool(e.checked))
        }
        _actionSetEnabled(a, !e.disabled)
        _connectActivate(_actionPointer(a), "activate", _menuActivate, _pointer(w), _ConnectFlags(0))
        _actionMapAdd(_actionMap(group), _action(a))
        _unref(_actionPointer(a))
        _menuAppend(menu, e.label, "sngl.{name}")
    }
    return n + 1
}

// Whether an entry from c on among its siblings is checked.
func _checkedFrom(c option[Widget]) bool {
    if c != null {
        var e = _menuEntryOf(c)
        if e != null && e.checked {
            return true
        }
        return _checkedFrom(_nextSibling(c))
    }
    return false
}

// Adds each entry from c on among its siblings to sub, from n on.
func _menuLeavesFrom(c option[Widget], sub _Menu, group _ActionGroup, n int, checkable bool) int {
    if c != null {
        var next = n
        if _menuEntryOf(c) != null {
            next = _menuAdd(sub, group, n, c, checkable)
        }
        return _menuLeavesFrom(_nextSibling(c), sub, group, next, checkable)
    }
    return n
}

// A submenu per top-level entry holding entries, or the entry itself where
// it holds none, from c on among its siblings. A submenu where one entry is
// checked draws them all as checks.
func _menuItemsFrom(c option[Widget], menu _Menu, group _ActionGroup, n int) int {
    if c != null {
        var next = n
        var e = _menuEntryOf(c)
        if e != null {
            if _entriesFrom(_firstChild(c)) == 0 {
                next = _menuAdd(menu, group, n, c, e.checked)
            } else {
                var sub = _menuNew()
                next = _menuLeavesFrom(_firstChild(c), sub, group, n, _checkedFrom(_firstChild(c)))
                _menuAppendSubmenu(menu, e.label, _menuModel(sub))
                _unref(_menuPointer(sub))
            }
        }
        return _menuItemsFrom(_nextSibling(c), menu, group, next)
    }
    return n
}

// Builds the window's menu afresh, a popover of its own each time: one
// handed a new model keeps each submenu's page of the last and adds another
// of the same name.
func _menuApply(box Widget) {
    _barApply(box)
    var win = _toplevelWindow(box)
    if win != null {
        var button = _barPart(box, "sngl-header-menu")
        if button != null {
            var menu = _menuNew()
            var group = _actionGroupNew()
            _menuItemsFrom(_firstChild(box), menu, group, 0)
            _insertActions(_windowWidget(win), "sngl", _actionGroup(group))
            _menuButtonSetPopover(_menuButtonOf(button), _popoverMenuNew(_menuModel(menu)))
            _unref(_groupPointer(group))
            _unref(_menuPointer(menu))
        }
    }
}

// An entry or a way back came to box or left it.
func _menuMoved(box Widget, child Widget) {
    if _backOf(child) != null {
        if _isToplevel(box) {
            _barApply(box)
        }
    } else if _menuEntryOf(child) != null {
        if _isToplevel(box) {
            _menuApply(box)
        } else if _menuEntryOf(box) != null {
            _entryChanged(box)
        }
    }
}

#[c.native("GtkWidget *", cast)]
func _asBack(w Widget) Back

#[c.native("GtkWidget *", cast)]
func _asMenuEntry(w Widget) MenuEntry

// --- Leaf widgets ---

// What a control holds, read off its widget. A GTK signal hands its handler
// the widget it fired on and nothing else, so an override reporting a change
// asks that widget: `@toggled(b) { checked = checkActive(b) }`.
func checkActive(b ui.node) bool {
    return _checkButtonActive(_as_GtkCheckButton(_widget(b)))
}

func switchActive(s ui.node) bool {
    return _switchActive(_as_GtkSwitch(_widget(s)))
}

// An entry's text, which is GTK's until the entry changes.
func entryText(e ui.node) string {
    return _editableText(_as_GtkEditable(_widget(e)))
}

