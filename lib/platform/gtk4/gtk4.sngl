#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWindowSetIconName")]
func _windowSetIconName(win _Window, name string)

#[c.native("getpid")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Getpid")]
func _processId() int

// Reads the bytes url names, handing done them, or why not, now or, for
// one fetched, once it arrives: a file the program carries, one beside it,
// or one fetched.
#[c.native("sngl_picture_read")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglPictureRead")]
func _pictureRead(url string, pic Picture, #[c.type("SnglPictureRead")] #[c.static] done func(pic _Object, bytes _Bytes, err string))

#[c.native("sngl_icon_dir")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglIconDir")]
func _iconDir() string

// Hands the runtime's box calls and its window the functions a window's
// icon is: taking a source appended to it as its icon, and letting it go,
// each answering whether it did, and showing it on the window made.
#[c.native("sngl_image_hooks")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglImageHooks")]
func _imageHooks(
    #[c.type("SnglTabsHook")] #[c.static] adopt func(box Widget, child Widget) bool,
    #[c.type("SnglTabsHook")] #[c.static] unadopt func(box Widget, child Widget) bool,
    #[c.type("SnglIconHook")] #[c.static] refresh func(box Widget),
)

// What the program says of an image: its fit, as a GtkContentFit -- 0 fill,
// 1 contain, 2 cover and 3 scale down -- what runs as it is clicked, as its
// picture arrives and as it fails, and why the last failed.
struct _ImageState {
    fit     int = 1
    click   func() = func() {}
    load    func() = func() {}
    failed  func() = func() {}
    failure string = ""
}

// What a source says: the URL it shows, kept for what reads it, whether
// what it shows arrived and why not, whether the image holding it was told,
// and a drawing's width, height and paint, which it has once painted is set.
struct _ImageSourceState {
    url     string = ""
    ready   bool = false
    err     string = ""
    told    bool = false
    width   int = 0
    height  int = 0
    painted bool = false
    paint   func(ctx CairoContext) = func(ctx CairoContext) {}
}

// What a picture says: its URL, whether it arrived and why not, how many
// hold it and whether the last let go, and the size it was last scaled to.
struct _PictureState {
    url      string = ""
    arrived  bool = false
    err      string = ""
    holders  int = 1
    released bool = false
    width    int = 0
    height   int = 0
}

// How many icons the display's windows were given.
struct _IconsState {
    count int = 0
}

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdImage(o _Object, key string, #[c.type("gpointer")] s c.held[_ImageState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldImage(o _Object, key string) option[c.held[_ImageState]]

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdImageSource(o _Object, key string, #[c.type("gpointer")] s c.held[_ImageSourceState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldImageSource(o _Object, key string) option[c.held[_ImageSourceState]]

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdPicture(o _Object, key string, #[c.type("gpointer")] s c.held[_PictureState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldPicture(o _Object, key string) option[c.held[_PictureState]]

#[c.native("g_object_set_data_full")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectSetDataFull")]
func _holdIcons(o _Object, key string, #[c.type("gpointer")] s c.held[_IconsState], #[c.type("GDestroyNotify")] #[c.release] rel c.pointer)

#[c.native("g_object_get_data")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GObjectGetData")]
func _heldIcons(o _Object, key string) option[c.held[_IconsState]]

func _imageOf(box Widget) option[_ImageState] {
    return _heldImage(_object(box), "sngl-image")
}

func _setImage(box Widget, s _ImageState) {
    _holdImage(_object(box), "sngl-image", s)
}

func _imageSourceOf(w Widget) option[_ImageSourceState] {
    return _heldImageSource(_object(w), "sngl-source")
}

func _setImageSource(w Widget, s _ImageSourceState) {
    _holdImageSource(_object(w), "sngl-source", s)
}

func _pictureStateOf(pic _Object) option[_PictureState] {
    return _heldPicture(pic, "sngl-picture")
}

func _setPictureState(pic _Object, s _PictureState) {
    _holdPicture(pic, "sngl-picture", s)
}

// The least whole number f is no more than: what C's ceil makes of a size.
func _ceil(f float) int {
    var i = int(f)
    if float(i) < f {
        return i + 1
    }
    return i
}

func _imageHooksSet() {
    _imageHooks(_imageAdopt, _imageUnadopt, _iconRefresh)
}

func _rtImageNew() Image {
    var box = _boxNew(0, 0)
    _setImage(box, _ImageState{fit=1, click=func() {}, load=func() {}, failed=func() {}, failure=""})
    var g = _clickGestureNew()
    _connectPressed(_gesturePointer(g), "pressed", _imagePressed, _pointer(box), _ConnectFlags(0))
    _addController(box, _gestureController(g))
    return _asImage(box)
}

// The image's click gesture was pressed: image is the image, which the
// connection lives no longer than.
func _imagePressed(gesture _Pointer, presses int, x float, y float, image _Pointer) {
    _imageClick(_pointed(image))
}

func _imageClick(box Widget) {
    var img = _imageOf(box)
    if img != null {
        var run = img.click
        run()
    }
}

// `none` is `scaleDown`: GTK has no picture that keeps its own size
// whatever room it is given.
func _rtImageSetFit(image Image, fit string) {
    var box = _handle(image)
    var img = _imageOf(box)
    if img != null {
        var f = 1
        if fit == "cover" {
            f = 2
        } else if fit == "fill" {
            f = 0
        } else if fit == "none" || fit == "scaleDown" {
            f = 3
        }
        _setImage(box, _ImageState{fit=f, click=img.click, load=img.load, failed=img.failed, failure=img.failure})
        _fitFrom(_firstChild(box), f)
    }
}

// Fits each source from c on among its siblings.
func _fitFrom(c option[Widget], fit int) {
    if c != null {
        if _imageSourceOf(c) != null {
            _gtkPictureSetFit(_gtkPictureOf(c), _ContentFit(fit))
        }
        _fitFrom(_nextSibling(c), fit)
    }
}

func _rtImageOnClick(image Image, click func()) {
    var box = _handle(image)
    var img = _imageOf(box)
    if img != null {
        _setImage(box, _ImageState{fit=img.fit, click=click, load=img.load, failed=img.failed, failure=img.failure})
    }
}

func _rtImageOnLoad(image Image, load func()) {
    var box = _handle(image)
    var img = _imageOf(box)
    if img != null {
        _setImage(box, _ImageState{fit=img.fit, click=img.click, load=load, failed=img.failed, failure=img.failure})
    }
}

func _rtImageOnFailed(image Image, failed func()) {
    var box = _handle(image)
    var img = _imageOf(box)
    if img != null {
        _setImage(box, _ImageState{fit=img.fit, click=img.click, load=img.load, failed=failed, failure=img.failure})
    }
}

// Why an image's picture failed, or "".
func imageFailure(w Image) string {
    var img = _imageOf(_handle(w))
    if img != null {
        return img.failure
    }
    return ""
}

func _rtImageClick(w Image) {
    _imageClick(_handle(w))
}

// Tells the image holding the source, once per picture, whether it
// arrived.
func _imageSourceReport(w Widget) {
    var parent = _parentOf(w)
    if parent != null {
        var img = _imageOf(parent)
        var s = _imageSourceOf(w)
        if img != null && s != null {
            if s.ready && !s.told {
                _setImageSource(w, _ImageSourceState{url=s.url, ready=s.ready, err=s.err, told=true, width=s.width, height=s.height, painted=s.painted, paint=s.paint})
                if s.err != "" {
                    _setImage(parent, _ImageState{fit=img.fit, click=img.click, load=img.load, failed=img.failed, failure=s.err})
                    var run = img.failed
                    run()
                } else {
                    var run = img.load
                    run()
                }
            }
        }
    }
}

// Shows tex, which the source holds a reference of its own on, err being
// why what it shows did not arrive.
func _imageSourceShow(w Widget, tex _Texture, err string) {
    _holdData(_object(w), "sngl-texture", _texturePointer(tex), _unrefData)
    _gtkPictureShow(_gtkPictureOf(w), _texturePaintable(tex))
    _imageSourceShown(w, err)
}

// Shows nothing, err being why.
func _imageSourceShowNone(w Widget, err string) {
    _setData(_object(w), "sngl-texture", null)
    _gtkPictureClear(_gtkPictureOf(w), null)
    _imageSourceShown(w, err)
}

// What the source shows arrived: the image holding it is told, and the
// window whose icon it is shows it.
func _imageSourceShown(w Widget, err string) {
    var s = _imageSourceOf(w)
    if s != null {
        _setImageSource(w, _ImageSourceState{url=s.url, ready=true, err=err, told=false, width=s.width, height=s.height, painted=s.painted, paint=s.paint})
    }
    _imageSourceReport(w)
    var icon = _dataWidget(_object(w), "sngl-icon-of")
    if icon != null {
        _iconApply(icon, w)
    }
}

// Shows the picture as it arrived.
func _imageSourceTake(w Widget, pic _Object) {
    var err = ""
    var p = _pictureStateOf(pic)
    if p != null {
        err = p.err
    }
    var tex = _data(pic, "sngl-texture")
    if tex != null {
        _ref(tex)
        _imageSourceShow(w, _textureAt(tex), err)
    } else {
        _imageSourceShowNone(w, err)
    }
}

// Makes the source watch no picture.
func _imageSourceUnwatch(w Widget) {
    var old = _dataObject(_object(w), "sngl-picture")
    if old != null {
        _setWatching(old, _listRemove(_dataList(old, "sngl-watching"), _constPointer(_pointer(w))))
    }
    _setData(_object(w), "sngl-picture", null)
}

// Makes pic the picture the source is told about.
func _imageSourceWatch(w Widget, pic _Object) {
    _imageSourceUnwatch(w)
    _setDataTo(_object(w), "sngl-picture", _objectPointer(pic))
    _setDataTo(pic, "sngl-watching", _listPointer(_listAppend(_dataList(pic, "sngl-watching"), _pointer(w))))
}

// Keeps l as the sources watching pic.
func _setWatching(pic _Object, l option[_List]) {
    if l != null {
        _setDataTo(pic, "sngl-watching", _listPointer(l))
    } else {
        _setData(pic, "sngl-watching", null)
    }
}

// A source going is watching no picture.
func _imageSourceGone(data _Pointer, gone _Object) {
    _imageSourceUnwatch(_objectWidget(gone))
}

// The source having been put somewhere: it fits itself to the image it is
// in, and reports to it.
func _imageSourceParented(w Widget) {
    var parent = _parentOf(w)
    if parent != null {
        var img = _imageOf(parent)
        if img != null {
            _gtkPictureSetFit(_gtkPictureOf(w), _ContentFit(img.fit))
            var frame = _dataWidget(_object(w), "sngl-frame")
            var same = false
            if frame != null {
                same = frame == parent
            }
            if !same {
                _setDataTo(_object(w), "sngl-frame", _pointer(parent))
                var s = _imageSourceOf(w)
                if s != null {
                    _setImageSource(w, _ImageSourceState{url=s.url, ready=s.ready, err=s.err, told=false, width=s.width, height=s.height, painted=s.painted, paint=s.paint})
                }
            }
            _imageSourceReport(w)
            return
        }
    }
    _setData(_object(w), "sngl-frame", null)
}

func _imageSourceNew() Widget {
    _imageHooksSet()
    var w = _gtkPictureNew()
    _setImageSource(w, _ImageSourceState{url="", ready=false, err="", told=false, width=0, height=0, painted=false, paint=func(ctx CairoContext) {}})
    _weakRef(_object(w), _imageSourceGone, null)
    _rtNotifyConnect(_widgetNode(w), "notify::parent", func() { _imageSourceParented(w) })
    return w
}

func _rtImageUrlNew() ImageUrl {
    return _asImageUrl(_imageSourceNew())
}

// The URL a source says it shows, kept on it for what reads it: it shows
// the picture it is handed, not one it fetches itself.
func _rtImageUrlSetUrl(source ImageUrl, url string) {
    var w = _imageUrlWidget(source)
    var s = _imageSourceOf(w)
    if s != null {
        _setImageSource(w, _ImageSourceState{url=url, ready=s.ready, err=s.err, told=s.told, width=s.width, height=s.height, painted=s.painted, paint=s.paint})
    }
}

func _rtImageUrlSetPicture(source ImageUrl, picture Picture) {
    var w = _imageUrlWidget(source)
    if _imageSourceOf(w) != null {
        var pic = _pictureObject(picture)
        _imageSourceWatch(w, pic)
        var p = _pictureStateOf(pic)
        if p != null {
            if p.arrived {
                _imageSourceTake(w, pic)
            }
        }
    }
}

func _rtImageDrawingNew() ImageDrawing {
    return _asImageDrawing(_imageSourceNew())
}

// A drawing paints its picture again whenever it is asked, once it knows
// its size and what to paint: a texture of what the handler draws on a
// surface of that size. GDK_MEMORY_DEFAULT, 0 here, is cairo's ARGB32, 0
// too, so the surface's pixels are the texture's as they stand.
func _drawingPaint(w Widget) {
    var s = _imageSourceOf(w)
    if s != null {
        if s.painted && s.width > 0 && s.height > 0 {
            var width = s.width
            var height = s.height
            var surface = _surfaceNew(_CairoFormat(0), width, height)
            var cr = _cairoCreate(surface)
            var paint = s.paint
            paint(cr)
            _cairoDestroy(cr)
            _surfaceFlush(surface)
            var stride = _surfaceStride(surface)
            var px = _bytesNew(_pixelsPointer(_surfaceData(surface)), _Size(stride * height))
            var tex = _memoryTextureNew(width, height, _MemoryFormat(0), px, _Size(stride))
            _bytesUnref(px)
            _surfaceDestroy(surface)
            _imageSourceUnwatch(w)
            _imageSourceShow(w, tex, "")
        }
    }
}

func _rtDrawingSetWidth(drawing ImageDrawing, width float) {
    var w = _imageDrawingWidget(drawing)
    var s = _imageSourceOf(w)
    if s != null {
        _setImageSource(w, _ImageSourceState{url=s.url, ready=s.ready, err=s.err, told=s.told, width=_ceil(width), height=s.height, painted=s.painted, paint=s.paint})
        _drawingPaint(w)
    }
}

func _rtDrawingSetHeight(drawing ImageDrawing, height float) {
    var w = _imageDrawingWidget(drawing)
    var s = _imageSourceOf(w)
    if s != null {
        _setImageSource(w, _ImageSourceState{url=s.url, ready=s.ready, err=s.err, told=s.told, width=s.width, height=_ceil(height), painted=s.painted, paint=s.paint})
        _drawingPaint(w)
    }
}

func _rtDrawingOnPaint(drawing ImageDrawing, paint func(ctx CairoContext)) {
    var w = _imageDrawingWidget(drawing)
    var s = _imageSourceOf(w)
    if s != null {
        _setImageSource(w, _ImageSourceState{url=s.url, ready=s.ready, err=s.err, told=s.told, width=s.width, height=s.height, painted=true, paint=paint})
        _drawingPaint(w)
    }
}

func _rtDrawingRedraw(drawing ImageDrawing) {
    _drawingPaint(_imageDrawingWidget(drawing))
}

// Makes a texture of the bytes, held on the picture, and whether it could.
// GdkPixbuf rather than gdk_texture_new_from_bytes: its loaders read SVG as
// well as PNG and JPEG. GDK_MEMORY_R8G8B8A8 is 5 and GDK_MEMORY_R8G8B8 7.
func _pictureDecode(pic _Object, bytes _Bytes) bool {
    var l = _loaderNew()
    var wrote = _loaderWrite(l, _bufferAt(_bytesData(bytes, null)), _bytesSize(bytes), null)
    var closed = _loaderClose(l, null)
    var made = false
    if wrote && closed {
        var pb = _loaderPixbuf(l)
        if pb != null {
            var px = _pixbufBytes(pb)
            var tex = _memoryTextureNew(_pixbufWidth(pb), _pixbufHeight(pb), _MemoryFormat(_pixbufHasAlpha(pb) ? 5 : 7), px, _Size(_pixbufRowstride(pb)))
            _bytesUnref(px)
            _holdData(pic, "sngl-texture", _texturePointer(tex), _unrefData)
            made = true
        }
    }
    _unref(_loaderPointer(l))
    return made
}

// What a picture's URL named arrived, as bytes or as why not: a picture
// given back before it did goes as its reading lets go of it.
func _pictureArrived(pic _Object, bytes _Bytes, err string) {
    var p = _pictureStateOf(pic)
    if p != null {
        if !p.released {
            var why = ""
            if err != "" {
                why = "{p.url}: {err}"
            } else if int(_bytesSize(bytes)) == 0 {
                why = "{p.url}: empty"
            } else if !_pictureDecode(pic, bytes) {
                why = "{p.url}: not an image GTK can read"
            }
            _setPictureState(pic, _PictureState{url=p.url, arrived=true, err=why, holders=p.holders, released=p.released, width=p.width, height=p.height})
            _pictureTell(pic)
        }
    }
}

// Telling a source runs the program's @load or @error, which may give the
// picture back or show another in a source: the picture is held until each
// is told, and each is told from a copy of the list, if it is still
// watching.
func _pictureTell(pic _Object) {
    _pictureHold(pic)
    var told = _listCopy(_dataList(pic, "sngl-watching"))
    var n = int(_listLength(told))
    var i = 0
    for i < n {
        var w = _listNth(told, _Count(i))
        var p = _pictureStateOf(pic)
        if p != null {
            if !p.released && _listFind(_dataList(pic, "sngl-watching"), _constPointer(w)) != null {
                _imageSourceTake(_pointed(w), pic)
            }
        }
        i += 1
    }
    _listFree(told)
    _pictureLetGo(pic)
}

// A file the program carries is read at once, from those it was handed or
// else beside it; one fetched arrives from the main loop.
func loadPicture(url string) Picture {
    var pic = _objectAt(_objectNew(_objectType(), null))
    _setPictureState(pic, _PictureState{url=url, arrived=false, err="", holders=1, released=false, width=0, height=0})
    var picture = _asPicture(pic)
    _pictureRead(url, picture, _pictureArrived)
    return picture
}

func _pictureHold(pic _Object) {
    var p = _pictureStateOf(pic)
    if p != null {
        if !p.released {
            _setPictureState(pic, _PictureState{url=p.url, arrived=p.arrived, err=p.err, holders=p.holders + 1, released=false, width=p.width, height=p.height})
        }
    }
}

// The sources showing a picture given back keep what they show.
func _pictureLetGo(pic _Object) {
    var p = _pictureStateOf(pic)
    if p != null {
        if !p.released {
            if p.holders > 1 {
                _setPictureState(pic, _PictureState{url=p.url, arrived=p.arrived, err=p.err, holders=p.holders - 1, released=false, width=p.width, height=p.height})
            } else {
                _setPictureState(pic, _PictureState{url=p.url, arrived=p.arrived, err=p.err, holders=0, released=true, width=p.width, height=p.height})
                var watching = _dataList(pic, "sngl-watching")
                var n = int(_listLength(watching))
                var i = 0
                for i < n {
                    _setData(_object(_pointed(_listNth(watching, _Count(i)))), "sngl-picture", null)
                    i += 1
                }
                _listFree(watching)
                _setData(pic, "sngl-watching", null)
                _unref(_objectPointer(pic))
            }
        }
    }
}

func refPicture(p Picture) Picture {
    _pictureHold(_pictureObject(p))
    return p
}

func unrefPicture(p Picture) {
    _pictureLetGo(_pictureObject(p))
}

// Scales the picture's texture to sw by sh, and whether it has one to: from
// its pixels for cairo, made the first time.
func _pictureScale(pic _Object, tex _Texture, sw int, sh int) bool {
    if _data(pic, "sngl-surface") == null {
        var tw = _textureWidth(tex)
        var th = _textureHeight(tex)
        if tw <= 0 || th <= 0 {
            return false
        }
        var made = _surfaceNew(_CairoFormat(0), tw, th)
        _textureDownload(tex, _pixelsOut(_surfaceData(made)), _Size(_surfaceStride(made)))
        _surfaceMarkDirty(made)
        _holdData(pic, "sngl-surface", _surfacePointer(made), _surfaceGone)
    }
    var full = _data(pic, "sngl-surface")
    if full != null {
        var surface = _surfaceAt(full)
        var scaled = _surfaceNew(_CairoFormat(0), sw, sh)
        var sc = _cairoCreate(scaled)
        sc.scale(float(sw) / float(_surfaceWidth(surface)), float(sh) / float(_surfaceHeight(surface)))
        _cairoSetSourceSurface(sc, surface, 0.0, 0.0)
        _cairoPaint(sc)
        _cairoDestroy(sc)
        _holdData(pic, "sngl-scaled", _surfacePointer(scaled), _surfaceGone)
        var p = _pictureStateOf(pic)
        if p != null {
            _setPictureState(pic, _PictureState{url=p.url, arrived=p.arrived, err=p.err, holders=p.holders, released=p.released, width=sw, height=sh})
        }
    }
    return true
}

func _surfaceGone(p _Pointer) {
    _surfaceDestroy(_surfaceAt(p))
}

// Paints a picture into a box, scaled to the box once and painted from that
// until the box changes size; one still on its way paints nothing, and is
// there the next time the drawing paints after it arrives.
func paintPicture(cr CairoContext, p Picture, x float, y float, w float, h float) {
    var pic = _pictureObject(p)
    var tex = _data(pic, "sngl-texture")
    var st = _pictureStateOf(pic)
    if tex != null && st != null && w > 0.0 && h > 0.0 {
        var sw = _ceil(w)
        var sh = _ceil(h)
        var ready = true
        if _data(pic, "sngl-scaled") == null || st.width != sw || st.height != sh {
            ready = _pictureScale(pic, _textureAt(tex), sw, sh)
        }
        var scaled = _data(pic, "sngl-scaled")
        if ready && scaled != null {
            cr.save()
            _cairoSetSourceSurface(cr, _surfaceAt(scaled), x, y)
            _cairoPaint(cr)
            cr.restore()
        }
    }
}

// GTK 4 takes a window's icon by name only, so the source's picture is
// written into a directory of the icon theme's search path under a name of
// its own, a new one each time it changes.
func _iconApply(toplevel Widget, source Widget) {
    var win = _toplevelWindow(toplevel)
    var tex = _data(_object(source), "sngl-texture")
    if win != null && tex != null {
        var dir = _iconDir()
        if dir != "" {
            var display = _displayObject(_defaultDisplay())
            var count = 1
            var icons = _heldIcons(display, "sngl-icons")
            if icons != null {
                count = icons.count + 1
            }
            _holdIcons(display, "sngl-icons", _IconsState{count=count})
            var name = "sngl-icon-{_processId()}-{count}"
            if _textureSavePng(_textureAt(tex), "{dir}/{name}.png") {
                _windowSetIconName(win, name)
            }
        }
    }
}

// A window made shows the icon it holds.
func _iconRefresh(box Widget) {
    var source = _dataWidget(_object(box), "sngl-icon")
    if source != null {
        _iconApply(box, source)
    }
}

// A window takes a source appended to it as its icon rather than as a
// widget.
func _imageAdopt(box Widget, child Widget) bool {
    if _imageSourceOf(child) == null || !_isToplevel(box) {
        return false
    }
    _ref(_pointer(child))
    _holdData(_object(box), "sngl-icon-widget", _pointer(child), _unrefData)
    _setDataTo(_object(box), "sngl-icon", _pointer(child))
    _setDataTo(_object(child), "sngl-icon-of", _pointer(box))
    _iconApply(box, child)
    return true
}

func _imageUnadopt(box Widget, child Widget) bool {
    var icon = _dataWidget(_object(box), "sngl-icon")
    if icon != null && _imageSourceOf(child) != null {
        if icon == child {
            _setData(_object(child), "sngl-icon-of", null)
            _setData(_object(box), "sngl-icon", null)
            _setData(_object(box), "sngl-icon-widget", null)
            return true
        }
    }
    return false
}

const component ui.image[platform](fit, style, @click, @load, @error, src) {
    Image #frame(
        fit = string(fit),
        look = lookOf(style),
        @click { click() },
        @load { load() },
        @failed { error({message=imageFailure(frame), kind="image"}) },
    ) {
        src
    }
}

const component ui.file[platform](path) {
    func picture() => loadPicture(path)

    ImageUrl(url=path, picture=picture)
}

const component ui.remote[platform](url) {
    func picture() => loadPicture(url)

    ImageUrl(url=url, picture=picture)
}

const component draw.image[platform](width, height, shapes) {
    ImageDrawing(width=width, height=height) {
        shapes
    }
}

// --- Drawing ---

// A canvas is a GtkDrawingArea whose drawing -- the shapes, as the calls the
// overrides below make -- is the handler of its `@paint`, handed cairo's
// context, which lowering connects as it connects any handler; a write to
// what the drawing reads asks for a paint through its redraw. cairo's own
// functions are the drawing's vocabulary, but for what it takes as an enum,
// which the runtime casts (rt's sngl_cairo_*).
#[c.native("cairo_t *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoContext")]
struct CairoContext {}

#[c.native("cairo_save")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoSave")]
func CairoContext.save()

#[c.native("cairo_restore")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoRestore")]
func CairoContext.restore()

#[c.native("cairo_set_source_rgba")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoSetSourceRgba")]
func CairoContext.setSourceRgba(r float, g float, b float, a float)

#[c.native("cairo_set_line_width")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoSetLineWidth")]
func CairoContext.setLineWidth(w float)

#[c.native("sngl_cairo_line_cap")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCairoLineCap")]
func CairoContext.setLineCap(cap int)

#[c.native("sngl_cairo_line_join")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCairoLineJoin")]
func CairoContext.setLineJoin(join int)

#[c.native("cairo_rectangle")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoRectangle")]
func CairoContext.rectangle(x float, y float, w float, h float)

#[c.native("cairo_new_sub_path")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoNewSubPath")]
func CairoContext.newSubPath()

#[c.native("cairo_arc")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoArc")]
func CairoContext.arc(cx float, cy float, r float, start float, end float)

#[c.native("cairo_arc_negative")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoArcNegative")]
func CairoContext.arcNegative(cx float, cy float, r float, start float, end float)

#[c.native("cairo_move_to")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoMoveTo")]
func CairoContext.moveTo(x float, y float)

#[c.native("cairo_line_to")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoLineTo")]
func CairoContext.lineTo(x float, y float)

#[c.native("cairo_curve_to")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoCurveTo")]
func CairoContext.curveTo(x1 float, y1 float, x2 float, y2 float, x3 float, y3 float)

#[c.native("cairo_close_path")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoClosePath")]
func CairoContext.closePath()

#[c.native("cairo_fill")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoFill")]
func CairoContext.fill()

#[c.native("cairo_fill_preserve")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoFillPreserve")]
func CairoContext.fillPreserve()

#[c.native("cairo_stroke")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoStroke")]
func CairoContext.stroke()

#[c.native("sngl_cairo_font")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCairoFont")]
func CairoContext.font(family string, size float)

#[c.native("cairo_show_text")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoShowText")]
func CairoContext.showText(text string)

#[c.native("cairo_translate")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoTranslate")]
func CairoContext.translate(x float, y float)

#[c.native("cairo_scale")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoScale")]
func CairoContext.scale(x float, y float)

#[c.native("cairo_clip")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.CairoClip")]
func CairoContext.clip()

// What a `@draw` handler is handed: the context, and the coordinate space
// the shapes were placed in.
struct DrawEvent {
    ctx    CairoContext
    width  int
    height int
}

// The primitive every shape below paints through: its handler is spliced
// into the drawing, written against the canvas's context.
#[marks.intrinsic("gtk4:draw")]
component Paint(@draw(e DrawEvent)) draw.shape

// The drawing area a `draw.canvas` is. Its width and height are the space
// its shapes are placed in, and `scalingMode` how that space is shown in the
// room it is given.
#[marks.intrinsic("gtk4:Canvas")]
component Canvas(
    width       ui.measurement,
    height      ui.measurement,
    scalingMode draw.ScalingMode,
    @click(),
    @paint(ctx CairoContext),
    shapes      ...component draw.shape,
) ui.node

#[c.native("sngl_canvas_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCanvasNew")]
func _rtCanvasNew() Canvas

#[c.native("sngl_canvas_set_width")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCanvasSetWidth")]
func _rtCanvasSetWidth(w Canvas, width int)

#[c.native("sngl_canvas_set_height")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCanvasSetHeight")]
func _rtCanvasSetHeight(w Canvas, height int)

#[c.native("sngl_canvas_set_scaling")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCanvasSetScaling")]
func _rtCanvasSetScaling(w Canvas, mode int)

// Runs `fn` from the main loop when it is next idle: how `async.do` hands
// work a goroutine finished back in Go. C posts through sngl_post itself.
#[c.native("sngl_post")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglPost")]
func _rtPost(
    #[c.type("SnglFn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("GDestroyNotify")] #[c.release] rel c.pointer,
)

#[c.native("sngl_on_click")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglOnClick")]
func _rtOnClick(
    w ui.node,
    #[c.type("SnglFn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("GDestroyNotify")] #[c.release] rel c.pointer,
)

#[c.native("sngl_click")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglClick")]
func _rtClick(w ui.node)

#[c.native("sngl_canvas_on_paint")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCanvasOnPaint")]
func _rtCanvasOnPaint(
    w Canvas,
    #[c.type("SnglDrawFn")] fn func(ctx CairoContext),
    #[c.context] ctx c.pointer,
    #[c.type("GDestroyNotify")] #[c.release] rel c.pointer,
)

#[c.native("sngl_canvas_redraw")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCanvasRedraw")]
func _rtCanvasRedraw(w Canvas)

#[gen.protocol(create)]
func _create_Canvas() Canvas {
    return _rtCanvasNew()
}

#[gen.protocol(set)]
func _set_Canvas_width(w Canvas, width ui.measurement) {
    _rtCanvasSetWidth(w, int(px(width)))
}

#[gen.protocol(set)]
func _set_Canvas_height(w Canvas, height ui.measurement) {
    _rtCanvasSetHeight(w, int(px(height)))
}

#[gen.protocol(set)]
func _set_Canvas_scalingMode(w Canvas, scalingMode draw.ScalingMode) {
    _rtCanvasSetScaling(w, int(scalingMode))
}

#[gen.protocol(on)]
func _on_Canvas_click(w Canvas, click func()) {
    _rtOnClick(w, click)
}

#[gen.fires("click")]
func _fire_Canvas_click(w Canvas) {
    _rtClick(w)
}

#[gen.protocol(on)]
func _on_Canvas_paint(w Canvas, paint func(ctx CairoContext)) {
    _rtCanvasOnPaint(w, paint)
}

#[gen.protocol(redraw)]
func _redraw_Canvas(w Canvas) {
    _rtCanvasRedraw(w)
}

// cairo wants each channel as 0..1 where SNGL carries 0..255.
func source(ctx CairoContext, c color) {
    ctx.setSourceRgba(float(c.r) / 255.0, float(c.g) / 255.0, float(c.b) / 255.0, float(c.a) / 255.0)
}

// Fill then stroke the current path, keeping it between the two where both
// apply.
func paint(ctx CairoContext, style draw.Style) {
    if style.fill.a > 0 {
        source(ctx, style.fill)
        if style.stroke.a > 0 {
            ctx.fillPreserve()
        } else {
            ctx.fill()
        }
    }
    if style.stroke.a > 0 {
        ctx.setLineWidth(style.strokeWidth)
        ctx.setLineCap(int(style.lineCap))
        ctx.setLineJoin(int(style.lineJoin))
        source(ctx, style.stroke)
        ctx.stroke()
    }
}

// The corner `sngl:ui/draw` solves, drawn as a line in and an arc, which
// leaves the path at the point it answers: cairo takes a center and two
// angles where the command gives three points and a radius.
func arcTo(ctx CairoContext, from draw.Point, corner draw.Point, to draw.Point, r float) draw.Point {
    var a = draw.tangentArc(from, corner, to, r)
    if a.degenerate {
        ctx.lineTo(corner.x, corner.y)
        return corner
    }
    ctx.lineTo(a.tangent1.x, a.tangent1.y)
    if a.sweep < 0.0 {
        ctx.arcNegative(a.center.x, a.center.y, r, a.start, a.start + a.sweep)
    } else {
        ctx.arc(a.center.x, a.center.y, r, a.start, a.start + a.sweep)
    }
    return a.tangent2
}

// What a `drawSource` paints a carried or fetched image with: the context,
// the URL its source names and the picture the source holds.
struct SourceEvent {
    ctx     CairoContext
    url     string
    picture Picture
}

// The primitive a `canvasImage` paints its source through. `@url` paints an
// image a URL names; a drawing is painted in place rather than as a picture,
// its shapes between `@enter`, which maps the drawing's own space onto the
// box and clips to it, and `@leave`. The size in their payload is the
// drawing's.
#[marks.intrinsic("gtk4:drawSource")]
component drawSource(
    @url(e SourceEvent),
    @enter(e DrawEvent),
    @leave(e DrawEvent),
    source ...component family.one[ui.imageSource],
) draw.shape

// A canvas's `style` reaches nothing: it is no shape's, and the area's
// background is its box's.
const component draw.canvas[platform](width, height, scalingMode, @click, shapes) {
    Canvas(width=width, height=height, scalingMode=scalingMode, @click { click() }) {
        shapes
    }
}

const component draw.rect[platform](x, y, w, h, style) {
    Paint(@draw(e) {
        e.ctx.save()
        e.ctx.rectangle(x, y, w, h)
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

const component draw.circle[platform](cx, cy, r, style) {
    Paint(@draw(e) {
        e.ctx.save()
        e.ctx.newSubPath()
        e.ctx.arc(cx, cy, r, 0.0, math.tau)
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

// An ellipse as four cubic segments rather than a scaled circle:
// `cairo_scale` would scale the stroke with the axes. kappa is the
// control-point offset that makes a cubic match a quarter arc to within a
// thousandth.
const component draw.ellipse[platform](cx, cy, rx, ry, style) {
    Paint(@draw(e) {
        var k = 0.5522847498307936
        var ox = rx * k
        var oy = ry * k

        e.ctx.save()
        e.ctx.newSubPath()
        e.ctx.moveTo(cx, cy - ry)
        e.ctx.curveTo(cx + ox, cy - ry, cx + rx, cy - oy, cx + rx, cy)
        e.ctx.curveTo(cx + rx, cy + oy, cx + ox, cy + ry, cx, cy + ry)
        e.ctx.curveTo(cx - ox, cy + ry, cx - rx, cy + oy, cx - rx, cy)
        e.ctx.curveTo(cx - rx, cy - oy, cx - ox, cy - ry, cx, cy - ry)
        e.ctx.closePath()
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

// A line has no inside, so its fill is not read.
const component draw.line[platform](x1, y1, x2, y2, style) {
    Paint(@draw(e) {
        e.ctx.save()
        e.ctx.moveTo(x1, y1)
        e.ctx.lineTo(x2, y2)
        e.ctx.setLineWidth(style.strokeWidth)
        e.ctx.setLineCap(int(style.lineCap))
        e.ctx.setLineJoin(int(style.lineJoin))
        source(e.ctx, style.stroke)
        e.ctx.stroke()
        e.ctx.restore()
    })
}

const component draw.path[platform](style, steps) {
    Paint(@draw(e) {
        // Where the path is, which `arcTo` needs and cairo will not hand back
        // without an out-parameter.
        var at = draw.Point{x=0.0, y=0.0}

        e.ctx.save()
        for var c = steps {
            if c.op == draw.PathOp.moveTo {
                e.ctx.moveTo(c.x, c.y)
                at = draw.Point{x=c.x, y=c.y}
            }
            if c.op == draw.PathOp.lineTo {
                e.ctx.lineTo(c.x, c.y)
                at = draw.Point{x=c.x, y=c.y}
            }
            if c.op == draw.PathOp.bezierTo {
                e.ctx.curveTo(c.cx1, c.cy1, c.cx2, c.cy2, c.x, c.y)
                at = draw.Point{x=c.x, y=c.y}
            }
            if c.op == draw.PathOp.arcTo {
                at = arcTo(e.ctx, at, draw.Point{x=c.cx1, y=c.cy1}, draw.Point{x=c.x, y=c.y}, c.r)
            }
            if c.op == draw.PathOp.close {
                e.ctx.closePath()
            }
        }
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

const component draw.canvasText[platform](x, y, content, style) {
    Paint(@draw(e) {
        e.ctx.save()
        e.ctx.font(style.fontFamily, style.fontSize)
        source(e.ctx, style.fill)
        e.ctx.moveTo(x, y)
        e.ctx.showText(content)
        e.ctx.restore()
    })
}

const component draw.canvasImage[platform](x, y, w, h, src) {
    drawSource(
        @url(e) {
            paintPicture(e.ctx, e.picture, x, y, w, h)
        },
        @enter(e) {
            e.ctx.save()
            e.ctx.translate(x, y)
            e.ctx.scale(w / float(e.width), h / float(e.height))
            e.ctx.rectangle(0.0, 0.0, float(e.width), float(e.height))
            e.ctx.clip()
        },
        @leave(e) {
            e.ctx.restore()
        },
    ) {
        src
    }
}
