import ui "sngl:ui"
import time "sngl:time"
import . "sngl:macro"
import build "sngl:build"
import marks "sngl:internal/marks"
import shapes "sngl:ui/draw"
import markup "sngl:ui/markup"
import math "sngl:math"
import go "sngl:language/go"
import gen "sngl:x/gen"
import c "sngl:x/c"
import family "sngl:family"
import gtk "gir:Gtk-4.0"

// The `gtk4` node of a build directive: `output { go { gtk4() } }`.
// A GLib idle callback runs on the thread that owns every widget, so a blocking
// call can be moved off it and its answer written back.
#[gen.can(asyncPost, instanceState)]
// Withholding reactivity is what asks for the explicit `nID.<prop> = <expr>`
// after every mutation of a tracked var, which the prop's declared set makes a
// call (`#[gen.protocol(set)]`); withholding declarative flattens the tree
// into the calls that build it. The same pair fyne takes, and for the same
// reason: GTK owns its widgets and diffs nothing.
#[gen.cannot(reactivity, declarative, inlineComponents, structSpread)]
#[gen.wants(structComponents, stdlibContextParam, canvas, reactiveCanvas)]
#[gen.name("gtk4")]
#[gen.native("gtk4")]
component platform(
    // Go package name for the generated files.
    const package       string,
    // Emit a standalone main() or a library-style module.
    const main          bool,
    // The process start, wrapped: what the handler does before calling `run`
    // happens before the event loop, and what it does after, once the loop
    // has exited. `run` presents the windows and runs the loop. A handler
    // that never calls it gets a process whose loop still runs -- timers,
    // effects, posted work -- with no window on screen. The application has
    // torn down when `run` returns, and a second call ends the process. `args`
    // is the command line after the program's name.
    @run(args list[string], run func()),
    // Which introspection data to read the widget vocabulary from: "builtin"
    // for the bundled subset, a path to a `Gtk-4.0.gir`, or unset to probe the
    // system locations and fall back to the bundled subset.
    const gir           string,
    // Make, fill and write a GIR class through the C functions GTK names, from
    // the generated file itself, rather than through pkg/go/gtk4rt. Every
    // string handed to GTK is then the generated code's own, and the file
    // builds with cgo whatever it renders.
    const cgo           bool = false,
    // What its generated code introduces beside a program's names: the packages
    // it imports -- `C` is cgo's, which a Go export of `c` would be -- an
    // instance record's receiver, the Model's own members, and the locals and
    // helpers its application code declares.
    const reservedNames list[string] = [
        "gtk4rt",
        "c",
        "app",
        "win",
        "buildUI",
        "buildWidgetTree",
        "snglCallbacks",
        "snglDrawFuncs",
        "gtkPost",
        "snglGoDispatch",
        "snglIdleCallback",
        "snglActivate",
        "boolToInt",
        "snglCalendarDate",
        "snglCalendarSelect",
    ],
) build.platform

// --- Windows ---

// A toplevel: the host object a `ui.window` is on this platform. A node the
// package body holds is attached to the application, and attaching one of
// these creates the GtkWindow and puts it on screen once the loop runs;
// removing one, as an `if` turning false does, destroys it and everything in
// it. `visible` shows and hides it without destroying it, and the window
// manager's close is reported as `visible = false` followed by `@closed`.
//
// The menu entries and the way back among its content are the menu behind
// its header bar's menu button and its back button.
#[marks.intrinsic("gtk4:Toplevel")]
component Toplevel(
    title    string,
    :visible bool = true,
    @closed(),
    content  ...component ui.node,
) root

// A window is gtk4rt's toplevel in either mode: the box its content is
// appended to, which keeps the title, visibility and handlers until the
// window is made around it. gtk4rt copies the title into C itself.
#[go.native(_rtPkg, "gtk4rt.ToplevelNew")]
func _rtToplevelNew() Toplevel

#[go.native(_rtPkg, "gtk4rt.ToplevelSetTitle")]
func _rtToplevelSetTitle(w Toplevel, title string)

#[go.native(_rtPkg, "gtk4rt.ToplevelSetVisible")]
func _rtToplevelSetVisible(w Toplevel, visible bool)

#[go.native(_rtPkg, "gtk4rt.ToplevelOnClosed")]
func _rtToplevelOnClosed(w Toplevel, fn func())

#[go.native(_rtPkg, "gtk4rt.ToplevelOnVisible")]
func _rtToplevelOnVisible(w Toplevel, fn func(visible bool))

#[go.native(_rtPkg, "gtk4rt.BoxAppend")]
func _rtToplevelAppend(box Toplevel, child ui.node)

#[go.native(_rtPkg, "gtk4rt.BoxRemove")]
func _rtToplevelRemove(box Toplevel, child ui.node)

#[gen.protocol(create)]
func _create_Toplevel() Toplevel {
    return _rtToplevelNew()
}

#[gen.protocol(append)]
func _append_Toplevel(parent Toplevel, child ui.node) {
    _rtToplevelAppend(parent, child)
}

#[gen.protocol(remove)]
func _remove_Toplevel(parent Toplevel, child ui.node) {
    _rtToplevelRemove(parent, child)
}

#[gen.protocol(set)]
func _set_Toplevel_title(w Toplevel, title string) {
    _rtToplevelSetTitle(w, title)
}

#[gen.protocol(set)]
func _set_Toplevel_visible(w Toplevel, visible bool) {
    _rtToplevelSetVisible(w, visible)
}

// The window manager's close and the host's own change of `visible` are
// gtk4rt's to report: the window raises close-request, which it answers.
#[gen.protocol(on)]
func _on_Toplevel_closed(w Toplevel, closed func()) {
    _rtToplevelOnClosed(w, closed)
}

#[gen.protocol(on)]
func _on_Toplevel_visible(w Toplevel, visible func(visible bool)) {
    _rtToplevelOnVisible(w, visible)
}

// A window's way back, while it can go back: a widget gtk4rt keeps hidden
// among the window's content, which has the window show a back button that
// presses it.
#[marks.intrinsic("gtk4:Back")]
component Back(@press()) ui.node

#[go.native(_rtPkg, "gtk4rt.BackNew")]
func _rtBackNew() Back

#[go.native(_rtPkg, "gtk4rt.BackOnPress")]
func _rtBackOnPress(b Back, fn func())

#[gen.protocol(create)]
func _create_Back() Back {
    return _rtBackNew()
}

#[gen.protocol(on)]
func _on_Back(b Back, press func()) {
    _rtBackOnPress(b, press)
}

// One entry of a window's menu, and its submenu's entries: a box gtk4rt keeps
// hidden among the window's content, from which the window builds the GMenu
// behind its header bar's menu button. Picking one is no GTK signal on it but
// the action gtk4rt makes for it.
#[marks.intrinsic("gtk4:MenuEntry")]
component MenuEntry(
    label    string,
    disabled bool = false,
    checked  bool = false,
    @select(),
    entries  ...component ui.node,
) ui.node

#[go.native(_rtPkg, "gtk4rt.MenuEntryNew")]
func _rtMenuEntryNew() MenuEntry

#[go.native(_rtPkg, "gtk4rt.MenuEntrySetLabel")]
func _rtMenuEntrySetLabel(e MenuEntry, label string)

#[go.native(_rtPkg, "gtk4rt.MenuEntrySetDisabled")]
func _rtMenuEntrySetDisabled(e MenuEntry, v bool)

#[go.native(_rtPkg, "gtk4rt.MenuEntrySetChecked")]
func _rtMenuEntrySetChecked(e MenuEntry, v bool)

#[go.native(_rtPkg, "gtk4rt.MenuEntryOnSelect")]
func _rtMenuEntryOnSelect(e MenuEntry, fn func())

#[go.native(_rtPkg, "gtk4rt.BoxAppend")]
func _rtMenuEntryAppend(e MenuEntry, child ui.node)

#[go.native(_rtPkg, "gtk4rt.BoxRemove")]
func _rtMenuEntryRemove(e MenuEntry, child ui.node)

#[gen.protocol(create)]
func _create_MenuEntry() MenuEntry {
    return _rtMenuEntryNew()
}

#[gen.protocol(append)]
func _append_MenuEntry(parent MenuEntry, child ui.node) {
    _rtMenuEntryAppend(parent, child)
}

#[gen.protocol(remove)]
func _remove_MenuEntry(parent MenuEntry, child ui.node) {
    _rtMenuEntryRemove(parent, child)
}

#[gen.protocol(set)]
func _set_MenuEntry_label(e MenuEntry, label string) {
    _rtMenuEntrySetLabel(e, label)
}

#[gen.protocol(set)]
func _set_MenuEntry_disabled(e MenuEntry, disabled bool) {
    _rtMenuEntrySetDisabled(e, disabled)
}

#[gen.protocol(set)]
func _set_MenuEntry_checked(e MenuEntry, checked bool) {
    _rtMenuEntrySetChecked(e, checked)
}

#[gen.protocol(on)]
func _on_MenuEntry(e MenuEntry, select func()) {
    _rtMenuEntryOnSelect(e, select)
}

// The window's `@error` is the outermost boundary of what it renders, and
// catches whether or not the call site handles one.
//
// Its menu's entries are drawn two deep: a top-level entry and its submenu. A
// window whose call site gives it no `canGoBack` writes no Back, the `if`
// folding away, and nor does one with no menu write an entry.
const component ui.window[platform](title, visible, canGoBack, @error, @closed, @back, content, favicon, menu) {
    Toplevel(title=title, :visible=visible, @closed { closed() }) {
        boundary(@error(e) { error(e) }) {
            content
        }
        #[family.crosses]
        favicon
        if canGoBack {
            Back(@press { back() })
        }
        for var i, it = menu {
            MenuEntry(label=it.label, disabled=it.disabled, checked=it.checked, @select { it.select() }) {
                for var j, sub = it.children {
                    MenuEntry(label=sub.label, disabled=sub.disabled, checked=sub.checked, @select { sub.select() })
                }
            }
        }
    }
}

// --- Leaf widgets ---

// What a control holds, read off its widget. A GTK signal hands its handler
// the widget it fired on and nothing else, so an override reporting a change
// asks that widget: `@toggled(b) { checked = checkActive(b) }`.
#[marks.intrinsic("gtk4.checkActive")]
func checkActive(b gtk.GtkCheckButton) bool

#[marks.intrinsic("gtk4.switchActive")]
func switchActive(s gtk.GtkSwitch) bool

#[marks.intrinsic("gtk4.entryText")]
func entryText(e gtk.GtkEntry) string

// Writes an entry's text, which an override does itself rather than binding
// `text`: see ui.input. gtk4rt blocks "changed" around the write and copies
// the text into C itself, so neither mode's generated file calls C for it.
#[go.native(_rtPkg, "gtk4rt.EditableSetTextQuiet")]
func setEntryText(e gtk.GtkEntry, text string)

// The day a calendar has selected. A calendar always has one, so this is null
// only where GTK reports no date at all.
#[marks.intrinsic("gtk4.calendarDate")]
func calendarDate(c gtk.GtkCalendar) option[time.date]

// A text starts at the left of its box, as html's does: a GtkLabel centers
// its words in whatever room it is given.
const component ui.text[platform](value, style) {
    gtk.GtkLabel(label=value, xalign=0.0, look=lookOf(style)) {}
}

const component ui.button[platform](text, style, @click) {
    gtk.GtkButton(label=text, look=lookOf(style), @clicked { click() }) {}
}

const component ui.checkbox[platform](label, checked, style, @change) {
    gtk.GtkCheckButton(label=label, active=checked, look=lookOf(style), @toggled(b) {
        if checkActive(b) != checked {
            checked = checkActive(b)
            change(checked)
        }
    }) {}
}

const component ui.image[platform](fit, style, @click, @load, @error, src) {
    Image(
        fit = string(fit),
        look = lookOf(style),
        @click {
            click()
        },
        @load {
            load()
        },
        @failed(m) {
            error({message=m, kind="image"})
        },
    ) {
        src
    }
}

// The value is pushed by an effect rather than bound: setting an entry's text
// deletes and reinserts it, firing "changed" for each, so writing back the
// text "changed" just reported re-entered the handler until the stack
// overflowed. Only a value the entry does not already show is written.
const component ui.input[platform](value, style, @input, @change) {
    gtk.GtkEntry #entry(
        look = lookOf(style),
        @changed(e) {
            if entryText(e) != value {
                value = entryText(e)
                input(value)
            }
        },
        @activate(e) {
            value = entryText(e)
            change(value)
        },
    ) {}
    effect(on=value, @mount(v) {
        if entryText(entry) != v {
            setEntryText(entry, v)
        }
    })
}

// gtk4 has no lightweight multi-line entry; map textarea to GtkEntry so
// the value binding + changed handler compile and round-trip. (Rich
// multi-line GtkTextView support is a future enhancement.)
const component ui.textarea[platform](value, style, @input, @change) {
    gtk.GtkEntry #entry(
        look = lookOf(style),
        @changed(e) {
            if entryText(e) != value {
                value = entryText(e)
                input(value)
            }
        },
        @activate(e) {
            value = entryText(e)
            change(value)
        },
    ) {}
    effect(on=value, @mount(v) {
        if entryText(entry) != v {
            setEntryText(entry, v)
        }
    })
}

// --- Container widgets ---

const component ui.vbox[platform](style, children) {
    gtk.GtkBox(orientation="vertical", spacing=spacingOf(style, 6), look=lookOf(style)) {
        children
    }
}

const component ui.hbox[platform](style, children) {
    gtk.GtkBox(orientation="horizontal", spacing=spacingOf(style, 6), look=lookOf(style)) {
        children
    }
}

const component ui.scroll[platform](style, direction, @reachEnd, content) {
    Scroll(direction=string(direction), look=lookOf(style), @reachEnd { reachEnd() }) {
        content
    }
}

// --- Indicators ---

// GtkProgressBar's fraction is 0..1, so the value is measured against max here
// rather than passed through as if it already were one.
//
// GTK spells indeterminate as repeated gtk_progress_bar_pulse() calls rather
// than as a property, and an override has no clock to drive them, so a bar
// given no value is an empty one. Written as two calls rather than as one with
// a ternary because a ternary is lowered to a temporary on a language with no
// conditional expression, and that happens before the fold that would have
// settled it -- `C.double(__lt0)` where `__lt0 = (2 / 10)`, which is Go
// integer division.
const component ui.progress[platform](style, value, max, label, showValue) {
    if value != null {
        gtk.GtkProgressBar(fraction=value / max, text=label, showText=showValue, look=lookOf(style)) {}
    } else {
        gtk.GtkProgressBar(fraction=0.0, text=label, showText=showValue, look=lookOf(style)) {}
    }
}

const component ui.spinner[platform](label, style) {
    gtk.GtkSpinner(spinning=true, tooltipText=label, look=lookOf(style)) {}
}

// `direction` is not forwarded: orientation is a GtkOrientation, and the
// only SNGL value that reaches a GTK enum is a string literal naming one of
// its members, which the prop's set folds to the member's value where it is
// written — a prop reference has no compile-time member to name. A separator is therefore horizontal, which is what
// `direction` defaults to.
const component ui.divider[platform](style) {
    gtk.GtkSeparator(look=lookOf(style)) {}
}

const component ui.link[platform](text, href, disabled, style, @click) {
    gtk.GtkLinkButton(uri=href, label=text, sensitive=(disabled == false), look=lookOf(style), @clicked { click() }) {}
}

// A flip reaches the program through `notify::active`: GtkSwitch's own
// `state-set` returns a gboolean, which the connect trampoline cannot carry.
const component ui.toggle[platform](checked, disabled, style, @change) {
    gtk.GtkSwitch(active=checked, sensitive=(disabled == false), look=lookOf(style), @notifyActive(s) {
        if switchActive(s) != checked {
            checked = switchActive(s)
            change(checked)
        }
    }) {}
}

// GtkCalendar takes the day, month and year as three separate ints -- its own
// `date` property is a GLib.DateTime, which no SNGL expression produces -- and
// a `date` offers no way to take those three apart. So the calendar is shown
// and its selection reported, and the bound value does not reach it, whether
// or not the `option` holds one.
// Selects y-m-d on a calendar as a click on the day does: gtk4rt's
// sngl_calendar_select, since the setter GTK 4.20 adds is not in the GTKs
// before it and the one they have is deprecated in it.
#[go.native(_rtPkg, "gtk4rt.CalendarSelectDay")]
func selectDay(cal gtk.GtkCalendar, y int, m int, d int)

// One calendar, which a bound date selects whenever it changes. With no date
// it shows GTK's own, today: a calendar always has a day selected.
const component ui.datepicker[platform](value, disabled, style, @change) {
    gtk.GtkCalendar #cal(sensitive=(disabled == false), look=lookOf(style), @daySelected(c) {
        value = calendarDate(c)
        change(value)
    }) {}
    effect(on=value, @mount(v) {
        if v != null {
            selectDay(cal, v.year(), v.month(), v.day())
        }
    })
}

// --- Layout ---

const component ui.spacer[platform](style) {
    gtk.GtkBox(hexpand=true, vexpand=true, look=lookOf(style)) {}
}

// The same shape html uses: a wrapper carrying the tooltip text, with the
// wrapped content inside it.
const component ui.tooltip[platform](style, text, trigger) {
    gtk.GtkBox(tooltipText=text, look=lookOf(style)) {
        trigger
    }
}

// A clickable card is its frame inside a frameless GtkButton, which gives it
// the hover, the press and the focus stop a button has.
const component ui.card[platform](style, clickable, @click, content) {
    if clickable {
        gtk.GtkButton(hasFrame=false, look=lookOf(style), @clicked { click() }) {
            gtk.GtkFrame {
                content
            }
        }
    } else {
        gtk.GtkFrame(look=lookOf(style)) {
            content
        }
    }
}

const component ui.stack[platform](style, layers) {
    gtk.GtkStack(look=lookOf(style)) {
        layers
    }
}

// `open` reaches the popover as widget visibility rather than as
// gtk_popover_popup: the emitter has one setter path per property and
// popup/popdown is a pair of calls chosen by the value. `position` is a
// GtkPositionType, so it is unreachable for the same reason as divider's
// orientation.
const component ui.popover[platform](style, open, @close, content) {
    gtk.GtkPopover(visible=open && shown(style), autohide=true, look=lookBesideVisible(style), @closed { close() }) {
        content
    }
}

// A check button's `active` marks a table's or a tree's selection. Clicking
// the selected one unchecks it on screen and changes nothing, since GTK has no
// way here to refuse the toggle.

// A row per box, each homogeneous so every cell takes an equal share and the
// columns line up. GtkColumnView is GTK's table, but it is fed through a list
// model and item factories, which nothing here can declare. A selectable table
// leads each row with a check button that selects it; a sortable header's
// cells are buttons reporting the column.
const component ui.table[platform](style, columns, selectable, selected, sortable, @select, @sort, rows) {
    gtk.GtkBox(orientation="vertical", spacing=spacingOf(style, 0), look=lookOf(style)) {
        gtk.GtkBox(orientation="horizontal", homogeneous=true) {
            if selectable {
                gtk.GtkLabel(label="") {}
            }
            for var col = columns {
                if sortable {
                    gtk.GtkButton(label=col, @clicked { sort(col) }) {}
                } else {
                    gtk.GtkLabel(label=col, xalign=0.0) {}
                }
            }
        }
        gtk.GtkSeparator() {}
        for var k, row = rows {
            gtk.GtkBox(orientation="horizontal", homogeneous=true) {
                if selectable {
                    gtk.GtkCheckButton(active=(k == selected), @toggled(b) {
                        if checkActive(b) && selected != k {
                            selected = k
                            select()
                        }
                    }) {}
                }
                for var cell = row.cells {
                    gtk.GtkLabel(label=cell, xalign=0.0) {}
                }
            }
        }
    }
}

// A tree's row: a node's label, and the spaces that indent it to its depth.
struct _TreeRow {
    label  string
    indent string
}

// A tree's rows in traversal order, each node's below it and indented one step
// further.
const func _treeRows(items list[ui.treeItem], indent string) list[_TreeRow] {
    var out list[_TreeRow] = []
    for var it = items {
        out = [...out, _TreeRow{label=it.label, indent=indent}, ..._treeRows(it.children, indent + "    ")]
    }
    return out
}

// Every node is shown, expanded or not: a row cannot be hidden and shown by
// its parent's state without a var, which a const component has none of.
const component ui.tree[platform](style, selected, @select, items) {
    gtk.GtkBox(orientation="vertical", spacing=spacingOf(style, 0), look=lookOf(style)) {
        for var row = _treeRows(items, "") {
            gtk.GtkCheckButton(label=row.indent + row.label, active=(row.label == selected), @toggled(b) {
                if checkActive(b) && selected != row.label {
                    selected = row.label
                    select()
                }
            }) {}
        }
    }
}

const component ui.radio[platform](value, disabled, direction, style, @change, options) {
    if direction == ui.Orientation.horizontal {
        gtk.GtkBox(orientation="horizontal", spacing=spacingOf(style, 6), sensitive=(disabled == false), look=lookOf(style)) {
            for var opt = options {
                gtk.GtkCheckButton(label=opt.label, active=(opt.label == value), @toggled(b) {
                    if checkActive(b) && value != opt.label {
                        value = opt.label
                        change(opt.label)
                    }
                }) {}
            }
        }
    } else {
        gtk.GtkBox(orientation="vertical", spacing=spacingOf(style, 6), sensitive=(disabled == false), look=lookOf(style)) {
            for var opt = options {
                gtk.GtkCheckButton(label=opt.label, active=(opt.label == value), @toggled(b) {
                    if checkActive(b) && value != opt.label {
                        value = opt.label
                        change(opt.label)
                    }
                }) {}
            }
        }
    }
}

// Offers a drop-down the labels `labels` joins with newlines, and selects
// `chosen` where one of them is it and nothing where none is. A drop-down
// takes its choices as a GListModel, which no SNGL expression produces, so
// gtk4rt builds one, copying both strings into C itself in either mode.
// Neither is a choice anyone made, so the drop-down reports neither.
#[go.native(_rtPkg, "gtk4rt.DropDownOffer")]
func offerChoices(d gtk.GtkDropDown, labels string, chosen string)

// The label a drop-down has selected, or "" where it has none.
#[marks.intrinsic("gtk4.dropDownLabel")]
func dropDownLabel(d gtk.GtkDropDown) string

// One drop-down, offered the choices' labels whenever they change and
// selecting the bound value whenever it does. `placeholder`, `multiple` and
// the focus events have nothing to reach.
const component ui.select[platform](value, disabled, style, @change, options) {
    gtk.GtkDropDown #drop(sensitive=(disabled == false), look=lookOf(style), @notifySelected(d) {
        var v = dropDownLabel(d)
        if v != "" && v != value {
            value = v
            change(v)
        }
    }) {}
    // Keyed on the drop-down as well as its labels, so a render that builds
    // the drop-down afresh offers the new one its choices: an effect whose
    // key reads a node mounts again wherever the node is built.
    effect(on={labels=options.map(func(o) => o.label).join("\n"), drop=drop}, @mount(k) {
        offerChoices(drop, k.labels, value)
    })
    effect(on=value, @mount(v) {
        offerChoices(drop, options.map(func(o) => o.label).join("\n"), v)
    })
}

// A menu's top-level entries, as html shows them; a submenu has nowhere to
// open without a var.
const component ui.menubar[platform](style, items) {
    gtk.GtkBox(orientation="horizontal", spacing=spacingOf(style, 4), look=lookOf(style)) {
        for var it = items {
            gtk.GtkButton(label=it.label, sensitive=(it.disabled == false), @clicked { it.select() }) {}
        }
    }
}

const component ui.menu[platform](style, open, items) {
    if open {
        gtk.GtkBox(orientation="vertical", spacing=spacingOf(style, 0), look=lookOf(style)) {
            for var it = items {
                gtk.GtkButton(label=it.label, sensitive=(it.disabled == false), @clicked { it.select() }) {}
            }
        }
    }
}

const component ui.toolbar[platform](style, controls) {
    gtk.GtkBox(orientation="horizontal", spacing=spacingOf(style, 4), look=lookOf(style)) {
        controls
    }
}

// GtkPaned holds exactly two panes, so the panes share a box evenly instead
// and `position` and its bounds have nothing to reach.
const component ui.splitview[platform](style, direction, panes) {
    if direction == "vertical" {
        gtk.GtkBox(orientation="vertical", homogeneous=true, look=lookOf(style)) {
            panes
        }
    } else {
        gtk.GtkBox(orientation="horizontal", homogeneous=true, look=lookOf(style)) {
            panes
        }
    }
}

const component ui.drawer[platform](style, open, content) {
    gtk.GtkBox(orientation="vertical", spacing=spacingOf(style, 6), visible=open && shown(style), look=lookBesideVisible(style)) {
        content
    }
}

// Shown in place rather than in a window of its own, as html shows it in the
// page.
const component ui.modal[platform](style, open, title, closable, @close, content) {
    gtk.GtkFrame(visible=open && shown(style), look=lookBesideVisible(style)) {
        gtk.GtkBox(orientation="vertical", spacing=6) {
            if title != "" || closable {
                gtk.GtkBox(orientation="horizontal", spacing=6) {
                    gtk.GtkLabel(label=title, xalign=0.0, hexpand=true) {}
                    if closable {
                        gtk.GtkButton(label="Close", @clicked { close() }) {}
                    }
                }
            }
            content
        }
    }
}

// --- The timer ---
//
// GLib already schedules, so this platform needs no timer primitive: the
// g_timeout_add/g_source_remove pair behind these two is a lifetime with a
// thing to release, which is what `effect` brackets. A GLib timeout source runs
// its callback on the thread holding the main loop, which is the thread every
// GTK call must come from, so a tick body mutates the model in the same place a
// signal handler does and needs no marshalling of its own.

// The runtime package the schedule lives in, named once.
const _rtPkg = "duckfam.us/sngl/pkg/go/gtk4rt"

// The armed source itself, held as an opaque type rather than as an id paired
// with its callback slot in a table the runtime keeps. `*gtk4rt.Schedule` is a
// name this declaration can spell -- the same thing `#[cnative]` does for
// `*C.cairo_t` below.
#[go.native(_rtPkg, "*gtk4rt.Schedule")]
struct Schedule {}

#[go.native(_rtPkg, "gtk4rt.Every", schedules)]
func every(ms int, f func()) Schedule

#[go.native(_rtPkg, "gtk4rt.Schedule.Cancel", method)]
func Schedule.cancel()

// `enabled` is the effect's *position*, not part of its key: an effect lives as
// long as the branch it is written in, so `if enabled` is what makes toggling
// the gate a mount and an unmount. `on=interval` is the key, because a running
// schedule is the same schedule for as long as its period is unchanged.
const component time.timer[platform](interval, enabled, @tick) {
    var handle Schedule

    if enabled {
        effect(
            on = interval,
            @mount(d) { handle = every(int(d), tick) },
            @unmount(d) {
                handle.cancel()
            },
        )
    }
}

// How a handler reaches a widget: gtk4rt registers it and connects the signal,
// copying the name into C itself, so neither mode's generated file calls C to
// connect one and a wrapped build stays one that cgo does not rebuild. The
// node is put where its scope holds it, as a Handle (gtk4Translator's
// OnConnectThrough).
#[go.native(_rtPkg, "gtk4rt.Connect")]
func _rtConnect(w ui.node, signal string, handler func())

#[gen.protocol(connect)]
func _connect(w ui.node, signal string, handler func()) {
    _rtConnect(w, signal, handler)
}

// --- Drawing ---
//
// A canvas here is a GtkDrawingArea and its draw callback is handed a
// `cairo_t*`, so cairo's own functions are the drawing vocabulary. Declared
// with `#[cnative(…)]`, which names a C identifier and no language: each is a
// free function taking the context first, which is the shape a native gets by
// default. Each argument crosses through the `c` conversion its declared
// parameter type names (`c.cdouble`, `c.cstring`), which is why this package
// imports one. Nothing here is Go's.
//
// Named as the cgo pointer it is, so a helper that takes the context has the
// right type in its own signature -- the draw function's own parameter type
// comes from this platform, but `paint(ctx, style)` is an ordinary func and
// carries whatever this declaration says.
#[cnative("*C.cairo_t")]
struct CairoContext {}

#[cnative("cairo_save")]
func CairoContext.save()

#[cnative("cairo_restore")]
func CairoContext.restore()

#[cnative("cairo_set_source_rgba")]
func CairoContext.setSourceRgba(r float, g float, b float, a float)

#[cnative("cairo_set_line_width")]
func CairoContext.setLineWidth(w float)

// cairo's cap and join are typedef'd enums, not plain ints, so the
// declarations name those types and a conversion is written where the value is
// produced. An `int` parameter would emit `C.int(...)` and not compile --
// which the emitted-cgo build test says, loudly.
#[cnative("C.cairo_line_cap_t")]
struct LineCapValue {}

#[cnative("C.cairo_line_join_t")]
struct LineJoinValue {}

#[cnative("C.cairo_line_cap_t")]
const func toLineCap(v int) LineCapValue

#[cnative("C.cairo_line_join_t")]
const func toLineJoin(v int) LineJoinValue

#[cnative("cairo_set_line_cap")]
func CairoContext.setLineCap(cap LineCapValue)

#[cnative("cairo_set_line_join")]
func CairoContext.setLineJoin(join LineJoinValue)

#[cnative("cairo_rectangle")]
func CairoContext.rectangle(x float, y float, w float, h float)

#[cnative("cairo_new_sub_path")]
func CairoContext.newSubPath()

// The angle form, so a partial sweep is writable -- a gauge or a pie wedge,
// which no stdlib shape expresses yet.
#[cnative("cairo_arc")]
func CairoContext.arc(cx float, cy float, r float, start float, end float)

#[cnative("cairo_move_to")]
func CairoContext.moveTo(x float, y float)

#[cnative("cairo_line_to")]
func CairoContext.lineTo(x float, y float)

#[cnative("cairo_curve_to")]
func CairoContext.curveTo(x1 float, y1 float, x2 float, y2 float, x3 float, y3 float)

#[cnative("cairo_arc_negative")]
func CairoContext.arcNegative(cx float, cy float, r float, start float, end float)

#[cnative("cairo_close_path")]
func CairoContext.closePath()

#[cnative("cairo_fill")]
func CairoContext.fill()

#[cnative("cairo_fill_preserve")]
func CairoContext.fillPreserve()

#[cnative("cairo_stroke")]
func CairoContext.stroke()

#[cnative("cairo_set_font_size")]
func CairoContext.setFontSize(size float)

// The slant and the weight are typedef'd enums like the line cap and join, so
// they are cast the same way rather than passed as `C.int` -- cgo refuses an
// int where a `cairo_font_slant_t` belongs.
//
// `Style` exposes neither, so both are always the normal value. Declared
// anyway, because the alternative is a native that lies about its signature.
#[cnative("C.cairo_font_slant_t")]
struct FontSlant {}

#[cnative("C.cairo_font_weight_t")]
struct FontWeight {}

#[cnative("C.cairo_font_slant_t")]
const func toFontSlant(v int) FontSlant

#[cnative("C.cairo_font_weight_t")]
const func toFontWeight(v int) FontWeight

#[cnative("cairo_select_font_face")]
func CairoContext.selectFontFace(family string, slant FontSlant, weight FontWeight)

#[cnative("cairo_show_text")]
func CairoContext.showText(text string)

// What a `@draw` handler is handed: the context, and the coordinate space the
// shapes were placed in.
struct DrawEvent {
    ctx    CairoContext
    width  int
    height int
}

#[marks.intrinsic("gtk4:draw:cairo")]
component draw(@draw(e DrawEvent)) shapes.shape

// cairo takes its line cap and join as enum values. The names are SNGL's, the
// numbers are `CAIRO_LINE_CAP_*` and `CAIRO_LINE_JOIN_*`, and mapping them
// here is what makes `lineCap` and `lineJoin` reach this target at all --
// before the overrides, gtk4 read neither (#223).
const func lineCap(cap shapes.LineCap) LineCapValue {
    if cap == shapes.LineCap.round {
        return toLineCap(1)
    }
    if cap == shapes.LineCap.square {
        return toLineCap(2)
    }
    return toLineCap(0)
}

const func lineJoin(join shapes.LineJoin) LineJoinValue {
    if join == shapes.LineJoin.round {
        return toLineJoin(1)
    }
    if join == shapes.LineJoin.bevel {
        return toLineJoin(2)
    }
    return toLineJoin(0)
}

// cairo wants each channel as 0..1 where SNGL carries 0..255.
func source(ctx CairoContext, c color) {
    ctx.setSourceRgba(float(c.r) / 255.0, float(c.g) / 255.0, float(c.b) / 255.0, float(c.a) / 255.0)
}

// Fill then stroke the current path, preserving it between the two when both
// apply. This is `_snglCairoPaint` written in SNGL rather than spliced in as
// Go text.
func paint(ctx CairoContext, style shapes.Style) {
    if style.fill.a > 0 {
        source(ctx, style.fill)
        if style.stroke.a > 0 {
            ctx.fillPreserve()
        } else {
            ctx.fill()
        }
    }
    if style.stroke.a > 0 {
        ctx.setLineWidth(style.strokeWidth)
        ctx.setLineCap(lineCap(style.lineCap))
        ctx.setLineJoin(lineJoin(style.lineJoin))
        source(ctx, style.stroke)
        ctx.stroke()
    }
}

const component shapes.rect[platform](x, y, w, h, style) {
    draw(@draw(e) {
        e.ctx.save()
        e.ctx.rectangle(x, y, w, h)
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

const component shapes.circle[platform](cx, cy, r, style) {
    draw(@draw(e) {
        e.ctx.save()
        e.ctx.newSubPath()
        e.ctx.arc(cx, cy, r, 0.0, math.tau)
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

// An ellipse as four cubic segments rather than a scaled circle: `cairo_scale`
// would scale the *stroke* with the axes, so a 2px outline on a wide ellipse
// comes out thicker horizontally than vertically. kappa is the control-point
// offset that makes a cubic match a quarter arc to within a thousandth.
const component shapes.ellipse[platform](cx, cy, rx, ry, style) {
    draw(@draw(e) {
        var k = 0.5522847498307936
        var ox = rx * k
        var oy = ry * k

        e.ctx.save()
        e.ctx.newSubPath()
        e.ctx.moveTo(cx, cy - ry)
        e.ctx.curveTo(cx + ox, cy - ry, cx + rx, cy - oy, cx + rx, cy)
        e.ctx.curveTo(cx + rx, cy + oy, cx + ox, cy + ry, cx, cy + ry)
        e.ctx.curveTo(cx - ox, cy + ry, cx - rx, cy + oy, cx - rx, cy)
        e.ctx.curveTo(cx - rx, cy - oy, cx - ox, cy - ry, cx, cy - ry)
        e.ctx.closePath()
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

// A line has no interior, so `fill` is not read: the declaration says a fill
// on a line is ignored, and here that is the absence of a call rather than a
// special case in the emitter.
const component shapes.line[platform](x1, y1, x2, y2, style) {
    draw(@draw(e) {
        e.ctx.save()
        e.ctx.moveTo(x1, y1)
        e.ctx.lineTo(x2, y2)
        e.ctx.setLineWidth(style.strokeWidth)
        e.ctx.setLineCap(lineCap(style.lineCap))
        e.ctx.setLineJoin(lineJoin(style.lineJoin))
        source(e.ctx, style.stroke)
        e.ctx.stroke()
        e.ctx.restore()
    })
}

// The corner is solved by `sngl:ui/draw`, which two targets need and neither
// host has: cairo takes a center and two angles where the command gives three
// points and a radius. What is left here is the cairo half -- the line in, the
// arc, and the point the path is left at.
func arcTo(ctx CairoContext, from shapes.Point, corner shapes.Point, to shapes.Point, r float) shapes.Point {
    var a = shapes.tangentArc(from, corner, to, r)
    if a.degenerate {
        ctx.lineTo(corner.x, corner.y)
        return corner
    }
    ctx.lineTo(a.tangent1.x, a.tangent1.y)
    if a.sweep < 0.0 {
        ctx.arcNegative(a.center.x, a.center.y, r, a.start, a.start + a.sweep)
    } else {
        ctx.arc(a.center.x, a.center.y, r, a.start, a.start + a.sweep)
    }
    return a.tangent2
}

const component shapes.path[platform](style, steps) {
    draw(@draw(e) {
        // Where the path is, which `arcTo` needs and cairo will not hand back
        // without an out-parameter. Every other command ends at its own point,
        // so tracking it here costs one assignment each.
        var at = shapes.Point{x=0.0, y=0.0}

        e.ctx.save()
        for var c = steps {
            if c.op == shapes.PathOp.moveTo {
                e.ctx.moveTo(c.x, c.y)
                at = shapes.Point{x=c.x, y=c.y}
            }
            if c.op == shapes.PathOp.lineTo {
                e.ctx.lineTo(c.x, c.y)
                at = shapes.Point{x=c.x, y=c.y}
            }
            if c.op == shapes.PathOp.bezierTo {
                e.ctx.curveTo(c.cx1, c.cy1, c.cx2, c.cy2, c.x, c.y)
                at = shapes.Point{x=c.x, y=c.y}
            }
            if c.op == shapes.PathOp.arcTo {
                at = arcTo(e.ctx, at, shapes.Point{x=c.cx1, y=c.cy1}, shapes.Point{x=c.x, y=c.y}, c.r)
            }
            if c.op == shapes.PathOp.close {
                e.ctx.closePath()
            }
        }
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

const component shapes.canvasText[platform](x, y, content, style) {
    draw(@draw(e) {
        e.ctx.save()
        // CAIRO_FONT_SLANT_NORMAL and CAIRO_FONT_WEIGHT_NORMAL. gtk4 read
        // fontFamily nowhere before this, so a program's font choice was
        // honored on three targets and dropped here (#223).
        e.ctx.selectFontFace(style.fontFamily, toFontSlant(0), toFontWeight(0))
        e.ctx.setFontSize(style.fontSize)
        source(e.ctx, style.fill)
        e.ctx.moveTo(x, y)
        e.ctx.showText(content)
        e.ctx.restore()
    })
}

// --- Images ---
//
// An image is gtk4rt's rather than a GIR class: a box holding the source it
// shows, fitted as `fit` says, or the placeholder where it holds none. A
// source is a GtkPicture showing the texture its bytes or its drawing make --
// a file the program carries, one fetched, or a picture a drawing paints --
// and reports to the image whether it arrived. Appended to a window, it is the
// window's icon. A width and a height in its style are its size, whatever its
// picture's.
#[marks.intrinsic("gtk4:Image")]
component Image(
    fit     string,
    look    gtk.Look,
    @click(),
    @load(),
    @failed(message string),
    content ...component option[ui.imageSource],
) ui.node

#[go.native(_rtPkg, "gtk4rt.ImageFrameNew")]
func _rtImageFrameNew() Image

#[go.native(_rtPkg, "gtk4rt.ImageFrameSetFit")]
func _rtImageFrameSetFit(w Image, fit string)

#[go.native(_rtPkg, "gtk4rt.ImageFrameOnClick")]
func _rtImageFrameOnClick(w Image, fn func())

#[go.native(_rtPkg, "gtk4rt.ImageFrameOnLoad")]
func _rtImageFrameOnLoad(w Image, fn func())

#[go.native(_rtPkg, "gtk4rt.ImageFrameOnError")]
func _rtImageFrameOnError(w Image, fn func(message string))

#[go.native(_rtPkg, "gtk4rt.BoxAppend")]
func _rtBoxAppend(box ui.node, child ui.node)

#[go.native(_rtPkg, "gtk4rt.BoxRemove")]
func _rtBoxRemove(box ui.node, child ui.node)

#[gen.protocol(create)]
func _create_Image() Image {
    return _rtImageFrameNew()
}

#[gen.protocol(append)]
func _append_Image(parent Image, child ui.node) {
    _rtBoxAppend(parent, child)
}

#[gen.protocol(remove)]
func _remove_Image(parent Image, child ui.node) {
    _rtBoxRemove(parent, child)
}

#[gen.protocol(set)]
func _set_Image_fit(w Image, fit string) {
    _rtImageFrameSetFit(w, fit)
}

// An image's events are gtk4rt's: a click on its box, and the source it
// holds reporting whether its picture arrived.
#[gen.protocol(on)]
func _on_Image_click(w Image, click func()) {
    _rtImageFrameOnClick(w, click)
}

#[gen.protocol(on)]
func _on_Image_load(w Image, load func()) {
    _rtImageFrameOnLoad(w, load)
}

#[gen.protocol(on)]
func _on_Image_failed(w Image, failed func(message string)) {
    _rtImageFrameOnError(w, failed)
}

// A scroll is gtk4rt's GtkScrolledWindow, which moves along `direction` and
// reports the end of its content coming within half a viewport of showing --
// as it arrives, and when the content changes size while it is there. GTK has
// no signal saying so; the changes of the adjustment along the axis the end
// is read on are what answer it.
#[marks.intrinsic("gtk4:Scroll")]
component Scroll(
    direction string,
    look      gtk.Look,
    @reachEnd(),
    content   ...component option[ui.node],
) ui.node

#[go.native(_rtPkg, "gtk4rt.ScrollNew")]
func _rtScrollNew() Scroll

#[go.native(_rtPkg, "gtk4rt.ScrolledWindowSetChild")]
func _rtScrolledWindowSetChild(sw Scroll, child ui.node)

#[go.native(_rtPkg, "gtk4rt.ScrollOnReachEnd")]
func _rtScrollOnReachEnd(sw Scroll, fn func())

#[go.native(_rtPkg, "gtk4rt.ScrollSetDirection")]
func _rtScrollSetDirection(sw Scroll, direction string)

#[gen.protocol(create)]
func _create_Scroll() Scroll {
    return _rtScrollNew()
}

#[gen.protocol(append)]
func _append_Scroll(parent Scroll, child ui.node) {
    _rtScrolledWindowSetChild(parent, child)
}

#[gen.protocol(set)]
func _set_Scroll_direction(w Scroll, direction string) {
    _rtScrollSetDirection(w, direction)
}

// The end arriving is no GTK signal: gtk4rt watches the vertical adjustment
// and calls the handler itself.
#[gen.protocol(on)]
func _on_Scroll(sw Scroll, reachEnd func()) {
    _rtScrollOnReachEnd(sw, reachEnd)
}

// The picture a URL names, decoded once: a file the program carries at once,
// one fetched when it arrives. Owned by the source deriving it, so it is made
// once per URL and given back when the URL changes or the source unmounts.
// The runtime counts its holders, so a program keeping one in a second var
// holds a reference, not a second decode.
#[go.native(_rtPkg, "*gtk4rt.Picture")]
#[owned(unrefPicture, retain=refPicture)]
struct Picture {}

#[go.native(_rtPkg, "gtk4rt.LoadPicture")]
func loadPicture(url string) Picture

#[go.native(_rtPkg, "gtk4rt.RefPicture")]
func refPicture(p Picture) Picture

#[go.native(_rtPkg, "gtk4rt.UnrefPicture")]
func unrefPicture(p Picture)

#[marks.intrinsic("gtk4:ImageUrl")]
component ImageUrl(url string, picture Picture) ui.imageSource

#[marks.intrinsic("gtk4:ImageDrawing")]
component ImageDrawing(width float, height float, shapes ...component shapes.shape) ui.imageSource

// A source of either kind is a GtkPicture gtk4rt fits to the image holding
// it. The URL is what a source says it shows, which a test reads; what it
// shows is the picture, and a drawing's is painted from its shapes.
#[go.native(_rtPkg, "gtk4rt.ImageSourceNew")]
func _rtImageSourceNew() ImageUrl

#[go.native(_rtPkg, "gtk4rt.ImageSourceNew")]
func _rtImageDrawingNew() ImageDrawing

#[go.native(_rtPkg, "gtk4rt.ImageSourceSetPicture")]
func _rtImageSourceSetPicture(w ImageUrl, picture Picture)

#[gen.protocol(create)]
func _create_ImageUrl() ImageUrl {
    return _rtImageSourceNew()
}

#[gen.protocol(set)]
func _set_ImageUrl_picture(w ImageUrl, picture Picture) {
    _rtImageSourceSetPicture(w, picture)
}

#[gen.protocol(create)]
func _create_ImageDrawing() ImageDrawing {
    return _rtImageDrawingNew()
}

const component ui.file[platform](path) {
    func picture() => loadPicture(path)

    ImageUrl(url=path, picture=picture)
}

const component ui.remote[platform](url) {
    func picture() => loadPicture(url)

    ImageUrl(url=url, picture=picture)
}

const component shapes.image[platform](width, height, shapes) {
    ImageDrawing(width=width, height=height) {
        shapes
    }
}

#[cnative("cairo_translate")]
func CairoContext.translate(x float, y float)

#[cnative("cairo_scale")]
func CairoContext.scale(x float, y float)

#[cnative("cairo_clip")]
func CairoContext.clip()

// Paints a picture into a box, scaled once per box size rather than per
// frame; one still on its way paints nothing, and is there the next time the
// drawing paints after it arrives.
#[go.native(_rtPkg, "gtk4rt.CairoPaintPicture")]
func paintPicture(cr CairoContext, p Picture, x float, y float, w float, h float)

// What a `drawSource` paints a carried or fetched image with: the context, the
// URL its source names and the picture the source holds.
struct SourceEvent {
    ctx     CairoContext
    url     string
    picture Picture
}

// The primitive a `canvasImage` paints its source through. `@url` paints an
// image a URL names; a drawing is painted in place rather than as a picture,
// its shapes between `@enter`, which maps the drawing's own space onto the box
// and clips to it, and `@leave`. The size in their payload is the drawing's.
#[marks.intrinsic("gtk4:drawSource")]
component drawSource(
    @url(e SourceEvent),
    @enter(e DrawEvent),
    @leave(e DrawEvent),
    source ...component family.one[ui.imageSource],
) shapes.shape

const component shapes.canvasImage[platform](x, y, w, h, src) {
    drawSource(
        @url(e) {
            paintPicture(e.ctx, e.picture, x, y, w, h)
        },
        @enter(e) {
            e.ctx.save()
            e.ctx.translate(x, y)
            e.ctx.scale(w / float(e.width), h / float(e.height))
            e.ctx.rectangle(0.0, 0.0, float(e.width), float(e.height))
            e.ctx.clip()
        },
        @leave(e) {
            e.ctx.restore()
        },
    ) {
        src
    }
}

// --- Rich text ---
//
// The span family, and the one target where the *host* resolves the cascade.
// Pango markup nests: `<b><i>x</i></b>` is what `bold { italic { … } }` means,
// so the tree an author wrote is the tree GTK is handed and nothing is
// flattened. What this platform builds is the string.
//
// A flow is therefore one `GtkLabel` and a span is no widget at all -- it is a
// piece of that label's markup -- which is why neither primitive names a GIR
// class. `codegen/platform/gtk4/markup.go` collects the span tree ahead of the
// walk and writes the markup as a Go string expression, so a run whose words
// come from state is an ordinary concatenation and the updater that moved that
// state sets the label again, through the flow's `markup` set.

#[marks.intrinsic("gtk4:Flow")]
component Flow(
    look    gtk.Look,
    // The Pango markup the spans make, which the platform writes wherever
    // one of them changes; nothing passes it.
    markup  string = "",
    content ...component markup.span,
) ui.node

#[go.native(_rtPkg, "gtk4rt.FlowNew")]
func _rtFlowNew() Flow

#[go.native(_rtPkg, "gtk4rt.LabelSetMarkup")]
func _rtFlowSetMarkup(w Flow, markup string)

#[gen.protocol(create)]
func _create_Flow() Flow {
    return _rtFlowNew()
}

// gtk4rt copies the markup into C itself, so the label is set in either mode
// with no C string in the program.
#[gen.protocol(set)]
func _set_Flow_markup(w Flow, markup string) {
    _rtFlowSetMarkup(w, markup)
}

// One run of words. `spanStyle` is read off the literal -- which
// fields a `SpanStyle` set is a question about the literal, as it is on every
// other target -- and becomes the Pango tags wrapped around this run's content.
#[marks.intrinsic("gtk4:Span")]
component Span(
    text      string,
    href      string,
    spanStyle markup.SpanStyle,
    content   ...component markup.span,
) markup.span

const component markup.richText[platform](style, content) {
    Flow(look=lookOf(style)) {
        content
    }
}

const component markup.text[platform](value) {
    Span(text=value) {}
}

const component markup.run[platform](style, content) {
    Span(spanStyle=style) {
        content
    }
}

// Pango has `<a href>` and GtkLabel follows one when it is clicked, so this is
// the one target besides html where a link is a link.
const component markup.link[platform](href, content) {
    Span(href=href) {
        content
    }
}

// Pango takes a foreground and nothing a theme could answer, so the fallback
// is a palette rather than the host: the light one, since the theme GTK ships
// with is light.
const component markup.token[platform](kind, content) {
    Span(spanStyle={color=markup.colorOf(markup.palette, markup.lightPalette, kind)}) {
        content
    }
}

// Pango markup has no image, and a GtkLabel holds text. So the description is
// what an image is here, in the brackets that say a picture stood where they
// are.
const component markup.image[platform](alt) {
    Span(text="[{alt}]") {}
}
