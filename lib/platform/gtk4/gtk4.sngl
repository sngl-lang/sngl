import ui "sngl:ui"
import build "sngl:build"
import marks "sngl:internal/marks"
import macro "sngl:macro"
import gen "sngl:x/gen"
import c "sngl:x/c"
import go "sngl:language/go"
import time "sngl:time"
import draw "sngl:ui/draw"
import family "sngl:family"
import math "sngl:math"
import markup "sngl:ui/markup"
import seq "sngl:seq"

// The runtime every gtk4 program links: the toplevels and the application,
// the look and the layout of a box's children, in C, which each language
// compiles into the program.
c.link(include="sngl_gtk.h", pkgConfig=["gtk4"], ldflags=["-lm"], library="gtk-4", sources=["rt/sngl_gtk.c", "rt/sngl_gtk.h", "rt/look.c", "rt/scroll.c", "rt/keys.c", "rt/choose.c", "rt/menu.c", "rt/image.c", "rt/markup.c"])

// The `gtk4` node of a build directive: `output { c { gtk4() } }`.
//
// Every node is a GTK widget and every operation on one a protocol function,
// here or in widgets.sngl, so the platform asks for `placement`, and each
// language writes the program whole. GTK owns its widgets and diffs nothing,
// so the tree is flattened and each write is explicit.
#[gen.can(insertBefore, asyncPost, instanceState)]
#[gen.cannot(reactivity, declarative, inlineComponents, structSpread)]
#[gen.wants(placement, stdlibContextParam, canvas, reactiveCanvas)]
#[gen.name("gtk4")]
#[gen.native("gtk4")]
component platform(
    // Go package name for the generated files.
    const package       string,
    // Emit a standalone main() or a library-style module.
    const main          bool,
    // The process start, wrapped: what the handler does before calling `run`
    // happens before the event loop, and what it does after, once the loop
    // has exited. `run` presents the windows and runs the loop. A handler
    // that never calls it gets a process whose loop still runs -- timers,
    // effects, posted work -- with no window on screen, which `quit` ends.
    // The application has torn down when `run` returns, and a second call
    // ends the process. `args` is the command line after the program's name.
    @run(args list[string], run func()),
    // Which introspection data a program's `gir:Gtk-4.0` import is declared
    // from: "builtin" for the bundled subset, a path to a `Gtk-4.0.gir`, or
    // unset to probe the system locations and fall back to the bundled
    // subset. The platform's own widgets are the bundled subset's whatever
    // it says.
    const gir           string,
    // What its generated code introduces beside a program's names: the
    // runtime's prefix, the program's entry, and the runtime calls a Go
    // program makes as functions of its own (codegen/platform/gtk4's
    // shimFile).
    const reservedNames list[string] = [
        "sngl_gtk",
        "sngl_app",
        "sngl_build",
        "sngl_main",
        "main",
        "snglGtkMain",
        "snglGtkInit",
        "snglGtkHold",
        "snglGtkPresent",
        "snglGtkRun",
        "snglGtkStep",
        "snglGtkReset",
        "snglGtkCaptureFile",
        "snglGtkCarryFile",
        "snglPost",
    ],
) build.platform

// Every node is a widget, held as its pointer. A protocol function handing a
// node to GTK reaches the pointer through this.
#[c.native("GtkWidget *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Widget")]
struct Widget {}

#[c.native("GtkWidget *", cast)]
#[gen.protocol(handle)]
func _handle(n ui.node) Widget

// A node the program holds at its root, a window, is put on screen when the
// program attaches it and destroyed, with everything in it, when it detaches
// it.
#[c.native("sngl_app_attach")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglAppAttach")]
func _rtAttach(n ui.node)

#[c.native("sngl_app_detach")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglAppDetach")]
func _rtDetach(n ui.node)

#[gen.protocol(attach)]
func _attach(n ui.node) {
    _rtAttach(n)
}

#[gen.protocol(detach)]
func _detach(n ui.node) {
    _rtDetach(n)
}

// What a component renders several nodes, or a slot, at its top into: a box
// down the page. A window among them is no child of it but a toplevel the
// application shows, which the box keeps, so a root component's windows come
// and go with it (rt's sngl_box_append).
#[marks.intrinsic("gtk4:Contents")]
component Contents(content ...component ui.node) ui.node

#[c.native("sngl_contents_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglContentsNew")]
func _rtContents() Contents

#[c.native("sngl_box_remove")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglBoxRemove")]
func _rtBoxRemove(box ui.node, child ui.node)

#[gen.protocol(contents)]
func _contents() Contents {
    return _rtContents()
}

#[c.native("sngl_slot_anchor")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglSlotAnchor")]
func _rtSlotAnchor(box ui.node, anchor ui.node) ui.node

// A render slot's entries go before an anchor the runtime keeps in its
// container, so a slot emptied and filled again comes back in its place.
#[gen.protocol(anchor)]
func _anchor(parent ui.node, anchor ui.node) ui.node {
    return _rtSlotAnchor(parent, anchor)
}

#[gen.protocol(create)]
func _create_Contents() Contents {
    return _rtContents()
}

#[gen.protocol(append)]
func _append_Contents(parent Contents, child ui.node) {
    _sngl_box_append(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(child)))
}

#[gen.protocol(insertBefore)]
func _insert_Contents(parent Contents, child ui.node, before ui.node) {
    _sngl_box_insert_before(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(before)), _as_GtkWidget(_widget(child)))
}

#[gen.protocol(remove)]
func _remove_Contents(parent Contents, child ui.node) {
    _rtBoxRemove(parent, child)
}

// Every widget's handlers are GLib signals.
#[gen.protocol(connect)]
func _connect(w ui.node, signal string, handler func()) {
    signalConnect(w, signal, handler)
}

// What a widget's style asks of the runtime (look.c): its CSS, its least
// size, its share of a box's spare room, and how a box lays out what it
// holds.
struct Look {
    css       string
    width     float
    height    float
    grow      float
    cross     int
    textAlign int
    lines     int
    wrap      int
    hidden    bool
    cursor    string
    justify   int
    spaced    bool
    spacing   int
    grid      bool
    columns   int
}

#[c.native("sngl_set_look")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglSetLook")]
func _rtSetLook(
    w       ui.node,
    css     string,
    width   int,
    height  int,
    grow    float,
    cross   int,
    align   int,
    lines   int,
    wrap    int,
    hidden  int,
    cursor  string,
    justify int,
    spaced  int,
    spacing int,
    grid    int,
    columns int,
)

// Gives w its look, each widget's `look` set.
func _setLook(w ui.node, l Look) {
    _rtSetLook(w, l.css, int(l.width + 0.5), int(l.height + 0.5), l.grow, l.cross, l.textAlign, l.lines, l.wrap, l.hidden ? 1 : 0, l.cursor, l.justify, l.spaced ? 1 : 0, l.spacing, l.grid ? 1 : 0, l.columns)
}

// Gives w its look: the `look` set of each class a `gir:Gtk-4.0` import
// declares, which is no package of the platform's.
func setLook(w ui.node, l Look) {
    _setLook(w, l)
}

// Runs the application: the program built once GTK is ready, and the loop
// until the last window closes. A Go program's entry; C's calls
// sngl_app_run with its own build.
#[c.native("sngl_gtk_main")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglGtkMain")]
func _rtMain(
    #[c.type("SnglFn")] build func(),
    #[c.context] ctx c.pointer,
    #[c.type("GDestroyNotify")] #[c.release] rel c.pointer,
) int

// What an entry whose platform node wrote `@run` starts with, Go's through
// the wrappers these give it: the windows the build attaches held hidden
// until the handler's `run` presents them, and the loop run over the tree
// already built.
#[c.native("sngl_gtk_hold")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglGtkHold")]
func _rtHold()

#[c.native("sngl_gtk_present")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglGtkPresent")]
func _rtPresent()

#[c.native("sngl_gtk_run")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglGtkRun")]
func _rtRun() int

// GTK made ready without an application, and the loop run once: how a Go
// test agent starts, and lets the loop run while a test waits.
#[c.native("sngl_gtk_init")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglGtkInit")]
func _rtInit()

#[c.native("sngl_gtk_step")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglGtkStep")]
func _rtStep()

// Every window taken down, as a test agent starts each test after the
// first: the last test's build put them up.
#[c.native("sngl_gtk_reset")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglGtkReset")]
func _rtReset()

// The first window shown, drawn at width by height into the file at path as
// its size and pixels (rt's sngl_gtk_capture_file): a Go test's snapshot.
#[c.native("sngl_gtk_capture_file")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglGtkCaptureFile")]
func _rtCaptureFile(path string, width int, height int) int

// A file a Go program embeds, handed to the runtime before it runs, which
// its images read as C's read the table its entry hands it.
#[c.native("sngl_gtk_carry_file")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglGtkCarryFile")]
func _rtCarryFile(name string, data string, len int)

// Ends the loop, and with it the application, which tears down before the
// entry returns: how a program whose windows are all hidden, or one an
// `@run` handler started without calling run, stops.
#[c.native("sngl_gtk_quit")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglGtkQuit")]
func quit()

// --- The timer ---
//
// A GLib timeout, armed as the effect mounts and removed as it unmounts. Its
// callback runs on the loop's thread, as a signal's handler does, which
// `schedules` says: a blocking call in a tick is handed to a goroutine.
#[c.native("SnglSchedule *")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.Schedule")]
struct Schedule {}

#[c.native("sngl_every")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglEvery", schedules)]
func _rtEvery(
    ms int,
    #[c.type("SnglFn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("GDestroyNotify")] #[c.release] rel c.pointer,
) Schedule

#[c.native("sngl_schedule_cancel")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglScheduleCancel")]
func _rtCancel(s Schedule)

// `enabled` is where the effect is, not part of its key, so toggling it
// mounts and unmounts the schedule; a schedule is the same one for as long as
// its period is.
const component time.timer[platform](interval, enabled, @tick) {
    var handle Schedule

    if enabled {
        effect(
            on = interval,
            @mount(d) { handle = _rtEvery(int(d), tick) },
            @unmount(d) {
                _rtCancel(handle)
            },
        )
    }
}

// --- Windows ---

// A toplevel: the host object a `ui.window` is. It is the runtime's box its
// content is appended to, which keeps the title, visibility and handlers
// until the window is made around it. The window manager's close is
// reported as `visible = false` followed by `@closed`.
//
// `@key` is each key pressed in the window, which a controller on the window
// hears as the key goes down to the focused widget, before anything in it.
// The handler takes nothing, since C hands a callback no function to call:
// what it hears is the runtime's to tell while it runs (`_rtKeyHeard`,
// `_rtKeyHeld`), and `_rtKeyStop` stops it.
#[marks.intrinsic("gtk4:Toplevel")]
component Toplevel(title string, :visible bool = true, @closed(), @key(), content ...component ui.node) root

#[c.native("sngl_toplevel_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglToplevelNew")]
func _rtToplevelNew() Toplevel

#[c.native("sngl_toplevel_set_title")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglToplevelSetTitle")]
func _rtToplevelSetTitle(w Toplevel, title string)

#[c.native("sngl_toplevel_set_visible")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglToplevelSetVisible")]
func _rtToplevelSetVisible(w Toplevel, visible bool)

#[c.native("sngl_toplevel_on_closed")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglToplevelOnClosed")]
func _rtToplevelOnClosed(
    w Toplevel,
    #[c.type("SnglFn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("GDestroyNotify")] #[c.release] rel c.pointer,
)

#[c.native("sngl_toplevel_on_visible")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglToplevelOnVisible")]
func _rtToplevelOnVisible(
    w Toplevel,
    #[c.type("SnglBoolFn")] fn func(visible bool),
    #[c.context] ctx c.pointer,
    #[c.type("GDestroyNotify")] #[c.release] rel c.pointer,
)

#[c.native("sngl_toplevel_on_key")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglToplevelOnKey")]
func _rtToplevelOnKey(
    w Toplevel,
    #[c.type("SnglFn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("GDestroyNotify")] #[c.release] rel c.pointer,
)

// The key a window's `@key` handler is hearing: its name, and whether a
// modifier was held -- 0 Control, 1 Alt, 2 Shift, 3 Super or Meta -- or, at
// 4, whether the focused field's text was being edited. Read while the
// handler runs, and nothing after.
#[c.native("sngl_key_heard")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglKeyHeard")]
func _rtKeyHeard() string

#[c.native("sngl_key_held")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglKeyHeld")]
func _rtKeyHeld(which int) bool

// Stops the key the handler is hearing: the window takes it, so a focused
// entry types none of it, a focused button is not activated and Tab moves
// no focus.
#[c.native("sngl_key_stop")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglKeyStop")]
func _rtKeyStop()

// A test's key, pressed as the test describes it: the handler hears it, a
// stop it calls calls the test's, and a key it leaves goes on where it would
// have gone.
#[c.native("sngl_toplevel_key")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglToplevelKey")]
func _rtToplevelKey(
    w       Toplevel,
    key     string,
    ctrl    bool,
    alt     bool,
    shift   bool,
    meta    bool,
    editing bool,
    #[c.type("SnglFn")] stop func(),
    #[c.context] ctx c.pointer,
    #[c.type("GDestroyNotify")] #[c.release] rel c.pointer,
)

#[gen.fires("key")]
func _fire_Toplevel_key(w Toplevel, e ui.KeyPress, stop func()) {
    _rtToplevelKey(w, e.key, e.ctrl, e.alt, e.shift, e.meta, e.editing, stop)
}

// A toplevel's content is a box's, whose append hands the window an entry of
// its menu or its way back (rt's sngl_box_append).
#[c.native("sngl_toplevel_append")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglToplevelAppend")]
func _rtToplevelAppend(w Toplevel, child ui.node)

#[c.native("sngl_toplevel_insert_before")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglToplevelInsertBefore")]
func _rtToplevelInsert(w Toplevel, before ui.node, child ui.node)

#[c.native("sngl_box_remove")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglBoxRemove")]
func _rtToplevelRemove(w Toplevel, child ui.node)

#[gen.protocol(create)]
func _create_Toplevel() Toplevel {
    return _rtToplevelNew()
}

#[gen.protocol(append)]
func _append_Toplevel(parent Toplevel, child ui.node) {
    _rtToplevelAppend(parent, child)
}

#[gen.protocol(insertBefore)]
func _insert_Toplevel(parent Toplevel, child ui.node, before ui.node) {
    _rtToplevelInsert(parent, before, child)
}

#[gen.protocol(remove)]
func _remove_Toplevel(parent Toplevel, child ui.node) {
    _rtToplevelRemove(parent, child)
}

#[gen.protocol(set)]
func _set_Toplevel_title(w Toplevel, title string) {
    _rtToplevelSetTitle(w, title)
}

#[gen.protocol(set)]
func _set_Toplevel_visible(w Toplevel, visible bool) {
    _rtToplevelSetVisible(w, visible)
}

#[gen.protocol(on)]
func _on_Toplevel_closed(w Toplevel, closed func()) {
    _rtToplevelOnClosed(w, closed)
}

#[gen.protocol(on)]
func _on_Toplevel_visible(w Toplevel, visible func(visible bool)) {
    _rtToplevelOnVisible(w, visible)
}

#[gen.protocol(on)]
func _on_Toplevel_key(w Toplevel, key func()) {
    _rtToplevelOnKey(w, key)
}

// A window's way back, while it can go back: a widget kept hidden among the
// window's content, which has the window show a back button that presses
// it.
#[marks.intrinsic("gtk4:Back")]
component Back(@press()) ui.node

// One entry of a window's menu, and its submenu's entries: a box kept hidden
// among the window's content, from which the window builds the GMenu behind
// its header bar's menu button. Picking one is no GTK signal on it but the
// action made for it.
#[marks.intrinsic("gtk4:MenuEntry")]
component MenuEntry(
    label    string,
    disabled bool = false,
    checked  bool = false,
    @select(),
    entries  ...component ui.node,
) ui.node

#[c.native("gtk_label_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkLabelNew")]
func _backLabel(text option[string]) Back

#[c.native("gtk_box_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkBoxNew")]
func _menuEntryBox(orientation _c_GtkOrientation, spacing int) MenuEntry

// What a menu entry holds on its box.
struct _MenuEntryState {
    label    string
    disabled bool
    checked  bool
    select   option[func()]
}

// What a way back holds on its widget: what pressing it runs.
struct _BackState {
    press option[func()]
}

// A window's bar: the header bar holding the back button and the menu
// button, decided once as the window is made, since GTK sets a title bar only
// on a window not yet shown.
struct _BarState {
    decided    bool
    bar        option[_p_GtkWidget]
    backButton option[_p_GtkWidget]
    menuButton option[_p_GtkWidget]
}

const _menuEntryKey = "sngl-menu-entry"

const _backKey = "sngl-back"

const _barKey = "sngl-bar"

func _gobject(w _p_GtkWidget) _p_GObject {
    return _as_GObject(_widgetPtr(w))
}

func _entryOf(w _p_GtkWidget) option[_MenuEntryState] {
    return _heldMenuEntry(_gobject(w), _menuEntryKey)
}

func _backOf(w _p_GtkWidget) option[_BackState] {
    return _heldBack(_gobject(w), _backKey)
}

func _barOf(box _p_GtkWidget) _BarState {
    var b = _heldBar(_gobject(box), _barKey)
    if b != null {
        return b
    }
    return _BarState{}
}

func _setBar(box _p_GtkWidget, b _BarState) {
    _holdBar(_gobject(box), _barKey, b)
}

// Installs what the runtime's window and box ask of menus and ways back
// (rt's menu.c): each window, entry and way back made installs it anew.
func _installWindowHook() {
    _rtWindowHook(func(op int, box _p_GtkWidget, child _p_GtkWidget) bool {
        return _windowHook(op, box, child)
    })
}

func _windowHook(op int, box _p_GtkWidget, child _p_GtkWidget) bool {
    if op == 0 {
        return _windowBack(box)
    }
    if op == 1 {
        _menuApply(box)
    } else if op == 2 {
        _barForget(box)
    } else if op == 3 {
        _menuMoved(box, child)
    }
    return false
}

// The window whose menu w is in, through the entries holding it.
func _menuHost(w _p_GtkWidget) option[_p_GtkWidget] {
    var p = _gtk_widget_get_parent(w)
    for p != null {
        var at = p
        if at != null {
            if _rtToplevelWindow(at) != null {
                return at
            }
            if _entryOf(at) == null {
                return null
            }
            p = _gtk_widget_get_parent(at)
        }
    }
    return null
}

func _entryChanged(w _p_GtkWidget) {
    var host = _menuHost(w)
    if host != null {
        _menuApply(host)
    }
}

// The first way back among a window's content.
func _backIn(box _p_GtkWidget) option[_p_GtkWidget] {
    var c = _firstChild(box)
    for c != null {
        var at = c
        if at != null {
            if _backOf(at) != null {
                return at
            }
            c = _nextSibling(at)
        }
    }
    return null
}

// The entries among w's children.
func _entriesIn(w _p_GtkWidget) list[_p_GtkWidget] {
    var out list[_p_GtkWidget] = []
    var c = _firstChild(w)
    for c != null {
        var at = c
        if at != null {
            if _entryOf(at) != null {
                out.push(at)
            }
            c = _nextSibling(at)
        }
    }
    return out
}

func _backPress(w _p_GtkWidget) {
    var b = _backOf(w)
    if b != null {
        var press = b.press
        if press != null {
            press()
        }
    }
}

// Presses the first way back among the window's content, and is whether
// there was one.
func _windowBack(box _p_GtkWidget) bool {
    var b = _backIn(box)
    if b != null {
        _backPress(b)
        return true
    }
    return false
}

// A window destroyed takes its bar with it, and a back button in it: the
// next window decides its own. One over the content stays there.
func _barForget(box _p_GtkWidget) {
    var b = _heldBar(_gobject(box), _barKey)
    if b != null {
        var back = b.backButton
        if b.bar != null {
            back = null
        }
        _setBar(box, _BarState{backButton=back})
    }
}

// The back button goes in the bar, or over the content of a window made
// without one, and shows while a way back is among the content.
func _barApply(box _p_GtkWidget) {
    var win = _rtToplevelWindow(box)
    if win != null {
        var b = _barOf(box)
        var entries = _entriesIn(box).length() > 0
        var canBack = _backIn(box) != null
        var bar = b.bar
        var menuButton = b.menuButton
        var backButton = b.backButton
        if !b.decided && (entries || canBack) {
            var made = _gtk_header_bar_new()
            _gtk_window_set_titlebar(win, made)
            var button = _gtk_menu_button_new()
            _gtk_menu_button_set_icon_name(_as_GtkMenuButton(_widgetPtr(button)), "open-menu-symbolic")
            _gtk_header_bar_pack_end(_as_GtkHeaderBar(_widgetPtr(made)), button)
            bar = made
            menuButton = button
        }
        if backButton == null && canBack {
            var button = _gtk_button_new_from_icon_name("go-previous-symbolic")
            _g_signal_connect_plain(
                _as_gpointer(_widgetPtr(button)),
                "clicked",
                func(o _p_GObject) {
                    _windowBack(box)
                },
                0,
            )
            if bar != null {
                _gtk_header_bar_pack_start(_as_GtkHeaderBar(_widgetPtr(bar)), button)
            } else {
                _gtk_widget_set_halign(button, 1)
                _gtk_box_prepend(_as_GtkBox(_widgetPtr(box)), button)
            }
            backButton = button
        }
        if backButton != null {
            _setVisible(backButton, canBack)
        }
        if menuButton != null {
            _setVisible(menuButton, entries)
        }
        _setBar(box, _BarState{decided=true, bar=bar, backButton=backButton, menuButton=menuButton})
    }
}

func _menuEntrySelect(w _p_GtkWidget) {
    var e = _entryOf(w)
    if e != null && !e.disabled {
        var select = e.select
        if select != null {
            select()
        }
    }
}

// Adds w's entry to menu as the action named for its place, a check where
// checkable.
func _menuAdd(menu _p_GMenu, group _p_GSimpleActionGroup, n int, w _p_GtkWidget, checkable bool) {
    var e = _entryOf(w)
    if e != null {
        var name = "e{n}"
        var a = _g_simple_action_new(name, null)
        if checkable {
            a = _g_simple_action_new_stateful(name, null, _g_variant_new_boolean(e.checked))
        }
        _g_simple_action_set_enabled(a, !e.disabled)
        _g_signal_connect_two(
            _as_gpointer(_ptr_GSimpleAction(a)),
            "activate",
            func(o _p_GObject, arg _c_gpointer) {
                _menuEntrySelect(w)
            },
            0,
        )
        _g_action_map_add_action(_as_GActionMap(_ptr_GSimpleActionGroup(group)), _as_GAction(_ptr_GSimpleAction(a)))
        _g_object_unref(_as_gpointer(_ptr_GSimpleAction(a)))
        _g_menu_append(menu, e.label, "sngl.{name}")
    }
}

// A submenu per top-level entry holding entries, or the entry itself where
// it holds none. A submenu where one entry is checked draws them all as
// checks.
func _menuApply(box _p_GtkWidget) {
    _barApply(box)
    var win = _rtToplevelWindow(box)
    var b = _barOf(box)
    var button = b.menuButton
    if win != null && button != null {
        var menu = _g_menu_new()
        var group = _g_simple_action_group_new()
        var n = 0
        for var c = _entriesIn(box) {
            var e = _entryOf(c)
            var kids = _entriesIn(c)
            if e != null {
                if kids.length() == 0 {
                    _menuAdd(menu, group, n, c, e.checked)
                    n += 1
                } else {
                    var checkable = false
                    for var k = kids {
                        var ke = _entryOf(k)
                        if ke != null && ke.checked {
                            checkable = true
                        }
                    }
                    var sub = _g_menu_new()
                    for var k = kids {
                        _menuAdd(sub, group, n, k, checkable)
                        n += 1
                    }
                    _g_menu_append_submenu(menu, e.label, _as_GMenuModel(_ptr_GMenu(sub)))
                    _g_object_unref(_as_gpointer(_ptr_GMenu(sub)))
                }
            }
        }
        _gtk_widget_insert_action_group(_as_GtkWidget(_ptr_PGtkWindow(win)), "sngl", _as_GActionGroup(_ptr_GSimpleActionGroup(group)))
        _gtk_menu_button_set_menu_model(_as_GtkMenuButton(_widgetPtr(button)), _as_GMenuModel(_ptr_GMenu(menu)))
        _g_object_unref(_as_gpointer(_ptr_GSimpleActionGroup(group)))
        _g_object_unref(_as_gpointer(_ptr_GMenu(menu)))
    }
}

// An entry or a way back came to box or went from it.
func _menuMoved(box _p_GtkWidget, child _p_GtkWidget) {
    var toplevel = _rtToplevelWindow(box) != null
    if _backOf(child) != null {
        if toplevel {
            _barApply(box)
        }
    } else if _entryOf(child) != null {
        if toplevel {
            _menuApply(box)
        } else if _entryOf(box) != null {
            _entryChanged(box)
        }
    }
}

func _newBack() Back {
    _installWindowHook()
    var b = _backLabel(null)
    var w = _pageWidget(b)
    _setVisible(w, false)
    _holdBack(_gobject(w), _backKey, _BackState{})
    return b
}

func _handleBack(b Back, press func()) {
    _holdBack(_gobject(_pageWidget(b)), _backKey, _BackState{press=press})
}

#[gen.protocol(create)]
func _create_Back() Back {
    return _newBack()
}

#[gen.protocol(on)]
func _on_Back(b Back, press func()) {
    _handleBack(b, press)
}

#[gen.fires("press")]
func _fire_Back_press(b Back) {
    _backPress(_pageWidget(b))
}

func _newMenuEntry() MenuEntry {
    _installWindowHook()
    var e = _menuEntryBox(_to_GtkOrientation(1), 0)
    var w = _pageWidget(e)
    _setVisible(w, false)
    _holdMenuEntry(_gobject(w), _menuEntryKey, _MenuEntryState{})
    return e
}

// Writes what entry e holds, and has its window build its menu afresh where
// that changed it.
func _writeMenuEntry(e MenuEntry, label string, disabled bool, checked bool) {
    var w = _pageWidget(e)
    var s = _entryOf(w)
    if s != null && (s.label != label || s.disabled != disabled || s.checked != checked) {
        _holdMenuEntry(_gobject(w), _menuEntryKey, _MenuEntryState{label=label, disabled=disabled, checked=checked, select=s.select})
        _entryChanged(w)
    }
}

func _writeMenuEntryLabel(e MenuEntry, label string) {
    var s = _entryOf(_pageWidget(e))
    if s != null {
        _writeMenuEntry(e, label, s.disabled, s.checked)
    }
}

func _writeMenuEntryDisabled(e MenuEntry, disabled bool) {
    var s = _entryOf(_pageWidget(e))
    if s != null {
        _writeMenuEntry(e, s.label, disabled, s.checked)
    }
}

func _writeMenuEntryChecked(e MenuEntry, checked bool) {
    var s = _entryOf(_pageWidget(e))
    if s != null {
        _writeMenuEntry(e, s.label, s.disabled, checked)
    }
}

func _handleMenuEntry(e MenuEntry, select func()) {
    var w = _pageWidget(e)
    var s = _entryOf(w)
    if s != null {
        _holdMenuEntry(_gobject(w), _menuEntryKey, _MenuEntryState{label=s.label, disabled=s.disabled, checked=s.checked, select=select})
    }
}

#[gen.protocol(create)]
func _create_MenuEntry() MenuEntry {
    return _newMenuEntry()
}

#[gen.protocol(append)]
func _append_MenuEntry(parent MenuEntry, child ui.node) {
    _sngl_box_append(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(child)))
}

#[gen.protocol(insertBefore)]
func _insert_MenuEntry(parent MenuEntry, child ui.node, before ui.node) {
    _sngl_box_insert_before(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(before)), _as_GtkWidget(_widget(child)))
}

#[gen.protocol(remove)]
func _remove_MenuEntry(parent MenuEntry, child ui.node) {
    _rtBoxRemove(parent, child)
}

#[gen.protocol(set)]
func _set_MenuEntry_label(e MenuEntry, label string) {
    _writeMenuEntryLabel(e, label)
}

#[gen.protocol(set)]
func _set_MenuEntry_disabled(e MenuEntry, disabled bool) {
    _writeMenuEntryDisabled(e, disabled)
}

#[gen.protocol(set)]
func _set_MenuEntry_checked(e MenuEntry, checked bool) {
    _writeMenuEntryChecked(e, checked)
}

#[gen.protocol(on)]
func _on_MenuEntry(e MenuEntry, select func()) {
    _handleMenuEntry(e, select)
}

// Its `@key` is each key pressed in the window, heard before the focused
// widget, which the runtime names as a browser names the key -- its character,
// or "Enter", "Tab", "ArrowUp", "F1" and the rest -- and with Control, Alt,
// Super or Meta held a letter is its own, lowercase unless Shift is held
// (rt's keys.c). A stop is the window taking the key. A key pressed while the
// focused field's input method is composing is the input method's, and the
// window does not hear it. Escape goes back while the window can, after
// nothing took it: not the handler, not a focused widget.
//
// Its menu's entries are drawn two deep: a top-level entry and its submenu. A
// window whose call site gives it no `canGoBack` writes no Back, the `if`
// folding away, and nor does one with no menu write an entry.
//
// Its favicon is a source the window takes as its icon (rt's image.c).
//
// The window's `@error` is the outermost boundary of what it renders, and
// catches whether or not the call site handles one.
const component ui.window[platform](title, visible, canGoBack, @error, @closed, @back, @key, content, favicon, menu) {
    Toplevel(title=title, :visible=visible, @closed { closed() }, @key {
        key(ui.KeyPress{key=_rtKeyHeard(), ctrl=_rtKeyHeld(0), alt=_rtKeyHeld(1), shift=_rtKeyHeld(2), meta=_rtKeyHeld(3), editing=_rtKeyHeld(4)}, func() { _rtKeyStop() })
    }) {
        boundary(@error(e) { error(e) }) {
            content
        }
        #[family.crosses]
        favicon
        if canGoBack {
            Back(@press { back() })
        }
        for var it = menu {
            MenuEntry(label=it.label, disabled=it.disabled, checked=it.checked, @select { it.select() }) {
                for var sub = it.children {
                    MenuEntry(label=sub.label, disabled=sub.disabled, checked=sub.checked, @select { sub.select() })
                }
            }
        }
    }
}

// --- Leaf widgets ---

// What a control holds, read off its widget. A GTK signal hands its handler
// the widget it fired on and nothing else, so an override reporting a change
// asks that widget: `@toggled(b) { checked = checkActive(b) }`.
func checkActive(b ui.node) bool {
    return _gtk_check_button_get_active(_as_GtkCheckButton(_widget(b)))
}

func switchActive(s ui.node) bool {
    return _gtk_switch_get_active(_as_GtkSwitch(_widget(s)))
}

func entryText(e ui.node) string {
    return _gtk_editable_get_text(_as_GtkEditable(_widget(e)))
}

// Writes an entry's text with its "changed" blocked, which an override does
// itself rather than binding `text`: see ui.input.
func setEntryText(e ui.node, text string) {
    _quietly(_widget(e), "changed", _gtk_editable_get_type(), "", func() {
        _gtk_editable_set_text(_as_GtkEditable(_widget(e)), text)
    })
}

// The day a calendar has selected. A calendar always has one, so this is null
// only where GTK reports no date at all.
func calendarDate(c ui.node) option[time.date] {
    var t = _gtk_calendar_get_date(_as_GtkCalendar(_widget(c)))
    var day = "{_padded(_g_date_time_get_year(t), 4)}-{_padded(_g_date_time_get_month(t), 2)}-{_padded(_g_date_time_get_day_of_month(t), 2)}"
    _g_date_time_unref(t)
    return time.parseDate(day)
}

// n written in at least `width` digits, zeros first.
const func _padded(n int, width int) string {
    var s = "{n}"
    for s.length() < width {
        s = "0" + s
    }
    return s
}

// Selects y-m-d on a calendar as a click on the day does, without reporting
// it.
#[c.native("sngl_calendar_select")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglCalendarSelect")]
func selectDay(cal ui.node, y int, m int, d int)

// Offers a drop-down the labels `labels` joins with newlines, and selects
// `chosen` where one of them is it and nothing where none is. A drop-down
// takes its choices as a GListModel, which no SNGL expression produces, so
// the runtime builds one. Neither is a choice anyone made, so the drop-down
// reports neither.
func offerChoices(d ui.node, labels string, chosen string) {
    _quietly(_widget(d), "notify", _gtk_drop_down_get_type(), "selected", func() {
        _offer(_as_GtkDropDown(_widget(d)), labels.split("\n"), chosen)
    })
}

// A drop-down's model is replaced only for labels that differ, which would
// otherwise drop the popup a user has open.
func _offer(d _p_GtkDropDown, labels list[string], chosen string) {
    var cur = _gtk_drop_down_get_model(d)
    var same = _g_type_check_instance_is_a(_as_GTypeInstance(_ptr_GListModel(cur)), _gtk_string_list_get_type()) && _g_list_model_get_n_items(cur) == labels.length()
    if same {
        for var i, l = labels {
            if _gtk_string_list_get_string(_as_GtkStringList(_ptr_GListModel(cur)), i) != l {
                same = false
            }
        }
    }
    if !same {
        var fresh = _gtk_string_list_new(null)
        for var l = labels {
            _gtk_string_list_append(fresh, l)
        }
        _gtk_drop_down_set_model(d, _as_GListModel(_ptr_GtkStringList(fresh)))
        _g_object_unref(_as_gpointer(_ptr_GtkStringList(fresh)))
    }
    var at = _invalidListPosition
    for var i, l = labels {
        if l == chosen && at == _invalidListPosition {
            at = i
        }
    }
    _gtk_drop_down_set_selected(d, at)
}

// Selects the choice labeled `label`, as a pick does: unlike an offer, the
// drop-down notifies, so its @notifySelected handler runs. A label among none
// of its choices selects nothing. The selection's handler may render the page
// the drop-down is on afresh, which drops the drop-down while GTK is still
// setting it, so it is held until the selection is done.
func selectLabel(d ui.node, label string) {
    var dd = _as_GtkDropDown(_widget(d))
    var m = _gtk_drop_down_get_model(dd)
    if !_g_type_check_instance_is_a(_as_GTypeInstance(_ptr_GListModel(m)), _gtk_string_list_get_type()) {
        return
    }
    var l = _as_GtkStringList(_ptr_GListModel(m))
    for var i = seq.count(_g_list_model_get_n_items(m)) {
        if _gtk_string_list_get_string(l, i) == label {
            _g_object_ref(_as_gpointer(_widget(d)))
            _gtk_drop_down_set_selected(dd, i)
            _g_object_unref(_as_gpointer(_widget(d)))
            return
        }
    }
}

// The label a drop-down has selected, or "" where it has none.
func dropDownLabel(d ui.node) string {
    var dd = _as_GtkDropDown(_widget(d))
    var at = _gtk_drop_down_get_selected(dd)
    if at == _invalidListPosition {
        return ""
    }
    return _gtk_string_list_get_string(_as_GtkStringList(_ptr_GListModel(_gtk_drop_down_get_model(dd))), at)
}

// A test's fire of an event whose handler reads a value off the widget puts
// the value there first, as the user's flip, typing or click on a day does. A
// flip to the state the widget is in already reports it all the same.
#[gen.fires("toggled")]
func _fire_GtkCheckButton_toggled(b GtkCheckButton, checked bool) {
    _fireCheck(b, checked)
}

#[gen.fires("notifyActive")]
func _fire_GtkSwitch_notifyActive(s GtkSwitch, checked bool) {
    _fireSwitch(s, checked)
}

#[gen.fires("changed")]
func _fire_GtkEntry_changed(e GtkEntry, text string) {
    _fireText(e, text, "changed")
}

#[gen.fires("activate")]
func _fire_GtkEntry_activate(e GtkEntry, text string) {
    _fireText(e, text, "activate")
}

#[gen.fires("daySelected")]
func _fire_GtkCalendar_daySelected(c GtkCalendar, day option[time.date]) {
    _fireDay(c, day)
}

func _fireCheck(b GtkCheckButton, checked bool) {
    var w = _as_GtkCheckButton(_ptr_GtkCheckButton(b))
    if _gtk_check_button_get_active(w) != checked {
        _gtk_check_button_set_active(w, _to_gboolean(checked ? 1 : 0))
    } else {
        _rtSignalEmit(b, "toggled")
    }
}

func _fireSwitch(s GtkSwitch, checked bool) {
    var w = _as_GtkSwitch(_ptr_GtkSwitch(s))
    if _gtk_switch_get_active(w) != checked {
        _gtk_switch_set_active(w, _to_gboolean(checked ? 1 : 0))
    } else {
        _g_object_notify(_as_GObject(_ptr_GtkSwitch(s)), "active")
    }
}

func _fireText(e GtkEntry, text string, signal string) {
    setEntryText(e, text)
    _rtSignalEmit(e, signal)
}

func _fireDay(c GtkCalendar, day option[time.date]) {
    if day != null {
        selectDay(c, day.year(), day.month(), day.day())
    }
    _rtSignalEmit(c, "day-selected")
}

// Puts w in the state a pointer resting on it puts it in, which its look
// draws: what a test snapshots to see a button shaded as it is hovered. GTK
// takes the state back once a pointer moves, and a test has none.
func hover(w ui.node) {
    _gtk_widget_set_state_flags(_as_GtkWidget(_widget(w)), 2, false)
}

// Puts w in the state a press holding it down puts it in, as hover does.
func press(w ui.node) {
    _gtk_widget_set_state_flags(_as_GtkWidget(_widget(w)), 1, false)
}

// A text is the runtime's GtkLabel, starting at the left of its box as
// html's does, and pressed through a click gesture, which a label has no
// signal for.
#[marks.intrinsic("gtk4:Text")]
component Text(value string, look Look, @click()) ui.node

#[c.native("sngl_text_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglTextNew")]
func _rtTextNew() Text

#[c.native("sngl_text_set_value")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglTextSetValue")]
func _rtTextSetValue(w Text, value string)

#[gen.protocol(create)]
func _create_Text() Text {
    return _rtTextNew()
}

#[gen.protocol(set)]
func _set_Text_value(w Text, value string) {
    _rtTextSetValue(w, value)
}

#[gen.protocol(set)]
func _set_Text_look(w Text, look Look) {
    _setLook(w, look)
}

#[gen.protocol(on)]
func _on_Text_click(w Text, click func()) {
    _rtOnClick(w, click)
}

#[gen.fires("click")]
func _fire_Text_click(w Text) {
    _rtClick(w)
}

const component ui.text[platform](value, style, @click) {
    Text(value=value, look=lookOf(style), @click { click() }) {}
}

// A control written `focusable=false` is given `can-focus` false, which keeps
// focus off the widget and off what it holds -- an entry's focus is on the
// text widget inside it, and a drop-down's on its button -- by Tab and by a
// click alike, and a click still presses it.
const component ui.button[platform](text, focusable, style, @click) {
    GtkButton(label=text, canFocus=focusable, look=lookOf(style), @clicked { click() }) {}
}

const component ui.checkbox[platform](label, checked, focusable, style, @change) {
    GtkCheckButton(label=label, active=checked, canFocus=focusable, look=lookOf(style), @toggled(b) {
        if checkActive(b) != checked {
            checked = checkActive(b)
            change(checked)
        }
    }) {}
}

// The value is pushed by an effect rather than bound: setting an entry's text
// deletes and reinserts it, firing "changed" for each, so writing back the
// text "changed" just reported re-entered the handler until the stack
// overflowed. Only a value the entry does not already show is written.
const component ui.input[platform](value, focusable, style, @input, @change) {
    GtkEntry #entry(
        canFocus = focusable,
        look = lookOf(style),
        @changed(e) {
            if entryText(e) != value {
                value = entryText(e)
                input(value)
            }
        },
        @activate(e) {
            value = entryText(e)
            change(value)
        },
    ) {}
    effect(on=value, @mount(v) {
        if entryText(entry) != v {
            setEntryText(entry, v)
        }
    })
}

// gtk4 has no lightweight multi-line entry; map textarea to GtkEntry so
// the value binding + changed handler compile and round-trip. (Rich
// multi-line GtkTextView support is a future enhancement.)
const component ui.textarea[platform](value, focusable, style, @input, @change) {
    GtkEntry #entry(
        canFocus = focusable,
        look = lookOf(style),
        @changed(e) {
            if entryText(e) != value {
                value = entryText(e)
                input(value)
            }
        },
        @activate(e) {
            value = entryText(e)
            change(value)
        },
    ) {}
    effect(on=value, @mount(v) {
        if entryText(entry) != v {
            setEntryText(entry, v)
        }
    })
}

// --- Container widgets ---

const component ui.vbox[platform](style, children) {
    GtkBox(orientation="vertical", look=boxLookOf(style, 6)) {
        children
    }
}

const component ui.hbox[platform](style, children) {
    GtkBox(orientation="horizontal", look=boxLookOf(style, 6)) {
        children
    }
}

// A grid is a GtkBox the runtime lays out a row at a time, so its children come
// and go as a box's do. GtkFlowBox wraps each child in one of its own, which
// a render slot's anchor is no sibling of, and GtkGrid places each by a
// position a child append cannot give it.
const component ui.grid[platform](columns, style, children) {
    GtkBox(orientation="horizontal", look=gridLookOf(style, columns)) {
        children
    }
}

// A scroll is a GtkScrolledWindow, which moves along `direction` and reports
// the end of its content coming within half a viewport of showing -- as it
// arrives, and when the content changes size while it is there. GTK has no
// signal saying so: the changes of the adjustment along the axis the end is
// read on are what answer it, and the runtime's probe (rt's scroll.c), a box
// laid out around the content, says when the content's length changes.
#[marks.intrinsic("gtk4:Scroll")]
component Scroll(
    direction string,
    look      Look,
    @reachEnd(),
    content   ...component option[ui.node],
) ui.node

#[c.native("gtk_scrolled_window_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkScrolledWindowNew")]
func _scrollWindow() Scroll

#[c.native("sngl_scroll_probe")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglScrollProbe")]
func _rtScrollProbe(sw Scroll) _p_GtkWidget

#[c.native("sngl_scroll_set_child")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglScrollSetChild")]
func _rtScrollSetChild(sw Scroll, child ui.node)

#[c.native("sngl_probe_content")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglProbeContent")]
func _rtProbeContent(probe _p_GtkWidget) int

#[c.native("sngl_probe_reset")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglProbeReset")]
func _rtProbeReset(probe _p_GtkWidget, across bool)

#[c.native("sngl_probe_hold")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglProbeHold")]
func _rtProbeHold(sw Scroll, probe _p_GtkWidget, content _p_GtkWidget)

#[c.native("sngl_probe_on_change")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglProbeOnChange")]
func _rtProbeOnChange(
    probe _p_GtkWidget,
    #[c.type("SnglFn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("GDestroyNotify")] #[c.release] rel c.pointer,
)

// What a scroll holds on its window: the axis the end is read on (0 down, 1
// across, 2 both, which reads it down), whether the end showed when last
// measured and the content's length then (-1 before it was), the idle
// report posted and not run (0 for none), the handler, and the handlers
// watching the adjustments, beside the adjustment each watches, which the
// state holds a reference to: the window's destroy disconnects them, and by
// then its scrollbars no longer answer them.
struct _ScrollState {
    axis     int
    near     bool
    content  int
    asked    int
    reachEnd option[func()]
    watches  list[int]
    watched  list[_p_GtkAdjustment]
}

const _scrollKey = "sngl-scroll"

func _scrollOf(sw Scroll) option[_ScrollState] {
    return _heldScroll(_as_GObject(_widget(sw)), _scrollKey)
}

func _setScroll(sw Scroll, s _ScrollState) {
    _holdScroll(_as_GObject(_widget(sw)), _scrollKey, s)
}

func _windowOf(sw Scroll) _p_GtkScrolledWindow {
    return _as_GtkScrolledWindow(_widget(sw))
}

func _axisOf(direction string) int {
    if direction == "horizontal" {
        return 1
    }
    if direction == "both" {
        return 2
    }
    return 0
}

// The adjustment the end is read on.
func _readAdjustment(sw Scroll, axis int) _p_GtkAdjustment {
    if axis == 1 {
        return _gtk_scrolled_window_get_hadjustment(_windowOf(sw))
    }
    return _gtk_scrolled_window_get_vadjustment(_windowOf(sw))
}

// A scroll down lets the content take the window's width, and one across
// its height; the scrollable content -- a viewport, or the content itself --
// is asked for its natural length along the axis it moves on.
func _scrollPolicies(sw Scroll, axis int) {
    var w = _windowOf(sw)
    _gtk_scrolled_window_set_policy(w, axis == 0 ? _policyExternal : _policyAutomatic, axis == 1 ? _policyNever : _policyAutomatic)
    _gtk_scrolled_window_set_propagate_natural_width(w, axis == 0)
    var c = _gtk_scrolled_window_get_child(w)
    if c != null && !_isA(c, _gtk_scrollable_get_type()) {
        c = _gtk_widget_get_parent(c)
    }
    if c != null && _isA(c, _gtk_scrollable_get_type()) {
        var scrollable = _as_GtkScrollable(_widgetPtr(c))
        _gtk_scrollable_set_vscroll_policy(scrollable, axis != 1 ? 1 : 0)
        _gtk_scrollable_set_hscroll_policy(scrollable, axis != 0 ? 1 : 0)
    }
}

// The child the window was given, where it is not the probe, is the
// content, and goes in the probe, which becomes the child.
func _scrollChild(sw Scroll) {
    var s = _scrollOf(sw)
    var axis = 0
    if s != null {
        axis = s.axis
    }
    _scrollPolicies(sw, axis)
    var probe = _rtScrollProbe(sw)
    var shown = _gtk_scrolled_window_get_child(_windowOf(sw))
    if shown != null && shown != probe {
        var content option[_p_GtkWidget] = shown
        if _isA(shown, _gtk_viewport_get_type()) {
            content = _gtk_viewport_get_child(_as_GtkViewport(_widgetPtr(shown)))
        }
        if content != null && content != probe {
            _rtProbeHold(sw, probe, content)
        }
    }
}

// Measures the end against the viewport. The handler runs on the next idle
// turn rather than here: the adjustment changes while GTK allocates, and a
// handler adding rows then would change the tree mid-allocation.
func _scrollChanged(sw Scroll) {
    var s = _scrollOf(sw)
    if s != null {
        var a = _readAdjustment(sw, s.axis)
        var page = _gtk_adjustment_get_page_size(a)
        if page > 0.0 {
            var near = _gtk_adjustment_get_upper(a) - (_gtk_adjustment_get_value(a) + page) <= page / 2.0
            var content = _rtProbeContent(_rtScrollProbe(sw))
            var fire = near && (!s.near || content > s.content)
            var asked = s.asked
            if fire && asked == 0 {
                asked = _g_idle_add_full(200, func() bool {
                    _scrollReport(sw)
                    return false
                })
            }
            _setScroll(sw, _ScrollState{axis=s.axis, near=near, content=content, asked=asked, reachEnd=s.reachEnd, watches=s.watches, watched=s.watched})
        }
    }
}

func _scrollReport(sw Scroll) {
    var s = _scrollOf(sw)
    if s != null {
        _setScroll(sw, _ScrollState{axis=s.axis, near=s.near, content=s.content, reachEnd=s.reachEnd, watches=s.watches, watched=s.watched})
        var reachEnd = s.reachEnd
        if reachEnd != null {
            reachEnd()
        }
    }
}

// The window going: its report not yet run is dropped, and the handlers on
// its adjustments, which a viewport may hold past it, are disconnected.
func _scrollGone(sw Scroll) {
    var s = _scrollOf(sw)
    if s != null {
        if s.asked != 0 {
            _g_source_remove(s.asked)
        }
        for var k, id = s.watches {
            var a = _as_gpointer(_ptr_GtkAdjustment(s.watched[k]))
            _g_signal_handler_disconnect(a, id)
            _g_object_unref(a)
        }
        _setScroll(sw, _ScrollState{axis=s.axis})
    }
    _rtProbeOnChange(_rtScrollProbe(sw), func() {})
}

func _watchAdjustment(sw Scroll, a _p_GtkAdjustment, signal string) int {
    return _g_signal_connect_plain(
        _as_gpointer(_ptr_GtkAdjustment(a)),
        signal,
        func(o _p_GObject) {
            _scrollChanged(sw)
        },
        0,
    )
}

func _newScroll() Scroll {
    var sw = _scrollWindow()
    var w = _windowOf(sw)
    var down = _gtk_scrolled_window_get_vadjustment(w)
    var across = _gtk_scrolled_window_get_hadjustment(w)
    var watched = [down, down, across, across]
    var watches = [
        _watchAdjustment(sw, down, "changed"),
        _watchAdjustment(sw, down, "value-changed"),
        _watchAdjustment(sw, across, "changed"),
        _watchAdjustment(sw, across, "value-changed"),
    ]
    for var a = watched {
        _g_object_ref(_as_gpointer(_ptr_GtkAdjustment(a)))
    }
    _setScroll(sw, _ScrollState{content=-1, watches=watches, watched=watched})
    _rtProbeOnChange(_rtScrollProbe(sw), func() {
        _scrollChanged(sw)
    })
    _g_signal_connect_notify(
        _as_gpointer(_widget(sw)),
        "notify::child",
        func(o _p_GObject, spec _p_GParamSpec) {
            _scrollChild(sw)
        },
        0,
    )
    _g_signal_connect_plain(
        _as_gpointer(_widget(sw)),
        "destroy",
        func(o _p_GObject) {
            _scrollGone(sw)
        },
        0,
    )
    _scrollPolicies(sw, 0)
    return sw
}

func _setScrollDirection(sw Scroll, direction string) {
    var axis = _axisOf(direction)
    var s = _scrollOf(sw)
    if s != null {
        _setScroll(sw, _ScrollState{axis=axis, content=-1, asked=s.asked, reachEnd=s.reachEnd, watches=s.watches, watched=s.watched})
    }
    _scrollPolicies(sw, axis)
    _rtProbeReset(_rtScrollProbe(sw), axis == 1)
}

func _handleScroll(sw Scroll, reachEnd func()) {
    var s = _scrollOf(sw)
    if s != null {
        _setScroll(sw, _ScrollState{axis=s.axis, near=s.near, content=s.content, asked=s.asked, reachEnd=reachEnd, watches=s.watches, watched=s.watched})
    }
}

// Runs the handler, as the end showing would.
func _scrollReachEnd(sw Scroll) {
    var s = _scrollOf(sw)
    if s != null {
        var reachEnd = s.reachEnd
        if reachEnd != null {
            reachEnd()
        }
    }
}

#[gen.protocol(create)]
func _create_Scroll() Scroll {
    return _newScroll()
}

#[gen.protocol(append)]
func _append_Scroll(parent Scroll, child ui.node) {
    _rtScrollSetChild(parent, child)
}

#[gen.protocol(set)]
func _set_Scroll_direction(w Scroll, direction string) {
    _setScrollDirection(w, direction)
}

#[gen.protocol(set)]
func _set_Scroll_look(w Scroll, look Look) {
    _setLook(w, look)
}

#[gen.protocol(on)]
func _on_Scroll(sw Scroll, reachEnd func()) {
    _handleScroll(sw, reachEnd)
}

#[gen.fires("reachEnd")]
func _fire_Scroll_reachEnd(sw Scroll) {
    _scrollReachEnd(sw)
}

const component ui.scroll[platform](style, direction, @reachEnd, content) {
    Scroll(direction=string(direction), look=lookOf(style), @reachEnd { reachEnd() }) {
        content
    }
}

// A `ui.tabs`: a box holding a GtkNotebook. Each TabPage it holds is a page
// of the notebook, and `selected` the one shown.
#[marks.intrinsic("gtk4:Tabs")]
component Tabs(
    selected int,
    look     Look,
    pages    ...component ui.node,
) ui.node

// One tab: its panel, a page the notebook shows a tab titled `title` for.
// The user choosing it is no GTK signal on it but the notebook's page
// changing, which is reported as `@change`, and only the user's. Named for
// the tabs' event it raises, which is what a test's press of it calls.
#[marks.intrinsic("gtk4:TabPage")]
component TabPage(
    title    string,
    disabled bool = false,
    @change(),
    content  ...component ui.node,
) ui.node

#[c.native("gtk_box_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkBoxNew")]
func _tabsBox(orientation _c_GtkOrientation, spacing int) Tabs

#[c.native("gtk_box_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkBoxNew")]
func _tabPageBox(orientation _c_GtkOrientation, spacing int) TabPage

// What a TabPage holds on its box: the tab's title and whether it is
// disabled, which the notebook hosting it shows, the handler the user
// choosing it runs, and that notebook while it hosts it.
struct _TabPageState {
    title    string
    disabled bool
    shown    option[func()]
    host     option[_p_GtkNotebook]
}

// What Tabs holds on its box: the page the program chose, which the
// notebook shows.
struct _TabsState {
    selected int
}

const _tabPageKey = "sngl-tab-page"

const _tabsKey = "sngl-tabs"

func _tabPage(p _p_GtkWidget) option[_TabPageState] {
    return _heldTabPage(_as_GObject(_widgetPtr(p)), _tabPageKey)
}

func _setTabPage(p _p_GtkWidget, s _TabPageState) {
    _holdTabPage(_as_GObject(_widgetPtr(p)), _tabPageKey, s)
}

func _pageWidget(p ui.node) _p_GtkWidget {
    return _as_GtkWidget(_widget(p))
}

// The notebook a Tabs' box holds, its one child.
func _notebookOf(t Tabs) _p_GtkNotebook {
    return _as_GtkNotebook(_widgetPtr(_gtk_widget_get_first_child(_pageWidget(t))))
}

func _selectedOf(t Tabs) int {
    var s = _heldTabs(_as_GObject(_widget(t)), _tabsKey)
    if s != null {
        return s.selected
    }
    return 0
}

// Runs change with the notebook's own reports of the page it shows
// blocked: what the program changes is no choice of the user's.
func _notebookQuietly(nb _p_GtkNotebook, change func()) {
    _quietly(_ptr_GtkNotebook(nb), "notify", _gtk_notebook_get_type(), "page", change)
}

// Shows the program's page.
func _tabsShow(t Tabs) {
    var nb = _notebookOf(t)
    var k = _selectedOf(t)
    if k >= 0 && k < _gtk_notebook_get_n_pages(nb) {
        _notebookQuietly(nb, func() {
            _gtk_notebook_set_current_page(nb, k)
        })
    }
}

// A page's tab shows its title, and is insensitive where the page is
// disabled. GTK still lets the user click it, and _tabsShown puts the
// program's page back.
func _tabShows(nb _p_GtkNotebook, page _p_GtkWidget, s _TabPageState) {
    _gtk_notebook_set_tab_label_text(nb, page, s.title)
    _gtk_widget_set_sensitive(_gtk_notebook_get_tab_label(nb, page), _to_gboolean(s.disabled ? 0 : 1))
}

// The notebook hosting a page: the one its state names, while the page is
// still in it.
func _hostOf(page _p_GtkWidget, s _TabPageState) option[_p_GtkNotebook] {
    var host = s.host
    if host != null && _gtk_widget_is_ancestor(page, _as_GtkWidget(_ptr_GtkNotebook(host))) {
        return host
    }
    return null
}

// The notebook showing another page: the user's choice, unless it is a
// disabled page's, which the program's own page replaces. A notebook its
// box let go of is being torn down, and the pages it drops as it goes are
// no one's choice.
func _tabsShown(t Tabs) {
    var nb = _notebookOf(t)
    if !_gtk_widget_is_ancestor(_as_GtkWidget(_ptr_GtkNotebook(nb)), _pageWidget(t)) {
        return
    }
    var k = _gtk_notebook_get_current_page(nb)
    if k < 0 || k == _selectedOf(t) {
        return
    }
    var s = _tabPage(_gtk_notebook_get_nth_page(nb, k))
    if s != null && !s.disabled {
        _holdTabs(_as_GObject(_widget(t)), _tabsKey, _TabsState{selected=k})
        var shown = s.shown
        if shown != null {
            shown()
        }
    } else {
        _tabsShow(t)
    }
}

// The notebook reports the page it shows through its `page` property, after
// the change, where `switch-page` fires before it.
func _newTabs() Tabs {
    var t = _tabsBox(_to_GtkOrientation(1), 0)
    var nb = _gtk_notebook_new()
    _gtk_notebook_set_scrollable(_as_GtkNotebook(_widgetPtr(nb)), true)
    _gtk_box_append(_as_GtkBox(_widget(t)), nb)
    _holdTabs(_as_GObject(_widget(t)), _tabsKey, _TabsState{selected=0})
    _g_signal_connect_notify(
        _as_gpointer(_widgetPtr(nb)),
        "notify::page",
        func(o _p_GObject, spec _p_GParamSpec) {
            _tabsShown(t)
        },
        0,
    )
    return t
}

#[gen.protocol(create)]
func _create_Tabs() Tabs {
    return _newTabs()
}

// A page appended or inserted is a page of the notebook, at its end.
func _tabsAdd(t Tabs, page ui.node) {
    var nb = _notebookOf(t)
    var w = _pageWidget(page)
    var s = _tabPage(w)
    if s != null && _gtk_notebook_page_num(nb, w) < 0 {
        _notebookQuietly(nb, func() {
            _gtk_notebook_append_page(nb, w, null)
        })
        var hosted = _TabPageState{title=s.title, disabled=s.disabled, shown=s.shown, host=nb}
        _setTabPage(w, hosted)
        _tabShows(nb, w, hosted)
        _tabsShow(t)
    }
}

#[gen.protocol(append)]
func _append_Tabs(parent Tabs, page ui.node) {
    _tabsAdd(parent, page)
}

#[gen.protocol(insertBefore)]
func _insert_Tabs(parent Tabs, page ui.node, before ui.node) {
    _tabsAdd(parent, page)
}

func _dropTabs(parent Tabs, page ui.node) {
    var nb = _notebookOf(parent)
    var w = _pageWidget(page)
    var k = _gtk_notebook_page_num(nb, w)
    if k < 0 {
        return
    }
    _g_object_ref(_as_gpointer(_widgetPtr(w)))
    _notebookQuietly(nb, func() {
        _gtk_notebook_remove_page(nb, k)
    })
    var s = _tabPage(w)
    if s != null {
        _setTabPage(w, _TabPageState{title=s.title, disabled=s.disabled, shown=s.shown})
    }
    _g_object_unref(_as_gpointer(_widgetPtr(w)))
    _tabsShow(parent)
}

#[gen.protocol(remove)]
func _remove_Tabs(parent Tabs, page ui.node) {
    _dropTabs(parent, page)
}

func _writeTabs_selected(t Tabs, selected int) {
    _holdTabs(_as_GObject(_widget(t)), _tabsKey, _TabsState{selected=selected})
    _tabsShow(t)
}

#[gen.protocol(set)]
func _set_Tabs_selected(t Tabs, selected int) {
    _writeTabs_selected(t, selected)
}

#[gen.protocol(set)]
func _set_Tabs_look(t Tabs, look Look) {
    _setLook(t, look)
}

func _newTabPage() TabPage {
    var p = _tabPageBox(_to_GtkOrientation(1), 0)
    _setTabPage(_pageWidget(p), _TabPageState{})
    return p
}

#[gen.protocol(create)]
func _create_TabPage() TabPage {
    return _newTabPage()
}

#[gen.protocol(append)]
func _append_TabPage(parent TabPage, child ui.node) {
    _sngl_box_append(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(child)))
}

#[gen.protocol(insertBefore)]
func _insert_TabPage(parent TabPage, child ui.node, before ui.node) {
    _sngl_box_insert_before(_as_GtkWidget(_widget(parent)), _as_GtkWidget(_widget(before)), _as_GtkWidget(_widget(child)))
}

#[gen.protocol(remove)]
func _remove_TabPage(parent TabPage, child ui.node) {
    _rtBoxRemove(parent, child)
}

func _writeTabPage_title(p TabPage, title string) {
    var w = _pageWidget(p)
    var s = _tabPage(w)
    if s != null {
        var next = _TabPageState{title=title, disabled=s.disabled, shown=s.shown, host=s.host}
        _setTabPage(w, next)
        var host = _hostOf(w, next)
        if host != null {
            _tabShows(host, w, next)
        }
    }
}

#[gen.protocol(set)]
func _set_TabPage_title(p TabPage, title string) {
    _writeTabPage_title(p, title)
}

func _writeTabPage_disabled(p TabPage, disabled bool) {
    var w = _pageWidget(p)
    var s = _tabPage(w)
    if s != null {
        var next = _TabPageState{title=s.title, disabled=disabled, shown=s.shown, host=s.host}
        _setTabPage(w, next)
        var host = _hostOf(w, next)
        if host != null {
            _tabShows(host, w, next)
        }
    }
}

#[gen.protocol(set)]
func _set_TabPage_disabled(p TabPage, disabled bool) {
    _writeTabPage_disabled(p, disabled)
}

func _handleTabPage(p TabPage, change func()) {
    var w = _pageWidget(p)
    var s = _tabPage(w)
    if s != null {
        _setTabPage(w, _TabPageState{title=s.title, disabled=s.disabled, shown=change, host=s.host})
    }
}

#[gen.protocol(on)]
func _on_TabPage(p TabPage, change func()) {
    _handleTabPage(p, change)
}

#[gen.fires("change")]
func _fire_TabPage_change(p TabPage) {
    _tabPageShow(p)
}

// Runs the page's handler as the user choosing it would, unless it is
// disabled.
func _tabPageShow(p TabPage) {
    var s = _tabPage(_pageWidget(p))
    if s != null && !s.disabled {
        var shown = s.shown
        if shown != null {
            shown()
        }
    }
}

// A tab is a page of a GtkNotebook, which shows a tab for it. `variant` is
// the notebook's look, which GTK's theme draws.
const component ui.tabs[platform](selected, style, @change, items) {
    Tabs(selected=selected, look=lookOf(style)) {
        for var k, t = items {
            TabPage(title=t.label, disabled=t.disabled, @change {
                selected = k
                change(k)
            }) {
                t.content
            }
        }
    }
}

// --- Indicators ---

// GtkProgressBar's fraction is 0..1, so the value is measured against max here
// rather than passed through as if it already were one.
//
// GTK spells indeterminate as repeated gtk_progress_bar_pulse() calls rather
// than as a property, and an override has no clock to drive them, so a bar
// given no value is an empty one. Written as two calls rather than as one with
// a ternary because a ternary is lowered to a temporary on a language with no
// conditional expression, and that happens before the fold that would have
// settled it -- `C.double(__lt0)` where `__lt0 = (2 / 10)`, which is Go
// integer division.
const component ui.progress[platform](style, value, max, label, showValue) {
    if value != null {
        GtkProgressBar(fraction=value / max, text=label, showText=showValue, look=lookOf(style)) {}
    } else {
        GtkProgressBar(fraction=0.0, text=label, showText=showValue, look=lookOf(style)) {}
    }
}

const component ui.spinner[platform](label, style) {
    GtkSpinner(spinning=true, tooltipText=label, look=lookOf(style)) {}
}

// `direction` is not forwarded: orientation is a GtkOrientation, and the
// only SNGL value that reaches a GTK enum is a string literal naming one of
// its members, which the prop's set folds to the member's value where it is
// written — a prop reference has no compile-time member to name. A separator is therefore horizontal, which is what
// `direction` defaults to.
const component ui.divider[platform](style) {
    GtkSeparator(look=lookOf(style)) {}
}

const component ui.link[platform](text, href, disabled, focusable, style, @click) {
    GtkLinkButton(uri=href, label=text, sensitive=(disabled == false), canFocus=focusable, look=lookOf(style), @clicked { click() }) {}
}

// A flip reaches the program through `notify::active`: GtkSwitch's own
// `state-set` returns a gboolean, which the connect trampoline cannot carry.
const component ui.toggle[platform](checked, disabled, focusable, style, @change) {
    GtkSwitch(active=checked, sensitive=(disabled == false), canFocus=focusable, look=lookOf(style), @notifyActive(s) {
        if switchActive(s) != checked {
            checked = switchActive(s)
            change(checked)
        }
    }) {}
}

// One calendar, which a bound date selects whenever it changes. With no date
// it shows GTK's own, today: a calendar always has a day selected.
const component ui.datepicker[platform](value, disabled, style, @change) {
    GtkCalendar #cal(sensitive=(disabled == false), look=lookOf(style), @daySelected(c) {
        value = calendarDate(c)
        change(value)
    }) {}
    effect(on=value, @mount(v) {
        if v != null {
            selectDay(cal, v.year(), v.month(), v.day())
        }
    })
}

// --- Layout ---

const component ui.spacer[platform](style) {
    GtkBox(look=lookOf({flex=1, ...style})) {}
}

// The same shape html uses: a wrapper carrying the tooltip text, with the
// wrapped content inside it.
const component ui.tooltip[platform](style, text, trigger) {
    GtkBox(tooltipText=text, look=lookOf(style)) {
        trigger
    }
}

// A clickable card is its frame inside a frameless GtkButton, which gives it
// the hover, the press and the focus stop a button has.
const component ui.card[platform](style, clickable, @click, content) {
    if clickable {
        GtkButton(hasFrame=false, look=lookOf(style), @clicked { click() }) {
            GtkFrame(look=innerFrameLookOf(style)) {
                content
            }
        }
    } else {
        GtkFrame(look=lookOf(style)) {
            content
        }
    }
}

const component ui.stack[platform](style, layers) {
    GtkStack(look=lookOf(style)) {
        layers
    }
}

// `open` reaches the popover as widget visibility rather than as
// gtk_popover_popup: the emitter has one setter path per property and
// popup/popdown is a pair of calls chosen by the value. `position` is a
// GtkPositionType, so it is unreachable for the same reason as divider's
// orientation.
const component ui.popover[platform](style, open, @close, content) {
    GtkPopover(visible=open && shown(style), autohide=true, look=lookBesideVisible(style), @closed { close() }) {
        content
    }
}

// A check button's `active` marks a table's or a tree's selection. Clicking
// the selected one unchecks it on screen and changes nothing, since GTK has no
// way here to refuse the toggle.

// A row per box, each homogeneous so every cell takes an equal share and the
// columns line up. GtkColumnView is GTK's table, but it is fed through a list
// model and item factories, which nothing here can declare. A selectable table
// leads each row with a check button that selects it; a sortable header's
// cells are buttons reporting the column.
const component ui.table[platform](style, columns, selectable, selected, sortable, @select, @sort, rows) {
    GtkBox(orientation="vertical", look=boxLookOf(style, 0)) {
        GtkBox(orientation="horizontal", homogeneous=true) {
            if selectable {
                GtkLabel(label="") {}
            }
            for var col = columns {
                if sortable {
                    GtkButton(label=col, @clicked { sort(col) }) {}
                } else {
                    GtkLabel(label=col, xalign=0.0) {}
                }
            }
        }
        GtkSeparator() {}
        for var k, row = rows {
            GtkBox(orientation="horizontal", homogeneous=true) {
                if selectable {
                    GtkCheckButton(active=(k == selected), @toggled(b) {
                        if checkActive(b) && selected != k {
                            selected = k
                            select()
                        }
                    }) {}
                }
                for var cell = row.cells {
                    GtkLabel(label=cell, xalign=0.0) {}
                }
            }
        }
    }
}

// A tree's row: a node's label, and the spaces that indent it to its depth.
struct _TreeRow {
    label  string
    indent string
}

// A tree's rows in traversal order, each node's below it and indented one step
// further.
const func _treeRows(items list[ui.treeItem], indent string) list[_TreeRow] {
    var out list[_TreeRow] = []
    for var it = items {
        out = [...out, _TreeRow{label=it.label, indent=indent}, ..._treeRows(it.children, indent + "    ")]
    }
    return out
}

// Every node is shown, expanded or not: a row cannot be hidden and shown by
// its parent's state without a var, which a const component has none of.
const component ui.tree[platform](style, selected, @select, items) {
    GtkBox(orientation="vertical", look=boxLookOf(style, 0)) {
        for var row = _treeRows(items, "") {
            GtkCheckButton(label=row.indent + row.label, active=(row.label == selected), @toggled(b) {
                if checkActive(b) && selected != row.label {
                    selected = row.label
                    select()
                }
            }) {}
        }
    }
}

const component ui.radio[platform](value, disabled, direction, style, @change, options) {
    // A choice of the option holding `v`, a button's or a test's.
    func pickValue(v T) {
        if v != value {
            value = v
            change(v)
        }
    }
    if direction == ui.Orientation.horizontal {
        GtkBox(orientation="horizontal", sensitive=(disabled == false), look=boxLookOf(style, 6)) {
            for var opt = options {
                GtkCheckButton(label=opt.label, active=(opt.value == value), @toggled(b) {
                    if checkActive(b) {
                        pickValue(opt.value)
                    }
                }) {}
            }
        }
    } else {
        GtkBox(orientation="vertical", sensitive=(disabled == false), look=boxLookOf(style, 6)) {
            for var opt = options {
                GtkCheckButton(label=opt.label, active=(opt.value == value), @toggled(b) {
                    if checkActive(b) {
                        pickValue(opt.value)
                    }
                }) {}
            }
        }
    }
}

// A test picks the option holding `value` as pressing its button does.
func ui.radio[T].change[platform](value) {
    pickValue(value)
}

// One drop-down, offered the choices' labels whenever they change and
// selecting the label of the bound value whenever it does. `placeholder` and
// the focus events have nothing to reach.
const component ui.select[platform](value, disabled, focusable, style, @change, options) {
    GtkDropDown #drop(sensitive=(disabled == false), canFocus=focusable, look=lookOf(style), @notifySelected(d) {
        var at = ui.choiceLabeled(options, dropDownLabel(d))
        if at >= 0 && options[at].value != value {
            value = options[at].value
            change(options[at].value)
        }
    }) {}
    // Keyed on the drop-down as well as its labels, so a render that builds
    // the drop-down afresh offers the new one its choices: an effect whose
    // key reads a node mounts again wherever the node is built.
    effect(on={labels=options.map(func(o) => o.label).format("\n"), drop=drop}, @mount(k) {
        offerChoices(drop, k.labels, ui.choiceLabel(options, value))
    })
    effect(on=value, @mount(v) {
        offerChoices(drop, options.map(func(o) => o.label).format("\n"), ui.choiceLabel(options, v))
    })
}

// A test picks the choice holding `value` through the drop-down, which
// knows its choices by label.
func ui.select[T].change[platform](value) {
    selectLabel(drop, ui.choiceLabel(options, value))
}

// A menu's top-level entries, as html shows them; a submenu has nowhere to
// open without a var.
const component ui.menubar[platform](style, items) {
    GtkBox(orientation="horizontal", look=boxLookOf(style, 4)) {
        for var it = items {
            GtkButton(label=it.label, sensitive=(it.disabled == false), @clicked { it.select() }) {}
        }
    }
}

const component ui.menu[platform](style, open, items) {
    if open {
        GtkBox(orientation="vertical", look=boxLookOf(style, 0)) {
            for var it = items {
                GtkButton(label=it.label, sensitive=(it.disabled == false), @clicked { it.select() }) {}
            }
        }
    }
}

const component ui.toolbar[platform](style, controls) {
    GtkBox(orientation="horizontal", look=boxLookOf(style, 4)) {
        controls
    }
}

// GtkPaned holds exactly two panes, so the panes share a box evenly instead
// and `position` and its bounds have nothing to reach.
const component ui.splitview[platform](style, direction, panes) {
    if direction == "vertical" {
        GtkBox(orientation="vertical", homogeneous=true, look=lookOf(style)) {
            panes
        }
    } else {
        GtkBox(orientation="horizontal", homogeneous=true, look=lookOf(style)) {
            panes
        }
    }
}

const component ui.drawer[platform](style, open, content) {
    GtkBox(orientation="vertical", visible=open && shown(style), look=boxLookBesideVisible(style, 6)) {
        content
    }
}

// Shown in place rather than in a window of its own, as html shows it in the
// page.
const component ui.modal[platform](style, open, title, closable, @close, content) {
    GtkFrame(visible=open && shown(style), look=lookBesideVisible(style)) {
        GtkBox(orientation="vertical", spacing=6) {
            if title != "" || closable {
                GtkBox(orientation="horizontal", spacing=6) {
                    GtkLabel(label=title, xalign=0.0, hexpand=true) {}
                    if closable {
                        GtkButton(label="Close", @clicked { close() }) {}
                    }
                }
            }
            content
        }
    }
}

// --- Rich text ---

// A flow is one GtkLabel, and the spans in it its Pango markup, which nests
// as they do: `<b><i>x</i></b>` is what `bold { italic { … } }` means, so
// Pango resolves the cascade. A span is the runtime's, no widget, holding its
// words, its link and the tags its style opens and closes, which the runtime
// writes from what the style sets; any change to one sets its flow's markup
// again (rt's markup.c).
#[marks.intrinsic("gtk4:Flow")]
component Flow(
    look    Look,
    content ...component markup.span,
) ui.node

#[marks.intrinsic("gtk4:Span")]
component Span(
    words     string = "",
    href      string = "",
    spanStyle markup.SpanStyle,
    content   ...component markup.span,
) markup.span

#[c.native("sngl_flow_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglFlowNew")]
func _rtFlowNew() Flow

#[c.native("sngl_span_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.SnglSpanNew")]
func _rtSpanNew() Span

