#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookGetCurrentPage")]
func _notebookCurrent(nb _Notebook) int

#[c.native("gtk_notebook_set_current_page")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookSetCurrentPage")]
func _notebookSetCurrent(nb _Notebook, at int)

#[c.native("gtk_notebook_append_page")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookAppendPage")]
func _notebookAppend(nb _Notebook, page Widget, label option[Widget]) int

#[c.native("gtk_notebook_remove_page")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkNotebookRemovePage")]
func _notebookRemove(nb _Notebook, at int)

