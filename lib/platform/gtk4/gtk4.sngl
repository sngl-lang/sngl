func _isLabel(w Widget) => _is(w, _labelType())

// The text a widget shows aligned, cut to lines and wrapped as its look
// says, and given back what it had where the look says nothing: its own
// text, or a button's label, which every override sets before the look.
func _lookSetText(w Widget, align int, lines int, wrap int) {
    if _isLabel(w) || _is(w, _editableType()) {
        _lookText(w, w, align, lines, wrap)
    } else if _is(w, _buttonType()) || _is(w, _checkButtonType()) {
        var done = false
        for var c = _childrenOf(w, false) {
            if !done && _isLabel(c) {
                done = true
                _lookText(w, c, align, lines, wrap)
            }
        }
    }
}

func _lookText(w Widget, t Widget, align int, lines int, wrap int) {
    var l = _lookOf(w)
    if l.textSaved || align != 0 || lines != 0 || wrap != 0 {
        if !l.textSaved {
            l.textSaved = true
            if _isLabel(t) {
                var lb = _labelOf(t)
                l.xalign0 = _labelXalign(lb)
                l.justify0 = int(_labelJustify(lb))
                l.wrap0 = _labelWrap(lb)
                l.lines0 = _labelLines(lb)
                l.ellipsize0 = int(_labelEllipsize(lb))
            } else {
                l.xalign0 = _editableAlignment(_editableOf(t))
            }
            _setLookState(w, l)
        }
        var x = l.xalign0
        if align == 1 {
            x = 0.5
        } else if align == 2 {
            x = 1.0
        } else if align == 3 || align == 4 {
            x = 0.0
        }
        if _isLabel(t) {
            // GtkJustification's left, right, center and fill; Pango's end.
            var justify = l.justify0
            if align == 1 {
                justify = 2
            } else if align == 2 {
                justify = 1
            } else if align == 3 {
                justify = 3
            } else if align == 4 {
                justify = 0
            }
            var lb = _labelOf(t)
            _labelSetXalign(lb, _to_float(x))
            _labelSetJustify(lb, _Justification(justify))
            _labelSetLines(lb, lines > 0 ? lines : l.lines0)
            _labelSetEllipsize(lb, _Ellipsize(lines > 0 ? 3 : l.ellipsize0))
            _labelSetWrap(lb, lines > 0 || wrap == 2 ? true : wrap == 1 ? false : l.wrap0)
        } else {
            _editableSetAlignment(_editableOf(t), _to_float(x))
        }
    }
}

// A label sized by its look is that size, its words wrapping inside the
// width as html's do: a size request is only the least a widget is, and a
// long line widened it. It is laid out by a layout of its own, which
// GtkLabel's own class functions measure and allocate, given the width it
// is: the size it answers is the last its look gave (labelWidth,
// labelHeight).
#[c.native("GtkWidgetClass *")]
