#[c.native("GtkWidgetClass.size_allocate", field)]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkWidgetClassSizeAllocate")]
func _classAllocate(k _WidgetClass, w Widget, width int, height int, baseline int)

#[c.native("gtk_custom_layout_new")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.GtkCustomLayoutNew")]
func _labelLayout(
    #[c.type("GtkCustomRequestModeFunc")] #[c.static] mode func(w Widget) int,
    #[c.type("GtkCustomMeasureFunc")] #[c.static] #[c.outs] measure func(w Widget, orientation int, forSize int) Measured,
    #[c.type("GtkCustomAllocateFunc")] #[c.static] allocate func(w Widget, width int, height int, baseline int),
) LayoutManager

func _labelClass() => _widgetClass(_classPeek(_labelType()))

// Height for width, as GtkLabel's own is.
func _labelMode(w Widget) => 0

func _labelMeasure(w Widget, orientation int, forSize int) Measured {
    var l = _lookOf(w)
    var at = forSize
    if orientation == 1 && l.labelWidth > 0 {
        at = l.labelWidth
    }
    var minimum = 0
    var natural = 0
    var minimumBaseline = -1
    var naturalBaseline = -1
    _classMeasure(_labelClass(), w, Orientation(orientation), at, &minimum, &natural, &minimumBaseline, &naturalBaseline)
    var want = orientation == 0 ? l.labelWidth : l.labelHeight
    if want > 0 {
        minimum = want
        natural = want
    }
    return Measured{minimum=minimum, natural=natural, minimumBaseline=minimumBaseline, naturalBaseline=naturalBaseline}
}

func _labelAllocate(w Widget, width int, height int, baseline int) {
    _classAllocate(_labelClass(), w, width, height, baseline)
}

func _lookSizeLabel(w Widget, wrap int) {
    var l = _lookOf(w)
    if _isLabel(w) && (l.width != 0 || l.height != 0 || l.labelSized) {
        if !l.labelSized {
            l.labelSized = true
            _setLayoutManager(w, _labelLayout(_labelMode, _labelMeasure, _labelAllocate))
        }
        l.labelWidth = l.width
        l.labelHeight = l.height
        _setLookState(w, l)
        if l.width > 0 && wrap != 1 {
            _labelSetWrap(_labelOf(w), true)
        }
        _queueResize(w)
    }
}

// A contents is shown only while a child of it is: one holding nothing a
// reader sees is no item of the box it sits in, as CSS's display: contents
// adds none, and takes no gap there. A component whose body asks and shows
// nothing -- a query per row -- put a gap per row above what came after.
func _contentsShown(box Widget) {
    if _hasLook(box) && !_lookOf(box).hidden {
        var any = false
        for var c = _childrenOf(box, false) {
            any = any || _visible(c)
        }
        if _visible(box) != any {
            _setVisible(box, any)
        }
    }
}

func _contentsChildShown(c _Pointer, spec _Pointer, box _Pointer) {
    _contentsShown(_pointed(box))
}

#[c.native("g_signal_connect_object")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.ConnectChildShown")]
func _connectChildShown(instance _Pointer, signal string, #[c.type("GCallback")] #[c.static] handler func(c _Pointer, spec _Pointer, box _Pointer), gobject _Pointer, flags _ConnectFlags) _Handler

#[c.native("g_signal_connect_object")]
#[go.native("duckfam.us/sngl/lib/platform/gtk4/cgo", "cgo.ConnectContentsKids")]
func _connectContentsKids(instance _Pointer, signal string, #[c.type("GCallback")] #[c.static] handler func(m _Pointer, at int, removed int, added int, box _Pointer), gobject _Pointer, flags _ConnectFlags) _Handler

func _contentsKids(m _Pointer, at int, removed int, added int, box _Pointer) {
    var i = at
    for i < at + added {
        var c = _modelItem(_pointerModel(m), _Count(i))
        _connectChildShown(c, "notify::visible", _contentsChildShown, box, _ConnectFlags(0))
        _unref(c)
        i += 1
    }
    _contentsShown(_pointed(box))
}

func _rtContents() Contents {
    var box = _boxNew(Orientation(1), 6)
    _setLookState(box, _LookState{contents=true})
    var kids = _observeChildren(box)
    _connectContentsKids(_modelPointer(kids), "items-changed", _contentsKids, _pointer(box), _ConnectFlags(0))
    _holdData(_object(box), "sngl-contents-kids", _modelPointer(kids), _unrefData)
    _setVisible(box, false)
    return _asContents(box)
}

