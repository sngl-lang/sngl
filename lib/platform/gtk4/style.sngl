import ui "sngl:ui"
import gtk "gir:Gtk-4.0"

// What a Style may say that GTK does not answer:
//
//   - maxWidth, maxHeight: GTK gives a widget at least its minimum and as much
//     as its parent allocates, and nothing caps it.
//   - flexDirection: vbox and hbox are the axis.
//   - position, top, bottom, left, right, zIndex: a GtkBox lays its children
//     out itself, with no flow to take one out of and no offsets.
//   - borderCollapse: table borders.
//   - listStyleType: no widget here draws a list marker.
const unstyled list[string] = [
    "maxWidth",
    "maxHeight",
    "flexDirection",
    "position",
    "top",
    "bottom",
    "left",
    "right",
    "zIndex",
    "borderCollapse",
    "listStyleType",
]

// A length in pixels, as codegen.MeasurementPx reads one for this target: an
// em is 16 of them, as html, android and bubbletea read one.
const func px(m ui.measurement) => m.px + 16.0 * (m.em + m.rem)

// GTK takes no negative length, which CSS allows for a margin; an unset one
// is none.
const func inset(m option[ui.measurement]) => m == null ? 0.0 : float.max(px(m), 0.0)

// A length as CSS text, nothing where the Style leaves it unset.
const func length(m option[ui.measurement]) => m == null ? "" : "{inset(m)}px"

// One side of a margin or a padding: the first of its own field, its axis's
// and the whole box's that is set, as CSS reads them.
const func side(all option[ui.measurement], axis option[ui.measurement], own option[ui.measurement]) string {
    return length(own != null ? own : axis != null ? axis : all)
}

const func cssColor(c option[color]) => c == null ? "" : c.hex()

const func decl(name string, value string) => value == "" ? "" : "{name}: {value}; "

const func weightOf(w ui.FontWeight) string {
    return match w {
        normal => "normal"
        bold => "bold"
        bolder => "bolder"
        lighter => "lighter"
        unset => ""
    }
}

const func slantOf(s ui.FontStyle) string {
    return match s {
        normal => "normal"
        italic => "italic"
        oblique => "oblique"
        unset => ""
    }
}

// A border its Style gives a width and no line is drawn solid, as every target
// without CSS's default of none draws one.
const func lineOf(s ui.Style) string {
    return match s.borderStyle {
        solid => "solid"
        dashed => "dashed"
        dotted => "dotted"
        double => "double"
        none => "none"
        unset => s.borderWidth != null ? "solid" : ""
    }
}

const func cssOf(s ui.Style) string {
    var css = decl("margin-top", side(s.margin, s.marginY, s.marginTop)) + decl("margin-right", side(s.margin, s.marginX, s.marginRight)) + decl("margin-bottom", side(s.margin, s.marginY, s.marginBottom)) + decl("margin-left", side(s.margin, s.marginX, s.marginLeft)) + decl("padding-top", side(s.padding, s.paddingY, s.paddingTop)) + decl("padding-right", side(s.padding, s.paddingX, s.paddingRight)) + decl("padding-bottom", side(s.padding, s.paddingY, s.paddingBottom)) + decl("padding-left", side(s.padding, s.paddingX, s.paddingLeft)) + decl("min-width", length(s.minWidth)) + decl("color", cssColor(s.color)) + decl("font-size", length(s.fontSize)) + decl("font-family", s.fontFamily) + decl("font-weight", weightOf(s.fontWeight)) + decl("font-style", slantOf(s.fontStyle)) + decl("background", cssColor(s.background)) + decl("border-radius", length(s.borderRadius)) + decl("border-color", cssColor(s.borderColor)) + decl("border-width", length(s.borderWidth)) + decl("border-style", lineOf(s)) + decl("border", s.border) + decl("border-bottom", s.borderBottom) + decl("border-left", s.borderLeft) + decl("opacity", s.opacity == null ? "" : "{s.opacity}")
    return css
}

// An unset alignment is CSS's default, stretch.
const func crossOf(a ui.Alignment) int {
    return match a {
        start => 1
        center => 2
        end => 3
        baseline => 4
        unset, stretch => 0
    }
}

const func textAlignOf(a ui.TextAlign) int {
    return match a {
        center => 1
        right => 2
        justify => 3
        left => 4
        unset => 0
    }
}

const func wrapOf(w ui.WhiteSpace) int {
    return match w {
        pre, nowrap => 1
        preWrap, preLine => 2
        unset, normal => 0
    }
}

// What GTK takes for a Style: CSS for the widget's own node, and beside it
// what GTK says through properties instead. A block rather than an
// expression, so the optimizer calls it instead of splicing a computed Style
// into each of the fields that read it.
//
// `flex` is a child's share of its box's spare room, and `justifyContent`
// where a box puts what its children leave of it: a GtkBox splits the room
// evenly and packs from the start, so gtk4rt lays out a box that asks for
// either otherwise.
const func lookOf(s ui.Style) gtk.Look {
    var look = lookHidden(s, s.display == ui.Display.none, false, 0)
    return look
}

// The look of a GtkBox, which holds its spacing: its gap, or what the
// override spaces its children by. gtk4rt sets it, since a box it lays out
// is one GtkBox's own setter cannot reach.
const func boxLookOf(s ui.Style, otherwise int) gtk.Look {
    var look = lookHidden(s, s.display == ui.Display.none, true, spacingOf(s, otherwise))
    return look
}

// The look of a widget whose visibility a prop drives, which answers
// `display` itself through shown.
const func lookBesideVisible(s ui.Style) gtk.Look {
    var look = lookHidden(s, false, false, 0)
    return look
}

// lookBesideVisible for a GtkBox.
const func boxLookBesideVisible(s ui.Style, otherwise int) gtk.Look {
    var look = lookHidden(s, false, true, spacingOf(s, otherwise))
    return look
}

const func shown(s ui.Style) => s.display != ui.Display.none

const func justifyOf(j ui.Justification) int {
    return match j {
        center => 1
        end => 2
        spaceBetween => 3
        spaceAround => 4
        spaceEvenly => 5
        unset, start => 0
    }
}

const func lookHidden(s ui.Style, hidden bool, spaced bool, spacing int) gtk.Look {
    var look gtk.Look = {
        css = cssOf(s),
        width = inset(s.width),
        height = inset(s.height),
        grow = s.flex == null ? 0.0 : s.flex,
        cross = crossOf(s.alignItems),
        textAlign = textAlignOf(s.textAlign),
        lines = s.maxLines == null ? 0 : s.maxLines,
        wrap = wrapOf(s.whiteSpace),
        hidden = hidden,
        cursor = s.cursor,
        justify = justifyOf(s.justifyContent),
        spaced = spaced,
        spacing = spacing,
    }
    return look
}

// Whether a Style says anything of its border, which then is all of it.
const func bordered(s ui.Style) => s.border != "" || s.borderBottom != "" || s.borderLeft != "" || s.borderWidth != null || s.borderColor != null || s.borderStyle != ui.BorderStyle.unset

// The look of the frame a clickable card's button holds: the button draws the
// card's border, so the frame draws the theme's only where the Style says
// nothing of one.
const func innerFrameLookOf(s ui.Style) gtk.Look {
    var look gtk.Look = {css=bordered(s) ? "border-style: none; " : ""}
    return look
}

// A box's spacing: its gap, or what the override spaces its children by.
const func spacingOf(s ui.Style, otherwise int) => s.gap == null ? otherwise : int(inset(s.gap))
