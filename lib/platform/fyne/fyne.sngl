import ui "sngl:ui"
import time "sngl:time"
import markup "sngl:ui/markup"
import shapes "sngl:ui/draw"
import . "sngl:macro"
import . "sngl:internal/marks"
import build "sngl:build"
import go "sngl:language/go"
import async "sngl:async"
import gen "sngl:x/gen"

// The `fyne` node of a build directive: `output { go { fyne() } }`.
// fyne.Do queues onto the goroutine running the driver, which is the one that
// owns every widget.
#[gen.can(asyncPost, instanceState)]
// Withholding reactivity is what asks for the explicit `nX.<prop> = <expr>`
// after every mutation of a tracked var, which is how a Fyne widget is told
// anything; withholding declarative flattens the tree into the
// create/append/attachHandler calls this platform consumes through
// WalkLowered. A toolkit that owns its widgets and has no diffing of its own
// needs both.
#[gen.cannot(reactivity, declarative, inlineComponents, structSpread)]
#[gen.wants(structComponents, stdlibContextParam, canvas, reactiveCanvas)]
#[gen.name("fyne")]
#[gen.native("fyne")]
component platform(
    // Go package name for the generated files.
    const package       string,
    // Emit a standalone main() or a library-style module.
    const main          bool,
    // The process start, wrapped: what the handler does before calling `run`
    // happens before the event loop, and what it does after, once the loop
    // has exited. `run` presents the windows and runs the loop. A handler
    // that never calls it gets a process whose loop still runs -- timers,
    // effects, posted work -- with no window on screen. The application has
    // torn down when `run` returns, and a second call ends the process. `args`
    // is the command line after the program's name.
    @run(args list[string], run func()),
    // What its generated code introduces beside a program's names: the packages
    // it imports, an instance record's receiver, the Model's own members, and
    // the locals BuildUI declares around the nodes a program names.
    const reservedNames list[string] = [
        "fyne",
        "app",
        "canvas",
        "container",
        "layout",
        "test",
        "theme",
        "widget",
        "fynelayout",
        "fynetext",
        "fynetheme",
        "snglcanvas",
        "color",
        "c",
        "toasts",
        "toastLabel",
        "toastBox",
        "buildUI",
        "showToast",
        "updateToast",
        "content",
        "parts",
        "slotContent",
        "win",
    ],
) build.platform

// --- Windows ---

// A toplevel: the host object a `ui.window` is on this platform. A node the
// package body holds is attached to the application, and attaching one of
// these creates the fyne.Window and puts it on screen once the loop runs;
// removing one, as an `if` turning false does, destroys it and everything in
// it. `visible` shows and hides it without destroying it, and the window
// manager's close is reported as `visible = false` followed by `@closed`.
#[intrinsic("fyne:Toplevel")]
component Toplevel(
    title    string,
    :visible bool = true,
    @closed(),
    content  ...component ui.node,
) root

// The window's `@error` is the outermost boundary of what it renders, and
// catches whether or not the call site handles one.
const component ui.window[platform](title, visible, @error, @closed, content, favicon) {
    Toplevel(title=title, :visible=visible, @closed { closed() }) {
        boundary(@error(e) { error(e) }) {
            content
        }
        #[family.crosses]
        favicon
    }
}

// --- The Spec vocabulary ---

// One argument to a widget's Go constructor.
//
// `prop` names one of the primitive's value props; when the instantiation
// supplies it, that expression is the argument. `raw` is Go source spliced
// verbatim, and is also the fallback when `prop` names a prop the caller left
// out — a Fyne constructor takes its content up front, so the argument still
// has to be *something*.
struct Arg {
    raw  string
    prop string
}

// The Go setter method one value prop becomes: `Setter{prop="text",
// call="SetText"}` emits `w.SetText(v)`. A prop with no Setter has no Fyne
// surface to reach, so the assignment is dropped.
struct Setter {
    prop    string
    call    string
    // current is the Go field holding what `call` writes, for a widget whose
    // setter fires its own change callback even for the value it holds:
    // the write is skipped then.
    current string
}

// The Go callback field one declared event is assigned to.
//
// `signature` is the Go func literal type the field takes. Its parameters are
// the SNGL event's, position for position: `OnChanged` on an Entry is
// `func(s string)` and the primitive's `@input` declares `(text string)`, so a
// handler's parameter is the callback's.
struct Handler {
    on        string
    field     string
    signature string
}

// Everything the Go emitter needs to build one Fyne widget.
//
// `new` is the constructor function and `args` what it is called with.
// `goType` is what it returns — it reaches the output as a Model field's type
// string rather than as an evaluated call, which is why `imports` must name
// its package as well as the constructor's: gc cannot see a type it never
// evaluates.
//
// `add` and `content` are the two ways a container takes children, and only
// one of them applies: `add` is the method a Container calls per child
// (default `Add`), `content` the field a Wrapper assigns its single child to
// (default `Content`).
// A Go declaration this platform emits a reference to: the import path it
// lives in, and its identifier there.
//
// That is the whole of what a Spec can know. What the package is *called* in
// the emitted file is the Go backend's to decide -- a module's package name is
// in its source rather than in its path, and another import may already hold
// the obvious name -- so a Spec that spelled a selector would be guessing at
// both. `name` may carry the pointer and slice syntax a type needs.
struct Native {
    path string
    name string
}

struct Spec {
    new      Native
    args     list[Arg]
    goType   Native
    add      string
    content  string
    setters  list[Setter]
    handlers list[Handler]
}

// The box a primitive is shown in, which style.sngl's lookOf builds from a
// ui.Style. Its fields are fynelayout.Look's; see that type.
#[go.native("duckfam.us/sngl/pkg/go/fynelayout", "fynelayout.Look")]
struct Look {
    marginTop     float32
    marginRight   float32
    marginBottom  float32
    marginLeft    float32
    paddingTop    float32
    paddingRight  float32
    paddingBottom float32
    paddingLeft   float32
    width         float32
    height        float32
    minWidth      float32
    maxWidth      float32
    maxHeight     float32
    grow          float32
    gap           float32
    cross         int
    justify       int
    fill          color
    stroke        color
    strokeWidth   float32
    radius        float32
    textColor     color
    textSize      float32
    bold          bool
    italic        bool
    monospace     bool
    textAlign     int
    wrap          int
    hidden        bool
}

// --- The primitives ---
//
// #[intrinsic] is what makes these primitives rather than wrappers over one:
// they carry no body, so the inliner leaves them in place, and the emitter
// recognises them by the id rather than by their names.

#[gen.renders(identity)]
#[intrinsic("fyne:Widget")]
component Widget(
    const spec  Spec,
    text        string,
    placeholder string,
    number      int,
    flag        bool,
    options     list[string],
    date        option[time.date],
    look        Look,
    @click(),
    @change(text string),
    @input(text string),
    @toggle(flag bool),
    @adjust(number int),
    @pick(date option[time.date]),
) ui.node

#[gen.renders(identity)]
#[intrinsic("fyne:Container")]
component Container(
    const spec  Spec,
    text        string,
    placeholder string,
    number      int,
    flag        bool,
    options     list[string],
    look        Look,
    @click(),
    @change(text string),
    @input(text string),
    children    ...component,
) ui.node

#[gen.renders(identity)]
#[intrinsic("fyne:Wrapper")]
component Wrapper(
    const spec  Spec,
    text        string,
    placeholder string,
    number      int,
    flag        bool,
    options     list[string],
    look        Look,
    @click(),
    @change(text string),
    @input(text string),
    @reachEnd(),
    content     ...component option[ui.node],
) ui.node

// --- The Fyne widgets ---
//
// One declaration per Go constructor. Each is an ordinary component:
// its body instantiates a primitive with the Spec that says which Fyne widget
// to build, and the inliner collapses it into whatever instantiated it. They
// are the vocabulary user code reaches for as `fyne.Label(...)`, and they are
// written the same way a user would write one more.

const component Label(text string = "", style ui.Style = ui.Style{}) ui.node {
    Widget(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/widget", name="NewLabel"},
            args = [Arg{raw=`""`}],
            goType = Native{path="fyne.io/fyne/v2/widget", name="*Label"},
            setters = [Setter{prop="text", call="SetText"}],
        },
        text = text,
        look = lookOf(style),
    ) {}
}

const component Button(text string = "", style ui.Style = ui.Style{}, @click()) ui.node {
    Widget(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/widget", name="NewButton"},
            args = [Arg{raw=`""`}, Arg{raw="nil"}],
            goType = Native{path="fyne.io/fyne/v2/widget", name="*Button"},
            setters = [Setter{prop="text", call="SetText"}],
            handlers = [Handler{on="click", field="OnTapped", signature="func()"}],
        },
        text = text,
        look = lookOf(style),
        @click { click() },
    ) {}
}

const component Entry(text string = "", placeholder string = "", style ui.Style = ui.Style{}, @input(text string), @change(text string)) ui.node {
    Widget(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/widget", name="NewEntry"},
            goType = Native{path="fyne.io/fyne/v2/widget", name="*Entry"},
            setters = [
                Setter{prop="text", call="SetText"},
                Setter{prop="placeholder", call="SetPlaceHolder"},
            ],
            handlers = [
                Handler{on="input", field="OnChanged", signature="func(s string)"},
                Handler{on="change", field="OnSubmitted", signature="func(s string)"},
            ],
        },
        text = text,
        placeholder = placeholder,
        look = lookOf(style),
        @input { input() },
        @change { change() },
    ) {}
}

const component MultiLineEntry(
    text        string = "",
    placeholder string = "",
    rows        int = 0,
    style       ui.Style = ui.Style{},
    @input(text string),
    @change(text string),
) ui.node {
    Widget(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/widget", name="NewMultiLineEntry"},
            goType = Native{path="fyne.io/fyne/v2/widget", name="*Entry"},
            setters = [
                Setter{prop="text", call="SetText"},
                Setter{prop="placeholder", call="SetPlaceHolder"},
                Setter{prop="number", call="SetMinRowsVisible"},
            ],
            handlers = [
                Handler{on="input", field="OnChanged", signature="func(s string)"},
                Handler{on="change", field="OnSubmitted", signature="func(s string)"},
            ],
        },
        text = text,
        placeholder = placeholder,
        number = rows,
        look = lookOf(style),
        @input { input() },
        @change { change() },
    ) {}
}

const component Check(text string = "", checked bool = false, style ui.Style = ui.Style{}, @change(checked bool)) ui.node {
    Widget(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/widget", name="NewCheck"},
            args = [Arg{raw=`""`}, Arg{raw="nil"}],
            goType = Native{path="fyne.io/fyne/v2/widget", name="*Check"},
            setters = [
                Setter{prop="text", call="SetText"},
                Setter{prop="flag", call="SetChecked"},
            ],
            handlers = [Handler{on="toggle", field="OnChanged", signature="func(b bool)"}],
        },
        text = text,
        flag = checked,
        look = lookOf(style),
        @toggle { change() },
    ) {}
}

// `options` must be assigned before `selected`: `SetSelected` ignores a value
// that is not already among `Options`, and the props are assigned in the order
// this call writes them. Reordering them is why the constructor can take `nil`
// choices.
const component Select(
    selected string = "",
    options  list[string] = [],
    style    ui.Style = ui.Style{},
    @change(value string),
) ui.node {
    Widget(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/widget", name="NewSelect"},
            args = [Arg{raw="nil"}, Arg{raw="nil"}],
            goType = Native{path="fyne.io/fyne/v2/widget", name="*Select"},
            setters = [
                Setter{prop="text", call="SetSelected", current="Selected"},
                Setter{prop="options", call="SetOptions"},
            ],
            handlers = [Handler{on="change", field="OnChanged", signature="func(s string)"}],
        },
        options = options,
        text = selected,
        look = lookOf(style),
        @change { change() },
    ) {}
}

// `widget.Hyperlink` exposes its text and its URL as struct fields rather than
// as setters, and a URL is a `*url.Parse` result rather than an expression this
// package can spell, so the link renders empty.
const component Hyperlink(style ui.Style = ui.Style{}) ui.node {
    Widget(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/widget", name="NewHyperlink"},
            args = [Arg{raw=`""`}, Arg{raw="nil"}],
            goType = Native{path="fyne.io/fyne/v2/widget", name="*Hyperlink"},
        },
        look = lookOf(style),
    ) {}
}

const component Spacer(style ui.Style = ui.Style{}) ui.node {
    Widget(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/layout", name="NewSpacer"},
            goType = Native{path="fyne.io/fyne/v2", name="CanvasObject"},
        },
        look = lookOf(style),
    ) {}
}

const component VBox(style ui.Style = ui.Style{}, children ...component) ui.node {
    Container(
        spec = Spec{
            new = Native{path="duckfam.us/sngl/pkg/go/fynelayout", name="NewVBox"},
            goType = Native{path="fyne.io/fyne/v2", name="*Container"},
            add = "Add",
        },
        look = lookOf(style),
    ) {
        children
    }
}

const component HBox(style ui.Style = ui.Style{}, children ...component) ui.node {
    Container(
        spec = Spec{
            new = Native{path="duckfam.us/sngl/pkg/go/fynelayout", name="NewHBox"},
            goType = Native{path="fyne.io/fyne/v2", name="*Container"},
            add = "Add",
        },
        look = lookOf(style),
    ) {
        children
    }
}

// A grid of `columns` equal columns, its children laid out a row at a time.
const component Grid(columns int = 1, style ui.Style = ui.Style{}, children ...component) ui.node {
    Container(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/container", name="NewGridWithColumns"},
            args = [Arg{prop="number", raw="1"}],
            goType = Native{path="fyne.io/fyne/v2", name="*Container"},
            add = "Add",
        },
        number = columns,
        look = lookOf(style),
    ) {
        children
    }
}

const component VScroll(style ui.Style = ui.Style{}, content ...component option[ui.node]) ui.node {
    Wrapper(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/container", name="NewVScroll"},
            args = [Arg{raw="nil"}],
            goType = Native{path="fyne.io/fyne/v2/container", name="*Scroll"},
            content = "Content",
        },
        look = lookOf(style),
    ) {
        content
    }
}

// A vertical scroll reporting the end of its content coming within half a
// viewport of showing (pkg/go/fynelayout's ReachScroll): Fyne reports a scroll
// and nothing about the content growing, which is what a handler adding a page
// does.
const component ReachScroll(style ui.Style = ui.Style{}, @reachEnd(), content ...component option[ui.node]) ui.node {
    Wrapper(
        spec = Spec{
            new = Native{path="duckfam.us/sngl/pkg/go/fynelayout", name="NewReachScroll"},
            goType = Native{path="duckfam.us/sngl/pkg/go/fynelayout", name="*ReachScroll"},
            content = "Content",
            handlers = [Handler{on="reachEnd", field="OnReachEnd", signature="func()"}],
        },
        look = lookOf(style),
        @reachEnd { reachEnd() },
    ) {
        content
    }
}

// --- Layout containers ---

const component ui.vbox[platform](style, children) {
    VBox(style=style) {
        children
    }
}

const component ui.hbox[platform](style, children) {
    HBox(style=style) {
        children
    }
}

// Fyne has no layered container in the widget set this platform builds from,
// so a stack is a vertical box: the children are all present and in order,
// they just do not overlap.
const component ui.stack[platform](style, layers) {
    VBox(style=style) {
        layers
    }
}

const component ui.scroll[platform](style, @reachEnd, content) {
    ReachScroll(style=style, @reachEnd { reachEnd() }) {
        content
    }
}

const component ui.spacer[platform](style) {
    Spacer(style=style) {}
}

// A clickable card is its box shown in a fynelayout.Tap, the widget Fyne hands
// a tap to: a box is drawn and never tapped.
const component ui.card[platform](style, clickable, @click, content) {
    if clickable {
        Wrapper(
            spec = Spec{
                new = Native{path="duckfam.us/sngl/pkg/go/fynelayout", name="NewTap"},
                args = [Arg{raw="nil"}],
                goType = Native{path="duckfam.us/sngl/pkg/go/fynelayout", name="*Tap"},
                content = "Content",
                handlers = [Handler{on="click", field="OnTapped", signature="func()"}],
            },
            look = lookOf(style),
            @click { click() },
        ) {
            VBox {
                content
            }
        }
    } else {
        VBox(style=style) {
            content
        }
    }
}

const component ui.splitview[platform](style, panes) {
    HBox(style=style) {
        panes
    }
}

// --- Overlays ---
//
// `open` is not forwarded: Fyne's overlay lifecycle is a canvas-level
// push/pop rather than a property, and a Spec's vocabulary is setters and
// constructor arguments. So an overlay renders inline with its content
// visible.

const component ui.modal[platform](style, content) {
    VBox(style=style) {
        content
    }
}

const component ui.drawer[platform](style, content) {
    VBox(style=style) {
        content
    }
}

const component ui.popover[platform](style, content) {
    VBox(style=style) {
        content
    }
}

// The shape html uses: a box carrying the tooltip text, with the wrapped
// content inside it.
const component ui.tooltip[platform](style, trigger) {
    VBox(style=style) {
        trigger
    }
}

// --- Navigation ---
//
// A menu bar and toolbar are a row of their entries, and tabs are sngl:ui's
// own body. Fyne's own AppTabs/MainMenu/Toolbar take their items as typed
// constructor arguments (`[]*container.TabItem`, `[]*fyne.MenuItem`), which no
// `Arg` can build out of a SNGL prop.

const component ui.toolbar[platform](style, controls) {
    HBox(style=style) {
        controls
    }
}

const component ui.menubar[platform](style) {
    HBox(style=style) {}
}

const component ui.menu[platform](style) {
    VBox(style=style) {}
}

// --- Data display ---
//
// `tree` and `radio` take their contents as a list prop rather than as
// children, and Fyne's Tree reads its own through callbacks a Spec has no way
// to spell. Each renders as its container, empty.

// A table is a grid of labels a column per heading, the headings first and
// then each row's cells, so a cell lines up under its heading. Fyne's own
// Table reads its cells through callbacks a Spec cannot spell; the grid's
// column count is a constructor argument, fixed where the table is built.
const component ui.table[platform](style, columns, rows) {
    Grid(columns=columns.length(), style=style) {
        for var col = columns {
            Label(text=col, style={fontWeight=bold})
        }
        for var row = rows {
            for var cell = row.cells {
                Label(text=cell)
            }
        }
    }
}

const component ui.tree[platform](style) {
    VBox(style=style) {}
}

const component ui.radio[platform](style) {
    VBox(style=style) {}
}

// --- Text ---

const component ui.text[platform](value, style) {
    Label(text=value, style=style) {}
}

const component ui.divider[platform](style, label) {
    Label(text=label, style=style) {}
}

const component ui.spinner[platform](label, style) {
    Label(text=label, style=style) {}
}

// `value` is a float and the label is text, so the conversion is spelled
// here rather than left to the Spec, which binds a prop to a setter and
// converts nothing. A bar with no value has no number to show and falls back
// to its `label`, which is the only other thing it was told.
const component ui.progress[platform](style, value, label) {
    if value != null {
        Label(text=string(value), style=style) {}
    } else {
        Label(text=label, style=style) {}
    }
}

// The picker shows its `placeholder` and neither reads the bound value nor
// reports a selection: Fyne has no date widget among those wrapped here,
// so the Label is a stub standing in for one rather than a picker whose value
// has nowhere to go.
// Fyne's DateEntry takes a typed date or one picked from its calendar button,
// and reports it as the *time.Time an option[date] is in Go, nil when cleared.
const component DateEntry(
    value       option[time.date] = null,
    placeholder string = "",
    style       ui.Style = ui.Style{},
    @change(date option[time.date]),
) ui.node {
    Widget(
        spec = Spec{
            new = Native{path="fyne.io/fyne/v2/widget", name="NewDateEntry"},
            goType = Native{path="fyne.io/fyne/v2/widget", name="*DateEntry"},
            setters = [
                Setter{prop="date", call="SetDate"},
                Setter{prop="placeholder", call="SetPlaceHolder"},
            ],
            handlers = [Handler{on="pick", field="OnChanged", signature="func(d *time.Time)"}],
        },
        date = value,
        placeholder = placeholder,
        look = lookOf(style),
        @pick { change() },
    ) {}
}

const component ui.datepicker[platform](placeholder, value, style, @change) {
    DateEntry(value=value, placeholder=placeholder, style=style, @change(d) {
        if d != value {
            value = d
            change(d)
        }
    }) {}
}

// --- Controls ---

const component ui.button[platform](text, style, @click) {
    Button(text=text, style=style, @click { click() }) {}
}

// `href` and `text` are not forwarded — see the Hyperlink declaration.
const component ui.link[platform](style) {
    Hyperlink(style=style) {}
}

// --- Images ---
//
// An image is this platform's runtime and not a Fyne widget: a box holding the
// source it shows, fitted as `fit` says, or the placeholder where it holds
// none. A source shows its picture itself -- the file a URL names, carried in
// the program or fetched, or the picture a drawing paints -- and reports to the
// image whether it arrived. In a window, a source is its icon.
#[intrinsic("fyne:Image")]
component Image(
    fit     string,
    look    Look,
    @click(),
    @load(),
    @failed(message string),
    content ...component option[ui.imageSource],
) ui.node

#[intrinsic("fyne:ImageUrl")]
component ImageUrl(url string) ui.imageSource

#[intrinsic("fyne:ImageDrawing")]
component ImageDrawing(width float, height float, shapes ...component shapes.shape) ui.imageSource

const component ui.image[platform](fit, style, @click, @load, @error, src) {
    Image(
        fit = string(fit),
        look = lookOf(style),
        @click {
            click()
        },
        @load {
            load()
        },
        @failed(m) {
            error({message=m, kind="image"})
        },
    ) {
        src
    }
}

const component ui.file[platform](path) {
    ImageUrl(url=path)
}

const component ui.remote[platform](url) {
    ImageUrl(url=url)
}

const component shapes.image[platform](width, height, shapes) {
    ImageDrawing(width=width, height=height) {
        shapes
    }
}

const component ui.checkbox[platform](label, checked, style, @change) {
    Check(text=label, checked=checked, style=style, @change(on) {
        if on != checked {
            checked = on
            change(on)
        }
    }) {}
}

// Fyne's Check is the switch affordance too: `widget.Switch` is not in the
// widget set this platform builds from.
const component ui.toggle[platform](label, checked, style, @change) {
    Check(text=label, checked=checked, style=style, @change(on) {
        if on != checked {
            checked = on
            change(on)
        }
    }) {}
}

const component ui.select[platform](value, style, @change, options) {
    Select(selected=value, options=options.map(func(o) => o.label), style=style, @change(v) {
        if v != value {
            value = v
            change(v)
        }
    }) {}
}

// --- Text entry ---

const component ui.input[platform](placeholder, value, style, @input, @change) {
    Entry(
        text = value,
        placeholder = placeholder,
        style = style,
        @input(v) {
            if v != value {
                value = v
                input(v)
            }
        },
        @change(v) {
            value = v
            change(v)
        },
    ) {}
}

const component ui.textarea[platform](placeholder, value, rows, style, @input, @change) {
    MultiLineEntry(
        text = value,
        placeholder = placeholder,
        rows = rows,
        style = style,
        @input(v) {
            if v != value {
                value = v
                input(v)
            }
        },
        @change(v) {
            value = v
            change(v)
        },
    ) {}
}

// --- The timer ---
//
// A recurring deadline is not a widget, so it is no primitive of this platform:
// the pair below is a lifetime with a thing to release, which is what `effect`
// brackets.

// `*time.Ticker` is a name this declaration can spell, which is what
// `#[cnative]` does for `*C.cairo_t` in gtk4.sngl, one scheme over -- and `C`
// is a field of it, which is why `sngl:language/go` had to grow a channel type
// before any of this could be written down.
#[go.native("time", "*time.Ticker")]
struct Schedule {
    C go.chan[time.datetime]
}

#[go.native("time", "time.NewTicker")]
func newTicker(d time.duration) Schedule

#[go.native("time", "time.Ticker.Stop", method)]
func Schedule.stop()

#[go.native("time", "time.Ticker.Reset", method)]
func Schedule.reset(d time.duration)

// Two effects, because a schedule and its period have two lifetimes. The first
// has no key, so it lives as long as the branch it is written in: it builds
// the ticker and stops it. The second is keyed on the period and handles only
// `@update`, so a new period retimes the running ticker in place rather than
// stopping it and building another -- a rebuilt one would start its period
// again from zero.
//
// `enabled` and a positive interval are the *position*: an effect lives as long
// as the branch holding it, so toggling the gate is a mount and an unmount, and
// a non-positive interval arms nothing. That has to be decided before
// `NewTicker` and `Reset`, which both *panic* on one.
//
// `@update` runs on every write to the interval, one of the period already
// running included, and `Reset` restarts the period even then -- so the period
// the ticker runs at is held in `period` and only a different one resets it.
// The `d > 0ms` test is for the write that takes the interval to zero, which
// `@update` reports before the branch closes.
//
// `Ticker.Stop` does not close `C`, so a goroutine parked on a receive from it
// stays parked for the life of the process. `done` is the second arm that ends
// it, and `go.select` is what makes the two a choice rather than a sequence --
// two receives in a row would take the tick before ever looking at `done`.
const component time.timer[platform](interval, enabled, @tick) {
    var handle Schedule
    var done go.chan[bool]
    var period time.duration
    var gen = 0

    if enabled && interval > 0ms {
        effect(
            @mount {
                gen = gen + 1
                var mine = gen
                period = interval
                handle = newTicker(interval)
                done = go.makeChan(false)
                var stopped = done
                var ticker = handle
                async.start(func() {
                    for {
                        go.select([
                            go.recv(ticker.C, func(at time.datetime) {
                                async.do(func() {
                                    // A post queued before an unmount runs
                                    // after it. `gen` is what it finds:
                                    // without it a stale tick writes state
                                    // the unmount has finished with.
                                    if gen != mine {
                                        return
                                    }
                                    tick()
                                })
                            }),
                            go.recv(stopped, func(b bool) {
                                return
                            }),
                        ])
                    }
                })
            },
            @unmount {
                // Closing `done` rather than sending on it: a closed channel is
                // always ready, so the goroutine's second arm is taken on its
                // very next pass whether or not anything is listening yet.
                gen = gen + 1
                handle.stop()
                go.closeChan(done)
            },
        )
        effect(
            on = interval,
            @update(d) {
                if d > 0ms && d != period {
                    period = d
                    handle.reset(d)
                }
            },
        )
    }
}

// --- Rich text ---
//
// The span family. Two primitives and a table of overrides, which is html's
// division; what differs here is that neither primitive carries a `Spec`. A
// widget's Spec says which Go constructor to call and with what, and a span's
// arguments are its `SpanStyle` -- a struct literal the emitter has to read
// rather than pass on, for the reason html's `spanStyleCSS` gives: a field the
// author left alone must emit nothing, and which fields those are cannot be
// asked of an opaque prop. So `markup.go` builds their Spec from the node's
// own props, and everything downstream of that -- the constructor, the Model
// field, `Add`, the setters, reactivity -- is the machinery every other widget
// here already goes through.
//
// `pkg/go/fynetext` is the other half and is where Fyne's own gaps are
// answered: the cascade, which Fyne does not inherit; a run's color and size,
// which a segment names through a theme rather than carrying; and underline
// and strikethrough, which Fyne draws nowhere at all.

// A flow of spans, as a node. `richText` cannot insert its own content -- it
// is a `ui.node` whose slot is the span family -- so something has to join the
// widget family and host the span one.
//
// Its `look` is every node's: the block styling a document's headings and
// quotes ask for is the box it is shown in. The role is not taken, there
// being nothing in Fyne that a heading announces itself to.
#[intrinsic("fyne:Flow")]
component Flow(
    look    Look,
    content ...component markup.span,
) ui.node

// One run of words. `text` and `href` are setters, so a reactive prop reaches
// the span and the flow rebuilds around it; `spanStyle` and `kind` are read
// off the literal and become the style the run is constructed with. `color` is
// a palette's answer for a token, and wins over the theme's: read off the
// literal where the build knows it and set where the program does.
#[intrinsic("fyne:Span")]
component Span(
    text      string,
    href      string,
    spanStyle markup.SpanStyle,
    kind      markup.Token,
    color     color,
    content   ...component markup.span,
) markup.span

const component markup.richText[platform](style, content) {
    Flow(look=lookOf(style)) {
        content
    }
}

const component markup.text[platform](value) {
    Span(text=value) {}
}

const component markup.run[platform](style, content) {
    Span(spanStyle=style) {
        content
    }
}

const component markup.link[platform](href, content) {
    Span(href=href) {
        content
    }
}

const component markup.token[platform](kind, content) {
    Span(kind=kind, color=markup.tokenColor(markup.palette, kind)) {
        content
    }
}

// Fyne has an image segment and it is a block -- "images in rich text are
// blocks", says its own comment -- so there is no picture to put on the line
// with the words. The description is what an image is here, in the brackets
// that say a picture stood where they are.
const component markup.image[platform](alt) {
    Span(text="[{alt}]") {}
}
