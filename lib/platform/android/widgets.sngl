import ui "sngl:ui"
import time "sngl:time"
import shapes "sngl:ui/draw"
import . "sngl:internal/marks"

// The portable components, implemented for this platform.
//
// Split from android.sngl rather than living in it: a package is its
// directory, so a file is a topic and not a compilation unit. The intrinsics
// these are written in terms of are declared there.

// --- The window ---

// The window's `@error` is the outermost boundary of what it renders, and
// catches whether or not the call site handles one.
const component ui.window[platform](visible, @error, @closed, content) {
    Screen(visible=visible, onBack=func() {
        visible = false
        closed()
    }) {
        boundary(@error(e) { error(e) }) {
            content
        }
    }
}

// --- Core Layout ---

const component ui.vbox[platform](style, children) {
    Column(modifier={...style}) {
        children
    }
}

const component ui.hbox[platform](style, children) {
    Row(modifier={...style}) {
        children
    }
}

const component ui.stack[platform](style, layers) {
    Box(modifier={...style}) {
        layers
    }
}

const component ui.spacer[platform](style) {
    Spacer(modifier={...style}) {}
}

const component ui.scroll[platform](style, content) {
    Column(
        modifier = {...style},
        then = [modifier.verticalScroll(rememberScrollState())],
    ) {
        content
    }
}

// --- Core Text & Media ---

const component ui.text[platform](value, style) {
    Text(text=value, modifier={...style}, style={...style}) {}
}

const component ui.button[platform](text, style, @click) {
    Button(onClick=func() { click() }, modifier={...style}, colors={...style}, shape={...style}) {
        Text(text=text) {}
    }
}

// An image is a box holding the source it shows, or the placeholder where it
// holds none, and it hands its source the two events it reports: a picture
// arriving and one failing. A file the program carries is SnglAssetImage, and
// a picture a URL names SnglRemoteImage, Kotlin the platform ships with the
// app (codegen/platform/android/assets.kt) -- the first reads the app's
// assets, the second fetches off the main thread, since Compose has no image
// loader in the box. A drawing is a Canvas, and reports neither.
const component ui.image[platform](style, @load, @error, src) {
    SnglImage(modifier={...style}, onLoad=func() { load() }, onError=func(m string) {
        error({message=m, kind="image"})
    }) {
        src
    }
}

#[gen.renders(identity)]
#[intrinsic("android:SnglImage")]
component SnglImage(
    modifier ui.Style,
    onLoad   func(),
    onError  func(message string),
    src      ...component option[ui.imageSource],
) ui.node

#[intrinsic("android:SnglAssetImage")]
component SnglAssetImage(url string) ui.imageSource

#[permission("android.permission.INTERNET")]
#[intrinsic("android:SnglRemoteImage")]
component SnglRemoteImage(url string) ui.imageSource

#[intrinsic("android:ImageDrawing")]
component ImageDrawing(width float, height float, shapes ...component shapes.shape) ui.imageSource

const component ui.file[platform](path) {
    SnglAssetImage(url=path)
}

const component ui.remote[platform](url) {
    SnglRemoteImage(url=url)
}

const component shapes.image[platform](width, height, shapes) {
    ImageDrawing(width=width, height=height) {
        shapes
    }
}

// The placeholder is Compose's floating `label`. A field given none must get
// no `label` argument rather than an empty one, so the conditional is the
// slot's whole body: a literal placeholder folds the slot away and a slot that
// renders nothing is not passed. A placeholder only known at run time cannot
// be answered that way and keeps the argument, so an empty one shows as the
// notched, uncaptioned field the fold exists to avoid.
const component ui.input[platform](placeholder, readonly, value, style, @input, @change) {
    OutlinedTextField(
        value = value,
        readOnly = readonly,
        modifier = {...style},
        onValueChange = func(v) {
            value = v
            input(v)
            change(v)
        },
    ) {
        component label {
            if placeholder != "" {
                Text(text=placeholder) {}
            }
        }
    }
}

const component ui.checkbox[platform](label, checked, style, @change) {
    Row(modifier={...style}, verticalAlignment=alignCenterVertically) {
        Checkbox(checked=checked, onCheckedChange=func(on) {
            checked = on
            change(on)
        }) {}
        if label != "" {
            Text(text=label) {}
        }
    }
}

// --- Tier 1: Core Input ---

// Compose's RadioButton is one option, so the group is the loop: the
// container is the direction the prop asks for and each option is a button
// beside its label. onClick is passed nothing, so the override reports the
// option it looped over.
const component ui.radio[platform](value, direction, style, @change, options) {
    if direction == ui.Orientation.horizontal {
        Row(modifier={...style}) {
            for var opt = options {
                Row(verticalAlignment=alignCenterVertically) {
                    RadioButton(selected=(value == opt.label), onClick=func() {
                        value = opt.label
                        change(opt.label)
                    }) {}
                    Text(text=opt.label) {}
                }
            }
        }
    } else {
        Column(modifier={...style}) {
            for var opt = options {
                Row(verticalAlignment=alignCenterVertically) {
                    RadioButton(selected=(value == opt.label), onClick=func() {
                        value = opt.label
                        change(opt.label)
                    }) {}
                    Text(text=opt.label) {}
                }
            }
        }
    }
}

const component ui.toggle[platform](label, checked, style, @change) {
    Row(modifier={...style}, verticalAlignment=alignCenterVertically) {
        Switch(checked=checked, onCheckedChange=func(on) {
            checked = on
            change(on)
        }) {}
        if label != "" {
            Text(text=label) {}
        }
    }
}

// The menu's open state is SnglSelect's own, in Kotlin, as a datepicker's
// dialog is: an override declaring a var gets one cell per call site, and a
// select inside a `for` is many selects.
const component ui.select[platform](placeholder, value, disabled, style, @change, options) {
    SnglSelect(
        value = value,
        options = options.map(func(o) => o.label),
        label = placeholder,
        enabled = disabled == false,
        modifier = {...style},
        onValueChange = func(v) {
            value = v
            change(v)
        },
    ) {}
}

const component ui.textarea[platform](value, style, @input, @change) {
    OutlinedTextField(
        value = value,
        minLines = 3,
        modifier = {...style},
        onValueChange = func(v) {
            value = v
            input(v)
            change(v)
        },
    ) {}
}

// A date is typed as YYYY-MM-DD, or picked in Material's dialog from the
// button beside the field. The half-typed text and the dialog's open state are
// SnglDateField's own, in Kotlin, because a const override has nowhere to hold
// state its render reads. An
// unpicked date shows nothing -- the `option` is what distinguishes that from
// the zero date, the first day of year one.
const component ui.datepicker[platform](placeholder, value, disabled, style, @change) {
    SnglDateField(
        value = value,
        label = placeholder,
        enabled = disabled == false,
        modifier = {...style},
        onValueChange = func(v) {
            value = v
            change(v)
        },
    ) {}
}

// --- Tier 2: Feedback & Navigation ---

// Compose's determinate/indeterminate split is by *presence* of the `progress`
// argument, which is the shape `value` being an `option` gives the override:
// the null test picks the call, and neither branch invents a fraction.
const component ui.progress[platform](style, value, max) {
    if value != null {
        // The null test is repeated inside the lambda because narrowing does
        // not cross into one: a lambda runs later, and the checker will not
        // assume a binding still holds what it held when it was written. The
        // branch the outer `if` already settled is the unreachable one.
        LinearProgressIndicator(
            progress = func() => (value != null ? float32(value / max) : float32(0.0)),
            modifier = {...style},
        ) {}
    } else {
        LinearProgressIndicator(modifier={...style}) {}
    }
}

const component ui.spinner[platform](style) {
    CircularProgressIndicator(modifier={...style}) {}
}

const component ui.badge[platform](value, style) {
    Badge(modifier={...style}) {
        Text(text=value) {}
    }
}

const component ui.divider[platform](style) {
    HorizontalDivider(modifier={...style}) {}
}

const component ui.card[platform](style, content) {
    Card(modifier={...style}) {
        content
    }
}

const component ui.link[platform](text, style) {
    Text(
        text = text,
        style = {...style},
        color = primaryColor,
    ) {}
}

// Material's TabRow of a Tab per tab, and the selected one's content under it.
const component ui.tabs[platform](selected, style, @change, items) {
    Column(modifier={...style}) {
        TabRow(selectedTabIndex=selected) {
            for var k, t = items {
                Tab(selected=(k == selected), enabled=!t.disabled, onClick=func() {
                    selected = k
                    change(k)
                }) {
                    component text {
                        Text(text=t.label) {}
                    }
                }
            }
        }
        for var k, t = items {
            if k == selected {
                t.content
            }
        }
    }
}

const component ui.modal[platform](open, title, @close, content) {
    if open {
        Dialog(onDismissRequest=func() { close() }) {
            Surface(shape=mediumShape) {
                Column(modifier={padding=16px}) {
                    if title != "" {
                        Text(text=title) {}
                    }
                    content
                }
            }
        }
    }
}

const component ui.drawer[platform](style, content) {
    Column(modifier={...style}) {
        content
    }
}

const component ui.tooltip[platform](style, trigger) {
    Column(modifier={...style}) {
        trigger
    }
}

const component ui.popover[platform](style, content) {
    Column(modifier={...style}) {
        content
    }
}

const component ui.splitview[platform](style, panes) {
    Column(modifier={...style}) {
        panes
    }
}

// A table is a column of rows, the headings first and then each row's cells,
// every cell an equal share of its row so that it lines up under its heading.
// The share is `weight` rather than a Style's `flex`, which would stretch
// each row down the whole column too.
const component ui.table[platform](style, columns, rows) {
    Column(modifier={...style}) {
        Row {
            for var col = columns {
                Box(then=[modifier.weight(f32(1.0))]) {
                    Text(text=col, style={fontWeight=bold}) {}
                }
            }
        }
        HorizontalDivider() {}
        for var row = rows {
            Row {
                for var cell = row.cells {
                    Box(then=[modifier.weight(f32(1.0))]) {
                        Text(text=cell) {}
                    }
                }
            }
        }
    }
}

const component ui.tree[platform] {
    Text(text="") {}
}

const component ui.menu[platform] {
    Text(text="") {}
}

const component ui.menubar[platform] {
    Text(text="") {}
}

const component ui.toolbar[platform](style, controls) {
    Column(modifier={...style}) {
        controls
    }
}

// --- The timer ---
//
// A recurring deadline. Compose has a shape for it -- LaunchedEffect keyed on
// the gate, with a delay loop inside -- so the primitive is that, and the
// emitter builds it from the declaration.
//
// The gate reaches the emitter as an expression rather than as the bare
// variable name the analysis used to reduce it to. `enabled=true` produced
// `LaunchedEffect() { while () {`, which is not Kotlin, and no golden covered
// an android timer to say so.
#[intrinsic("android:Timer")]
component Timer[F any](
    interval time.duration,
    enabled  bool,
    @tick,
) F

const component time.timer[platform](interval, enabled, @tick) {
    Timer(interval=interval, enabled=enabled, @tick { tick() }) {}
}
