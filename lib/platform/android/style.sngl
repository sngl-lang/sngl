import ui "sngl:ui"

// What a ui.Style becomes on Compose: a Modifier, a TextStyle, a Material
// button's colors and its shape, each routed by the override to its argument.
//
// None of these reads a composable, since under `--lang go` each may stay a
// function of its own; the theme's text style and a button's default colors
// are read in the overrides.

// What a child's `flex` is a share of. A vbox or an hbox provides a closure
// written in its Column's or Row's content, where `weight` is in scope, so it
// is the parent's share even where the child is a composable of its own,
// called with the closure. Anywhere else it is screenShare's.
context #flexShare(screenShare)

// A Style that writes nothing.
const blank ui.Style = {}

// What a Style may say that this platform does not answer:
//
//   - flexDirection: vbox and hbox are the axis.
//   - position, top, bottom, left, right: Compose has no flow to take a node
//     out of, nor CSS's offsets from one.
//   - border, borderBottom, borderLeft, borderCollapse: CSS shorthand text and
//     table borders.
//   - borderStyle: Compose draws a solid border only.
//   - cursor: a touch screen shows no pointer.
//   - display: a node is laid out by the composable it is.
//   - overflow: scrolling is ui.scroll's, and clipping a shape's.
//   - listStyleType: no widget here draws a list marker.
const unstyled list[string] = [
    "flexDirection",
    "position",
    "top",
    "bottom",
    "left",
    "right",
    "border",
    "borderBottom",
    "borderLeft",
    "borderCollapse",
    "borderStyle",
    "cursor",
    "display",
    "overflow",
    "listStyleType",
]

// A length in dp, as codegen.MeasurementPx reads one: an em is 16, Material's
// body text size.
const func magnitude(m ui.measurement) => m.px + 16.0 * (m.em + m.rem)

const func length(m ui.measurement) => dpOf(float32(magnitude(m)))

// Compose's padding throws on a negative one, which CSS allows for a margin.
// An unset side is none.
const func inset(m option[ui.measurement], extra float) => dpOf(float32(nonNegative(m == null ? 0.0 : magnitude(m)) + extra))

const func nonNegative(v float) => v < 0.0 ? 0.0 : v

const func fontSizeOf(m option[ui.measurement]) TextUnit {
    return m == null ? unspecifiedTextUnit : textUnitOf(float32(magnitude(m)), spUnit)
}

// One side of a margin or a padding: the first of its own field, its axis's
// and the whole box's that is set, as CSS reads them.
const func side(all option[ui.measurement], axis option[ui.measurement], own option[ui.measurement]) option[ui.measurement] {
    return own != null ? own : axis != null ? axis : all
}

const func shapeOf(s ui.Style) Shape {
    return s.borderRadius == null ? rectangleShape : roundedCorners(length(s.borderRadius))
}

// The Modifier a Style asks for, outermost first: the margin, the box's size,
// its outline and fill, and the padding inside them, as CSS's border-box lays
// them out. A widget that paints its own surface takes the background through
// its colors instead of a rectangle drawn behind it, which `paints` turns off.
const func styleModifier(s ui.Style, paints bool) Modifier {
    var m Modifier = modifier
    var top = side(s.margin, s.marginY, s.marginTop)
    var right = side(s.margin, s.marginX, s.marginRight)
    var bottom = side(s.margin, s.marginY, s.marginBottom)
    var left = side(s.margin, s.marginX, s.marginLeft)
    if top != null || right != null || bottom != null || left != null {
        m = m.paddingEach(inset(left, 0.0), inset(top, 0.0), inset(right, 0.0), inset(bottom, 0.0))
    }
    if s.zIndex != null {
        m = m.zIndex(float32(s.zIndex))
    }
    // A bound before the size, since `width` fixes the constraints a later
    // `widthIn` could only be clamped into.
    if s.minWidth != null || s.maxWidth != null {
        m = m.widthIn(
            s.minWidth != null ? length(s.minWidth) : unspecifiedDp,
            s.maxWidth != null ? length(s.maxWidth) : unspecifiedDp,
        )
    }
    if s.maxHeight != null {
        m = m.heightIn(unspecifiedDp, length(s.maxHeight))
    }
    if s.width != null {
        m = m.width(length(s.width))
    }
    if s.height != null {
        m = m.height(length(s.height))
    }
    if s.opacity != null {
        m = m.alpha(float32(s.opacity))
    }
    var shape = shapeOf(s)
    if s.borderRadius != null {
        m = m.clip(shape)
    }
    // Compose draws a border over the content; CSS insets the content by it,
    // so its width joins the padding below. Its color is the text's where it
    // names none, as CSS's currentColor.
    var edge = 0.0
    if s.borderWidth != null {
        edge = magnitude(s.borderWidth)
        m = m.border(length(s.borderWidth), composeOf(s.borderColor != null ? s.borderColor : s.color != null ? s.color : #000000), shape)
    }
    if paints && s.background != null {
        m = m.background(composeOf(s.background), shape)
    }
    top = side(s.padding, s.paddingY, s.paddingTop)
    right = side(s.padding, s.paddingX, s.paddingRight)
    bottom = side(s.padding, s.paddingY, s.paddingBottom)
    left = side(s.padding, s.paddingX, s.paddingLeft)
    if edge != 0.0 || top != null || right != null || bottom != null || left != null {
        m = m.paddingEach(inset(left, edge), inset(top, edge), inset(right, edge), inset(bottom, edge))
    }
    return m
}

// A Column's or a Row's children placed down or along it, as `gap` and
// `justifyContent` say: Compose's Arrangement, which no Modifier says. A spread
// of the free space leaves the gap to it, as CSS's minimum between children is
// no more than what spreads them. An unset one is the start, Compose's
// default and CSS's.
const func columnArrangement(s ui.Style) VerticalArrangement {
    return s.gap == null ? columnPlacement(s.justifyContent) : columnSpacing(s.justifyContent, length(s.gap))
}

const func columnPlacement(j ui.Justification) VerticalArrangement {
    return match j {
        spaceBetween => arrangeSpaceBetweenV
        spaceAround => arrangeSpaceAroundV
        spaceEvenly => arrangeSpaceEvenlyV
        center => arrangeCenterV
        end => arrangeBottom
        unset, start => arrangeTop
    }
}

const func columnSpacing(j ui.Justification, gap Dp) VerticalArrangement {
    return match j {
        spaceBetween => arrangeSpaceBetweenV
        spaceAround => arrangeSpaceAroundV
        spaceEvenly => arrangeSpaceEvenlyV
        center => spacedByAlignedV(gap, alignCenterVertically)
        end => spacedByAlignedV(gap, alignBottom)
        unset, start => spacedByV(gap)
    }
}

const func rowArrangement(s ui.Style) HorizontalArrangement {
    return s.gap == null ? rowPlacement(s.justifyContent) : rowSpacing(s.justifyContent, length(s.gap))
}

const func rowPlacement(j ui.Justification) HorizontalArrangement {
    return match j {
        spaceBetween => arrangeSpaceBetweenH
        spaceAround => arrangeSpaceAroundH
        spaceEvenly => arrangeSpaceEvenlyH
        center => arrangeCenterH
        end => arrangeEnd
        unset, start => arrangeStart
    }
}

const func rowSpacing(j ui.Justification, gap Dp) HorizontalArrangement {
    return match j {
        spaceBetween => arrangeSpaceBetweenH
        spaceAround => arrangeSpaceAroundH
        spaceEvenly => arrangeSpaceEvenlyH
        center => spacedByAlignedH(gap, alignCenterHorizontally)
        end => spacedByAlignedH(gap, alignHorizontalEnd)
        unset, start => spacedByH(gap)
    }
}

// Where `alignItems` puts a Column's or a Row's children across it. Compose
// has no stretch: an unset alignment is CSS's default, stretch, which a child
// that flexes answers by filling the cross axis itself (stretches).
const func columnAlignment(a ui.Alignment) HorizontalAlignment {
    return match a {
        center => alignCenterHorizontally
        end => alignHorizontalEnd
        unset, start, stretch, baseline => alignStart
    }
}

const func rowAlignment(a ui.Alignment) VerticalAlignment {
    return match a {
        center => alignCenterVertically
        end => alignBottom
        unset, start, stretch, baseline => alignTop
    }
}

// Whether a flex child fills its parent's cross axis, CSS's stretch, which an
// unset alignment is. A parent aligning its children otherwise gives the
// share alone: filling is the most the parent may be, not the size of its
// largest child, which made a stats bar in a centered row the whole screen.
const func stretches(s ui.Style) => s.alignItems == ui.Alignment.unset || s.alignItems == ui.Alignment.stretch

// Compose's weight throws on a share that is not positive, which CSS reads as
// none.
const func flexed(m Modifier, flex option[float], share func(float32) Modifier) Modifier {
    return flex == null || flex <= 0.0 ? m : chain(m, share(float32(flex)))
}

const func modifierOf(s ui.Style, share func(float32) Modifier) Modifier {
    return flexed(s == blank ? modifier : styleModifier(s, true), s.flex, share)
}

// modifierOf for a widget that paints its own surface.
const func surfaceModifierOf(s ui.Style, share func(float32) Modifier) Modifier {
    return flexed(s == blank ? modifier : styleModifier(s, false), s.flex, share)
}

const func fontWeightOf(w ui.FontWeight) option[FontWeight] {
    return match w {
        unset => null
        normal => weightNormal
        bold => weightBold
        lighter => weightLight
        bolder => weightExtraBold
    }
}

// Compose has upright and italic and no third face, so `oblique` is italic,
// which is what a font with no true italic is synthesized into anyway.
const func fontStyleOf(st ui.FontStyle) option[FontStyle] {
    return match st {
        unset => null
        normal => slantNormal
        italic, oblique => slantItalic
    }
}

// Only the generic families are names Compose has; any other is a font
// resource an application registers, which SNGL cannot name yet.
const func fontFamilyOf(name string) option[FontFamily] {
    return match name {
        "" => null
        "monospace" => familyMonospace
        "serif" => familySerif
        "sans-serif" => familySansSerif
        "cursive" => familyCursive
        else => familyDefault
    }
}

const func textAlignOf(a ui.TextAlign) TextAlign {
    return match a {
        unset => alignUnspecified
        left => alignStartText
        center => alignCenter
        right => alignEnd
        justify => alignJustify
    }
}

const func colorOf(c option[color]) ComposeColor {
    return c == null ? unspecifiedColor : composeOf(c)
}

const func typeset(s ui.Style) bool {
    return s.color != null || s.fontSize != null || s.fontWeight != ui.FontWeight.unset || s.fontStyle != ui.FontStyle.unset || s.fontFamily != "" || s.textAlign != ui.TextAlign.unset
}

const func textStyle(s ui.Style) TextStyle {
    return !typeset(s) ? plainTextStyle : textStyleOf(
        color = colorOf(s.color),
        fontSize = fontSizeOf(s.fontSize),
        fontWeight = fontWeightOf(s.fontWeight),
        fontStyle = fontStyleOf(s.fontStyle),
        fontFamily = fontFamilyOf(s.fontFamily),
        textAlign = textAlignOf(s.textAlign),
    )
}

// Text's `softWrap`, `overflow` and `maxLines`. Each answers Text's own
// default where the Style leaves the field unset, which the call then leaves
// out. `nowrap` and `pre` keep a paragraph on its lines, and a clamped text
// ends in an ellipsis, as CSS's line clamp does.
const func softWrapOf(w ui.WhiteSpace) bool {
    return match w {
        nowrap, pre => false
        unset, normal, preWrap, preLine => wrapsLines
    }
}

const func clampOverflow(lines option[int]) => lines == null ? overflowClip : overflowEllipsis

const func linesOf(lines option[int]) => lines == null ? unboundedLines : lines

// A Material button is a stadium -- its shape token is CornerFull, which no
// theme changes -- unless the Style names its corners.
const func buttonShapeOf(s ui.Style) Shape {
    return s.borderRadius == null ? circleShape : roundedCorners(length(s.borderRadius))
}
