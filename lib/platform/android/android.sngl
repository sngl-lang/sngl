import ui "sngl:ui"
import time "sngl:time"
import . "sngl:macro"
import . "sngl:internal/marks"
import build "sngl:build"
import shapes "sngl:ui/draw"
import kt "sngl:language/kotlin"
import gen "sngl:x/gen"

// The `android` node of a build directive:
// `output { kotlin { android(main = true) } }`.
// Compose brackets a keyed lifetime itself: DisposableEffect is the same
// construct an `effect` declares, so the node arrives intact rather than as the
// calls passEffect would build. No reactiveCanvas -- the draw lambda reads
// Compose state directly, so a recomposition already redraws. `navigation`
// because sngl:ui/nav is a NavHost here (nav.go): each page a destination with
// a typed route, the back stack Compose's.
#[gen.can(effects, instanceState, navigation)]
#[gen.cannot(inlineComponents, structSpread)]
#[gen.wants(structComponents, stdlibContextParam, canvas)]
#[gen.name("android")]
#[gen.native("android")]
component platform(
    // Kotlin package / Android application ID.
    const package       string,
    // Display name used in AndroidManifest.xml.
    const appName       string,
    // Path to a launcher icon asset.
    const icon          string,
    // Emit a full Gradle project or just Compose sources.
    const main          bool,
    // Include Gradle wrapper + build scripts (default: true; set "false" to skip).
    const gradle        bool,
    // Theme accent color (hex).
    const color         string,
    // Absolute path to the project root. Set automatically by `sngl generate`; used to resolve relative asset paths.
    const projectDir    string,
    // Which Android runtime to test against under `sngl test`.
    //   "robolectric": JVM simulation, fast, no emulator (default).
    //   "device":      APK on a real emulator/device via adb.
    const testRunner    string,
    // Toolchain combo — a known-good set of Gradle/AGP/Kotlin/Compose/SDK
    // versions (see internal/androidtc). "stable" (default) or "next".
    const toolchain     string,
    // Override compileSdk / targetSdk (0 = combo default).
    const sdk           int,
    // Override minSdk (0 = default 26).
    const minSdk        int,
    // Override the Gradle distribution version (unset = combo default).
    const gradleVersion string,
    // What its generated code introduces beside a program's names. A component,
    // struct or enum is written as a Kotlin type named by capitalizing it, and
    // an explicit import outranks a declaration of the file's own package, so a
    // program's `modifier` would be shadowed by Compose's `Modifier`; and the
    // types and parameters the screen itself declares.
    const reservedNames list<string> = [
        "modifier",
        "alignment",
        "textStyle",
        "fontWeight",
        "textAlign",
        "dialog",
        "pullToRefreshBox",
        "composeColor",
        "toast",
        "localContext",
        "golib",
        "backHandler",
        "activity",
        "mainScreen",
        "mainScreenState",
        "errorEvent",
        "snglRaise",
        "color",
        "canvasStyle",
        "pathCmd",
        "state",
        "context",
        "slotContent",
    ],
) build.platform {
    gen.run(@run(dir, args) {
        install(dir)
    })
    gen.build(@build(dir, out) {
        buildApk(dir, out)
    })
}

// Builds the project in dir into a debug APK at out. The options are the
// node's, as the build had them.
#[intrinsic("android.buildApk", build)]
func buildApk(dir string, out string)

// Builds the project in dir, makes sure a device is attached -- starting an
// emulator where none is -- installs the APK, launches it and follows its log
// until it exits.
#[intrinsic("android.install", build)]
func install(dir string)

// --- The composables ---
//
// A composable is declared as what it is: `#[kt.native(name, import)]` on a
// bodyless component names the Compose function, and the import that reaches
// it. A program describes one the platform never heard of the same way, and
// these are written in no other form than that, so they are also the examples.
//
// A prop's name is the Compose argument it is emitted as, in declaration
// order. Five names are the emitter's own: `modifier` takes a Style and
// becomes the `Modifier` chain built from it, `chain` appends further Modifier
// calls verbatim after those, `args` is arguments spelled in Kotlin, for a
// value — `Alignment.CenterVertically`, a `MaterialTheme` shape — that SNGL
// has no way to write, and `colors` and `shape` take a Style rendered as the
// widget's own colour set and outline.
//
// A func-typed prop is a Compose lambda argument, and the override supplies
// the lambda: its body is emitted where the argument goes, so what the callback
// does is ordinary code in this file rather than a case in the codegen. A
// callback's parameters are the values Compose passes, and the override writes
// the prop the callback reports and hands the value on to the SNGL event:
// `func(on) { checked = on; change(on) }`. A callback Compose passes nothing to
// has no value to hand on, so the override names the value itself --
// `value = opt` in radio below.
//
// A **slot** is the other kind of lambda Compose takes: content rather than a
// callback. A named slot a call site populated is emitted as that argument,
// and one whose body renders nothing is left out — an absent argument and one
// given empty content are two different widgets.
//
// What this platform's codegen answers for itself rather than by a call --
// the screen, a nav link, a markup flow, the date field it ships -- is an
// `#[intrinsic("android:…")]`, namespaced by the platform so it can never
// collide with a stdlib intrinsic or with another platform's.

// The screen: what a `ui.window` is on android, which shows one. It is not
// a composable: MainScreen draws its content, and a program declares one
// window here, a second being refused where it is written.
//
// A hidden screen draws nothing. The system back at the root is the window's
// close, the counterpart of a window manager's: `onBack` runs -- the override
// reports `visible = false` before the window's own `@closed` -- and the
// activity finishes when no screen is drawn after it.
#[intrinsic("android:Screen")]
component Screen(
    visible  bool = true,
    onBack   func(),
    children ...component ui.node,
) root

#[gen.renders(identity)]
#[kt.native("Column", "androidx.compose.foundation.layout.Column")]
component Column(
    modifier ui.Style,
    chain    list<string>,
    children ...component,
) ui.node

#[gen.renders(identity)]
#[kt.native("Box", "androidx.compose.foundation.layout.Box")]
component Box(
    modifier ui.Style,
    chain    list<string>,
    children ...component,
) ui.node

#[gen.renders(identity)]
#[kt.native("Row", "androidx.compose.foundation.layout.Row")]
component Row(
    modifier ui.Style,
    chain    list<string>,
    args     list<string>,
    children ...component,
) ui.node

#[gen.renders(identity)]
#[kt.native("Spacer", "androidx.compose.foundation.layout.Spacer")]
component Spacer(
    modifier ui.Style,
    chain    list<string>,
) ui.node

#[gen.renders(identity)]
#[kt.native("Text", "androidx.compose.material3.Text")]
component Text(
    text     string,
    modifier ui.Style,
    // Typography, as Compose's own `style` argument: a TextStyle built from
    // the Style's font and colour fields.
    style    ui.Style,
    args     list<string>,
) ui.node

#[gen.renders(identity)]
#[kt.native("HorizontalDivider", "androidx.compose.material3.HorizontalDivider")]
component HorizontalDivider(
    modifier ui.Style,
) ui.node

#[gen.renders(identity)]
#[kt.native("CircularProgressIndicator", "androidx.compose.material3.CircularProgressIndicator")]
component CircularProgressIndicator(
    modifier ui.Style,
) ui.node

// Compose splits determinate from indeterminate by whether the `progress`
// argument is there at all, so the override writes the two calls rather than
// choosing a number for "unknown". It is a `() -> Float`, which is why the
// prop is a func returning `float32`: `float` is a Kotlin Double, and the
// declaration is what says otherwise.
#[gen.renders(identity)]
#[kt.native("LinearProgressIndicator", "androidx.compose.material3.LinearProgressIndicator")]
component LinearProgressIndicator(
    progress func() float32,
    modifier ui.Style,
) ui.node

// `colors` is the same Style the modifier gets. A Button paints its own
// surface, so a background in the modifier lands behind the pill rather than
// on it -- the colour has to go through the widget's own colour set.
#[gen.renders(identity)]
#[kt.native("Button", "androidx.compose.material3.Button")]
component Button(
    onClick  func(),
    modifier ui.Style,
    colors   ui.Style,
    shape    ui.Style,
    children ...component,
) ui.node

#[gen.renders(identity)]
#[kt.native("Badge", "androidx.compose.material3.Badge")]
component Badge(
    modifier ui.Style,
    children ...component,
) ui.node

#[gen.renders(identity)]
#[kt.native("Card", "androidx.compose.material3.Card")]
component Card(
    modifier ui.Style,
    children ...component,
) ui.node

#[gen.renders(identity)]
#[kt.native("TabRow", "androidx.compose.material3.TabRow")]
component TabRow(
    selectedTabIndex int,
    children         ...component,
) ui.node

// One tab of a TabRow; `text` is its label, which Compose takes as content.
#[gen.renders(identity)]
#[kt.native("Tab", "androidx.compose.material3.Tab")]
component Tab(
    selected bool,
    enabled  bool,
    onClick  func(),
    text     component ui.node,
) ui.node

#[gen.renders(identity)]
#[kt.native("Checkbox", "androidx.compose.material3.Checkbox")]
component Checkbox(
    checked         bool,
    onCheckedChange func(bool),
) ui.node

#[gen.renders(identity)]
#[kt.native("Switch", "androidx.compose.material3.Switch")]
component Switch(
    checked         bool,
    onCheckedChange func(bool),
) ui.node

#[gen.renders(identity)]
#[kt.native("RadioButton", "androidx.compose.material3.RadioButton")]
component RadioButton(
    selected bool,
    onClick  func(),
) ui.node

// `label` is the floating caption, and it is a slot rather than a prop
// because Compose takes content there, not text. An override that leaves it
// empty gets no `label` argument at all, which is not the same widget as one
// labelled with nothing.
#[gen.renders(identity)]
#[kt.native("OutlinedTextField", "androidx.compose.material3.OutlinedTextField")]
component OutlinedTextField(
    value         string,
    minLines      int,
    readOnly      bool,
    modifier      ui.Style,
    // Compose passes the new text.
    onValueChange func(value string),
    label         component ui.node,
) ui.node

// A field a date is typed into, with a button opening Material's date picker.
// It is Kotlin the platform ships with the app (codegen/platform/android/
// datefield.kt), since the half-typed text and whether the dialog is open are
// state its render reads, and a const override has nowhere to hold that.
// `onValueChange` is a date once one is typed or picked, or null when the
// field is cleared.
#[gen.renders(identity)]
#[intrinsic("android:SnglDateField")]
component SnglDateField(
    value         option<time.date>,
    label         string,
    enabled       bool,
    modifier      ui.Style,
    onValueChange func(value option<time.date>),
) ui.node

#[gen.renders(identity)]
#[kt.native("Dialog", "androidx.compose.ui.window.Dialog")]
component Dialog(
    onDismissRequest func(),
    children         ...component,
) ui.node

#[gen.renders(identity)]
#[kt.native("Surface", "androidx.compose.material3.Surface")]
component Surface(
    args     list<string>,
    children ...component,
) ui.node
