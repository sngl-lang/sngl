import ui "sngl:ui"
import markup "sngl:ui/markup"

// What a ui.Style becomes in a terminal: a lipgloss style for the box, the
// share of its parent's free space a `flex` child grows into, how a vbox or
// hbox places and spaces its children, and the cascade a flow of rich text
// starts from.

// A Style that writes nothing.
const blank ui.Style = {}

// What a Style may say that a terminal does not answer:
//
//   - minWidth: lipgloss sizes a block to a width or wraps it under a maximum,
//     and has no floor.
//   - flexDirection: vbox and hbox are the axis.
//   - justifyContent: not answered yet; the free space a `flex` child takes
//     is where it would come from.
//   - position, top, bottom, left, right, zIndex: a terminal lays text out in
//     one flow, and draws nothing over anything but a modal.
//   - fontSize, fontFamily: a terminal has one face in one size.
//   - whiteSpace: not answered yet; lipgloss keeps the newlines written and
//     wraps to a width, and `nowrap` would be its Inline.
//   - border, borderBottom, borderLeft, borderCollapse: CSS shorthand text and
//     table borders.
//   - cursor: a terminal shows no pointer.
//   - display: not answered yet; `none` is a node rendering nothing, which a
//     look cannot say.
//   - overflow: not answered yet; a maximum width or height already clips.
//   - listStyleType: no widget here draws a list marker.
const unstyled list[string] = [
    "minWidth",
    "flexDirection",
    "justifyContent",
    "position",
    "top",
    "bottom",
    "left",
    "right",
    "zIndex",
    "fontSize",
    "fontFamily",
    "whiteSpace",
    "border",
    "borderBottom",
    "borderLeft",
    "borderCollapse",
    "cursor",
    "display",
    "overflow",
    "listStyleType",
]

// A length in cells, as codegen.MeasurementPx reads one for this target: an
// em is 16px and a cell 8px wide, so an em is two cells. Anything visible is
// at least one, and an unset length none.
const func cellsOf(m option[ui.measurement]) int {
    var px = pxOf(m)
    return px <= 0.0 ? 0 : int.max(1, int(px) / 8)
}

const func pxOf(m option[ui.measurement]) => m == null ? 0.0 : m.px + 16.0 * (m.em + m.rem)

// A length down the screen, in rows: a cell is twice as tall as it is wide
// (tui.Picture draws two pixels to one), so a row is 16px. A 192px image was
// 24 rows around a picture of 12, and a column's 16px gap two blank lines.
const func rowsOf(m option[ui.measurement]) int {
    var px = pxOf(m)
    return px <= 0.0 ? 0 : int.max(1, int(px) / 16)
}

// One side of a margin or a padding: the first of its own field, its axis's
// and the whole box's that is set, as CSS reads them.
const func side(all option[ui.measurement], axis option[ui.measurement], own option[ui.measurement]) int {
    return cellsOf(own != null ? own : axis != null ? axis : all)
}

// The share of its parent's free space a `flex` child grows into; none where
// the Style names none.
const func growOf(flex option[float]) => flex == null ? 0.0 : flex

const func hue(c color) => hueOf(c.hex())

const func borderOf(s ui.Style) Border {
    return match s.borderStyle {
        double => doubleBorder()
        dashed, dotted => dashedBorder()
        else => s.borderRadius != null ? roundedBorder() : normalBorder()
    }
}

const func slanted(st ui.FontStyle) => st == ui.FontStyle.italic || st == ui.FontStyle.oblique

const func outlined(b ui.BorderStyle) => b == ui.BorderStyle.solid || b == ui.BorderStyle.dashed || b == ui.BorderStyle.dotted || b == ui.BorderStyle.double

const func alignOf(a ui.TextAlign) Position {
    return match a {
        center => posCenter
        right => posRight
        unset, left, justify => posLeft
    }
}

// The lipgloss style a Style asks for. A border is drawn where a width or a
// style says so, as CSS draws one for `border-style: solid` alone.
const func lookOf(s ui.Style) => boxLook(s, true)

// A flow's look leaves out what seedOf hands its words, which the box cannot
// apply to a string its runs have already reset partway along.
const func flowLookOf(s ui.Style) => boxLook(s, false)

const func boxLook(s ui.Style, words bool) Look {
    if s == blank {
        return newStyle()
    }
    var l = newStyle()
    if words && s.color != null {
        l = l.foreground(hue(s.color))
    }
    if s.background != null {
        l = l.background(hue(s.background))
    }
    if words && (s.fontWeight == ui.FontWeight.bold || s.fontWeight == ui.FontWeight.bolder) {
        l = l.bold(true)
    }
    if words && s.fontWeight == ui.FontWeight.lighter || s.opacity != null && s.opacity < 1.0 {
        l = l.faint(true)
    }
    if words && slanted(s.fontStyle) {
        l = l.italic(true)
    }
    if s.textAlign == ui.TextAlign.center || s.textAlign == ui.TextAlign.right {
        l = l.alignHorizontal(alignOf(s.textAlign))
    }
    if s.borderWidth != null || outlined(s.borderStyle) {
        l = l.border(borderOf(s))
        if s.borderColor != null {
            l = l.borderForeground(hue(s.borderColor))
        }
    }
    l = l.marginTop(side(s.margin, s.marginY, s.marginTop))
    l = l.marginRight(side(s.margin, s.marginX, s.marginRight))
    l = l.marginBottom(side(s.margin, s.marginY, s.marginBottom))
    l = l.marginLeft(side(s.margin, s.marginX, s.marginLeft))
    l = l.paddingTop(side(s.padding, s.paddingY, s.paddingTop))
    l = l.paddingRight(side(s.padding, s.paddingX, s.paddingRight))
    l = l.paddingBottom(side(s.padding, s.paddingY, s.paddingBottom))
    l = l.paddingLeft(side(s.padding, s.paddingX, s.paddingLeft))
    if s.width != null {
        l = l.width(cellsOf(s.width))
    }
    if s.height != null {
        l = l.height(rowsOf(s.height))
    }
    if s.maxWidth != null {
        l = l.maxWidth(cellsOf(s.maxWidth))
    }
    if s.maxHeight != null || s.maxLines != null {
        // maxLines counts the text, and lipgloss caps the box with its frame.
        l = l.maxHeight(lineCap(rowsOf(s.maxHeight), s.maxLines == null ? 0 : s.maxLines + l.verticalFrame()))
    }
    return l
}

const func lineCap(height int, lines int) int {
    return height == 0 ? lines : lines == 0 ? height : int.min(height, lines)
}

// Where a vbox's or an hbox's children sit across its axis, as the fraction
// a lipgloss.Position is: a number rather than the constants, so a literal
// Style folds to one.
const func crossOf(a ui.Alignment) float {
    return match a {
        center => 0.5
        end => 1.0
        unset, start, stretch, baseline => 0.0
    }
}

// What a flow's words start from: the fields of its Style a run of words carries.
const func seedOf(s ui.Style) markup.SpanStyle {
    return {
        color = s.color == null ? color{a=0} : s.color,
        fontWeight = match s.fontWeight {
            bold, bolder => markup.Weight.bold
            lighter => markup.Weight.lighter
            normal => markup.Weight.normal
            unset => markup.Weight.inherit
        },
        fontStyle = match s.fontStyle {
            italic, oblique => markup.Slant.italic
            normal => markup.Slant.normal
            unset => markup.Slant.inherit
        },
    }
}
