import ui "sngl:ui"
import time "sngl:time"
import markup "sngl:ui/markup"
import shapes "sngl:ui/draw"
import . "sngl:macro"
import . "sngl:internal/marks"
import build "sngl:build"
import go "sngl:language/go"
import gen "sngl:x/gen"

// The `bubbletea` node of a build directive: `output { go { bubbletea() } }`.
// focusOrder: a TUI draws its own widgets, so nothing else tracks which one has
// the keyboard. No reactiveCanvas: View() re-runs on every update and
// re-rasterizes with it, so an explicit redraw would be the second of two.
// viewMatches: View() is Go statements, so a match there is a switch.
// asyncPost: a closure posted back to the loop is a message Update runs.
#[gen.can(viewMatches, asyncPost)]
#[gen.cannot(inlineComponents, implicitRecv, structSpread)]
#[gen.wants(structComponents, stdlibContextParam, focusOrder, canvas)]
#[gen.name("bubbletea")]
#[gen.native("bubbletea")]
component platform(
    // Go package name for the generated files.
    const package       string,
    // Emit a standalone main() or a library-style module.
    const main          bool,
    // Emit companion test files (default: true; set "false" to skip).
    const tests         bool,
    // What its generated code introduces beside a program's names: the packages
    // it imports, the Model's own fields and the getters and setters a var
    // named `view`, `update`, `init` or `terminalSize` would collide with, and
    // the locals Update and View declare around the handler and view code they
    // hold.
    const reservedNames list[string] = [
        "tea",
        "lipgloss",
        "textinput",
        "tui",
        "snglcanvas",
        "image",
        "width",
        "height",
        "toasts",
        "view",
        "update",
        "init",
        "terminalSize",
        "resizeWidgets",
        "snglToast",
        "toastDismissMsg",
        "msg",
        "cmd",
        "cmds",
        "overlayOpen",
        "content",
        "parts",
        "v",
        "t",
        "bg",
        "toastStyle",
        "slotContent",
    ],
) build.platform

// --- Blueprint vocabulary ---
//
// Blueprint records describe how a stdlib component renders through one of the
// three inlined platform primitives (Layout, Styled, Widget). The Go extractor
// in blueprint.go reads these off the inlined NodeInst.

enum JoinDir { vertical, horizontal }

struct Model {
    type   string
    new    string
    view   string
    update string
    init   string
    pkg    string
    // resize is an optional method-chain template applied to the widget field
    // whenever the terminal size changes (e.g. ".SetWidth($\{w\})" or
    // ".SetSize($\{w\}, $\{h\})"). It is emitted as `m.<field><resize>` from a
    // generated resizeWidgets() helper, which the WindowSizeMsg case and
    // SetTerminalSize both call. The $\{w\}/$\{h\} tokens resolve to the inset,
    // clamped terminal width/height (see tui.WidgetWidth/WidgetHeight). Empty
    // means the widget has no size (e.g. spinner).
    resize string
}

struct Focus {
    enabled bool
}

struct Bind {
    prop string
    get  string
    set  string
}

struct Event {
    on  string
    key string
}

// --- The primitives ---
//
// Every body below renders through exactly one of these. Their props are the
// blueprint: extractBlueprint reads them off the inlined NodeInst by the names
// declared here, so a rename here is a rename in blueprint.go.
//
// #[intrinsic] is what says these are the primitives rather than wrappers over
// one: they carry no body, and the id is what the view renderer recognizes them
// by instead of their names.

#[gen.renders(identity)]
#[intrinsic("bubbletea:Layout")]
component Layout(
    const join JoinDir,
    look       Look,
    grow       float,
    // Where the children sit across the axis, as a lipgloss.Position.
    align      float,
    spacing    int,
    // Body text revealed, dim, under the focused trigger this Layout wraps.
    tooltip    string,
    // Draws nothing, where its children are still rendered: what they hold
    // and the lifetimes they bracket outlive its being hidden.
    hidden     bool,
    children   ...component,
) ui.node

#[gen.renders(identity)]
#[intrinsic("bubbletea:Styled")]
component Styled(
    content      string,
    focus        Focus,
    const events list[Event],
    look         Look,
    grow         float,
    // Fired by the key an `events` record maps "change" to. A key press
    // carries nothing, so the override says here what the press reports.
    @change,
    // Fired by the key an `events` record maps "click" to, for a Styled an
    // override writes beneath its root, which a call site's `@click` does
    // not land on.
    @click(),
) ui.node

#[gen.renders(identity)]
#[intrinsic("bubbletea:Widget")]
component Widget(
    const model Model,
    focus       Focus,
    const binds list[Bind],
    placeholder string,
    look        Look,
    grow        float,

    // Operands for the `$\{name\}` tokens in this widget's Model strings. A
    // token names one of these props, so the set grows with the templates
    // rather than with the widget count.
    options list[string],
    items   list[string],
    columns list[string],
    rows    list[list[string]],
    value   float,
    max     float,
) ui.node

#[gen.renders(identity)]
#[intrinsic("bubbletea:Overlay")]
component Overlay(
    placement string,
    dim       bool,
    look      Look,
    children  ...component,
) ui.node

// --- The window ---

// The screen: what a `ui.window` is on a terminal, which shows one. The
// package body holds it, and View draws its content; a program declares one
// window here, and a second is refused where it is written.
//
// A hidden screen draws nothing, and what it holds stays: its timers tick and
// its effects stay mounted, since hiding a window is not destroying it.
//
// ctrl+c is the window's close, the terminal's counterpart of a window
// manager's: it fires `@closed`, which the override reports as
// `visible = false` before the window's own handler runs, and the program
// ends when no screen is drawn after it.
//
// A screen given a `canGoBack` draws its title on a line over the content,
// `‹` before it while it can go back, and esc runs `@back` then. One given
// none -- the literal `false` a window's default is -- draws no line. A
// terminal has no place for a window's menu, so a screen draws none.
#[intrinsic("bubbletea:Screen")]
component Screen(
    visible   bool = true,
    title     string = "",
    canGoBack bool = false,
    @closed(),
    @back(),
    content   ...component ui.node,
) root

// The window's `@error` is the outermost boundary of what it renders, and
// catches whether or not the call site handles one.
const component ui.window[platform](title, visible, canGoBack, @error, @closed, @back, content) {
    Screen(visible=visible, title=title, canGoBack=canGoBack, @back { back() }, @closed {
        visible = false
        closed()
    }) {
        boundary(@error(e) { error(e) }) {
            content
        }
    }
}

// --- Core Layout ---

const component ui.vbox[platform](style, children) {
    Layout(join=JoinDir.vertical, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=rowsOf(style.gap), hidden=style.display == ui.Display.none) {
        children
    }
}

const component ui.hbox[platform](style, children) {
    Layout(join=JoinDir.horizontal, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=cellsOf(style.gap), hidden=style.display == ui.Display.none) {
        children
    }
}

const component ui.stack[platform](style, layers) {
    Layout(join=JoinDir.vertical, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=rowsOf(style.gap)) {
        layers
    }
}

const component ui.spacer[platform](style) {
    Styled(content="", look=lookOf(style), grow=style.flex) {}
}

const component ui.scroll[platform](style, content) {
    Layout(join=JoinDir.vertical, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=rowsOf(style.gap)) {
        content
    }
}

// --- Core Text & Media ---

const component ui.text[platform](value, style) {
    Styled(content=value, look=lookOf(style), grow=style.flex) {}
}

const component ui.button[platform](text, style) {
    Styled(
        content = text,
        focus = Focus{enabled=true},
        events = [Event{on="click", key="enter"}],
        look = lookOf(style),
        grow = style.flex,
    ) {}
}

// An image is a box holding the source it shows, or the placeholder where it
// holds none. A drawing is a canvas, as one is anywhere in a terminal; a
// picture a URL names is drawn in half-block cells fitted into a box of
// `Picture`'s choosing, since a terminal has no size a pixel has.
const component ui.image[platform](style, src) {
    Layout(join=JoinDir.vertical, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=rowsOf(style.gap)) {
        #[family.crosses]
        src
    }
}

#[intrinsic("bubbletea:Picture")]
component Picture(url string) ui.imageSource

#[intrinsic("bubbletea:ImageDrawing")]
component ImageDrawing(width float, height float, shapes ...component shapes.shape) ui.imageSource

const component ui.file[platform](path) {
    Picture(url=path)
}

const component ui.remote[platform](url) {
    Picture(url=url)
}

const component shapes.image[platform](width, height, shapes) {
    ImageDrawing(width=width, height=height) {
        shapes
    }
}

const component ui.input[platform](placeholder, style) {
    Widget(
        model = Model{
            type = "textinput.Model",
            new = "textinput.New()",
            view = ".View()",
            update = ".Update(msg)",
            init = "textinput.Blink",
            pkg = "charm.land/bubbles/v2/textinput",
            resize = ".SetWidth($\{w\})",
        },
        focus = Focus{enabled=true},
        binds = [Bind{prop="value", get=".Value()", set=".SetValue"}],
        placeholder = placeholder,
        look = lookOf(style),
        grow = style.flex,
    ) {}
}

const component ui.checkbox[platform](label, checked, style, @change) {
    Styled(
        content = label,
        focus = Focus{enabled=true},
        events = [Event{on="change", key="space"}],
        look = lookOf(style),
        grow = style.flex,
        @change {
            checked = !checked
            change(checked)
        },
    ) {}
}

// --- Tier 1: Core Input ---

const component ui.radio[platform](style) {
    Layout(join=JoinDir.vertical, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=rowsOf(style.gap)) {
    }
}

const component ui.toggle[platform](label, checked, style, @change) {
    Styled(
        content = label,
        focus = Focus{enabled=true},
        events = [Event{on="change", key="space"}],
        look = lookOf(style),
        grow = style.flex,
        @change {
            checked = !checked
            change(checked)
        },
    ) {}
}

// A select is tui.Select: a list whose cursor is the choice, holding the
// value even before a choice carries it. Its choices are handed to every
// view and update, since they are the program's and may arrive after it
// starts.
const component ui.select[platform](style, options) {
    Widget(
        model = Model{
            type = "tui.Select",
            new = "tui.NewSelect(40, 10)",
            view = ".View($\{options\})",
            update = ".Update(msg, $\{options\})",
            resize = ".SetSize($\{w\}, $\{h\})",
        },
        focus = Focus{enabled=true},
        binds = [Bind{prop="value", get=".Value()", set=".SetValue"}],
        options = options.map(func(o) => o.label),
        look = lookOf(style),
        grow = style.flex,
    ) {}
}

const component ui.textarea[platform](style) {
    Widget(
        model = Model{
            type = "textarea.Model",
            new = "textarea.New()",
            view = ".View()",
            update = ".Update(msg)",
            pkg = "charm.land/bubbles/v2/textarea",
            resize = ".SetWidth($\{w\})",
        },
        focus = Focus{enabled=true},
        binds = [Bind{prop="value", get=".Value()", set=".SetValue"}],
        look = lookOf(style),
        grow = style.flex,
    ) {}
}

// A date is typed, as YYYY-MM-DD, into tui.DateInput: a text field read as
// the *time.Time an option[date] is in Go, nil until what is typed is a date.
const component ui.datepicker[platform](placeholder, style) {
    Widget(
        model = Model{
            type = "tui.DateInput",
            new = "tui.NewDateInput()",
            view = ".View()",
            update = ".Update(msg)",
            init = "textinput.Blink",
            pkg = "charm.land/bubbles/v2/textinput",
            resize = ".SetWidth($\{w\})",
        },
        focus = Focus{enabled=true},
        binds = [Bind{prop="value", get=".Date()", set=".SetDate"}],
        placeholder = placeholder,
        look = lookOf(style),
        grow = style.flex,
    ) {}
}

// --- Tier 2: Feedback & Navigation ---

// bubbles' progress is a fraction and has no indeterminate mode, so a bar
// given no value is an empty one; `spinner` is the widget that says "working"
// here. Written as two calls rather than one carrying a ternary: Go has no
// conditional expression, so a ternary is lowered to a temporary, and that
// happens before the fold that would have settled it -- leaving `${value}` to
// interpolate a name the blueprint extractor cannot read a number off.
const component ui.progress[platform](style, value, max) {
    if value != null {
        Widget(
            model = Model{
                type = "progress.Model",
                new = "progress.New()",
                view = ".ViewAs(tui.Percent(float64($\{value\}), float64($\{max\})))",
                pkg = "charm.land/bubbles/v2/progress",
                resize = ".SetWidth($\{w\})",
            },
            value = value,
            max = max,
            look = lookOf(style),
            grow = style.flex,
        ) {}
    } else {
        Widget(
            model = Model{
                type = "progress.Model",
                new = "progress.New()",
                view = ".ViewAs(tui.Percent(float64($\{value\}), float64($\{max\})))",
                pkg = "charm.land/bubbles/v2/progress",
                resize = ".SetWidth($\{w\})",
            },
            value = 0.0,
            max = max,
            look = lookOf(style),
            grow = style.flex,
        ) {}
    }
}

const component ui.spinner[platform](style) {
    Widget(
        model = Model{
            type = "spinner.Model",
            new = "spinner.New()",
            view = ".View()",
            update = ".Update(msg)",
            init = "$\{self\}.Tick",
            pkg = "charm.land/bubbles/v2/spinner",
        },
        look = lookOf(style),
        grow = style.flex,
    ) {}
}

const component ui.divider[platform](style) {
    Styled(content="─", look=lookOf(style), grow=style.flex) {}
}

// A terminal focuses controls rather than regions, so a clickable card is its
// content beside a `›` that takes the focus and fires `@click` on enter, as a
// button's label does.
const component ui.card[platform](style, clickable, @click, content) {
    Layout(join=JoinDir.horizontal, look=lookOf(style), grow=style.flex) {
        if clickable {
            Styled(
                content = "› ",
                focus = Focus{enabled=true},
                events = [Event{on="click", key="enter"}],
                @click { click() },
            ) {}
        }
        Layout(join=JoinDir.vertical, align=crossOf(style.alignItems), spacing=rowsOf(style.gap)) {
            content
        }
    }
}

const component ui.chip[platform](label, style) {
    Styled(
        content = label,
        focus = Focus{enabled=true},
        events = [Event{on="click", key="enter"}],
        look = lookOf(style),
        grow = style.flex,
    ) {}
}

const component ui.link[platform](text, style) {
    Styled(content=text, look=lookOf(style), grow=style.flex) {}
}

const component ui.modal[platform](style, open, content) {
    if open {
        Overlay(placement="center", dim=true, look=lookOf(style)) {
            content
        }
    }
}

const component ui.drawer[platform](style, open, side, content) {
    if open {
        Overlay(placement=side, dim=true, look=lookOf(style)) {
            content
        }
    }
}

const component ui.tooltip[platform](style, text, trigger) {
    // Render the trigger child, then reveal `text` (dim, below) only while
    // the wrapped trigger is focused. The `tooltip` prop carries the body
    // text to the Layout renderer, which appends it gated on the focusable
    // descendant's focus expression (see renderBlueprint in view_ir.go).
    Layout(join=JoinDir.vertical, tooltip=text, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=rowsOf(style.gap)) {
        trigger
    }
}

const component ui.popover[platform](style, content) {
    Layout(join=JoinDir.vertical, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=rowsOf(style.gap)) {
        content
    }
}

const component ui.splitview[platform](style, panes) {
    Layout(join=JoinDir.horizontal, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=cellsOf(style.gap)) {
        panes
    }
}

// The headings and rows are handed to the table on each view and update, as a
// select's choices are: rows a request answers arrive after it is built.
const component ui.table[platform](style, columns, rows) {
    Widget(
        model = Model{
            type = "tui.Table",
            new = "tui.NewTable(10)",
            view = ".View($\{columns\}, $\{rows\})",
            update = ".Update(msg, $\{columns\}, $\{rows\})",
            resize = ".SetWidth($\{w\})",
        },
        focus = Focus{enabled=true},
        binds = [Bind{prop="selected", get=".Cursor()"}],
        columns = columns,
        rows = rows.map(func(r) => r.cells),
        look = lookOf(style),
        grow = style.flex,
    ) {}
}

// A tree's labels in traversal order, each node's below it. bubbles' list
// reports its selection as the item's text, which is what `selected` holds, so
// a label is not indented: the depth would be read back as part of it.
const func _treeLabels(items list[ui.treeItem]) list[string] {
    var out list[string] = []
    for var it = items {
        out = [...out, it.label, ..._treeLabels(it.children)]
    }
    return out
}

const component ui.tree[platform](style, items) {
    Widget(
        model = Model{
            type = "list.Model",
            new = "tui.NewList(tui.StringItems($\{items\}), 40, 10)",
            view = ".View()",
            update = ".Update(msg)",
            pkg = "charm.land/bubbles/v2/list",
            resize = ".SetSize($\{w\}, $\{h\})",
        },
        focus = Focus{enabled=true},
        binds = [Bind{prop="selected", get="tui.SelectedString"}],
        items = _treeLabels(items),
        look = lookOf(style),
        grow = style.flex,
    ) {}
}

const component ui.menu[platform](style, open, items) {
    if open {
        // menu surfaces selection via @select only — its stdlib signature
        // has no `selected` prop, so there's no two-way selection var to
        // bind. (Read-back would be inert: findBidiProp finds nothing.)
        Widget(
            model = Model{
                type = "list.Model",
                new = "tui.NewList(tui.StringItems($\{items\}), 40, 10)",
                view = ".View()",
                update = ".Update(msg)",
                pkg = "charm.land/bubbles/v2/list",
                resize = ".SetSize($\{w\}, $\{h\})",
            },
            focus = Focus{enabled=true},
            items = items.map(func(it) => it.label),
            look = lookOf(style),
            grow = style.flex,
        ) {}
    }
}

const component ui.menubar[platform](style) {
    Layout(join=JoinDir.horizontal, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=cellsOf(style.gap)) {
    }
}

const component ui.toolbar[platform](style, controls) {
    Layout(join=JoinDir.horizontal, look=lookOf(style), grow=style.flex, align=crossOf(style.alignItems), spacing=cellsOf(style.gap)) {
        controls
    }
}

// A recurring deadline. Not a blueprint primitive: a timer renders nothing, so
// it carries no Kind and never reaches the view. compiler_ir.go collects it and
// emits the tea.Tick / Msg pair the Elm architecture schedules with.
//
// html, fyne and gtk4 all schedule with an `effect` over a start/stop pair of
// host natives instead, and this platform cannot: an effect's `@mount` hands
// over a *closure*, and in Elm nothing outside Update may touch the model. The
// closure would capture whichever local it was settled on -- New's, which is
// copied out on return -- so the emitted program arms its ticker, increments a
// field of an orphaned copy, and renders the same screen forever. Tried and
// measured rather than assumed: the model still read 0 after three ticks, and
// Init returned nil because nothing in the effect lowering is a schedule the
// emitter can describe.
//
// What Init needs back is a command, and a command needs the period and a body
// Update can run against its own live Model -- which is exactly what ir.Timer
// carries and what a closure cannot supply. Emitting a *Model receiver would
// not rescue it either: it turns the silent no-op into a data race with the
// Update goroutine, which is the rule the architecture exists to enforce.
//
// The gate is a prop rather than the position the node is written at, because
// arming happens in Init and Update, outside the view the position describes.
#[intrinsic("bubbletea:Timer")]
component Timer[F any](
    interval time.duration,
    enabled  bool,
    @tick,
) F

const component time.timer[platform](interval, enabled, @tick) {
    Timer(interval=interval, enabled=enabled, @tick { tick() }) {}
}

// --- Rich text ---
//
// The span family, implemented the way every other family here is: two
// primitives and a table of overrides. lipgloss has no inheritance -- a style
// is applied to a string and the result is a string -- so the cascade an
// author wrote is resolved in the emitter, one leaf at a time, and each run of
// words is rendered exactly once with the style it ends up with. Rendering a
// joined flow a second time would not work even if it were tidier: the inner
// runs have left their reset sequences in the string, and an outer color would
// stop at the first of them.
//
// A terminal has one face and one size, so `fontFamily` and `fontSize` say
// nothing here -- which is also why `monospace` needs no override of its own:
// the `run` the stdlib body wraps it in already reaches `Span`, and its
// `fontFamily` is a field the emitter has nothing to do with.

// A flow of spans, as a node. `richText` cannot insert its own content -- the
// component is a `ui.node` and its slot is the span family -- so something has
// to join the widget family and host the span one.
//
// `role` is not taken. A terminal has the styling and none of the semantics,
// which `markup.Role`'s own documentation says; what a heading looks like
// arrives in its look and seed, and that is the whole of what this target can show.
#[intrinsic("bubbletea:Flow")]
component Flow(
    look    Look,
    // What its words start from: the fields of its Style a run carries.
    seed    markup.SpanStyle,
    grow    float,
    content ...component markup.span,
) ui.node

// One run of words. `text` is the literal a leaf carries, `spanStyle` what
// this run says about its own appearance, and `kind` what a `token` says it
// is -- read by the emitter, which maps it to one of the terminal's own
// sixteen colors rather than to a value a document chose. `color` is what a
// palette the program set says instead, and wins where it says anything.
#[intrinsic("bubbletea:Span")]
component Span(
    text      string,
    spanStyle markup.SpanStyle,
    kind      markup.Token,
    color     color,
    content   ...component markup.span,
) markup.span

const component markup.richText[platform](style, content) {
    Flow(look=flowLookOf(style), seed=seedOf(style), grow=style.flex) {
        content
    }
}

const component markup.text[platform](value) {
    Span(text=value) {}
}

const component markup.run[platform](style, content) {
    Span(spanStyle=style) {
        content
    }
}

// A terminal cannot follow a link, so the URL is dropped and the words are
// underlined -- which is how a link reads in one, and is the same trade
// `ui.link` above already makes. Written as a style rather than as a prop the
// emitter reads, because the family's own vocabulary already says it.
const component markup.link[platform](content) {
    Span(spanStyle={underline=true}) {
        content
    }
}

const component markup.token[platform](kind, content) {
    Span(kind=kind, color=markup.tokenColor(markup.palette, kind)) {
        content
    }
}

// Nothing here can draw, so the description is what an image is: the words
// between the brackets, in brackets, which is the form `ui.image` renders its
// own placeholder in.
const component markup.image[platform](alt) {
    Span(text="[{alt}]") {}
}

// --- lipgloss ---
//
// What style.sngl builds a ui.Style's look from. Each is a value method: a
// lipgloss style is copied on every call, so a chain is a value like any other.

const _lipgloss = "charm.land/lipgloss/v2"

const _tui = "duckfam.us/sngl/pkg/go/tui"

#[go.native(_lipgloss, "lipgloss.Style")]
struct Look {}

#[go.native("image/color", "color.Color")]
struct Hue {}

#[go.native(_lipgloss, "lipgloss.Border")]
struct Border {}

#[go.native(_lipgloss, "lipgloss.Position")]
