import ui "sngl:ui"
import time "sngl:time"
import js "sngl:language/js"
import . "sngl:macro"
import . "sngl:internal/marks"
import build "sngl:build"
import shapes "sngl:ui/draw"
import markup "sngl:ui/markup"
import math "sngl:math"
import gen "sngl:x/gen"
import nav "sngl:ui/nav"
import family "sngl:family"

// Serves dir over HTTP at listen, ":0" when empty, printing the address, until
// the process is stopped. What `sngl run` does with a site. Declared above the
// node whose command calls it, which is where library source resolves it.
#[intrinsic("html.serve", build)]
func serve(dir string, listen string)

// The `html` node of a build directive: `output { none { html() } }`. Its props
// are the build options this platform accepts.
// Both modes write the tree as markup -- static mode to a file, route mode into
// a handler -- so a view body is never host-language statements.
//
// A platform has the last word, and html renders HTML and JS: the language emits
// route mode's server half, not the markup or the script. So a restriction that
// exists because Go lacks a construct does not apply to what html itself writes --
// a ternary in a class attribute, a `.filter` in a server action, a blocking call
// in a handler that already runs on its own goroutine. The goroutine itself is
// withdrawn again: what html spawns work onto is the browser, which has none. And
// a DOM parent can put a child at a position, so a keyed run moves one child
// rather than rebuilding from the first change.
#[gen.can(ternary, listLambdas, asyncCalls, insertBefore, inlineSlots, instanceState, navigation, genericComponents)]
#[gen.cannot(
    viewStatements,
    asyncSpawn,
    asyncReactive,
    implicitRecv,
    inlineComponents,
    reactivity,
    structSpread,
)]
#[gen.wants(structComponents, stdlibContextParam, canvas, reactiveCanvas, navigationHrefs)]
#[gen.name("html")]
#[gen.native("html")]
component platform(
    // Render in preview mode (iframe-friendly; stable element IDs for live reload).
    const preview       bool,
    // Emit a test harness instead of the normal app bundle.
    const test          bool,
    // Relative path to a CSS file included in every page.
    const stylesheet    string,
    // Absolute path to the project root. Set automatically by `sngl generate`; used to resolve relative asset paths.
    const projectDir    string,
    // Route mode: target Go package name (default "ui", or "main" when main=true).
    const package       string,
    // Route mode: emit a main() that calls ListenAndServe.
    const main          bool,
    // Route mode: HTTP framework (default "net/http").
    const framework     string,
    // Route mode: host:port for `sngl run` to listen on.
    const listen        string,
    // Minify emitted HTML and inline JS via esbuild.
    const minify        bool,
    // Disable content-hash filenames for emitted assets; produce stable paths.
    const noCacheBust   bool,
    // Its page script is JavaScript whatever the language, so it reserves
    // JavaScript's words, and beside them what the script introduces: the
    // `state` object a page's vars live in, a factory's `props`, the `String`
    // it redefines, and the browser globals it calls.
    const reservedNames list[string] = [
        ...js.words,
        "state",
        "props",
        "String",
        "document",
        "window",
        "globalThis",
        "Object",
        "Array",
        "Map",
        "Set",
        "Number",
        "Math",
        "JSON",
        "Event",
        "Error",
        "Promise",
        "Date",
        "Intl",
        "location",
        "history",
        "console",
        "parseInt",
        "parseFloat",
        "decodeURIComponent",
        "encodeURIComponent",
        "setTimeout",
        "clearTimeout",
        "setInterval",
        "clearInterval",
        "requestAnimationFrame",
    ],
) build.platform {
    gen.run(@run(dir, args) {
        serve(dir, listen)
    })
}

// The browser's Event, as an element's handler is handed it. A handler on an
// element is handed the DOM's own event, and an override reads what it reports
// off it: `@change(e) { checked = e.currentTarget.checked }`. Only what an
// override reads is declared; the DOM has more.
#[js.native("Event")]
struct Event {
    // The element the handler was attached to.
    currentTarget Target
}

// The element an event was dispatched to, as far as a control reports its
// state through it: the text of an input, a textarea or a select, and whether
// a checkbox is checked.
#[js.native("HTMLInputElement")]
struct Target {
    value   string
    checked bool
}

// The element every tag resolves to. The web's element set is open — a new
// standard adds to it, and a custom element is a tag nobody declared — so one
// declaration answers to every tag name rather than one per tag existing.
//
// The typed props are the attributes whose value is not a string; everything
// else is one, which is what the wildcard prop says. A tag-specific numeric
// attribute missing from this list is accepted as a string rather than
// rejected.
// Lowercase, so a typo inside a `platform html { ... }` body -- where a bare
// name reaches this wildcard -- is reported rather than emitted as an element
// nobody has heard of.
//
// This rejects SVG, whose vocabulary is camelCase inside foreign content
// (`linearGradient`, `clipPath`, `feGaussianBlur`). Reaching it by widening the
// pattern would cost the misspelling check for every HTML tag, so SVG is left
// for a family of its own -- `component svg build.family` names a family of
// nodes and a slot says which host accepts them, which is what an SVG subtree
// is. Until then it
// is written through `element(tag=..., attrs={...})`, which the diagnostics
// below point at.
// A DOM element is still there while the page runs, so a `#id` on one names
// something a read can ask. That the emitter has no way to ask it yet is a
// separate defect; claiming otherwise here would have a prop read answered
// with the value the markup was written with.
#[gen.renders(identity)]
#[wildcard("[a-z][a-z0-9]*", "tag")]
component element(
    // The name this resolved from — `html.div` binds "div" — and the tag to
    // emit. Writing it is how a hyphenated custom element is reached, an
    // identifier holding no hyphen: `html.element(tag="my-widget")`. It names
    // the element rather than describing it, so it is never an attribute.
    #[construct] tag string,

    style       ui.Style,
    class       string,
    id          string,
    textContent string,
    innerText   string,
    innerHTML   string,

    disabled bool,
    checked  bool,
    readonly bool,
    selected bool,
    hidden   bool,
    open     bool,

    // An attribute is written as it is emitted, so a caller holding a number
    // converts: `component ui.progress` spells string(value). These were
    // declared `int` and so were written by two paths that disagreed -- the
    // static render rendered the literal and the server render had no string to
    // write, because there is no attribute type here to convert through.
    rows   string,
    width  string,
    height string,
    value  string,
    max    string,

    // Every other attribute, keyed by the name it was written under -- an
    // attribute a standard adds after this file was written among them.
    //
    // A hyphenated name (`data-*`, `aria-*`) does not reach the pattern at all:
    // it is not an identifier, so it can only be written as a key of this map,
    // and a key is taken as given. The pattern governs the names written as
    // props, and is lowercase for the reason the tag pattern is: a camelCase
    // name there is a DOM property or a misspelling of one, and the properties
    // an element takes are declared above.
    #[wildcard("[a-z][a-z0-9]*")]
    attrs map[string, string],

    @click(),
    @input(e Event),
    @change(e Event),
    @focus(),
    @blur(),
    @submit(),
    @scroll(),
    @load(),
    @error(e error),
    @close(),
    @select(),

    // Every other DOM event. The event set is as open as the element set and
    // the attribute set, for the same reason: a standard adds to it. The
    // events above are declared for what a handler is handed, not as the
    // whole list, so one that hands nothing SNGL can name reaches a handler
    // here.
    //
    // Void, because what this cannot name a handler cannot read; an event
    // whose argument matters is declared above.
    //
    // Lowercase, because these are DOM event types and that is how the DOM
    // spells them. A stdlib component's SNGL name for an event -- `@scrollEnd`
    // -- is mapped to the DOM one by the override that wraps it, which is what
    // wrapping an element in SNGL is for. Accepting the SNGL spelling here
    // instead would emit `addEventListener("scrollEnd")`, an event nothing
    // fires.
    #[wildcard("[a-z][a-z0-9]*")]
    @event,
    children ...component,
) ui.node {}

// --- Core Layout ---

const component ui.vbox[platform](style, children) {
    html.div(style={...style, display=flex, flexDirection=column}) {
        children
    }
}

const component ui.hbox[platform](style, children) {
    html.div(style={...style, display=flex, flexDirection=row}) {
        children
    }
}

const component ui.stack[platform](style, layers) {
    html.div(style={...style, position=relative}) {
        layers
    }
}

const component ui.spacer[platform](style) {
    html.div(style={...style, flex=1}) {}
}

// `@scrollEnd` is the standard library's name for the event the DOM calls
// `scrollend`. The names differ, so the override maps them: that is the half of
// wrapping an element that a wildcard cannot do for itself.
const component ui.scroll[platform](style, @scroll, @scrollEnd, content) {
    html.div(style={...style, overflow=auto}, @scroll { scroll() }, @scrollend { scrollEnd() }) {
        content
    }
}

// --- Core Text & Media ---

const component ui.text[platform](value, style) {
    html.span(textContent=value, style={...style}) {}
}

// `@longPress` maps to `contextmenu`, which is what a sustained touch press
// fires -- and a right-click, which is not the same gesture. It stands in until
// html synthesizes the real one from pointerdown and a timer; the alternative
// was a declared event that reached nothing.
const component ui.button[platform](text, disabled, style, @click, @longPress, content) {
    html.button(disabled=disabled, style={...style}, @click { click() }, @contextmenu { longPress() }) {
        html.span(textContent=text) {}
        content
    }
}

// An image is a frame around the `<img>` its source renders: the frame carries
// the style, the click and the description, as an `img` role, so the
// placeholder stands in the same box where there is no source. The page's
// rules fill the frame with the picture and fit it by the frame's class.
const component ui.image[platform](alt, fit, style, @click, src, placeholder) {
    html.span(
        class = "sngl-image sngl-image-" + string(fit),
        attrs = {"role"="img", "aria-label"=alt},
        style = {display=inlineBlock, overflow=hidden, ...style},
        @click { click() },
    ) {
        #[family.crosses]
        src {
            placeholder
        }
    }
}

// Where an image's pixels come from, each an `<img>` in the image's frame: a
// URL the browser fetches, which is what a `file:` asset's path is too, or a
// drawing painted in the page and handed over as a data URL. In a window's
// favicon either is the page's `<link rel="icon">`.
#[intrinsic("html:imageUrl")]
component ImageUrl(url string) ui.imageSource

#[intrinsic("html:imageDrawing")]
component ImageDrawing(width float, height float, shapes ...component shapes.shape) ui.imageSource

const component ui.file[platform](path) {
    ImageUrl(url=path)
}

const component ui.remote[platform](url) {
    ImageUrl(url=url)
}

const component shapes.image[platform](width, height, shapes) {
    ImageDrawing(width=width, height=height) {
        shapes
    }
}

const component ui.input[platform](placeholder, readonly, value, disabled, type, style, @input, @change) {
    html.input(
        type = string(type),
        placeholder = placeholder,
        value = value,
        disabled = disabled,
        readonly = readonly,
        style = {...style},
        @input(e) {
            value = e.currentTarget.value
            input(value)
        },
        @change(e) {
            value = e.currentTarget.value
            change(value)
        },
    ) {}
}

const component ui.checkbox[platform](label, checked, disabled, style, @change) {
    html.label(style={display=inlineFlex, alignItems=center, gap=4px, ...style}) {
        html.input(type="checkbox", checked=checked, disabled=disabled, @change(e) {
            checked = e.currentTarget.checked
            change(checked)
        }) {}
        html.span(textContent=label) {}
    }
}

// --- Tier 1: Core Input ---

const component ui.radio[platform](value, disabled, direction, style, @change, options) {
    html.fieldset(style={display=flex, flexDirection=(direction == ui.Orientation.horizontal ? row : column), gap=8px, border="none", padding=0, ...style}) {
        for var opt = options {
            html.label(style={display=inlineFlex, alignItems=center, gap=4px}) {
                html.input(type="radio", value=opt.label, checked=(opt.label == value), disabled=disabled, @change {
                    value = opt.label
                    change(opt.label)
                })
                html.span(textContent=opt.label)
            }
        }
    }
}

const component ui.toggle[platform](label, checked, disabled, style, @change) {
    html.label(style={display=inlineFlex, alignItems=center, gap=8px, ...style}) {
        html.input(type="checkbox", role="switch", checked=checked, disabled=disabled, @change(e) {
            checked = e.currentTarget.checked
            change(checked)
        }) {}
        html.span(textContent=label) {}
    }
}

const component ui.select[platform](placeholder, value, disabled, style, @change, options) {
    html.select(disabled=disabled, style={...style}, @change(e) {
        value = e.currentTarget.value
        change(value)
    }) {
        if placeholder != "" {
            html.option(value="", disabled=true, selected=true, textContent=placeholder)
        }
        for var opt = options {
            html.option(value=opt.label, selected=(opt.label == value), textContent=opt.label)
        }
    }
}

const component ui.textarea[platform](placeholder, readonly, value, disabled, rows, style, @input, @change) {
    html.textarea(
        placeholder = placeholder,
        disabled = disabled,
        readonly = readonly,
        rows = string(rows),
        style = {...style},
        @input(e) {
            value = e.currentTarget.value
            input(value)
        },
        @change(e) {
            value = e.currentTarget.value
            change(value)
        },
    ) {
    }
}

// --- Tier 2: Feedback & Navigation ---

// `<progress>` with no `value` attribute is HTML's own indeterminate bar, so
// the absent value is spelled by leaving the attribute off rather than by
// choosing a number to stand for "unknown".
const component ui.progress[platform](style, value, max) {
    if value != null {
        html.progress(value=string(value), max=string(max), style={...style}) {}
    } else {
        html.progress(max=string(max), style={...style}) {}
    }
}

// badge, chip and avatar render as sngl:ui's own bodies do, and say what they
// are in a class: `sngl-<name>`, and a modifier for each choice the props
// make (`sngl-badge-success`, `sngl-avatar-large`, `sngl-chip-selected`), so
// a page's stylesheet can restyle every one of them at once.
const component ui.badge[platform](value, variant, style) {
    html.span(
        class = variant != "" ? "sngl-badge sngl-badge-" + variant : "sngl-badge",
        textContent = value,
        style = {
            display = inlineBlock,
            paddingY = 2px,
            paddingX = 8px,
            borderRadius = 12px,
            ...style,
        },
    ) {}
}

const component ui.chip[platform](label, variant, removable, selected, disabled, style, @click, @remove) {
    html.span(
        class = "sngl-chip" + (variant != "" ? " sngl-chip-" + variant : "") + (selected ? " sngl-chip-selected" : ""),
        style = {
            display = inlineFlex,
            alignItems = center,
            gap = 4px,
            paddingY = 4px,
            paddingX = 12px,
            borderRadius = 16px,
            borderWidth = 1px,
            borderColor = selected ? #0066CC : #CCCCCC,
            opacity = disabled ? 0.5 : 1.0,
            ...style,
        },
    ) {
        html.span(textContent=label, @click { click() }) {}
        if removable {
            html.button(class="sngl-chip-remove", textContent="×", disabled=disabled, @click { remove() }) {}
        }
    }
}

const component ui.spinner[platform](label, style) {
    html.span(style={display=inlineFlex, alignItems=center, gap=8px, ...style}) {
        html.span(class="sngl-spinner") {}
        html.span(textContent=label) {}
    }
}

// A tablist of the tabs' labels and a tabpanel showing the selected one's
// content. `underline` marks the selected tab with a rule under it, `pills`
// with a filled background.
const component ui.tabs[platform](selected, variant, style, @change, items) {
    html.div(style={...style, display=flex, flexDirection=column}) {
        html.div(role="tablist", style={display=flex, gap=4px, borderBottom="1px solid #ccc"}) {
            for var k, t = items {
                html.button(
                    role = "tab",
                    textContent = t.label,
                    disabled = t.disabled,
                    style = {
                        paddingY = 8px,
                        paddingX = 16px,
                        border = "none",
                        borderBottom = variant == ui.TabsVariant.underline && k == selected ? "2px solid currentColor" : "2px solid transparent",
                        borderRadius = variant == ui.TabsVariant.pills ? 16px : 0px,
                        background = variant == ui.TabsVariant.pills && k == selected ? #00000014 : #00000000,
                        fontWeight = k == selected ? ui.FontWeight.bold : ui.FontWeight.normal,
                        cursor = "pointer",
                    },
                    @click {
                        selected = k
                        change(k)
                    },
                )
            }
        }
        html.div(role="tabpanel") {
            for var k, t = items {
                if k == selected {
                    t.content
                }
            }
        }
    }
}

const component ui.link[platform](text, href, style, @click) {
    html.a(href=href, style={...style}, @click { click() }) {
        html.span(textContent=text) {}
    }
}

const component ui.divider[platform](style) {
    html.hr(style={...style}) {}
}

// --- Tier 3: Overlays & Layout ---

// A window is a surface: html writes its document from the first that no `if`
// over state and no `for` can take away, which is the page, and shows every
// other as a `<dialog>` in it, without a backdrop as a desktop window is.
// Which is which is optimize.Documents' to find, once everything is inlined,
// so every window is one of these and the codegen answers each: the document's
// `visible` and `@closed` do nothing, since a page cannot leave the screen and
// is told of no close; a dialog's `visible` is its `open` attribute, the one
// `show()` sets, and its header carries the title and a close the user makes,
// which is a window manager's close -- `visible = false`, then `@closed`. A
// close the program makes runs nothing.
#[gen.renders(surface)]
#[intrinsic("html:window")]
component Window(
    title    string,
    :visible bool = true,
    @closed(),
    content  ...component ui.node,
) root

// The window's `@error` is the outermost boundary of what it renders, and
// catches whether or not the call site handles one.
const component ui.window[platform](title, visible, @error, @closed, content, favicon) {
    Window(title=title, :visible=visible, @closed { closed() }) {
        boundary(@error(e) { error(e) }) {
            content
        }
        #[family.crosses]
        favicon
    }
}

const component ui.modal[platform](style, open, title, content) {
    html.div(class="modal-overlay", hidden=(open == false), style={...style, position=fixed, top=0, left=0, right=0, bottom=0, background=#00000080, display=flex, alignItems=center, justifyContent=center, zIndex=1000}) {
        html.div(class="modal-content", style={background="#fff", borderRadius=8px, padding=24px}) {
            if title != "" {
                html.h3(textContent=title, style={marginTop=0, marginX=0, marginBottom=16px})
            }
            content
        }
    }
}

const component ui.drawer[platform](style, content) {
    html.div(style={...style, position=fixed, top=0, bottom=0, background="#fff", zIndex=1000}) {
        content
    }
}

const component ui.tooltip[platform](style, text, trigger) {
    html.div(title=text, style={...style}) {
        trigger
    }
}

const component ui.popover[platform](style, content) {
    html.div(style={...style, position=relative}) {
        content
    }
}

const component ui.splitview[platform](style, panes) {
    html.div(style={...style, display=flex}) {
        panes
    }
}

// --- Tier 4: Data & Desktop ---

const component ui.table[platform](style, columns, rows) {
    html.table(width="100%", style={borderCollapse="collapse", ...style}) {
        html.thead {
            html.tr {
                for var col = columns {
                    html.th(textContent=col, style={textAlign=left, padding=8px, borderBottom="2px solid #ddd"})
                }
            }
        }
        html.tbody {
            for var row = rows {
                html.tr {
                    for var cell = row.cells {
                        html.td(textContent=cell, style={padding=8px, borderBottom="1px solid #eee"})
                    }
                }
            }
        }
    }
}

// A tree's row: a node's label, and how far its depth indents it.
struct _TreeRow {
    label  string
    indent ui.measurement
}

// A tree's rows, in traversal order, each node's below it and indented one
// step further.
const func _treeRows(items list[ui.treeItem], indent ui.measurement) list[_TreeRow] {
    var out list[_TreeRow] = []
    for var it = items {
        out = [...out, _TreeRow{label=it.label, indent=indent}, ..._treeRows(it.children, indent + 16px)]
    }
    return out
}

const component ui.tree[platform](style, items) {
    html.ul(style={listStyleType=none, paddingLeft=16px, ...style}) {
        for var row = _treeRows(items, 0px) {
            html.li(textContent=row.label, style={paddingLeft=row.indent})
        }
    }
}

const component ui.menu[platform](style, open, items) {
    if open {
        html.div(role="menu", style={...style, position=absolute, display=flex, flexDirection=column, background="#fff", border="1px solid #ddd", borderRadius=4px, padding=4px, zIndex=100}) {
            for var it = items {
                html.button(role="menuitem", disabled=it.disabled, textContent=it.label, @click {
                    it.select()
                })
            }
        }
    }
}

// The top-level entries; a submenu is not drawn yet.
const component ui.menubar[platform](style, items) {
    html.nav(role="menubar", style={...style, display=flex, gap=4px}) {
        for var it = items {
            html.button(role="menuitem", disabled=it.disabled, textContent=it.label, @click {
                it.select()
            })
        }
    }
}

const component ui.toolbar[platform](style, controls) {
    html.div(style={...style, display=flex, gap=4px, alignItems=center}) {
        controls
    }
}

// --- Tier 5: Mobile & Specialized ---

// An empty `value` is what `<input type="date">` shows as unfilled, so an
// unpicked date is the empty string rather than the zero date. Two calls
// rather than one with a ternary, for the reason progress gives: under a
// language with no conditional expression the ternary becomes a temporary
// before the fold that would have settled it.
// The control reports the date as the text of a "YYYY-MM-DD" field, empty
// when cleared, so the date is built from it here.
const component ui.datepicker[platform](value, disabled, style, @change) {
    html.input(
        type = "date",
        value = (value != null ? string(value) : ""),
        disabled = disabled,
        style = {...style},
        @change(e) {
            value = e.currentTarget.value == "" ? null : time.date(e.currentTarget.value)
            change(value)
        },
    ) {}
}

const component ui.card[platform](style, content) {
    html.div(style={borderRadius=8px, padding=16px, ...style}) {
        content
    }
}

// --- Rich text ---
//
// The span family, implemented the way every other family here is: a component
// per member, each naming the element html already has for what the member
// means. A flow is a tree of spans and this platform renders a tree of
// elements, so the nesting carries over as it stands and the cascade is the
// one CSS already applies -- which is what the family asks for, the five
// typography fields being exactly the ones a browser inherits.
//
// The named faces are not lowered to `run` first. Each has an element that
// says what it *is* -- `<strong>`, `<em>`, `<code>` -- and a document that
// announces its emphasis to a screen reader is most of the reason to render
// one on the web at all. `run` is the general case underneath, and it is the
// only member that has to map a style field at a time.

// The two elements a flow is built from. `element` above cannot serve: it
// belongs to the widget family and hosts it, so a span written inside one is
// the ordinary membership error. These are the same element by the time they
// are emitted -- a tag, a style and children -- and differ only in the family
// each joins, which is the whole of what a tree kind is for.
//
// `flow` is the box the words sit in and is a widget; `inline` is one of the
// words and is a span. Both take their tag as a prop, so the vocabulary below
// is a table of tags rather than a declaration per element.
#[intrinsic("html:flow")]
component flow(
    tag            string,
    style          ui.Style,
    // The element's id, for an in-page link. Empty writes none: an id
    // attribute may not be empty.
    id             string,
    class          string,
    // The rule `class` stands for, as on `inline`.
    classStyle     ui.Style,
    classStyleDark ui.Style,
    content        ...component markup.span,
) ui.node

#[intrinsic("html:inline")]
component inline(
    tag            string,
    style          ui.Style,
    // What a `run` says about its own words. A `SpanStyle` and not a
    // `ui.Style`: its five typography fields lead with a state that means "the
    // span set nothing", and only a value carrying that distinction can be
    // turned into CSS that leaves the enclosing words alone. `spanStyleCSS`
    // is the half of this platform that reads it.
    spanStyle      markup.SpanStyle,
    class          string,
    // The rule `class` stands for, light and dark, written to the page's
    // stylesheet rather than onto the element. Read by `classRules`.
    classStyle     markup.SpanStyle,
    classStyleDark markup.SpanStyle,
    href           string,
    alt            string,
    textContent    string,
    content        ...component markup.span,
) markup.span

// The element a flow's role names. A heading announces as one, a quotation is
// quoted, a code sample is preformatted; a role html has no element for is a
// paragraph, which is what an unmarked run of prose is anyway.
const func roleTag(role markup.Role) string {
    if role == markup.Role.heading1 {
        return "h1"
    } else if role == markup.Role.heading2 {
        return "h2"
    } else if role == markup.Role.heading3 {
        return "h3"
    } else if role == markup.Role.heading4 {
        return "h4"
    } else if role == markup.Role.heading5 {
        return "h5"
    } else if role == markup.Role.heading6 {
        return "h6"
    } else if role == markup.Role.quote {
        return "blockquote"
    } else if role == markup.Role.code {
        return "pre"
    } else if role == markup.Role.caption {
        return "figcaption"
    }
    return "p"
}

// `preWrap` is the family's literal-whitespace rule, and html is the one host
// that would otherwise collapse what the author wrote. It is written first so
// a caller's own style wins, which is also how every other override here
// orders its defaults.
const component markup.richText[platform](style, role, anchor, content) {
    flow(tag=roleTag(role), id=anchor, style={margin=0px, whiteSpace=ui.WhiteSpace.preWrap, ...style}) {
        content
    }
}

// A class rather than the base's inline style, so the box has a dark half and
// a page's own `pre` rule can still restyle it.
const component markup.codeBlock[platform](content) {
    flow(
        tag = "pre",
        class = "sngl-code",
        classStyle = {padding=12px, background=#F5F5F5, color=#1F2328, borderRadius=4px},
        classStyleDark = {background=#161B22, color=#E6EDF3},
        style = {margin=0px, whiteSpace=ui.WhiteSpace.preWrap},
    ) {
        markup.monospace {
            content
        }
    }
}

const component markup.text[platform](value) {
    inline(tag="span", textContent=value) {}
}

const component markup.bold[platform](content) {
    inline(tag="strong") {
        content
    }
}

const component markup.italic[platform](content) {
    inline(tag="em") {
        content
    }
}

const component markup.underline[platform](content) {
    inline(tag="u") {
        content
    }
}

const component markup.strike[platform](content) {
    inline(tag="s") {
        content
    }
}

const component markup.monospace[platform](content) {
    inline(tag="code") {
        content
    }
}

const component markup.link[platform](href, content) {
    inline(tag="a", href=href) {
        content
    }
}

// A picture among the words is an image like any other, in a frame on the line.
const component markup.image[platform](alt, src) {
    #[family.crosses]
    ui.image(alt=alt) {
        src
    }
}

// A class, so what a keyword looks like stays the page's to say: the default
// palette is the class's rule in the stylesheet, light and dark, and a page's
// own CSS for `sngl-tok-<kind>` wins over it. A palette the program sets is on
// the element instead, since it wins over everything.
const component markup.token[platform](kind, content) {
    inline(
        tag = "span",
        class = "sngl-tok-" + string(kind),
        classStyle = {color=markup.tokenColor(markup.lightPalette, kind)},
        classStyleDark = {color=markup.tokenColor(markup.darkPalette, kind)},
        spanStyle = {color=markup.tokenColor(markup.palette, kind)},
    ) {
        content
    }
}

// The general run, and the one member with a style to map. A field the author
// left alone has to emit no CSS at all -- `font-weight: normal` on an inner
// span would un-bold the words around it, which is what the `inherit` members
// of `SpanStyle` exist to prevent -- and which fields those are is a question
// about a struct literal that only the emitter can ask. So the style is handed
// over whole and `spanStyleCSS` decides, rather than a chain of components
// here asking field by field: a prop is opaque to the `if` that would ask,
// so every branch survived folding and the words came out once per branch.
const component markup.run[platform](style, content) {
    inline(tag="span", spanStyle=style) {
        content
    }
}

// A list is the element html has for one, so a screen reader announces its
// length and each item's place, and the browser numbers it and picks a nested
// list's bullet itself. The default body's `marker` is the ordinal written out
// for a host that cannot count; this one can, so it reads `start` instead.
//
// The page's reset takes the indent the markers hang in, so the list gives it
// back, and the gap between items is the default body's.
const component markup.list[platform](ordered, start, items) {
    html.element(tag=ordered ? "ol" : "ul", attrs=ordered ? {"start"=string(start)} : {}, style={display=flex, flexDirection=column, gap=4px, paddingLeft=2em}) {
        items
    }
}

// A task item is a checkbox in place of the bullet: a real one, so it reads as
// a checkbox, and disabled, since a document describes state rather than
// holding it. Its row is a flex box, which is also what drops the marker.
const component markup.listItem[platform](task, content) {
    if task == markup.Task.none {
        html.li {
            content
        }
    } else {
        html.li(style={display=flex, flexDirection=row, alignItems=baseline, gap=8px}) {
            html.input(type="checkbox", checked=task == markup.Task.done, disabled=true) {}
            html.div(style={display=flex, flexDirection=column}) {
                content
            }
        }
    }
}

// Force v to run client-side (front-end). For code imported from non-js:
// languages this compiles the dependency to a front-end WASM asset instead of a
// server call. No effect for static-site builds. Build fails if the logic cannot
// run in the browser or depends on server-side values.
#[intrinsic("html.frontend")]
const func frontend[T any](v T) T

// Force v to run server-side (back-end). A func value is generated as an HTTP
// route; a constant expression is generated as a lazy-loaded static file.
#[intrinsic("html.backend")]
const func backend[T any](v T) T

// --- The timer ---
//
// The web already schedules, so this platform needs no timer primitive: the
// setInterval/clearInterval pair is a lifetime with a thing to release, which
// is what `effect` brackets.
//
// `delay` is a duration rather than an int so the call site converts nothing --
// a duration's magnitude is milliseconds, which is what setInterval wants.
#[js.native("setInterval")]
func setInterval(f func(), delay time.duration) int

#[js.native("clearInterval")]
func clearInterval(handle int)

// `enabled` is the effect's *position*, not part of its key: an effect lives as
// long as the branch it is written in, so `if enabled` is what makes toggling
// the gate a mount and an unmount. `on=interval` is the key, because a running
// schedule is the same schedule for as long as its period is unchanged.
const component time.timer[platform](interval, enabled, @tick) {
    var handle = 0

    if enabled {
        effect(
            on = interval,
            @mount(d) { handle = setInterval(tick, d) },
            @unmount(d) {
                clearInterval(handle)
            },
        )
    }
}

// --- Drawing ---
//
// A canvas draws through a CanvasRenderingContext2D, and its methods are the
// drawing vocabulary. Declared here rather than translated in Go: a shape
// override below calls them, and the emitted JavaScript is the call it wrote.
//
// `method` on each is what makes that possible -- a DOM method is a property
// of the context, and a native call is otherwise emitted with the receiver as
// its first argument.
#[js.native("CanvasRenderingContext2D")]
struct DrawContext {
    // Canvas2D sets style by property assignment rather than by method, so
    // these are fields. The SNGL names are the DOM names, so nothing has to
    // map them.
    fillStyle   string
    strokeStyle string
    lineWidth   float
    lineCap     string
    lineJoin    string
    font        string
}

#[js.native("save", "", method)]
func DrawContext.save()

#[js.native("restore", "", method)]
func DrawContext.restore()

#[js.native("beginPath", "", method)]
func DrawContext.beginPath()

#[js.native("arc", "", method)]
func DrawContext.arc(x float, y float, r float, start float, end float)

#[js.native("fill", "", method)]
func DrawContext.fill()

#[js.native("stroke", "", method)]
func DrawContext.stroke()

#[js.native("fillRect", "", method)]
func DrawContext.fillRect(x float, y float, w float, h float)

#[js.native("strokeRect", "", method)]
func DrawContext.strokeRect(x float, y float, w float, h float)

// The DOM's `ellipse` takes a rotation and a sweep; a shape that wants a
// partial arc writes them itself rather than waiting for a stdlib shape.
#[js.native("ellipse", "", method)]
func DrawContext.ellipse(x float, y float, rx float, ry float, rotation float, start float, end float)

#[js.native("moveTo", "", method)]
func DrawContext.moveTo(x float, y float)

#[js.native("lineTo", "", method)]
func DrawContext.lineTo(x float, y float)

#[js.native("bezierCurveTo", "", method)]
func DrawContext.bezierCurveTo(cx1 float, cy1 float, cx2 float, cy2 float, x float, y float)

#[js.native("arcTo", "", method)]
func DrawContext.arcTo(x1 float, y1 float, x2 float, y2 float, r float)

#[js.native("closePath", "", method)]
func DrawContext.closePath()

#[js.native("translate", "", method)]
func DrawContext.translate(x float, y float)

#[js.native("scale", "", method)]
func DrawContext.scale(x float, y float)

#[js.native("rect", "", method)]
func DrawContext.rect(x float, y float, w float, h float)

#[js.native("clip", "", method)]
func DrawContext.clip()

#[js.native("fillText", "", method)]
func DrawContext.fillText(text string, x float, y float)

#[js.native("strokeText", "", method)]
func DrawContext.strokeText(text string, x float, y float)

// The primitive an override paints through: `@draw` is the target calling in
// with the context, and the handler body is what the draw function emits.
//
// A shape override paints through it below.
// What a `@draw` handler is handed: the context to paint through, and the
// coordinate space the shapes were placed in. The size is the canvas's own
// declared width and height, so it arrives as a literal.
struct DrawEvent {
    ctx    DrawContext
    width  int
    height int
}

#[intrinsic("html:draw")]
component draw(@draw(e DrawEvent)) shapes.shape

// What a `drawSource` paints a fetched or shipped image with: the context, and
// the URL its source names.
struct SourceEvent {
    ctx DrawContext
    url string
}

// The primitive a `canvasImage` paints its source through. `@url` paints an
// image a URL names; a drawing is painted in place rather than as a picture,
// its shapes between `@enter`, which maps the drawing's own space onto the box
// and clips to it, and `@leave`. The size in their payload is the drawing's.
#[intrinsic("html:drawSource")]
component drawSource(
    @url(e SourceEvent),
    @enter(e DrawEvent),
    @leave(e DrawEvent),
    source ...component family.one[ui.imageSource],
) shapes.shape

// `rgba(...)` as the DOM spells it. Written in SNGL rather than pointed at the
// page's `_snglColor` helper, because being pure is what lets a constant style
// fold: a literal colour becomes the string `"rgba(51,102,204,1)"` at build
// time, where a native call stays a call forever. The alpha channel is 0-255
// in SNGL and 0-1 here, which is the whole reason it is a function.
const func cssColor(c color) => "rgba({c.r},{c.g},{c.b},{float(c.a) / 255.0})"

// Fill and stroke are gated on alpha, which every other backend does and this
// one did not: the old translation tested the colour *object* for truthiness,
// and a JS object is always truthy, so a fill-only shape also painted an
// invisible stroke (#225).
// The style a shape shares, as a helper rather than repeated per shape. A
// shape that needs only part of it sets that part itself instead of calling
// this -- `rect` and `line` below do.
func paintStyle(ctx DrawContext, style shapes.Style) {
    ctx.fillStyle = cssColor(style.fill)
    ctx.strokeStyle = cssColor(style.stroke)
    ctx.lineWidth = style.strokeWidth
}

const component shapes.circle[platform](cx, cy, r, style) {
    html.draw(@draw(e) {
        e.ctx.save()
        paintStyle(e.ctx, style)
        e.ctx.beginPath()
        e.ctx.arc(cx, cy, r, 0.0, math.tau)
        if style.fill.a > 0 {
            e.ctx.fill()
        }
        if style.stroke.a > 0 {
            e.ctx.stroke()
        }
        e.ctx.restore()
    })
}

// Each shape sets only the style it uses, which is the point of writing these
// in SNGL: the translation they replace applied all six properties to every
// shape, including a font to a rectangle.
const component shapes.rect[platform](x, y, w, h, style) {
    html.draw(@draw(e) {
        e.ctx.save()
        if style.fill.a > 0 {
            e.ctx.fillStyle = cssColor(style.fill)
            e.ctx.fillRect(x, y, w, h)
        }
        if style.stroke.a > 0 {
            e.ctx.strokeStyle = cssColor(style.stroke)
            e.ctx.lineWidth = style.strokeWidth
            // A rectangle has corners, so lineJoin is its to honour. No
            // lineCap: the path closes, so there are no ends for one to shape
            // -- which is also why circle and ellipse set neither.
            e.ctx.lineJoin = string(style.lineJoin)
            e.ctx.strokeRect(x, y, w, h)
        }
        e.ctx.restore()
    })
}

const component shapes.ellipse[platform](cx, cy, rx, ry, style) {
    html.draw(@draw(e) {
        e.ctx.save()
        paintStyle(e.ctx, style)
        e.ctx.beginPath()
        e.ctx.ellipse(cx, cy, rx, ry, 0.0, 0.0, math.tau)
        if style.fill.a > 0 {
            e.ctx.fill()
        }
        if style.stroke.a > 0 {
            e.ctx.stroke()
        }
        e.ctx.restore()
    })
}

// A line has no interior, so `fill` is not read here at all rather than being
// set and ignored. That is the declaration's documented behaviour, stated once
// in the override instead of as a special case in five emitters.
const component shapes.line[platform](x1, y1, x2, y2, style) {
    html.draw(@draw(e) {
        e.ctx.save()
        e.ctx.strokeStyle = cssColor(style.stroke)
        e.ctx.lineWidth = style.strokeWidth
        e.ctx.lineCap = string(style.lineCap)
        e.ctx.lineJoin = string(style.lineJoin)
        e.ctx.beginPath()
        e.ctx.moveTo(x1, y1)
        e.ctx.lineTo(x2, y2)
        e.ctx.stroke()
        e.ctx.restore()
    })
}

const component shapes.path[platform](style, steps) {
    html.draw(@draw(e) {
        e.ctx.save()
        paintStyle(e.ctx, style)
        e.ctx.lineCap = string(style.lineCap)
        e.ctx.lineJoin = string(style.lineJoin)
        e.ctx.beginPath()
        for var c = steps {
            if c.op == shapes.PathOp.moveTo {
                e.ctx.moveTo(c.x, c.y)
            }
            if c.op == shapes.PathOp.lineTo {
                e.ctx.lineTo(c.x, c.y)
            }
            if c.op == shapes.PathOp.bezierTo {
                e.ctx.bezierCurveTo(c.cx1, c.cy1, c.cx2, c.cy2, c.x, c.y)
            }
            if c.op == shapes.PathOp.arcTo {
                e.ctx.arcTo(c.cx1, c.cy1, c.x, c.y, c.r)
            }
            if c.op == shapes.PathOp.close {
                e.ctx.closePath()
            }
        }
        if style.fill.a > 0 {
            e.ctx.fill()
        }
        if style.stroke.a > 0 {
            e.ctx.stroke()
        }
        e.ctx.restore()
    })
}

// The page's own image shim, which carries the decode cache and the wait for
// a source that has not arrived yet. Receiver-first: `method` would make this
// `ctx._snglDrawImage(...)`, and the context is an argument here, not the
// thing the call is made on.
#[js.native("_snglDrawImage")]
func drawImage(ctx DrawContext, src string, x float, y float, w float, h float)

const component shapes.canvasImage[platform](x, y, w, h, src) {
    drawSource(
        @url(e) {
            drawImage(e.ctx, e.url, x, y, w, h)
        },
        @enter(e) {
            e.ctx.save()
            e.ctx.translate(x, y)
            e.ctx.scale(w / float(e.width), h / float(e.height))
            e.ctx.beginPath()
            e.ctx.rect(0.0, 0.0, float(e.width), float(e.height))
            e.ctx.clip()
        },
        @leave(e) {
            e.ctx.restore()
        },
    ) {
        src
    }
}

const component shapes.canvasText[platform](x, y, content, style) {
    html.draw(@draw(e) {
        e.ctx.save()
        e.ctx.font = "{style.fontSize}px {style.fontFamily}"
        if style.fill.a > 0 {
            e.ctx.fillStyle = cssColor(style.fill)
            e.ctx.fillText(content, x, y)
        }
        if style.stroke.a > 0 {
            e.ctx.strokeStyle = cssColor(style.stroke)
            e.ctx.strokeText(content, x, y)
        }
        e.ctx.restore()
    })
}

// --- Navigation ---

// A page of a stack, as this platform serves one: a document of its own on a
// static site and a route in route mode, written as the whole window with
// every other page pruned. What its content is handed is the page's params
// cell, which a static site binds to the page's own params and a route to the
// request's.
//
// It is a node, which is what it renders; the override crosses it into the
// page family it stands in for, which is not nameable here.
#[intrinsic("html:page")]
component Page(content ...component ui.node) ui.node

// A stack of pages, which a document never shows whole: each page is written
// out as the window with the stack standing for that page alone.
//
// The pages' family is sngl:ui/nav's and unexported, so the slot takes it as a
// type parameter, bound by the pages written there.
#[intrinsic("html:stack")]
component Stack[F any](pages ...component F) ui.node

const component nav.stack[platform](pages) {
    Stack {
        pages
    }
}

const component nav.page[platform](params, content) {
    #[family.crosses]
    Page {
        content(params)
    }
}

// A link is an address here: the page's href, filled from the params it
// passes. Its own `@click` runs before the browser follows it, as ui.link's
// does. A link in a window shown inside the document navigates in place, and
// renders sngl:ui/nav's own body there instead.
const component nav.link[platform](to, params, text, style, @click) {
    ui.link(href=nav.href(to, params), text=text, style=style, @click {
        click()
    })
}
