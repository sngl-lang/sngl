import ui "sngl:ui"
import c "sngl:x/c"
import api "sngl:platform/win32/api"
import go "sngl:language/go"

// --- The window procedures ---

// A box's and a toplevel's window procedure, and the one each control is
// subclassed with, are the platform's, which the runtime registers its
// classes with (`sngl_win32_procs`, as `_ctls` starts). Each control's
// notifications reach the window it is in, which hands them to the
// handlers the program connected to the control (`_on`); what the runtime
// draws -- a flow's words, a canvas, a picture, a progress bar's text -- it
// asks the runtime to paint.

// The handlers the program connected to a window, kept beside its record
// rather than in it, since a layout copies records by the thousand: a
// click, a change, an activation (Enter in an edit, a multi-line one's
// focus leaving it, a tree's node expanded), a close, a scroll's end, a
// picture loaded and failed, and a toplevel's `:visible`. `clicks` and
// `activates` say one was connected, which the cursor and Enter ask.
struct _On {
    click     func() = func() {}
    clicks    bool = false
    change    func() = func() {}
    activate  func() = func() {}
    activates bool = false
    closed    func() = func() {}
    reach     func() = func() {}
    load      func() = func() {}
    failed    func() = func() {}
    visible   func(visible bool) = func(visible bool) {}
}

var _on map[api.HWND, _On] = {}

// Set while a test raises a click, which opens no link and bubbles no
// further than the node it is on.
var _firing = false

#[c.native("DWORD_PTR")]
struct _DwordPtr = int

// Hands the runtime the window procedures and what rich text reads of a
// record, which `_ctls` starts as.
#[c.native("sngl_win32_procs")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32Procs")]
func _procs(
    #[c.type("WNDPROC")] #[c.static(convention="CALLBACK")] box func(w api.HWND, msg api.UINT, wp api.WPARAM, lp api.LPARAM) api.LRESULT,
    #[c.type("SUBCLASSPROC")] #[c.static(convention="CALLBACK")] control func(w api.HWND, msg api.UINT, wp api.WPARAM, lp api.LPARAM, id _UintPtr, data _DwordPtr) api.LRESULT,
    #[c.type("sngl_win32_count_hook")] #[c.static] nkids func(w api.HWND) int,
    #[c.type("sngl_win32_kid_hook")] #[c.static] kid func(w api.HWND, at int) api.HWND,
)

