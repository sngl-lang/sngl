// --- A context's state ---

// What a context draws in beside GDI+'s own state, which save and restore
// keep with it: its color, a channel each, 0 to 255; its line's width, and
// its cap and join in `LineCap`'s and `LineJoin`'s order; its font's size in
// pixels and its family.
struct _Pen {
    r      int
    g      int
    b      int
    a      int
    width  float
    cap    int
    join   int
    fontPx float
    family string
}

// What a save kept: the pen, and GDI+'s state of the graphics.
struct _Saved {
    pen   _Pen
    state int
}

// The state of the paint whose serial `_paintSerial` is (sngl_win32_gfx's
// `serial`, which the runtime counts up as each paint begins): the current
// point, where the figure being built started, whether there is a current
// point, and whether the figure has a point of its own yet, since a move
// only says where the next segment starts; the pen; and what each save
// kept, the first 16 of them, and how deep the saves go, which counts past
// them as cairo's does.
var _paintSerial = 0
var _x = 0.0
var _y = 0.0
var _fx = 0.0
var _fy = 0.0
var _at = false
var _begun = false
var _pen = _Pen{r=0, g=0, b=0, a=255, width=1.0, cap=0, join=0, fontPx=16.0, family="sans-serif"}
var _saved list[_Saved] = []
var _depth = 0

#[c.native("sngl_win32_gfx.g", field)]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32GfxG")]
func _gfxGraphics(g Gfx) _GpGraphics

#[c.native("sngl_win32_gfx.path", field)]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32GfxPath")]
func _gfxPath(g Gfx) _GpPath

#[c.native("sngl_win32_gfx.serial", field)]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32GfxSerial")]
func _gfxSerial(g Gfx) int

// The state of g's paint, made afresh as a paint begins, as cairo's starts:
// black, a line one wide, and the default font.
func _paintOf(g Gfx) {
    var serial = _gfxSerial(g)
    if serial != _paintSerial {
        _paintSerial = serial
        _x = 0.0
        _y = 0.0
        _fx = 0.0
        _fy = 0.0
        _at = false
        _begun = false
        _pen = _Pen{r=0, g=0, b=0, a=255, width=1.0, cap=0, join=0, fontPx=16.0, family="sans-serif"}
        _saved = []
        _depth = 0
    }
}

// The pen's color as GDI+ takes one.
func _argb() _GpArgb {
    return _GpArgb(_pen.a * 16777216 + _pen.r * 65536 + _pen.g * 256 + _pen.b)
}

func _channel(v int) => v < 0 ? 0 : (v > 255 ? 255 : v)

// The path emptied, after a fill, a stroke or a clip.
func _newPath(g Gfx) {
    _gdipResetPath(_gfxPath(g))
    _gdipSetPathFillMode(_gfxPath(g), _gpFillModeWinding)
    _at = false
    _begun = false
}

// The arc of `sweep` radians from `start`, joined by a line to the current
// point where there is one, as cairo's is: as cubic segments of a quarter
// turn or less, since Wine's GdipAddPathArc ends one with a segment of no
// length, after which its stroke drops the rest of the figure.
func _arc(g Gfx, cx float, cy float, r float, start float, sweep float) {
    var tau = 6.283185307179586
    var turn = sweep > tau ? tau : (sweep < -tau ? -tau : sweep)
    var sx = cx + r * math.cos(start)
    var sy = cy + r * math.sin(start)
    if _at && !_begun {
        // GDI+ joins an arc to the figure's last point, and a move made
        // none.
        _gdipAddPathLine(_gfxPath(g), _x, _y, sx, sy)
    } else if !_at {
        _fx = sx
        _fy = sy
    }
    var n = int(float.ceil(float.abs(turn) / (tau / 4.0) - 0.000000001))
    var step = n > 0 ? turn / float(n) : 0.0
    var k = 4.0 / 3.0 * math.tan(step / 4.0)
    var a = start
    var i = 0
    for r > 0.0 && i < n {
        var b = a + step
        var x0 = cx + r * math.cos(a)
        var y0 = cy + r * math.sin(a)
        var x3 = cx + r * math.cos(b)
        var y3 = cy + r * math.sin(b)
        _gdipAddPathBezier(_gfxPath(g), x0, y0, x0 - k * r * math.sin(a), y0 + k * r * math.cos(a), x3 + k * r * math.sin(b), y3 - k * r * math.cos(b), x3, y3)
        i += 1
        a += step
    }
    _x = cx + r * math.cos(start + turn)
    _y = cy + r * math.sin(start + turn)
    _at = true
    _begun = true
}

// The font family `name` names: CSS's generic families as GDI+'s, or the one
// the system knows by that name, or its sans-serif.
func _fontFamily(name string) option[_GpFontFamily] {
    var f option[_GpFontFamily] = null
    if name == "serif" {
        _gdipGetGenericFontFamilySerif(&f)
    } else if name == "monospace" {
        _gdipGetGenericFontFamilyMonospace(&f)
    } else if name != "sans-serif" && name != "" {
        _gdipCreateFontFamilyFromName(name, null, &f)
    }
    if f == null {
        _gdipGetGenericFontFamilySansSerif(&f)
    }
    return f
}
