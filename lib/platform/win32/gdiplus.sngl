import c "sngl:x/c"
import math "sngl:math"
import go "sngl:language/go"

// --- GDI+ ---
//
// The flat API of GDI+ a canvas's context paints through, as <gdiplus.h>
// declares it, which sngl_win32.h includes. win32gen reads no GDI+, so the
// platform declares what it calls here, as it does user32's few that
// win32gen skips. Each of GDI+'s objects is a `void` to C
// (gdiplusgpstubs.h), so a handle to one is a `void *`, which is what cgo
// takes for it: spelled `GpPath *`, Go's wrappers held a type cgo would not
// pass.

#[c.native("void *")]
struct _GpGraphics {}

#[c.native("void *")]
struct _GpPath {}

#[c.native("void *")]
struct _GpSolidFill {}

#[c.native("void *")]
struct _GpBrush {}

#[c.native("void *")]
struct _GpPen {}

#[c.native("void *")]
struct _GpFontFamily {}

#[c.native("void *")]
struct _GpFontCollection {}

#[c.native("void *")]
struct _GpFont {}

#[c.native("void *")]
struct _GpStringFormat {}

#[c.native("REAL")]
struct _GpReal = float

#[c.native("ARGB")]
struct _GpArgb = int

#[c.native("GraphicsState")]
struct _GpGraphicsState = int

#[c.native("UINT16")]
struct _GpUint16 = int

#[c.native("GpStatus")]
struct _GpStatus = int

#[c.native("GpFillMode")]
struct _GpFillMode = int

#[c.native("GpUnit")]
struct _GpUnit = int

#[c.native("Unit")]
struct _GpFontUnit = int

#[c.native("GpLineCap")]
struct _GpLineCap = int

#[c.native("GpDashCap")]
struct _GpDashCap = int

#[c.native("GpLineJoin")]
struct _GpLineJoin = int

#[c.native("GpMatrixOrder")]
struct _GpMatrixOrder = int

#[c.native("CombineMode")]
struct _GpCombineMode = int

#[c.native("RectF")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.GpRectF")]
struct _GpRectF {
    X      _GpReal
    Y      _GpReal
    Width  _GpReal
    Height _GpReal
}

// GDI+'s Ok, and the members of its enums the context names.
const _gpOk = 0
const _gpFillModeWinding = 1
const _gpUnitPixel = 2
const _gpLineCapFlat = 0
const _gpLineCapSquare = 1
const _gpLineCapRound = 2
const _gpDashCapFlat = 0
const _gpDashCapRound = 2
const _gpLineJoinMiter = 0
const _gpLineJoinBevel = 1
const _gpLineJoinRound = 2
const _gpMatrixOrderPrepend = 0
const _gpCombineModeIntersect = 1
const _gpFontStyleRegular = 0

