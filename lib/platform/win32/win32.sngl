#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SendListView")]
func _sendListView(to api.HWND, msg api.UINT, w api.WPARAM, #[c.type("LPARAM")] lv ref[_NmListView]) api.LRESULT

