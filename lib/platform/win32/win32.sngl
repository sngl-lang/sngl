}

// Chooses the tab at `index` as the user's click on it does, which reports
// it: TCM_SETCURSEL, then TCN_SELCHANGE.
func pickTab(t Tabs, index int) {
    var w = _handle(t)
    api.SendMessage(w, 4876, index, 0)
    var nm = _header(w, -551)
    _sendNotify(api.GetParent(w), api.WM_NOTIFY, nm.idFrom, &nm)
}

