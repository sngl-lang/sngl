#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SendTreeItem")]
func _sendTreeItem(t api.HWND, msg api.UINT, w api.WPARAM, #[c.type("LPARAM")] it _TreeItem) api.LRESULT

// What DTN_DATETIMECHANGE's LPARAM points to.
#[c.native("NMDATETIMECHANGE")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.NmDateTimeChange")]
struct _NmDateTimeChange {
    nmhdr   _Nmhdr
    dwFlags api.DWORD
    st      _SystemTime
}

#[c.native("SendMessageW")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SendDateChange")]
func _sendDateChange(to api.HWND, msg api.UINT, w api.WPARAM, #[c.type("LPARAM")] ch ref[_NmDateTimeChange]) api.LRESULT

#[c.native("sngl_win32_set_date")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32SetDate")]
func _setDate(d api.HWND, iso c.utf16)

// A test's choice, as the user's, in the first table, tree or date picker
// of the window `n` is in: a row selected, a column header clicked, a node
// selected by its label, a date picked ("YYYY-MM-DD", or "" for none). Each
// answers whether there was one to choose.
func pickRow(n ui.node, row int) bool {
    return _pickRow(_handle(n), row)
}

func _pickRow(n api.HWND, row int) bool {
    var t = _firstOf(n, _kTable)
    if t != null {
        // Selected and focused, as a click leaves it.
        var it = _LvState{mask=0, iItem=0, iSubItem=0, state=3, stateMask=3}
        return _sendItemState(_found(t), 4139, row, &it) != 0
    }
    return false
}

func clickColumn(n ui.node, column int) bool {
    return _clickColumn(_handle(n), column)
}

func _clickColumn(n api.HWND, column int) bool {
    var t = _firstOf(n, _kTable)
    if t != null {
        var w = _found(t)
        var lv = _NmListView{hdr=_header(w, -108), iItem=-1, iSubItem=column}
        _sendListView(api.GetParent(w), api.WM_NOTIFY, lv.hdr.idFrom, &lv)
        return true
    }
    return false
}

func pickNode(n ui.node, label string) bool {
    return _pickNode(_handle(n), label)
}

func _pickNode(n api.HWND, label string) bool {
    var t = _firstOf(n, _kTree)
    if t != null {
        var w = _found(t)
        var it = _treeFind(w, label)
        if it != null {
            return _sendTreeItem(w, 4363, 9, _treeFoundItem(it)) != 0
        }
    }
    return false
}

func pickDate(n ui.node, iso string) bool {
    return _pickDate(_handle(n), iso)
}

func _pickDate(n api.HWND, iso string) bool {
    var t = _firstOf(n, _kDate)
    if t != null {
        var w = _found(t)
        _setDate(w, iso)
        var st = _SystemTime{wYear=0, wMonth=0, wDayOfWeek=0, wDay=0, wHour=0, wMinute=0, wSecond=0, wMilliseconds=0}
        var flags = _dtmGetSystemTime(w, 4097, 0, &st)
        var ch = _NmDateTimeChange{nmhdr=_header(w, -759), dwFlags=flags, st=st}
        _sendDateChange(api.GetParent(w), api.WM_NOTIFY, ch.nmhdr.idFrom, &ch)
        return true
    }
    return false
}

