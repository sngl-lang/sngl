// --- Drawing ---

// A canvas is a window of the runtime's that GDI+ paints, through a context
// whose calls are cairo's, as gtk4's are: a path built, then filled or
// stroked in the color, line and font last set, which save and restore keep
// (sngl_win32_gfx). Its drawing -- the shapes, as the calls the overrides
// below make -- is the handler of its `@paint`, handed the context, which
// lowering connects as it connects any handler, and a write to what the
// drawing reads asks for a paint through its redraw.
#[macro.cnative("sngl_win32_gfx *")]
struct Gfx {}

#[macro.cnative("sngl_win32_gfx_save")]
func Gfx.save()

#[macro.cnative("sngl_win32_gfx_restore")]
func Gfx.restore()

// Each channel 0..255, as a SNGL color holds it.
#[macro.cnative("sngl_win32_gfx_color")]
func Gfx.color(r int, g int, b int, a int)

#[macro.cnative("sngl_win32_gfx_line_width")]
func Gfx.lineWidth(w float)

// `LineCap` and `LineJoin` in their order: butt, round, square, and miter,
// round, bevel.
#[macro.cnative("sngl_win32_gfx_line_cap")]
func Gfx.lineCap(cap int)

#[macro.cnative("sngl_win32_gfx_line_join")]
func Gfx.lineJoin(join int)

#[macro.cnative("sngl_win32_gfx_rect")]
func Gfx.rectangle(x float, y float, w float, h float)

#[macro.cnative("sngl_win32_gfx_new_sub_path")]
func Gfx.newSubPath()

#[macro.cnative("sngl_win32_gfx_move_to")]
func Gfx.moveTo(x float, y float)

#[macro.cnative("sngl_win32_gfx_line_to")]
func Gfx.lineTo(x float, y float)

#[macro.cnative("sngl_win32_gfx_curve_to")]
func Gfx.curveTo(x1 float, y1 float, x2 float, y2 float, x3 float, y3 float)

#[macro.cnative("sngl_win32_gfx_arc")]
func Gfx.arc(cx float, cy float, r float, start float, end float)

#[macro.cnative("sngl_win32_gfx_arc_negative")]
func Gfx.arcNegative(cx float, cy float, r float, start float, end float)

#[macro.cnative("sngl_win32_gfx_close_path")]
func Gfx.closePath()

// The path filled, and kept for a stroke where `preserve` says.
#[macro.cnative("sngl_win32_gfx_fill")]
func Gfx.fill(preserve bool)

#[macro.cnative("sngl_win32_gfx_stroke")]
func Gfx.stroke()

#[macro.cnative("sngl_win32_gfx_font")]
func Gfx.font(family c.utf16, size float)

// Drawn from the current point, on its baseline.
#[macro.cnative("sngl_win32_gfx_text")]
func Gfx.showText(content c.utf16)

// What a `@draw` handler is handed: the context, and the coordinate space
// the shapes were placed in.
struct DrawEvent {
    ctx    Gfx
    width  int
    height int
}

// The primitive every shape below paints through: its handler is spliced
// into the drawing, written against the canvas's context.
#[marks.intrinsic("win32:draw")]
component Paint(@draw(e DrawEvent)) draw.shape

// The window a `draw.canvas` is. Its width and height are the space its
// shapes are placed in, and `scalingMode` how that space is shown in the
// room it is given.
#[marks.intrinsic("win32:Canvas")]
component Canvas(
    width       ui.measurement,
    height      ui.measurement,
    scalingMode draw.ScalingMode,
    @click(),
    @paint(ctx Gfx),
    shapes      ...component draw.shape,
) ui.node

#[macro.cnative("sngl_win32_canvas")]
func _rtCanvas() Canvas

#[macro.cnative("sngl_win32_set_canvas_width")]
func _rtSetCanvasWidth(w Canvas, width int)

#[macro.cnative("sngl_win32_set_canvas_height")]
