#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SendItemState")]
func _sendItemState(t api.HWND, msg api.UINT, w api.WPARAM, #[c.type("LPARAM")] it ref[_LvState]) api.LRESULT

