// A drawing that scales grows into the room its box has spare.
func _rtSetScaling(w Canvas, mode int) {
    if _rtScalingChanged(w, mode) != 0 {
        var h = _handle(w)
        if _ctls.contains(h) {
            var scales = mode != 0
            _ctls[h].flex = scales ? 1.0 : 0.0
        }
        _relayout(h)
    }
}

