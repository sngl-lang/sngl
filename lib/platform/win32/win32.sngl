// The runtime every win32 program links: the window procedure, the layout of
// a box's children and the message loop, in C, which each language compiles
// into the program.
c.link(include="sngl_win32.h", library="user32", ldflags=["-mwindows", "-luser32", "-lgdi32", "-lcomctl32", "-lshell32", "-lmsimg32", "-lole32", "-luuid", "-lwindowscodecs", "-lurlmon", "-lgdiplus", "-lwinhttp"], sources=["rt/sngl_win32.c", "rt/sngl_win32.h", "rt/http.c", "sngl:language/c/rt/sngl_http.h"])

// The source annotations MinGW's sal.h, specstrings.h and driverspecs.h
// define as macros, which windows.h includes: a local lowering names
// `__out` was read by the preprocessor as one.
const salMacros = [
    "__analysis_assume",
    "__bcount",
    "__deref",
    "__deref_opt_out",
    "__deref_opt_out_bcount",
    "__deref_out",
    "__deref_out_ecount",
    "__deref_out_opt",
    "__drv_arg",
    "__drv_at",
    "__drv_deref",
    "__drv_in",
    "__drv_in_deref",
    "__drv_out",
    "__drv_out_deref",
    "__drv_when",
    "__ecount",
    "__encoded_pointer",
    "__fallthrough",
    "__in",
    "__in_bcount",
    "__in_bcount_nz",
    "__in_bcount_z",
    "__in_ecount",
    "__in_ecount_nz",
    "__in_ecount_z",
    "__in_opt",
    "__inout",
    "__inout_bcount",
    "__inout_bcount_full",
    "__inout_bcount_nz",
    "__inout_bcount_part",
    "__inout_bcount_z",
    "__inout_ecount",
    "__inout_ecount_full",
    "__inout_ecount_nz",
    "__inout_ecount_part",
    "__inout_ecount_z",
    "__inout_opt",
    "__internal_kernel_driver",
    "__kernel_code",
    "__kernel_driver",
    "__nothrow",
    "__out",
    "__out_bcount",
    "__out_bcount_full",
    "__out_bcount_full_z",
    "__out_bcount_nz",
    "__out_bcount_part",
    "__out_bcount_part_z",
    "__out_bcount_z",
    "__out_ecount",
    "__out_ecount_full",
    "__out_ecount_full_z",
    "__out_ecount_nz",
    "__out_ecount_part",
    "__out_ecount_part_z",
    "__out_ecount_z",
    "__out_opt",
    "__range",
    "__refparam",
    "__specstrings",
    "__user_code",
    "__user_driver",
]

// The `win32` node of a build directive: `output { c { win32() } }`.
//
// Every node is a window the runtime makes, and every operation on one a
// protocol function below, so the platform asks for `placement`: what the
// program renders becomes calls of these, which each language writes as it
// writes any call, and the platform's generator writes only the program's
// entry. A box places a child ahead of another, so a render slot's content
// goes where the slot is written. Win32 owns its controls and diffs nothing,
// which is gtk4's reason for flattening the tree and asking for explicit
// writes too. A context is a hidden parameter of each function reading it,
// as gtk4's is.
#[gen.can(insertBefore, asyncPost, instanceState)]
#[gen.cannot(reactivity, declarative, inlineComponents, structSpread)]
#[gen.wants(placement, stdlibContextParam, canvas, reactiveCanvas)]
#[gen.name("win32")]
#[gen.native("win32")]
component platform(
    // Go package name for the generated files.
    const package       string,
    // Emit a standalone main() or a library-style module.
    const main          bool,
    // The process start, wrapped: what the handler does before calling `run`
    // happens before the message loop, and what it does after, once the loop
    // has exited. `run` shows the windows and runs the loop. `args` is the
    // command line after the program's name.
    @run(args list[string], run func()),
    // The architecture the program is built for: `amd64`, or `386` for
    // 32-bit Windows. Off Windows, the build cross-compiles with MinGW's
    // compiler for it, and `sngl run` runs the program under Wine.
    const arch          string = "amd64",
    // What its generated code introduces beside a program's names: the
    // runtime's prefix, the program's entry, the runtime calls a Go program
    // makes as functions of its own (codegen/platform/win32's shimFile), and
    // the annotations windows.h defines as macros.
    const reservedNames list[string] = [
        "sngl_win32",
        "snglWin32Hold",
        "snglWin32Present",
        "snglWin32Run",
        "snglWin32Step",
        "snglWin32Snapshot",
        "snglWin32CarryFile",
        "snglPost",
        "sngl_build",
        "sngl_main",
        "main",
        "WinMain",
        ...salMacros,
    ],
) build.platform

// Every node is a window, held as its handle. Protocol functions below take
// and return nodes typed as their components, which is what the handle is to
// each language; one handing a node to a Win32 function of api reaches the
// handle through this.
#[c.native("HWND", cast)]
#[gen.protocol(handle)]
func _handle(n ui.node) api.HWND

// A node the program holds at its root, a window, is shown when the program
// attaches it and destroyed, with everything in it, when it detaches it. Any
// other node attached -- a test's component, a program with no window -- is
// shown in a window of its own, which goes with it.
#[c.native("sngl_win32_detach")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32Detach")]
func _rtDetach(n ui.node)

#[gen.protocol(attach)]
func _attach(n ui.node) {
    _attachNode(_handle(n))
}

#[gen.protocol(detach)]
func _detach(n ui.node) {
    _rtDetach(n)
}

// A node's children, which every container shares: a child appended last,
// put ahead of another, and destroyed as it is taken out (layout.sngl).
func _rtAppend(parent ui.node, child ui.node) {
    _appendTo(_handle(parent), _handle(child))
}

func _rtInsert(parent ui.node, child ui.node, before ui.node) {
    _insertTo(_handle(parent), _handle(child), _handle(before))
}

// A render slot's entries go before an anchor kept among its container's
// children, so a slot emptied and filled again comes back in its place.
#[gen.protocol(anchor)]
func _anchor(parent ui.node, anchor ui.node) ui.node {
    return _asNode(_slotAnchor(_handle(parent), _handle(anchor)))
}

#[c.native("HWND", cast)]
func _asNode(w api.HWND) ui.node

func _rtRemove(parent ui.node, child ui.node) {
    _removeFrom(_handle(parent), _handle(child))
}

// A handler the runtime calls with its context, which it releases when the
// window it was connected to goes.
#[c.native("sngl_win32_on_click")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32OnClick")]
func _rtOnClick(
    w ui.node,
    #[c.type("sngl_win32_fn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("sngl_win32_release")] #[c.release] rel c.pointer,
)

#[c.native("sngl_win32_on_change")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32OnChange")]
func _rtOnChange(
    w ui.node,
    #[c.type("sngl_win32_fn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("sngl_win32_release")] #[c.release] rel c.pointer,
)

#[c.native("sngl_win32_on_activate")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32OnActivate")]
func _rtOnActivate(
    w ui.node,
    #[c.type("sngl_win32_fn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("sngl_win32_release")] #[c.release] rel c.pointer,
)

// A control's or a toplevel's text, which the runtime measures it by again.
func _rtSetText(w ui.node, text string) {
    _setText(_handle(w), text)
}

// What a node's style asks of the runtime (sngl_win32_look): its share of a
// box's spare room, the gap between a box's children, the room inside its
// edges, its least size, its colors as 0xRRGGBB or -1 for the system's, and
// its font size, 0 for the system's, and 1 where its style's display hides
// it, which takes it out of its box's layout.
#[c.native("sngl_win32_look")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.Look")]
struct Look {
    flex       float
    gap        int
    padTop     int
    padRight   int
    padBottom  int
    padLeft    int
    minWidth   int
    width      int
    height     int
    align      int
    color      int
    background int
    fontPx     int
    hidden     int
}

// What of a look the runtime paints a node by: its colors and font size
// (_look, layout.sngl, sets the rest).
#[c.native("sngl_win32_set_look")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32SetLook")]
func _paintLook(w ui.node, look Look)

// What a window's paint is asked to cover again: all of it, where NULL.
// win32gen writes no InvalidateRect, whose rectangle is a `const RECT *`.
#[c.native("const RECT *")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.ConstRect")]
struct _ConstRect {}

#[c.native("InvalidateRect")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.InvalidateRect")]
func _invalidateRect(w api.HWND, r option[_ConstRect], erase bool) api.WINBOOL

// The whole of a window painted again, its background erased first.
func _invalidate(w api.HWND) {
    _invalidateRect(w, null, true)
}

// A control disabled is drawn grayed and takes no input.
func _rtSetEnabled(w ui.node, enabled bool) {
    api.EnableWindow(_handle(w), enabled)
    _invalidate(_handle(w))
}

// A check box's or a radio button's check, set and read as Win32 holds it.
func _setCheck(w ui.node, checked bool) {
    api.SendMessage(_handle(w), api.BM_SETCHECK, checked ? api.BST_CHECKED : api.BST_UNCHECKED, 0)
}

func _check(w ui.node) bool {
    return api.SendMessage(_handle(w), api.BM_GETCHECK, 0, 0) == api.BST_CHECKED
}

// What a test raises, it raises as the control would: the notification it
// sends the window it is in, which reaches the handler the program connected
// there as the user's does.

#[c.native("GetDlgCtrlID")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.GetDlgCtrlID")]
func _dlgCtrlId(w api.HWND) int

#[c.native("GetAncestor")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.GetAncestor")]
func _ancestor(w api.HWND, flags api.UINT) api.HWND

// WM_COMMAND, the window it is from in its LPARAM.
#[c.native("SendMessageW")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SendCommand")]
func _sendCommand(to api.HWND, msg api.UINT, w api.WPARAM, #[c.type("LPARAM")] from api.HWND) api.LRESULT

// A control's notification `code`: WM_COMMAND to the window it is in, its
// id and the code in its WPARAM (MAKEWPARAM).
func _notify(w api.HWND, code int) {
    _sendCommand(api.GetParent(w), api.WM_COMMAND, _dlgCtrlId(w) % 65536 + code * 65536, w)
}

#[c.native("UINT_PTR")]
struct _UintPtr = int

// What a WM_NOTIFY's LPARAM points to first: the control it is from and
// what it says.
#[c.native("NMHDR")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.Nmhdr")]
struct _Nmhdr {
    hwndFrom api.HWND
    idFrom   _UintPtr
    code     api.UINT
}

// The header of w's notification `code`.
func _header(w api.HWND, code int) _Nmhdr {
    return _Nmhdr{hwndFrom=w, idFrom=_dlgCtrlId(w), code=code}
}

#[c.native("SendMessageW")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SendNotify")]
func _sendNotify(to api.HWND, msg api.UINT, w api.WPARAM, #[c.type("LPARAM")] nm ref[_Nmhdr]) api.LRESULT

// --- Windows ---

// A toplevel: the window a `ui.window` is. The window manager's close hides
// it and is reported as `visible = false` followed by `@closed`, and the
// program ends when the last window it showed is closed.
#[marks.intrinsic("win32:Window")]
component Window(title string, :visible bool = true, @closed(), content ...component ui.node) root

#[c.native("sngl_win32_toplevel")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32Toplevel")]
func _rtToplevel() Window

#[c.native("sngl_win32_set_visible")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32SetVisible")]
func _rtSetVisible(w Window, visible bool)

// A window is no `ui.node`, being the root of what it holds, so it reaches
// the runtime's calls every node shares through declarations of its own.
#[c.native("HWND", cast)]
func _windowHandle(w Window) api.HWND

func _rtWindowAppend(parent Window, child ui.node) {
    _appendTo(_windowHandle(parent), _handle(child))
}

func _rtWindowRemove(parent Window, child ui.node) {
    _removeFrom(_windowHandle(parent), _handle(child))
}

func _rtWindowInsert(parent Window, child ui.node, before ui.node) {
    _insertTo(_windowHandle(parent), _handle(child), _handle(before))
}

#[c.native("sngl_win32_on_closed")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32OnClosed")]
func _rtWindowOnClosed(
    w Window,
    #[c.type("sngl_win32_fn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("sngl_win32_release")] #[c.release] rel c.pointer,
)

#[gen.protocol(create)]
func _create_Window() Window {
    return _rtToplevel()
}

#[gen.protocol(append)]
func _append_Window(parent Window, child ui.node) {
    _rtWindowAppend(parent, child)
}

#[gen.protocol(remove)]
func _remove_Window(parent Window, child ui.node) {
    _rtWindowRemove(parent, child)
}

#[gen.protocol(insertBefore)]
func _insert_Window(parent Window, child ui.node, before ui.node) {
    _rtWindowInsert(parent, child, before)
}

// A title needs no layout, so it is Win32's own call.
#[gen.protocol(set)]
func _set_Window_title(w Window, title string) {
    api.SetWindowText(_windowHandle(w), title)
}

#[gen.protocol(set)]
func _set_Window_visible(w Window, visible bool) {
    _rtSetVisible(w, visible)
}

#[gen.protocol(on)]
func _on_Window_closed(w Window, closed func()) {
    _rtWindowOnClosed(w, closed)
}

#[c.native("sngl_win32_fire_close")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32FireClose")]
func _rtFireClose(w Window)

#[gen.fires("closed")]
func _fire_Window_closed(w Window) {
    _rtFireClose(w)
}

#[c.native("sngl_win32_on_visible")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32OnVisible")]
func _rtWindowOnVisible(
    w Window,
    #[c.type("sngl_win32_bool_fn")] fn func(visible bool),
    #[c.context] ctx c.pointer,
    #[c.type("sngl_win32_release")] #[c.release] rel c.pointer,
)

// The window manager's close hides the window, which reaches `:visible` as
// false before `@closed` is reported.
#[gen.protocol(on)]
func _on_Window_visible(w Window, visible func(visible bool)) {
    _rtWindowOnVisible(w, visible)
}

// --- Containers ---

// How a box lays its children out.
enum BoxMode {
    // Along its axis, each its own size, the room to spare shared by flex,
    // and each the box's whole size across it.
    line
    // `columns` to a row, in columns of equal width sharing the box's.
    grid
    // In rows, each child its own size, a row wrapping where the next would
    // not fit.
    flow
    // One over another, each the box's whole room.
    stack
    // Along its axis in equal shares.
    equal
}

// A box lays its children out as its mode says. A framed one draws an
// etched edge inside its bounds, a hidden one takes no room, one with a
// click handler is pressed as a button is, and one with a tip shows it as
// the pointer rests on one of its children.
#[marks.intrinsic("win32:Box")]
component Box(
    vertical bool,
    look     Look,
    mode     BoxMode = BoxMode.line,
    columns  int = 0,
    framed   bool = false,
    visible  bool = true,
    tip      string = "",
    @click(),
    children ...component ui.node,
) ui.node

#[c.native("sngl_win32_set_tip")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32SetTip")]
func _rtSetTip(b Box, tip c.utf16)

func _rtSetMode(b Box, mode int) {
    _setMode(_handle(b), mode)
}

func _rtSetColumns(b Box, columns int) {
    _setColumns(_handle(b), columns)
}

func _rtSetFramed(b Box, framed bool) {
    _setFramed(_handle(b), framed)
}

#[c.native("sngl_win32_box")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32Box")]
func _rtBoxWindow() Box

func _rtBox(vertical bool) Box {
    var b = _rtBoxWindow()
    var w = _handle(b)
    if _ctls.contains(w) {
        _ctls[w].vertical = vertical
    }
    return b
}

func _rtSetVertical(b Box, vertical bool) {
    _setVertical(_handle(b), vertical)
}

#[gen.protocol(create)]
func _create_Box() Box {
    return _rtBox(true)
}

func _rtContents() Box {
    var b = _rtBox(true)
    var w = _handle(b)
    if _ctls.contains(w) {
        _ctls[w].contents = true
    }
    return b
}

// What a component renders several nodes, or a slot, at its top into: a box
// down the page, as a window lays out what it holds, growing by the most any
// node in it grows.
#[gen.protocol(contents)]
func _contents() Box {
    return _rtContents()
}

#[gen.protocol(append)]
func _append_Box(parent Box, child ui.node) {
    _rtAppend(parent, child)
}

#[gen.protocol(remove)]
func _remove_Box(parent Box, child ui.node) {
    _rtRemove(parent, child)
}

#[gen.protocol(insertBefore)]
func _insert_Box(parent Box, child ui.node, before ui.node) {
    _rtInsert(parent, child, before)
}

#[gen.protocol(set)]
func _set_Box_vertical(b Box, vertical bool) {
    _rtSetVertical(b, vertical)
}

#[gen.protocol(set)]
func _set_Box_look(b Box, look Look) {
    _look(b, look)
}

#[gen.protocol(set)]
func _set_Box_mode(b Box, mode BoxMode) {
    _rtSetMode(b, int(mode))
}

#[gen.protocol(set)]
func _set_Box_columns(b Box, columns int) {
    _rtSetColumns(b, columns)
}

#[gen.protocol(set)]
func _set_Box_framed(b Box, framed bool) {
    _rtSetFramed(b, framed)
}

#[gen.protocol(set)]
func _set_Box_visible(b Box, visible bool) {
    _rtSetShown(b, visible)
}

#[gen.protocol(set)]
func _set_Box_tip(b Box, tip string) {
    _rtSetTip(b, tip)
}

#[gen.protocol(on)]
func _on_Box_click(b Box, click func()) {
    _rtOnClick(b, click)
}

#[gen.fires("click")]
func _fire_Box_click(b Box) {
    _rtFireClick(b)
}

// Room a box shares out by its flex and draws nothing in.
#[marks.intrinsic("win32:Spacer")]
component Spacer(look Look) ui.node

#[c.native("sngl_win32_spacer")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32Spacer")]
func _rtSpacer() Spacer

#[gen.protocol(create)]
func _create_Spacer() Spacer {
    return _rtSpacer()
}

#[gen.protocol(set)]
func _set_Spacer_look(s Spacer, look Look) {
    _look(s, look)
}

