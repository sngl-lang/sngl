// The runtime's calls on a span, which is no `ui.node` but a window all the
// same: put into a flow or a span, and written.
#[c.native("HWND", cast)]
func _spanHandle(s markup.span) api.HWND

func _rtSpanAppend(parent ui.node, child markup.span) {
    _appendTo(_handle(parent), _spanHandle(child))
}

func _rtSpanInsert(parent ui.node, child markup.span, before markup.span) {
    _insertTo(_handle(parent), _spanHandle(child), _spanHandle(before))
}

func _rtSpanRemove(parent ui.node, child markup.span) {
    _removeFrom(_handle(parent), _spanHandle(child))
}

func _rtSpanAppendIn(parent markup.span, child markup.span) {
    _appendTo(_spanHandle(parent), _spanHandle(child))
}

func _rtSpanInsertIn(parent markup.span, child markup.span, before markup.span) {
    _insertTo(_spanHandle(parent), _spanHandle(child), _spanHandle(before))
}

func _rtSpanRemoveIn(parent markup.span, child markup.span) {
    _removeFrom(_spanHandle(parent), _spanHandle(child))
}

