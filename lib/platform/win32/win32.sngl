    _rtSetEntryChecked(e, checked)
}

#[gen.protocol(on)]
func _on_MenuEntry_select(e MenuEntry, select func()) {
    _rtOnClick(e, select)
}


// --- Timers ---

// Calls `fn` every `ms` milliseconds from the message loop, until the id it
// answers is cancelled.
#[macro.cnative("sngl_win32_every")]
func _rtEvery(
    ms int,
    #[c.type("sngl_win32_fn")] fn func(),
    #[c.context] ctx c.pointer,
    #[c.type("sngl_win32_release")] #[c.release] rel c.pointer,
) int

#[macro.cnative("sngl_win32_cancel")]
func _rtCancel(id int)

// --- The stdlib's components ---

// Its menu is the window's menu bar, drawn two deep: a top-level entry and
// its submenu, as gtk4's is.
const component ui.window[platform](title, visible, canGoBack, @error, @closed, @back, @key, content, favicon, menu) {
    Window(title=title, :visible=visible, @closed { closed() }) {
        content
        for var it = menu {
            MenuEntry(label=it.label, disabled=it.disabled, checked=it.checked, @select { it.select() }) {
                for var sub = it.children {
                    MenuEntry(label=sub.label, disabled=sub.disabled, checked=sub.checked, @select { sub.select() }) {}
                }
            }
        }
    }
}

const component ui.text[platform](value, style) {
    Text(value=value, look=lookOf(style)) {}
}

const component ui.button[platform](text, focusable, style, @click) {
    Button(text=text, look=lookOf(style), @click { click() }) {}
}

const component ui.checkbox[platform](label, checked, focusable, style, @change) {
    CheckBox #box(label=label, checked=checked, look=lookOf(style), @click {
        if isChecked(box) != checked {
            checked = isChecked(box)
            change(checked)
        }
    }) {}
}

// The value is pushed by an effect rather than bound, as gtk4's is: the
// edit reports each change it is given as one the user made, so only a
// value it does not already show is written, and quietly.
const component ui.input[platform](value, focusable, style, @input, @change) {
    Edit #entry(
        look = lookOf(style),
        @change {
            if editText(entry) != value {
                value = editText(entry)
                input(value)
            }
        },
        @activate {
            value = editText(entry)
            change(value)
        },
    ) {}
    effect(on=value, @mount(v) {
        setEditText(entry, v)
    })
}

// As ui.input's, but for Enter, which is a line of the text: the text is
// committed as the focus leaves it.
const component ui.textarea[platform](value, rows, focusable, style, @input, @change) {
    TextArea #area(
        rows = rows,
        look = lookOf(style),
        @change {
            if editText(area) != value {
                value = editText(area)
                input(value)
            }
        },
        @commit {
            value = editText(area)
            change(value)
        },
    ) {}
    effect(on=value, @mount(v) {
        setEditText(area, v)
    })
}

// A bar given no value is indeterminate, Win32's marquee. Written as two
// bars rather than one with a conditional fraction, as gtk4's is.
const component ui.progress[platform](style, value, max, label, showValue) {
    if value != null {
        Progress(fraction=value / max, text=label, showText=showValue, look=lookOf(style)) {}
    } else {
        Progress(fraction=-1.0, text=label, showText=showValue, look=lookOf(style)) {}
    }
}

// One drop-down, offered the choices' labels whenever they change and
// selecting the label of the bound value whenever it does, as gtk4's is.
// `placeholder`, `focusable` and the focus events have nothing to reach.
const component ui.select[platform](value, disabled, focusable, style, @change, options) {
    Select #drop(enabled=!disabled, look=lookOf(style), @change {
        var at = ui.choiceLabeled(options, selectedLabel(drop))
        if at >= 0 && options[at].value != value {
            value = options[at].value
            change(options[at].value)
        }
    }) {}
    effect(on={labels=options.map(func(o) => o.label).format("\n"), drop=drop}, @mount(k) {
        offerChoices(drop, k.labels, ui.choiceLabel(options, value))
    })
    effect(on=value, @mount(v) {
        offerChoices(drop, options.map(func(o) => o.label).format("\n"), ui.choiceLabel(options, v))
    })
}

// A test picks the choice holding `value` through the drop-down, which
// knows its choices by label.
func ui.select[T].change[platform](value) {
    selectLabel(drop, ui.choiceLabel(options, value))
}

// A timer is the runtime's, on the window every node is made in: the effect
// arms it as its branch mounts and cancels it as it goes, as gtk4's does.
const component time.timer[platform](interval, enabled, @tick) {
    var handle = 0

    if enabled {
        effect(
            on = interval,
            @mount(d) { handle = _rtEvery(int(d), tick) },
            @unmount(d) {
                _rtCancel(handle)
            },
        )
    }
}

const component ui.vbox[platform](style, children) {
    Box(vertical=true, look=boxLookOf(style, 6)) {
        children
    }
}

const component ui.hbox[platform](style, children) {
    Box(vertical=false, look=boxLookOf(style, 6)) {
        children
    }
}

const component ui.spacer[platform](style) {
    Spacer(look=lookOf({flex=1, ...style})) {}
}

// A busy indicator is a progress bar's marquee.
const component ui.spinner[platform](label, style) {
    Progress(fraction=-1.0, text=label, showText=false, look=lookOf(style)) {}
}

// `label` has nowhere to go: an etched line draws no text.
const component ui.divider[platform](style, direction) {
    Divider(vertical=direction == "vertical", look=lookOf(style)) {}
}

const component ui.link[platform](text, href, disabled, style, @click) {
    Link(text=text, href=href, enabled=!disabled, look=lookOf(style), @click { click() }) {}
}

// A check box, Win32 having no switch.
const component ui.toggle[platform](label, checked, disabled, style, @change) {
    CheckBox #box(label=label, checked=checked, enabled=!disabled, look=lookOf(style), @click {
        if isChecked(box) != checked {
            checked = isChecked(box)
            change(checked)
        }
    }) {}
}

// The buttons of a group are a box's, which Win32 unchecks the others of as
// one is checked.
const component ui.radio[platform](value, disabled, direction, style, @change, options) {
    // A choice of the option holding `v`, a button's or a test's.
    func pickValue(v T) {
        if v != value {
            value = v
            change(v)
        }
    }
    Box(vertical=direction == ui.Orientation.vertical, look=boxLookOf(style, 6)) {
        for var opt = options {
            Radio #button(label=opt.label, checked=opt.value == value, enabled=!disabled, @click {
                if isPicked(button) {
                    pickValue(opt.value)
                }
            }) {}
        }
    }
}

// A test picks the option holding `value` as pressing its button does.
func ui.radio[T].change[platform](value) {
    pickValue(value)
}

const component ui.toolbar[platform](style, controls) {
    Box(vertical=false, look=boxLookOf(style, 4)) {
        controls
    }
}

// Laid out `columns` to a row, or flowing where it has none.
const component ui.grid[platform](columns, style, children) {
    Box(vertical=false, mode=gridMode(columns), columns=gridColumns(columns), look=boxLookOf(style, 6)) {
        children
    }
}

const func gridMode(columns option[int]) => columns == null ? BoxMode.flow : BoxMode.grid

const func gridColumns(columns option[int]) => columns == null ? 0 : columns

const component ui.stack[platform](style, layers) {
    Box(vertical=true, mode=BoxMode.stack, look=lookOf(style)) {
        layers
    }
}

// The panes share the box evenly, so `position`, its bounds and `@resize`
// have nothing to reach, as on gtk4.
const component ui.splitview[platform](style, direction, panes) {
    Box(vertical=direction == "vertical", mode=BoxMode.equal, look=lookOf(style)) {
        panes
    }
}

// A card is a framed box, and a clickable one is pressed as a button is.
const component ui.card[platform](style, clickable, @click, content) {
    if clickable {
        Box(vertical=true, framed=true, look=boxLookOf(style, 6), @click { click() }) {
            content
        }
    } else {
        Box(vertical=true, framed=true, look=boxLookOf(style, 6)) {
            content
        }
    }
}

// Shown in place while it is open, as on gtk4.
const component ui.drawer[platform](style, open, content) {
    Box(vertical=true, visible=open, look=boxLookOf(style, 6)) {
        content
    }
}

const component ui.popover[platform](style, open, content) {
    Box(vertical=true, framed=true, visible=open, look=boxLookOf(style, 6)) {
        content
    }
}

// A tab is a page of a tab control, which shows a tab for it. `variant` is
// the control's look, which Win32's theme draws.
const component ui.tabs[platform](selected, style, @change, items) {
    Tabs #strip(selected=selected, look=lookOf(style)) {
        for var k, t = items {
            TabPage(title=t.label, enabled=!t.disabled, @change {
                selected = k
                change(k)
            }) {
                t.content
            }
        }
    }
}

// A test chooses the tab at `index` as a click on it does.
func ui.tabs.change[platform](index) {
    pickTab(strip, index)
}

// `@scroll` and `@scrollEnd` have nothing to reach: the runtime reports only
// the end arriving.
const component ui.scroll[platform](style, direction, @reachEnd, content) {
    Scroll(axes=direction, look=lookOf(style), @reachEnd { reachEnd() }) {
        content
    }
}

// The trigger's box shows the tip as the pointer rests on it. `position`
// and `delay` are the system's.
const component ui.tooltip[platform](style, text, trigger) {
    Box(vertical=true, tip=text, look=lookOf(style)) {
        trigger
    }
}

// A window of its own, owned by the program's and modal over it. Its style
// and `size` have nothing to reach: the window is sized to what it holds.
const component ui.modal[platform](open, title, closable, @close, content) {
    Modal(title=title, open=open, closable=closable, @closed { close() }) {
        content
    }
}

// A menu bar is the window's, wherever it is written in it: its entries
// join the menu bar of the window they are in, and take no room where they
// are.
const component ui.menubar[platform](style, items) {
    Box(vertical=false, visible=false, look=lookOf(style)) {
        for var it = items {
            MenuEntry(label=it.label, disabled=it.disabled, checked=it.checked, @select { it.select() }) {
                for var sub = it.children {
                    MenuEntry(label=sub.label, disabled=sub.disabled, checked=sub.checked, @select { sub.select() }) {}
                }
            }
        }
    }
}

// Its top-level entries as buttons in place while it is open, as on gtk4: a
// popup menu Win32 tracks runs a loop of its own until it is dismissed.
const component ui.menu[platform](style, open, items) {
    Box(vertical=true, framed=true, visible=open, look=boxLookOf(style, 0)) {
        for var it = items {
            Button(text=it.label, enabled=!it.disabled, @click { it.select() }) {}
        }
    }
}
