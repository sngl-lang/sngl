func Gfx.image(url c.utf16, x float, y float, w float, h float)

// What a `@draw` handler is handed: the context, and the coordinate space
// the shapes were placed in.
struct DrawEvent {
    ctx    Gfx
    width  int
    height int
}

// The primitive every shape below paints through: its handler is spliced
// into the drawing, written against the canvas's context.
#[marks.intrinsic("win32:draw")]
component Paint(@draw(e DrawEvent)) draw.shape

// The window a `draw.canvas` is. Its width and height are the space its
// shapes are placed in, and `scalingMode` how that space is shown in the
// room it is given.
#[marks.intrinsic("win32:Canvas")]
component Canvas(
    width       ui.measurement,
    height      ui.measurement,
    scalingMode draw.ScalingMode,
    @click(),
    @paint(ctx Gfx),
    shapes      ...component draw.shape,
) ui.node

// What a `drawSource` paints an image a URL names with.
struct SourceEvent {
    ctx Gfx
    url string
}

// The primitive a `canvasImage` paints its source through. `@url` paints an
// image a URL names; a drawing is painted in place rather than as a picture,
// its shapes between `@enter`, which maps the drawing's own space onto the
// box and clips to it, and `@leave`. The size in their payload is the
// drawing's.
#[marks.intrinsic("win32:drawSource")]
component drawSource(
    @url(e SourceEvent),
    @enter(e DrawEvent),
    @leave(e DrawEvent),
    source ...component family.one[ui.imageSource],
) draw.shape

// A source showing what its shapes draw, `width` by `height` pixels: a
// picture whose bitmap the shapes paint, as the handler of its `@paint`, and
// a write to what they read paints again, as a canvas is.
#[marks.intrinsic("win32:ImageDrawing")]
component ImageDrawing(
    width  float,
    height float,
    @paint(ctx Gfx),
    shapes ...component draw.shape,
) ui.imageSource

