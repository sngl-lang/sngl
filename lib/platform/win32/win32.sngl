// An entry of the menu bar of the window it is in, wherever in the window
// it is, taking no room in its box; one holding entries is their submenu.
// `@select` is the user choosing it.
#[marks.intrinsic("win32:MenuEntry")]
component MenuEntry(label string, disabled bool, checked bool, @select(), entries ...component ui.node) ui.node

#[macro.cnative("sngl_win32_entry")]
func _rtEntry() MenuEntry

#[macro.cnative("sngl_win32_set_entry_disabled")]
func _rtSetEntryDisabled(e MenuEntry, disabled bool)

#[macro.cnative("sngl_win32_set_entry_checked")]
func _rtSetEntryChecked(e MenuEntry, checked bool)

// How many items the menu bar of the window `n` is in holds.
#[macro.cnative("sngl_win32_menu_items")]
func menuItems(n ui.node) int

// Chooses the entry labeled `label` in the menu bar of the window `n` is
// in, as the user does: a test's way to a menu. False where there is no
// such entry, or it is grayed.
#[macro.cnative("sngl_win32_choose")]
func chooseMenu(n ui.node, label c.utf16) bool

#[gen.protocol(create)]
func _create_MenuEntry() MenuEntry {
    return _rtEntry()
}

#[gen.protocol(append)]
func _append_MenuEntry(parent MenuEntry, child ui.node) {
    _rtAppend(parent, child)
}

#[gen.protocol(remove)]
func _remove_MenuEntry(parent MenuEntry, child ui.node) {
    _rtRemove(parent, child)
}

#[gen.protocol(insertBefore)]
func _insert_MenuEntry(parent MenuEntry, child ui.node, before ui.node) {
    _rtInsert(parent, child, before)
}

