// A drop-down list. Its choices are offered by label, and `@change` is one
// the user selects.
#[marks.intrinsic("win32:Select")]
component Select(enabled bool, look Look, @change()) ui.node

#[c.native("sngl_win32_select")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32Select")]
func _rtSelect() Select

#[c.native("SendMessageW")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.AddString")]
func _addString(s api.HWND, msg api.UINT, w api.WPARAM, #[c.type("LPARAM")] label c.utf16) api.LRESULT

// Offers a drop-down the labels `labels` joins with newlines and selects
// `chosen` where one of them is it, reporting neither: CB_SETCURSEL
// reports nothing. A drop-down keeps its choices in the order offered, so
// the first labeled `chosen` is its place among `labels`.
func offerChoices(s Select, labels string, chosen string) {
    var w = _handle(s)
    api.SendMessage(w, 331, 0, 0)
    var at = -1
    if labels != "" {
        var each = labels.split("\n")
        var i = 0
        for i < each.length() {
            _addString(w, 323, 0, each[i])
            if at < 0 && each[i] == chosen {
                at = i
            }
            i += 1
        }
    }
    api.SendMessage(w, 334, at, 0)
    _relayout(w)
}

// The label of the choice a drop-down has selected, or "".
#[c.native("sngl_win32_selected")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32Selected")]
func selectedLabel(s Select) string

// The place of the choice labeled `label` in a drop-down, or -1.
#[c.native("sngl_win32_find_choice")]
#[go.native("duckfam.us/sngl/lib/platform/win32/cgo", "cgo.SnglWin32FindChoice")]
func _findChoice(s api.HWND, label c.utf16) int

// Selects the choice labeled `label` as the user's pick does, which reports
// it: CB_SETCURSEL, then CBN_SELCHANGE.
func selectLabel(s Select, label string) {
    var w = _handle(s)
    api.SendMessage(w, 334, _findChoice(w, label), 0)
    _notify(w, 1)
}

