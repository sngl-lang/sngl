import time "sngl:time"
import build "sngl:build"
import . "sngl:internal/marks"
import family "sngl:family"
import shapes "sngl:ui/draw"
import ui "sngl:ui"
import markup "sngl:ui/markup"
import nav "sngl:ui/nav"
import gen "sngl:x/gen"

// The `none` node of a build directive: the interpreter as a build target.
//
// The one withdrawal, and it is the interpreter's only one because every other
// gated pass compensates for something a backend cannot emit -- and there is no
// backend here. This one is different in kind: `internal/interp` *does*
// evaluate a spread itself (`eval.go` merges the source struct's fields), so
// the flattening is not something the runtime needs. It is kept because the
// withdrawal predates this package and nothing records why; the whole suite
// passes without it, which makes removing it a change to make deliberately
// rather than in passing.
//
// `instanceState` because the interpreter scopes a component's state per
// instance: each mount is an environment of its own.
#[gen.can(instanceState)]
#[gen.cannot(structSpread)]
#[gen.name("none")]
component platform() build.platform

// A deadline that recurs. The interpreter's clock finds these in the rendered
// tree and fires each one's `@tick` when the clock reaches its deadline.
//
// It is a node, so its position is its lifetime: one written under an `if` is
// scheduled only while that branch renders, and one in a child component is
// scheduled because the child rendered it. That is the whole reason `timer`
// stopped being a compiler concept -- a schedule hoisted onto the component had
// neither.
#[intrinsic("none:Timer")]
component Timer<F>(
    interval time.duration,
    enabled  bool,
    @tick,
) F

const component[platform] time.timer {
    if enabled {
        Timer(interval=interval, enabled=true, @tick { tick() })
    }
}

// The drawing tree renders nothing here, which is a thing to say rather than a
// gap to leave: the interpreter has no surface to paint on, so a shape it is
// handed is a node in the tree and nothing more. `sngl test` asserts on that
// tree, so the shapes have to reach it, and an empty body is exactly what
// leaves the node in place and draws none of it.
//
// Written out rather than omitted because omitting them is indistinguishable
// from an implementation nobody got to: every other target answers this
// question per shape, and `reportBodylessLibComponents` asks it of this one
// too.
const component[platform] shapes.rect {}

const component[platform] shapes.circle {}

const component[platform] shapes.ellipse {}

const component[platform] shapes.line {}

const component[platform] shapes.path {}

const component[platform] shapes.canvasText {}

const component[platform] shapes.canvasImage {}

const component[platform] shapes.image {}

// --- Widgets ---
//
// A control a test drives: what a host would hand an override when the user
// types or clicks, a test's trigger hands this, and the override writes the
// prop the control reports from it as on every other target. `value` is what
// the control shows. A snapshot prints the sngl:ui component rendering one,
// as the widget a compiled target's snapshot would show.
#[intrinsic("none:Control")]
component Control<T>(
    value T,
    @input(value T),
    @change(value T),
) ui.node

// The interpreter draws no widget, so each sngl:ui widget is answered the way a
// shape is: an empty body leaves the node standing in the tree with its props,
// which is what `sngl test` asserts on and a snapshot prints. The form
// controls are the exception, rendering a Control a trigger reaches. Written
// out for the reason the shapes are -- the declarations are bodyless, and a
// target that says nothing about one is a build failure.
const component[platform] ui.vbox {}

const component[platform] ui.hbox {}

const component[platform] ui.stack {}

const component[platform] ui.scroll {}

const component[platform] ui.spacer {}

const component[platform] ui.divider {}

const component[platform] ui.splitview {}

const component[platform] ui.card {}

const component[platform] ui.drawer {}

const component[platform] ui.text {}

// An image holds the source it shows, or the placeholder where it has none,
// which is what a snapshot prints beneath the description. A source stands as
// itself, with its URL or its shapes.
#[intrinsic("none:image")]
component image(alt string, fit ui.ObjectFit, @click(), content ...component ui.node) ui.node

const component[platform] ui.image {
    image(alt=alt, fit=fit, @click { click() }) {
        #[family.crosses]
        src {
            placeholder
        }
    }
}

const component[platform] ui.file {}

const component[platform] ui.remote {}

const component[platform] ui.progress {}

const component[platform] ui.spinner {}

const component[platform] ui.table {}

const component[platform] ui.tree {}

const component[platform] ui.button {}

const component[platform] ui.input {
    Control(
        value = value,
        @input(v) {
            value = v
            input(v)
        },
        @change(v) {
            value = v
            change(v)
        },
    )
}

const component[platform] ui.textarea {
    Control(
        value = value,
        @input(v) {
            value = v
            input(v)
        },
        @change(v) {
            value = v
            change(v)
        },
    )
}

const component[platform] ui.checkbox {
    Control(value=checked, @change(on) {
        checked = on
        change(on)
    })
}

const component[platform] ui.radio {
    Control(value=value, @change(v) {
        value = v
        change(v)
    })
}

const component[platform] ui.toggle {
    Control(value=checked, @change(on) {
        checked = on
        change(on)
    })
}

const component[platform] ui.select {
    Control(value=value, @change(v) {
        value = v
        change(v)
    })
}

const component[platform] ui.datepicker {
    Control(value=value, @change(v) {
        value = v
        change(v)
    })
}

const component[platform] ui.link {}

const component[platform] ui.menu {}

const component[platform] ui.menubar {}

const component[platform] ui.toolbar {}

const component[platform] ui.modal {}

// --- Rich text ---
//
// The span family, implemented the way the shapes above are and for the same
// reason: the interpreter has no surface, so what an implementation here owes
// is the *tree* rather than a rendering of it. `sngl test` asserts on that
// tree and a snapshot prints it, so a flow reaches a test as the words the
// author wrote, nested as they were written.
//
// Two primitives and a table of overrides, which is the division html makes.
// `text` and `image` need neither: they carry no content, so an empty body
// leaves the member itself standing with its props, and the member's own name
// is the most useful thing a snapshot can print for one.
//
// What the other four need is a node that survives the expansion. A member
// whose body inserts its content is a component with a body, and a snapshot
// prints a component's expansion rather than the component -- so a `run` whose
// body were the bare content would put its words in the tree and lose the
// style that is the whole of what a run says.

// A flow of spans, as a node. `richText` cannot insert its own content: the
// component is a `ui.node` and its slot is the span family, so a span at the
// root of its body is the ordinary membership error. This is the one
// declaration here that joins the widget family and hosts the span one, which
// is the pair html declares for the same reason.
//
// It takes the role and not the style. Both are on the `richText` node above
// it either way -- the tree holds every member it mounted, and only the
// snapshot skips an expanded one -- and a printed document in which every
// paragraph carried forty style fields is one nobody reads. The role is what a
// flow *means*, which is the half a test asserts on.
#[intrinsic("none:flow")]
component flow(
    role    markup.Role,
    content ...component markup.span,
) ui.node

// One span, and the three things a member varies that its own name does not
// already say. Each override below writes the one prop it has, so a snapshot
// prints `inline(href=…)` for a link and nothing extra for the words inside
// it.
#[intrinsic("none:inline")]
component inline(
    style   markup.SpanStyle,
    href    string,
    kind    markup.Token,
    content ...component markup.span,
) markup.span

const component[platform] markup.richText {
    flow(role=role) {
        content
    }
}

const component[platform] markup.text {}

const component[platform] markup.image {}

const component[platform] markup.run {
    inline(style=style) {
        content
    }
}

const component[platform] markup.link {
    inline(href=href) {
        content
    }
}

const component[platform] markup.token {
    inline(kind=kind) {
        content
    }
}

// --- Navigation ---

// A stack of pages, answered by the interpreter by id. It mounts every page it
// holds, so each page's handle is bound to a value whether it is showing or
// not, and each page registers itself with the stack as it mounts; only the
// one showing renders what it holds. With nothing showing yet, the stack
// starts at the page whose href is "/", or its first. Which page shows, and
// with what params, is the interpreter's state, kept on the stack's instance.
//
// The pages' family is sngl:ui/nav's and unexported, so the slot takes it as
// a type parameter, bound by the pages written there.
// A window, as the interpreter mounts one: what it renders, under the boundary
// its `@error` is, which catches whether or not the call site handles one.
// Nothing draws it, so its title and its `visible` are state a test reads and
// nothing shows.
#[intrinsic("none:Window")]
component Window(content ...component ui.node) root

const component[platform] ui.window {
    Window {
        boundary(@error(e) { error(e) }) {
            content
        }
    }
}

#[intrinsic("none:Stack")]
component Stack<F>(pages ...component F) ui.node

// A page as the interpreter mounts it: its content, when its stack is showing
// this page, and nothing otherwise -- a page not showing is not mounted. It is
// a node, which is what it renders; the override crosses it into the page
// family it stands in for, which is not nameable here.
#[intrinsic("none:Page")]
component Page(href string, title string, content ...component ui.node) ui.node

const component[platform] nav.stack {
    Stack {
        pages
    }
}

const component[platform] nav.page {
    #[family.crosses]
    Page(href=href, title=title) {
        content(params)
    }
}
