import ir "sngl:internal/ir"
import marks "sngl:internal/marks"

// Marks a struct as naming a tree. The struct is the tree: nothing is stored in
// it and no value of it exists, so a component naming it says which family it
// is a member of rather than what it holds.
//
// A name resolves or it does not, which is the point — a misspelled tree is an
// unresolved name at the declaration rather than a family nobody joins.
func kind() ir.Macro

// The tree an ordinary component belongs to: the one whose members are
// interchangeable, where a container hosts anything. A component that names no
// tree is a member of this one, and a slot that names no type accepts it.
#[marks.builtin("treeDefault")]
struct default {}

// Exactly one member of the tree T, as a slot's content type. Bare `T` accepts
// any number, so this is what narrows it; `option<T>` is the other narrowing.
//
// T defaults to the tree an ordinary component belongs to, so `tree.one` on its
// own says "exactly one child, of whatever family the slot already accepts".
#[marks.builtin("treeOne")]
struct one<T = default> {}
