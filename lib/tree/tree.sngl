// Package tree describes a segmented component tree: one whose nodes are not
// interchangeable widgets but members of a named family, where a container
// accepts only its own family's members.
//
// A canvas and its shapes are one such tree; rich text (paragraphs, inline
// runs) and menus (items, separators) are others. Nothing here knows what a
// shape is — the compiler compares declarations.
//
// A slot declares which family its content belongs to by naming that family's
// type, and how many of them it takes by wrapping it: bare is any number,
// `tree.one<T>` is exactly one, `option<T>` is none or one.

import ir "sngl://internal/ir"
import . "sngl://internal/marks"

// Names the tree this component is a member of.
//
// A member's children are implicitly members of the same tree, so a shape
// contains only shapes without saying so. A component that declares a children
// type of its own, or carries `children`, says what it accepts instead.
func kind(name string) ir.Macro {}

// Names the tree this component's children must be members of.
//
// Written alone it makes a container that is not itself a member — a canvas
// hosts shapes but is not one. Written alongside `kind` it makes a member that
// hosts a different family, which is how a rich-text block holds inline runs.
func children(name string) ir.Macro {}

// Exactly one member of the tree T, as a slot's content type. Bare `T` accepts
// any number, so this is what narrows it; `option<T>` is the other narrowing.
#[builtin("treeOne")]
struct one<T> {}
