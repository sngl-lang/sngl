// Dates, clock values and the passage of time: the `date` or `time` a value
// falls on, the `duration` between two of them, and the `timer` that fires
// every duration.
//
// None of this is ambient. A program that never asks what time it is never
// names any of it, which is why these are imported rather than in scope
// everywhere.
//
// `date`, `time` and `datetime` are string-representable, as `color` is: a
// string literal in the canonical form coerces to one, and one coerces back
// to that form. Platform codegen maps all three to the host's native
// date/time type (Go `time.Time`, JS/Kotlin string).

import . "sngl:internal/marks"

// Calendar date in canonical "YYYY-MM-DD" form.
#[builtin("date")]
struct date {}

// Wall-clock time in "HH:MM" or "HH:MM:SS" form.
#[builtin("time")]
struct time {}

// ISO-8601 date and time together.
#[builtin("datetime")]
struct datetime {}

// Time quantity used by `timer.interval` and animation APIs. Unit
// literals: `ms`, `s`, `m`, `h`.
//
// The mark lets a foreign-type importer hand out this type where it has no
// scope to resolve the name in — a Go `time.Duration` maps to it.
#[builtin("duration")]
unit duration { ms, s = 1000ms, m = 60s, h = 60m }

// Periodic callback. Fires `@tick` every `interval` while `enabled`
// is true. Toggling `enabled` is the idiomatic way to start and stop
// the timer; the timer is automatically cleaned up when the component
// unmounts. Intervals below the platform's frame budget may coalesce.
#[builtin("timer")]
component timer(
    interval duration,
    enabled bool,
    @tick,
) {}
