import marks "sngl:internal/marks"
import macro "sngl:macro"
import tree "sngl:tree"

// Calendar date in canonical "YYYY-MM-DD" form.
#[marks.builtin("date")]
struct date {}

// Wall-clock time in "HH:MM" or "HH:MM:SS" form.
#[marks.builtin("time")]
struct time {}

// ISO-8601 date and time together.
#[marks.builtin("datetime")]
struct datetime {}

// Time quantity used by `timer.interval` and animation APIs. Unit
// literals: `ms`, `s`, `m`, `h`.
//
// The mark lets a foreign-type importer hand out this type where it has no
// scope to resolve the name in — a Go `time.Duration` maps to it.
#[marks.builtin("duration")]
unit duration { ms, s = 1000ms, m = 60s, h = 60m }

// Periodic callback. Fires `@tick` every `interval` while `enabled`
// is true. Toggling `enabled` is the idiomatic way to start and stop
// the timer; the timer is automatically cleaned up when the component
// unmounts. Intervals below the platform's frame budget may coalesce.
//
// `enabled` defaults to true because omitting it has always meant an always-on
// timer. It carries the default rather than each backend reading a missing
// value as "no gate", since every implementation writes the gate as the
// position it places its primitive at -- and a position needs a value to test.
//
// The body is each target's. There is no compiler construct behind this
// declaration: `sngl:platform/<name>` overrides it with the primitive that
// platform schedules with, which is why a timer's branch, its component
// boundary and its interval are answered by the tree it renders into rather
// than by a list the checker hoisted it onto.
//
// A timer belongs to no tree: it schedules and renders nothing, so it sits
// wherever the work it drives belongs.
#[tree.none]
component timer(
    #[macro.construct] interval duration,
    #[macro.construct] enabled bool = true,
    @tick,
) {}

// The current instant, as the host's clock reports it.
//
// `readonly` is the load-bearing half of this mark and the easiest thing here
// to delete by accident. A library function with no body is typed *pure*, and
// a pure call is a compile-time constant -- so unflagged, a clock reading is
// accepted wherever a constant is demanded, and the value a build ships is the
// one the build machine read. An `output` option is the position that shows
// it: read once, before the program runs.
#[marks.intrinsic("time.now", readonly)]
func now() datetime

// The instant `d` after this one. A negative duration moves back.
#[marks.intrinsic("datetime.add")]
func datetime.add(d duration) datetime

// How long `start` is before `end`; negative when it is after.
//
// A package function and not a `datetime` method, which is not a style
// choice: a method's first parameter *is* the receiver when it carries the
// receiver's own type (`resolve.go`'s convention, what lets `int.ident(1)`
// mean `1.ident()`), so no `datetime` method can take a second instant.
#[marks.intrinsic("time.between")]
func between(start datetime, end datetime) duration

// How long ago `t` was, negative while it is still ahead.
//
// A SNGL body rather than a third intrinsic: it inherits `now`'s impurity
// through the purity fixed point, so nothing here restates the rule above.
func since(t datetime) duration {
    return between(t, now())
}

// What remains until `t`, negative once it has passed.
func until(t datetime) duration {
    return between(now(), t)
}
