// Clock values and the passage of time: the `time` a value is read at, the
// `duration` between two of them, and the `timer` that fires every duration.
//
// None of this is ambient. A program that never asks what time it is never
// names these, which is why they are imported rather than in scope
// everywhere -- `date` and `datetime` stay in `sngl:builtin` because they
// are what a stored value is typed as rather than a clock to read.

import . "sngl:internal/marks"

// Wall-clock time in "HH:MM" or "HH:MM:SS" form. String-representable like
// `date`; coerces to/from its canonical string form. Platform codegen maps
// it to the native date/time type.
#[builtin("time")]
struct time {}

// Time quantity used by `timer.interval` and animation APIs. Unit
// literals: `ms`, `s`, `m`, `h`.
//
// The mark lets a foreign-type importer hand out this type where it has no
// scope to resolve the name in — a Go `time.Duration` maps to it.
#[builtin("duration")]
unit duration { ms, s = 1000ms, m = 60s, h = 60m }

// Periodic callback. Fires `@tick` every `interval` while `enabled`
// is true. Toggling `enabled` is the idiomatic way to start and stop
// the timer; the timer is automatically cleaned up when the component
// unmounts. Intervals below the platform's frame budget may coalesce.
#[builtin("timer")]
component timer(
    interval duration,
    enabled bool,
    @tick,
) {}
