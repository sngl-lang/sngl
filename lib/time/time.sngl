import marks "sngl:internal/marks"
import macro "sngl:macro"

// Calendar date in canonical "YYYY-MM-DD" form.
#[marks.builtin("date")]
struct date {}

// The year of a date.
const func date.year(d date) => int.parse(string(d).substring(0, 4), 10)

// The month of a date, from 1 for January.
const func date.month(d date) => int.parse(string(d).substring(5, 7), 10)

// The day of a date's month, from 1.
const func date.day(d date) => int.parse(string(d).substring(8, 10), 10)

// The date "YYYY-MM-DD" names, or null when the text is not one: a month past
// 12, or a day past the last of its month, is no date. Text a program did not
// write -- what a user typed -- is read this way, since converting it with
// `date(s)` takes it on trust.
const func parseDate(s string) option<date> {
    // An option nothing set holds no date. `null` is sngl:builtin's, and
    // this package loads before that one is in scope.
    var unset option<date>
    if s.length() != 10 || s.substring(4, 5) != "-" || s.substring(7, 8) != "-" {
        return unset
    }
    if !_digits(s.substring(0, 4) + s.substring(5, 7) + s.substring(8, 10)) {
        return unset
    }
    var y = int.parse(s.substring(0, 4), 10)
    var m = int.parse(s.substring(5, 7), 10)
    var d = int.parse(s.substring(8, 10), 10)
    if m < 1 || m > 12 || d < 1 || d > _daysIn(y, m) {
        return unset
    }
    return date(s)
}

// Whether t is all decimal digits.
const func _digits(t string) bool {
    if t == "" {
        return true
    }
    return "0123456789".contains(t.substring(0, 1)) && _digits(t.substring(1, t.length()))
}

// The days in month m of year y, February counting the leap day.
const func _daysIn(y int, m int) int {
    if m == 2 {
        if (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 {
            return 29
        }
        return 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30
    }
    return 31
}

// Wall-clock time in "HH:MM" or "HH:MM:SS" form.
#[marks.builtin("time")]
struct time {}

// ISO-8601 date and time together.
#[marks.builtin("datetime")]
struct datetime {}

// Time quantity used by `timer.interval` and animation APIs. Unit
// literals: `ms`, `s`, `m`, `h`.
//
// The mark lets a foreign-type importer hand out this type where it has no
// scope to resolve the name in — a Go `time.Duration` maps to it.
#[marks.builtin("duration")]
unit duration { ms, s = 1000ms, m = 60s, h = 60m }

// Periodic callback. Fires `@tick` every `interval` while `enabled`
// is true. Toggling `enabled` is the idiomatic way to start and stop
// the timer; the timer is automatically cleaned up when the component
// unmounts. Intervals below the platform's frame budget may coalesce.
//
// `enabled` defaults to true because omitting it has always meant an always-on
// timer. It carries the default rather than each backend reading a missing
// value as "no gate", since every implementation writes the gate as the
// position it places its primitive at -- and a position needs a value to test.
//
// The body is each target's. There is no compiler construct behind this
// declaration: `sngl:platform/<name>` overrides it with the primitive that
// platform schedules with, which is why a timer's branch, its component
// boundary and its interval are answered by the tree it renders into rather
// than by a list the checker hoisted it onto.
//
// A timer belongs to no tree: it schedules and renders nothing, so it sits
// wherever the work it drives belongs.
component timer<F>(
    #[macro.construct] interval duration,
    #[macro.construct] enabled bool = true,
    @tick,
) F {}
