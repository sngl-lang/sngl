import marks "sngl:internal/marks"

// Receiver type for test-only helpers. Used by the test runner:
// each test function declares `t test.Test` as its first parameter and the
// runner injects a value that carries the assertion facility. Tests
// are top-level functions whose name starts with "test" and that call
// `t.assert(cond)` to declare expected conditions.
struct Test {}

// Asserts that b is true; fails the enclosing test otherwise. The
// assertion records a failure on the test and continues executing
// so that multiple failures can be reported from a single run.
#[marks.intrinsic("test.assert")]
func Test.assert(b bool)

// Like assert, but stops the test immediately when b is false. Use
// must when subsequent statements would crash or be meaningless if
// the condition fails (e.g. checking a value before dereferencing it).
#[marks.intrinsic("test.must")]
func Test.must(b bool)

// Override the active locale for the duration of this test. Subsequent
// i18n calls (i18n.tr, i18n.format, i18n.date, etc.) use this locale
// until the test returns. Useful for asserting on locale-specific output.
// Deprecated: use t.setContext(locale, loc) once the locale context is in scope.
#[marks.intrinsic("test.setLocale")]
func Test.setLocale(loc string)

// Override a context value for the duration of this test. The first argument
// names the context (a bare context name, a reference to its declaration);
// the second is the new value, of the context's type. Subsequent reads of the
// context — including component vars initialised from it — see the overridden
// value. Replaces t.setLocale when the locale context is declared.
#[marks.intrinsic("test.setContext")]
func Test.setContext[V any](
    ctx   V, // the context to set
    value V, // what it reads from here on
)

// Pump the platform main loop until either the predicate returns true
// or the timeout (in milliseconds) elapses. Used to gate assertions on
// asynchronous reactivity (timers, debounced handlers). The predicate
// is evaluated repeatedly between settle steps.
#[marks.intrinsic("test.wait")]
func Test.wait(predicate func() bool, timeout_ms int)

// Capture the current platform render and assert it matches the golden
// stored at `<fixture>.snapshots/<name>.<ext>`. Under SNGL_UPDATE_SNAPSHOTS=1
// the golden is (re)written from the current capture instead of compared.
// The capture format (ANSI text, PNG, etc.) is chosen by the platform.
#[marks.intrinsic("test.snapshot")]
func Test.snapshot(name string)

// Advances the test's clock to the next timer deadline and fires every timer
// due then, as the running program's clock would.
#[marks.intrinsic("test.tick")]
func Test.tick()

// Runs body as a subtest named desc, on a snapshot of the state the enclosing
// test has reached: what the subtest changes, its siblings do not see. body
// takes the subtest's own Test and the component the enclosing test took,
// whose type its annotation names.
#[marks.intrinsic("test.test")]
func Test.test[C any = struct {}](desc string, body func(Test, C))
