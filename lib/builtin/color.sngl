import marks "sngl:internal/marks"

// RGBA color with 8-bit channels. Component values range 0-255; alpha
// defaults to fully opaque (255). Colors can be constructed in three
// equivalent ways: a hex literal in place of a color expression, the
// `color.rgb(r, g, b)` and `color.rgba(r, g, b, a)` helpers, or a struct
// literal `color{r=..., g=..., b=..., a=...}`. Hex literals accept three,
// four, six, or eight digits — `#RGB`, `#RGBA`, `#RRGGBB`, `#RRGGBBAA` —
// where the short forms expand CSS-style by doubling each digit (`#f00` is
// `#ff0000`).
// Derived colors (lighten, darken, opacity-adjust) are available via
// the functions on the `color` receiver.
#[marks.builtin("color")]
struct color {
    r uint8 = 0
    g uint8 = 0
    b uint8 = 0
    a uint8 = 255
}

// Builds an opaque color from 0-255 RGB components. Values outside
// that range are clamped by downstream consumers; pass literal ints.
const func color.rgb(r int, g int, b int) color { return color{r=uint8(r), g=uint8(g), b=uint8(b), a=255} }

// Builds a color from 0-255 RGB components and an explicit 0-255
// alpha. Use when transparency is needed; otherwise prefer
// `color.rgb` for clarity.
const func color.rgba(r int, g int, b int, a int) color { return color{r=uint8(r), g=uint8(g), b=uint8(b), a=uint8(a)} }

// Returns a copy of c with alpha replaced by a (0-255). Useful for
// deriving translucent variants of a base color while keeping the
// hue stable.
const func color.opacity(c color, a int) color { return color{r=c.r, g=c.g, b=c.b, a=uint8(a)} }

// Renders c as `#RRGGBB`, or `#RRGGBBAA` when it is not opaque: a colour is
// its complete value, and dropping alpha would print two different colours
// the same.
#[marks.intrinsic("color.hex")]
const func color.hex(c color) string

// Mixes c toward white by pct (0.0-1.0) on each RGB channel,
// preserving alpha. `lighten(c, 0.0)` returns c; `lighten(c, 1.0)`
// returns opaque white at c's alpha.
const func color.lighten(c color, pct float) color {
    var ret = color{r=c.r, g=c.g, b=c.b, a=c.a}
    ret.r = uint8(int.min(255, int(c.r) + int(float(255 - int(c.r)) * pct)))
    ret.g = uint8(int.min(255, int(c.g) + int(float(255 - int(c.g)) * pct)))
    ret.b = uint8(int.min(255, int(c.b) + int(float(255 - int(c.b)) * pct)))
    return ret
}

// Mixes c toward black by pct (0.0-1.0) on each RGB channel,
// preserving alpha. `darken(c, 0.0)` returns c; `darken(c, 1.0)`
// returns black at c's alpha.
const func color.darken(c color, pct float) color {
    var ret = color{r=c.r, g=c.g, b=c.b, a=c.a}
    ret.r = uint8(int(float(int(c.r)) * (1.0 - pct)))
    ret.g = uint8(int(float(int(c.g)) * (1.0 - pct)))
    ret.b = uint8(int(float(int(c.b)) * (1.0 - pct)))
    return ret
}
