// The predeclared constants.
//
// Declarations rather than names the parser knows, so they resolve through the
// scope chain and a declaration of your own by any of these names shadows
// them, like any other name.
import . "sngl://internal/marks"

const (
    true = 0 == 0
    false = 0 != 0
)

// The absence of a value. Assignable to any `option<T>`, and what a bare
// `option<T>` holds until one is given.
//
// The written value is a placeholder the compiler replaces: `null` has no
// literal to be declared with, and its type is not one that can be spelled.
#[builtin("null")]
const null = 0

// The platform this build targets. Compare it against a platform's own
// identity const — `PLATFORM == html.platform` — to gate code on the target;
// the comparison folds at build time and the branch not taken is removed. The
// compiler supplies the value.
//
// Its type is `platform`, not `string`: `PLATFORM == "html"` does not compile,
// so a target name cannot be misspelled into a branch that is silently never
// taken.
#[builtin("targetPlatform")]
const PLATFORM = ""

// The language this build emits: `LANGUAGE == go.language`. Behaves like
// PLATFORM in every respect.
#[builtin("targetLanguage")]
const LANGUAGE = ""
