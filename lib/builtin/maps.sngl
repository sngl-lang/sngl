// Key-value collections.

import . "sngl:internal/marks"

// K is the key type (must be comparable); V is the value type.
#[builtin("map")]
struct map<K, V> {}

// Number of entries currently in m.
#[intrinsic("map.length")]
func map<K, V>.length() int { return 0 }

// List of keys in m in unspecified order.
#[intrinsic("map.keys")]
func map<K, V>.keys() list<K> { return [] }

// List of values in m in unspecified order.
#[intrinsic("map.values")]
func map<K, V>.values() list<V> { return [] }

// True iff key exists in m.
#[intrinsic("map.contains")]
func map<K, V>.contains(key K) bool { return false }

// Lookup with default — returns the value if key is present in m,
// otherwise returns the default value. Both are coerced to match the
// declared value type.
#[intrinsic("map.get")]
func map<K, V>.get(key K, default V) V { return default }
