// K is the key type (must be comparable); V is the value type.
#[_builtin(map)]
struct map[K any, V any] {}

// Number of entries currently in m.
#[_intrinsic("map.length")]
const func map[K, V].length(this map[K, V]) int

// List of keys in m in unspecified order.
#[_intrinsic("map.keys")]
const func map[K, V].keys(this map[K, V]) list[K]

// List of values in m in unspecified order.
#[_intrinsic("map.values")]
const func map[K, V].values(this map[K, V]) list[V]

// True iff key exists in m.
#[_intrinsic("map.contains")]
const func map[K, V].contains(this map[K, V], key K) bool

// Lookup with default — returns the value if key is present in m,
// otherwise returns the default value. Both are coerced to match the
// declared value type.
#[_intrinsic("map.get")]
const func map[K, V].get(this map[K, V], key K, default V) V
