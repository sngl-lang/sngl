// The result type that makes a function a macro; sngl:internal/ir's `Macro`
// for this package alone. The marks below are what sngl:builtin writes on its
// own declarations, declared here so the package imports no macros: it is the
// first package checked, and what every other package's `int` and `string`
// resolve to. They are private, so a program writes sngl:internal/marks' and
// sngl:tree's, which the compiler answers the same way.
struct _Macro {}

// What the compiler may assume about a call to an intrinsic, as
// sngl:internal/ir's `IntrinsicFlag` says.
enum _IntrinsicFlag { mutates, readonly, mutatesReceiver, build }

// The constructs sngl:builtin's declarations dispatch to: the kinds of
// sngl:internal/marks' `builtin` this package writes. An enum rather than a
// string, so that `_builtin`'s signature names none of the scalars its own
// marks declare.
enum _Kind {
    bool
    dyn
    int
    int8
    int16
    int32
    int64
    uint8
    uint16
    uint32
    uint64
    float
    float32
    float64
    string
    color
    list
    map
    iter
    ref
    option
    null
    context
    effect
    errorBoundary
    output
    treeRoot
    platform
    language
    targetPlatform
    targetLanguage
}

// Names the IR construct a declaration dispatches to: sngl:internal/marks'
// `builtin`, written with the kind bare, `#[_builtin(int)]`. A scalar's mark is
// also what puts its name in scope before this package is checked (the
// compiler reads it off the source).
func _builtin(kind _Kind) _Macro

// Names the native implementation behind a function: sngl:internal/marks'
// `intrinsic`.
func _intrinsic(id string, flags list<_IntrinsicFlag> = []) _Macro

// Marks a component as belonging to no family: sngl:tree's `none`.
func _none() _Macro

// A truth value; `true` and `false` are its two.
#[_builtin(bool)]
struct bool {}

// A value the program says nothing about the type of.
#[_builtin(dyn)]
struct dyn {}
