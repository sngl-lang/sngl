import build "sngl:build"

// The platform this build targets. Compare it against a platform's
// build-target node — `PLATFORM == html.platform` — to gate code on the target;
// the comparison folds at build time and the branch not taken is removed. The
// compiler supplies the value.
//
// It is a value of sngl:build's `platform` family, as `html.platform` is: the
// node a platform package declares is the target, so there is no second way to
// name it. There is no literal, so `PLATFORM == "html"` does not compile, and a
// target name cannot be misspelled into a branch that is silently never taken.
#[_builtin(targetPlatform)]
const PLATFORM build.platform

// The language this build emits: `LANGUAGE == go.language`, a value of
// sngl:build's `language` family. Behaves like PLATFORM in every respect.
#[_builtin(targetLanguage)]
const LANGUAGE build.language
