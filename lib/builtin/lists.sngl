// Heterogeneous list. `list[T]` is the parameterized form; element type
// is inferred from literals. Methods on the `list` receiver
// (`length`, `push`, `filter`, `map`, …) cover the common operations and
// are all pure — they return new lists rather than mutating in place.
// T is the element type.
#[_builtin(list)]
struct list[T any] {}

// The elements' formats with sep between them, no brackets: what `"{xs}"`
// writes, `1, 2, 3`. A named argument the list does not declare is each
// element's: `"{xs, sep="; ", base=16}"` writes `a; b; c` of 10, 11, 12. Only
// a list of a type that declares a format has one.
const func list[T].format(sep string = ", ", _item _formatArgs[T]) => this.map(func(x T) => _format(x, _item))._join(sep)

// Puts the list's format on the end of out, each element by its own
// appendFormat.
func list[T].appendFormat(out ref[builder], sep string = ", ", _item _formatArgs[T]) {
    for var i, x = this {
        if i > 0 {
            out.add(sep)
        }
        _appendFormat(x, out, _item)
    }
}

// Number of items in l.

#[_intrinsic("list.length")]
const func list[T].length() int

// Appends item to the receiver list (`this`), in place. Index assignment
// (`l[i] = x`) and the mutating methods modify the list directly, and observers
// are notified exactly as assigning a var would be. Backed by the ListPush
// intrinsic, which carries the mutates-receiver semantics through to lowering
// and every backend (see ir.Intrinsics / ir.IntrinsicDef.MutatesReceiver).
//
// It returns nothing, so `l.push(x)` is the only way to write it. Returning the
// receiver made `l = l.push(x)` the obvious spelling and it means the same
// thing twice -- the push already did it -- which is a mutation dressed as a
// function of its argument. It also could not be honestly compiled: Go's
// append returns a new slice rather than mutating, so the two halves had to be
// emitted separately and no single expression said both.
#[_intrinsic("list.push", mutates, mutatesReceiver)]
func list[T].push(item T)

// Removes the item at index from the receiver list (`this`) in place.
// Out-of-range indices leave the list unchanged.
//
// Returns nothing, for the reason `push` does not: a method that mutates its
// receiver and also returns it invites `l = l.remove(i)`, which performs the
// removal once and reads as though it performed it twice.
#[_intrinsic("list.remove", mutates, mutatesReceiver)]
func list[T].remove(index int)

// Inserts item at index in the receiver list, in place, shifting what was at
// index and after it one place along. An index equal to the length appends; an
// index outside [0, length] leaves the list unchanged, as remove's does.
#[_intrinsic("list.insert", mutates, mutatesReceiver)]
func list[T].insert(index int, item T)

// Removes every item from the receiver list, in place. Not `l = []`: that
// replaces the list, and an effect keyed on it is told so with `@update`
// rather than `@clear`.
#[_intrinsic("list.clear", mutates, mutatesReceiver)]
func list[T].clear()

// Puts the receiver list's items in increasing order, in place: a's ahead of
// b's where `a < b`. Only a list of a type `<` orders has one; sortBy orders
// any other. The sort is stable, which only a list of floats can tell, with
// its 0 and -0.
#[_intrinsic("list.sort", mutates, mutatesReceiver)]
func list[T ordered].sort()

// Puts the receiver list's items in the order before says, in place:
// `before(a, b)` is true where a goes ahead of b. The sort is stable, so two
// items before puts neither ahead of the other keep the order they had:
// `moves.sortBy(func(a, b) => a.level < b.level)` keeps the moves
// of one level in the order they came.
#[_intrinsic("list.sortBy", mutates, mutatesReceiver)]
func list[T].sortBy(before func(T, T) bool)

// Index of the first occurrence of item in l (by equality), or -1 if
// absent.
#[_intrinsic("list.indexOf")]
const func list[T].indexOf(item T) int

// The strings of a list of strings, sep between them: what format is written
// over, once each item is its format.
#[_intrinsic("list.join")]
const func list[T]._join(sep string) string

// Returns a copy of l with items in reverse order.
#[_intrinsic("list.reverse")]
const func list[T].reverse() list[T]

// Returns a new list containing items from start (inclusive) to end
// (exclusive). Bounds are clamped to [0, length(l)].
#[_intrinsic("list.slice")]
const func list[T].slice(start int, end int) list[T]

// Returns a new list containing the items of l for which pred returns
// true. Item order is preserved.
#[_intrinsic("list.filter")]
const func list[T].filter(pred func(T) bool) list[T]

// Returns a new list built by applying fn to each item of l. The
// result's length equals the input's.
#[_intrinsic("list.map")]
const func list[T].map[U any](fn func(T) U) list[U]

// True if item appears in l (by equality). Equivalent to
// `list.indexOf(l, item) >= 0`.
const func list[T].contains(item T) => this.indexOf(item) >= 0

// Generic iterator. list[T] and map[K, V] implicitly convert when passed
// to a context expecting iter[T] (or iter<(K, V)> for map). For-loops
// bind elements when iterating over an iter[T]. The type is opaque —
// no methods, no fields.
#[_builtin(iter)]
struct iter[T any] {}
