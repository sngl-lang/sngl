// A failure, and the receiver the program raises one through. `message` is
// human-readable; `kind` tags the category so a handler can dispatch on it
// programmatically ("network", "decode", "validation").
struct error {
    message string
    kind    string
}

// Raises a runtime error. The error propagates to the nearest enclosing
// `boundary`, whose `@error` handler receives it. Without a boundary the
// error terminates the containing evaluation with a platform-default
// handler.
#[_intrinsic("error.raise")]
func error.raise(message string, kind string)

// Catches errors raised in its children's event handlers and expressions.
// When a descendant calls `error.raise` or throws during evaluation, the
// boundary swallows the error and invokes `@error` with it; `failed` is what
// it renders in place of `content` from then on. Without a surrounding
// boundary, errors propagate to the platform's default handler.
//
// Either half is enough on its own: `@error` alone reports and keeps
// rendering `content`, `failed` alone swaps the subtree with nothing to run.
// One of the two is required, since a boundary that neither reports nor
// replaces catches an error and does nothing with it.
//
#[_builtin(errorBoundary)]
component boundary[T any](
    @error(e error),
    content ...component T,
    failed  component(error error) T,
) T
