import . "sngl:internal/marks"

// Declares what the package compiles to: which language and platform
// pairs to build, and the options each is built with.
//
// Written at the root of a file, once per package -- any file of the
// package may carry it. Two forms, and they mean the same thing:
//
//     output {
//         go {
//             bubbletea()
//         }
//     }
//
//     output(lang = "go", platform = "bubbletea")
//
// The block form groups targets under a language, so a package that
// ships more than one names each platform once:
//
//     output {
//         js {
//             html(minify = true)
//         }
//         go {
//             bubbletea()
//         }
//     }
//
// A build that names its targets on the command line ignores the
// directive; a build that names none compiles exactly what is written
// here.
//
// A package that declares its own `output` component gets that
// component, and has no build directive.
#[builtin("output")]
component output(targets ...component) {}
