import build "sngl:build"
import marks "sngl:internal/marks"

// Declares what the package compiles to: which language and platform
// pairs to build, and the options each is built with.
//
// Written at the root of a file, once per package -- any file of the
// package may carry it. It is a member of `root`, the family a package body
// accepts, like a window. The contents are an ordinary component tree:
// `output` hosts languages, a language hosts platforms.
//
//     output {
//         go {
//             bubbletea()
//         }
//     }
//
// A package that ships more than one target names each platform once,
// under the language it is built with:
//
//     output {
//         none {
//             html(minify = true)
//         }
//         go {
//             bubbletea()
//         }
//     }
//
// Each node in that tree is a declaration a target package carries, so a
// misspelled target is an unresolved name rather than a string nothing
// matched. Its build options are that node's props, written where they
// belong: a platform's on the platform, a language's on the language, and
// the ones every target shares on `output` itself.
//
// Every value in the tree is read at build time, so all of it must be
// constant -- a literal, a const, or a call the compiler can evaluate.
//
// A build that names its targets on the command line ignores the
// directive; a build that names none compiles exactly what is written
// here.
//
// A package that declares its own `output` component gets that
// component, and has no build directive.
#[marks.builtin("output")]
component output(
    // Display name for the app; used as window title and platform-native app name.
    const name string,
    // Path to a launcher / favicon icon (SVG or PNG), relative to the project dir.
    const icon string,
    // Short app description (Android description, HTML <meta description>, etc.).
    const description string,
    // Semantic version string (Android versionName, HTML meta, etc.).
    const version string,
    // When true, generate source maps for target languages that support them
    // (Go //line directives, JS .map sidecars).
    const maps bool,
    // When true, the generator emits unit tests in the target language
    // alongside the application code, using that language's native test
    // runner (Go's testing, Kotlin's JUnit, JS's Jest/Vitest).
    const test bool,
    const targets ...component build.language,
) root {}
