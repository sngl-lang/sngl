import . "sngl://internal/builtin"

// 64-bit signed integer. Arithmetic operators produce `int` when both
// operands are `int`; division truncates. Methods on the `int` receiver
// (`min`, `max`, `abs`, `clamp`) live alongside this type; convert to
// `float` with `float(x)` before doing fractional math.
#[builtin("int")]
struct int {}

// 64-bit floating-point number. Use the `0.0` / `1.5` literal form (a
// trailing `.0` distinguishes it from `int`). Methods on the `float`
// receiver expose the standard math library (`floor`, `round`, `pow`,
// trigonometric functions, etc.).
#[builtin("float")]
struct float {}

// UTF-8 string. Strings are immutable; methods on the `string` receiver
// return new values rather than mutating in place. Use `+` for
// concatenation and the `string.*` helpers (`length`, `upper`, `split`,
// `replace`, …) for everything else.
#[builtin("string")]
struct string {}

// Heterogeneous list. `list<T>` is the parameterized form; element type
// is inferred from literals. Methods on the `list` receiver
// (`length`, `push`, `filter`, `map`, …) cover the common operations and
// are all pure — they return new lists rather than mutating in place.
// T is the element type.
#[builtin("list")]
struct list<T> {}

// RGBA color with 8-bit channels. Component values range 0-255; alpha
// defaults to fully opaque (255). Colors can be constructed in three
// equivalent ways: a hex literal in place of a color expression, the
// `color.rgb(r, g, b)` and `color.rgba(r, g, b, a)` helpers, or a struct
// literal `color{r=..., g=..., b=..., a=...}`. Hex literals accept three,
// four, six, or eight digits — `#RGB`, `#RGBA`, `#RRGGBB`, `#RRGGBBAA` —
// where the short forms expand CSS-style by doubling each digit (`#f00` is
// `#ff0000`).
// Derived colors (lighten, darken, opacity-adjust) are available via
// the functions on the `color` receiver.
#[builtin("color")]
struct color {
    r int = 0
    g int = 0
    b int = 0
    a int = 255
}

// Calendar date in canonical "YYYY-MM-DD" form. Like `color`, a date is
// string-representable: a string literal in the canonical form coerces to
// `date` and a `date` coerces back to its string form. Platform codegen
// maps it to the native date/time type (Go `time.Time`, JS/Kotlin string).
#[builtin("date")]
struct date {}

// Wall-clock time in "HH:MM" or "HH:MM:SS" form. String-representable like
// `date`; coerces to/from its canonical string form. Platform codegen maps
// it to the native date/time type.
#[builtin("time")]
struct time {}

// ISO-8601 date-time. String-representable like `date`/`time`; coerces
// to/from its canonical string form. Platform codegen maps it to the
// native date/time type (Go `time.Time`, JS/Kotlin string).
#[builtin("datetime")]
struct datetime {}

// K is the key type (must be comparable); V is the value type.
#[builtin("map")]
struct map<K, V> {}

// Generic iterator. list<T> and map<K, V> implicitly convert when passed
// to a context expecting iter<T> (or iter<(K, V)> for map). For-loops
// bind elements when iterating over an iter<T>. The type is opaque —
// no methods, no fields.
#[builtin("iter")]
struct iter<T> {}

// Optional value: `option<T>` is either a `T` or absent. Constructed by the
// compiler; T is the wrapped type.
#[builtin("option")]
struct option<T> {}

// Mutable reference cell: `ref<T>` is a write-through handle to a `T`.
// Used by NoLambda lowering for mutable captures; T is the referent type.
#[builtin("ref")]
struct ref<T> {}
