import ir "sngl:internal/ir"
import marks "sngl:internal/marks"

// Marks a family whose members raise no events: what they are has nothing to
// raise one from -- a painted shape is pixels, not an element. A member that
// declares an event is refused where it is declared, since a handler written
// for it would never run. A platform primitive is the exception, in the other
// direction: its event is the target calling in -- with the drawing context,
// say -- which is how an override is handed what it renders with, and only an
// #[intrinsic] declaration can be one.
func eventless() ir.Macro

// Written on a placement -- a node, or a slot insertion, in a view -- it says
// this one stands where its family is not the one the position accepts. That
// one check is all it lifts: the node's own body, its slots and its children
// are held to their families as ever, and the mark reaches no further than the
// placement it is written on.
//
// Crossing a family is what a platform's primitives are for -- html's window
// override puts an element in the root family, where a dialog is a window --
// and a program crosses into a family of its own the same way:
//
//     component slide(caption string) deck {
//         #[family.crosses]
//         ui.text(value=caption)
//     }
func crosses() ir.Macro

// Exactly one member of the family T, as a slot's content type. Bare `T`
// accepts any number, so this is what narrows it; `option<T>` is the other
// narrowing. The count is what the population renders: an `if` with an `else`
// rendering one node in each branch is one, and a `for` is any number.
//
// Written bare, `family.one` is a count and no family: "exactly one child, of
// whatever this slot already accepts", which is the family the component
// declaring it belongs to.
#[marks.builtin("familyOne")]
struct one<T> {}
