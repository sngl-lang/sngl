// Host-native modal surfaces: the notifications and file choosers an
// application asks the platform for rather than draws itself.
//
// These are not components. A component is placed in a tree and rendered;
// `Alert.confirm` and `File.pick` are calls that hand control to the host
// and return what the user chose, which is why they live outside `sngl:ui`.

import . "sngl:internal/marks"

// Receiver type for transient user notifications. Access methods
// via `Alert.toast(...)`, `Alert.info(...)`, `Alert.warn(...)`,
// `Alert.error(...)`, and `Alert.confirm(...)`. Each call routes
// to the platform's native notification mechanism (toast, snackbar,
// dialog) with an appropriate severity.
struct Alert {}

// Receiver type for file-system interactions. Access methods via
// `File.pick()` to prompt for a single file and `File.pickFolder()`
// to prompt for a directory. Both return the selected path or
// empty string on cancellation. Availability and dialog style are
// platform-defined.
struct File {}

// --- Alert ---

// Shows a short transient toast tagged with variant ("info",
// "success", "warning", "error") appropriate to the platform. The
// toast dismisses automatically after the platform's default
// duration.
#[intrinsic("Alert.toast", mutates)]
func Alert.toast(message string, variant string)

// Shows an informational alert. Equivalent to `Alert.toast(message,
// "info")` on platforms that render toasts, or a modeless info
// dialog on desktop platforms.
#[intrinsic("Alert.info", mutates)]
func Alert.info(message string)

// Shows a warning alert. The rendering elevates severity compared
// to `Alert.info` — a colored toast or a dismissible warning
// dialog depending on the platform.
#[intrinsic("Alert.warn", mutates)]
func Alert.warn(message string)

// Shows an error alert. Rendered with the platform's error styling
// and typically stays visible until dismissed.
#[intrinsic("Alert.error", mutates)]
func Alert.error(message string)

// Prompts the user to confirm or cancel. Blocks until a choice is
// made and returns true on confirm, false on cancel. On platforms
// without a native confirm dialog, falls back to a modal overlay.
#[intrinsic("Alert.confirm", mutates)]
func Alert.confirm(message string) bool

// --- File ---

// Opens a file-picker dialog and returns the chosen path, or an
// empty string if cancelled. The dialog style (native, in-app) is
// platform-defined. Not all platforms expose a file system — web
// platforms may return a synthetic handle.
#[intrinsic("File.pick", readonly)]
func File.pick() string

// Opens a folder-picker dialog and returns the chosen path, or an
// empty string if cancelled. Same platform caveats as `File.pick`.
#[intrinsic("File.pickFolder", readonly)]
func File.pickFolder() string
