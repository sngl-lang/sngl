// --- Core ---

// Vertical box layout container. Children are stacked top to bottom and
// laid out along the cross axis via `style.alignItems`. Enable `scroll`
// to make overflow scrollable; set `refreshing` alongside `@refresh`
// to opt in to pull-to-refresh on platforms that support it. Use
// `style.gap` to control spacing between children.
component vbox(
    style Style,
    scroll bool,
    refreshing bool,
    @refresh RefreshEvent,
) list<component> {}

// Horizontal box layout container. Children are placed side by side
// along the main axis and aligned via `style.alignItems` /
// `style.justifyContent`. Enable `scroll` to make horizontal overflow
// scrollable. Use `style.gap` for spacing between children.
component hbox(
    style Style,
    scroll bool,
) list<component> {}

// Layered container where children overlap in the order they are declared.
// Later children paint over earlier ones. Useful for overlays, badges
// pinned to a corner, or background/foreground composition. Children
// size independently; use `style.position` inside a child for precise
// placement.
component stack(
    style Style,
) list<component> {}

// Displays a text string. `value` is the content; set `selectable=true`
// to allow the platform to offer copy. Typography (size, weight, color,
// alignment, `maxLines` truncation) is driven entirely by `style`.
// The `@click` event fires on tap/click for simple text-as-action use.
component text(
    style Style,
    value string,
    selectable bool,
    @click ClickEvent,
) {}

// Clickable button that triggers an action. Supply `text` for a label,
// or nest components inside the body for custom content. Set
// `disabled=true` to suppress input and render the disabled styling.
// `@click` fires on activation; `@longPress` fires after a sustained
// press on pointer/touch platforms.
component button(
    style Style,
    text string,
    disabled bool,
    focusable bool = true,
    @click ClickEvent,
    @longPress LongPressEvent,
) list<component> {}

// Single-line text input field. `value` is a two-way bound prop — write
// to update the field, read to observe edits. `placeholder` shows when
// empty; `readonly` disables edits while keeping focus/selection; set
// `type` to "password", "search", "email", etc. for appropriate platform
// behavior. `@input` fires on every keystroke, `@change` on commit
// (blur or Enter), `@submit` on Enter. `maxLength` caps accepted input.
component input(
    style Style,
    :value string,
    placeholder string,
    disabled bool,
    readonly bool,
    type string,
    maxLength int,
    focusable bool = true,
    @input InputEvent,
    @change ChangeEvent,
    @focus FocusEvent,
    @blur FocusEvent,
    @submit SubmitEvent,
) {}

// Displays an image from a URL or asset path. `fit` controls how the
// image is scaled into its frame (see `ObjectFit`). `alt` provides the
// accessibility label. `@load` fires once decoding completes; `@error`
// fires on fetch/decode failure with an `ErrorEvent` describing the
// failure.
component image(
    style Style,
    src string,
    alt string,
    fit ObjectFit,
    @click ClickEvent,
    @load LoadEvent,
    @error ErrorEvent,
) {}

// Scrollable viewport that wraps a single child. `direction` is
// "vertical", "horizontal", or "both". `scrollX`/`scrollY` are
// two-way bound scroll offsets, useful for programmatic scrolling or
// scroll-linked effects. `showScrollbar` is "auto", "always", or
// "never". `@scroll` fires continuously while scrolling; `@scrollEnd`
// fires once motion settles.
component scroll(
    style Style,
    direction string,
    scrollX float,
    scrollY float,
    showScrollbar string,
    @scroll ScrollEvent,
    @scrollEnd ScrollEvent,
) component {}

// Flexible empty space. With `style.flex=1` it expands to absorb
// available room between siblings, which is the common way to
// right-align content in an `hbox`. `size` gives a fixed length
// when flex expansion is not wanted.
component spacer(
    style Style,
    size string,
) {}

// Boolean toggle rendered as a checkmark box. `checked` is two-way
// bound — toggling the box updates it, and writes to it update the
// rendered state. `label` is rendered next to the box; omit it for
// a bare checkbox. `@change` fires each time the user toggles.
component checkbox(
    style Style,
    :checked bool,
    label string,
    disabled bool,
    focusable bool = true,
    @change ChangeEvent,
) {}

// Placeholder for projected content in custom component definitions.
// When a user of the component passes children to it, the `slot`
// position is where those children render. A component with no
// `slot` drops any children passed by the caller.
component slot() {}

// Catches errors raised in children's event handlers and expressions.
// When a descendant calls `error.raise` or throws during evaluation,
// the boundary swallows the error and invokes `@error` with an
// `ErrorEvent` carrying the message and kind. Without a surrounding
// boundary, errors propagate to the platform's default handler.
component errorBoundary(
    @error ErrorEvent,
) list<component> {}

// Periodic callback. Fires `@tick` every `interval` while `enabled`
// is true. Toggling `enabled` is the idiomatic way to start and stop
// the timer; the timer is automatically cleaned up when the component
// unmounts. Intervals below the platform's frame budget may coalesce.
component timer(
    interval duration,
    enabled bool,
    @tick,
) {}

// --- Input ---

// Group of mutually exclusive options. `options` is the list of choice
// labels; `value` is the currently selected label (matched by string
// equality). `direction` is "horizontal" or "vertical" and controls
// how choices are laid out. `@change` fires with the newly selected
// value on user selection.
component radio(
    style Style,
    value string,
    options list<string>,
    disabled bool,
    direction string,
    @change ChangeEvent,
) {}

// On/off switch control. `checked` is two-way bound. Semantically
// equivalent to `checkbox` but rendered as a switch affordance on
// platforms that distinguish the two.
component toggle(
    style Style,
    :checked bool,
    label string,
    disabled bool,
    focusable bool = true,
    @change ChangeEvent,
) {}

// Dropdown selection control. `options` is the list of choices;
// `value` is the current selection, two-way bound. Set `multiple=true`
// to allow multi-select (value becomes a newline-joined string of
// selected labels). `placeholder` shows when nothing is selected.
component select(
    style Style,
    :value string,
    options list<string>,
    placeholder string,
    disabled bool,
    multiple bool,
    focusable bool = true,
    @change ChangeEvent,
    @focus FocusEvent,
    @blur FocusEvent,
) {}

// Multi-line text input field. Mirrors `input` semantics for a
// multi-line editor: two-way bound `value`, `@input` per keystroke,
// `@change` on commit. `rows` controls the initial visible row count;
// the editor still scrolls when content exceeds it.
component textarea(
    style Style,
    :value string,
    placeholder string,
    disabled bool,
    readonly bool,
    rows int,
    maxLength int,
    focusable bool = true,
    @input InputEvent,
    @change ChangeEvent,
    @focus FocusEvent,
    @blur FocusEvent,
) {}

// --- Feedback & Navigation ---

// Determinate progress indicator. Shows the fraction `value / max`
// filled. Set `showValue=true` to render a numeric read-out alongside
// the bar. `variant` styles the bar ("primary", "success", "warning",
// "error"); `label` annotates the bar with a short description.
component progress(
    style Style,
    value float,
    max float,
    label string,
    variant string,
    showValue bool,
) {}

// Indeterminate loading indicator. Use when progress cannot be
// measured. `variant` is "bar" or "circle"; `size` is "small",
// "medium", or "large". `label` adds an accessible description
// announced by screen readers.
component spinner(
    style Style,
    label string,
    variant string,
    size string,
) {}

// Small status label — a compact chip showing a status, count, or
// category tag. `variant` styles the color ("primary", "success",
// "warning", "error", "neutral"); `size` is "small" or "medium".
component badge(
    style Style,
    value string,
    variant string,
    size string,
) {}

// Tabbed navigation. `items` labels each tab; `selected` is the
// 0-based index of the active tab and is two-way bound. Children of
// `tabs` are the panels: one per item, in the same order. `variant`
// styles the tab strip ("underline", "pills"); `@change` fires with
// the newly selected index.
component tabs(
    style Style,
    items list<string>,
    selected int,
    variant string,
    @change SelectEvent,
) list<component> {}

// Navigational hyperlink. `href` is the destination — an external
// URL, an in-app route, or a file path depending on the platform.
// `target` ("self" or "blank") controls whether navigation replaces
// the current view or opens a new window. `@click` runs before
// navigation and can short-circuit it by raising an error.
component link(
    style Style,
    href string,
    text string,
    target string,
    disabled bool,
    focusable bool = true,
    @click ClickEvent,
) {}

// Visual separator line. `direction` is "horizontal" (default) or
// "vertical". `label` inserts a centered caption inside the rule,
// commonly rendered as "text with lines on either side".
component divider(
    style Style,
    direction string,
    label string,
) {}

// --- Overlays & Layout ---

// Dialog overlay. Renders its children in a centered modal dialog
// atop a scrim when `open` is true. `title` is the dialog heading;
// `closable=true` shows a close affordance that emits `@close`. `size`
// is "small", "medium", "large", or "full". Dismissing the scrim or
// pressing Escape also emits `@close`.
component modal(
    style Style,
    open bool,
    title string,
    closable bool,
    size string,
    @close DismissEvent,
) list<component> {}

// Slide-out panel anchored to a side of the viewport. `side` is "left",
// "right", "top", or "bottom". `size` is a length or a preset ("small",
// "medium", "large"). Like `modal`, tapping the scrim or pressing
// Escape emits `@close`.
component drawer(
    style Style,
    open bool,
    side string,
    size string,
    @close DismissEvent,
) list<component> {}

// Informational popup on hover or focus. Wraps a single child (the
// trigger); `text` is the tooltip body. `position` hints at placement
// ("top", "bottom", "left", "right", "auto"). `delay` is the
// millisecond delay before the tooltip appears.
component tooltip(
    style Style,
    text string,
    position string,
    delay int,
) component {}

// Floating content panel anchored to a trigger. Children include the
// trigger and the panel contents; `open` controls visibility and is
// two-way bound. `openOn` is "click", "hover", or "focus". `position`
// hints at placement; the runtime flips to an opposite side if there
// is not enough room. Clicking outside emits `@close`.
component popover(
    style Style,
    open bool,
    position string,
    openOn string,
    @close DismissEvent,
) list<component> {}

// Resizable two-pane layout. Exactly two children define the panes.
// `direction` is "horizontal" (side-by-side) or "vertical". `position`
// is the split location as a 0.0-1.0 fraction and is two-way bound;
// `minPosition`/`maxPosition` clamp user drags. Set `resizable=false`
// to lock the split.
component splitview(
    style Style,
    direction string,
    position float,
    minPosition float,
    maxPosition float,
    resizable bool,
    @resize ResizeEvent,
) list<component> {}

// --- Data & Desktop ---

// Tabular data display. `columns` is the list of column headers;
// `rows` is the cell grid — one inner `list<string>` per row, each
// cell aligned to its column by position (defaults to no rows).
// Enable `selectable` for row selection with `selected` as
// the 0-based row index (two-way bound). Enable `sortable` to let the
// user re-order by column; `sortColumn` and `sortDirection` ("asc" or
// "desc") reflect the current sort and are two-way bound. `@sort`
// fires when the user changes sort, `@select` when the selection
// changes.
component table(
    style Style,
    columns list<string>,
    rows list<list<string>> = [],
    selectable bool,
    :selected int,
    sortable bool,
    sortColumn string,
    sortDirection string,
    @select SelectEvent,
    @sort ChangeEvent,
) {}

// Hierarchical data display. `items` is the visible row labels in
// traversal order. `selected` is the label of the current selection,
// two-way bound. `expanded` is the list of expanded node indices,
// also two-way bound. `@select` fires on row pick, `@expand` when the
// user toggles a node.
component tree(
    style Style,
    items list<string>,
    selected string,
    expanded list<int>,
    @select SelectEvent,
    @expand ExpandEvent,
) {}

// Context or dropdown menu. `items` is the list of entry labels;
// `open` is two-way bound visibility. `@select` fires with the chosen
// item, `@close` when the menu dismisses without selection (click
// outside, Escape).
component menu(
    style Style,
    items list<string>,
    open bool,
    @select MenuEvent,
    @close DismissEvent,
) {}

// Horizontal menu bar — typically at the top of a window on desktop.
// Each entry in `items` is rendered as a top-level menu title;
// sub-menu items are provided by the host platform's menu
// integration. `@select` fires with the activated menu path.
component menubar(
    style Style,
    items list<string>,
    @select MenuEvent,
) {}

// Horizontal bar of action buttons. `items` populates the default
// buttons; nesting children lets you build custom toolbar contents
// (mix of buttons, separators, spacers). `@select` fires when an
// item from `items` is activated.
component toolbar(
    style Style,
    items list<string>,
    @select MenuEvent,
) list<component> {}

// --- Mobile & Specialized ---

// Calendar-based date selection. `value` is the selected date
// (two-way bound). `min` / `max` clamp the selectable range;
// `placeholder` shows when no date is picked. `@change` fires once
// the user picks a date.
component datepicker(
    style Style,
    value date,
    min date,
    max date,
    disabled bool,
    placeholder string,
    @change DateEvent,
    @focus FocusEvent,
    @blur FocusEvent,
) {}

// Compact interactive tag. `label` is the displayed text. Set
// `removable=true` to render a remove affordance that emits
// `@remove`. `selected` styles the chip as active (two-way bound
// when used as a filter). `variant` styles the chip color.
component chip(
    style Style,
    label string,
    variant string,
    removable bool,
    selected bool,
    disabled bool,
    focusable bool = true,
    @click ClickEvent,
    @remove DismissEvent,
) {}

// User profile image with fallback. Renders `src` when available;
// otherwise displays `initials` in a styled placeholder. `size` is
// a preset ("small", "medium", "large") or a length; `variant` is
// "circle" (default) or "square".
component avatar(
    style Style,
    src string,
    alt string,
    initials string,
    size string,
    variant string,
    @click ClickEvent,
) {}

// Styled container for grouping related content. `variant` selects
// the surface treatment ("outlined", "elevated", "filled"). Set
// `clickable=true` to make the entire card respond to `@click` —
// useful for building tappable list items.
component card(
    style Style,
    variant string,
    clickable bool,
    @click ClickEvent,
) list<component> {}

// --- Examples ---

component _example_vbox {
    vbox(style={gap=8, padding=16}) {
        text(value="First")
        text(value="Second")
        text(value="Third")
    }
}

component _example_hbox {
    hbox(style={gap=8, padding=16}) {
        text(value="Left")
        text(value="Center")
        text(value="Right")
    }
}

component _example_stack {
    stack {
        text(value="Behind", style={padding=16})
        text(value="In front", style={padding=32, color=#FF0000})
    }
}

component _example_text {
    vbox(style={gap=8, padding=16}) {
        text(value="Hello, World!", style={fontSize=24, fontWeight="bold"})
        text(value="Regular text")
        text(value="Colored text", style={color=#0066CC})
    }
}

component _example_button {
    var count = 0
    vbox(style={gap=8, padding=16}) {
        hbox(style={gap=8}) {
            button(text="Click me", @click { count += 1 })
            button(text="Reset", @click { count = 0 })
            button(text="Disabled", disabled=true)
        }
        text(value="Clicked " + string(count) + " times")
    }
}

component _example_input {
    var name = ""
    vbox(style={gap=8, padding=16}) {
        input(placeholder="Enter your name", value=name, @input(e) { name = e.value })
        input(placeholder="Password", type="password")
        input(placeholder="Search...", type="search")
        text(value="Hello, " + name)
    }
}

component _example_image {
    vbox(style={gap=8, padding=16}) {
        image(src="https://placehold.co/200x100", alt="Placeholder image", fit="contain")
    }
}

component _example_scroll {
    scroll(direction="vertical", style={height=120}) {
        vbox(style={gap=4, padding=8}) {
            text(value="Line 1")
            text(value="Line 2")
            text(value="Line 3")
            text(value="Line 4")
            text(value="Line 5")
            text(value="Line 6")
            text(value="Line 7")
            text(value="Line 8")
        }
    }
}

component _example_spacer {
    hbox(style={padding=16}) {
        text(value="Left")
        spacer
        text(value="Right")
    }
}

component _example_checkbox {
    var darkMode = false
    vbox(style={gap=8, padding=16}) {
        checkbox(checked=darkMode, label="Dark mode", @change { darkMode!! })
        text(value=darkMode ? "Dark mode on" : "Dark mode off")
    }
}

component _example_radio {
    var size = "medium"
    vbox(style={gap=8, padding=16}) {
        radio(options=["small", "medium", "large"], value=size, direction="horizontal")
        text(value="Selected: " + size)
    }
}

component _example_toggle {
    var notifications = false
    vbox(style={gap=8, padding=16}) {
        toggle(checked=notifications, label="Notifications", @change { notifications!! })
        text(value=notifications ? "Enabled" : "Disabled")
    }
}

component _example_select {
    var fruit = ""
    vbox(style={gap=8, padding=16}) {
        select(options=["Apple", "Banana", "Cherry"], placeholder="Pick a fruit", value=fruit)
        text(value="Selected: " + fruit)
    }
}

component _example_textarea {
    var notes = ""
    vbox(style={gap=8, padding=16}) {
        textarea(placeholder="Write some notes...", rows=4, value=notes, @input(e) { notes = e.value })
        text(value="Length: " + string(notes.length()))
    }
}

component _example_progress {
    vbox(style={gap=8, padding=16}) {
        progress(value=0.7, max=1, label="70% complete", showValue=true)
        progress(value=3, max=10)
    }
}

component _example_spinner {
    hbox(style={gap=16, padding=16, alignItems="center"}) {
        spinner(label="Loading...")
        spinner(variant="circle", size="large")
    }
}

component _example_badge {
    hbox(style={gap=8, padding=16, alignItems="center"}) {
        badge(value="3", variant="primary")
        badge(value="New", variant="success")
        badge(value="Error", variant="error")
    }
}

component _example_tabs {
    var selected = 0
    vbox(style={padding=16}) {
        tabs(items=["Overview", "Details", "Settings"], selected=selected) {
            text(value="Overview content")
            text(value="Detail content")
            text(value="Settings content")
        }
    }
}

component _example_link {
    hbox(style={gap=16, padding=16}) {
        link(href="https://example.com", text="Example Site")
        link(href="https://example.com", text="New Tab", target="blank")
    }
}

component _example_divider {
    vbox(style={gap=8, padding=16}) {
        text(value="Section 1")
        divider
        text(value="Section 2")
        divider(label="OR")
        text(value="Section 3")
    }
}

component _example_modal {
    var showModal = false
    vbox(style={padding=16}) {
        button(text="Open Modal", @click { showModal = true })
        modal(open=showModal, title="Example Modal", closable=true) {
            text(value="Modal content goes here.")
            button(text="Close", @click { showModal = false })
        }
    }
}

component _example_drawer {
    var showDrawer = false
    vbox(style={padding=16}) {
        button(text="Open Drawer", @click { showDrawer = true })
        drawer(open=showDrawer, side="right") {
            vbox(style={gap=8, padding=16}) {
                text(value="Drawer Content", style={fontWeight="bold"})
                button(text="Close", @click { showDrawer = false })
            }
        }
    }
}

component _example_tooltip {
    vbox(style={padding=16}) {
        tooltip(text="This is a tooltip") {
            button(text="Hover me")
        }
    }
}

component _example_popover {
    var showPop = false
    vbox(style={padding=16}) {
        popover(open=showPop, position="bottom", openOn="click") {
            button(text="Toggle", @click { showPop!! })
        }
    }
}

component _example_splitview {
    splitview(direction="horizontal", style={height=120}) {
        vbox(style={padding=12}) {
            text(value="Left pane")
        }
        vbox(style={padding=12}) {
            text(value="Right pane")
        }
    }
}

component _example_table {
    vbox(style={padding=16}) {
        table(columns=["Name", "Role", "Status"])
    }
}

component _example_tree {
    vbox(style={padding=16}) {
        tree(items=["Documents", "Photos", "Music", "Videos"])
    }
}

component _example_menu {
    var showMenu = false
    vbox(style={padding=16}) {
        button(text="Show Menu", @click { showMenu = true })
        menu(items=["Cut", "Copy", "Paste"], open=showMenu)
    }
}

component _example_menubar {
    vbox(style={padding=16}) {
        menubar(items=["File", "Edit", "View", "Help"])
    }
}

component _example_toolbar {
    vbox(style={padding=16}) {
        toolbar {
            button(text="New")
            button(text="Open")
            button(text="Save")
            spacer
            button(text="Settings")
        }
    }
}

component _example_datepicker {
    vbox(style={padding=16}) {
        datepicker(placeholder="Select a date")
    }
}

component _example_chip {
    hbox(style={gap=8, padding=16}) {
        chip(label="Tag")
        chip(label="Removable", removable=true)
        chip(label="Success", variant="success")
    }
}

component _example_avatar {
    hbox(style={gap=8, padding=16}) {
        avatar(initials="JD")
        avatar(initials="AB", variant="square")
        avatar(initials="XY", size="large")
    }
}

component _example_card {
    hbox(style={gap=16, padding=16}) {
        card(variant="outlined") {
            text(value="Outlined", style={fontWeight="bold"})
            text(value="With a border")
        }
        card(variant="elevated") {
            text(value="Elevated", style={fontWeight="bold"})
            text(value="With a shadow")
        }
    }
}
