import build "sngl:build"
import marks "sngl:internal/marks"
import gen "sngl:x/gen"

// C's keywords, through C23, which no declaration may take.
const keywords = [
    "auto",
    "break",
    "case",
    "char",
    "const",
    "continue",
    "default",
    "do",
    "double",
    "else",
    "enum",
    "extern",
    "float",
    "for",
    "goto",
    "if",
    "inline",
    "int",
    "long",
    "register",
    "restrict",
    "return",
    "short",
    "signed",
    "sizeof",
    "static",
    "struct",
    "switch",
    "typedef",
    "union",
    "unsigned",
    "void",
    "volatile",
    "while",
    "alignas",
    "alignof",
    "constexpr",
    "nullptr",
    "static_assert",
    "thread_local",
    "typeof",
    "typeof_unqual",
]

// What the headers every program includes define as a macro, which no local
// may take either: stdbool.h's and stddef.h's.
const macros = [
    "bool",
    "true",
    "false",
    "NULL",
    "offsetof",
]

// How hard a C compiler optimizes: each member's value is the flag it is
// passed as. Every level means the same program, since -fwrapv and
// -fstack-clash-protection hold at each.
enum Optimization {
    // None, which a debugger reads best.
    o0 = "-O0"
    o1 = "-O1"
    // What a release build optimizes at.
    o2 = "-O2"
    o3 = "-O3"
    // For size.
    size = "-Os"
    // What does not get in a debugger's way.
    debug = "-Og"
}

// The `c` node of a build directive: `output { c { gtk4() } }`. Its props are
// the build options every C target accepts, and its slot is the platforms
// built with them.
//
// C has no closure, so a lambda is lifted to a function and the struct of
// what it captures (passLambda). Nor has it a reference that outlives the
// frame it points into, so a `ref` is a box (passNoRef). An enum is the
// integer its member's position is, and a match the if chain it means.
#[gen.can(
    toggle,
    ternary,
    computed,
    reactivity,
    declarative,
    inlineComponents,
    viewStatements,
    entryWrites,
)]
#[gen.name("c")]
#[gen.native("c")]
component language(
    // The compiler a build runs: `cc` where it is unset, or `$CC` where the
    // environment names one.
    const cc            string,
    // The standard the program is compiled as, `c11` or `c17`; it compiles
    // as either.
    const std           string = "c17",
    // How hard the compiler optimizes. Left unset it is o0, which a debugger
    // reads best, and o2 in a release build (`sngl build --release`); one set
    // is what it says in either.
    const optimize      Optimization = gen.release() ? Optimization.o2 : Optimization.o0,
    // Names a program's declaration is renamed away from in generated C: C's
    // keywords and the macros its headers define.
    const reservedWords list[string] = [...keywords, ...macros],
    const platforms     ...component build.platform,
) build.language {
    gen.run(@run(dir, args) {
        var cmd = launch(buildProgram(dir, dir + "/app", cc, std, optimize))
        for var a = args {
            cmd.push(a)
        }
        var code = gen.shell(cmd=cmd, dir=dir)
        if code != 0 {
            error.raise("exit status {code}", "exit")
        }
    })
    gen.build(@build(dir, out) {
        buildProgram(dir, out, cc, std, optimize)
    })
}

// Compiles the program the build wrote to dir into the executable out with
// cc under std at the optimize level, and returns its path: every .c file
// there, linking what its sngl.build names. A program built for another
// system is compiled by the compiler for it, whatever cc says, and a Windows
// one's path ends `.exe`.
#[marks.intrinsic("c.buildProgram", build)]
func buildProgram(dir string, out string, cc string, std string, optimize Optimization) string

// The command running the program at path: itself, or under Wine where it is
// a Windows program and the host is not Windows.
#[marks.intrinsic("c.launch", build)]
func launch(path string) list[string]
