import marks "sngl:internal/marks"
import tree "sngl:tree"
import ui "sngl:ui"

// The family whose members are written at the root of a file: the windows a
// program opens, and the build directive saying what it compiles to. Nothing
// syntactic makes those top-level — the package body is a slot that accepts
// this tree, and everything else it could accept belongs to another one.
//
// `root` because each member genuinely is one: a window roots a render tree,
// and a build directive roots the targets. An `if` or a `for` at the root
// still works, since neither is a node, and a component that names `root`
// itself renders windows conditionally.
#[tree.kind]
#[marks.builtin("treeRoot")]
struct root {}

// Catches errors raised in children's event handlers and expressions.
// When a descendant calls `error.raise` or throws during evaluation,
// the boundary swallows the error and invokes `@error` with an
// `ErrorEvent` carrying the message and kind. Without a surrounding
// boundary, errors propagate to the platform's default handler.
//
// It belongs to no family of its own and takes T from whatever it was given:
// a boundary around shapes is a shape's parent, one around widgets a widget's,
// and it is placeable in either. An empty boundary binds nothing, which is
// harmless — there is no content for the binding to have checked.
#[marks.builtin("errorBoundary")]
component errorBoundary<T>(
    @error ui.ErrorEvent,
    content ...component T,
) T {}

// A top-level window — the entry point of a UI. `href` is the route the
// window is served at (URL template params like `{name}` bind as string
// vars in scope for the body); `title` names it; `favicon` is its icon.
// `@error` is the window's outermost error boundary.
//
// Reading `name.href` / `name.title` off a `window #name` declaration
// lets links survive a window's path change without copying the path
// string. The #[builtin("window")] mark is how the checker recognises a
// window declaration — by tag, not by matching the name "window".
//
// A program must declare at least one: the package body renders nothing on
// its own, so a program with no window has nowhere to draw.
#[marks.builtin("window")]
component window(
    title string,
    href string,
    favicon string,
    @error ui.ErrorEvent,
    content ...component ui.ui,
) root {}

// Receiver type for raising runtime errors caught by an
// `errorBoundary` ancestor. Call `error.raise(message, kind)` to
// throw; the nearest boundary's `@error` handler receives an
// `ErrorEvent` with the message and kind.
struct error {}

// Raises a runtime error. The error propagates to the nearest
// enclosing `errorBoundary` ancestor, whose `@error` handler
// receives an `ErrorEvent{message, kind}`. Without a boundary the
// error terminates the containing evaluation with a platform-default
// handler. `kind` lets handlers dispatch programmatically (e.g.
// "network", "validation", "internal").
#[marks.intrinsic("error.raise")]
func error.raise(message string, kind string)
