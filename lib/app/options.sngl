import . "sngl:macro"

// Top-level build-time options shared across every platform and language.
// Any field declared here is recognized in every output() block; platforms
// pick up the values they care about through their own Options structs.
#[options]
struct Options {
    // The window a build opens at, named by its `#id` rather than by a
    // string, so a typo is a window nobody declared. A program with one
    // window needs it only for emphasis; past one it is what says which of
    // them is the program, a question the compiler previously refused to
    // guess and therefore left unanswered.
    entry dyn
    // Display name for the app; used as window title and platform-native app name.
    name string
    // Path to a launcher / favicon icon (SVG or PNG), relative to the project dir.
    icon string
    // Short app description (Android description, HTML <meta description>, etc.).
    description string
    // Semantic version string (Android versionName, HTML meta, etc.).
    version string
    // When true, generate source maps for target languages that support them
    // (Go //line directives, JS .map sidecars). Default false.
    maps bool
    // When true, the generator emits unit tests in the target language
    // alongside the application code. Tests use the target language's
    // native test runner (Go's testing, Kotlin's JUnit, JS's Jest/Vitest).
    // Emission is wired up in a separate change; for now the field is
    // accepted by the CLI but produces no extra files.
    test bool
}
