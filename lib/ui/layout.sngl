// Vertical box layout container. Children are stacked top to bottom and
// laid out along the cross axis via `style.alignItems`. A box does not
// scroll: put it in a `scroll` for that. Set `refreshing` alongside
// `@refresh` to opt in to pull-to-refresh on platforms that support it.
// Use `style.gap` to control spacing between children.
component vbox(
    refreshing bool = false,
    style      Style = Style{},
    @refresh(),
    children   ...component,
) node

component _example_vbox node {
    vbox(style={gap=8px, padding=16px}) {
        text(value="First")
        text(value="Second")
        text(value="Third")
    }
}

// Horizontal box layout container. Children are placed side by side
// along the main axis and aligned via `style.alignItems` /
// `style.justifyContent`. A box does not scroll: put it in a
// `scroll(direction=horizontal)` for that. Use `style.gap` for spacing
// between children.
component hbox(
    style    Style = Style{},
    children ...component,
) node

component _example_hbox node {
    hbox(style={gap=8px, padding=16px}) {
        text(value="Left")
        text(value="Center")
        text(value="Right")
    }
}

// Layered container where children overlap in the order they are declared.
// Later children paint over earlier ones. Useful for overlays, badges
// pinned to a corner, or background/foreground composition. Children
// size independently; use `style.position` inside a child for precise
// placement.
component stack(
    style  Style = Style{},
    layers ...component,
) node

component _example_stack node {
    stack {
        text(value="Behind", style={padding=16px})
        text(value="In front", style={padding=32px, color=#FF0000})
    }
}

// The axis a `scroll` moves along.
enum ScrollDirection { vertical, horizontal, both }

// Scrollable viewport that wraps a single child. `direction` is the axis
// it scrolls along; a scroll given none scrolls vertically, as a page
// does. Content wider than a vertical scroll, or taller than a
// horizontal one, does not scroll. `@scroll` fires continuously while
// scrolling; `@scrollEnd` fires once motion settles.
//
// `@reachEnd` fires when the end of the content comes within half a
// viewport of being shown -- the bottom, or the right edge of a
// horizontal scroll: once when it arrives, and again whenever the
// content changes size while it is there. A handler that adds content
// is how a list loads its next page as it is scrolled to -- and since
// content too short to scroll has its end shown already, it fires on
// arrival, so a first page shorter than the viewport loads the next
// without waiting for a scroll that cannot happen. A handler that adds
// nothing is not called again until the end is scrolled away from and
// back. bubbletea draws a scroll as its content, cut off by the
// terminal, and the interpreter lays nothing out: both fire it only when
// a test does.
component scroll(
    style     Style = Style{},
    direction ScrollDirection = ScrollDirection.vertical,
    @scroll(),
    @scrollEnd(),
    @reachEnd(),
    content   ...component option[node],
) node

component _example_scroll node {
    scroll(style={height=120px}) {
        vbox(style={gap=4px, padding=8px}) {
            text(value="Line 1")
            text(value="Line 2")
            text(value="Line 3")
            text(value="Line 4")
            text(value="Line 5")
            text(value="Line 6")
            text(value="Line 7")
            text(value="Line 8")
        }
    }
}

// Flexible empty space: it grows into the room its siblings leave along its
// parent's axis, as `flex: 1` does in CSS, which is the common way to
// right-align content in an `hbox`. A `style.flex` of its own is its share
// instead.
component spacer(
    style Style = Style{},
) node

component _example_spacer node {
    hbox(style={padding=16px}) {
        text(value="Left")
        spacer
        text(value="Right")
    }
}

// Visual separator line. `direction` is "horizontal" (default) or
// "vertical". `label` inserts a centered caption inside the rule,
// commonly rendered as "text with lines on either side".
component divider(
    style     Style = Style{},
    direction string = "",
    label     string = "",
) node

component _example_divider node {
    vbox(style={gap=8px, padding=16px}) {
        text(value="Section 1")
        divider
        text(value="Section 2")
        divider(label="OR")
        text(value="Section 3")
    }
}

// Resizable two-pane layout. Exactly two children define the panes.
// `direction` is "horizontal" (side-by-side) or "vertical". `position`
// is the split location as a 0.0-1.0 fraction and is two-way bound;
// `minPosition`/`maxPosition` clamp user drags. Set `resizable=false`
// to lock the split.
component splitview(
    style       Style = Style{},
    direction   string = "",
    position    float = 0.0,
    minPosition float = 0.0,
    maxPosition float = 0.0,
    resizable   bool = false,
    @resize(),
    panes       ...component,
) node

component _example_splitview node {
    splitview(direction="horizontal", style={height=120px}) {
        vbox(style={padding=12px}) {
            text(value="Left pane")
        }
        vbox(style={padding=12px}) {
            text(value="Right pane")
        }
    }
}

// Styled container for grouping related content. `variant` selects
// the surface treatment ("outlined", "elevated", "filled"). Set
// `clickable=true` to make the entire card respond to `@click` --
// useful for building tappable list items. The flag is what makes the
// card look and act pressable (a pointer, a ripple, a focus stop), so a
// card that is not one does not; `@click` fires only on a clickable card.
component card(
    style     Style = Style{},
    variant   string = "",
    clickable bool = false,
    @click(),
    content   ...component,
) node

component _example_card node {
    hbox(style={gap=16px, padding=16px}) {
        card(variant="outlined") {
            text(value="Outlined", style={fontWeight=bold})
            text(value="With a border")
        }
        card(variant="elevated") {
            text(value="Elevated", style={fontWeight=bold})
            text(value="With a shadow")
        }
    }
}
