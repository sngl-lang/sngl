// Where a followed link opens: in place of the current view, or in a new
// window.
enum LinkTarget { self, blank }

// Navigational hyperlink. `href` is the destination — an external
// URL, an in-app route, or a file path depending on the platform.
// `target` controls whether navigation replaces
// the current view or opens a new window. `@click` runs before
// navigation and can short-circuit it by raising an error.
component link(
    text      string,
    href      string,
    target    LinkTarget = LinkTarget.self,
    disabled  bool = false,
    focusable bool = true,
    style     Style = Style{},
    @click(),
) node

component _example_link node {
    hbox(style={gap=16px, padding=16px}) {
        link(href="https://example.com", text="Example Site")
        link(href="https://example.com", text="New Tab", target=blank)
    }
}

// How a tab strip marks the selected tab.
enum TabsVariant { underline, pills }

// One tab of a `tabs`: data, since it names itself as its family, so the tabs
// read their tabs as a list rather than rendering them. What it is written
// with is its panel, mounted with the tabs and shown while it is the selected
// tab.
component tab(
    label    string,       // what the tab shows in the strip
    disabled bool = false, // whether it can be chosen
    // The panel: mounted with the tabs, shown while this tab is selected.
    content  ...component node,
) tab

// Tabbed navigation. Each tab is a `tab` written as a child -- under an `if`
// or a `for` where the list depends on something -- and the panel shown is
// what the selected one was written with. Every panel is mounted with the
// tabs and stays mounted while another is selected, so what a panel holds --
// its state, its requests, a scroll's position -- outlives a switch away and
// back, and selecting a tab only shows its panel. A platform that cannot keep
// a panel loaded mounts it when its tab is selected; keeping it loaded is
// preferred. `selected` is the 0-based index of the selected tab and is
// two-way bound; `@change` fires with the index the user chose, by pressing a
// tab or, where the platform swipes between panels, by swiping. `variant`
// styles the tab strip, where a target draws one of its own.
component tabs(
    :selected int,
    variant   TabsVariant = TabsVariant.underline,
    style     Style = Style{},
    @change(index int),
    // The tabs, in the order the strip shows them.
    items     ...component tab,
) node {
    vbox(style={...style}) {
        hbox(style={gap=4px}) {
            for var k, t = items {
                button(
                    text = t.label,
                    disabled = t.disabled,
                    style = {fontWeight=k == selected ? FontWeight.bold : FontWeight.normal},
                    @click {
                        selected = k
                        change(k)
                    },
                )
            }
        }
        for var k, t = items {
            vbox(style={display=k == selected ? Display.flex : Display.none}) {
                t.content
            }
        }
    }
}

component _example_tabs node {
    var selected = 0
    vbox(style={padding=16px}) {
        tabs(:selected=selected) {
            tab(label="Overview") {
                text(value="Overview content")
            }
            tab(label="Details") {
                text(value="Detail content")
            }
            tab(label="Settings", disabled=true) {
                text(value="Settings content")
            }
        }
    }
}

// One entry of a menu or a menu bar: data, since it names itself as its
// family, so the menu reads its entries as a list rather than rendering them.
// `@select` fires when the user picks it; the entries under it are its
// submenu. `checked` marks it chosen, with a check beside its label: the one
// of a submenu's entries that is the setting, or an entry that toggles one.
// Picking an entry does not check it; `@select` writes what `checked` reads.
component menuItem(
    label    string,       // what the entry shows
    disabled bool = false, // shown, but cannot be picked
    checked  bool = false, // shown chosen
    @select(),             // the user picked this entry
    // The entries of this one's submenu, in order.
    children ...component menuItem,
) menuItem

// Context or dropdown menu. Its entries are written as its children, each a
// `menuItem` carrying its own `@select`. `open` is its visibility. `@close`
// fires when the menu dismisses without a selection (click outside, Escape).
component menu(
    style Style = Style{},
    open  bool = false,
    @close(),
    // The entries, in order.
    items ...component menuItem,
) node

component _example_menu node {
    var showMenu = false
    var picked = ""
    vbox(style={padding=16px}) {
        button(text="Show Menu", @click { showMenu = true })
        menu(open=showMenu) {
            menuItem(label="Cut", @select { picked = "Cut" })
            menuItem(label="Copy", @select { picked = "Copy" })
            menuItem(label="Paste", disabled=true)
        }
    }
}

// Horizontal menu bar — typically at the top of a window on desktop. Its
// top-level entries are written as its children, each a `menuItem` whose own
// children are its menu.
component menubar(
    style Style = Style{},
    // The top-level entries, in order.
    items ...component menuItem,
) node

component _example_menubar node {
    vbox(style={padding=16px}) {
        menubar {
            menuItem(label="File") {
                menuItem(label="Open")
                menuItem(label="Save")
            }
            menuItem(label="Edit")
            menuItem(label="View")
            menuItem(label="Help")
        }
    }
}

// Horizontal bar of controls: its children, a mix of buttons, separators and
// spacers, each answering for itself.
component toolbar(
    style    Style = Style{},
    controls ...component,
) node

component _example_toolbar node {
    vbox(style={padding=16px}) {
        toolbar {
            button(text="New")
            button(text="Open")
            button(text="Save")
            spacer
            button(text="Settings")
        }
    }
}
