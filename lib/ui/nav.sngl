// Where a followed link opens: in place of the current view, or in a new
// window.
enum LinkTarget { self, blank }

// Navigational hyperlink. `href` is the destination — an external
// URL, an in-app route, or a file path depending on the platform.
// `target` controls whether navigation replaces
// the current view or opens a new window. `@click` runs before
// navigation and can short-circuit it by raising an error.
component link(
    text      string,
    href      string,
    target    LinkTarget = LinkTarget.self,
    disabled  bool = false,
    focusable bool = true,
    style     Style = Style{},
    @click(),
) node

component _example_link node {
    hbox(style={gap=16px, padding=16px}) {
        link(href="https://example.com", text="Example Site")
        link(href="https://example.com", text="New Tab", target=blank)
    }
}

// How a tab strip marks the selected tab.
enum TabsVariant { underline, pills }

// Tabbed navigation. `items` labels each tab; `selected` is the
// 0-based index of the active tab and is two-way bound. Children of
// `tabs` are the panels: one per item, in the same order. `variant`
// styles the tab strip; `@change` fires with
// the newly selected index.
// TODO Use families pass the tabs as children
component tabs(
    items    list<string>,
    selected int = 0,
    variant  TabsVariant = TabsVariant.underline,
    style    Style = Style{},
    @change(),
    panels   ...component,
) node

component _example_tabs node {
    var selected = 0
    vbox(style={padding=16px}) {
        tabs(items=["Overview", "Details", "Settings"], selected=selected) {
            text(value="Overview content")
            text(value="Detail content")
            text(value="Settings content")
        }
    }
}

// One entry of a menu or a menu bar: data, since it names itself as its
// family, so the menu reads its entries as a list rather than rendering them.
// `@select` fires when the user picks it; the entries under it are its
// submenu.
component menuItem(
    label    string,       // what the entry shows
    disabled bool = false, // shown, but cannot be picked
    @select(),             // the user picked this entry
    // The entries of this one's submenu, in order.
    children ...component menuItem,
) menuItem

// Context or dropdown menu. Its entries are written as its children, each a
// `menuItem` carrying its own `@select`. `open` is its visibility. `@close`
// fires when the menu dismisses without a selection (click outside, Escape).
component menu(
    style Style = Style{},
    open  bool = false,
    @close(),
    // The entries, in order.
    items ...component menuItem,
) node

component _example_menu node {
    var showMenu = false
    var picked = ""
    vbox(style={padding=16px}) {
        button(text="Show Menu", @click { showMenu = true })
        menu(open=showMenu) {
            menuItem(label="Cut", @select { picked = "Cut" })
            menuItem(label="Copy", @select { picked = "Copy" })
            menuItem(label="Paste", disabled=true)
        }
    }
}

// Horizontal menu bar — typically at the top of a window on desktop. Its
// top-level entries are written as its children, each a `menuItem` whose own
// children are its menu.
component menubar(
    style Style = Style{},
    // The top-level entries, in order.
    items ...component menuItem,
) node

component _example_menubar node {
    vbox(style={padding=16px}) {
        menubar {
            menuItem(label="File") {
                menuItem(label="Open")
                menuItem(label="Save")
            }
            menuItem(label="Edit")
            menuItem(label="View")
            menuItem(label="Help")
        }
    }
}

// Horizontal bar of controls: its children, a mix of buttons, separators and
// spacers, each answering for itself.
component toolbar(
    style    Style = Style{},
    controls ...component,
) node

component _example_toolbar node {
    vbox(style={padding=16px}) {
        toolbar {
            button(text="New")
            button(text="Open")
            button(text="Save")
            spacer
            button(text="Settings")
        }
    }
}
