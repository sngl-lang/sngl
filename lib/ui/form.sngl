import marks "sngl:internal/marks"
import time "sngl:time"

// Clickable button that triggers an action, labeled with `text`. Set
// `disabled=true` to suppress input and render the disabled styling.
// `@click` fires on activation; `@longPress` fires after a sustained
// press on pointer/touch platforms.
component button(
    text      string,
    disabled  bool = false,
    focusable bool = true,
    style     Style = Style{},
    @click(),
    @longPress(),
) node

component _example_button node {
    var count = 0
    vbox(style={gap=8px, padding=16px}) {
        hbox(style={gap=8px}) {
            button(text="Click me", @click { count += 1 })
            button(text="Reset", @click { count = 0 })
            button(text="Disabled", disabled=true)
        }
        text(value="Clicked " + string(count) + " times")
    }
}

// What an input field holds, which a platform may answer with a keyboard,
// masking or validation of its own.
enum InputType { text, password, search, email, number, tel, url }

// Single-line text input field. `value` is a two-way prop: bound with
// `:value=v`, the field shows `v` and writes edits back to it; left unbound,
// the field keeps its own text, starting from a one-way `value=` if given. `placeholder` shows when
// empty; `readonly` disables edits while keeping focus/selection; set
// `type` to what the field holds for appropriate platform behavior. `@input` fires on every keystroke, `@change` on commit
// (blur or Enter), `@submit` on Enter. `maxLength` caps accepted input.
component input(
    placeholder string = "",
    readonly    bool = false,
    :value      string,
    disabled    bool = false,
    type        InputType = InputType.text,
    maxLength   int = 0,
    focusable   bool = true,
    style       Style = Style{},
    @input(value string),
    @change(value string),
    @focus(),
    @blur(),
    @submit(),
) node

component _example_input node {
    var name = ""
    vbox(style={gap=8px, padding=16px}) {
        input(placeholder="Enter your name", :value=name)
        input(placeholder="Password", type=password)
        input(placeholder="Search...", type=search)
        text(value="Hello, " + name)
    }
}

// Multi-line text input field. Mirrors `input` semantics for a
// multi-line editor: two-way bound `value`, `@input` per keystroke,
// `@change` on commit. `rows` controls the initial visible row count;
// the editor still scrolls when content exceeds it.
component textarea(
    placeholder string = "",
    readonly    bool = false,
    :value      string,
    disabled    bool = false,
    rows        int = 0,
    maxLength   int = 0,
    focusable   bool = true,
    style       Style = Style{},
    @input(value string),
    @change(value string),
    @focus(),
    @blur(),
) node

component _example_textarea node {
    var notes = ""
    vbox(style={gap=8px, padding=16px}) {
        textarea(placeholder="Write some notes...", rows=4, :value=notes)
        text(value="Length: " + string(notes.length()))
    }
}

// Boolean toggle rendered as a checkmark box. `checked` is two-way:
// bound with `:checked=v`, toggling the box writes `v` and writes to `v`
// update the box; left unbound, the box keeps its own state, starting from a
// one-way `checked=` if given. `label` is rendered next to the box; omit it for
// a bare checkbox. `@change` fires each time the user toggles, and
// carries the new state.
component checkbox(
    label     string = "",
    :checked  bool,
    disabled  bool = false,
    focusable bool = true,
    style     Style = Style{},
    @change(checked bool),
) node

component _example_checkbox node {
    var darkMode = false
    vbox(style={gap=8px, padding=16px}) {
        checkbox(:checked=darkMode, label="Dark mode")
        text(value=darkMode ? "Dark mode on" : "Dark mode off")
    }
}

// The axis a group of controls is laid out along.
enum Orientation { vertical, horizontal }

// Group of mutually exclusive options. Its choices are written as its
// children, each a `choice`, as a select's are. `value` is the value of the
// selected choice, of whatever type the choices hold, and selects the first
// choice holding it. `direction` is the axis the choices are laid out along.
// `@change` fires with the newly selected value on user selection.
component radio[T any](
    :value    T,
    disabled  bool = false,
    direction Orientation = Orientation.vertical,
    style     Style = Style{},
    @change(value T),
    // The choices, in the order they are laid out.
    options   ...component choice[T],
) node

component _example_radio node {
    var size = "medium"
    vbox(style={gap=8px, padding=16px}) {
        radio(:value=size, direction=horizontal) {
            choice(label="small", value="small")
            choice(label="medium", value="medium")
            choice(label="large", value="large")
        }
        text(value="Selected: " + size)
    }
}

// On/off switch control. `checked` is two-way bound. Semantically
// equivalent to `checkbox` but rendered as a switch affordance on
// platforms that distinguish the two.
component toggle(
    label     string = "",
    :checked  bool,
    disabled  bool = false,
    focusable bool = true,
    style     Style = Style{},
    @change(checked bool),
) node

component _example_toggle node {
    var notifications = false
    vbox(style={gap=8px, padding=16px}) {
        toggle(:checked=notifications, label="Notifications")
        text(value=notifications ? "Enabled" : "Disabled")
    }
}

// One of a select's choices: data, since it names itself as its family, so a
// select reads its choices as a list rather than rendering them. `label` is
// what it shows, and `value` what the select's `value` holds while it is
// selected.
component choice[T any](label string, value T) choice[T]

// Dropdown selection control. Its choices are written as its children, each a
// `choice`, under an `if` or a `for` where the list depends on something --
// `for var m = Method { choice(label="{m}", value=m) }` offers every member
// of an enum. `value` is the selected choice's value, two-way bound, of
// whatever type the choices hold, and selects the first choice holding it.
// `placeholder` shows when no choice holds it.
component select[T any](
    placeholder string = "",
    :value      T,
    disabled    bool = false,
    focusable   bool = true,
    style       Style = Style{},
    @change(value T),
    @focus(),
    @blur(),
    // The choices, in the order they are offered.
    options     ...component choice[T],
) node

// The label of the first of `options` holding `value`, or "" where none
// does: what a platform's control, which knows its choices by label, shows
// selected, and what a test choosing `value` hands it.
#[marks.builtin("choiceKey")]
const func choiceLabel[T any](options list[choice[T]], value T) string {
    for var o = options {
        if o.value == value {
            return o.label
        }
    }
    return ""
}

// The position of the first of `options` labeled `label`, or -1 where none
// is: a platform's control reports a choice by its label.
const func choiceLabeled[T any](options list[choice[T]], label string) int {
    for var i, o = options {
        if o.label == label {
            return i
        }
    }
    return -1
}

component _example_select node {
    var fruit = ""
    vbox(style={gap=8px, padding=16px}) {
        select(placeholder="Pick a fruit", :value=fruit) {
            choice(label="Apple", value="apple")
            choice(label="Banana", value="banana")
            choice(label="Cherry", value="cherry")
        }
        text(value="Selected: " + fruit)
    }
}

// Calendar-based date selection. `value` is the selected date
// (two-way bound). `min` / `max` clamp the selectable range;
// `placeholder` shows when no date is picked. `@change` fires once
// the user picks a date.
//
// All three are `option`s because each is absent until someone supplies it,
// and a `date` has no value meaning "none": its zero is the first day of year
// one, which is a date a picker would happily show.
component datepicker(
    placeholder string = "",
    min         option[time.date] = null,
    max         option[time.date] = null,
    :value      option[time.date],
    disabled    bool = false,
    style       Style = Style{},
    @change(value option[time.date]),
    @focus(),
    @blur(),
) node

component _example_datepicker node {
    vbox(style={padding=16px}) {
        datepicker(placeholder="Select a date")
    }
}
