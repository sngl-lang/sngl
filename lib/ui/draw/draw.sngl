import ui "sngl:ui"

// `shape` below is a family because it is a member of `build.family`, and
// `#[marks.builtin("familyShape")]` is how the compiler names that one family.
import build "sngl:build"
import math "sngl:math"
import marks "sngl:internal/marks"
import family "sngl:family"

// How the end of an open stroke is drawn: flat at the end point, rounded
// past it, or squared off past it.
enum LineCap { butt, round, square }

// How two segments of a stroke meet: a sharp corner, a rounded one, or one
// cut across.
enum LineJoin { miter, round, bevel }

// How a shape is painted. `fill` and `stroke` default to fully transparent,
// so a shape draws nothing until one of them is set. `fontSize` and
// `fontFamily` apply to `canvasText` only.
struct Style {
    fill        color = color{a=0}
    stroke      color = color{a=0}
    strokeWidth float = 1.0
    lineCap     LineCap = butt
    lineJoin    LineJoin = miter
    fontSize    float = 16.0
    fontFamily  string = "sans-serif"
}

// What one step of a path does.
enum PathOp { moveTo, lineTo, bezierTo, arcTo, close }

// The tree the shapes form. Declaring it here is what makes `shape` a name a
// component can resolve, so a misspelling is an unresolved name rather than a
// family nobody joins.
//
// The builtin mark is the one thing this family has that an ordinary one does
// not: passShapeDraw turns a canvas's children into the calls that paint them,
// so the compiler has to name the tree those rules are about. It names it by the mark rather than by
// the pair "sngl:ui/draw" and "shape", so a program declaring a `shape` family
// of its own is a different one and is not painted. `#[family.eventless]` is
// what a painted shape cannot do -- raise an event -- said by the family, so
// the checker holds its members to it without knowing what drawing is.
#[marks.builtin("familyShape")]
#[family.eventless]
component shape build.family

// How a canvas is shown when the room it is given is not the size it draws at.
// `width` and `height` are the coordinate space the shapes are placed in;
// this is what happens to the picture that space produces.
//
// `center` leaves it alone, at its own size, in the middle of whatever it was
// given — the default, because a drawing placed in pixels is one somebody
// measured. `fit` and `fill` both scale it evenly, `fit` until the whole of it
// is inside and `fill` until none of the space is left over, so `fill` crops
// where the shapes are the wrong shape for the room. `stretch` scales the two
// axes separately to land exactly on the edges, which is the only one that
// changes what the drawing looks like.
enum ScalingMode { center, fit, fill, stretch }

// Immediate-mode drawing surface. Its rest slot accepts shapes, so a canvas
// hosts them without being one. They paint in declaration order — later shapes
// cover earlier ones — in pixels from the top-left, whatever measurement unit
// `width` and `height` are given in.
//
// Those two are the coordinate space and not the size on screen: a canvas laid
// out bigger than it draws shows the picture per `scalingMode`.
component canvas(
    width       ui.measurement,
    height      ui.measurement,
    scalingMode ScalingMode,
    style       Style,
    @click(),
    shapes      ...component shape,
) ui.node {}

// Axis-aligned rectangle with its top-left corner at x, y.
component rect(x float, y float, w float, h float, style Style = Style{}) shape

// Circle of radius r centred at cx, cy.
component circle(cx float, cy float, r float, style Style = Style{}) shape

// Ellipse centred at cx, cy with radii rx and ry.
component ellipse(cx float, cy float, rx float, ry float, style Style = Style{}) shape

// Straight segment from x1, y1 to x2, y2. Uses `stroke`; a `fill` is
// meaningless on a line and is ignored.
component line(x1 float, y1 float, x2 float, y2 float, style Style = Style{}) shape

// Arbitrary shape built from the steps it holds, in order: `moveTo`, `lineTo`,
// `bezierTo`, `arcTo` and `close`.
component path(style Style = Style{}, steps ...component _step) shape

// One step of a path, as the overrides read it. Each `op` reads only the
// fields it needs and the rest keep their zero, which is why a program writes
// the step components below rather than this.
component _step(
    op  PathOp,
    x   float = 0.0,
    y   float = 0.0,
    cx1 float = 0.0,
    cy1 float = 0.0,
    cx2 float = 0.0,
    cy2 float = 0.0,
    r   float = 0.0,
) _step

// Starts a new subpath at x, y without drawing.
component moveTo(x float, y float) _step {
    _step(op=PathOp.moveTo, x=x, y=y)
}

// A straight segment to x, y.
component lineTo(x float, y float) _step {
    _step(op=PathOp.lineTo, x=x, y=y)
}

// A cubic Bézier curve to x, y, pulled toward the control points cx1, cy1
// and cx2, cy2.
component bezierTo(cx1 float, cy1 float, cx2 float, cy2 float, x float, y float) _step {
    _step(op=PathOp.bezierTo, cx1=cx1, cy1=cy1, cx2=cx2, cy2=cy2, x=x, y=y)
}

// The corner at cx, cy rounded off with radius r, tangent to the segment
// arriving at it and to the one leaving toward x, y.
component arcTo(cx float, cy float, x float, y float, r float) _step {
    _step(op=PathOp.arcTo, cx1=cx, cy1=cy, x=x, y=y, r=r)
}

// A straight segment back to where the subpath started, joined to it.
component close() _step {
    _step(op=PathOp.close)
}

// Text baseline-anchored at x, y. Named `canvasText` rather than `text` so
// a program can import this package alongside `sngl:ui`.
component canvasText(x float, y float, content string, style Style = Style{}) shape

// Image drawn into the box at x, y sized w by h, from any source a `ui.image`
// takes: a file, a fetched URL, or another drawing, which is painted in place
// scaled to the box rather than rasterised first.
component canvasImage(
    x   float,
    y   float,
    w   float,
    h   float,
    src ...component family.one<ui.imageSource>,
) shape

// A drawing as an image source: the shapes it holds, painted into a picture
// `width` by `height` pixels, which is what an `image`, a window's favicon or a
// `canvasImage` shows. Repainted when what the shapes read changes, as a
// canvas is.
component image(
    width  float,
    height float,
    shapes ...component shape,
) ui.imageSource

// --- Geometry ---
//
// The vocabulary a shape's own coordinates are written in, and what an
// override reaches for when it has to compute them: a dial hand, a polygon
// corner, the control points of a curve. All of it is plain SNGL over
// `sngl:builtin`'s trig, so it folds away wherever the inputs are constant.

// A position in the canvas's coordinate space.
struct Point {
    x float = 0.0
    y float = 0.0
}

// An extent in the same space. Named for its fields rather than `w`/`h` so a
// call site reads as the prop it fills.
struct Size {
    width  float = 0.0
    height float = 0.0
}

// The point at `angle` radians and `radius` from `center`, measuring
// clockwise from the positive x axis -- the direction screen coordinates run,
// where y grows downward.
//
// This is the one that makes an arc, a dial or a regular polygon writable: the
// alternative is trigonometry at every call site.
// Block bodies with the return type written out, not `=>`: in library source
// an unannotated expression body is inferred only when it answers a
// *primitive* -- `color.rgb() => color{…}` would otherwise shadow the `color`
// primitive in callers -- so a struct-returning helper stays `dyn`, and an
// expression body cannot carry an annotation to say otherwise.
const func Point.polar(center Point, radius float, angle float) Point {
    return Point{
        x = center.x + radius * math.cos(angle),
        y = center.y + radius * math.sin(angle),
    }
}

// `p` moved by dx, dy.
const func Point.offset(p Point, dx float, dy float) Point {
    return Point{x=p.x + dx, y=p.y + dy}
}

// The point `t` of the way from a to b, with t = 0 at a and t = 1 at b.
// Values outside that range extrapolate, which is deliberate: a control point
// often sits beyond the segment it belongs to.
const func Point.lerp(a Point, b Point, t float) Point {
    return Point{
        x = a.x + (b.x - a.x) * t,
        y = a.y + (b.y - a.y) * t,
    }
}

// The distance between two points.
const func Point.distance(a Point, b Point) => math.sqrt((b.x - a.x) * (b.x - a.x) + (b.y - a.y) * (b.y - a.y))

// The angle from a to b, in radians, as `Point.polar` measures it.
const func Point.angle(a Point, b Point) => math.atan2(b.y - a.y, b.x - a.x)

// The even scale that puts all of `inner` inside `outer`, and the one that
// leaves none of `outer` uncovered. These are `ScalingMode.fit` and
// `ScalingMode.fill` as a number, which is what a target's own scaling does to
// a canvas -- so an override that scales part of a drawing can ask the same
// question the platform does.
const func Size.fitScale(inner Size, outer Size) => float.min(outer.width / inner.width, outer.height / inner.height)

const func Size.fillScale(inner Size, outer Size) => float.max(outer.width / inner.width, outer.height / inner.height)

// --- The tangent arc ---

// Arc is the corner `arcTo` asks for, solved: round off
// the corner at `corner` with radius `r`, tangent to the segment arriving from
// `from` and to the one leaving toward `to`.
//
// Here rather than in a platform package because two targets need it and
// neither host has the primitive. Canvas2D and `pkg/go/canvas` take the
// tangent form directly; cairo takes a centre and two angles, and Compose's
// `Path.arcTo` takes a bounding box and two degrees. Both are the same three
// numbers this carries, so the trigonometry is written once.
struct Arc {
    // No arc to draw: a zero radius, a corner that does not turn, or one that
    // doubles back. The path goes to the corner itself, which is also what
    // `tan(half)` being zero or unbounded would otherwise make NaN.
    degenerate bool = false
    // Where the incoming line stops and where the outgoing one starts. The
    // path is left at `tangent2` -- not at `to`, which is the same place
    // Canvas2D leaves it and what a following command measures from.
    tangent1   Point = Point{}
    tangent2   Point = Point{}
    center     Point = Point{}
    // The arc's start angle in radians and its signed sweep. A negative sweep
    // turns the other way, which is `cairo_arc_negative` on one target and a
    // negative `sweepAngleDegrees` on the other.
    start      float = 0.0
    sweep      float = 0.0
}

// Named for what it solves, and the struct for what it is: SNGL tells a
// function from a struct by case and Go's export rule erases that, so
// `tangentArc` returning a `TangentArc` collided as one name in the emitted
// package and did not compile.
const func tangentArc(from Point, corner Point, to Point, r float) Arc {
    var a1 = Point.angle(corner, from)
    var a2 = Point.angle(corner, to)
    var turn = a2 - a1

    // The signed turn brought into (-pi, pi]: which way the corner bends is
    // what picks the sweep direction.
    if turn > math.pi {
        turn = turn - math.tau
    }
    if turn < -math.pi {
        turn = turn + math.tau
    }
    var half = float.abs(turn) / 2.0
    if r <= 0.0 || half < 0.0001 || half > 1.5706 {
        return Arc{degenerate=true, tangent1=corner, tangent2=corner, center=corner}
    }

    // Tangent points sit `r / tan(half)` along each ray from the corner, and
    // the centre `r / sin(half)` along the bisector. The arc between them
    // subtends `pi - |turn|`, turning against the corner's own bend.
    var reach = r / math.tan(half)
    var t1 = Point.polar(corner, reach, a1)
    var t2 = Point.polar(corner, reach, a2)
    var c = Point.polar(corner, r / math.sin(half), a1 + turn / 2.0)
    var sweep = math.pi - float.abs(turn)
    if turn > 0.0 {
        sweep = -sweep
    }
    return Arc{tangent1=t1, tangent2=t2, center=c, start=Point.angle(c, t1), sweep=sweep}
}
