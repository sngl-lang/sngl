// Displays a text string. Typography -- size, weight, color, alignment,
// `maxLines` truncation -- is driven entirely by `style`.
component text(
    value      string, // the text shown
    selectable bool,   // lets the platform offer copy
    style      Style,
    @click(e ClickEvent), // a tap or click, for text used as an action
) node

component _example_text node {
    vbox(style={gap=8px, padding=16px}) {
        text(value="Hello, World!", style={fontSize=24px, fontWeight=bold})
        text(value="Regular text")
        text(value="Colored text", style={color=#0066CC})
    }
}

// Displays an image from a URL or asset path.
component image(
    src   string,    // the URL or asset path
    alt   string,    // the accessibility label
    fit   ObjectFit, // how the image is scaled into its frame
    style Style,
    @click(e ClickEvent),
    @load(e LoadEvent), // decoding completed
    // Fetching or decoding failed. The payload is the ambient `error` --
    // the value `error.raise` throws and a `boundary` catches, because a
    // failure is a failure whoever noticed it.
    @error(e error),
) node

component _example_image node {
    vbox(style={gap=8px, padding=16px}) {
        image(src="https://placehold.co/200x100", alt="Placeholder image", fit=contain)
    }
}

// Small status label — a compact chip showing a status, count, or
// category tag.
component badge(
    value   string, // the text shown
    variant string, // the color: "primary", "success", "warning", "error" or "neutral"
    size    string, // "small" or "medium"
    style   Style,
) node {
    text(value=value, style={display=inlineBlock, paddingY=2px, paddingX=8px, borderRadius=12px, ...style})
}

component _example_badge node {
    hbox(style={gap=8px, padding=16px, alignItems=center}) {
        badge(value="3", variant="primary")
        badge(value="New", variant="success")
        badge(value="Error", variant="error")
    }
}

// Compact interactive tag.
component chip(
    label     string, // the text shown
    variant   string, // the color
    removable bool,   // shows a remove affordance, which fires `@remove`
    selected  bool,   // styles the chip as active, as a filter that is on
    disabled  bool,
    focusable bool = true,
    style     Style,
    @click(e ClickEvent),
    @remove(e DismissEvent), // the remove affordance was used
) node {
    hbox(style={
        alignItems = center,
        gap = 4px,
        paddingY = 4px,
        paddingX = 12px,
        borderRadius = 16px,
        borderWidth = 1px,
        borderColor = selected ? #0066CC : #CCCCCC,
        opacity = disabled ? 0.5 : 1.0,
        ...style,
    }) {
        text(value=label, @click { click() })
        if removable {
            button(text="×", disabled=disabled, focusable=focusable, @click { remove({}) })
        }
    }
}

component _example_chip node {
    hbox(style={gap=8px, padding=16px}) {
        chip(label="Tag")
        chip(label="Removable", removable=true)
        chip(label="Success", variant="success")
    }
}

// A preset size for a component that offers three.
enum SizePreset { small, medium, large }

// The outline an avatar is clipped to.
enum AvatarVariant { circle, square }

// User profile image with fallback: the image where there is one, and the
// initials in a styled placeholder otherwise.
component avatar(
    initials string,              // shown when there is no `src`
    size     SizePreset = medium, // a preset; `style.width` and `style.height` set any other size
    variant  AvatarVariant,       // the outline it is clipped to
    src      string,              // the image, a URL or asset path
    alt      string,              // the image's accessibility label
    style    Style,
    @click(e ClickEvent),
) node {
    if src != "" {
        image(
            src = src,
            alt = alt,
            fit = cover,
            style = {
                width = _avatarSide(size),
                height = _avatarSide(size),
                borderRadius = _avatarRadius(size, variant),
                ...style,
            },
            @click { click() },
        )
    } else {
        text(
            value = initials,
            style = {
                display = inlineFlex,
                alignItems = center,
                justifyContent = center,
                width = _avatarSide(size),
                height = _avatarSide(size),
                textAlign = center,
                borderRadius = _avatarRadius(size, variant),
                background = #CCCCCC,
                ...style,
            },
            @click { click() },
        )
    }
}

// The side of an avatar of each preset size.
const func _avatarSide(size SizePreset) measurement {
    if size == SizePreset.small {
        return 24px
    }
    if size == SizePreset.large {
        return 64px
    }
    return 40px
}

// A circle's radius is half its side; a square keeps a small rounding.
const func _avatarRadius(size SizePreset, variant AvatarVariant) measurement {
    if variant == AvatarVariant.square {
        return 4px
    }
    return _avatarSide(size) * 0.5
}

component _example_avatar node {
    hbox(style={gap=8px, padding=16px}) {
        avatar(initials="JD")
        avatar(initials="AB", variant=square)
        avatar(initials="XY", size=large)
    }
}

// Progress indicator, showing the fraction `value / max` filled.
//
// Written with no `value` it is *indeterminate*: a bar that says work is
// happening and not how much is left. That is why `value` is an `option` --
// zero is a legitimate fraction and cannot double as "not known", and each
// platform has its own shape for the indeterminate one.
component progress(
    style     Style,
    value     option<float>, // how far along; none for work of unknown length
    // The value `value` is measured against. One rather than zero, because a
    // platform that wants a fraction divides by it and every platform that
    // does not still has to render something: `<progress max="0">` is invalid
    // HTML, and a GTK fraction of value/0 is not a number.
    max       float = 1,
    label     string, // a short description of the work
    variant   string, // the color: "primary", "success", "warning" or "error"
    showValue bool,   // shows a numeric read-out beside the bar
) node

component _example_progress node {
    vbox(style={gap=8px, padding=16px}) {
        progress(value=0.7, max=1, label="70% complete", showValue=true)
        progress(value=3, max=10)
        progress(label="working")
    }
}

// The shape a spinner turns in.
enum SpinnerVariant { circle, bar }

// Indeterminate loading indicator. Use when progress cannot be measured.
component spinner(
    label   string,         // an accessible description, announced by screen readers
    variant SpinnerVariant, // the shape it turns in
    size    SizePreset = medium,
    style   Style,
) node

component _example_spinner node {
    hbox(style={gap=16px, padding=16px, alignItems=center}) {
        spinner(label="Loading...")
        spinner(variant=circle, size=large)
    }
}

// Which way a table's sorted column runs, if it is sorted at all.
enum SortDirection { none, asc, desc }

// Tabular data display.
// TODO should use families to define rows as children
component table(
    style         Style,
    columns       list<string>, // the column headers
    // The cell grid: one list per row, each cell aligned to its column by
    // position.
    rows          list<list<string>> = [],
    selectable    bool,          // lets the user select a row
    :selected     int,           // the selected row's index from 0
    sortable      bool,          // lets the user re-order by a column
    sortColumn    string,        // the column the rows are sorted by
    sortDirection SortDirection, // which way the sorted column runs
    @select(e SelectEvent),      // the selection changed
    @sort(e ChangeEvent),        // the user changed the sort
) node

component _example_table node {
    vbox(style={padding=16px}) {
        table(columns=["Name", "Role", "Status"])
    }
}

// Hierarchical data display.
// TODO should use families to define nodes as children
component tree(
    style     Style,
    items     list<string>, // the visible row labels, in traversal order
    :selected string,       // the label of the selected row
    expanded  list<int>,    // the indices of the expanded nodes
    @select(e SelectEvent), // a row was picked
    @expand(e ExpandEvent), // the user expanded or collapsed a node
) node

component _example_tree node {
    vbox(style={padding=16px}) {
        tree(items=["Documents", "Photos", "Music", "Videos"])
    }
}

// TODO Components take positional arguments. We prefer putting the ones that make sense early,
// but a user could use them all that way. We should make a way to cut off positional arguments.
// (it would work for functions and events too), `_ enum{}` might work already. (unnabable and unprovidable)
// Make it backwards compatible to rearrange. Similar to the `_ [0]func()` hack in Go to make structs uncomparable.
