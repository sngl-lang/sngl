// 2D shapes and the canvas that hosts them, and the `shape` tree they are
// members of. A component joins it by naming that tree in its return position.
//
// The shapes live here rather than in `sngl://std` because `canvas`, `rect`,
// `line` and `path` are names an application usually wants for itself.

// std is qualified rather than dot-imported: a lib package is loaded into the
// checker's own symbol table, so names it lifts become indistinguishable from
// names it declares and would be re-lifted by `import . "sngl://draw"`. User
// packages do not re-export a dot import, and neither should this one.
import std "sngl://std"

// `#[tree.kind]` is what marks the shape struct below as naming a tree.
import tree "sngl://tree"

// How a shape is painted. `fill` and `stroke` default to fully transparent,
// so a shape draws nothing until one of them is set. `fontSize` and
// `fontFamily` apply to `canvasText` only.
struct CanvasStyle {
    fill color = color{a=0}
    stroke color = color{a=0}
    strokeWidth float = 1.0
    lineCap string = "butt"
    lineJoin string = "miter"
    fontSize float = 16.0
    fontFamily string = "sans-serif"
}

// One step of a path. `op` is "moveTo", "lineTo", "bezierTo", "arcTo" or
// "close", and each reads only the fields it needs: `bezierTo` both control
// points and the end point, `arcTo` one control point, the end point and
// the radius `r`. The rest keep their zero value.
struct PathCmd {
    op string
    x float = 0.0
    y float = 0.0
    cx1 float = 0.0
    cy1 float = 0.0
    cx2 float = 0.0
    cy2 float = 0.0
    r float = 0.0
}

// The tree the shapes form. Declaring it here is what makes `shape` a name a
// component can resolve, so a misspelling is an unresolved name rather than a
// family nobody joins.
#[tree.kind]
struct shape {}

// Immediate-mode drawing surface. Its default slot accepts shapes, so a canvas
// hosts them without being one. They paint in declaration order — later shapes
// cover earlier ones — in pixels from the top-left, whatever measurement unit
// `width` and `height` are given in.
component canvas(
    width std.measurement,
    height std.measurement,
    style CanvasStyle,
    @click std.ClickEvent,
    slot _ shape,
) {}

// Axis-aligned rectangle with its top-left corner at x, y.
component rect(x float, y float, w float, h float, style CanvasStyle) shape {}

// Circle of radius r centred at cx, cy.
component circle(cx float, cy float, r float, style CanvasStyle) shape {}

// Ellipse centred at cx, cy with radii rx and ry.
component ellipse(cx float, cy float, rx float, ry float, style CanvasStyle) shape {}

// Straight segment from x1, y1 to x2, y2. Uses `stroke`; a `fill` is
// meaningless on a line and is ignored.
component line(x1 float, y1 float, x2 float, y2 float, style CanvasStyle) shape {}

// Arbitrary shape built from a list of PathCmd steps.
component path(cmds list<PathCmd>, style CanvasStyle) shape {}

// Text baseline-anchored at x, y. Named `canvasText` rather than `text` so
// a program can import this package alongside `sngl://std`.
component canvasText(x float, y float, content string, style CanvasStyle) shape {}

// Image drawn into the box at x, y sized w by h. `src` takes the same URL
// or asset path as `std.image`.
component canvasImage(x float, y float, w float, h float, src string) shape {}
