// 2D shapes and the canvas that hosts them. Importing this package brings both
// the shape components and the `#[draw.shape]` mark that declares new ones.
//
// The shapes live here rather than in `sngl://std` because `canvas`, `rect`,
// `line` and `path` are names an application usually wants for itself.

// std is qualified rather than dot-imported: a lib package is loaded into the
// checker's own symbol table, so names it lifts become indistinguishable from
// names it declares and would be re-lifted by `import . "sngl://draw"`. User
// packages do not re-export a dot import, and neither should this one.
import std "sngl://std"

// `Macro` is the return type that makes `shape` a mark rather than a
// function.
import ir "sngl://internal/ir"

// `shape` is this package's public spelling of `tree.kind("shape")`; the tree
// marks themselves are internal to the compiler.
import tree "sngl://tree"

// How a shape is painted. `fill` and `stroke` default to fully transparent,
// so a shape draws nothing until one of them is set. `fontSize` and
// `fontFamily` apply to `canvasText` only.
struct CanvasStyle {
    fill        color  = color{a=0}
    stroke      color  = color{a=0}
    strokeWidth float  = 1.0
    lineCap     string = "butt"
    lineJoin    string = "miter"
    fontSize    float  = 16.0
    fontFamily  string = "sans-serif"
}

// One step of a path. `op` is "moveTo", "lineTo", "bezierTo", "arcTo" or
// "close", and each reads only the fields it needs: `bezierTo` both control
// points and the end point, `arcTo` one control point, the end point and
// the radius `r`. The rest keep their zero value.
struct PathCmd {
    op  string
    x   float = 0.0
    y   float = 0.0
    cx1 float = 0.0
    cy1 float = 0.0
    cx2 float = 0.0
    cy2 float = 0.0
    r   float = 0.0
}

// Immediate-mode drawing surface. Its children are the shapes to paint, in
// declaration order — later shapes cover earlier ones. Coordinates are in
// pixels from the top-left of the canvas, whatever measurement unit
// `width` and `height` are given in.
#[tree.children("shape")]
component canvas(width std.measurement, height std.measurement, style CanvasStyle, @click std.ClickEvent) {}

// Axis-aligned rectangle with its top-left corner at x, y.
#[tree.kind("shape")]
component rect(x float, y float, w float, h float, style CanvasStyle) {}

// Circle of radius r centred at cx, cy.
#[tree.kind("shape")]
component circle(cx float, cy float, r float, style CanvasStyle) {}

// Ellipse centred at cx, cy with radii rx and ry.
#[tree.kind("shape")]
component ellipse(cx float, cy float, rx float, ry float, style CanvasStyle) {}

// Straight segment from x1, y1 to x2, y2. Uses `stroke`; a `fill` is
// meaningless on a line and is ignored.
#[tree.kind("shape")]
component line(x1 float, y1 float, x2 float, y2 float, style CanvasStyle) {}

// Arbitrary shape built from a list of PathCmd steps.
#[tree.kind("shape")]
component path(cmds list<PathCmd>, style CanvasStyle) {}

// Text baseline-anchored at x, y. Named `canvasText` rather than `text` so
// a program can import this package alongside `sngl://std`.
#[tree.kind("shape")]
component canvasText(x float, y float, content string, style CanvasStyle) {}

// Image drawn into the box at x, y sized w by h. `src` takes the same URL
// or asset path as `std.image`.
#[tree.kind("shape")]
component canvasImage(x float, y float, w float, h float, src string) {}

// Marks a component as a shape: something a `canvas` hosts and paints rather
// than a widget the layout places.
//
// A shape's children are shapes, so it declares no children type of its own,
// and it may declare no events — a painted shape has nothing to raise one
// from.
func shape() ir.Macro {}
