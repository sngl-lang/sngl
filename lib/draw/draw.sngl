// 2D shapes and the canvas that hosts them. The package also carries the
// `shape` macro, so `import "sngl://draw"` brings both the components and the
// mark that declares new ones.
//
// std is qualified rather than dot-imported: a lib package is loaded into the
// checker's own symbol table, so names it lifts become indistinguishable from
// names it declares and would be re-lifted by `import . "sngl://draw"`. User
// packages do not re-export a dot import, and neither should this one.
import std "sngl://std"

struct CanvasStyle {
    fill        color  = color{a=0}
    stroke      color  = color{a=0}
    strokeWidth float  = 1.0
    lineCap     string = "butt"
    lineJoin    string = "miter"
    fontSize    float  = 16.0
    fontFamily  string = "sans-serif"
}

struct PathCmd {
    op  string
    x   float = 0.0
    y   float = 0.0
    cx1 float = 0.0
    cy1 float = 0.0
    cx2 float = 0.0
    cy2 float = 0.0
    r   float = 0.0
}

component canvas(width std.measurement, height std.measurement, style CanvasStyle, @click std.ClickEvent) list<shape> {}

component rect(x float, y float, w float, h float, style CanvasStyle) list<shape> {}

component circle(cx float, cy float, r float, style CanvasStyle) list<shape> {}

component ellipse(cx float, cy float, rx float, ry float, style CanvasStyle) list<shape> {}

component line(x1 float, y1 float, x2 float, y2 float, style CanvasStyle) list<shape> {}

component path(cmds list<PathCmd>, style CanvasStyle) list<shape> {}

component canvasText(x float, y float, content string, style CanvasStyle) list<shape> {}

component canvasImage(x float, y float, w float, h float, src string) list<shape> {}
