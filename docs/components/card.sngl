output {
    js { html }
}

component main {
    vbox(style={gap=12, padding=16}) {
        card(variant="outlined") {
            text(value="Outlined", style={fontWeight="bold"})
            text(value="Card with a border")
        }
        card(variant="elevated") {
            text(value="Elevated", style={fontWeight="bold"})
            text(value="Card with a shadow")
        }
        card(variant="filled") {
            text(value="Filled", style={fontWeight="bold"})
            text(value="Card with a background")
        }
    }
}
