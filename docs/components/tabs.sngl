output {
    js { html }
}

component main {
    var selected = 0

    vbox(style={gap=8, padding=16}) {
        tabs(items=["Overview", "Details", "Settings"], selected=selected) {
            text(value="Welcome to the overview.")
            text(value="Here are the details.")
            text(value="Adjust your settings here.")
        }
    }
}
