output {
    js { html }
}

component main {
    var showModal = false

    vbox(style={gap=8, padding=16}) {
        button(text="Open Modal", @click={ showModal = true })
        modal(open=showModal, title="Confirm Action", closable=true) {
            text(value="Are you sure you want to proceed?")
            hbox(style={gap=8}) {
                button(text="Cancel", @click={ showModal = false })
                button(text="Confirm", @click={ showModal = false })
            }
        }
    }
}
