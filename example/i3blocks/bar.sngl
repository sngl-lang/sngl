// An i3 status bar, and a GTK or Fyne window in the same process that shows
// what the bar is showing.
//
// In ~/.config/i3/config:
//
//     bar {
//         status_command ~/bin/i3blocks-demo
//     }
//
// Build with `sngl build --lang go --platform gtk4 --opt name=i3blocks-demo -o ~/bin bar.sngl`.
import i3 "./i3"
import time "sngl:time"
import ui "sngl:ui"

// One binary per host. Both are Go, so both pick `i3.block[go.language]`.
output {
    go {
        gtk4
        fyne
    }
}

var (
    uptime = 0
    samples list<int> = []
    workspaces = ["web", "code", "chat"]
    focused = 0
    details = false
)

func load() => samples.length == 0 ? 0 : samples[samples.length - 1]

// Timers belong to no family, so one may sit at the package root beside the
// bar and the window.
time.timer(interval=1s, @tick {
    uptime += 1
    samples.push((uptime * 7) % 11)
})

i3.bar {
    for var i, w = workspaces {
        i3.text(
            name="ws",
            full=w,
            color=i == focused ? #ffffff : #888888,
            separator=false,
            @click {
                focused = i
            },
        )
    }
    i3.gap(width=24)
    i3.text(
        name="load",
        full="load {load()}",
        color=load() > 7 ? #ff5555 : #a3be8c,
        urgent=load() > 9,
        @click(button) {
            // Left click shows the samples in the window; right click hides
            // them.
            details = button == 1
        },
    )
    i3.text(name="uptime", full="up {uptime}s", short="{uptime}s")
}

ui.window(title="Load") {
    ui.vbox(style={gap=8, padding=16}) {
        ui.text(value="{workspaces[focused]}: load {load()} after {uptime}s", style={fontWeight=bold})
        if details {
            ui.vbox(style={gap=2}) {
                for var s = samples {
                    ui.text(value="{s}")
                }
            }
            ui.button(text="Clear", @click {
                samples = []
            })
        }
    }
}
