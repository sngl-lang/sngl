import . "sngl:ui"
import . "sngl:time"
import . "sngl:app"

output {
	none {
		html(stylesheet="public/style.css")
	}
}

import "go:git.duckfam.us/jonathan/sngl/docs"
import "go:git.duckfam.us/jonathan/sngl/docs/lookup"
import "file:public"
import pgAssets "file:internal/playground/assets"
import "internal/docui"
import "internal/learn"
import "sngl:platform/html"

const pages = docs.Pages()
const components = docs.LibraryComponents()
const curated = docs.CuratedComponents()
const curatedLabel = docs.CuratedRestLabel()
const curatedHref = docs.CuratedPkgHref()
const targets = docs.Targets()
const lessonSections = docs.Tutorial()
const navTree = docs.NavTree()
const libraryTree = lookup.LibraryTree()
const allPackages = lookup.LibraryPackages()
const allDeclPages = lookup.AllDeclPages()
const searchEntries = docs.SearchIndex()
const logo = public.path("sngl.svg")
const screenshotWeb = public.path("snapshots/todo/todo_html.png")
const screenshotTerminal = public.path("snapshots/todo/todo_bubbletea.png")
const screenshotDesktop = public.path("snapshots/todo/todo_fyne.png")
const screenshotAndroid = public.path("snapshots/todo/todo_android.png")

component NavSidebar(currentHref = "") {
	docui.Sidebar(homeHref="/index.html", logo=logo) {
		docui.SearchBox(entries=searchEntries)
		html.ul {
			for var group = navTree {
				if group.title == "" {
					for var item = group.items {
						docui.NavItem(text=item.title, href=item.href, active=currentHref == item.href)
					}
				}
				if group.title != "" {
					docui.NavGroup(title=group.title, href=group.href) {
						for var item = group.items {
							docui.NavItem(text=item.title, href=item.href, active=currentHref == item.href)
						}
					}
				}
			}
		}
	}
}

component PlatformCarousel() {
	var (
		active = 0
		rotating = true
	)
	timer(interval=5000ms, enabled=rotating, @tick {
		active = (active + 1) % 4
	})

	vbox(style={gap=16, alignItems="center", padding="32 0"}) {
		stack {
			if active == 0 {
				image(src=screenshotWeb, alt="SNGL Todo App on Web", fit=contain,
					style={maxWidth=800, maxHeight=500, borderRadius=8, width="100%"})
			}
			if active == 1 {
				image(src=screenshotTerminal, alt="SNGL Todo App in Terminal", fit=contain,
					style={maxWidth=800, maxHeight=500, borderRadius=8, width="100%"})
			}
			if active == 2 {
				image(src=screenshotDesktop, alt="SNGL Todo App on Desktop", fit=contain,
					style={maxWidth=800, maxHeight=500, borderRadius=8, width="100%"})
			}
			if active == 3 {
				image(src=screenshotAndroid, alt="SNGL Todo App on Android", fit=contain,
					style={maxWidth=800, maxHeight=500, borderRadius=8, width="100%"})
			}
		}
		hbox(style={gap=8}) {
			button(text="Web", @click { active = 0 },
				style={paddingLeft=20, paddingRight=20, borderRadius=20,
					background=active == 0 ? "#2196f3" : "#f5f5f5",
					color=active == 0 ? "#fff" : "#333"})
			button(text="Terminal", @click { active = 1 },
				style={paddingLeft=20, paddingRight=20, borderRadius=20,
					background=active == 1 ? "#2196f3" : "#f5f5f5",
					color=active == 1 ? "#fff" : "#333"})
			button(text="Desktop", @click { active = 2 },
				style={paddingLeft=20, paddingRight=20, borderRadius=20,
					background=active == 2 ? "#2196f3" : "#f5f5f5",
					color=active == 2 ? "#fff" : "#333"})
			button(text="Android", @click { active = 3 },
				style={paddingLeft=20, paddingRight=20, borderRadius=20,
					background=active == 3 ? "#2196f3" : "#f5f5f5",
					color=active == 3 ? "#fff" : "#333"})
		}
	}
}

component PageLayout(title = "", currentHref = "", children ...component) {
	if PLATFORM == html.platform {
		html.div(class="site") {
			html.div(innerHTML="<input type='checkbox' id='nav-toggle' class='nav-toggle'><label class='nav-hamburger' for='nav-toggle'>&#9776;</label>")
			NavSidebar(currentHref=currentHref)
			html.main {
				html.article {
					html.h1(innerText=title)
					children
				}
				html.footer(class="site-footer") {
					// docsgen replaces the year marker with the commit's year.
					html.span(class="copyright",
						innerHTML="&copy; <!-- sngl:year --> Jonathan Duck. All rights reserved.")
					html.span(class="footer-meta") {
						html.a(href="https://git.duckfam.us/jonathan/sngl", innerText="Source")
						// docsgen replaces the marker with the commit this site
						// was generated from; plain `sngl generate` leaves it out.
						html.span(class="build-stamp", innerHTML="<!-- sngl:build -->")
					}
				}
			}
		}
	} else {
		hbox {
			NavSidebar(currentHref=currentHref)
			vbox(style={padding=24, flex=1}) {
				text(value=title, style={fontSize=28, fontWeight="bold"})
				children
			}
		}
	}
}

component PlaygroundContent() {
	if PLATFORM == html.platform {
		html.link(rel="stylesheet", href=pgAssets.path("playground.css"))
		html.link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism-tomorrow.min.css")
		html.div(class="playground-toolbar") {
			html.select(id="examples") {
				html.option(value="", innerText="Examples...")
				html.option(value="default", innerText="Hello")
			}
			html.button(id="format-btn", type="button", title="Format (Shift+Alt+F)", innerText="Format")
			html.span(class="status", id="status", innerText="Loading WASM...")
		}
		html.div(class="error-banner", id="error")
		html.div(class="split-pane") {
			html.div(class="editor-pane", id="editor-pane")
			html.div(class="output-pane") {
				html.div(class="tab-bar", innerHTML="<button class='active' data-tab='preview'>Preview</button><button data-tab='code'>Code</button><button data-tab='ast'>AST</button>")
				html.div(class="tab-content") {
					html.div(class="tab-panel active", id="tab-preview") {
						html.iframe(id="preview")
					}
					html.div(class="tab-panel", id="tab-code") {
						html.div(id="code-header") {
							html.select(id="target-select")
						}
						html.pre(id="code-output") {
							html.code
						}
					}
					html.div(class="tab-panel", id="tab-ast") {
						html.div(id="ast-output")
					}
				}
			}
		}
		html.div(id="playground-sources")
		html.script(innerHTML="window.__sngl_wasm_url=\"" + pgAssets.path("sngl.wasm") + "\";")
		html.script(src=pgAssets.path("wasm_exec.js"))
		html.script(src="https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js")
		html.script(src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-go.min.js")
		html.script(src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-javascript.min.js")
		html.script(src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-markup.min.js")
		html.script(src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-clike.min.js")
		html.script(src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-kotlin.min.js")
		html.script(type="module", src=pgAssets.path("playground.js"))
	} else {
		text(value="Interactive playground — available in browser only.")
	}
}

component TutorialContent() {
	if PLATFORM == html.platform {
		html.link(rel="stylesheet", href=pgAssets.path("playground.css"))
		html.link(rel="stylesheet", href=pgAssets.path("tutorial.css"))
		html.div(class="tutorial-layout") {
			html.aside(id="lesson-nav", class="tutorial-nav") {
				for var section = lessonSections {
					html.div(class="tutorial-section") {
						html.h3(innerText=section.title)
						html.ul {
							for var lesson = section.lessons {
								html.li {
									html.a(innerText=lesson.title, href="#lesson=" + lesson.slug)
								}
							}
						}
					}
				}
			}
			html.div(class="tutorial-prose-pane") {
				html.h2(id="lesson-title")
				html.div(id="lesson-prose", class="tutorial-prose")
			}
			html.div(class="tutorial-playground") {
				html.div(class="editor-pane", id="editor-pane")
				html.div(class="tutorial-preview-pane") {
					html.iframe(id="preview", class="tutorial-preview")
					html.div(class="error-banner", id="error")
				}
				html.span(class="status", id="status", innerText="Loading WASM...")
			}
		}
		html.div(id="lesson-sources")
		html.script(innerHTML="window.__sngl_wasm_url=\"" + pgAssets.path("sngl.wasm") + "\";")
		html.script(src=pgAssets.path("wasm_exec.js"))
		html.script(type="module", src=pgAssets.path("tutorial.js"))
	} else {
		text(value="Interactive tutorial — available in browser only.")
	}
}

component main {
	// Components — the starter set, in reading order. Everything else is one
	// click on, in the package the component belongs to.
	window(title="Components", href="/components/index.html", favicon=logo) {
		PageLayout(title="Components", currentHref="/components/index.html") {
			html.p(innerText="The components a first application reaches for. Each links to its API reference and a live preview.")
			html.div(class="component-list") {
				for var comp = curated {
					html.a(class="component-card", href=comp.href) {
						html.h3(innerText=comp.name)
						html.p(innerText=comp.blurb)
					}
				}
			}
			html.p(class="browse-all") {
				html.a(href=curatedHref, innerText=curatedLabel)
			}
		}
	}

	// The library root: the packages, each imported by its own path.
	window(title="Library", href="/docs/sngl/index.html", favicon=logo) {
		PageLayout(title="The SNGL library", currentHref="/docs/sngl/index.html") {
			html.p(innerText="Every package of the embedded library. Only sngl:builtin is in scope without an import.")
			html.ul(class="decl-list") {
				for var pkg = libraryTree {
					html.li {
						html.a(href=pkg.href, innerText=pkg.title)
						html.span(innerText=pkg.blurb, class="decl-doc")
					}
				}
			}
		}
	}

	// Rich per-component pages (preview + highlighted code + props/events tables)
	for var comp = components {
		window #componentPage(title=comp.name, href=comp.href, favicon=logo) {
			PageLayout(title=comp.name, currentHref=componentPage.href) {
				html.p(innerText=comp.doc, class="component-blurb")

				docui.Markdown(src=comp.previewHTML)
				docui.Markdown(src=comp.highlightedCode)

				text(value="Properties", style={fontSize=20, fontWeight="bold"})
				docui.Table {
					docui.HeaderRow {
						docui.HeaderCell(value="Name")
						docui.HeaderCell(value="Type")
						docui.HeaderCell(value="Description")
					}
					for var prop = comp.props {
						docui.Row {
							docui.CodeCell(value=prop.name)
							docui.Cell(value=prop.type)
							docui.Cell(value=prop.doc)
						}
					}
				}
				text(value="Events", style={fontSize=20, fontWeight="bold"})
				docui.Table {
					docui.HeaderRow {
						docui.HeaderCell(value="Name")
						docui.HeaderCell(value="Payload Type")
					}
					for var evt = comp.events {
						docui.Row {
							docui.CodeCell(value=evt.name)
							docui.Cell(value=evt.payloadType)
						}
					}
				}
				text(value="Children: " + comp.children)
			}
		}
	}

	// One index page per package: the library's, then each target's.
	for var pkg = allPackages {
		window #packagePage(title=pkg.title, href=pkg.href, favicon=logo) {
			PageLayout(title=pkg.title, currentHref=packagePage.href) {
				docui.PackagePage(path=pkg.path, baseHref=pkg.baseHref)
			}
		}
	}

	// Per-decl detail pages across every package (top-level decls + type
	// methods + enum members). A library component is skipped by AllDeclPages
	// itself — it is rendered above as a rich page.
	for var d = allDeclPages {
		window #declPage(title=d.title, href=d.href, favicon=logo) {
			PageLayout(title=d.title, currentHref=d.href) {
				docui.Markdown(src=d.body)
			}
		}
	}

	// Platforms reference — capability matrix and per-platform options
	window(title="Platforms", href="/platforms/index.html", favicon=logo) {
		PageLayout(title="Built-in Platforms", currentHref="/platforms/index.html") {
			text(value="A platform decides what to render. The matrix below shows which optional capabilities each platform implements; each section documents the recognized `--opt key=value` options.")

			text(value="Global Options", style={fontSize=22, fontWeight="bold"})
			text(value="Declared by the standard library; accepted by every output target.")
			docui.Table {
				docui.HeaderRow {
					docui.HeaderCell(value="Name")
					docui.HeaderCell(value="Type")
					docui.HeaderCell(value="Description")
				}
				for var opt = targets.globalOptions {
					docui.Row {
						docui.CodeCell(value=opt.name)
						docui.Cell(value=opt.type)
						docui.Cell(value=opt.doc)
					}
				}
			}

			text(value="Capabilities", style={fontSize=22, fontWeight="bold"})
			docui.Table {
				docui.HeaderRow {
					docui.HeaderCell(value="Platform")
					for var col = targets.platformCapabilities {
						docui.HeaderCell(value=col)
					}
				}
				for var p = targets.platforms {
					docui.Row {
						docui.CodeCell(value=p.name)
						for var c = p.capabilities {
							docui.Cell(value=c.value == "" ? "—" : c.value)
						}
					}
				}
			}

			for var p = targets.platforms {
				text(value=p.name, style={fontSize=20, fontWeight="bold"})
				text(value=p.doc)
				text(value="Supported languages:")
				for var lname = p.languages {
					text(value="• " + lname, style={fontFamily="monospace"})
				}
				text(value="Options", style={fontSize=16, fontWeight="bold"})
				docui.Table {
					docui.HeaderRow {
						docui.HeaderCell(value="Name")
						docui.HeaderCell(value="Type")
						docui.HeaderCell(value="Description")
					}
					for var opt = p.options {
						docui.Row {
							docui.CodeCell(value=opt.name)
							docui.Cell(value=opt.type)
							docui.Cell(value=opt.doc)
						}
					}
				}
			}
		}
	}

	// Languages reference — capability matrix and per-language options
	window(title="Languages", href="/languages/index.html", favicon=logo) {
		PageLayout(title="Built-in Languages", currentHref="/languages/index.html") {
			text(value="A language decides what code to emit. The matrix below shows which optional capabilities each language implements; each section documents the recognized `--opt key=value` options.")

			text(value="Capabilities", style={fontSize=22, fontWeight="bold"})
			docui.Table {
				docui.HeaderRow {
					docui.HeaderCell(value="Language")
					for var col = targets.languageCapabilities {
						docui.HeaderCell(value=col)
					}
				}
				for var l = targets.languages {
					docui.Row {
						docui.CodeCell(value=l.name)
						for var c = l.capabilities {
							docui.Cell(value=c.value == "" ? "—" : c.value)
						}
					}
				}
			}

			for var l = targets.languages {
				text(value=l.name, style={fontSize=20, fontWeight="bold"})
				text(value=l.doc)
				text(value="Options", style={fontSize=16, fontWeight="bold"})
				docui.Table {
					docui.HeaderRow {
						docui.HeaderCell(value="Name")
						docui.HeaderCell(value="Type")
						docui.HeaderCell(value="Description")
					}
					for var opt = l.options {
						docui.Row {
							docui.CodeCell(value=opt.name)
							docui.Cell(value=opt.type)
							docui.Cell(value=opt.doc)
						}
					}
				}
			}
		}
	}

	// Documentation pages
	for var page = pages {
		window #docPage(title=page.title, href=page.href, favicon=logo) {
			PageLayout(title=page.title, currentHref=page.href) {
				if page.href == "/index.html" {
					PlatformCarousel
				}
				docui.Markdown(src=page.body)
			}
		}
	}

	// Playground (HTML-only content via platform body)
	window(title="Playground", href="/playground.html", favicon=logo) {
		PageLayout(title="Playground", currentHref="/playground.html") {
			PlaygroundContent
		}
	}

	// Tutorial (Go-tour-style interactive walkthrough)
	window(title="Tutorial", href="/tutorial.html", favicon=logo) {
		PageLayout(title="Tutorial", currentHref="/tutorial.html") {
			TutorialContent
		}
	}

	// Getting Started — rendered from the GettingStarted SNGL component
	// (getting_started.sngl) instead of the markdown pipeline so the prose,
	// code blocks, and per-language tabs work on every platform website.sngl
	// targets, not just html.
	window(title="Getting Started", href="/learn/getting-started.html", favicon=logo) {
		PageLayout(title="Getting Started", currentHref="/learn/getting-started.html") {
			learn.GettingStarted
		}
	}

}
