output {
	js {
		html(stylesheet="public/style.css")
	}
}

import "go://git.duckfam.us/jonathan/sngl/docs"
import "file://public"
import "internal/docui"

const pages = docs.Pages()
const tiers = docs.ComponentsByTier()
const components = docs.StdlibComponents()
const logo = public.path("sngl.svg")

component NavSidebar(currentHref = "") {
	docui.Sidebar(homeHref="/index.html") {
		docui.NavItem(text="SNGL", href="/index.html", active=currentHref == "/index.html")
		docui.NavGroup(title="Getting Started") {
			docui.NavItem(text="Installation", href="/getting-started/installation.html", active=currentHref == "/getting-started/installation.html")
			docui.NavItem(text="Your First App", href="/getting-started/first-app-web.html", active=currentHref == "/getting-started/first-app-web.html")
			docui.NavItem(text="Build Targets", href="/getting-started/build-targets.html", active=currentHref == "/getting-started/build-targets.html")
			docui.NavItem(text="Data Binding", href="/getting-started/data-binding.html", active=currentHref == "/getting-started/data-binding.html")
		}
		docui.NavGroup(title="Language") {
			docui.NavItem(text="Effective SNGL", href="/language/effective-sngl.html", active=currentHref == "/language/effective-sngl.html")
			docui.NavItem(text="Language Reference", href="/language/reference.html", active=currentHref == "/language/reference.html")
			docui.NavItem(text="Language Specification", href="/language/specification.html", active=currentHref == "/language/specification.html")
		}
		docui.NavItem(text="Components", href="/components/index.html", active=currentHref == "/components/index.html")
		docui.NavItem(text="Playground", href="/playground.html", active=currentHref == "/playground.html")
	}
}

component PageLayout(title = "", currentHref = "") list<component> {
	hbox {
		NavSidebar(currentHref=currentHref)
		vbox(style={padding=24, flex=1}) {
			text(value=title, style={fontSize=28, fontWeight="bold"})
			slot
		}
	}
}

component main {
	// Components gallery — grouped by tier
	window(title="Components", href="/components/index.html", favicon=logo) {
		PageLayout(title="Component Gallery", currentHref="/components/index.html") {
			text(value="Browse all built-in components with API reference and live previews.")
			docui.Gallery(hrefPrefix="/components/", hrefSuffix=".html")
		}
	}

	// Individual component pages
	for comp = components {
		window(title=comp.name, href="/components/" + comp.name + ".html", favicon=logo) {
			PageLayout(title=comp.name, currentHref="/components/" + comp.name + ".html") {
				docui.Detail(name=comp.name)

				html.div(innerHTML=comp.previewHTML)
				html.div(innerHTML=comp.highlightedCode)

				html.h2(innerText="Properties")
				html.table {
					html.thead {
						html.tr {
							html.th(innerText="Name")
							html.th(innerText="Type")
							html.th(innerText="Description")
						}
					}
					html.tbody {
						for prop = comp.props {
							html.tr {
								html.td {
									html.code(innerText=prop.name)
								}
								html.td {
									html.span(class="type-badge", innerText=prop.type)
								}
								html.td(innerText=prop.doc)
							}
						}
					}
				}
				html.h2(innerText="Events")
				html.table {
					html.thead {
						html.tr {
							html.th(innerText="Name")
							html.th(innerText="Payload Type")
						}
					}
					html.tbody {
						for evt = comp.events {
							html.tr {
								html.td {
									html.code(innerText=evt.name)
								}
								html.td(innerText=evt.payloadType)
							}
						}
					}
				}
				text(value="Children: " + comp.children)
			}
		}
	}

	// Documentation pages
	for page = pages {
		window(title=page.title, href=page.href, favicon=logo) {
			PageLayout(title=page.title, currentHref=page.href) {
				docui.Markdown(src=page.body)
			}
		}
	}

	// Playground
	window(title="Playground", href="/playground.html", favicon=logo) {
		PageLayout(title="Playground", currentHref="/playground.html") {
			html.link(rel="stylesheet", href="/assets/playground/playground.css")
			html.link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism-tomorrow.min.css")
			html.div(class="playground-toolbar") {
				html.select(id="examples") {
					html.option(value="", innerText="Examples...")
					html.option(value="default", innerText="Hello")
				}
				html.span(class="status", id="status", innerText="Loading WASM...")
			}
			html.div(class="error-banner", id="error")
			html.div(class="split-pane") {
				html.div(class="editor-pane", id="editor-pane")
				html.div(class="output-pane") {
					html.div(class="tab-bar", innerHTML="<button class='active' data-tab='preview'>Preview</button><button data-tab='code'>Code</button><button data-tab='ast'>AST</button>")
					html.div(class="tab-content") {
						html.div(class="tab-panel active", id="tab-preview") {
							html.iframe(id="preview")
						}
						html.div(class="tab-panel", id="tab-code") {
							html.div(id="code-header") {
								html.select(id="target-select")
							}
							html.pre(id="code-output") {
								html.code
							}
						}
						html.div(class="tab-panel", id="tab-ast") {
							html.div(id="ast-output")
						}
					}
				}
			}
			html.div(id="playground-sources")
			html.script(src="/assets/playground/wasm_exec.js")
			html.script(src="https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js")
			html.script(src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-go.min.js")
			html.script(src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-javascript.min.js")
			html.script(src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-markup.min.js")
			html.script(type="module", src="/assets/playground/playground.js")
		}
	}
}
