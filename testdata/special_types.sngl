import . "sngl:ui"
import . "sngl:time"
import app "sngl:app"

component main node {
    var (
        bg = #ff0000
        timeout duration = 5s
        birthday date = "2026-03-12"
        noon time = "12:00"
        event_time datetime = "2026-03-12T10:00:00Z"
    )

    text(value=bg)
}

app.window {
    main
}
