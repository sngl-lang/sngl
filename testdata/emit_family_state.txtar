A generated family whose content reads state is compiled into the program.

The family's Go override says how the host's content is written out:
`render` is the pure function from the members to the text, `@start` runs once
the program is up, and `@change` runs with the text each time it differs.
Each member's override says what it contributes, `gen.node(value=…)`, and the
family's value type is whatever `render` takes a list of.

The build does not write that code. It rewrites the host into SNGL the target
already compiles: one synthesized function returning the members' values --
the host's `if`s and `for`s kept as they were written, each member's value
with its props bound, each call-site handler a lambda the value carries -- and
in place of the host, the family's `gen.emit` handed that function. `gen.emit`
is an ordinary bodied component of `sngl:x/gen`, two effects: one mounted at
start, one keyed on `render(members())`. So the re-render is an effect rekeyed
by a write to what the members read, and a click is a closure posted to the
drawing thread -- nothing either host had to learn.

`labelled` has a body and composes: its `text` is reached with its props bound.

deny out/go/fyne/model.go `(?i)\bbar\b` -- the host itself reaches no backend
deny out/go/gtk4/model.go `(?i)\bbar\b` -- likewise

-- app.sngl --
import async "sngl:async"
import build "sngl:build"
import gen "sngl:x/gen"
import go "sngl:language/go"
import ui "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
}

component block build.family

component text(full string, color string = "", @click(button int)) block

component labelled(label string, n int) block {
    text(full="{label}={n}")
}

component bar(blocks ...component block) root

// What one member contributes: its data, and the handler a click on it runs.
struct Entry {
    full string
    color string
    click func(button int)
}

#[go.native("os", "*os.File")]
struct File {}

#[go.native("os", "os.Stdin")]
const stdin File

#[go.native("bufio", "*bufio.Scanner")]
struct Scanner {}

#[go.native("bufio", "bufio.NewScanner")]
func newScanner(f File) Scanner

#[go.native("bufio", "bufio.Scanner.Scan", method)]
func Scanner.scan() bool

#[go.native("bufio", "bufio.Scanner.Text", method)]
func Scanner.text() string

#[go.native("os", "os.Exit")]
func exit(code int)

#[go.native("fmt", "fmt.Print")]
func print(s string)

// The status line: a pure function of the members, so it is what the build
// keys the re-render on.
func encode(members list<Entry>) string {
    var parts list<string> = []
    for var e = members {
        parts.push(e.color == "" ? e.full : "{e.full}#{e.color}")
    }
    return parts.join("|")
}

// A click arrives as "<index> <button>" on a line of stdin. When stdin closes
// the bar is gone, and so is the program -- posted, so every click read before
// it has run.
func readClicks(members func() list<Entry>) {
    var in = newScanner(stdin)
    for in.scan() {
        var fields = in.text().trim().split(" ")
        async.post(func() {
            var ms = members()
            var i = int.parse(fields[0], 10)
            if i < ms.length {
                ms[i].click(int.parse(fields[1], 10))
            }
        })
    }
    async.post(func() {
        exit(0)
    })
}

component block[go.language] {
    gen.emit(
        render=encode,
        @start(members) {
            print("start\n")
            async.spawn(func() {
                readClicks(members)
            })
        },
        @change(line) {
            print(line + "\n")
        },
    )
}

component text[go.language] {
    gen.node(value=Entry{full=full, color=color, click=click})
}

var n = 0
var names = ["a", "b"]

bar {
    for var i, w = names {
        text(full=w, color=i == n ? "fff" : "", @click(button) {
            n = i + button
        })
    }
    if n > 0 {
        labelled(label="n", n=n)
    }
}

ui.window {
    ui.text(value="{n}")
}
