// A window is a scope like an `if`, and what it confers is the same count: a
// read of one window's node from another is `option<T>`, because the surface
// may not be open -- and on a target whose windows are separate documents it
// never is, two pages having no shared address space.
//
// This was `undefined: btn1` before, refused by the tree-family id barrier
// because a window hosts a family other than its own. It is the one of the
// three scopes that was never silent, and the only reason for that is that the
// barrier had been put there by hand. The count is the general rule the
// barrier was a special case of; what is left of the barrier is the canvas,
// where there is no handle to be optional about at all
// (error_tree_family_id_barrier.sngl).
//
// A window written at the root of a file is registered in pass1 rather than
// left in the package body, so declareNodeIDsStmt never walks one and
// hoistWindowInteriorIDs is what counts these.

import ui "sngl:ui"

ui.window #win1(title="one") {
    ui.button #btn1(text="a")
}

ui.window #win2(title="two", href="/two") {
    ui.button(text="b", @click {
        btn1.text = "x" // ERROR(check) "btn1 is rendered inside another window, so out here it is option<button> rather than one node; a window may not be open, and on a target whose windows are separate documents it never is from out here"
    })
}
