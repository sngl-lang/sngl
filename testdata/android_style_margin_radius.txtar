Every Style field android can express reaches the widget, written as a
literal or held in a value. `margin` and `borderRadius` were dropped from both
paths with no diagnostic, and a held Style lost `flex` too. `weight` exists only
in a Row's or a Column's content, so a spliced child's weight call lands inside
that lambda, and a component built at run time is handed a closure written
there, which makes its root a real share of the Row rather than of the screen.

-- app.sngl --
import ui "sngl:ui"

output {
    kotlin {
        android
    }
}

var held ui.Style = {margin=8px, borderRadius=4px, padding=2px, flex=1}

component labelled(look ui.Style) {
    ui.text(value="prop", style=look)
}

// Stateful under a `for`, so a composable of its own: its root's flex is a
// share of the Row it is called in.
component tally(label string) ui.node {
    var n = 0
    ui.button(text="{label} {n}", style={flex=1}, @click {
        n = n + 1
    })
}

ui.window(title="Style") {
    ui.vbox(style={margin=12px, borderRadius=6px}) {
        ui.text(value="literal", style={margin=4px, borderRadius=2px, flex=1})
        ui.button(text="held", style=held)
        labelled(look={margin=3px, borderRadius=5px})
        ui.hbox {
            ui.text(value="row", style={flex=2})
            for var l = ["a", "b"] {
                tally(label=l)
            }
        }
    }
}
