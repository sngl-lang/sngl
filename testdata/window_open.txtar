A window's `#id` opens and closes it, from anywhere a handler can reach it.

`open` and `close` are methods of `ui.window` that assign its `visible`, and
the window binds nothing to it here, so they write the cell the window keeps
for it. A program started with no window on screen -- `@run` never called
`run` -- is the case that wants it: a status bar opening a window when one of
its blocks is clicked. Started that way the host reports each window hidden,
which writes `visible = false`, so `open` is a change the Toplevel's setter
puts on screen.

deny * `gtk4rt\.Window\{|snglWindow|\.Mount\(\)|\.Unmount\(\)` -- a window is a Toplevel node, not a record kept beside the tree
deny * `details\.open\(\)|details\.close\(\)` -- a method called through the handle is the spliced instance's

-- app.sngl --
import go "sngl:language/go"
import time "sngl:time"
import ui "sngl:ui"

#[go.native("os", "os.Exit")]
func exit(code int)

output {
    go {
        gtk4(@run(args, run) {
            wanted = args.contains("--open")
        })
        fyne(@run(args, run) {
            wanted = args.contains("--open")
        })
    }
}

var (
    wanted = false
    ticks = 0
)

// The first tick opens the window when asked to, and the second ends the
// program -- so whether a window reached the screen is the whole difference
// between the two runs.
time.timer(interval=200ms, @tick {
    ticks += 1
    if ticks == 1 && wanted {
        details.open()
    }
    if ticks == 2 {
        exit(0)
    }
})

ui.window #details(title="Details") {
    ui.text(value="{ticks}")
    ui.button(text="Close", @click {
        details.close()
    })
}
