A window's `#id` opens and closes it, from anywhere a handler can reach it.

`window.open()` and `window.close()` are intrinsics each platform answers: on
gtk4 and fyne the entry window is always built, the Model keeps it in a field
named by its `#id`, and the two present and hide it. A program started with no
window on screen -- `@run` never called `run` -- is the case that wants it: a
status bar opening a window when one of its blocks is clicked. Started that
way, the window manager's close hides the window rather than ending the
program (hide-on-close on gtk4, a close intercept on fyne).

Only the entry window: gtk4 and fyne build one window today.

-- app.sngl --
import go "sngl:language/go"
import time "sngl:time"
import ui "sngl:ui"

#[go.native("os", "os.Exit")]
func exit(code int)

output {
    go {
        gtk4(@run(args, run) {
            wanted = args.contains("--open")
        })
        fyne(@run(args, run) {
            wanted = args.contains("--open")
        })
    }
}

var (
    wanted = false
    ticks = 0
)

// The first tick opens the window when asked to, and the second ends the
// program -- so whether a window reached the screen is the whole difference
// between the two runs.
time.timer(interval=200ms, @tick {
    ticks += 1
    if ticks == 1 && wanted {
        details.open()
    }
    if ticks == 2 {
        exit(0)
    }
})

ui.window #details(title="Details") {
    ui.text(value="{ticks}")
    ui.button(text="Close", @click {
        details.close()
    })
}
