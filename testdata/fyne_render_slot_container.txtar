	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	items   []string
	__slot0 []fyne.CanvasObject

	__n2 *fyne.Container
	__n3 *widget.Button
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.items = []string{"a", "b"}
	m.__slot0 = nil
	return m
}

func (m *Model) __renderSlot0(__parent *fyne.Container) {
	for _, __entry := range m.__slot0 {
		__parent.Remove(__entry)
	}
	m.__slot0 = nil
	for _, it := range m.items {
		__n0 := container.NewHBox()
		__n1 := widget.NewLabel("")
		__n1.SetText(("row " + it))
		__n0.Add(__n1)
		__parent.Add(__n0)
		m.__slot0 = append(m.__slot0, __n0)
	}
}

func (m *Model) __n3_click_handler() {
	m.items = append(m.items, "c")
	m.__renderSlot0(m.__n2)
}

func (m *Model) Items() []string {
	return m.items
}

func (m *Model) SetItems(v []string) {
	m.items = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n2 = container.NewVBox()
	m.__n3 = widget.NewButton("", nil)
	m.__n3.SetText("add")
	m.__n3.OnTapped = m.__n3_click_handler
	m.__n2.Add(m.__n3)
	m.__renderSlot0(m.__n2)
	content := fyne.CanvasObject(m.__n2)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
