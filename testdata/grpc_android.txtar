package test.sngl.app

// The runtime behind sngl:json and sngl:http, written beside MainScreen.kt
// when a program reaches either. The compiler hands each call a Codec it
// wrote from the SNGL type -- how to build and read each struct, the name each
// field and enum member travels under -- and the rules and the words are
// pkg/go/sngljson's: a key the type does not name is ignored, a missing key
// fails unless its field is an option, a value of the wrong kind fails naming
// where it was, writing leaves an absent option's key out, and a map's keys are
// visited in order so a failure names the same one everywhere.
//
// A codec is typed by the value it reads and writes, SnglCodec<T>, and built
// from the factories below, so the code the compiler writes holds no cast: a
// struct is built from SnglCodecArgs.at, whose type each constructor
// parameter gives. The JSON in between is untyped, and the one cast back to T
// is here, in at and Decoded.value, where the codec is what makes it sound.

import java.net.HttpURLConnection
import java.net.SocketTimeoutException
import java.net.URL
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.channels.Channel
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext
import org.json.JSONArray
import org.json.JSONObject
import org.json.JSONTokener

class SnglCodec<T>(val kind: Int) {
    var elem: SnglCodec<*>? = null
    var fields: List<SnglCodecField> = emptyList()
    var make: ((SnglCodecArgs) -> T)? = null
    var read: ((T) -> List<Any?>)? = null
    var wires: List<String> = emptyList()
    var values: List<Any> = emptyList()

    // An integer's range, and how it is made from a Long: every width and
    // sign of SNGL integer is one kind. Each is written by its toString,
    // which is its decimal value -- a ULong past Long.MAX_VALUE included.
    var lo: Long = Long.MIN_VALUE
    var hi: Long = Long.MAX_VALUE
    var fromLong: (Long) -> Any = { it }
    var fromDouble: (Double) -> Any = { it }

    class Decoded<T>(private val v: Any?, val error: String?) {
        @Suppress("UNCHECKED_CAST")
        val value: T get() = v as T
    }

    class Response(
        val status: Int,
        val headers: Map<String, String>,
        val body: String,
        val failed: Boolean,
        val timeout: Boolean,
        val message: String,
        val cancelled: Boolean = false,
    )

    private class Fail(message: String) : Exception(message)

    companion object {
        const val BOOL = 0
        const val INT = 1
        const val FLOAT = 3
        const val STRING = 4
        const val DATE = 5
        const val DATETIME = 6
        const val OPTION = 7
        const val LIST = 8
        const val MAP = 9
        const val ENUM = 10
        const val STRUCT = 11

        private val dateRE = Regex("""^\d{4}-\d{2}-\d{2}$""")
        private val datetimeRE = Regex("""^\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(\.\d+)?([Zz]|[+-]\d{2}:\d{2})$""")

        fun bool(): SnglCodec<Boolean> = SnglCodec(BOOL)
        fun string(): SnglCodec<String> = SnglCodec(STRING)
        fun date(): SnglCodec<String> = SnglCodec(DATE)
        fun datetime(): SnglCodec<String> = SnglCodec(DATETIME)
        fun float(): SnglCodec<Double> = SnglCodec(FLOAT)
        fun float32(): SnglCodec<Float> = SnglCodec<Float>(FLOAT).also { it.fromDouble = { d -> d.toFloat() } }

        private fun <T : Any> integer(lo: Long, hi: Long, from: (Long) -> T): SnglCodec<T> =
            SnglCodec<T>(INT).also {
                it.lo = lo
                it.hi = hi
                it.fromLong = from
            }

        fun int(): SnglCodec<Int> = integer(Int.MIN_VALUE.toLong(), Int.MAX_VALUE.toLong()) { it.toInt() }
        fun long(): SnglCodec<Long> = integer(Long.MIN_VALUE, Long.MAX_VALUE) { it }
        fun short(): SnglCodec<Short> = integer(Short.MIN_VALUE.toLong(), Short.MAX_VALUE.toLong()) { it.toShort() }
        fun byte(): SnglCodec<Byte> = integer(Byte.MIN_VALUE.toLong(), Byte.MAX_VALUE.toLong()) { it.toByte() }
        fun ubyte(): SnglCodec<UByte> = integer(0, 0xff) { it.toUByte() }
        fun ushort(): SnglCodec<UShort> = integer(0, 0xffff) { it.toUShort() }
        fun uint(): SnglCodec<UInt> = integer(0, 0xffffffffL) { it.toUInt() }
        // Read through a Long, so a ULong past Long.MAX_VALUE is refused on
        // the way in; it is still written exactly.
        fun ulong(): SnglCodec<ULong> = integer(0, Long.MAX_VALUE) { it.toULong() }

        fun <E> option(e: SnglCodec<E>): SnglCodec<E?> = SnglCodec<E?>(OPTION).also { it.elem = e }
        fun <E> list(e: SnglCodec<E>): SnglCodec<List<E>> = SnglCodec<List<E>>(LIST).also { it.elem = e }
        fun <E> map(e: SnglCodec<E>): SnglCodec<Map<String, E>> = SnglCodec<Map<String, E>>(MAP).also { it.elem = e }

        private val scope = kotlinx.coroutines.MainScope()

        // How many bodies start began are still running: a test waits for none
        // before it reads what they wrote.
        val active = java.util.concurrent.atomic.AtomicInteger()

        // Starts a body that waits -- a handler, an effect's mount -- on the
        // thread the target draws on, which a wait leaves and comes back to.
        fun start(block: suspend () -> Unit) {
            active.incrementAndGet()
            scope.launch {
                try {
                    block()
                } finally {
                    active.decrementAndGet()
                }
            }
        }

        fun <T> decode(text: String, c: SnglCodec<T>): Decoded<T> {
            val v: Any? = try {
                val t = JSONTokener(text)
                val parsed = t.nextValue()
                if (t.nextClean() != '\u0000') throw Fail("not JSON")
                parsed
            } catch (e: Exception) {
                return Decoded(null, "not JSON")
            }
            return try {
                Decoded(dec(if (v == JSONObject.NULL) null else v, c, "$"), null)
            } catch (e: Fail) {
                Decoded(null, e.message)
            }
        }

        private fun describe(c: SnglCodec<*>): String = when (c.kind) {
            BOOL -> "a boolean"
            INT -> "an integer"
            FLOAT -> "a number"
            STRING -> "a string"
            DATE -> "a date"
            DATETIME -> "a datetime"
            OPTION -> describe(c.elem!!)
            LIST -> "an array"
            ENUM -> "one of " + c.wires.joinToString(", ")
            else -> "an object"
        }

        private fun integral(v: Any?): Long? {
            if (v !is Number) return null
            val d = v.toDouble()
            if (v is Double || v is Float) {
                if (d.isNaN() || d.isInfinite() || d != Math.floor(d) || Math.abs(d) > 9.223372036854776E18) return null
                return d.toLong()
            }
            return v.toLong()
        }

        private fun dec(v: Any?, c: SnglCodec<*>, path: String): Any? {
            fun want(): Fail = Fail(path + ": want " + describe(c))
            when (c.kind) {
                OPTION -> return if (v == null) null else dec(v, c.elem!!, path)
                BOOL -> return v as? Boolean ?: throw want()
                INT -> {
                    val n = integral(v) ?: throw want()
                    if (n < c.lo || n > c.hi) throw want()
                    return c.fromLong(n)
                }
                FLOAT -> return c.fromDouble((v as? Number)?.toDouble() ?: throw want())
                STRING -> return v as? String ?: throw want()
                DATE -> {
                    val s = v as? String ?: throw want()
                    if (!dateRE.matches(s)) throw want()
                    try { java.time.LocalDate.parse(s) } catch (e: Exception) { throw want() }
                    return s
                }
                DATETIME -> {
                    val s = v as? String ?: throw want()
                    if (!datetimeRE.matches(s)) throw want()
                    try { java.time.OffsetDateTime.parse(s.uppercase()) } catch (e: Exception) { throw want() }
                    return s
                }
                ENUM -> {
                    val i = if (v is String) c.wires.indexOf(v) else -1
                    if (i < 0) throw want()
                    return c.values[i]
                }
                LIST -> {
                    val a = v as? JSONArray ?: throw want()
                    val out = ArrayList<Any?>(a.length())
                    for (i in 0 until a.length()) out.add(dec(unwrap(a.get(i)), c.elem!!, "$path[$i]"))
                    return out
                }
                MAP -> {
                    val o = v as? JSONObject ?: throw want()
                    val out = LinkedHashMap<String, Any?>()
                    for (k in o.keys().asSequence().toList().sorted()) out[k] = dec(unwrap(o.get(k)), c.elem!!, "$path.$k")
                    return out
                }
                STRUCT -> {
                    val o = v as? JSONObject ?: throw want()
                    val args = ArrayList<Any?>(c.fields.size)
                    for (f in c.fields) {
                        val present = o.has(f.wire)
                        if (!present && f.codec.kind != OPTION) throw Fail("$path.${f.wire}: missing")
                        args.add(dec(if (present) unwrap(o.get(f.wire)) else null, f.codec, "$path.${f.wire}"))
                    }
                    return c.make!!(SnglCodecArgs(args))
                }
            }
            throw want()
        }

        private fun unwrap(v: Any?): Any? = if (v == JSONObject.NULL) null else v

        fun <T> encode(v: T, c: SnglCodec<T>): String = StringBuilder().also { enc(it, v, c) }.toString()

        // The fields of v, a value c reads.
        @Suppress("UNCHECKED_CAST")
        private fun readFields(c: SnglCodec<*>, v: Any?): List<Any?> = (c as SnglCodec<Any?>).read!!(v)

        private fun enc(b: StringBuilder, v: Any?, c: SnglCodec<*>) {
            when (c.kind) {
                OPTION -> if (v == null) b.append("null") else enc(b, v, c.elem!!)
                BOOL -> b.append(if (v == true) "true" else "false")
                INT -> b.append(v.toString())
                FLOAT -> b.append(number((v as Number).toDouble()))
                STRING, DATE, DATETIME -> quote(b, v as String)
                ENUM -> quote(b, enumWire(c, v))
                LIST -> {
                    b.append('[')
                    (v as List<*>).forEachIndexed { i, x ->
                        if (i > 0) b.append(',')
                        enc(b, x, c.elem!!)
                    }
                    b.append(']')
                }
                MAP -> {
                    val m = v as Map<*, *>
                    b.append('{')
                    m.keys.map { it as String }.sorted().forEachIndexed { i, k ->
                        if (i > 0) b.append(',')
                        quote(b, k)
                        b.append(':')
                        enc(b, m[k], c.elem!!)
                    }
                    b.append('}')
                }
                STRUCT -> {
                    val vals = readFields(c, v)
                    b.append('{')
                    var first = true
                    c.fields.forEachIndexed { i, f ->
                        val x = vals[i]
                        if (f.codec.kind == OPTION && x == null) return@forEachIndexed
                        if (!first) b.append(',')
                        first = false
                        quote(b, f.wire)
                        b.append(':')
                        enc(b, x, f.codec)
                    }
                    b.append('}')
                }
            }
        }

        private fun enumWire(c: SnglCodec<*>, v: Any?): String {
            val i = c.values.indexOf(v)
            return if (i < 0) v.toString() else c.wires[i]
        }

        // A float as JSON and JavaScript write one: the shortest decimal that
        // reads back as the same value, with no fraction for a whole number and
        // an exponent from 1e21 up and below 1e-6.
        fun number(d: Double): String {
            if (d.isNaN() || d.isInfinite()) return "null"
            if (d == 0.0) return "0"
            val bd = java.math.BigDecimal(d.toString()).stripTrailingZeros()
            val a = Math.abs(d)
            if (a >= 1e-6 && a < 1e21) return bd.toPlainString()
            val digits = bd.unscaledValue().abs().toString()
            val exp = digits.length - 1 - bd.scale()
            val mant = if (digits.length > 1) digits[0] + "." + digits.substring(1) else digits
            return (if (d < 0) "-" else "") + mant + "e" + (if (exp >= 0) "+" else "-") + Math.abs(exp)
        }

        private fun quote(b: StringBuilder, s: String) {
            b.append('"')
            for (ch in s) {
                when (ch) {
                    '"' -> b.append("\\\"")
                    '\\' -> b.append("\\\\")
                    '\b' -> b.append("\\b")
                    '\u000C' -> b.append("\\f")
                    '\n' -> b.append("\\n")
                    '\r' -> b.append("\\r")
                    '\t' -> b.append("\\t")
                    else -> if (ch < ' ') b.append(String.format("\\u%04x", ch.code)) else b.append(ch)
                }
            }
            b.append('"')
        }

        fun escape(s: String): String {
            val hex = "0123456789ABCDEF"
            val b = StringBuilder()
            for (byte in s.toByteArray(Charsets.UTF_8)) {
                val c = byte.toInt() and 0xff
                val ch = c.toChar()
                if (ch in 'A'..'Z' || ch in 'a'..'z' || ch in '0'..'9' || ch == '-' || ch == '.' || ch == '_' || ch == '~') {
                    b.append(ch)
                } else {
                    b.append('%').append(hex[c shr 4]).append(hex[c and 15])
                }
            }
            return b.toString()
        }

        private fun queryValues(v: Any?, c: SnglCodec<*>): List<String> = when (c.kind) {
            OPTION -> if (v == null) emptyList() else queryValues(v, c.elem!!)
            LIST -> (v as List<*>).flatMap { queryValues(it, c.elem!!) }
            BOOL -> listOf(if (v == true) "true" else "false")
            INT -> listOf(v.toString())
            FLOAT -> listOf(number((v as Number).toDouble()))
            ENUM -> listOf(enumWire(c, v))
            else -> listOf(v.toString())
        }

        fun <T> withQuery(url: String, q: T, c: SnglCodec<T>): String {
            val vals = readFields(c, q)
            val parts = ArrayList<String>()
            c.fields.forEachIndexed { i, f ->
                for (s in queryValues(vals[i], f.codec)) parts.add(escape(f.wire) + "=" + escape(s))
            }
            if (parts.isEmpty()) return url
            return url + (if (url.contains('?')) "&" else "?") + parts.joinToString("&")
        }

        // sngl:async's lifetimes, by number: each live one holds how to stop
        // the requests made under it, and 0 -- forever -- is never held.
        private val lives = java.util.concurrent.ConcurrentHashMap<Int, java.util.concurrent.CopyOnWriteArrayList<() -> Unit>>()
        private val nextLife = java.util.concurrent.atomic.AtomicInteger()

        fun begin(): Int {
            val id = nextLife.incrementAndGet()
            lives[id] = java.util.concurrent.CopyOnWriteArrayList()
            return id
        }

        fun end(id: Int) {
            lives.remove(id)?.forEach { it() }
        }

        fun ended(id: Int): Boolean = id != 0 && !lives.containsKey(id)

        // sngl:async's queues, by number, as lifetimes are: each is held until
        // its reader reads it closed and empty, and a number not held is one
        // that is.
        private val queues = java.util.concurrent.ConcurrentHashMap<Int, Channel<Any?>>()
        private val nextQueue = java.util.concurrent.atomic.AtomicInteger()

        fun queueOpen(): Int {
            val id = nextQueue.incrementAndGet()
            queues[id] = Channel(Channel.UNLIMITED)
            return id
        }

        fun queueSend(id: Int, item: Any?) {
            val q = queues[id]
            if (q == null || q.trySend(item).isClosed) throw IllegalStateException("send to a closed queue")
        }

        fun queueClose(id: Int) {
            queues[id]?.close()
        }

        suspend fun queueReceive(id: Int): Any? {
            val q = queues[id] ?: return null
            val r = q.receiveCatching()
            if (r.isClosed) queues.remove(id)
            return r.getOrNull()
        }

        private fun cancelled(): Response = Response(0, emptyMap(), "", true, false, "cancelled", true)

        // Sends one request on a thread of its own and waits for its answer
        // there: a failure only where no response arrived, or `life` ended
        // first, which disconnects it.
        suspend fun send(method: String, url: String, headers: Map<String, String>, body: String?, life: Int): Response {
            if (ended(life)) return cancelled()
            return withContext(Dispatchers.IO) {
                val conn = try {
                    URL(url).openConnection() as HttpURLConnection
                } catch (e: Exception) {
                    return@withContext Response(0, emptyMap(), "", true, false, e.toString())
                }
                val abort: () -> Unit = { conn.disconnect() }
                lives[life]?.add(abort)
                try {
                    conn.requestMethod = method.uppercase()
                    for (k in headers.keys.sorted()) conn.setRequestProperty(k, headers[k])
                    if (body != null) {
                        conn.doOutput = true
                        conn.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
                    }
                    val status = conn.responseCode
                    val stream = if (status >= 400) conn.errorStream else conn.inputStream
                    val text = stream?.use { it.readBytes().toString(Charsets.UTF_8) } ?: ""
                    val hs = LinkedHashMap<String, String>()
                    for ((k, vs) in conn.headerFields) {
                        if (k != null) hs[k.lowercase()] = vs.joinToString(", ")
                    }
                    conn.disconnect()
                    // A response that arrived is the answer, whenever the
                    // lifetime ended: a failure is only where none did.
                    Response(status, hs, text, false, false, "")
                } catch (e: SocketTimeoutException) {
                    if (ended(life)) cancelled() else Response(0, emptyMap(), "", true, true, e.toString())
                } catch (e: Exception) {
                    if (ended(life)) cancelled() else Response(0, emptyMap(), "", true, false, e.toString())
                } finally {
                    lives[life]?.remove(abort)
                }
            }
        }
    }
}

class SnglCodecField(val wire: String, val codec: SnglCodec<*>)

// The fields of a struct being decoded, in its codec's order. at gives each
// the type of the constructor parameter it is passed to.
class SnglCodecArgs(private val values: List<Any?>) {
    @Suppress("UNCHECKED_CAST")
    fun <F> at(i: Int): F = values[i] as F
}
-- out/kotlin/android/SnglGrpc.kt --
package test.sngl.app

import java.io.IOException
import kotlinx.coroutines.CompletableDeferred
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.async
import kotlinx.coroutines.channels.Channel
import kotlinx.coroutines.coroutineScope
import kotlinx.coroutines.delay
import kotlinx.coroutines.launch
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.OkHttpClient
import okhttp3.Protocol
import okhttp3.Request
import okhttp3.RequestBody
import okio.BufferedSink

// SnglGrpc is the transport behind sngl:grpc's call and stream: a call's
// bytes framed as gRPC and carried over OkHttp's HTTP/2. The messages are
// written and read by SnglProto, from the program's own classes, so nothing
// here knows a message.
object SnglGrpc {
    class Answer(val body: ByteArray, val code: Int, val message: String)

    private val none = ByteArray(0)
    private val grpc = "application/grpc".toMediaType()

    // A server written `host:port` is called in plaintext, which HTTP/2
    // speaks only to a client that assumes it.
    private val plain by lazy { OkHttpClient.Builder().protocols(listOf(Protocol.H2_PRIOR_KNOWLEDGE)).build() }
    private val tls by lazy { OkHttpClient.Builder().protocols(listOf(Protocol.HTTP_2, Protocol.HTTP_1_1)).build() }

    // The request messages are written as they come, while the responses
    // are read: OkHttp hands a duplex body its sink and leaves it open.
    private class Pumped : RequestBody() {
        val sink = CompletableDeferred<BufferedSink>()

        override fun contentType() = grpc

        override fun isDuplex() = true

        override fun writeTo(sink: BufferedSink) {
            this.sink.complete(sink)
        }
    }

    private fun request(server: String, method: String, body: RequestBody): Request {
        val secure = server.startsWith("https://")
        val host = server.removePrefix("https://").removePrefix("http://").trimEnd('/')
        return Request.Builder()
            .url((if (secure) "https://" else "http://") + host + method)
            .header("te", "trailers")
            .post(body)
            .build()
    }

    private fun client(server: String) = if (server.startsWith("https://")) tls else plain

    // A call that fails before answering carries its status in the headers,
    // with no trailers after them.
    private fun status(resp: okhttp3.Response): Answer {
        val status = resp.header("grpc-status") ?: resp.trailers()["grpc-status"]
        val message = resp.header("grpc-message") ?: resp.trailers()["grpc-message"] ?: ""
        val code = status?.toIntOrNull() ?: return Answer(none, 13, "the response has no grpc-status")
        return Answer(none, code, if (code != 0) unescape(message) else "")
    }

    suspend fun call(server: String, method: String, request: ByteArray, life: Int): Answer {
        var got: ByteArray? = null
        var n = 0
        var sent = false
        val a = exchange(server, method, { if (sent) null else request.also { sent = true } }, life) {
            got = it
            n++
            true
        }
        if (a.code != 0) return a
        if (n != 1) return Answer(none, 13, "a unary call answered $n messages")
        return Answer(got!!, 0, "")
    }

    // stream sends each item of sngl:async's queue as write writes it, as it
    // is sent, and hands each response message to each, where the caller
    // runs, as it arrives: until the server ends the call, each answers
    // false (code -1), or life ends. Closing the queue ends the requests.
    suspend fun stream(server: String, method: String, queue: Int, write: (Any?) -> ByteArray, life: Int, each: suspend (ByteArray) -> Boolean): Answer =
        exchange(server, method, { SnglCodec.queueReceive(queue)?.let(write) }, life, each)

    private suspend fun exchange(server: String, method: String, next: suspend () -> ByteArray?, life: Int, each: suspend (ByteArray) -> Boolean): Answer {
        if (SnglCodec.ended(life)) return Answer(none, 1, "cancelled")
        if (server.isEmpty()) return Answer(none, 14, "no server: provide the service's address")
        val body = Pumped()
        val call = client(server).newCall(request(server, method, body))
        val messages = Channel<ByteArray>(16)
        return coroutineScope {
            // SnglCodec keeps its lifetimes' aborts to itself, so the call
            // watches for its lifetime's end.
            val watch = if (life == 0) null else launch {
                while (!SnglCodec.ended(life)) delay(20)
                call.cancel()
            }
            val pump = launch(Dispatchers.IO) {
                val sink = body.sink.await()
                try {
                    while (true) {
                        val m = next() ?: break
                        sink.writeByte(0).writeInt(m.size).write(m).flush()
                    }
                    sink.close()
                } catch (e: IOException) {
                    // The call ended, and the reader answers how.
                }
            }
            val reader = async(Dispatchers.IO) {
                try {
                    call.execute().use { resp ->
                        if (resp.code != 200) return@async Answer(none, fromHttp(resp.code), "HTTP ${resp.code}")
                        val src = resp.body!!.source()
                        while (!src.exhausted()) {
                            val flag = src.readByte()
                            val len = src.readInt()
                            if (flag.toInt() != 0 || len < 0) return@async Answer(none, 13, "a response message the client cannot read")
                            messages.send(src.readByteArray(len.toLong()))
                        }
                        status(resp)
                    }
                } catch (e: java.io.EOFException) {
                    Answer(none, 13, "a response message cut short")
                } catch (e: IOException) {
                    if (SnglCodec.ended(life)) Answer(none, 1, "cancelled") else Answer(none, 14, e.toString())
                } finally {
                    messages.close()
                }
            }
            var stopped: Answer? = null
            for (m in messages) {
                if (!each(m)) stopped = Answer(none, -1, "")
                else if (SnglCodec.ended(life)) stopped = Answer(none, 1, "cancelled")
                if (stopped != null) break
            }
            watch?.cancel()
            val answer = if (stopped != null) {
                call.cancel()
                messages.cancel()
                reader.cancel()
                stopped
            } else {
                reader.await()
            }
            pump.cancel()
            answer
        }
    }

    // gRPC's mapping of an HTTP status that is not one of its own answers.
    private fun fromHttp(status: Int): Int = when (status) {
        400 -> 13
        401 -> 16
        403 -> 7
        404 -> 12
        429, 502, 503, 504 -> 14
        else -> 2
    }

    // grpc-message is percent-encoded UTF-8, where `+` is itself.
    private fun unescape(s: String): String {
        if (!s.contains('%')) return s
        val out = java.io.ByteArrayOutputStream()
        var i = 0
        while (i < s.length) {
            val c = s[i]
            if (c == '%' && i + 2 < s.length) {
                val b = s.substring(i + 1, i + 3).toIntOrNull(16)
                if (b != null) {
                    out.write(b)
                    i += 3
                    continue
                }
            }
            out.write(c.toString().toByteArray(Charsets.UTF_8))
            i++
        }
        return out.toString("UTF-8")
    }
}

class SnglPbFail(message: String) : Exception(message)

class SnglPbDecoded<T>(val value: T?, val error: String?)

// SnglPbWriter is a message's bytes as protobuf's wire format writes them.
class SnglPbWriter {
    private var buf = ByteArray(64)
    private var size = 0

    fun bytes(): ByteArray = buf.copyOf(size)

    private fun room(n: Int) {
        if (size + n > buf.size) buf = buf.copyOf(maxOf(buf.size * 2, size + n))
    }

    fun tag(num: Int, type: Int) = varint((num.toLong() shl 3) or type.toLong())

    fun varint(v: Long) {
        var x = v
        room(10)
        while (x and 0x7fL.inv() != 0L) {
            buf[size++] = ((x and 0x7f) or 0x80).toByte()
            x = x ushr 7
        }
        buf[size++] = x.toByte()
    }

    fun zigzag32(v: Int) = varint(((v shl 1) xor (v shr 31)).toLong() and 0xffffffffL)

    fun zigzag64(v: Long) = varint((v shl 1) xor (v shr 63))

    fun fixed32(v: Int) {
        room(4)
        for (i in 0 until 4) buf[size++] = (v ushr (8 * i)).toByte()
    }

    fun fixed64(v: Long) {
        room(8)
        for (i in 0 until 8) buf[size++] = (v ushr (8 * i)).toByte()
    }

    fun raw(b: ByteArray) {
        varint(b.size.toLong())
        room(b.size)
        b.copyInto(buf, size)
        size += b.size
    }

    fun string(s: String) = raw(s.toByteArray(Charsets.UTF_8))

    fun base64(s: String) = raw(android.util.Base64.decode(s, android.util.Base64.DEFAULT))

    // A length-delimited record of what write writes: a message, a packed
    // field, a map's entry.
    inline fun sub(write: (SnglPbWriter) -> Unit) {
        val w = SnglPbWriter()
        write(w)
        raw(w.bytes())
    }
}

// SnglPbReader reads the records of a message, b from start to end. A
// record that is not protobuf, or not of the wire type its field is, fails
// naming where.
class SnglPbReader(private val b: ByteArray, private var pos: Int = 0, private val end: Int = b.size) {
    companion object {
        fun narrow(x: Long, lo: Long, hi: Long, path: String): Long {
            if (x < lo || x > hi) throw SnglPbFail("$path: $x is out of range")
            return x
        }
    }

    fun more(): Boolean = pos < end

    fun varint(): Long {
        var x = 0L
        var shift = 0
        while (shift < 64) {
            if (pos >= end) throw SnglPbFail("not protobuf")
            val c = b[pos++].toInt()
            x = x or ((c and 0x7f).toLong() shl shift)
            if (c and 0x80 == 0) return x
            shift += 7
        }
        throw SnglPbFail("not protobuf")
    }

    fun tag(path: String): Long = try {
        varint()
    } catch (e: SnglPbFail) {
        throw SnglPbFail("$path: not protobuf")
    }

    // want checks the record tag reads is of wire type type, as kind is
    // written.
    fun want(tag: Long, type: Int, path: String, kind: String) {
        if ((tag and 7L).toInt() != type) throw SnglPbFail("$path: want $kind")
    }

    fun fixed32(): Int {
        if (end - pos < 4) throw SnglPbFail("not protobuf")
        var x = 0
        for (i in 0 until 4) x = x or ((b[pos++].toInt() and 0xff) shl (8 * i))
        return x
    }

    fun fixed64(): Long {
        if (end - pos < 8) throw SnglPbFail("not protobuf")
        var x = 0L
        for (i in 0 until 8) x = x or ((b[pos++].toLong() and 0xff) shl (8 * i))
        return x
    }

    fun zigzag32(): Int {
        val x = varint().toInt()
        return (x ushr 1) xor -(x and 1)
    }

    fun zigzag64(): Long {
        val x = varint()
        return (x ushr 1) xor -(x and 1)
    }

    private fun length(): Int {
        val n = varint()
        if (n < 0 || n > end - pos) throw SnglPbFail("not protobuf")
        return n.toInt()
    }

    fun bytes(): ByteArray {
        val n = length()
        val out = b.copyOfRange(pos, pos + n)
        pos += n
        return out
    }

    fun string(): String {
        val n = length()
        val out = String(b, pos, n, Charsets.UTF_8)
        pos += n
        return out
    }

    fun base64(): String = android.util.Base64.encodeToString(bytes(), android.util.Base64.NO_WRAP)

    fun sub(): SnglPbReader {
        val n = length()
        val r = SnglPbReader(b, pos, pos + n)
        pos += n
        return r
    }

    fun skip(tag: Long, path: String) {
        try {
            when ((tag and 7L).toInt()) {
                0 -> varint()
                1 -> fixed64()
                2 -> pos += length()
                5 -> fixed32()
                else -> throw SnglPbFail("not protobuf")
            }
        } catch (e: SnglPbFail) {
            throw SnglPbFail("$path: not protobuf")
        }
    }
}
-- out/kotlin/android/SnglProto.kt --
package test.sngl.app

@Suppress("UNUSED_PARAMETER", "NAME_SHADOWING", "UNUSED_VARIABLE", "RedundantExplicitType")
object SnglProto {
    fun write(write: (SnglPbWriter) -> Unit): ByteArray = SnglPbWriter().also(write).bytes()

    fun <T> decode(read: () -> T): SnglPbDecoded<T> = try {
        SnglPbDecoded(read(), null)
    } catch (e: SnglPbFail) {
        SnglPbDecoded(null, e.message)
    }

    fun writeGet(w: SnglPbWriter, m: Get) {
        if (m.id != 0) { w.tag(1, 0); w.varint(m.id.toLong().toInt().toLong()) }
    }

    fun readGet(r: SnglPbReader, path: String): Get {
        var f0: Int = 0
        while (r.more()) {
            val t = r.tag(path)
            when ((t ushr 3).toInt()) {
                1 -> { r.want(t, 0, path + ".id", "int32"); f0 = (try { r.varint() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".id" + ": want int32") }.toInt().toLong()).toInt() }
                else -> r.skip(t, path)
            }
        }
        return Get(id = f0)
    }

    fun writeBook(w: SnglPbWriter, m: Book) {
        if (m.id != 0) { w.tag(1, 0); w.varint(m.id.toLong().toInt().toLong()) }
        if (m.kind != Kind.UNKNOWN) { w.tag(2, 0); w.varint(numKind(m.kind)) }
        if (m.ranks.isNotEmpty()) {
            w.tag(3, 2)
            w.sub { p -> for (v in m.ranks) p.zigzag64(v.toLong()) }
        }
        for (v in m.tags) { w.tag(4, 2); w.sub { s -> writeTag(s, v) } }
        for (k in m.scores.keys.sorted()) {
            w.tag(5, 2)
            w.sub { e -> e.tag(1, 2); e.string(k); e.tag(2, 1); e.fixed64(m.scores.getValue(k).toDouble().toRawBits()) }
        }
        m.next?.let { x -> w.tag(6, 2); w.sub { s -> writeTag(s, x) } }
        if (m.cover != "") { w.tag(7, 2); w.base64(m.cover) }
        if (m.isbn != 0uL) { w.tag(10, 1); w.fixed64(m.isbn.toLong()) }
        if (m.count != 0) { w.tag(11, 0); w.varint(m.count.toLong()) }
        when (val o = m.where) {
            is Where.Shelf -> { w.tag(8, 2); w.string(o.value) }
            is Where.Tag -> { w.tag(9, 2); w.sub { s -> writeTag(s, o.value) } }
            else -> {}
        }
    }

    fun readBook(r: SnglPbReader, path: String): Book {
        var f0: Int = 0
        var f1: Kind = Kind.UNKNOWN
        var f2: ArrayList<Long> = ArrayList()
        var f3: ArrayList<Tag> = ArrayList()
        var f4: LinkedHashMap<String, Double> = LinkedHashMap()
        var f5: Tag? = null
        var f6: String = ""
        var f7: ULong = 0uL
        var f8: Int = 0
        var f9: Where = Where.None
        while (r.more()) {
            val t = r.tag(path)
            when ((t ushr 3).toInt()) {
                1 -> { r.want(t, 0, path + ".id", "int32"); f0 = (try { r.varint() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".id" + ": want int32") }.toInt().toLong()).toInt() }
                2 -> { r.want(t, 0, path + ".kind", "enum"); f1 = memberKind(try { r.varint() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".kind" + ": want enum") }, path + ".kind") }
                3 -> if ((t and 7L).toInt() == 2) { val p = r.sub(); while (p.more()) f2.add((try { p.zigzag64() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".ranks" + ": want sint64") })) } else { r.want(t, 0, path + ".ranks", "sint64"); f2.add((try { r.zigzag64() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".ranks" + ": want sint64") })) }
                4 -> { r.want(t, 2, path + ".tags", "message"); f3.add(readTag(try { r.sub() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".tags" + ": want message") }, path + ".tags")) }
                5 -> {
                    r.want(t, 2, path + ".scores", "map")
                    val e = r.sub()
                    var k = ""
                    var v: Double = 0.0
                    while (e.more()) {
                        val et = e.tag(path)
                        when ((et ushr 3).toInt()) {
                            1 -> { e.want(et, 2, path + ".scores", "string"); k = e.string() }
                            2 -> { e.want(et, 1, path + ".scores", "double"); v = Double.fromBits(try { e.fixed64() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".scores" + ": want double") }) }
                            else -> e.skip(et, path + ".scores")
                        }
                    }
                    f4[k] = v
                }
                6 -> { r.want(t, 2, path + ".next", "message"); f5 = readTag(try { r.sub() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".next" + ": want message") }, path + ".next") }
                7 -> { r.want(t, 2, path + ".cover", "bytes"); f6 = try { r.base64() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".cover" + ": want bytes") } }
                10 -> { r.want(t, 1, path + ".isbn", "fixed64"); f7 = (try { r.fixed64() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".isbn" + ": want fixed64") }).toULong() }
                11 -> { r.want(t, 0, path + ".count", "int64"); f8 = SnglPbReader.narrow((try { r.varint() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".count" + ": want int64") }), Int.MIN_VALUE.toLong(), Int.MAX_VALUE.toLong(), path + ".count").toInt() }
                8 -> { r.want(t, 2, path + ".where.shelf", "string"); f9 = Where.Shelf(try { r.string() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".where.shelf" + ": want string") }) }
                9 -> { r.want(t, 2, path + ".where.tag", "message"); f9 = Where.Tag(readTag(try { r.sub() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".where.tag" + ": want message") }, path + ".where.tag")) }
                else -> r.skip(t, path)
            }
        }
        return Book(id = f0, kind = f1, ranks = f2, tags = f3, scores = f4, next = f5, cover = f6, isbn = f7, count = f8, where = f9)
    }

    fun numKind(v: Kind): Long = when (v) {
        Kind.UNKNOWN -> 0L
        Kind.PAPERBACK -> 3L
    }

    fun memberKind(x: Long, path: String): Kind = when (x.toInt()) {
        0 -> Kind.UNKNOWN
        3 -> Kind.PAPERBACK
        else -> throw SnglPbFail(path + ": no member numbered " + x.toInt())
    }

    fun writeTag(w: SnglPbWriter, m: Tag) {
        if (m.name != "") { w.tag(1, 2); w.string(m.name) }
    }

    fun readTag(r: SnglPbReader, path: String): Tag {
        var f0: String = ""
        while (r.more()) {
            val t = r.tag(path)
            when ((t ushr 3).toInt()) {
                1 -> { r.want(t, 2, path + ".name", "string"); f0 = try { r.string() } catch (e: SnglPbFail) { throw SnglPbFail(path + ".name" + ": want string") } }
                else -> r.skip(t, path)
            }
        }
        return Tag(name = f0)
    }
}
