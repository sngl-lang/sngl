A grpc.call on android is written as Go's is, over the program's own Kotlin
classes: SnglProto holds a writer and a reader per message and a number and
a member lookup per enum, and SnglGrpc frames the call over OkHttp's HTTP/2.
A oneof's member named as the message it carries, `tag Tag`, holds the
message through an alias, since inside the sealed class `Tag` is the member.
A uint64 field's default is an unsigned literal.

deny out/kotlin/android/SnglProto.kt `com\.google\.protobuf|io\.grpc|reflect` -- the messages are the program's own classes, written field by field

-- app.sngl --
import async "sngl:async"
import grpc "sngl:grpc"
import ui "sngl:ui"

output {
    kotlin {
        android
    }
}

enum Kind {
    #[grpc.value(0)]
    unknown
    #[grpc.value(3)]
    paperback
}

#[grpc.message("shop.Tag")]
struct Tag {
    #[grpc.field(1)]
    name string = ""
}

enum Where {
    none
    #[grpc.field(8)]
    shelf string
    #[grpc.field(9)]
    tag   Tag
}

#[grpc.message("shop.Book")]
struct Book {
    #[grpc.field(1)]
    id     int32 = 0
    #[grpc.field(2)]
    kind   Kind = Kind.unknown
    #[grpc.field(3, sint64)]
    ranks  list[int64] = []
    #[grpc.field(4)]
    tags   list[Tag] = []
    #[grpc.field(5)]
    scores map[string, float] = {}
    #[grpc.field(6)]
    next   option[Tag] = null
    #[grpc.field(7, bytes)]
    cover  string = ""
    #[grpc.field(10, fixed64)]
    isbn   uint64 = 0
    #[grpc.field(11, int64)]
    count  int = 0
    where  Where = Where.none
}

#[grpc.message("shop.Get")]
struct Get {
    #[grpc.field(1)]
    id int32 = 0
}

func fetch(id int32, life async.Lifetime) async.Result[Book] {
    return grpc.call[Get, Book](server="localhost:50051", method="/shop.Shop/GetBook", request={id=id}, life=life)
}

component main ui.node {
    var title = "-"
    ui.button(text="Fetch", @click {
        match var b = fetch(1, async.forever) {
            ok { title = "{b.id}" }
            failed { title = b.code }
        }
    })
    ui.text(value=title)
}

ui.window {
    main
}
