A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_var_shadows_node_name.sngl --
// A node position accepts nothing but a component, so a var of the same name
// does not stand in the way of one: `progress(value=progress)` names the
// component and reads the var. Only the docs suite caught this when a bare
// component reference moved from the package root onto the scope chain.

import . "sngl:ui"

component main node {
    var progress float = 0.25

    vbox {
        progress(value=progress, max=1.0)
        text(value="{progress}")
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
