import . "sngl:ui"
import . "sngl:app"
import tr "sngl:tree"

// Component declares optional child (option<T>).
// Two children: error.
component OptionalOne(content ...component option<ui>) ui {
    vbox {
        content
    }
}

component main ui {
    OptionalOne { // ERROR(check) "accepts at most one child"
        text(value="a")
        text(value="b")
    }
}

window {
    main
}
