import . "sngl:ui"
import . "sngl:app"
import tr "sngl:tree"

// Component declares optional child (option<T>).
// Two children: error.
component OptionalOne(slot _ option<tr.default>) {
    vbox {
        slot
    }
}

component main {
    OptionalOne { // ERROR(check) "accepts at most one child"
        text(value="a")
        text(value="b")
    }
}
