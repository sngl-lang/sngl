A path's steps are its children, each step component composing one record of
the path's step family. A `for` over state and an `if` over state among them
make the list a value every target rebuilds when either changes, and each
target's path override reads the records where it read a list of commands.

-- draw_path_steps.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"

component art ui.node {
    var closed = false
    var corners = [draw.Point{x=30.0, y=36.0}, draw.Point{x=56.0, y=36.0}]
    draw.canvas(width=60px, height=40px) {
        draw.path(style={stroke=#993366, strokeWidth=2.0}) {
            draw.moveTo(x=4.0, y=12.0)
            for var c = corners {
                draw.lineTo(x=c.x, y=c.y)
            }
            draw.bezierTo(cx1=34.0, cy1=12.0, cx2=44.0, cy2=12.0, x=56.0, y=36.0)
            draw.arcTo(cx=56.0, cy=12.0, x=40.0, y=12.0, r=4.0)
            if closed {
                draw.close()
            }
        }
    }
    ui.button(text="close", @click {
        closed = true
    })
}

ui.window {
    art()
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
