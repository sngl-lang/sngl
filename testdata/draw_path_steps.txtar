}

// A picture that will not decode draws nothing rather than failing the frame,
// which is what every other target does with an unreadable source.
fun DrawScope.snglDrawImage(src: String, x: Float, y: Float, w: Float, h: Float) {
    val bmp = SnglAssets.bitmap(src) ?: return
    drawImage(
        image = bmp,
        dstOffset = IntOffset(x.toInt(), y.toInt()),
        dstSize = IntSize(w.toInt(), h.toInt()),
    )
}

// A drawing painted in place of a picture: its own space mapped onto the box
// and clipped to it, until snglDrawLeave.
fun DrawScope.snglDrawEnter(x: Float, y: Float, sx: Float, sy: Float, w: Float, h: Float) {
    drawContext.canvas.save()
    drawContext.canvas.translate(x, y)
    drawContext.canvas.scale(sx, sy)
    drawContext.canvas.clipRect(0f, 0f, w, h)
}

fun DrawScope.snglDrawLeave() {
    drawContext.canvas.restore()
}

fun _snglFloatStr(v: Double): String =
    if (v.isFinite() && v == kotlin.math.floor(v) && kotlin.math.abs(v) < 9.007199254740992E15) v.toLong().toString() else v.toString()

fun _snglSplit(s: String, sep: String): List<String> =
    if (sep.isEmpty()) s.map { it.toString() } else s.split(sep)

enum class SnglPathOp(private val sngl: String) {
    MOVETO("moveTo"),
    LINETO("lineTo"),
    BEZIERTO("bezierTo"),
    ARCTO("arcTo"),
    CLOSE("close");

    override fun toString(): String = sngl
}

enum class SnglLineCap(private val sngl: String) {
    BUTT("butt"),
    ROUND("round"),
    SQUARE("square");

    override fun toString(): String = sngl
}

enum class SnglLineJoin(private val sngl: String) {
    MITER("miter"),
    ROUND("round"),
    BEVEL("bevel");

    override fun toString(): String = sngl
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainScreen() {
    var closed__inst0 by remember { mutableStateOf(false) }
