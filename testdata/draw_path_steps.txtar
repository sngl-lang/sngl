fun tangentArc(from: Point, corner: Point, to: Point, r: Double): Arc {
    var a1 = Math.atan2((from.y - corner.y), (from.x - corner.x))
    var a2 = Math.atan2((to.y - corner.y), (to.x - corner.x))
    var turn = (a2 - a1)
    if ((turn > 3.141592653589793)) {
    	turn = (turn - 6.283185307179586)
    }
    if ((turn < -3.141592653589793)) {
    	turn = (turn + 6.283185307179586)
    }
    var half = (kotlin.math.abs(turn) / 2.0)
    if ((((r <= 0.0) || (half < 0.0001)) || (half > 1.5706))) {
    	return Arc(degenerate = true, tangent1 = corner, tangent2 = corner, center = corner)
    }
    var reach = (r / Math.tan(half))
    var t1 = Point(x = (corner.x + (reach * Math.cos(a1))), y = (corner.y + (reach * Math.sin(a1))))
    var t2 = Point(x = (corner.x + (reach * Math.cos(a2))), y = (corner.y + (reach * Math.sin(a2))))
    var c = corner.polar((r / Math.sin(half)), (a1 + (turn / 2.0)))
    var sweep = (3.141592653589793 - kotlin.math.abs(turn))
    if ((turn > 0.0)) {
    	sweep = -sweep
    }
    return Arc(tangent1 = t1, tangent2 = t2, center = c, start = Math.atan2((t1.y - c.y), (t1.x - c.x)), sweep = sweep)
}

fun Point.polar(radius: Double, angle: Double): Point = Point(x = (this.x + (radius * Math.cos(angle))), y = (this.y + (radius * Math.sin(angle))))

