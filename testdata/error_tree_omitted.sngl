// An omitted return position is a declaration that has not said which family
// it joins, and the compiler reports it as one. Inference from the body comes
// later: it is bottom-up from what a body contains while membership is
// checked *against* the tree, and components can be mutually recursive, so it
// needs a fixpoint rather than one ordered pass.
//
// Belonging to no family is still sayable — with the mark, not with silence.

import app "sngl:app"
import ui "sngl:ui"

component card(label string) { // ERROR(check) "component card: name the tree it belongs to in the return position, or mark it #[tree.none]"
    ui.text(value=label)
}

app.window {
}
