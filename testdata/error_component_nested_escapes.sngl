// A body-local component is invisible outside the body that declares it, so
// the sibling naming it has an undefined name where it wrote it -- not a
// silently dropped declaration, which is what #184 was.

import . "sngl:ui"

component outer() node {
    component inner(label = "") node {
        text(value=label)
    }

    inner(label="hi")
}

component other() node {
    inner(label="nope") // ERROR(check) "undefined: inner"
}

component main node {
    vbox {
        outer()
        other()
    }
}

window {
    main
}
