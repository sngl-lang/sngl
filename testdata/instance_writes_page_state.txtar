A component built at run time reads and writes the page's state, not a field
of its own record.

`row` declares `label` and so is an instance per element on every target that
keeps an instance's state; `total` is the page's. A record there held every
state var the body named as one of its own fields, and the page's `total`
became `c.total`, which no record declares -- in a click handler and in an
effect alike. An instance reaches the page through the Model it holds.

On android the page's state is `remember`ed in MainScreen, and a composable of
its own cannot name a local of MainScreen's, so what `row` reads is declared at
file level -- and so is `start`, which only the page reads, because `total` is
initialized from it there.

deny out/go/fyne/model.go `c\.total\b` -- the page's state is the Model's, reached as c.__model.total
deny out/go/gtk4/model.go `c\.total\b` -- the page's state is the Model's, reached as c.__model.total

-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

var start = 0
var total = start
var labels list<string> = ["a", "b"]

component row(name = "") node {
    var label = name + ":"
    effect(on=name, @mount { total = total + 1 }, @unmount { total = total - 1 })
    button(text="{label} {total}", @click { total = total + 10 })
}

window {
    vbox {
        for var l = labels {
            row(name=l)
        }
        text(value=string(total))
        text(value="from {start}")
    }
}
