A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_menu.sngl --
import . "sngl:ui"
import . "sngl:test"

// menu: state-binding fixture — toggling the bound `open` var
// shows/hides the menu.
component main node {
    var open = false
    var last = ""
    menu(open=open) {
        menuItem(label="Cut", @select {
            last = "cut"
        })
        menuItem(label="Copy", @select {
            last = "copy"
        })
        menuItem(label="Paste", disabled=true)
    }
}

func testMenuOpenToggles(t Test, c main) {
    t.assert(c.open == false)
    c.open = true
    t.assert(c.open == true)
    c.open = false
    t.assert(c.open == false)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
