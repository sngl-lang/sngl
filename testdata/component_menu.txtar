package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	open bool
	last string

	__n0 *fyne.Container
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.open = false
	m.last = ""
	return m
}

func (m *Model) Open() bool {
	return m.open
}

func (m *Model) SetOpen(v bool) {
	m.open = v
}

func (m *Model) Last() string {
	return m.last
}

func (m *Model) SetLast(v string) {
	m.last = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = container.NewVBox()
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
