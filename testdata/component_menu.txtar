// Code generated by sngl (bubbletea) from component_menu.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbles/v2/list"
	"charm.land/bubbletea/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/tui"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	open      bool
	__focusID int

	widget0 list.Model

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.open = false
	m.__focusID = 0
	m.widget0 = tui.NewList(tui.StringItems([]string{"Cut", "Copy", "Paste"}), 40, 10)
	m.resizeWidgets()
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
	m.resizeWidgets()
}

// resizeWidgets sizes each bubbles widget to the current terminal extent.
func (m *Model) resizeWidgets() {
	m.widget0.SetSize(tui.WidgetWidth(m.width), tui.WidgetHeight(m.height))
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Open() bool {
	return m.open
}

func (m Model) SetOpen(v bool) Model {
	m.open = v
	return m
}

type setOpenMsg struct{ value bool }

func SetOpenCmd(v bool) tea.Cmd {
	return func() tea.Msg { return setOpenMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setOpenMsg:
		m = m.SetOpen(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
		m.resizeWidgets()
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		}
	}
	if m.__focusID == 0 {
		m.widget0, cmd = m.widget0.Update(msg)
		cmds = append(cmds, cmd)
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	if m.open {
		content = m.widget0.View()
	}
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
