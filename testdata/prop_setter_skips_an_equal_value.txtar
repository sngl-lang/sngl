A component built at run time takes each prop through its setter, and a
render hands every instance it holds each prop again: a setter handed the
value its cell already holds returns before the write
(lower.propSetter), so nothing reading the prop updates. The Pokédex's 237
move rows each re-rendered for every move's answer that arrived, though one
row at most had changed.

The value is compared as == compares it: a string, an enum, a struct field
by field. A list is written whatever it holds, and so is a struct or an
option holding one: compared, the Pokédex's gtk4 Go tests left its forms
unrendered and its evolution rows removed a freed widget
(lower.comparedByValue). A map and a function are written whatever they
hold, since not every target compares them by value.

`chain == other` compares a struct holding a list of itself, as the
Pokédex's evolution chain is, by a function that calls itself -- C's per
type, JS's named where it is written: JS wrote it out field by field and
never ended.

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
    }
    c {
        gtk4
    }
    none {
        html
    }
}

struct Fact {
    kind  string
    power int
}

struct Link {
    name string
    next list[Link]
}

func depth(l Link) int {
    var d = 1
    for var n = l.next {
        d = d + depth(n)
    }
    return d
}

component row(name string, tags list[string], fact Fact, chain Link, seen map[string, int], @pick()) ui.node {
    ui.vbox {
        ui.text(value="{name} {tags.format()} {fact.kind} {depth(chain)} {seen.length()}")
        ui.button(text="pick", @click { pick() })
    }
}

component table ui.node {
    var names = ["a", "b"]
    var tags = ["x"]
    var seen map[string, int] = {}
    var picked = ""
    var chain = Link{name="a", next=[Link{name="b", next=[]}]}
    var other = Link{name="a", next=[]}

    ui.vbox {
        for var n = names {
            row(name=n, tags=tags, fact=Fact{kind=picked, power=1}, chain=chain, seen=seen, @pick { picked = n })
        }
        ui.button(text="more", @click { names.push("c") })
        ui.text(value="{chain == other}")
    }
}

ui.window {
    table()
}
-- out/c/gtk4/main.c --
