// A literal newline is permitted inside a quoted string, so an unterminated
// one runs to the end of the file. The diagnostic therefore belongs at the
// quote that opened it, not at the end of the input -- and a comment cannot be
// written on that line, because the string would swallow it. Hence the
// position on the directive.
//
// No window here: the string swallows everything after it, so anything
// appended would be inside the literal.
import . "sngl:ui"

// ERROR(parse:12:16) "unterminated string"
var x string = "hello
