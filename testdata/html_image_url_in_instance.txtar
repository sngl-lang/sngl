An image in a component built at run time changes its picture by its <img>'s
`src`, as its creation sets it: the setter the factory declares was
translated before the body created the element, so it knew no source and
wrote the new URL as a `url` attribute no <img> reads, and the Pokédex's
reused cards kept their old artwork.
deny out/none/html/index.html `setAttribute\("url"` -- an image's URL is its src
-- app.sngl --
import . "sngl:test"
import . "sngl:ui"

output {
    none {
        html
    }
}

component card(url string) node {
    var taps = 0

    button(text="tap", @click { taps += 1 })
    image(alt="x") {
        remote(url=url)
    }
}

component page node {
    var u = "a.png"
    var on = true

    if on {
        card(url=u)
    }
    button #next(text="next", @click { u = "b.png" })
}

func testTheUrlMoves(t Test, c page) {
    c.next.click()
    t.assert(c.u == "b.png")
}

window {
    page
}
-- out/none/html/index.html --
