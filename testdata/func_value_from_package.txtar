A function another of the program's packages declares, held only as a value,
is emitted.

A directory import's functions reach the output only when the program reaches
them, and that walk followed calls: a function handed to a func-typed prop or
stored in a record was referenced by the emitted code and declared by nothing
(`undefined: shout`). A generated family's `render` is the case that found it,
the family's override being in the package and its `encode` read as a value.

-- app.sngl --
import p "./p"
import ui "sngl:ui"

output {
    go {
        gtk4
    }
}

ui.window {
    p.shouter()
}
-- p/p.sngl --
import ui "sngl:ui"

struct Holder {
    f func(s string) string
}

func shout(s string) string {
    var out = s.upper()
    return out + "!"
}

component show(render func(s string) string) ui.node {
    var h = Holder{f=render}

    ui.text(value=h.f("a"))
}

component shouter() ui.node {
    show(render=shout)
}
-- out/go/gtk4/callbacks.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

import "git.duckfam.us/jonathan/sngl/pkg/go/gtk4rt"

func main() {
	gtk4rt.Run(func(app gtk4rt.Handle) gtk4rt.Handle {
		return New().BuildUI(app)
	})
}
-- out/go/gtk4/model.go --
