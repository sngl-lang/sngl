A query is a box the store holds, found by an id and the key it was asked
with, and `remote.query` is an ordinary intrinsic an adapter calls — there is
no query construct and no mark. So what reaches the output is whatever the
inliner carried to the call site, which is where the box has to be keyed.

`&` is the caller's whole say in it. Here the url is passed as a value, which
keys one question forever: the box is bound once, in the constructor, and
stays where it was put. Changing the url after that is not a new question,
because the caller did not ask for one -- every later read is `m.res`, the
same box. The cell form, `http.fetch(&url)`, is in
remote_http_fetch_live.txtar.

Either way it is the same lookup under the id the adapter spelled, keyed by
the url, and inside the thunk the transport the language implements, down to
the Go package that performs the request.

-- snap.sngl --
import . "sngl:ui"
import . "sngl:app"
import http "sngl:remote/http"

component main ui {
    var url = "https://example.com/"
    var res = http.fetch(url)

    window(title="fetch") {
        text(value=res.or(blank).body)
        button(text="go", @click { url = "https://other/" })
    }
}

const blank = http.Result{status=0, body="", headers={}}

output(lang="go", platform="bubbletea")
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from snap.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/remote"
	"git.duckfam.us/jonathan/sngl/pkg/go/remote/http"
)

var blank http.Response = http.Response{Status: 0, Body: "", Headers: map[string]string{}}

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	blank     http.Response
	url       string
	res       *remote.Value[http.Response]
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.blank = http.Response{Status: 0, Body: "", Headers: map[string]string{}}
	m.url = "https://example.com/"
	m.res = remote.Query[http.Response](remote.Default, "http.fetch", ([]any)([]string{m.url}), func() (http.Response, error) {
		return (func() http.Response { return func() http.Response { v, _ := http.Get(m.url); return v }() })(), nil
	})
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Url() string {
	return m.url
}

func (m Model) SetUrl(v string) Model {
	m.url = v
	return m
}

type setUrlMsg struct{ value string }

func SetUrlCmd(v string) tea.Cmd {
	return func() tea.Msg { return setUrlMsg{value: v} }
}

func (m Model) Res() *remote.Value[http.Response] {
	return m.res
}

func (m Model) SetRes(v *remote.Value[http.Response]) Model {
	m.res = v
	return m
}

type setResMsg struct{ value *remote.Value[http.Response] }

func SetResCmd(v *remote.Value[http.Response]) tea.Cmd {
	return func() tea.Msg { return setResMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setUrlMsg:
		m = m.SetUrl(msg.value)
	case setResMsg:
		m = m.SetRes(msg.value)
	case remoteSettledMsg:
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.url = "https://other/"
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0 = lipgloss.NewStyle().Render(fmt.Sprint(m.res.Or(m.blank).Body))
	parts = append(parts, part0)
	var part1 string
	part1Focused := (m.__focusID == 0)
	part1Prefix := " "
	if part1Focused {
		part1Prefix = ">"
	}
	part1 = lipgloss.NewStyle().Render(part1Prefix + " " + fmt.Sprint("go"))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

// remoteSettledMsg wakes the program when a fetch answers.
type remoteSettledMsg struct{}
