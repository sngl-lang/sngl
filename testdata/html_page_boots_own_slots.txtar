A page boots only the render slots it placed.

`site` is a root component, spliced into the package body, so the slot the
branch in `Toggle` lowers to is the package's -- and html collects slot funcs
per owner. Every page used to look its anchor up and render into it, and on
`two.html`, which has no such anchor, `insertBefore` on null threw at startup
and stopped the rest of that page's script. On the docs site that was every
page.

deny out/none/html/two.html `__slotAnchor_0` -- two.html places no slot, so it boots none

-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
}

component Toggle() ui.node {
    var on = false

    ui.vbox {
        ui.button(text="flip", @click { on!! })
        if on {
            ui.text(value="on")
        }
    }
}

component site() ui.root {
    ui.window(title="one", href="/one.html") {
        Toggle
    }
    ui.window(title="two", href="/two.html") {
        ui.text(value="plain")
    }
}

site()
