A raise after a blocking call, under a window's @error. passAsyncOffload has
split the click: load runs on a goroutine, and what follows is posted back to
the drawing thread. The catch block the goroutine half gets recovers the raise
on that goroutine, so its handler -- which writes the model and a widget -- is
posted back too. Run where it was recovered, it raced the drawing thread on
fyne and called GTK off its main thread on gtk4.

deny * `_ = e\n\s*m\.caught =` -- the window's handler runs inside the post, not on the goroutine

-- app.sngl --
import . "sngl:ui"
import go "sngl:language/go"

#[go.native("time", "time.Sleep")]
#[go.async]
func sleep(ns int)

func load(s string) string {
    sleep(3)
    if s.length == 0 {
        error.raise("empty", "validation")
    }
    return s
}

var caught = "none"
var greeting = "idle"

window #home(title="raise", @error(e) {
    caught = "window: " + e.message
}) {
    vbox {
        button(text="go", @click {
            greeting = load("")
        })
        text(value=caught)
        text(value=greeting)
    }
}

output {
    go {
        fyne
        gtk4
    }
}
