// `output(entry = …)` names the window a build opens at by its `#id`, not by
// a string — so what a program writes there is a name the compiler resolves.
// A component is a declaration and resolves; it is just not a window.

import ui "sngl:ui"

output(entry=greeting) // ERROR(check) "output entry names a window, and greeting is not one"

component greeting() ui.node {
    ui.text(value="hi")
}

ui.window #home(title="Home") {
    greeting()
}
