JS codegen for map<K, V> under the html platform. A map literal is emitted as
`new Map([[k, v], ...])`; `length()` dispatches to the `.size` property rather
than a call; and `get()` with a default becomes a `.has()`/`.get()` ternary,
since JS has no two-argument lookup.
-- app.sngl --
import . "sngl:ui"
import app "sngl:app"

output { none { html } }

component main ui {
    var scores map<string, int> = {alice=10, bob=20}
    var size = 0
    button(text="count", @click {
        size = scores.length()
    })
    button(text="check", @click {
        size = scores.get("alice", 0)
    })
    text(value=string(size))
}

app.window {
    main
}
