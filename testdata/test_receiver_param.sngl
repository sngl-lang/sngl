import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

// A method's first parameter is the receiver when its type is the type the
// method is attached to, whatever the parameter is called. The convention used
// to be the name `this`, which meant a method written the other way could only
// be called through its type.
struct Box<T> {
    value T
}

func Box<T>.same(b Box<T>) Box<T> { return b }
func int.twice(n int) int { return n * 2 }

component main ui {
    var b Box<int> = {value=1}
    text(value="{b.value}")
}

func testReceiverIsTheFirstParam(t Test, c main) {
    var b Box<int> = {value=1}

    // Reached as a method on the value...
    t.assert(b.same().value == 1)
    t.assert(3.twice() == 6)

    // ...and through the type, with the receiver written out. Only the
    // non-generic case: `Box.same(b)` reports "cannot pass Box as Box", a
    // generic-identity problem of its own that predates this.
    t.assert(int.twice(3) == 6)
}

app.window {
    main
}
