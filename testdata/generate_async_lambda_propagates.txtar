A function whose body contains a lambda that calls an async native is
itself colored async.  The generated JS must emit "async function outer".

The enclosing function is async because its lambda body calls async.

The async call inside the lambda is awaited.
-- app.sngl --
import . "sngl:ui"
import api "js:./api"

output {
    none {
        html
    }
}

func outer() {
    var f = func() { api.fetchHello("x") }
    f()
}

component main {
    button(text="Go", @click { outer() })
}
-- api/index.ts --
export async function fetchHello(url: string): Promise<string> { return "hi"; }
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<button id="$0">
  <span>Go</span>
</button>

<script>
(() => {
  // sngl-virt:/sngl/api/index.ts
  async function fetchHello(url) {
    return "hi";
  }

  // sngl-entry.js
  var state = {};
  async function outer() {
    let f = async () => {
      await fetchHello("x");
    };
    f();
  }
  var $0 = document.getElementById("$0");
  $0.addEventListener("click", async function() {
    await outer();
  });
})();
</script>
</body></html>
