// A slot population's binding may name its type. The declaration carries the
// types and no names, so a population names positions -- and a written type
// has to agree with the position it names.

import . "sngl:ui"

struct Row {
    title string
}

component table(rows list<Row>, cell component(Row)) node {
    vbox {
        for var r = rows {
            cell(r)
        }
    }
}

component grid(rows list<Row>, row component(Row, int)) node {
    vbox {
        for var i, r = rows {
            row(r, i)
        }
    }
}

component main node {
    vbox {
        // Name only.
        table(rows=[]) {
            component cell(row) {
                text(value=row.title)
            }
        }
        // The same binding, said out loud.
        table(rows=[]) {
            component cell(row Row) {
                text(value=row.title)
            }
        }
        // Across lines: the population is written the way an argument list is,
        // so the formatter writes it back the same way.
        grid(rows=[]) {
            component row(
                r Row,
                i int,
            ) {
                text(value="{i}: {r.title}")
            }
        }
    }
}

window {
    main
}
