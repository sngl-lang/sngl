A function's last parameter may be `...T`. The checker packs the arguments
past the others into a list literal at each call, a list spread into that
position becoming a spread element of it, so every backend emits an ordinary
list argument. `int.min` and its siblings are the library's own variadics:
Go's builtin min, JavaScript's Math.min and Kotlin's minOf each take the
arguments separately, so a literal rest is written out and any other is
folded over.

-- func_variadic.sngl --
import . "sngl:ui"
import . "sngl:test"

// A function's last parameter may be `...T`: it collects the positional
// arguments past the others into a list[T], and a list spread into that
// position contributes its elements.
func sum(first int, rest ...int) int {
    var total = first
    for var x = rest {
        total += x
    }
    return total
}

func count(xs ...string) => xs.length()

struct Point {
    first int
}

component main node {
    var more = [3, 4]
    vbox {
        text(value=string(sum(1, 2, ...more)))
        extremes()
    }
}

func testVariadic(t Test, c main) {
    t.assert(sum(1) == 1)
    t.assert(sum(1, 2, 3) == 6)
    var xs = [2, 3, 4]
    t.assert(sum(1, ...xs) == 10)
    t.assert(sum(1, 2, ...xs, 5) == 17)
    t.assert(sum(first=1, rest=[2, 3]) == 6)
    t.assert(count() == 0)
    t.assert(count("a", "b") == 2)
    // A struct spread still names parameters by its fields.
    var p = Point{first=7}
    t.assert(sum(...p) == 7)
}

component extremes node {
    var n = 7
    var xs = [9, 4]
    vbox {
        text(value=string(int.min(n, 3, 5)) + " " + string(int.max(n, ...xs)))
        button(text="more", @click {
            n = n + 1
            xs = [n, 2]
        })
    }
}

window {
    main()
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
