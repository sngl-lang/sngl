// SKIP(codegen) "names sngl:platform/html, which a per-platform harness does not register"
// A platform override is checked with its statements swapped onto the
// declaration and the base body put back after, so the tree-less rule has to
// hold the body it was asked about rather than whatever the declaration holds
// when the answer arrives. Reading it late checks the base body once per
// registered override, and the override's body never.

import tree "sngl:tree"
import ui "sngl:ui"
import "sngl:platform/html"

#[tree.none]
component logger() {
    ui.text(value="base") // ERROR(check) "component logger names no tree, so it may not contain the node component text"
}

component logger[html.platform] {
    ui.text(value="ovr") // ERROR(check) "component logger names no tree, so it may not contain the node component text"
}

ui.window {
    logger()
}
