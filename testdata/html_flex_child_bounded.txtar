A box given a share of a column is that share, and no more, on html: its
`flex` is written with `min-width:0;min-height:0`. A flex item's minimum is its
content's by default, so a box with `flex=1` grew with what it held, the
scroll inside it never scrolled, and its end always showed -- a grid loading a
page at its end loaded every page there was.

deny out/none/html/index.html `flex:1(;gap|"|;padding)` -- every flex is written with its minimum

-- app.sngl --
import seq "sngl:seq"
import ui "sngl:ui"

output {
    none {
        html
    }
}

component page ui.node {
    var shown = 30

    ui.vbox(style={flex=1, padding=8px}) {
        ui.text(value="items")
        ui.scroll(style={flex=1}, @reachEnd { shown += 30 }) {
            ui.vbox {
                for var i = seq.count(shown) {
                    ui.text(value="{i}")
                }
            }
        }
    }
}

ui.window {
    page()
}
-- out/none/html/index.html --
