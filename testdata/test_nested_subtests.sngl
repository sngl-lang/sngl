import . "sngl://std"

component nested {
    var x = 0
    var y = 0
    text(value="{x}")
}

func testThreeLevels(t Test, c nested) {
    c.x = 1
    t.assert(c.x == 1)

    t.test("level 2", func(t, c) {
        c.x = 2
        t.assert(c.x == 2)

        t.test("level 3", func(t, c) {
            c.x = 3
            t.assert(c.x == 3)
        })

        t.assert(c.x == 2)
    })

    t.assert(c.x == 1)
}

func testSiblingSubtests(t Test, c nested) {
    c.x = 10

    t.test("first sibling", func(t, c) {
        c.y = 1
        t.assert(c.y == 1)
        t.assert(c.x == 10)
    })

    t.test("second sibling", func(t, c) {
        t.assert(c.y == 0)
        t.assert(c.x == 10)
    })
}
