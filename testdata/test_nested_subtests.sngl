component nested {
    var x = 0
    var y = 0
    text(value="{x}")
}

test nested "three levels" {
    x = 1
    assert(x == 1)

    test "level 2" {
        x = 2
        assert(x == 2)

        test "level 3" {
            x = 3
            assert(x == 3)
        }

        assert(x == 2)
    }

    assert(x == 1)
}

test nested "sibling subtests" {
    x = 10

    test "first sibling" {
        y = 1
        assert(y == 1)
        assert(x == 10)
    }

    test "second sibling" {
        assert(y == 0)
        assert(x == 10)
    }
}
