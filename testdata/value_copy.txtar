deny out/none/html/index.html `\.push\(state\.xs__inst0\[0\]\)` -- a pushed element is a copy
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `ys__inst0\.add\(xs__inst0\[0\]\)` -- a pushed element is a copy
deny * `copy\(Row\{|Clone\(\[\]int\{` -- a literal is nobody else's and is not copied
deny out/go/bubbletea/model.go `r__own := func[^\n]*\n\tr__own = Row` -- a parameter replaced whole is not copied
deny out/none/html/index.html `let r__own = \(\([^\n]*\n\s*r__own = \{` -- a parameter replaced whole is not copied

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
    kotlin {
        android
    }
    none {
        html
    }
}

struct Row {
    n     int = 0
    items list[int] = []
}

struct Tree {
    label string
    kids  list[Tree] = []
}

func bumped(r Row) int {
    r.n = 5
    r.items.push(1)
    return r.n
}

func Row.grow(r Row) {
    r.n += 1
}

func size(r Row) int {
    return r.n + r.items.length()
}

func replaced(r Row) int {
    r = Row{n=9}
    return r.n
}

func pushedTo(xs list[int]) int {
    xs.push(3)
    return xs.length()
}

component box ui.node {
    var (
        xs list[Row] = [Row{n=1, items=[1]}]
        ys list[Row] = []
        a list[int] = [1, 2]
        b list[int] = []
        p = Row{n=1, items=[1]}
        q = Row{}
        t = Tree{label="a", kids=[Tree{label="b"}]}
        u = Tree{label="x"}
        m map[string, Row] = {"a"=Row{n=1}}
        mm map[string, Row] = {"b"=Row{}}
        out = ""
    )

    func pushed() {
        ys.push(xs[0])
        xs[0].n = 5
        xs[0].items.push(2)
        out = "{ys[0].n} {ys[0].items.length()}"
    }

    func assigned() {
        q = p
        b = a
        p.items[0] = 9
        a[0] = 9
        out = "{q.items[0]} {b[0]}"
    }

    func local() {
        var l = xs[0]
        xs[0].n = 7
        l.items.push(4)
        out = "{l.n} {xs[0].items.length()}"
    }

    func literal() {
        ys = [p]
        p.n = 4
        out = "{ys[0].n}"
    }

    func referenced() {
        for var &x = xs {
            ys.push(x)
            x.n = 9
        }
        out = "{ys[0].n} {xs[0].n}"
    }

    func tree() {
        u = t
        t.kids.push(Tree{label="c"})
        out = "{u.kids.length()} {t.kids.length()}"
    }

    func maps() {
        mm = m
        m["a"] = Row{n=7}
        out = "{mm.get("a", Row{}).n}"
    }

    func params() {
        var bv = bumped(p)
        p.grow()
        var sv = size(p)
        var rv = replaced(p)
        var lv = pushedTo(a)
        out = "{p.n} {p.items.length()} {bv} {sv} {rv} {lv} {a.length()}"
    }

    ui.text #o(value=out)
    ui.button(text="pushed", @click { pushed() })
    ui.button(text="assigned", @click { assigned() })
    ui.button(text="local", @click { local() })
    ui.button(text="literal", @click { literal() })
    ui.button(text="referenced", @click { referenced() })
    ui.button(text="tree", @click { tree() })
    ui.button(text="maps", @click { maps() })
    ui.button(text="params", @click { params() })
}

ui.window {
    box
}
