A blocking call in a timer's `@tick` gets a goroutine like one anywhere else.

`offloadableFuncs` is the list of bodies passAsyncOffload may enter from the
target's own thread. It reads each component's timers and the package's, and
read a window's vars, funcs and error handler but not its timers -- and
passTimerPrimitive records a schedule on whichever owner held the node, so an
inlined timer's is a window's.

The failure was silent, which is what makes it worse than the ternary panic in
`timer_tick_lowered.txtar`: the tick body was left as written, so
`os.Hostname()` ran on the goroutine fyne draws on. A poll of anything slower
than a hostname lookup freezes the window, and the generated code compiles and
runs.

deny out/go/fyne/model.go `m.name__inst0 = func\(\) string \{ v, _ := os.Hostname` -- the answer is bound on the spawned goroutine and posted back, never assigned on the drawing thread

-- app.sngl --
import ui "sngl:ui"
import time "sngl:time"
import go "sngl:language/go"

#[go.native("os", "os.Hostname", fails)]
#[go.async]
func host() string

output {
    go {
        fyne
    }
}

component poller ui.node {
    var name = "idle"

    time.timer(interval=50ms, @tick {
        name = host()
    })

    ui.text(value=name)
}

ui.window #main(title="poll") {
    poller()
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package ui

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/widget"
	"os"
	"time"
)

func mustParseDuration(s string) time.Duration {
	d, err := time.ParseDuration(s)
	if err != nil {
		panic(err)
	}
	return d
}

// Model holds the state for this SNGL UI.
type Model struct {
	name__inst0 string

	__n0 *widget.Label

	timer0Ticker *time.Ticker
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.name__inst0 = "idle"
	return m
}

func (m *Model) host() string {
	return ""
}

func (m *Model) Name__inst0() string {
	return m.name__inst0
}

func (m *Model) SetName__inst0(v string) {
	m.name__inst0 = v
}

// StartTimers starts all timers; ticks are gated on each timer's enabled var.
func (m *Model) StartTimers() {
	m.timer0Ticker = time.NewTicker(50 * time.Millisecond)
	go func() {
		for range m.timer0Ticker.C {
			fyne.Do(func() {
				go func() {
					__async_off0 := func() string { v, _ := os.Hostname(); return v }()
					fyne.Do(func() {
						m.name__inst0 = __async_off0
						m.__n0.SetText(m.name__inst0)
					})
				}()

			})
		}
	}()
}

// StopTimers stops all active timers.
func (m *Model) StopTimers() {
	if m.timer0Ticker != nil {
		m.timer0Ticker.Stop()
	}
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText(m.name__inst0)
	content := fyne.CanvasObject(m.__n0)
	return content
}
