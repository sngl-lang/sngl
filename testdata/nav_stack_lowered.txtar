A target that does not declare `navigation` gets sngl:ui/nav as plain UI
(passNavigation). The stack's `current` is a var of the navigator family's
record, its props plus an `id`, starting at the page whose href is "/". The
pkg page's params are the program's own `picked`, which the page binds. The
history is a list of entries, each holding the page it replaced and the
params. The pages are an if-chain on `current.id`, so the counter on the home
page is not mounted while another page shows. On gtk4 and fyne it is an
instance built with the branch and starts again at zero; bubbletea splices
its `hits` into the Model, where it survives -- the divergence a window
under an `if` has there too, and still open.

The links call `go`, which pushes an entry and writes the params and
`current`; the button calls `back`, which pops one and restores both. A read
of `pages.current` -- the window's title, the func taking a navigator, the
comparison with `about` -- reads the var, and the comparison compares ids.

deny * `nav\.|Stack|navGo` -- nothing of sngl:ui/nav reaches a backend

-- app.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    go {
        gtk4
        fyne
        bubbletea
    }
}

struct Pkg {
    name string
}

var picked = Pkg{name="first"}

func label(n nav.navigator) string {
    return "at {n.title}"
}

component counter ui.node {
    var hits = 0
    ui.button(text="hits {hits}", @click {
        hits += 1
    })
}

ui.window #main(title="Docs - {pages.current.title}") {
    ui.vbox {
        nav.stack #pages {
            nav.page #home(href="/", title="Home") {
                counter()
            }
            nav.page #about(href="/about", title="About") {
                ui.text(value=label(pages.current))
            }
            nav.page #pkg(href=`/p/{name}`, title="Package", :params=picked) {
                component content(p) {
                    ui.text(value=p.name)
                }
            }
        }
        nav.link(to=about, text="About")
        nav.link(to=pkg, params=Pkg{name="sngl"}, text="sngl")
        ui.button(text="Back", @click {
            pages.back()
        })
        if pages.current == about {
            ui.text(value="on about")
        }
    }
}
