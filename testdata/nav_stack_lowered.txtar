A target that does not declare `navigation` gets sngl:ui/nav as plain UI
(passNavigation). The stack's current page is a var of the page family's
record, its props plus an `id`, starting at the page whose href is "/"; the
family's `meta` is the program's `Meta`, which every page of the stack
carries. The pkg page's params var starts at the params its call site wrote,
which is also what a `go` naming none shows it with. The history is a list of
entries, each holding the page it replaced and the params. The pages are an
if-chain on `current.id`, so the counter on the home page is not mounted
while another page shows. On gtk4 and fyne it is an instance built with the
branch and starts again at zero; bubbletea splices its `hits` into the
Model, where it survives -- the divergence a window under an `if` has there
too, and still open.

The links call `go`, which pushes an entry and writes the params and the
current page; the button calls `back`, which pops one and restores both. A
read of `pages.current` -- the window's title, the meta's label, the
comparison with `about` -- reads the var, and the comparison compares ids.

deny * `nav\.|\bStack\b|navGo` -- nothing of sngl:ui/nav reaches a backend (gtk4's own box calls ask for a GtkStack)

-- app.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    go {
        gtk4
        fyne
        bubbletea
    }
}

struct Pkg {
    name string
}

struct Meta {
    label string
}

func label(title string) string {
    return "at {title}"
}

component counter ui.node {
    var hits = 0
    ui.button(text="hits {hits}", @click {
        hits += 1
    })
}

ui.window #main(title="Docs - {pages.current.title}") {
    ui.vbox {
        nav.stack #pages {
            nav.page #home(href="/", title="Home", meta=Meta{label="home"}) {
                counter()
            }
            nav.page #about(href="/about", title="About", meta=Meta{label="about"}) {
                ui.text(value=label(pages.current.title))
            }
            nav.page #pkg(href=`/p/{name}`, title="Package", meta=Meta{label="pkg"}, params=Pkg{name="first"}) {
                component content(p) {
                    ui.text(value=p.name)
                }
            }
        }
        ui.text(value=pages.current.meta.label)
        nav.link(to=about, text="About")
        nav.link(to=pkg, text="first")
        nav.link(to=pkg, params=Pkg{name="sngl"}, text="sngl")
        ui.button(text="Back", @click {
            pages.back()
        })
        if pages.current == about {
            ui.text(value="on about")
        }
    }
}
