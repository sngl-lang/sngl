import . "sngl:ui"
import . "sngl:test"

component indexed {
    var items = ["a", "b", "c"]
    var rate = 0.0
    var empty list<string> = []

    vbox {
        for var idx, item = items {
            text #row(value="{item}:{idx * 10}")
        }
    }
}

// The index comes first and the element second, which is what the checker
// types and what every backend emits. The fixture used to name them the other
// way round and assert "0:a" anyway -- the interpreter bound them backwards,
// so two mistakes cancelled and the html this program generates disagreed
// with the interpreter running it.
//
// `idx * 10` is what keeps the two from cancelling again: interpolating both
// names type-checks under either binding, so the assertion was the only thing
// pinning the order and a checker that swapped them would still compile this.
// Multiplication takes the int alone, so the swap is a check error here rather
// than a different string.
func testForWithIndexVariable(t Test, c indexed) {
    t.assert(c.row[0].value == "a:0")
    t.assert(c.row[1].value == "b:10")
    t.assert(c.row[2].value == "c:20")
}

func testFloatComparisons(t Test, c indexed) {
    t.assert(c.rate == 0.0)
    c.rate = 1.5
    t.assert(c.rate != 0.0)
}

func testListComparisons(t Test, c indexed) {
    t.assert(c.items.length() > 0)
    t.assert(c.empty.length() == 0)
}
