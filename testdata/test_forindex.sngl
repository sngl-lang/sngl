import . "sngl:ui"
import . "sngl:test"

component indexed {
    var items = ["a", "b", "c"]
    var rate = 0.0
    var empty list<string> = []

    vbox {
        for var idx, item = items {
            text #row(value="{item}:{idx * 10}")
        }
    }
}

// `idx * 10` is what stops the two mistakes cancelling: interpolating both
// names type-checks under either binding, so a swap would still compile.
// Multiplication takes the int alone.
func testForWithIndexVariable(t Test, c indexed) {
    t.assert(c.row[0].value == "a:0")
    t.assert(c.row[1].value == "b:10")
    t.assert(c.row[2].value == "c:20")
}

func testFloatComparisons(t Test, c indexed) {
    t.assert(c.rate == 0.0)
    c.rate = 1.5
    t.assert(c.rate != 0.0)
}

func testListComparisons(t Test, c indexed) {
    t.assert(c.items.length() > 0)
    t.assert(c.empty.length() == 0)
}
