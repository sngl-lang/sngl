component indexed {
    var items = ["a", "b", "c"]
    var rate = 0.0
    var empty = []

    vbox {
        for item, idx = items {
            text #item(value="{idx}:{item}")
        }
    }
}

func testForWithIndexVariable(t T, c indexed) {
    t.assert(c.#item[0].value == "0:a")
    t.assert(c.#item[1].value == "1:b")
    t.assert(c.#item[2].value == "2:c")
}

func testFloatComparisons(t T, c indexed) {
    t.assert(c.rate == 0.0)
    c.rate = 1.5
    t.assert(c.rate != 0.0)
}

func testListComparisons(t T, c indexed) {
    t.assert(c.items.length() > 0)
    t.assert(c.empty.length() == 0)
}
