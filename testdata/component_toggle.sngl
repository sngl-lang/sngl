import . "sngl:std"

// toggle: state-binding fixture — flipping the bound `checked` var
// propagates to the switch, and the label sits after the switch.
component main {
    var on = false
    toggle(checked=on, label="Notifications")
}

func testToggleFlips(t Test, c main) {
    t.assert(c.on == false)
    c.on = true
    t.assert(c.on == true)
    c.on = false
    t.assert(c.on == false)
}
