  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Index</title>
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<a href="/one.html">One</a>
<a href="/two.html">Two</a>

<script>
(() => {
  // sngl-entry.js
  var state = {};
})();
</script>
</body></html>
