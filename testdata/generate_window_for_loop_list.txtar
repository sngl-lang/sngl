A `for` over a const list writes one page per item: title and href come from
the item, so a two-element `items` is one.html and two.html. The index page
iterates the same list for its links -- a page's `#id` written in a loop names
that copy inside the loop and nothing outside it, so the index reads the data
the pages came from rather than the pages.

Both loops run at build time. The golden is three static pages whose links are
literal, with no client JS behind them.

The body reads `page.title` beside `it.title`, and the two fold by different
routes. `it.title` is the loop variable the document binds for its copy.
`page.title` is a read off the page's own id, which is the copy's record --
`title=it.title`, folded where `it` is bound.

-- site.sngl --
import . "sngl:ui"
import "sngl:platform/html"
import nav "sngl:ui/nav"

output { none { html } }

struct Item {
    slug string = ""
    title string = ""
}

const items list<Item> = [
    {slug="one", title="One"},
    {slug="two", title="Two"},
]

window(title=pages.current.title) {
    nav.stack #pages {
        nav.page #index(href="/index.html", title="Index") {
            for var it = items {
                html.a(href="/" + it.slug + ".html", innerText=it.title)
            }
        }
        for var it = items {
            nav.page #page(href="/" + it.slug + ".html", title=it.title) {
                text(value=it.title)
                text(value=page.title)
            }
        }
    }
}
-- out/none/html/index.html --
