A `for` over a const list writes one page per item: title and href come from
the item, so a two-element `items` is one.html and two.html. The index page
iterates the same list for its links -- a page's `#id` written in a loop names
that copy inside the loop and nothing outside it, so the index reads the data
the pages came from rather than the pages.

Both loops run at build time. The golden is three static pages whose links are
literal, with no client JS behind them.

The body reads `page.title` beside `it.title`, and the two fold by different
routes. `it.title` is the loop variable the document binds for its copy.
`page.title` is a read off the page's own id, which is the copy's record --
`title=it.title`, folded where `it` is bound.

Under `--lang go` each page is a route with a handler of its own: both loop
copies of `#page` would be `handlePage`, so the second takes the name its
path makes, `handleTwoHtml`.

-- site.sngl --
import . "sngl:ui"
import "sngl:platform/html"
import nav "sngl:ui/nav"

output {
    none { html }
    go { html }
}

struct Item {
    slug  string = ""
    title string = ""
}

const items list[Item] = [
    {slug="one", title="One"},
    {slug="two", title="Two"},
]

window(title=pages.current.title) {
    nav.stack #pages {
        nav.page #index(href="/index.html", title="Index") {
            for var it = items {
                html.a(href="/" + it.slug + ".html", innerText=it.title)
            }
        }
        for var it = items {
            nav.page #page(href="/" + it.slug + ".html", title=it.title) {
                text(value=it.title)
                text(value=page.title)
            }
        }
    }
}
-- out/go/html/server.go --
package main

import (
	"fmt"
	"log"
	"net"
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /index.html", handleIndex)
	mux.HandleFunc("GET /one.html", handlePage)
	mux.HandleFunc("GET /two.html", handleTwoHtml)
	return mux
}

func handleIndex(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from site.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Index</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<a href=\"/one.html\">One</a>\n<a href=\"/two.html\">Two</a>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { visible__inst0: true };\n})();\n</script>\n</body></html>\n"))
}

func handlePage(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from site.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>One</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<span>One</span>\n<span>One</span>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { visible__inst0: true };\n})();\n</script>\n</body></html>\n"))
}

func handleTwoHtml(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from site.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Two</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<span>Two</span>\n<span>Two</span>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { visible__inst0: true };\n})();\n</script>\n</body></html>\n"))
}

func main() {
	ln, err := net.Listen("tcp", ":8080")
	if err != nil {
		log.Fatal(err)
	}
	host, port, _ := net.SplitHostPort(ln.Addr().String())
	if ip := net.ParseIP(host); ip == nil || ip.IsUnspecified() {
		host = "localhost"
	}
	fmt.Println("http://" + net.JoinHostPort(host, port))
	log.Fatal(http.Serve(ln, Handler()))
}
