A type parameter constrained by an anonymous struct reads the constraint's
fields in a generic body. Go and Kotlin copy the function per instantiation,
so the field read is a concrete struct's; JavaScript keeps the one generic
function and reads a property. A spread of a T binds only the constraint's
fields. A field may name another parameter, which the argument's own field
binds: `valueOf(cell)` is an int.

deny out/go/bubbletea/model.go `\bany\b` -- each copy reads a concrete struct
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `\bAny\b` -- each copy reads a concrete struct
deny out/none/html/index.html `nameOf__` -- JavaScript keeps the one generic function

-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        bubbletea
    }
    kotlin {
        android
    }
}

struct User {
    name string
    age  int = 30
}

struct Pet {
    name string
    legs int
}

var n = 1

func nameOf[T struct {
    name string
}](v T) string {
    if n < 0 {
        return ""
    }
    return v.name
}

func greet(name string) => "hi {name}"

func greetAll[T struct {
    name string
}](v T) string {
    if n < 0 {
        return ""
    }
    return greet(...v)
}

struct Cell {
    value int
    label string
}

func valueOf[T any, U struct {
    value T
}](u U) T {
    if n < 0 {
        return u.value
    }
    return u.value
}

struct Holder[T struct {
    name string
}] {
    item T
}

func Holder[T].label() string {
    if n < 0 {
        return ""
    }
    return this.item.name
}

var user = User{name="ann"}
var pet = Pet{name="rex", legs=4}
var held = Holder[Pet]{item=pet}
var cell = Cell{value=7, label="seven"}

ui.window(title="t") {
    ui.text(value="{nameOf(user)} {nameOf(pet)} {greetAll(user)} {held.label()} {valueOf(cell) + 1}")
    ui.button(text="go", @click {
        user = User{name=nameOf(pet)}
        n = n + 1
    })
}
