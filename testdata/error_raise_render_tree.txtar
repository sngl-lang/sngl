A raise follows the render tree. leaf's click reaches no boundary in leaf's own
body, so the checker leaves it native; passErrorScope resolves it once the
inliner has spliced each instance into the tree that renders it. The instance
two levels down under shell's boundary is caught there, and the one beside the
boundary reaches the window's @error. Each splice is its own clone, which is
how one declaration answers to two handlers.

Before the pass every target let both raises out of the click with nothing to
catch them: a bare panic on Go, a bare throw on JavaScript and Kotlin.

deny out/none/html/index.html `addEventListener\("click", function\(\) \{\s*check\(` -- each click is a catch block, not a bare call
deny out/go/bubbletea/model.go `__focusID == \d+:\s*Check\(` -- nor on bubbletea
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `onClick = \{\s*check\(` -- nor on android, where the handler is a lambda in the Button's props by then

-- app.sngl --
import . "sngl:ui"

func check(s string) {
    if s.length == 0 {
        error.raise("empty", "validation")
    }
}

component leaf(label string) node {
    var after = false
    button(text=label, @click {
        check("")
        after = true
    })
}

component middle node {
    leaf(label="deep")
}

component shell node {
    var problem = "none"
    boundary(@error(e) {
        problem = "boundary: " + e.message
    }) {
        middle()
    }
    leaf(label="beside")
    text(value=problem)
}

var caught = "none"

window #home(title="raise", href="/index.html", @error(e) {
    caught = "window: " + e.message
}) {
    vbox {
        shell()
        text(value=caught)
    }
}

output {
    none {
        html
    }
    go {
        bubbletea
        html
    }
    kotlin {
        android
    }
}
