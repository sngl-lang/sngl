// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbles/v2/progress"
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"git.duckfam.us/jonathan/sngl/pkg/go/tui"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	widget0 progress.Model
	widget1 progress.Model

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.widget0 = progress.New()
	m.widget1 = progress.New()
	m.resizeWidgets()
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
	m.resizeWidgets()
}

// resizeWidgets sizes each bubbles widget to the current terminal extent.
func (m *Model) resizeWidgets() {
	m.widget0.SetWidth(tui.WidgetWidth(m.width))
	m.widget1.SetWidth(tui.WidgetWidth(m.width))
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
		m.resizeWidgets()
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0 = m.widget0.ViewAs(tui.Percent(float64(2.0), float64(10.0)))
	parts = append(parts, part0)
	var part1 string
	part1 = m.widget1.ViewAs(tui.Percent(float64(0.0), float64(1.0)))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
