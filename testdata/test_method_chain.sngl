import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

component main node {
    var words = ["hello", "world", "foo"]

    func chain() => words[0].upper().length()
    func deep() => "  spaces  ".trim().upper().length()

    text(value=string(chain))
}

func testMethodChainLen(t Test, c main) {
    t.assert(c.chain == 5)
}

func testMethodChainDeep(t Test, c main) {
    t.assert(c.deep == 6)
}

app.window {
    main
}
