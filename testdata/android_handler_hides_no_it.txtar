import . "sngl:ui"
import . "sngl:test"

output {
    kotlin {
        android
    }
}

component main node {
    var items = ["a", "b"]
    var log = ""
    vbox {
        for var it = items {
            checkbox #row(label=it, @change(on) { log = it })
            checkbox #bare(label=it, @change { log = "{it}!" })
        }
        text(value=log)
    }
}

func testHandlerReadsTheLoopsIt(t Test, c main) {
    c.row[1].change(true)
    t.assert(c.log == "b")
    c.bare[0].change(true)
    t.assert(c.log == "a!")
}

window {
    main
}
