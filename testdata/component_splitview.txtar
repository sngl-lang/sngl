-- component_splitview.sngl --
import . "sngl:ui"

// splitview: A-tier — declaration validates parse + check.
component main node {
    splitview(direction="horizontal", position=0.5) {
        vbox { text(value="Left") }
        vbox { text(value="Right") }
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
