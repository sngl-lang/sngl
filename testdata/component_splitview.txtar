// Code generated by sngl (fyne) from component_splitview.sngl; DO NOT EDIT.

package ui

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
)

// Model holds the state for this SNGL UI.
type Model struct {
	__n0 *fyne.Container
	__n1 *fyne.Container
	__n2 *widget.Label
	__n3 *fyne.Container
	__n4 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = container.NewHBox()
	m.__n1 = container.NewVBox()
	m.__n2 = widget.NewLabel("")
	m.__n2.SetText("Left")
	m.__n1.Add(m.__n2)
	m.__n0.Add(m.__n1)
	m.__n3 = container.NewVBox()
	m.__n4 = widget.NewLabel("")
	m.__n4.SetText("Right")
	m.__n3.Add(m.__n4)
	m.__n0.Add(m.__n3)
	content := fyne.CanvasObject(m.__n0)
	return content
}
