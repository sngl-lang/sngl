A focusable view loop over a map, on bubbletea.

The focus cursor is an int ordinal, and both View() and Update() count it out
by ranging over the map: View() to decide which row is highlighted, Update() to
decide which entry Enter activates. Go randomizes map iteration order per range
execution, so those two walks of the same map are two different orders --
ordinal 3 is one entry in the frame the user is looking at and another in the
handler that runs, and the highlight itself moves between frames. A list has
neither problem, which is why the bug survived: a slice ranges the same way
twice.

So a map loop in a bubbletea view walks its keys in order, and the two
functions below spell the same head. `slices.Sorted` needs a `cmp.Ordered` key;
`bool` is not one, and neither are the struct-backed key types (color, date,
time, datetime, a multi-base unit), so those order by their rendered form
instead -- an arbitrary order, but the same arbitrary order in both functions,
which is the whole requirement.

This also settles a shuffle that predates focus entirely: a plain map loop in a
bubbletea view had no ordering at all, so its rows reshuffled on every frame.

The value comes back by a lookup rather than a second range variable, and the
map is bound to a temp first -- the iterable may be a call, and the lookup runs
once per iteration.

deny out/go/bubbletea/model.go `range m\.labels` -- neither function ranges the map directly; both walk the sorted keys
deny out/go/bubbletea/model.go `range m\.flags` -- likewise for the key type Go will not order

-- app.sngl --
import . "sngl:ui"

output { go { bubbletea } }

component main {
    var labels map<string, string> = {a="A", b="B"}
    var flags map<bool, string> = {true="on", false="off"}
    var picked = ""

    vbox {
        for var k, v = labels {
            button(text=v, @click { picked = k })
        }
        for var f, fv = flags {
            button(text=fv, @click { picked = fv })
        }
    }
    text(value=picked)
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"cmp"
	"fmt"
	"maps"
	"slices"
	"strings"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	labels              map[string]string
	flags               map[bool]string
	picked              string
	__focusID           int
	__focusLoop0_cursor int
	__focusLoop1_cursor int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.labels = map[string]string{"a": "A", "b": "B"}
	m.flags = map[bool]string{true: "on", false: "off"}
	m.picked = ""
	m.__focusID = 0
	m.__focusLoop0_cursor = 0
	m.__focusLoop1_cursor = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		__focusLen := len(m.labels)
		if (m.__focusLoop0_cursor + 1) < __focusLen {
			m.__focusLoop0_cursor = (m.__focusLoop0_cursor + 1)
		} else {
			m.__focusID = 1
			m.__focusLoop1_cursor = 0
		}
	} else {
		if m.__focusID == 1 {
			__focusLen := len(m.flags)
			if (m.__focusLoop1_cursor + 1) < __focusLen {
				m.__focusLoop1_cursor = (m.__focusLoop1_cursor + 1)
			} else {
				m.__focusID = 0
				m.__focusLoop0_cursor = 0
			}
		}
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		if m.__focusLoop0_cursor > 0 {
			m.__focusLoop0_cursor = (m.__focusLoop0_cursor - 1)
		} else {
			__focusLen := len(m.flags)
			m.__focusID = 1
			m.__focusLoop1_cursor = (__focusLen - 1)
		}
	} else {
		if m.__focusID == 1 {
			if m.__focusLoop1_cursor > 0 {
				m.__focusLoop1_cursor = (m.__focusLoop1_cursor - 1)
			} else {
				__focusLen := len(m.labels)
				m.__focusID = 0
				m.__focusLoop0_cursor = (__focusLen - 1)
			}
		}
	}
}

func (m Model) Labels() map[string]string {
	return m.labels
}

func (m Model) SetLabels(v map[string]string) Model {
	m.labels = v
	return m
}

type setLabelsMsg struct{ value map[string]string }

func SetLabelsCmd(v map[string]string) tea.Cmd {
	return func() tea.Msg { return setLabelsMsg{value: v} }
}

func (m Model) Flags() map[bool]string {
	return m.flags
}

func (m Model) SetFlags(v map[bool]string) Model {
	m.flags = v
	return m
}

type setFlagsMsg struct{ value map[bool]string }

func SetFlagsCmd(v map[bool]string) tea.Cmd {
	return func() tea.Msg { return setFlagsMsg{value: v} }
}

func (m Model) Picked() string {
	return m.picked
}

func (m Model) SetPicked(v string) Model {
	m.picked = v
	return m
}

type setPickedMsg struct{ value string }

func SetPickedCmd(v string) tea.Cmd {
	return func() tea.Msg { return setPickedMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setLabelsMsg:
		m = m.SetLabels(msg.value)
	case setFlagsMsg:
		m = m.SetFlags(msg.value)
	case setPickedMsg:
		m = m.SetPicked(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			__focusIdx0 := -1
			for _, k := range slices.Sorted(maps.Keys(m.labels)) {
				__focusIdx0++
				if m.__focusLoop0_cursor == __focusIdx0 {
					m.picked = k
					break
				}
			}
		case msg.Code == tea.KeyEnter && m.__focusID == 1:
			__focusIdx1 := -1
			__focusMap1 := m.flags
			for _, __focusMap1Key := range slices.SortedStableFunc(maps.Keys(__focusMap1), func(a, b bool) int { return cmp.Compare(fmt.Sprint(a), fmt.Sprint(b)) }) {
				fv := __focusMap1[__focusMap1Key]
				__focusIdx1++
				if m.__focusLoop1_cursor == __focusIdx1 {
					m.picked = fv
					break
				}
			}
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	var part0Children []string
	__focusIdx0 := -1
	var part0_1 string
	var part0_1Items []string
	part0_1Map := m.labels
	for _, k := range slices.Sorted(maps.Keys(part0_1Map)) {
		v := part0_1Map[k]
		_ = k
		_ = v
		var part0_1Item string
		__focusIdx0 += 1
		part0_1ItemFocused := ((m.__focusID == 0) && (m.__focusLoop0_cursor == __focusIdx0))
		part0_1ItemPrefix := " "
		if part0_1ItemFocused {
			part0_1ItemPrefix = ">"
		}
		part0_1Item = lipgloss.NewStyle().Render(part0_1ItemPrefix + " " + fmt.Sprint(v))
		part0_1Items = append(part0_1Items, part0_1Item)
	}
	part0_1 = strings.Join(part0_1Items, "\n")
	part0Children = append(part0Children, part0_1)
	__focusIdx1 := -1
	var part0_3 string
	var part0_3Items []string
	part0_3Map := m.flags
	for _, f := range slices.SortedStableFunc(maps.Keys(part0_3Map), func(a, b bool) int { return cmp.Compare(fmt.Sprint(a), fmt.Sprint(b)) }) {
		fv := part0_3Map[f]
		_ = f
		_ = fv
		var part0_3Item string
		__focusIdx1 += 1
		part0_3ItemFocused := ((m.__focusID == 1) && (m.__focusLoop1_cursor == __focusIdx1))
		part0_3ItemPrefix := " "
		if part0_3ItemFocused {
			part0_3ItemPrefix = ">"
		}
		part0_3Item = lipgloss.NewStyle().Render(part0_3ItemPrefix + " " + fmt.Sprint(fv))
		part0_3Items = append(part0_3Items, part0_3Item)
	}
	part0_3 = strings.Join(part0_3Items, "\n")
	part0Children = append(part0Children, part0_3)
	part0 = lipgloss.JoinVertical(lipgloss.Left, part0Children...)
	parts = append(parts, part0)
	var part1 string
	part1 = lipgloss.NewStyle().Render(fmt.Sprint(m.picked))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
