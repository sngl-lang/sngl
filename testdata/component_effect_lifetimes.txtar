A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_effect_lifetimes.sngl --
// What passEffect lowers a bracket to, run: each component is a shape of
// effect whose settle reconciles a list of keys, and its test reads back the
// order the handlers ran in, which a count cannot tell apart from the wrong
// order. testdata/effect_*.sngl hold the interpreter to the same answers.

import . "sngl:test"
import . "sngl:ui"

// A reactive `if` is the lifetime: the branch coming back is a new one.
component branch node {
    var shown = true
    var log list[string] = []
    button #toggle(text="toggle", @click { shown = !shown })
    if shown {
        effect(@mount { log.push("in") }, @unmount { log.push("out") })
    }
    text(value=log.join(","))
}

func testBranchIsTheLifetime(t Test, c branch) {
    t.assert(c.log.join(",") == "in")
    c.toggle.click()
    t.assert(c.log.join(",") == "in,out")
    c.toggle.click()
    t.assert(c.log.join(",") == "in,out,in")
    c.toggle.click()
    t.assert(c.log.join(",") == "in,out,in,out")
}

// One bracket per element, keyed by it: dropping one moves only its own, and
// several ending on one change end newest first.
component perElement node {
    var items list[string] = ["a", "b", "c"]
    var log list[string] = []
    button #drop(text="drop", @click { items = ["a"] })
    button #add(text="add", @click { items.push("d") })
    for var it = items {
        effect(on=it, @mount(v) { log.push("+" + v) }, @unmount(v) { log.push("-" + v) })
    }
    text(value=log.join(","))
}

func testEndingsRunNewestFirst(t Test, c perElement) {
    t.assert(c.log.join(",") == "+a,+b,+c")
    c.drop.click()
    t.assert(c.log.join(",") == "+a,+b,+c,-c,-b")
}

func testPushMountsTheNewBracket(t Test, c perElement) {
    c.add.click()
    t.assert(c.log.join(",") == "+a,+b,+c,+d")
}

// Two positions rekeyed by one write both end before either begins.
component twoPositions node {
    var k = 0
    var log list[string] = []
    button #rekey(text="rekey", @click { k = k + 1 })
    effect(on=k, @mount { log.push("+A") }, @unmount { log.push("-A") })
    effect(on=k, @mount { log.push("+B") }, @unmount { log.push("-B") })
    text(value=log.join(","))
}

func testBothEndBeforeEitherBegins(t Test, c twoPositions) {
    t.assert(c.log.join(",") == "+A,+B")
    c.rekey.click()
    t.assert(c.log.join(",") == "+A,+B,-B,-A,+A,+B")
}

struct counter {
    n int
}

struct pair {
    a int
    b string
}

// A key is read wherever it is written: through a field, and through a call.
component keys node {
    var key counter = counter{n=0}
    var n = 0
    var log list[string] = []

    func scaled(m int) => m * n

    button #field(text="field", @click { key.n = key.n + 1 })
    button #called(text="called", @click { n = n + 1 })
    effect(on=key.n, @mount { log.push("f+") }, @unmount { log.push("f-") })
    effect(on=scaled(2), @mount { log.push("c+") }, @unmount { log.push("c-") })
    text(value=log.join(","))
}

func testAFieldWriteRekeys(t Test, c keys) {
    c.field.click()
    t.assert(c.log.join(",") == "f+,c+,f-,f+")
}

func testACalledKeyRekeys(t Test, c keys) {
    c.called.click()
    t.assert(c.log.join(",") == "f+,c+,c-,c+")
}

// A struct key compares field by field: the same value written again is no
// new lifetime, and a changed field is one.
component structKey node {
    var key pair = pair{a=1, b="x"}
    var log list[string] = []
    button #same(text="same", @click { key = pair{a=1, b="x"} })
    button #bump(text="bump", @click { key = pair{a=1, b="y"} })
    effect(on=key, @mount { log.push("m") }, @unmount { log.push("u") })
    text(value=log.join(","))
}

func testAStructKeyComparesFieldByField(t Test, c structKey) {
    c.same.click()
    t.assert(c.log.join(",") == "m")
    c.bump.click()
    t.assert(c.log.join(",") == "m,u,m")
}

window {
    branch
    perElement
    twoPositions
    keys
    structKey
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
