package main

import (
	"strings"
	"testing"
)

func TestBranchIsTheLifetime(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((strings.Join(c.log__inst0, ",") == "in")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst0, \",\") == \"in\")") }
	c.toggleClick()
	if !((strings.Join(c.log__inst0, ",") == "in,out")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst0, \",\") == \"in,out\")") }
	c.toggleClick()
	if !((strings.Join(c.log__inst0, ",") == "in,out,in")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst0, \",\") == \"in,out,in\")") }
	c.toggleClick()
	if !((strings.Join(c.log__inst0, ",") == "in,out,in,out")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst0, \",\") == \"in,out,in,out\")") }
}

func TestEndingsRunNewestFirst(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((strings.Join(c.log__inst1, ",") == "+a,+b,+c")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst1, \",\") == \"+a,+b,+c\")") }
	c.dropClick()
	if !((strings.Join(c.log__inst1, ",") == "+a,+b,+c,-c,-b")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst1, \",\") == \"+a,+b,+c,-c,-b\")") }
}

func TestPushMountsTheNewBracket(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.addClick()
	if !((strings.Join(c.log__inst1, ",") == "+a,+b,+c,+d")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst1, \",\") == \"+a,+b,+c,+d\")") }
}

func TestBothEndBeforeEitherBegins(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((strings.Join(c.log__inst2, ",") == "+A,+B")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst2, \",\") == \"+A,+B\")") }
	c.rekeyClick()
	if !((strings.Join(c.log__inst2, ",") == "+A,+B,-B,-A,+A,+B")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst2, \",\") == \"+A,+B,-B,-A,+A,+B\")") }
}

func TestAFieldWriteRekeys(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.fieldClick()
	if !((strings.Join(c.log__inst3, ",") == "f+,c+,f-,f+")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst3, \",\") == \"f+,c+,f-,f+\")") }
}

func TestACalledKeyRekeys(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.calledClick()
	if !((strings.Join(c.log__inst3, ",") == "f+,c+,c-,c+")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst3, \",\") == \"f+,c+,c-,c+\")") }
}

func TestAStructKeyComparesFieldByField(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.sameClick()
	if !((strings.Join(c.log__inst4, ",") == "m")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst4, \",\") == \"m\")") }
	c.bumpClick()
	if !((strings.Join(c.log__inst4, ",") == "m,u,m")) { t.Errorf("assert failed: %s", "(strings.Join(c.log__inst4, \",\") == \"m,u,m\")") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
