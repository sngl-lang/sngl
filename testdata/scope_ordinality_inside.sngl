// The count is what a scope says about a handle read from *outside* it. Read
// from inside, the handle is the one node it has always been, and the ids of
// each block are hoisted again into the scope checkBlockIR pushes for it --
// which is what makes the inner binding shadow the counted one.
//
// The positive half of error_scope_ordinality.sngl. Without the re-hoist both
// reads below are the error that fixture asserts, which is a working program
// refused: html already renders this one correctly.
//
// Reads, not writes. This used to prove the point by assigning `maybe.value`,
// which the checker now refuses wherever it is written: a prop is what the
// tree says it is, and a write beside it is a second source of truth the next
// render undoes. What the fixture is about is unchanged -- whether the handle
// resolves at all from inside the scope that counts it.

import ui "sngl:ui"

ui.window #w(title="t") {
    var show = true
    var items = ["a", "b"]

    ui.vbox {
        if show {
            ui.text #maybe(value="hi")

            ui.text(value="maybe says {maybe.value}")
        }

        for var it = items {
            ui.text #row(value=it)

            ui.text(value="row says {row.value}")
        }
    }
}
