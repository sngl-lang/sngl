Every image source, in every place a picture is taken, on every target.

An image's pixels come from a member of `ui.imageSource`: a file the program
carries, a URL fetched while it runs, or a drawing. Each is overridden per
target to a primitive of that target's own, and each container -- `ui.image`,
`markup.image`, `draw.canvasImage` and a window's `favicon` -- takes the source
the same way, through a slot.

What each target does with them:

- html: an image is a frame (`role="img"`, carrying the description and the
  style) around the `<img>` its source renders. A file or a URL is the `src`;
  a drawing paints into a canvas of its own and hands the picture over as a
  data URL, again on every write of what it reads. The document's drawn
  favicon is a `<link rel="icon">` in the head, written the same way.
- fyne: a runtime Image widget whose box shows the source, fitted by the
  frame; a drawing's picture is rasterised and handed to it on each repaint.
  The window's icon is the source's picture.
- gtk4: a gtk4rt image box and a GtkPicture per source, which fits itself to
  the image it lands in; the program draws, so the build is inline cgo and
  hands the window its icon in BuildUI.
- bubbletea: a URL or file is a half-block picture; a drawing is a canvas.
- android: a file is SnglAssetImage, read out of the app's assets; a drawing
  is a Canvas; a URL draws nothing.

`canvasImage` paints a URL through each target's image shim, and a drawing in
place under a transform and a clip, so the drawing needs no surface of its
own. The avatar's source sits under an `if`: where the photo is not there,
the image's placeholder -- the initials -- stands in its place, on every
target, because a slot's fallback renders wherever its content renders
nothing.

deny out/none/html/index.html `<img[^>]*alt="Logo"` -- an image's description is its frame's aria-label; its <img> carries none of its own
deny out/none/html/index.html `<picture` -- the source renders the <img> itself; no picture element selects among sources
deny out/none/html/index.html `<body>[\s\S]*rel="icon"` -- the drawn favicon is the head's icon link, not an element of the page
deny out/go/fyne/model.go `NewImageFromResource\(nil\)` -- an image is no longer an empty canvas.Image

-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"
import markup "sngl:ui/markup"

component gallery ui.node {
    var radius = 4.0
    var url = "https://example.com/a.png"
    var hasPhoto = false
    ui.vbox {
        ui.image(alt="Logo", fit=cover) {
            ui.file(path="logo.svg")
        }
        ui.image(alt="Remote") {
            ui.remote(url=url)
        }
        ui.image(alt="Dot") {
            draw.image(width=16.0, height=16.0) {
                draw.circle(cx=8.0, cy=8.0, r=radius, style={fill=#3366CC})
            }
        }
        ui.avatar(initials="JD") {
            component src {
                if hasPhoto {
                    ui.remote(url=url)
                }
            }
        }
        draw.canvas(width=32px, height=32px) {
            draw.canvasImage(x=0.0, y=0.0, w=16.0, h=16.0) {
                ui.file(path="logo.svg")
            }
            draw.canvasImage(x=16.0, y=16.0, w=16.0, h=16.0) {
                draw.image(width=8.0, height=8.0) {
                    draw.rect(x=0.0, y=0.0, w=8.0, h=8.0, style={fill=#FF0000})
                }
            }
        }
        markup.richText {
            markup.text(value="see ")
            markup.image(alt="logo") {
                ui.file(path="logo.svg")
            }
        }
        ui.button(text="grow", @click {
            radius = radius + 1.0
            hasPhoto = !hasPhoto
        })
    }
}

ui.window(title="Images") {
    gallery
    component favicon {
        draw.image(width=16.0, height=16.0) {
            draw.circle(cx=8.0, cy=8.0, r=6.0, style={fill=#00AA00})
        }
    }
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
