-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestNothingPicked(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.last == "")) { t.Errorf("assert failed: %s", "(c.last == \"\")") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
