A component rendering a focus stop under a `for` is spliced on bubbletea, which
keeps no state of an instance's own and whose focus order reaches only what the
window renders: each copy of the button is one stop of the loop, and Enter runs
the copy's `@pick` with the loop's `x` bound.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
    }
}

component item(label string, @pick()) node {
    button #hit(text=label, @click { pick() })
}

component main node {
    var xs = ["a", "b"]
    var last = ""
    vbox {
        text #shown(value=last)
        for var x = xs {
            item(label=x, @pick { last = x })
        }
    }
}

func testNothingPicked(t Test, c main) {
    t.assert(c.last == "")
}

window {
    main
}
