import . "sngl:ui"

component Counter(label = "") node {
    var count = 0

    hbox {
        text(value=label)
        button(text="+", @click { count = count + 1 })
        button(text="-", @click { count = count - 1 })
    }
}

component main node {
    var (
        count = 0
        name = "World"
        active = true
    )

    func greeting() => "Hello, " + name
    func doubled() => count * 2

    vbox(style={padding=16, gap=12}) {
        text(value=greeting, style={fontSize=24, fontWeight="bold"})
        if active {
            text(value="Active", style={color=#007700})
        }
        input(placeholder="Enter name", value=name, @input(e) { name = e.value })
        Counter(label="Clicks")
        button(text=active ? "Deactivate" : "Activate", @click { active!! })
    }
}

window {
    main
}
