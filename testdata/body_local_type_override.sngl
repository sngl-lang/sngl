// SKIP(codegen) "names sngl:platform/html, which a per-platform harness does not register; the html output is pinned by body_local_type_override.txtar"
import ui "sngl:ui"
import "sngl:platform/html"

// An override body is collected on its own, so its type declarations need
// collecting there too -- pass1 only ever sees the parenless stub. The
// annotated vars are the half that needs them registered before the var walk
// reaches them, and a bare unit literal has no other spelling: 3tk resolves
// against the type its position expects.
component thing ui.node {
    ui.text(value="base")
}

component thing[html.platform] {
    struct Row {
        a int
    }

    var r = Row{a=1}
    var r2 Row = Row{a=2}

    ui.text(value="${r.a}${r2.a}")
}

component tagged ui.node {
    ui.text(value="base")
}

component tagged[html.platform] {
    enum Phase {
        start
        done
    }
    unit tick { tk, kt = 10tk }

    var p = Phase.done
    var p2 Phase = Phase.start
    var elapsed tick = 3tk

    ui.text(value="${p}${p2}${elapsed}")
}

component main ui.node {
    thing()
    tagged()
}

ui.window {
    main
}
