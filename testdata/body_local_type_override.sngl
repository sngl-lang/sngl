// SKIP(codegen) "names sngl:platform/html, which a per-platform harness does not register; the html output is pinned by body_local_type_override.txtar"
import ui "sngl:ui"
import "sngl:platform/html"
import app "sngl:app"

// An override body is collected on its own, so its type declarations need
// collecting there too -- pass1 only ever sees the parenless stub.
//
// The unit here is declared and not used: a bare unit literal needs an expected
// type since 3c223a7e, and a body-local type does not resolve in an annotation
// inside an override body (#204).
component thing ui.node {
    ui.text(value="base")
}

component thing[html.platform] {
    struct Row {
        a int
    }

    var r = Row{a=1}

    ui.text(value="${r.a}")
}

component tagged ui.node {
    ui.text(value="base")
}

component tagged[html.platform] {
    enum Phase {
        start
        done
    }
    unit tick { tk, kt = 10tk }

    var p = Phase.done

    ui.text(value="${p}")
}

component main ui.node {
    thing()
    tagged()
}

app.window {
    main
}
