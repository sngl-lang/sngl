A directory import sorts each page's children by the Frontmatter field marked
`#[md.order]`, ascending, rather than by path.

`zeta.md` writes weight 1 and `alpha.md` weight 3, and `middle.md` writes none
and sorts as the field's default, 2. Path order would list Alpha, Middle,
Zeta; the root's list of children says Zeta, Middle, Alpha.

-- app.sngl --
import ui "sngl:ui"
import docs "md:./docs/"

output {
    none {
        html
    }
}

docs.site {
    component layout(page, content) {
        ui.window(title=page.frontmatter.title, href=page.href) {
            ui.vbox {
                for var child = page.children {
                    ui.text(value="child: {child.frontmatter.title}")
                }
                content
            }
        }
    }
}
-- docs/meta.sngl --
import md "sngl:ui/markup/md"

struct Frontmatter {
    title string = ""
    #[md.order]
    weight int = 2
}
-- docs/index.md --
---
title: Home
---

# Home
-- docs/alpha.md --
---
title: Alpha
weight: 3
---

# Alpha
-- docs/middle.md --
---
title: Middle
---

# Middle
-- docs/zeta.md --
---
title: Zeta
weight: 1
---

# Zeta
