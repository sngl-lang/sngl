A data component's content: each `card` the caller writes is a record of its
props and a number, and what it was written with becomes a branch of the
population of the content slot `deck` is given, chosen by that number. `deck`
inserts it, `c.content`, under the `if` that picks the card shown, so the
content is an ordinary slot population on every target: built where the
container inserts it, reading and writing the caller's state.

`testdata/family_data_content.sngl` is the interpreter's half.

deny * `\.content\b` -- what a record was written with is spliced where the container inserts it, never read off the record
-- app.sngl --
import ui "sngl:ui"

component card(label string, content ...component ui.node) card

component deck(:shown int, cards ...component card) ui.node {
    ui.hbox {
        for var k, c = cards {
            ui.button(text=c.label, @click {
                shown = k
            })
        }
    }
    for var k, c = cards {
        if k == shown {
            c.content
        }
    }
}

ui.window {
    var shown = 0
    var hits = 0
    deck(:shown=shown) {
        card(label="one") {
            ui.text(value="first")
        }
        card(label="two") {
            ui.button(text="hit", @click {
                hits = hits + 1
            })
            ui.text(value="{hits}")
        }
    }
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
