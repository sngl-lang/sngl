// built outside composition; the modifier reads LocalFlexShare where the node
// it is on is composed.
val snglFlexShare: (Float) -> Modifier = { w ->
    Modifier.composed { LocalFlexShare.current?.invoke(w) ?: Modifier.fillMaxSize() }
}
