import . "sngl:ui"
import app "sngl:app"

component Counter(label = "", start = 0, name = "") node {
    var count = start

    hbox {
        text(value=label + ": " + string(count))
        button(text="+", @click { count = count + 1 })
    }
}

component main node {
    Counter(label="Clicks")
}

app.window {
    main
}
