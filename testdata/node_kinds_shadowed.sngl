import . "sngl:ui"
import . "sngl:time"
import . "sngl:app"

// The built-in visual nodes are shadowable (design doc D3). A user component
// resolves before the #[builtin] declaration, so each of these instantiates as
// an ordinary node instance rather than as the compiler's own construct — no
// package timer is registered, no error boundary.
//
// `slot` is not in this family and is absent on purpose: it is a keyword in the
// declaration family (func, component, struct, enum, unit), not a #[builtin]
// node resolved by name, so there is nothing for a user declaration to shadow.
component timer(label string, slot _) {
    text(value=label)
}

component errorBoundary(label string, slot _) {
    text(value=label)
}

component main {
    timer(label="ordinary")
    errorBoundary(label="ordinary")
}
