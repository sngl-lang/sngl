import . "sngl:ui"
import . "sngl:time"

// The built-in visual nodes are shadowable (design doc D3). A user component
// resolves before the #[builtin] declaration, so each of these instantiates as
// an ordinary node instance rather than as the compiler's own construct — no
// package timer is registered, no error boundary.
//
// A slot is absent on purpose: it is a parameter of the component being
// checked, resolved before any component of that name, not a #[builtin] node —
// so there is nothing for a user declaration to shadow.
component timer(label string, children ...component) node {
    text(value=label)
}

component boundary(label string, children ...component) node {
    text(value=label)
}

component main node {
    timer(label="ordinary")
    boundary(label="ordinary")
}

window {
    main
}
