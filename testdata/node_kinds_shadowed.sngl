// The built-in visual nodes are shadowable (design doc D3). A user component
// resolves before the #[builtin] declaration, so each of these instantiates as
// an ordinary node instance rather than as the compiler's own construct — no
// package timer is registered, no slot projection, no error boundary.
//
// Shadowing `slot` is safe because platform-extension bodies, which reference
// bare `slot` heavily, are checked against the stdlib scope rather than the
// user root — so a user declaration cannot capture the name out from under the
// compiler's own source.
component timer(label string) list<component> {
    text(value=label)
}

component slot(label string) list<component> {
    text(value=label)
}

component errorBoundary(label string) list<component> {
    text(value=label)
}

component main {
    timer(label="ordinary")
    slot(label="ordinary")
    errorBoundary(label="ordinary")
}
