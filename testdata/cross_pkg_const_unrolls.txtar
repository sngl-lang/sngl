Cross-package const folding: a top-level const passed as a prop into a
component imported from another directory must let the receiving component's
`for` loop unroll at compile time. The rendered HTML must contain the literal
text values as static markup, not a runtime loop.

The archive's root files are the package and its subdirectories are importable
from it, so `import "widgets"` here resolves the way it would on disk -- the
harness hands the checker an fs.FS over the archive and nothing else changes.

deny out/none/html/index.html `for \(` -- unrolling happened at compile time, so no JS loop runtime leaks into the static markup

-- app.sngl --
import . "sngl:ui"
import "widgets"

output {
    none {
        html
    }
}

const items = ["a", "b"]

component main node {
    widgets.Row(entries=items)
}

window {
    main
}
-- widgets/row.sngl --
import . "sngl:ui"

component Row(entries list<string> = []) node {
    for var x = entries {
        text(value=x)
    }
}

window {
}
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

