An event payload read on gtk4's cgo path reads the widget the handler is on.

A toggle has no gtk4rt wrapper, so the page falls back to cgo, and a handler
reading `e.value` gets the entry's text through `C.gtk_editable_get_text`.
The substitution rewrote the handler's shared IR in place from both the
promoted method and the instance record's signal lambda, so the second
rendering found the first's wrapped-runtime getter already spliced in:
`cannot use m.box (*C.GtkEntry) as gtk4rt.Handle in EditableGetText`. And in
the record the entry is a local of its build function, where the getter spelled
it as a field (`c.__n7 undefined (type *RowInstance ...)`).

fyne rides along: its payload substitution shares the same helper.
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
        gtk4
    }
}

component row(label string) node {
    var got = ""

    hbox {
        input(@change(e) { got = label + " " + e.value })
        toggle(checked=got != "")
        text(value=got)
    }
}

component main node {
    var last = ""
    var on = false
    var rows = ["a", "b"]

    vbox {
        input #box(@change(e) { last = "got " + e.value })
        toggle(checked=on)
        text(value=last)
        for var r = rows {
            row(label=r)
        }
    }
}

func testBuilds(t Test, c main) {
    t.assert(c.last == "")
}

window {
    main
}
