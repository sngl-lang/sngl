)

// Model holds the state for this SNGL UI.
type Model struct {
	hits int

	activeWindow string
	windowABox   *fyne.Container
	windowBBox   *fyne.Container
	__n0         *widget.Label
	__n1         *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.hits = 0
	return m
}

func (m *Model) bump(n int) int {
	return (n + 1)
}

func (m *Model) __n2_click_handler() {
	m.hits = (m.hits + 1)
	m.__n0.SetText(("a " + fmt.Sprint(m.hits)))
	m.__n1.SetText(("b " + fmt.Sprint(m.hits)))
}

func (m *Model) Hits() int {
	return m.hits
}

func (m *Model) SetHits(v int) {
	m.hits = v
}

// BuildUI creates the widget tree. Call once.
func (m *Model) BuildUI() fyne.CanvasObject {
	if m.activeWindow == "" {
		m.activeWindow = "a"
	}
	m.windowABox = container.NewStack(m.buildWindowA())
	m.windowBBox = container.NewStack(m.buildWindowB())
	if m.activeWindow != "a" {
		m.windowABox.Hide()
	}
	if m.activeWindow != "b" {
		m.windowBBox.Hide()
	}
	var windowObjects []fyne.CanvasObject
	windowObjects = append(windowObjects, m.windowABox)
	windowObjects = append(windowObjects, m.windowBBox)
	return container.NewStack(windowObjects...)
}

func (m *Model) navigate(name string) {
	m.activeWindow = name
	m.windowABox.Hide()
	m.windowBBox.Hide()
	switch name {
	case "a":
		m.windowABox.Show()
	case "b":
		m.windowBBox.Show()
	}
}

func (m *Model) buildWindowA() fyne.CanvasObject {
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText(("a " + fmt.Sprint(m.hits)))
	__n2 := widget.NewButton("", nil)
	__n2.SetText("go")
	__n2.OnTapped = m.__n2_click_handler
	return container.NewVBox(m.__n0, __n2)
}

func (m *Model) buildWindowB() fyne.CanvasObject {
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText(("b " + fmt.Sprint(m.hits)))
	return m.__n1
}
