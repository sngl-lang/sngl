// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	hits      int
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.hits = 0
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) bump(n int) int {
	return (n + 1)
}

func (m *Model) __focusNext() {
	if __focusID == 0 {
		__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if __focusID == 0 {
		__focusID = 0
	}
}

func (m Model) Hits() int {
	return m.hits
}

func (m Model) SetHits(v int) Model {
	m.hits = v
	return m
}

type setHitsMsg struct{ value int }

func SetHitsCmd(v int) tea.Cmd {
	return func() tea.Msg { return setHitsMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setHitsMsg:
		m = m.SetHits(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.hits = (m.hits + 1)
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0 = lipgloss.NewStyle().Render(fmt.Sprint(("a " + fmt.Sprint(m.hits))))
	parts = append(parts, part0)
	var part1 string
	part1Focused := (__focusID == 0)
	part1Prefix := " "
	if part1Focused {
		part1Prefix = ">"
	}
	part1 = lipgloss.NewStyle().Render(part1Prefix + " " + fmt.Sprint("go"))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
