// A wildcard widens which prop names a component accepts; it does not stop
// them being checked. A name no wildcard covers is still unknown, and a value
// is still checked against the wildcard prop's declared type.

import . "sngl://std"
import . "sngl://platforms"

component attrs(
    #[wildcard("data[A-Za-z0-9]+")] data string = "",
) {
    text(value = data)
}

component styled(
    #[wildcard("theme[A-Za-z]+")] theme Style = {},
) {
    text(value = "x")
}

component twice(
    #[wildcard("ax+")] a string = "",
    #[wildcard("a+x")] b string = "",
) {
    text(value = a)
}

component badPattern(
    #[wildcard("data(")] c string = "", // ERROR(check) "#[wildcard(\"data(\")]"
) {
    text(value = c)
}

component doubled(
    #[wildcard("p.*")]
    #[wildcard("q.*")] d string = "", // ERROR(check) "already a wildcard"
) {
    text(value = d)
}

component main() {
    window {
        attrs(dateRole = "row") // ERROR(check) "unknown prop \"dateRole\" on component attrs"
        styled(themeMain = "big") // ERROR(check) "cannot use string as Style for prop \"themeMain\""
        twice(ax = "?") // ERROR(check) "matches both wildcard props"
    }
}
