// A struct spread supplies a generic component's props without any of them
// being written, so a type parameter is bound from the spread struct's field of
// that name. `...a` gives `on` the type of `a.on`, which is what types the
// `@mount(v)` payload -- read as a positional argument instead, the spread
// bound T to the struct and the handler was rejected.
import . "sngl:ui"

struct pageArgs {
    on int
}

component main {
    var page = 3
    var a = pageArgs{on=page}

    effect(...a, @mount(v) {
        page = v + 1
    })

    text(value="page=" + string(page))
}
