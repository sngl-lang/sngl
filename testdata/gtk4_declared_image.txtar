An image and its sources are gtk4rt's, no GIR class, and are built through
the protocol gtk4.sngl declares for them by hand: an Image's create is
gtk4rt.ImageFrameNew, a source goes in and out through gtk4rt.BoxAppend and
BoxRemove, its fit is written by gtk4rt.ImageFrameSetFit, and its click,
load and failure are connected by the #[gen.protocol(on)]s calling gtk4rt's
ImageFrameOn* rather than through the platform's connect, since GTK raises
no signal for any of them. A source of either kind is made by
gtk4rt.ImageSourceNew, and a URL's picture is handed over by
ImageSourceSetPicture. Each is a #[go.native], so the inline-cgo path the
drawing keeps the program on calls the gtk4rt functions a wrapped build does,
and the fit crosses as a Go string gtk4rt copies itself: no image op makes a
C string. The one C.CString left is the window title's.
deny out/go/gtk4/model.go `gtk4rt\.Connect\([^\n]*"(click|load|failed)"` -- an image's events are gtk4rt's, connected by its own on
-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"
import go "sngl:language/go"

output {
    go {
        gtk4
    }
}

var src = "a.png"
var shown = true
var clicks = 0
var why = ""

ui.window(title="t") {
    ui.image(
        fit = cover,
        @click {
            clicks += 1
        },
        @error(e) {
            why = e.message
        },
    ) {
        if shown {
            ui.file(src)
        }
    }
    ui.image {
        draw.image(width=10.0, height=10.0) {
            draw.line(x1=0.0, y1=0.0, x2=10.0, y2=10.0)
        }
    }
}
