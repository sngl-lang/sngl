import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

component exprs ui {
    var a = 10
    var b = 3
    var s = "hello world"
    text(value="{a}")
}

func testStringConcatenationWithVars(t Test, c exprs) {
    t.assert("val=" + string(c.a) == "val=10")
    t.assert(c.s + "!" == "hello world!")
}

func testNestedArithmetic(t Test, c exprs) {
    t.assert((c.a + c.b) * 2 == 26)
    t.assert(c.a * c.b + 1 == 31)
}

func testStringInterpolation(t Test, c exprs) {
    t.assert("a={c.a}" == "a=10")
    t.assert("{c.s} {c.a}" == "hello world 10")
}

func testEqualityOnDifferentTypes(t Test, c exprs) {
    t.assert(10 == 10)
    t.assert("x" == "x")
    t.assert(true == true)
    t.assert(10 != 20)
    t.assert("x" != "y")
}

app.window {
}
