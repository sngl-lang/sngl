component exprs {
    var a = 10
    var b = 3
    var s = "hello world"
    text(value="{a}")
}

test exprs "string concatenation with vars" {
    assert("val=" + string(a) == "val=10")
    assert(s + "!" == "hello world!")
}

test exprs "nested arithmetic" {
    assert((a + b) * 2 == 26)
    assert(a * b + 1 == 31)
}

test exprs "string interpolation" {
    assert("a={a}" == "a=10")
    assert("{s} {a}" == "hello world 10")
}

test exprs "equality on different types" {
    assert(10 == 10)
    assert("x" == "x")
    assert(true == true)
    assert(10 != 20)
    assert("x" != "y")
}
