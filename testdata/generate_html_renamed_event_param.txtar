`@input(myEvent)` names the event parameter, but JS emission canonicalizes it:
the handler comes out as `function(e)` and `myEvent.value` as `e.target.value`,
so the user-chosen name does not survive into the output at all. The assignment
is followed by inlined DOM patches for both nodes bound to `name` -- the input
it came from and the text beside it.

deny out/none/html/index.html `myEvent` -- the event parameter is renamed to `e` on the way out, so the source's spelling reaches nothing
-- app.sngl --
import . "sngl:ui"

output { none { html } }

component main node {
    var name = "Alice"
    input(value=name, @input(myEvent) { name = myEvent.value })
    text(value=name)
}

window {
    main
}
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<input id="__n0" data-sngl-id="__n0" placeholder="" type=""/>
<span id="__n1" data-sngl-id="__n1">
</span>

<script>
(() => {
  // sngl-entry.js
  var state = { name__inst0: "Alice" };
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  var __n1 = document.querySelector('[data-sngl-id="__n1"]');
  __n0.addEventListener("input", function(e) {
    state.name__inst0 = e.target.value;
    __n0.value = state.name__inst0;
    __n1.textContent = state.name__inst0;
  });
  function __sngl_init() {
    __n0.value = state.name__inst0;
    __n1.textContent = state.name__inst0;
  }
  __sngl_init();
})();
</script>
</body></html>
