// A window's `@key` hears each key pressed in it before anything in it does,
// and a handler that calls `stop` keeps the key from going further.

import . "sngl:test"
import ui "sngl:ui"

component app root {
    var typed = ""

    ui.window #main(title="Keys", @key(e, stop) {
        typed = typed + "[" + e.key + "]"
        if e.ctrl {
            stop()
        }
    }) {
        ui.text(value=typed)
    }
}

app()

func testAKeyReachesTheWindow(t Test, c app) {
    var stopped = false
    c.main.key(ui.KeyPress{key="7"}, func() { stopped = true })
    c.main.key(ui.KeyPress{key="Enter"}, func() { stopped = true })
    t.assert(c.typed == "[7][Enter]")
    t.assert(!stopped)
}

func testAHandlerStopsAKey(t Test, c app) {
    var stopped = false
    c.main.key(ui.KeyPress{key="s", ctrl=true}, func() { stopped = true })
    t.assert(c.typed == "[s]")
    t.assert(stopped)
}
