A package-level owned var of an imported package is released as the
program's own: on overwrite, wherever the assignment is written, and last of
all at teardown. OwnedState collected only the program's vars, so `reopen`
assigned over the value it held and nothing released it.

-- app.sngl --
import p "./p"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

ui.window {
    ui.button(text="reopen", @click {
        p.reopen(10)
    })
    ui.text(value="{p.current()}")
}
-- p/p.sngl --
import macro "sngl:macro"

#[macro.owned(close)]
struct file {
    fd int
}

func close(f file) {
}

func open(fd int) => file{fd=fd}

var cache = open(9)

func reopen(fd int) {
    cache = open(fd)
}

func current() => cache.fd
