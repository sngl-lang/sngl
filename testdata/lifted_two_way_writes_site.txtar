A two-way binding inside a block lifted into a component of its own writes
back what the site bound: the lift read `shape` as the component's prop
`__p0`, and renamed the ident the write-back shares with the binding, so
fyne wrote `__prop___p0 = __value` in the page.
-- app.sngl --
import test "sngl:test"
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
        gtk4
        bubbletea
    }
    kotlin {
        android
    }
}

component asked(:value string = "") ui.node {
    var shown = true

    if shown {
        ui.button #set(text=value, @click { value = "b" })
    }
}

component page ui.node {
    var on = true
    var shape = "a"

    if on {
        ui.vbox {
            ui.text #seen(shape)
            asked(:value=shape)
        }
    }
}

func testTheBindingWritesThePage(t test.Test, c page) {
    t.assert(c.shape == "a")
}

ui.window {
    page
}
