package main

import "testing"

func TestTheBindingWritesThePage(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.shape == "a")) { t.Errorf("assert failed: %s", "(c.shape == \"a\")") }
}

