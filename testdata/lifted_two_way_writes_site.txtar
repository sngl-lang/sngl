package main

import "testing"

func TestTheBindingWritesThePage(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.shape == "a")) { t.Errorf("assert failed: %s", "(c.shape == \"a\")") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
