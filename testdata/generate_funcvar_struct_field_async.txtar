A struct field of funcvar type initialized with an async candidate. The field
is a slot like any other, so it colours Async: the click handler calling
h.run() is emitted as an async wrapper and the field call is awaited.

-- app.sngl --
import . "sngl:ui"
import api "js:./api"
import app "sngl:app"

output {
    none {
        html
    }
}

struct Handler {
    run func() string
}

component main node {
    var h = Handler{run=api.fetchHello}
    button(text="Go", @click { h.run() })
    text(value="hi")
}

app.window {
    main
}
-- api/index.ts --
export async function fetchHello(): Promise<string> { return "hi"; }
