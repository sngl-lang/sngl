A var that only a call's own @error handler names is still state. catchAtCall
renders that handler at the call, so the shake has to reach it there; it walked
a call's function, receiver, callee and arguments and stopped, so `problem` was
shaken while the handler kept writing it. Go emitted `problem__inst0 = …`
against a Model with no such field, and the program did not compile.

Nothing in the view reads `problem` -- a test does, through the component --
which is what leaves the handler as the one thing naming it.

-- app.sngl --
import . "sngl:ui"

func requireAge(s string) int {
    if s.length == 0 {
        error.raise("an age is required", "validation")
    }
    return int(s)
}

component check node {
    var problem = "none"
    button(text="Check", @click {
        requireAge("", @error(e) {
            problem = "call: " + e.kind
        })
    })
}

window {
    check()
}

output {
    none {
        html
    }
    go {
        bubbletea
        fyne
    }
}
