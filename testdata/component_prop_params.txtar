A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_prop_params.sngl --
import . "sngl:ui"

component Counter(label = "", start = 0) node {
    var count = start

    hbox {
        text(value=label + ": " + string(count))
    }
}

component main node {
    Counter(label="Clicks")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
