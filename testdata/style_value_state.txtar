A whole `Style` held in state -- a var replaced or written a field at a time
by a handler, a ternary between two literals, an element of a list, and a var
read by each copy of a reactive loop -- handed to a node's `style`.

On the Go targets it did not compile: the `Style` a Model field, a ternary's
temp and the `__merge_Style` helper named was a library struct no backend
declared, since only a struct a signature names was promoted, and the helper
compared a `Measurement` and a `snglcolor.Color` field against `0`. Nothing
applied it either -- fyne and bubbletea dropped a style that was not a
literal, and html wrote `setAttribute("style", <object>)` in the handlers and
nothing on first render.

The library struct a var, a ternary or a list element is typed by is now
declared like a signature's, and the merge compares each field against its own
Go zero. Each target turns the value into its own style where the program
runs: fyne through `__styleTheme` into the node's theme override, bubbletea
through `__styleLipgloss` on every render, both reading a zero field as unset
as `__merge_Style` does, and html through `_snglStyleCSS` on first render and
after each write, where a field the object lacks is unset. A looped copy's
slot records its override, so a re-render removes what it added. gtk4 applies
no Style paint at all, literal or not, and only reads the ternary's temp.

deny out/none/html/index.html `setAttribute\("style", __merge` -- the style attribute is written as CSS text, never as the struct itself
deny * `!= 0 \{\n\t\tbase\.(Color|FontSize)` -- a struct-typed field is compared against its composite zero

-- style.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
}

ui.window {
    var s ui.Style = {color=#ff0000, fontSize=14px}
    var on = false
    var kept list<ui.Style> = [{background=#00ffff}]
    var rows = ["a"]

    ui.button(text="swap", @click {
        s = {color=#0000ff, fontSize=20px, fontWeight=bold}
        on = !on
    })
    ui.button(text="tint", @click {
        s.color = #00ff00
        rows = ["a", "b"]
    })
    ui.text(value="styled", style=s)
    ui.text(value="picked", style=on ? {color=#ff0000} : {color=#0000ff})
    ui.text(value="kept", style=kept[0])
    for var r = rows {
        ui.text(value=r, style=s)
    }
}
