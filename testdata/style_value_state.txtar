	m.__n2 = widget.NewButton("", nil)
	m.__n2.SetText("tint")
	m.__n2.OnTapped = m.__n2_click_handler
	m.__n0 = widget.NewLabel("")
	m.__n0__theme = container.NewThemeOverride(m.__n0, fynetheme.New(theme.DefaultTheme()))
	m.__n0.SetText("styled")
