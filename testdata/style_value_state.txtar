// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	s         Style
	on        bool
	kept      []Style
	rows      []string
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.s = Style{Color: snglcolor.Color{R: 255, G: 0, B: 0, A: 255}, FontSize: Measurement{Px: 14}}
	m.on = false
	m.kept = []Style{Style{Background: snglcolor.Color{R: 0, G: 255, B: 255, A: 255}}}
	m.rows = []string{"a"}
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 1
	} else {
		if m.__focusID == 1 {
			m.__focusID = 0
		}
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 1
	} else {
		if m.__focusID == 1 {
			m.__focusID = 0
		}
	}
}

func (m Model) S() Style {
	return m.s
}

func (m Model) SetS(v Style) Model {
	m.s = v
	return m
}

type setSMsg struct{ value Style }

func SetSCmd(v Style) tea.Cmd {
	return func() tea.Msg { return setSMsg{value: v} }
}

func (m Model) On() bool {
	return m.on
}

func (m Model) SetOn(v bool) Model {
	m.on = v
	return m
}

type setOnMsg struct{ value bool }

func SetOnCmd(v bool) tea.Cmd {
	return func() tea.Msg { return setOnMsg{value: v} }
}

func (m Model) Kept() []Style {
	return m.kept
}

func (m Model) SetKept(v []Style) Model {
	m.kept = v
	return m
}

type setKeptMsg struct{ value []Style }

func SetKeptCmd(v []Style) tea.Cmd {
	return func() tea.Msg { return setKeptMsg{value: v} }
}

func (m Model) Rows() []string {
	return m.rows
}

func (m Model) SetRows(v []string) Model {
	m.rows = v
	return m
}

type setRowsMsg struct{ value []string }

func SetRowsCmd(v []string) tea.Cmd {
	return func() tea.Msg { return setRowsMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setSMsg:
		m = m.SetS(msg.value)
	case setOnMsg:
		m = m.SetOn(msg.value)
	case setKeptMsg:
		m = m.SetKept(msg.value)
	case setRowsMsg:
		m = m.SetRows(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.s = Style{Color: snglcolor.Color{R: 0, G: 0, B: 255, A: 255}, FontSize: Measurement{Px: 20}, FontWeight: "bold"}
			m.on = !m.on
		case msg.Code == tea.KeyEnter && m.__focusID == 1:
			m.s.Color = snglcolor.Color{R: 0, G: 255, B: 0, A: 255}
			m.rows = []string{"a", "b"}
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = lipgloss.NewStyle().Render(part0Prefix + " " + fmt.Sprint("swap"))
	parts = append(parts, part0)
	var part1 string
	part1Focused := (m.__focusID == 1)
	part1Prefix := " "
	if part1Focused {
		part1Prefix = ">"
	}
	part1 = lipgloss.NewStyle().Render(part1Prefix + " " + fmt.Sprint("tint"))
	parts = append(parts, part1)
	var part2 string
	part2 = __styleLipgloss(__merge_Style(Style{}, m.s)).Render(fmt.Sprint("styled"))
	parts = append(parts, part2)
	var __lt0 Style
	if m.on {
		__lt0 = Style{Color: snglcolor.Color{R: 255, G: 0, B: 0, A: 255}}
	} else {
		__lt0 = Style{Color: snglcolor.Color{R: 0, G: 0, B: 255, A: 255}}
	}
	var part5 string
	part5 = __styleLipgloss(__merge_Style(Style{}, __lt0)).Render(fmt.Sprint("picked"))
	parts = append(parts, part5)
	var part6 string
	part6 = __styleLipgloss(__merge_Style(Style{}, m.kept[0])).Render(fmt.Sprint("kept"))
	parts = append(parts, part6)
	var part7 string
	var part7Items []string
	for _, r := range m.rows {
		_ = r
		var part7Item string
		part7Item = __styleLipgloss(__merge_Style(Style{}, m.s)).Render(fmt.Sprint(r))
		part7Items = append(part7Items, part7Item)
	}
	part7 = strings.Join(part7Items, "")
	if part7 != "" {
		parts = append(parts, part7)
	}
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
