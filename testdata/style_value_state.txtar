		contentParts = append(contentParts, contentPart_0)
		var contentPart_1 string
		contentPart_1Focused := (m.__focusID == 1)
		contentPart_1Prefix := " "
		if contentPart_1Focused {
			contentPart_1Prefix = ">"
		}
		contentPart_1 = lipgloss.NewStyle().Render(contentPart_1Prefix + " " + fmt.Sprint("tint"))
		contentParts = append(contentParts, contentPart_1)
		var contentPart_2 string
		contentPart_2 = __styleLipgloss(__merge_Style(Style{}, m.s)).Render(fmt.Sprint("styled"))
		contentParts = append(contentParts, contentPart_2)
		var __lt0 Style
		if m.on {
			__lt0 = Style{Color: snglcolor.Color{R: 255, G: 0, B: 0, A: 255}}
		} else {
			__lt0 = Style{Color: snglcolor.Color{R: 0, G: 0, B: 255, A: 255}}
		}
		var contentPart_5 string
		contentPart_5 = __styleLipgloss(__merge_Style(Style{}, __lt0)).Render(fmt.Sprint("picked"))
		contentParts = append(contentParts, contentPart_5)
		var contentPart_6 string
		contentPart_6 = __styleLipgloss(__merge_Style(Style{}, m.kept[0])).Render(fmt.Sprint("kept"))
		contentParts = append(contentParts, contentPart_6)
		var contentPart_7 string
		var contentPart_7Items []string
		for _, r := range m.rows {
			_ = r
			var contentPart_7Item string
			contentPart_7Item = __styleLipgloss(__merge_Style(Style{}, m.s)).Render(fmt.Sprint(r))
			contentPart_7Items = append(contentPart_7Items, contentPart_7Item)
		}
		contentPart_7 = tui.Column(0, contentPart_7Items...)
		if contentPart_7 != "" {
			contentParts = append(contentParts, contentPart_7)
		}
		content = tui.Column(0, contentParts...)
	}
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
