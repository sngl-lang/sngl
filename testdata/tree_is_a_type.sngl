// A family is a declared component, a member of `build.family`. A component
// says which family it belongs to by naming it in its return position, and a
// slot says which it accepts by naming it as the slot's type.
//
// Nothing is matched by name: a misspelled family is an unresolved name where
// it is written, and two packages each declaring a family of the same name
// declare two families.
//
// A family may be declared below its members: it is registered before them.

import . "sngl:ui"
import build "sngl:build"

// A container that is not itself a member: its rest slot names the family
// it hosts.
component document(children ...component block) node {}

// A member that hosts a different family — the rich-text case the mechanism
// was generalised for.
component para(children ...component inline) block {}

// A member with no slot hosts nothing.
component bold(weight int) inline {}

// A member whose slot names no family hosts its own, so this holds inlines.
component span(children ...component) inline {}

// `node` is a family like any other: naming it in a slot says the same thing as
// naming nothing there, because that is the family this component belongs to.
component plain(children ...component node) node {}

component block build.family

component inline build.family

component main node {
    document() {
        para() {
            bold(weight=700)
            span() {
                bold(weight=400)
            }
        }
    }
    plain() {
        text(value="anything goes here")
    }
}

window {
    main
}
