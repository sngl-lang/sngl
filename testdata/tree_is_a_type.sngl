// A tree is a declared type. `#[tree.kind]` marks a struct as naming one, a
// component says which it belongs to by naming that type in its return
// position, and a slot says which it accepts by naming it as the slot's type.
//
// Nothing is matched by name: a misspelled tree is an unresolved name where it
// is written, and two packages each declaring a tree of the same name declare
// two trees.

import . "sngl:ui"
import tr "sngl:tree"
import app "sngl:app"

#[tr.kind]
struct block {}

#[tr.kind]
struct inline {}

// A container that is not itself a member: its rest slot names the family
// it hosts.
component document(children ...component block) ui {}

// A member that hosts a different family — the rich-text case the mechanism
// was generalised for.
component para(children ...component inline) block {}

// A member with no slot hosts nothing.
component bold(weight int) inline {}

// A member whose slot names no family hosts its own, so this holds inlines.
component span(children ...component) inline {}

// `ui` is a family like any other: naming it in a slot says the same thing as
// naming nothing there, because that is the family this component belongs to.
component plain(children ...component ui) ui {}

component main ui {
    document() {
        para() {
            bold(weight=700)
            span() {
                bold(weight=400)
            }
        }
    }
    plain() {
        text(value="anything goes here")
    }
}

app.window {
    main
}
