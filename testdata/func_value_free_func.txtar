A free function held as a value is named the way a call to it is.

A top-level func that reads no state is emitted free on the Go targets, under
its exported name, and a call to it says so. Held as a value -- passed to a
component's func-typed prop and stored in a record, which is how a value hands
over the function that belongs to it -- it came out as a Model method value,
`m.encode`, beside a file declaring `func Encode`, and the program did not
compile.

deny out/go/fyne/model.go `m\.encode` -- encode is free, not a Model method
deny out/go/gtk4/model.go `m\.encode` -- likewise

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
}

struct Holder {
    f func(xs list<string>) string
}

func encode(xs list<string>) string {
    var s = ""
    for var x = xs {
        s = s + x
    }
    return s
}

component show(render func(xs list<string>) string) ui.node {
    var h = Holder{f=render}

    ui.text(value=h.f(["a"]))
}

ui.window {
    show(render=encode)
}
