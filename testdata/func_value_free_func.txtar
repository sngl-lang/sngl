A free function handed as a value is named the way a call to it is.

A top-level func that reads no state is emitted free on the Go targets, under
its exported name, and a call to it says so. Read as a value -- passed to a
component's func-typed prop, which the inliner substitutes into the call the
body makes -- it came out as a Model method value, `m.encode`, beside a file
declaring `func Encode`, and the program did not compile.

deny out/go/fyne/model.go `m\.encode` -- encode is free, not a Model method
deny out/go/gtk4/model.go `m\.encode` -- likewise

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
}

func encode(xs list<string>) string {
    var s = ""
    for var x = xs {
        s = s + x
    }
    return s
}

component show(render func(xs list<string>) string) ui.node {
    ui.text(value=render(["a"]))
}

ui.window {
    show(render=encode)
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	__n0 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

func Encode(xs []string) string {
	s := ""
	for _, x := range xs {
		s = (s + x)
	}
	return s
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText(Encode([]string{"a"}))
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
-- out/go/gtk4/callbacks.go --
