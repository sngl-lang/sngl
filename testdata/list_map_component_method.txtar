A component's method handed to a list method by name is called the way a
sibling call is. NoListLambdas called a named package function by name and
left anything else a callee expression, so a component method stayed an
Ident naming the declaration; once the component was spliced into its
caller that Ident named nothing the splice had renamed, and bubbletea
emitted `m.tag__inst0(…)` beside a free `Tag__inst0`, which does not
compile. `panel` is spliced into `app` here, which is what puts the method
through the inliner, and the test is there so that each target's output is
compiled. The interpreter's half is
cmd/sngl/testdata/list_map_component_method_runs.txt.

deny out/go/bubbletea/model.go `m\.tag__inst0` -- the clone is a free function, and is called as one

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

component panel node {
    var got = ""
    func tag(x int) => "<{x}>"
    button #run(text="run", @click {
        got = [4, 5].map(tag).join(",")
    })
    text(value=got)
}

component app node {
    var shown = true
    panel
}

func testBuilds(t Test, c app) {
    t.assert(c.shown)
}

window {
    app
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
