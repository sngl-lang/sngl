import . "sngl:ui"
import . "sngl:test"

// Props print in the order they were written, which is the order the checker
// recorded -- a positional arg is resolved to its name on the way in, so
// `text({}, "x")` and `text(style={}, value="x")` are one thing by here.
// Handlers print after them as bare `@name` markers: a snapshot records that a
// handler is attached, never what it would do.
component card {
    var label = "hi"

    vbox {
        text(value=label, selectable=true)
        text({}, "resolved from positional")
        button(text="click me", @click { label = "clicked" })
        hbox {
            text(value="nested")
        }
    }
}

func testWrittenOrder(t Test, c card) {
    t.snapshot("props")
}

func testReflectsCurrentState(t Test, c card) {
    c.label = "changed"
    t.snapshot("changed")
}
