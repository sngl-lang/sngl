A generic function or component reading and writing its own type parameter
as JSON is emitted at each type a call binds, since every language's codec
reads the type at the call: Go and Kotlin copy every generic anyway, and
JavaScript, which emits one generic function or component otherwise, copies
the ones a codec call reaches.

deny out/none/html/index.html `function (readOr|written|twice)\(` -- every generic a codec reaches is copied per type

-- app.sngl --
import json "sngl:json"
import test "sngl:test"
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
    kotlin {
        android
    }
}

enum Kind {
    #[json.identifier("hard-cover")]
    hardcover
    paperback
}

struct Book {
    id   int
    kind Kind
}

func written[T any](value T) => json.encode(value)

func twice[U any](value U) => written(value) + written(value)

func readOr[T any](text string, fallback T) => match var got = json.decode[T](text) {
    ok => got
    failed => fallback
}

component stored[T any](text string, :value T) ui.node {
    var last = ""
    effect(@mount { value = readOr(text, value) })
    effect(on=value, @update(v) { last = json.encode(v) })
    ui.text(value=last)
}

component shelf ui.node {
    var book = Book{id=0, kind=Kind.paperback}
    var count = 0
    stored(text=`{"id": 7, "kind": "hard-cover"}`, :value=book)
    stored(text=`3`, :value=count)
}

func testFunctions(t test.Test) {
    t.assert(written(Kind.hardcover) == `"hard-cover"`)
    t.assert(twice(Book{id=1, kind=Kind.paperback}) == `{"id":1,"kind":"paperback"}{"id":1,"kind":"paperback"}`)
    t.assert(readOr(`"x"`, 5) == 5)
    t.assert(readOr(`[1, 2]`, [0])[1] == 2)
}

func testSpliced(t test.Test, c shelf) {
    t.assert(c.book.id == 7)
    t.assert(c.book.kind == Kind.hardcover)
    t.assert(c.count == 3)
}

component toggled ui.node {
    var shown = true
    var n = 0
    if shown {
        stored(text=`4`, :value=n)
    }
}

func testUnderIf(t test.Test, c toggled) {
    t.assert(c.n == 4)
}

ui.window {
    shelf
    toggled
}
