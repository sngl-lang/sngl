	if !((Twice__Book(Book{Id: 1, Kind: "paperback"}) == "{\"id\":1,\"kind\":\"paperback\"}{\"id\":1,\"kind\":\"paperback\"}")) { t.Errorf("assert failed: %s", "(Twice__Book(Book{Id: 1, Kind: \"paperback\"}) == \"{\\\"id\\\":1,\\\"kind\\\":\\\"paperback\\\"}{\\\"id\\\":1,\\\"kind\\\":\\\"paperback\\\"}\")") }
	if !((ReadOr__int("\"x\"", 5) == 5)) { t.Errorf("assert failed: %s", "(ReadOr__int(\"\\\"x\\\"\", 5) == 5)") }
	if !((ReadOr__list_int("[1, 2]", []int{0})[1] == 2)) { t.Errorf("assert failed: %s", "(ReadOr__list_int(\"[1, 2]\", []int{0})[1] == 2)") }
}

func TestSpliced(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.book__inst0.Id == 7)) { t.Errorf("assert failed: %s", "(c.book__inst0.Id == 7)") }
	if !((c.book__inst0.Kind == "hardcover")) { t.Errorf("assert failed: %s", "(c.book__inst0.Kind == \"hardcover\")") }
	if !((c.count__inst0 == 3)) { t.Errorf("assert failed: %s", "(c.count__inst0 == 3)") }
}

func TestUnderIf(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.n__inst0 == 4)) { t.Errorf("assert failed: %s", "(c.n__inst0 == 4)") }
}


