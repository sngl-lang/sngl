Each window's `@error` is its own. Every target's window override wraps the
content in `boundary(@error(e) { error(e) })`, forwarding to the @error its
call site wrote, and that handler is the override body's code: substituted per
window as the content is. The inliner's clone copied a boundary's children and
shared its handler, so substituting the first window's @error wrote the one
handler every window ran -- a raise in "B" set `a`.

deny out/go/fyne/model.go `(?s)a caught.*a caught` -- B's raise runs B's handler, not A's
deny out/go/gtk4/model.go `(?s)a caught.*a caught` -- likewise
deny out/none/html/index.html `(?s)a caught.*a caught` -- likewise

-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
        gtk4
    }
}

var a = ""
var b = ""

ui.window(title="A", @error(e) { a = "a caught" }) {
    ui.button(text="boom a", @click { error.raise("x", "boom") })
    ui.text(value=a)
}

ui.window(title="B", @error(e) { b = "b caught" }) {
    ui.button(text="boom b", @click { error.raise("y", "boom") })
    ui.text(value=b)
}
