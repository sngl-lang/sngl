A call's own @error catches a raise that leaves the call: the handler runs with
the error, and execution carries on with the statement after the call. That is
what the interpreter does (dispatchRaise, on the CallStmt), and every compiled
target used to emit the call bare -- evalErrorAwareCall recognised a direct
error.raise and nothing else, so a raise inside a called function escaped the
handler written for it and reached the host uncaught.

Each target now runs the call under the host's own catch: a recover on the Go
targets, a try on JavaScript and Kotlin. Kotlin's raise throws SnglRaise, which
carries the error's kind; a RuntimeException carried only the message.

The tests click through a handler, a component func and a raise two calls down,
and one call that does not raise, whose handler must not run. They execute on
every Go target and on android; the html pages are run by
cmd/sngl/testdata/call_error_handler_runs.txt in a real Chromium, beside the
interpreter.

deny out/go/bubbletea/model.go `(?m)^\t+Check\(5\)\n\t+m\.after` -- a call with its own @error runs under a recover, never bare
deny out/none/html/index.html `(?m)^\s+check\(5\);\n\s+state\.after` -- nor bare on html, where it runs in a try

-- call_error_handler.sngl --
import . "sngl:ui"
import . "sngl:test"

func check(n int) {
    if n > 1 {
        error.raise("too big", "range")
    }
}

func scaled(n int) int {
    check(n)
    return n * 10
}

component main node {
    var caught = ""
    var after = ""

    func viaFunc() {
        check(5, @error(e) { caught = caught + "func:" + e.message + ";" })
        after = after + "f"
    }

    button #inHandler(text="Handler", @click {
        check(5, @error(e) { caught = caught + e.message + "/" + e.kind + ";" })
        after = after + "h"
    })
    button #inFunc(text="Func", @click { viaFunc() })
    button #deep(text="Deep", @click {
        scaled(7, @error(e) { caught = caught + "deep:" + e.message + ";" })
        after = after + "d"
    })
    button #fine(text="Fine", @click {
        check(1, @error(e) { caught = caught + "never;" })
        after = after + "ok"
    })
    text(value="{caught}|{after}")
}

func testHandlerCatches(t Test, c main) {
    c.inHandler.click()
    t.assert(c.caught == "too big/range;")
    t.assert(c.after == "h")
}

func testFuncCatches(t Test, c main) {
    c.inFunc.click()
    t.assert(c.caught == "func:too big;")
    t.assert(c.after == "f")
}

func testRaiseTwoCallsDown(t Test, c main) {
    c.deep.click()
    t.assert(c.caught == "deep:too big;")
    t.assert(c.after == "d")
}

func testNoRaiseSkipsHandler(t Test, c main) {
    c.fine.click()
    t.assert(c.caught == "")
    t.assert(c.after == "ok")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
        html
    }
    kotlin {
        android
    }
    none {
        html
    }
}
