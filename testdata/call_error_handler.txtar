package main

import "testing"

func TestHandlerCatches(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.inHandlerClick()
	if !((c.caught == "too big/range;")) { t.Errorf("assert failed: %s", "(c.caught == \"too big/range;\")") }
	if !((c.after == "h")) { t.Errorf("assert failed: %s", "(c.after == \"h\")") }
}

func TestFuncCatches(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.inFuncClick()
	if !((c.caught == "func:too big;")) { t.Errorf("assert failed: %s", "(c.caught == \"func:too big;\")") }
	if !((c.after == "f")) { t.Errorf("assert failed: %s", "(c.after == \"f\")") }
}

func TestRaiseTwoCallsDown(t *testing.T) {
	c := newTestComponent()
	_ = c
