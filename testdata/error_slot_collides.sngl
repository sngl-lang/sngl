// A slot shares its parameter list with the props and events. The three mean
// different things afterwards — a slot is read as a tag, a prop as a value, an
// event as a handler — but the reader of the declaration has only the one list
// to go on, so a name repeated across them is a collision here.

import . "sngl://std"

component collides(header string, slot header) { // ERROR(check) "name is already declared as a prop"
    vbox {
        text(value=header)
    }
}
