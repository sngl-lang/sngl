-- component_js_native.sngl --
// A js.native names the global it is, whether the SNGL name is the global's
// own or another, and a call reaches the real one: html only, since nothing
// else runs JavaScript.

import js "sngl:language/js"
import . "sngl:test"
import . "sngl:ui"

#[js.native("btoa")]
func btoa(s string) string

#[js.native("btoa")]
func base64(s string) string

component main node {
    var same = "unset"
    var renamed = "unset"
    button #go(text="go", @click {
        same = btoa("hi")
        renamed = base64("hi")
    })
    text(value="same={same} renamed={renamed}")
}

func testCallsTheRealGlobal(t Test, c main) {
    c.go.click()
    t.assert(c.same == "aGk=")
    t.assert(c.renamed == "aGk=")
}

window {
    main
}

output {
    none {
        html
    }
}
