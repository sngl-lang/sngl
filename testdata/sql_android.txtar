package test.sngl.app

// The runtime behind sngl:json and sngl:http, written beside MainScreen.kt
// when a program reaches either. The compiler hands each call a Codec it
// wrote from the SNGL type -- how to build and read each struct, the name each
// field and enum member travels under -- and the rules and the words are
// pkg/go/sngljson's: a key the type does not name is ignored, a missing key
// fails unless its field is an option, a value of the wrong kind fails naming
// where it was, writing leaves an absent option's key out, and a map's keys are
// visited in order so a failure names the same one everywhere.
//
// A codec is typed by the value it reads and writes, SnglCodec<T>, and built
// from the factories below, so the code the compiler writes holds no cast: a
// struct is built from SnglCodecArgs.at, whose type each constructor
// parameter gives. The JSON in between is untyped, and the one cast back to T
// is here, in at and Decoded.value, where the codec is what makes it sound.

import java.net.HttpURLConnection
import java.net.SocketTimeoutException
import java.net.URL
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.channels.Channel
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext
import org.json.JSONArray
import org.json.JSONObject
import org.json.JSONTokener

class SnglCodec<T>(val kind: Int) {
    var elem: SnglCodec<*>? = null
    var fields: List<SnglCodecField> = emptyList()
    var make: ((SnglCodecArgs) -> T)? = null
    var read: ((T) -> List<Any?>)? = null
    var wires: List<String> = emptyList()
    var values: List<Any> = emptyList()

    // An integer's range, and how it is made from a Long: every width and
    // sign of SNGL integer is one kind. Each is written by its toString,
    // which is its decimal value -- a ULong past Long.MAX_VALUE included.
    var lo: Long = Long.MIN_VALUE
    var hi: Long = Long.MAX_VALUE
    var fromLong: (Long) -> Any = { it }
    var fromDouble: (Double) -> Any = { it }

    class Decoded<T>(private val v: Any?, val error: String?) {
        @Suppress("UNCHECKED_CAST")
        val value: T get() = v as T
    }

    class Response(
        val status: Int,
        val headers: Map<String, String>,
        val body: String,
        val failed: Boolean,
        val timeout: Boolean,
        val message: String,
        val cancelled: Boolean = false,
    )

    private class Fail(message: String) : Exception(message)

    companion object {
        const val BOOL = 0
        const val INT = 1
        const val FLOAT = 3
        const val STRING = 4
        const val DATE = 5
        const val DATETIME = 6
        const val OPTION = 7
        const val LIST = 8
        const val MAP = 9
        const val ENUM = 10
        const val STRUCT = 11

        private val dateRE = Regex("""^\d{4}-\d{2}-\d{2}$""")
        private val datetimeRE = Regex("""^\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2}(\.\d+)?([Zz]|[+-]\d{2}:\d{2})$""")

        fun bool(): SnglCodec<Boolean> = SnglCodec(BOOL)
        fun string(): SnglCodec<String> = SnglCodec(STRING)
        fun date(): SnglCodec<String> = SnglCodec(DATE)
        fun datetime(): SnglCodec<String> = SnglCodec(DATETIME)
        fun float(): SnglCodec<Double> = SnglCodec(FLOAT)
        fun float32(): SnglCodec<Float> = SnglCodec<Float>(FLOAT).also { it.fromDouble = { d -> d.toFloat() } }

        private fun <T : Any> integer(lo: Long, hi: Long, from: (Long) -> T): SnglCodec<T> =
            SnglCodec<T>(INT).also {
                it.lo = lo
                it.hi = hi
                it.fromLong = from
            }

        fun int(): SnglCodec<Int> = integer(Int.MIN_VALUE.toLong(), Int.MAX_VALUE.toLong()) { it.toInt() }
        fun long(): SnglCodec<Long> = integer(Long.MIN_VALUE, Long.MAX_VALUE) { it }
        fun short(): SnglCodec<Short> = integer(Short.MIN_VALUE.toLong(), Short.MAX_VALUE.toLong()) { it.toShort() }
        fun byte(): SnglCodec<Byte> = integer(Byte.MIN_VALUE.toLong(), Byte.MAX_VALUE.toLong()) { it.toByte() }
        fun ubyte(): SnglCodec<UByte> = integer(0, 0xff) { it.toUByte() }
        fun ushort(): SnglCodec<UShort> = integer(0, 0xffff) { it.toUShort() }
        fun uint(): SnglCodec<UInt> = integer(0, 0xffffffffL) { it.toUInt() }
        // Read through a Long, so a ULong past Long.MAX_VALUE is refused on
        // the way in; it is still written exactly.
        fun ulong(): SnglCodec<ULong> = integer(0, Long.MAX_VALUE) { it.toULong() }

        fun <E> option(e: SnglCodec<E>): SnglCodec<E?> = SnglCodec<E?>(OPTION).also { it.elem = e }
        fun <E> list(e: SnglCodec<E>): SnglCodec<List<E>> = SnglCodec<List<E>>(LIST).also { it.elem = e }
        fun <E> map(e: SnglCodec<E>): SnglCodec<Map<String, E>> = SnglCodec<Map<String, E>>(MAP).also { it.elem = e }

        private val scope = kotlinx.coroutines.MainScope()

        // How many bodies start began are still running: a test waits for none
        // before it reads what they wrote.
        val active = java.util.concurrent.atomic.AtomicInteger()

        // Starts a body that waits -- a handler, an effect's mount -- on the
        // thread the target draws on, which a wait leaves and comes back to.
        fun start(block: suspend () -> Unit) {
            active.incrementAndGet()
            scope.launch {
                try {
                    block()
                } finally {
                    active.decrementAndGet()
                }
            }
        }

        fun <T> decode(text: String, c: SnglCodec<T>): Decoded<T> {
            val v: Any? = try {
                val t = JSONTokener(text)
                val parsed = t.nextValue()
                if (t.nextClean() != '\u0000') throw Fail("not JSON")
                parsed
            } catch (e: Exception) {
                return Decoded(null, "not JSON")
            }
            return try {
                Decoded(dec(if (v == JSONObject.NULL) null else v, c, "$"), null)
            } catch (e: Fail) {
                Decoded(null, e.message)
            }
        }

        private fun describe(c: SnglCodec<*>): String = when (c.kind) {
            BOOL -> "a boolean"
            INT -> "an integer"
            FLOAT -> "a number"
            STRING -> "a string"
            DATE -> "a date"
            DATETIME -> "a datetime"
            OPTION -> describe(c.elem!!)
            LIST -> "an array"
            ENUM -> "one of " + c.wires.joinToString(", ")
            else -> "an object"
        }

        private fun integral(v: Any?): Long? {
            if (v !is Number) return null
            val d = v.toDouble()
            if (v is Double || v is Float) {
                if (d.isNaN() || d.isInfinite() || d != Math.floor(d) || Math.abs(d) > 9.223372036854776E18) return null
                return d.toLong()
            }
            return v.toLong()
        }

        private fun dec(v: Any?, c: SnglCodec<*>, path: String): Any? {
            fun want(): Fail = Fail(path + ": want " + describe(c))
            when (c.kind) {
                OPTION -> return if (v == null) null else dec(v, c.elem!!, path)
                BOOL -> return v as? Boolean ?: throw want()
                INT -> {
                    val n = integral(v) ?: throw want()
                    if (n < c.lo || n > c.hi) throw want()
                    return c.fromLong(n)
                }
                FLOAT -> return c.fromDouble((v as? Number)?.toDouble() ?: throw want())
                STRING -> return v as? String ?: throw want()
                DATE -> {
                    val s = v as? String ?: throw want()
                    if (!dateRE.matches(s)) throw want()
                    try { java.time.LocalDate.parse(s) } catch (e: Exception) { throw want() }
                    return s
                }
                DATETIME -> {
                    val s = v as? String ?: throw want()
                    if (!datetimeRE.matches(s)) throw want()
                    try { java.time.OffsetDateTime.parse(s.uppercase()) } catch (e: Exception) { throw want() }
                    return s
                }
                ENUM -> {
                    val i = if (v is String) c.wires.indexOf(v) else -1
                    if (i < 0) throw want()
                    return c.values[i]
                }
                LIST -> {
                    val a = v as? JSONArray ?: throw want()
                    val out = ArrayList<Any?>(a.length())
                    for (i in 0 until a.length()) out.add(dec(unwrap(a.get(i)), c.elem!!, "$path[$i]"))
                    return out
                }
                MAP -> {
                    val o = v as? JSONObject ?: throw want()
                    val out = LinkedHashMap<String, Any?>()
                    for (k in o.keys().asSequence().toList().sorted()) out[k] = dec(unwrap(o.get(k)), c.elem!!, "$path.$k")
                    return out
                }
                STRUCT -> {
                    val o = v as? JSONObject ?: throw want()
                    val args = ArrayList<Any?>(c.fields.size)
                    for (f in c.fields) {
                        val present = o.has(f.wire)
                        if (!present && f.codec.kind != OPTION) throw Fail("$path.${f.wire}: missing")
                        args.add(dec(if (present) unwrap(o.get(f.wire)) else null, f.codec, "$path.${f.wire}"))
                    }
                    return c.make!!(SnglCodecArgs(args))
                }
            }
            throw want()
        }

        private fun unwrap(v: Any?): Any? = if (v == JSONObject.NULL) null else v

        fun <T> encode(v: T, c: SnglCodec<T>): String = StringBuilder().also { enc(it, v, c) }.toString()

        // The fields of v, a value c reads.
        @Suppress("UNCHECKED_CAST")
        private fun readFields(c: SnglCodec<*>, v: Any?): List<Any?> = (c as SnglCodec<Any?>).read!!(v)

        private fun enc(b: StringBuilder, v: Any?, c: SnglCodec<*>) {
            when (c.kind) {
                OPTION -> if (v == null) b.append("null") else enc(b, v, c.elem!!)
                BOOL -> b.append(if (v == true) "true" else "false")
                INT -> b.append(v.toString())
                FLOAT -> b.append(number((v as Number).toDouble()))
                STRING, DATE, DATETIME -> quote(b, v as String)
                ENUM -> quote(b, enumWire(c, v))
                LIST -> {
                    b.append('[')
                    (v as List<*>).forEachIndexed { i, x ->
                        if (i > 0) b.append(',')
                        enc(b, x, c.elem!!)
                    }
                    b.append(']')
                }
                MAP -> {
                    val m = v as Map<*, *>
                    b.append('{')
                    m.keys.map { it as String }.sorted().forEachIndexed { i, k ->
                        if (i > 0) b.append(',')
                        quote(b, k)
                        b.append(':')
                        enc(b, m[k], c.elem!!)
                    }
                    b.append('}')
                }
                STRUCT -> {
                    val vals = readFields(c, v)
                    b.append('{')
                    var first = true
                    c.fields.forEachIndexed { i, f ->
                        val x = vals[i]
                        if (f.codec.kind == OPTION && x == null) return@forEachIndexed
                        if (!first) b.append(',')
                        first = false
                        quote(b, f.wire)
                        b.append(':')
                        enc(b, x, f.codec)
                    }
                    b.append('}')
                }
            }
        }

        private fun enumWire(c: SnglCodec<*>, v: Any?): String {
            val i = c.values.indexOf(v)
            return if (i < 0) v.toString() else c.wires[i]
        }

        // A float as JSON and JavaScript write one: the shortest decimal that
        // reads back as the same value, with no fraction for a whole number and
        // an exponent from 1e21 up and below 1e-6.
        fun number(d: Double): String {
            if (d.isNaN() || d.isInfinite()) return "null"
            if (d == 0.0) return "0"
            val bd = java.math.BigDecimal(d.toString()).stripTrailingZeros()
            val a = Math.abs(d)
            if (a >= 1e-6 && a < 1e21) return bd.toPlainString()
            val digits = bd.unscaledValue().abs().toString()
            val exp = digits.length - 1 - bd.scale()
            val mant = if (digits.length > 1) digits[0] + "." + digits.substring(1) else digits
            return (if (d < 0) "-" else "") + mant + "e" + (if (exp >= 0) "+" else "-") + Math.abs(exp)
        }

        private fun quote(b: StringBuilder, s: String) {
            b.append('"')
            for (ch in s) {
                when (ch) {
                    '"' -> b.append("\\\"")
                    '\\' -> b.append("\\\\")
                    '\b' -> b.append("\\b")
                    '\u000C' -> b.append("\\f")
                    '\n' -> b.append("\\n")
                    '\r' -> b.append("\\r")
                    '\t' -> b.append("\\t")
                    else -> if (ch < ' ') b.append(String.format("\\u%04x", ch.code)) else b.append(ch)
                }
            }
            b.append('"')
        }

        fun escape(s: String): String {
            val hex = "0123456789ABCDEF"
            val b = StringBuilder()
            for (byte in s.toByteArray(Charsets.UTF_8)) {
                val c = byte.toInt() and 0xff
                val ch = c.toChar()
                if (ch in 'A'..'Z' || ch in 'a'..'z' || ch in '0'..'9' || ch == '-' || ch == '.' || ch == '_' || ch == '~') {
                    b.append(ch)
                } else {
                    b.append('%').append(hex[c shr 4]).append(hex[c and 15])
                }
            }
            return b.toString()
        }

        private fun queryValues(v: Any?, c: SnglCodec<*>): List<String> = when (c.kind) {
            OPTION -> if (v == null) emptyList() else queryValues(v, c.elem!!)
            LIST -> (v as List<*>).flatMap { queryValues(it, c.elem!!) }
            BOOL -> listOf(if (v == true) "true" else "false")
            INT -> listOf(v.toString())
            FLOAT -> listOf(number((v as Number).toDouble()))
            ENUM -> listOf(enumWire(c, v))
            else -> listOf(v.toString())
        }

        fun <T> withQuery(url: String, q: T, c: SnglCodec<T>): String {
            val vals = readFields(c, q)
            val parts = ArrayList<String>()
            c.fields.forEachIndexed { i, f ->
                for (s in queryValues(vals[i], f.codec)) parts.add(escape(f.wire) + "=" + escape(s))
            }
            if (parts.isEmpty()) return url
            return url + (if (url.contains('?')) "&" else "?") + parts.joinToString("&")
        }

        // sngl:async's lifetimes, by number: each live one holds how to stop
        // the requests made under it, and 0 -- forever -- is never held.
        private val lives = java.util.concurrent.ConcurrentHashMap<Int, java.util.concurrent.CopyOnWriteArrayList<() -> Unit>>()
        private val nextLife = java.util.concurrent.atomic.AtomicInteger()

        fun begin(): Int {
            val id = nextLife.incrementAndGet()
            lives[id] = java.util.concurrent.CopyOnWriteArrayList()
            return id
        }

        fun end(id: Int) {
            lives.remove(id)?.forEach { it() }
        }

        fun ended(id: Int): Boolean = id != 0 && !lives.containsKey(id)

        // sngl:async's queues, by number, as lifetimes are: each is held until
        // its reader reads it closed and empty, and a number not held is one
        // that is.
        private val queues = java.util.concurrent.ConcurrentHashMap<Int, Channel<Any?>>()
        private val nextQueue = java.util.concurrent.atomic.AtomicInteger()

        fun queueOpen(): Int {
            val id = nextQueue.incrementAndGet()
            queues[id] = Channel(Channel.UNLIMITED)
            return id
        }

        fun queueSend(id: Int, item: Any?) {
            val q = queues[id]
            if (q == null || q.trySend(item).isClosed) throw IllegalStateException("send to a closed queue")
        }

        fun queueClose(id: Int) {
            queues[id]?.close()
        }

        suspend fun queueReceive(id: Int): Any? {
            val q = queues[id] ?: return null
            val r = q.receiveCatching()
            if (r.isClosed) queues.remove(id)
            return r.getOrNull()
        }

        private fun cancelled(): Response = Response(0, emptyMap(), "", true, false, "cancelled", true)

        // Sends one request on a thread of its own and waits for its answer
        // there: a failure only where no response arrived, or `life` ended
        // first, which disconnects it.
        suspend fun send(method: String, url: String, headers: Map<String, String>, body: String?, life: Int): Response {
            if (ended(life)) return cancelled()
            return withContext(Dispatchers.IO) {
                val conn = try {
                    URL(url).openConnection() as HttpURLConnection
                } catch (e: Exception) {
                    return@withContext Response(0, emptyMap(), "", true, false, e.toString())
                }
                val abort: () -> Unit = { conn.disconnect() }
                lives[life]?.add(abort)
                try {
                    conn.requestMethod = method.uppercase()
                    for (k in headers.keys.sorted()) conn.setRequestProperty(k, headers[k])
                    if (body != null) {
                        conn.doOutput = true
                        conn.outputStream.use { it.write(body.toByteArray(Charsets.UTF_8)) }
                    }
                    val status = conn.responseCode
                    val stream = if (status >= 400) conn.errorStream else conn.inputStream
                    val text = stream?.use { it.readBytes().toString(Charsets.UTF_8) } ?: ""
                    val hs = LinkedHashMap<String, String>()
                    for ((k, vs) in conn.headerFields) {
                        if (k != null) hs[k.lowercase()] = vs.joinToString(", ")
                    }
                    conn.disconnect()
                    // A response that arrived is the answer, whenever the
                    // lifetime ended: a failure is only where none did.
                    Response(status, hs, text, false, false, "")
                } catch (e: SocketTimeoutException) {
                    if (ended(life)) cancelled() else Response(0, emptyMap(), "", true, true, e.toString())
                } catch (e: Exception) {
                    if (ended(life)) cancelled() else Response(0, emptyMap(), "", true, false, e.toString())
                } finally {
                    lives[life]?.remove(abort)
                }
            }
        }
    }
}

class SnglCodecField(val wire: String, val codec: SnglCodec<*>)

// The fields of a struct being decoded, in its codec's order. at gives each
// the type of the constructor parameter it is passed to.
class SnglCodecArgs(private val values: List<Any?>) {
    @Suppress("UNCHECKED_CAST")
    fun <F> at(i: Int): F = values[i] as F
}
