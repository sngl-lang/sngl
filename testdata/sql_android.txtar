A sql: import on android runs each statement through SnglSql, over the
platform's own SQLiteDatabase: arguments bound by type through a cursor
factory, and the rows written as JSON for SnglCodec to decode. MainActivity
hands it the context its database files live under.

deny out/kotlin/android/SnglSql.kt `java\.sql|jdbc` -- the platform's own SQLite, no driver

-- app.sngl --
import books "sql:./db/query.sql"
import ui "sngl:ui"

output {
    kotlin {
        android
    }
}

component main ui.node {
    var count int64 = 0
    var title = "-"
    var found option[list[books.FindRow]] = null
    books.find(pattern="%a%", :value=found)
    ui.button(text="Add", @click {
        match var id = books.addCall(title="Tehanu", pages=252) {
            ok { count = id }
            failed { title = id.message }
        }
    })
    ui.button(text="Count", @click {
        match var n = books.countCall() {
            ok { count = n.or(0) }
            failed { count = -1 }
        }
    })
    ui.text(value="{count} {title}")
}

ui.window {
    main
}
-- db/schema.sql --
CREATE TABLE books (
  id    INTEGER PRIMARY KEY,
  title TEXT NOT NULL,
  pages INTEGER
);
-- db/query.sql --
-- sngl:schema schema.sql

-- name: Add :execlastid
INSERT INTO books (title, pages) VALUES (?, ?);

-- name: Count :one
SELECT count(*) FROM books;

-- name: Find :many
SELECT id, title FROM books WHERE title LIKE sqlc.arg(pattern);
