// SKIP(codegen) "names sngl:platform/none, which a per-platform harness does not register; the interpreter runs it"

import "sngl:platform/none"
import ui "sngl:ui"
import "sngl:test"

// A test raises an event as the target says it is raised: an override of the
// event names the component it belongs to, the target and the event's
// parameters, and its body reads the target's override of the component --
// its props and the nodes it named. A test's `c.d.change(3)` runs it.
component dial(:value int, @change(to int)) ui.node

component dial[none.platform](value, @change) {
    ui.button #up(text="{value}", @click {
        value += 1
        change(value)
    })
}

func dial.change[none.platform](to) {
    value = to
    change(to)
}

// A generic component's event is overridden on the receiver written with its
// parameters, `pick[T]`.
component pick[T any](:value T, @change(to T)) ui.node

component pick[none.platform](value, @change) {
    ui.vbox {}
}

func pick[T].change[none.platform](to) {
    value = to
    change(to)
}

component main ui.node {
    var n = 0
    var seen list[int] = []
    var word = "a"
    var words list[string] = []

    dial #d(:value=n, @change(v) { seen.push(v) })
    pick #p(:value=word, @change(w) { words.push(w) })
}

func testATriggerRaisesTheEventThroughItsOverride(t test.Test, c main) {
    c.d.change(3)
    t.assert(c.n == 3)
    t.assert(c.seen.length() == 1 && c.seen[0] == 3)
}

func testAGenericComponentsTriggerTakesItsType(t test.Test, c main) {
    c.p.change("b")
    t.assert(c.word == "b")
    t.assert(c.words.length() == 1 && c.words[0] == "b")
}

ui.window {
    main
}
