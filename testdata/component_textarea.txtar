// Code generated by sngl (bubbletea) from component_textarea.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbles/v2/textarea"
	"charm.land/bubbletea/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/tui"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	text      string
	__focusID int

	widget0 textarea.Model

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.text = ""
	m.__focusID = 0
	m.widget0 = textarea.New()
	m.widget0.Focus()
	m.resizeWidgets()
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
	m.resizeWidgets()
}

// resizeWidgets sizes each bubbles widget to the current terminal extent.
func (m *Model) resizeWidgets() {
	m.widget0.SetWidth(tui.WidgetWidth(m.width))
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Text() string {
	return m.text
}

func (m Model) SetText(v string) Model {
	m.text = v
	return m
}

type setTextMsg struct{ value string }

func SetTextCmd(v string) tea.Cmd {
	return func() tea.Msg { return setTextMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setTextMsg:
		m = m.SetText(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
		m.resizeWidgets()
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
			if m.__focusID == 0 {
				m.widget0.Focus()
			} else {
				m.widget0.Blur()
			}
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
			if m.__focusID == 0 {
				m.widget0.Focus()
			} else {
				m.widget0.Blur()
			}
		}
	}
	if m.__focusID == 0 {
		m.widget0, cmd = m.widget0.Update(msg)
		cmds = append(cmds, cmd)
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = m.widget0.View()
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestTextareaValueMutates(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.text == "")) { t.Errorf("assert failed: %s", "(c.text == \"\")") }
	c.text = "hello"
	if !((c.text == "hello")) { t.Errorf("assert failed: %s", "(c.text == \"hello\")") }
	c.text = (c.text + " world")
	if !((c.text == "hello world")) { t.Errorf("assert failed: %s", "(c.text == \"hello world\")") }
}


func newTestComponent() Model { return New() }
