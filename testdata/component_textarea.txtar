A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_textarea.sngl --
import . "sngl:ui"
import . "sngl:test"

// textarea: state-binding fixture — mutating the bound `value`
// var propagates to the textarea editor.
component main node {
    var text = ""
    textarea(:value=text, placeholder="Notes", rows=4)
}

func testTextareaValueMutates(t Test, c main) {
    t.assert(c.text == "")
    c.text = "hello"
    t.assert(c.text == "hello")
    c.text = c.text + " world"
    t.assert(c.text == "hello world")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
