package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	text string

	__n0 *widget.Entry
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.text = ""
	return m
}

func (m *Model) __n0_input_handler(v string) {
	if v != m.text {
		m.text = v
		m.__n0.SetText(m.text)
	}
}

func (m *Model) __n0_change_handler(v string) {
	m.text = v
	m.__n0.SetText(m.text)
}

func (m *Model) Text() string {
	return m.text
}

func (m *Model) SetText(v string) {
	m.text = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = widget.NewMultiLineEntry()
	m.__n0.SetText(m.text)
	m.__n0.SetPlaceHolder("Notes")
	m.__n0.SetMinRowsVisible(4)
	m.__n0.OnChanged = m.__n0_input_handler
	m.__n0.OnSubmitted = m.__n0_change_handler
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
