	m.__effect0_live = m.__effect0_desired
}

func (m *Model) __effects0_settle() {
	if !m.__effects0_torn {
		if m.__effects0_settling {
			m.__effects0_pending = true
		} else {
			m.__effects0_settling = true
			m.__effects0_pending = true
			m.__effects0_steps = 0
