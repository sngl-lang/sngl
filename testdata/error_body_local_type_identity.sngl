import . "sngl:ui"

struct Local {
    a int
}

func takesFileScoped(v Local) => v.a

// Type identity is per-declaration: this Local shadows the file-scope one and
// is a second, incompatible type rather than another name for it. Declaring it
// is not an error -- passHoistBodyTypes renames it after the body it was
// written in, so the host gets a name for each of the two types -- and passing
// one where the other is wanted still is.
func inner() int {
    struct Local {
        a int
    }

    return takesFileScoped(Local{a=1}) // ERROR(check) "cannot pass Local as Local"
}

component main node {
    text(value="${inner()}")
}

window {
    main
}
