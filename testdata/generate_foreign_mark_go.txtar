	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

type Entry struct {
	Title string
}

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	*modelState
}

// modelState is what every copy of a Model shares.
type modelState struct {
	e__inst0       Entry
	visible__inst0 bool

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{&modelState{}}
	m.e__inst0 = Entry{Title: "hello"}
	m.visible__inst0 = true
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) E__inst0() Entry {
	return m.e__inst0
}

func (m Model) SetE__inst0(v Entry) Model {
	m.e__inst0 = v
	return m
}

type setE__inst0Msg struct{ value Entry }

func SetE__inst0Cmd(v Entry) tea.Cmd {
	return func() tea.Msg { return setE__inst0Msg{value: v} }
}

func (m Model) Visible__inst0() bool {
	return m.visible__inst0
}

func (m Model) SetVisible__inst0(v bool) Model {
	m.visible__inst0 = v
	return m
}

type setVisible__inst0Msg struct{ value bool }

func SetVisible__inst0Cmd(v bool) tea.Cmd {
	return func() tea.Msg { return setVisible__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setE__inst0Msg:
		m = m.SetE__inst0(msg.value)
	case setVisible__inst0Msg:
		m = m.SetVisible__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			if m.visible__inst0 {
				m.visible__inst0 = false
			}
			if !(m.visible__inst0) {
				return m, tea.Quit
			}
			return m, nil
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	if m.visible__inst0 {
		content = lipgloss.NewStyle().Render(fmt.Sprint(m.e__inst0.Title))
	}
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
