A mark names a declaration the program still declares itself, so a backend
that emits that declaration keeps spelling it its own way. Go emits the
struct type under its SNGL name, declared and used: honouring the mark's name
here would leave two names for one type — `api.Item` used, `Entry` declared —
and no import of the package the mark named, which nothing resolved.

deny out/go/bubbletea/model.go `api\.Item` -- the mark's name never reaches the output; the emitted type is spelled Entry everywhere
deny out/go/bubbletea/model.go `example.com/api` -- the mark resolves no import, because the declaration it marks is the program's own

-- app.sngl --
import . "sngl:ui"
import . "sngl:macro"
import app "sngl:app"

output {
    go {
        bubbletea
    }
}

#[foreign("go:example.com/api", "api.Item")]
struct Entry {
    title string
}

component main ui {
    var e = Entry{title="hello"}
    text(value=e.title)
}

app.window {
    main
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
)

type Entry struct {
	Title string
}

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	e Entry

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.e = Entry{Title: "hello"}
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) E() Entry {
	return m.e
}

func (m Model) SetE(v Entry) Model {
	m.e = v
	return m
}

type setEMsg struct{ value Entry }

func SetECmd(v Entry) tea.Cmd {
	return func() tea.Msg { return setEMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setEMsg:
		m = m.SetE(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(m.e.Title))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
