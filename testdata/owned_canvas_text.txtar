gtk4's canvasText hands cairo the font family and the text as the `c.str`s
CMarshal converts them to, and ReleaseTemps gives each back (#110). The family
is the literal `"serif"` once the override is spliced, so it is made once, as
a Model field New sets, and freed in the teardown. The text changes with `n`,
so each frame binds it to a local, draws with it, and frees it before the next
statement: an explicit call, never a `defer`, which would hold every frame's
string until the draw routine returned and is not something C has.

deny out/go/gtk4/model.go `(?s)func \(m \*Model\) _canvasDraw0\([^}]*defer` -- a draw routine frees each string after the call that read it
deny out/go/gtk4/model.go `_canvasDraw0[^}]*C\.CString\("serif"\)` -- a constant string is made once, not per frame
-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"
import go "sngl:language/go"

output {
    go {
        gtk4
    }
}

var n = 0

ui.window(title="t") {
    draw.canvas(width=200px, height=40px) {
        draw.canvasText(x=4.0, y=20.0, content="count: {n}", style=draw.Style{fontFamily="serif"})
    }
    ui.button(text="more", @click {
        n = n + 1
    })
}
