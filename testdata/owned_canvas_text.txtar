gtk4's canvasText hands cairo the font family and the text as Go strings,
through `cgo.SnglCairoFont` and `cgo.CairoShowText`, whose generated wrappers
make each C string and free it right after the call that read it (#110 was
the program converting and releasing them itself). The family is the literal
`"serif"` once the override is spliced; the text changes with `n`, so each
frame builds it again. Nothing is held by a `defer` until the draw routine
returns, which is not something C has.

deny out/go/gtk4/main.go `(?s)func \(m \*Model\) _canvasDraw0\([^}]*defer` -- a C string is freed after the call that read it, never deferred to the routine's return
deny out/go/gtk4/main.go `_canvasDraw0[^}]*C\.CString\("serif"\)` -- the program makes no C string of its own; the wrapper does
-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"
import go "sngl:language/go"

output {
    go {
        gtk4
    }
}

var n = 0

ui.window(title="t") {
    draw.canvas(width=200px, height=40px) {
        draw.canvasText(x=4.0, y=20.0, content="count: {n}", style=draw.Style{fontFamily="serif"})
    }
    ui.button(text="more", @click {
        n = n + 1
    })
}
-- out/go/gtk4/main.go --
