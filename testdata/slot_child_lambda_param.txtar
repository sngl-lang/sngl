A lambda's parameter, in a node a loop makes a runtime instance, stays the
lambda's own rather than becoming a prop of the instance.

lowerSlotChildInstances lifts every free value a looped subtree reads into a
prop, and treated as bound only the handlers' parameters and the view's own
variables. A lambda in a prop's value -- fyne's select override writes
`options.map(func(o) => o.label)`, and a program can write one too -- had its
parameter lifted, so the site handed the instance an `o` it never declared and
the Go did not compile.

deny * `Set__p\d+\(o\)` -- the lambda's parameter is not a prop
deny * `Set__p\d+\(n\)` -- the lambda's parameter is not a prop
-- app.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
    }
}

component Pick(:pick string) ui.node {
    ui.vbox {
        ui.select(:value=pick) {
            ui.choice(label="a", value="a")
        }
        ui.text(value=string([1, 2].map(func(n int) => n * 2).length()))
    }
}

var pick = "a"

ui.window {
    for var i = [1] {
        Pick(:pick=pick)
    }
}
