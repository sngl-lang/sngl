A function that reaches a context read only through a function it names as a
value still reads the context, and is not folded before passContext has made
the value a parameter. readsContext followed Call.Func alone, so `label`,
which hands `show` to map, looked context-free to the optimizer: it was
interpreted at build time against the default, and `label(2)` under
`depth(5)` came out as the literal "1:2" on every compiled target.

deny out/go/bubbletea/model.go `"1:2"` -- the call is not folded against the default

-- ctx.sngl --
import . "sngl:ui"
import . "sngl:test"

context #depth(1)

func show(x int) => "{depth}:{x}"

func label(n int) => [n].map(show)[0]

component panel node {
    var got = ""
    depth(5) {
        button #run(text="run", @click {
            got = label(2)
        })
    }
    text(value=got)
}

func testFuncValueReadsProvider(t Test, c panel) {
    c.run.click()
    t.assert(c.got == "5:2")
}

window {
    panel
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
