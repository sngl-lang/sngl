package main

import (
	"fmt"
	"testing"
)

func TestAlias(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(c.kPresent()) { t.Errorf("assert failed: %s", "c.kPresent()") }
	if c.kPresent() {
		c.kClick()
	}
	if !((c.hits == 1)) { t.Errorf("assert failed: %s", "(c.hits == 1)") }
	if !((("n" + fmt.Sprint(c.hits)) == "n1")) { t.Errorf("assert failed: %s", "((\"n\" + fmt.Sprint(c.hits)) == \"n1\")") }
	c.hitClick()
	if !((c.hits__inst0 == 1)) { t.Errorf("assert failed: %s", "(c.hits__inst0 == 1)") }
	if !((c.hits__inst0 == 1)) { t.Errorf("assert failed: %s", "(c.hits__inst0 == 1)") }
	c.tsClick()
	if !(!c.kPresent()) { t.Errorf("assert failed: %s", "!c.kPresent()") }
}

func TestHelpers(t *testing.T) {
	c := newTestComponent()
	_ = c
	if c.kPresent() {
		c.kClick()
	}
	if !((c.hits == 1)) { t.Errorf("assert failed: %s", "(c.hits == 1)") }
	if c.kPresent() {
		c.kClick()
	}
	if c.kPresent() {
		c.kClick()
	}
	if !((c.hits == 3)) { t.Errorf("assert failed: %s", "(c.hits == 3)") }
	if !(c.kPresent()) { t.Errorf("assert failed: %s", "c.kPresent()") }
	if !((("n" + fmt.Sprint(c.hits)) == "n3")) { t.Errorf("assert failed: %s", "((\"n\" + fmt.Sprint(c.hits)) == \"n3\")") }
	var i__local0 int = 0
	for (i__local0 < 2) {
		c.hitClick()
		i__local0 = (i__local0 + 1)
	}
	if !((c.hits__inst0 == 2)) { t.Errorf("assert failed: %s", "(c.hits__inst0 == 2)") }
	c.tsClick()
	if !(!c.kPresent()) { t.Errorf("assert failed: %s", "!c.kPresent()") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
