A test reaches its instance through a local holding it (`held`, `b`) and
through a function it hands the instance to (`clickK`, `hitBadge`, `shownK`),
and every target answers as the interpreter does: each such reach is the
test's own `c.…` by the time a test emitter reads it, the helper inlined into
the test (internal/lower/test_instance.go).

cmd/sngl/testdata/test_instance_reach_runs.txt runs it on all six.

deny out/go/bubbletea/model_test.go `held|\bb\.` -- no local holds the instance once the test reaches it
deny out/go/bubbletea/model.go `func ClickK|func HitBadge` -- a helper the test hands its instance to is inlined, not emitted
deny out/kotlin/android/app/src/test/kotlin/test/sngl/app/MainScreenTest.kt `held` -- no local holds the instance once the test reaches it
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component badge(label string) node {
    var hits = 0
    button #hit(text="{label}{hits}", @click { hits = hits + 1 })
}

component main node {
    var shown = true
    var hits = 0
    vbox {
        button #ts(text="s", @click { shown = !shown })
        text #label(value="n{hits}")
        badge #bd(label="b")
        if shown {
            button #k(text="k{hits}", @click { hits = hits + 1 })
        }
    }
}

func clickK(c main) {
    if c.k != null {
        c.k.click()
    }
}

func clickTwice(c main) {
    clickK(c)
    clickK(c)
}

func hitBadge(b badge, times int) {
    var i = 0
    for i < times {
        b.hit.click()
        i = i + 1
    }
}

func shownK(c main) => c.k != null

func labelOf(c main) => c.label.value

func testAlias(t Test, c main) {
    var held = c
    t.assert(held.k != null)
    if held.k != null {
        held.k.click()
    }
    t.assert(held.hits == 1)
    t.assert(held.label.value == "n1")
    var b = held.bd
    b.hit.click()
    t.assert(b.hits == 1)
    t.assert(held.bd.hits == 1)
    held.ts.click()
    t.assert(held.k == null)
}

func testHelpers(t Test, c main) {
    clickK(c)
    t.assert(c.hits == 1)
    clickTwice(c)
    t.assert(c.hits == 3)
    t.assert(shownK(c))
    t.assert(labelOf(c) == "n3")
    hitBadge(c.bd, 2)
    t.assert(c.bd.hits == 2)
    c.ts.click()
    t.assert(!shownK(c))
}

window {
    main
}
