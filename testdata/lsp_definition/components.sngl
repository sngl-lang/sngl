import ui "sngl:ui"

component Counter(label string, :count int = 0, @bumped(n int)) ui.node {
    func bump() {
        count += 1
        bumped(count)
    }

    ui.button #inc(text=label, @click { bump() })
}

ui.window #main(title="t") {
    var total = 0
    Counter(label="a", :count=total, @bumped(n) {})
}

