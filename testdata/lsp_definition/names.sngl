import math "sngl:math"

struct Point {
    x, y int

    func sum() => x + y
}

enum Shade {
    light
    dark
}

const limit = 3

func area(p Point, scale int = 1) int {
    var total = p.x * p.y
    for var i, q = [p] {
        total += q.sum() + i
    }
    return total * scale + int(math.pi)
}

func shaded() => Shade.dark

func use() => area(Point{x=1, y=2}, scale=limit)

