An effect keyed on a prop of a component built at run time reports a change of
the prop. The setter the prop is given is the only write it gets, and the
effect lowering ran while the prop was a parameter nothing wrote. So the setter
marks the report written and settles, as passEffect does after a write to a
var. A prop's value is the only sign it was written, as on the interpreter, so
setting it to what it already holds reports nothing. Before this, fyne's
setter settled with nothing marked and html's did not settle at all. The
`@update` never ran, and `seen` stayed 0.

deny out/go/fyne/model.go `func \(c \*ChildInstance\) SetN\(__v int\) \{\n\tc\.__prop_n = __v` -- the setter marks the report before it writes

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component child(n int) ui.node {
    var seen = 0

    effect(
        on = n,
        @update(v) {
            seen = v
        },
    )
    ui.text(value="{seen}")
}

var shown = true
var n = 1

ui.window(title="t") {
    if shown {
        child(n=n)
    }
    ui.button(text="+", @click {
        n += 1
    })
}
