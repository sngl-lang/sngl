// SKIP(codegen) "names sngl:platform/html, which a per-platform harness does not register"
// A helper in a program's override of a library component may not take the
// name of a method the program adds to that component: the addition would
// answer every call the helper's body makes.
import . "sngl:ui"
import "sngl:platform/html"

func avatar.shout(a avatar) => "TOP"

component avatar[html.platform](initials) {
    func shout() => "{initials}!" // ERROR(check) "is declared in component avatar and again in its override"
    text(value=shout())
}

window(title="t") {
    avatar(initials="AB")
}
