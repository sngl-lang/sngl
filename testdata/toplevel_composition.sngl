// The idiomatic shape: the window composes, components hold behaviour. A
// component instantiated with no block parses as a call statement rather than
// a visual node, so `counter()` here is an *ast.CallStmt -- the same window
// body either way.

import . "sngl:ui"
import app "sngl:app"

app.window {
    counter()
}

component counter ui {
    var n = 0

    vbox {
        text(value="{n}")
        button #inc(text="+", @click { n = n + 1 })
    }
}
