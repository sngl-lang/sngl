// SKIP(codegen) "a compiled target answers sngl:ui/nav in C2's later commits"
// A family value is one record of the props the family declares, whatever
// member it holds: a select reaches only those, nothing turns it back into a
// member, and so `go`, which takes a page, refuses it.

import nav "sngl:ui/nav"
import ui "sngl:ui"

struct Pkg {
    name string
}

func asPage(n nav.navigator) nav.page<Pkg> {
    return n // ERROR(check) "cannot return navigator as page<Pkg>"
}

component site ui.node {
    nav.stack #pages {
        nav.page #pkg(href=`/p/{name}`, title="Package", params=Pkg{}) {
            ui.text(value="pkg")
        }
    }
    ui.text(value=pages.current.params.name)                    // ERROR(check) "navigator is a family, and a value of one reaches only the props its members share: it declares no \"params\""
    ui.button(text="Again", @click { pages.go(pages.current) }) // ERROR(check) "cannot pass navigator as page<T>"
}
