A for-else in a view is answered by passViewForElse, which finds the view
bodies to rewrite through blocks.go's collector. That collector walked a slot
insertion's fallback and not the populations of its entries, so a for-else
written in an entry's population reached html and gtk4 with the else gone:
the loop rendered and "nothing here" never did. bubbletea answers a for-else
itself, which is why it alone kept it.

-- app.sngl --
import . "sngl:ui"

component each(item component(content component(x int) node) node) node {
    var xs list[int] = []

    vbox {
        item() {
            component content(x) {
                for var i = xs {
                    text(value="{i}")
                } else {
                    text(value="nothing here")
                }
            }
        }
    }
}

window {
    each {
        component item(content) {
            content(1)
        }
    }
}

output {
    none {
        html
    }
    go {
        gtk4
        bubbletea
    }
}
