                    val o = v as? JSONObject ?: throw want()
                    val out = LinkedHashMap<String, Any?>()
                    for (k in o.keys().asSequence().toList().sorted()) out[k] = dec(unwrap(o.get(k)), c.elem!!, "$path.$k")
