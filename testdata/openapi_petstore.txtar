An `openapi:` import resolves through the library's own plugin,
`sngl:x/scheme/openapi`, whose handler hands the spec to `openapi.generate`,
which reads it and writes the package in Go -- a declaration per
schema, a `…Call` function per operation and a component over `async.query`
per GET, and `server`, the context the spec's first server defaults. The spec
is a small petstore: 3.1 null unions in both spellings (`type: [T, 'null']`
and 3.0's `nullable`), a `oneOf` of a `$ref` and null, an `allOf` of one
`$ref` beside `readOnly`, a paged list, a field named `type`, snake_case keys
and operation ids written in camelCase, and a map of any value, which is left
out and said.

The program uses each: a component keyed on two parameters, which is an
anonymous struct, one keyed on its one, a function from a handler, and
`server` provided around a subtree.

written openapi:./petstore.yml
-- app.sngl --
import async "sngl:async"
import ui "sngl:ui"
import pets "openapi:./petstore.yml"

output {
    none {
        html
    }
    go {
        fyne
        gtk4
    }
    kotlin {
        android
    }
}

// A page of names, a page further each time More is pressed.
component names ui.node {
    var offset = 0
    var page option[pets.PaginatedPetSummaryList] = null
    pets.petList(limit=20, offset=offset, :value=page)
    if page != null {
        for var p = page.results {
            ui.text(value=p.name)
        }
    }
    ui.button(text="More", @click { offset += 20 })
}

// One pet, asked again whenever name changes.
component detail(name string) ui.node {
    var pet option[pets.PetDetail] = null
    var loading = false
    var failure option[async.Failure] = null
    pets.petRetrieve(id=name, :value=pet, :pending=loading, :failure=failure)
    if loading {
        ui.spinner()
    }
    if failure != null {
        ui.text(value="Could not load {name}: {failure.message}")
    }
    if pet != null {
        ui.text(value="#{pet.id} {pet.name}")
        for var t = pet.tags {
            ui.badge(value=t.type.name)
        }
    }
}

// The breed, asked from a handler rather than a component.
component breed(name string) ui.node {
    var from = "-"
    ui.button(text="Bred from", @click {
        match var r = pets.petBreedRetrieveCall(id=name) {
            ok { from = r.parentBreed != null ? r.parentBreed.name : "nothing" }
            failed { from = r.message }
        }
    })
    ui.text(value=from)
}

ui.window(title="Petstore") {
    names
    pets.server("https://mirror.example") {
        detail(name="rex")
        breed(name="beagle")
    }
}
-- petstore.yml --
openapi: 3.1.0
info:
  title: Petstore
  version: 1.0.0
servers:
- url: https://petstore.example
paths:
  /api/v1/pets/:
    get:
      operationId: pet_list
      summary: List pets
      parameters:
      - name: limit
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      - name: offset
        required: false
        in: query
        description: The initial index from which to return the results.
        schema:
          type: integer
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedPetSummaryList'
          description: ''
  /api/v1/pets/{id}/:
    get:
      operationId: pet_retrieve
      summary: Get pet
      parameters:
      - in: path
        name: id
        schema:
          type: string
        description: This parameter can be a string or an integer.
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PetDetail'
          description: ''
  /api/v1/pet-breeds/{id}/:
    get:
      operationId: pet_breed_retrieve
      summary: Get pet breed
      parameters:
      - in: path
        name: id
        schema:
          type: string
        required: true
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PetBreedDetail'
          description: ''
components:
  schemas:
    PaginatedPetSummaryList:
      type: object
      required:
      - count
      - next
      - previous
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
          format: uri
        previous:
          type: string
          nullable: true
          format: uri
        results:
          type: array
          items:
            $ref: '#/components/schemas/PetSummary'
    PetSummary:
      type: object
      properties:
        name:
          type: string
          maxLength: 200
        url:
          type: string
          format: uri
          readOnly: true
      required:
      - name
      - url
    PetDetail:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 200
        adoption_fee:
          type:
          - integer
          - 'null'
        age:
          type:
          - integer
          - 'null'
        is_available:
          type: boolean
        breed:
          $ref: '#/components/schemas/PetBreedSummary'
        photos:
          allOf:
          - $ref: '#/components/schemas/PetPhotos'
          readOnly: true
        measurements:
          type: array
          items:
            $ref: '#/components/schemas/PetMeasurement'
          readOnly: true
        tags:
          type: array
          items:
            $ref: '#/components/schemas/PetTag'
          readOnly: true
      required:
      - id
      - name
      - breed
      - photos
      - measurements
      - tags
    PetPhotos:
      type: object
      properties:
        thumbnail_url:
          type:
          - string
          - 'null'
      required:
      - thumbnail_url
    PetMeasurement:
      type: object
      properties:
        base_value:
          type: integer
        margin:
          type: integer
        measure:
          $ref: '#/components/schemas/MeasureSummary'
      required:
      - base_value
      - margin
      - measure
    MeasureSummary:
      type: object
      properties:
        name:
          type: string
        url:
          type: string
          format: uri
      required:
      - name
      - url
    PetTag:
      type: object
      properties:
        slot:
          type: integer
        type:
          $ref: '#/components/schemas/TagSummary'
      required:
      - slot
      - type
    TagSummary:
      type: object
      properties:
        name:
          type: string
        url:
          type: string
          format: uri
      required:
      - name
      - url
    PetBreedSummary:
      type: object
      properties:
        name:
          type: string
        url:
          type: string
          format: uri
      required:
      - name
      - url
    PetBreedDetail:
      type: object
      properties:
        id:
          type: integer
        name:
          type: string
        parent_breed:
          oneOf:
          - $ref: '#/components/schemas/PetBreedSummary'
          - type: 'null'
        breed_lineage:
          type: object
          additionalProperties: {}
      required:
      - id
      - name
      - parent_breed
