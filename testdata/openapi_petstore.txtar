                LIST -> {
                    val a = v as? JSONArray ?: throw want()
                    val out = ArrayList<Any?>(a.length())
                    for (i in 0 until a.length()) out.add(dec(unwrap(a.get(i)), c.elem!!, "$path[$i]"))
                    return out
                }
