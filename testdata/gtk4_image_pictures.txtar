A picture on gtk4 is an owned derived value of its source: `ui.file` and
`ui.remote` derive a `Picture` from the URL, made once per URL and released
when it changes or the source unmounts, and hand it to the GtkPicture and to
the drawing that paints it. Before, `canvasImage` handed the URL to the paint
on every frame, which decoded it once but downloaded and scaled the texture
per frame, and nothing the IR could see held the picture.

deny out/go/gtk4/model.go `CairoPaintURL\(` -- a drawing paints the picture its source holds
deny out/go/gtk4/model.go `ImageSourceSetURL\(` -- a source shows the picture, not a URL it fetches itself

-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"

output {
    go {
        gtk4
    }
}

component page ui.node {
    var src = "a.png"
    var more = ["b.png", "c.png"]

    ui.vbox {
        ui.image {
            ui.file(src)
        }
        for var u = more {
            ui.image {
                ui.remote(u)
            }
        }
        draw.canvas(width=200px, height=100px) {
            draw.canvasImage(x=0.0, y=0.0, w=100.0, h=100.0) {
                ui.file(src)
            }
            for var u = more {
                draw.canvasImage(x=100.0, y=0.0, w=50.0, h=50.0) {
                    ui.remote(u)
                }
            }
        }
        ui.button(text="next", @click {
            src = "b.png"
            more = ["d.png"]
        })
    }
}

ui.window(title="t") {
    page
}
