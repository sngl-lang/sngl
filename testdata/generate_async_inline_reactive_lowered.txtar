
An async call inside a visual-node prop expression is an inline reactive
context, so it is hoisted into a synthetic __hoist_N computed and then lowered
by NoAsyncReactive into the settled-state field plus async kicker pattern: the
field __async___hoist_0, and $compute___hoist_0 awaiting the original
fetchHello call, fired at startup to populate it.
-- app.sngl --
import . "sngl:ui"
import api "js:./api"

output {
    none {
        html
    }
}

component main node {
    text(value="got " + api.fetchHello("world"))
}

window {
    main
}
-- api/index.ts --
export async function fetchHello(name: string): Promise<string> { return "hi " + name; }
