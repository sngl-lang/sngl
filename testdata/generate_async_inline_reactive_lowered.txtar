  }

  // sngl-entry.js
  var state = { __async___hoist_0: "" };
  function __hoist_0() {
    return state.__async___hoist_0;
  }
  async function $compute___hoist_0() {
    state.__async___hoist_0 = "got " + await fetchHello("world");
