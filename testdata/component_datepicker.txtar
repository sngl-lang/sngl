A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_datepicker.sngl --
import . "sngl:ui"
import . "sngl:time"
import . "sngl:test"

// datepicker: state-binding fixture — mutating the bound `value`
// (date) propagates to the picker.
component main node {
    var d date
    datepicker(value=d, placeholder="Pick a date")
}

func testDatepickerValueMutates(t Test, c main) {
    var fresh date
    c.d = fresh
    t.assert(true)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
