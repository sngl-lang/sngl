	gtk4rt.WindowSetDefaultSize(win, 480, 640)
	gtk4rt.WindowSetChild(win, m.__root)
	return win
}

// calChange fires the "day-selected" signal on the #cal widget; for tests.
func (m *Model) calChange(v *time.Time) {
	gtk4rt.CalendarSelectDate(m.cal, v)
	gtk4rt.Emit(m.cal, "day-selected")
}
