A type declared in a platform override body reaches that platform's output.

An override body is collected on its own: pass1 only ever sees the parenless
stub, so `collectExtensionDecls` is what puts its struct, enum and unit
declarations on `ir.Component.BodyDecls` before `checkComponentBody` runs.
Without it the declaration was dropped and the literal typed `dyn`, which the
html output hid completely -- JS declares no types, so nothing was missing from
it and the page worked. This golden is the assertion that survives that: the
state field, its initializer and the read all name the declaration.

It registers them in the same walk that resolves a var annotation, which is the
other half (#204): a body-local type had to be reachable from a literal alone,
and a bare unit literal is not one -- `3tk` resolves against the type its
position expects, so `var elapsed tick = 3tk` was the only spelling and it was
the one that did not resolve.

The `.sngl` fixture of the same name carries the checker-level assertion and a
`SKIP(codegen)`, because a per-platform harness registers only its own platform
and cannot resolve `sngl:platform/html`. A golden names its targets itself, so
it is where the generated output belongs.

deny out/none/html/index.html `>base<` -- the override replaces the declaration's own body; both rendering would mean the specialization never happened

-- app.sngl --
import ui "sngl:ui"
import "sngl:platform/html"

output {
    none {
        html
    }
}

component thing ui.node {
    ui.text(value="base")
}

component thing[html.platform] {
    struct Row {
        a int
    }
    enum Phase {
        start
        done
    }
    unit tick { tk, kt = 10tk }

    var r = Row{a=1}
    var r2 Row = Row{a=2}
    var p Phase = Phase.done
    var elapsed tick = 3tk

    ui.text(value="${r.a}${r2.a}${p}${elapsed}")
}

component main ui.node {
    thing()
}

ui.window {
    main
}
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<span id="__n0" data-sngl-id="__n0">
</span>

<script>
(() => {
  // sngl-entry.js
  var state = { r__inst0: null, r2__inst0: null, p__inst0: null, elapsed__inst0: 3 };
  state.r__inst0 = { a: 1 };
  state.r2__inst0 = { a: 2 };
  state.p__inst0 = "done";
  function Row(a) {
    return { a };
  }
  function String(v) {
    return "" + v;
  }
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  function __sngl_init() {
    __n0.textContent = "$" + String(state.r__inst0.a) + "$" + String(state.r2__inst0.a) + "$" + String(state.p__inst0) + "$" + String(state.elapsed__inst0);
  }
  __sngl_init();
})();
</script>
</body></html>
