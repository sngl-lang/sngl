An instance's `__root` is the box a slot at the top of its body renders into,
and the constructor made one for every instance whether or not the body had
such a slot. A body whose top is one node binds that node as the Root, so the
box was never parented, never sunk and never unreferenced: one GtkBox leaked
per instance built, which the pokedex built on every navigation (the ASan check
in design/ownership.md). The box is made only where a render in the body names
it; `panel` has a top-level `for`, so its constructor keeps it.

deny out/go/gtk4/model.go `func newBadgeInstance\([^}]*(gtk_box_new|BoxNew)` -- a body whose top is one node makes no root box
-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
    }
}

component badge(name string) ui.node {
    var label = name

    ui.text(label)
}

component panel(items list[string]) ui.node {
    var seen = 0

    for var i = items {
        ui.text("{i} {seen}")
    }
}

var names = ["a", "b"]
var panels = [["x"], ["y", "z"]]

ui.window(title="t") {
    ui.vbox {
        for var n = names {
            badge(name=n)
        }
        for var p = panels {
            panel(items=p)
        }
        ui.button(text="flip", @click {
            panels = [["z"]]
            names = names.length() == 2 ? ["c"] : ["a", "b"]
        })
    }
}
