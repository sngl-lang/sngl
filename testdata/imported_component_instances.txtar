Two instances of one stateful component from an imported package each get
state of their own, the way two instances of a component the program declares
do.

The inliner substituted only components the package itself declares, a stdlib
component with a body, and a platform override. An imported one was left
standing as a node, so each backend met it as a live instance it had not
elected: on html both instances shared one node id, only the second was
filled in, and each read its `start` prop before the binding was declared
(`state.n_1 = start_1;` above `var start_1 = 1;`). The same program with
`counter` declared locally was correct, because it is inlined with its state
renamed per instance -- which is what an imported one gets now.

deny out/none/html/index.html `state\.\w+ = start` -- a prop is substituted where the instance is written, not read before it is bound
deny out/none/html/index.html `__n0" data-sngl-id="__n0">\s*</span>\s*<span id="__n0"` -- two instances are two nodes

-- app.sngl --
import ui "sngl:ui"
import lib "./lib"

output {
    none {
        html
    }
    go {
        bubbletea
    }
    kotlin {
        android
    }
}

ui.window {
    ui.vbox {
        lib.counter(start=1)
        lib.counter(start=10)
    }
}
-- lib/lib.sngl --
import ui "sngl:ui"

component counter(start int) ui.node {
    var n = start

    ui.hbox {
        ui.text(value="n is {n}")
        ui.button(text="add", @click {
            n = n + 1
        })
    }
}
