A palette that changes while the program runs redraws the code it colors.

The provider's value reads state, so every token's color is a run-time read,
and moving the state has to reach the words. On gtk4 that is the label's
markup assembled again: a span's color is a piece of the markup expression
(`gtk4rt.Foreground`) rather than a literal folded into it, and the handler
that moves the palette sets the whole label from the same expression. html
writes `style.color` from an updater, fyne calls the span's `SetColor`, and
bubbletea and android re-render from state, each falling back to the color
the token's kind would have had where the palette leaves one unset.

deny * `__ctx_palette` -- the provider's value is read in place, not copied once into a hidden field

-- main.sngl --
import ui "sngl:ui"
import markup "sngl:ui/markup"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

ui.window #home(title="t") {
    var pal = markup.lightPalette

    ui.vbox {
        ui.button(text="theme", @click { pal = markup.darkPalette })
        markup.palette(pal) {
            markup.richText {
                markup.monospace {
                    markup.token(kind=markup.Token.keyword) {
                        markup.text("func")
                    }
                }
            }
        }
    }
}
