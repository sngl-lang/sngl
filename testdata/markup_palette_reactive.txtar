fun tokenColor(p: Palette, kind: SnglToken): Color {
    if ((kind == SnglToken.KEYWORD)) {
    	return p.keyword
    }
    if ((kind == SnglToken.TYPE)) {
    	return p.type
    }
    if ((kind == SnglToken.FUNCTION)) {
    	return p.function
    }
    if ((kind == SnglToken.VARIABLE)) {
    	return p.variable
    }
    if ((kind == SnglToken.CONSTANT)) {
    	return p.constant
    }
    if ((kind == SnglToken.STRING)) {
    	return p.string
    }
    if ((kind == SnglToken.NUMBER)) {
    	return p.number
    }
    if ((kind == SnglToken.COMMENT)) {
    	return p.comment
    }
    if ((kind == SnglToken.OPERATOR)) {
    	return p.operator
    }
    if ((kind == SnglToken.PUNCTUATION)) {
    	return p.punctuation
    }
    return p.plain
}
