fun tokenColor(p: Palette, kind: Token): Color {
    if ((kind == Token.KEYWORD)) {
    	return p.keyword
    }
    if ((kind == Token.TYPE)) {
    	return p.type
    }
    if ((kind == Token.FUNCTION)) {
    	return p.function
    }
    if ((kind == Token.VARIABLE)) {
    	return p.variable
    }
    if ((kind == Token.CONSTANT)) {
    	return p.constant
    }
    if ((kind == Token.STRING)) {
    	return p.string
    }
    if ((kind == Token.NUMBER)) {
    	return p.number
    }
    if ((kind == Token.COMMENT)) {
    	return p.comment
    }
    if ((kind == Token.OPERATOR)) {
    	return p.operator
    }
    if ((kind == Token.PUNCTUATION)) {
    	return p.punctuation
    }
    return p.plain
}
