component counter {
    var count = 0

    button #inc(text="+", @click={ count += 1 })
    button #dec(text="-", @click={ count -= 1 })
    text #display(value="Count: {count}")
}

component wrapper {
    var visible = true

    vbox {
        text #hdr(value="header")
        if visible {
            text #conditional(value="shown")
        }
    }
}

component listcomp {
    var items = ["a", "b", "c"]

    vbox {
        for item = items {
            text #item(value=item)
        }
    }
}

test counter "event triggering" {
    assert(count == 0)
    #inc.@click()
    assert(count == 1)
    #inc.@click()
    #inc.@click()
    assert(count == 3)
    #dec.@click()
    assert(count == 2)
    assert(#display.value == "Count: 2")
}

test counter "dom updates after mutation" {
    count += 1
    assert(#display.value == "Count: 1")
    count += 4
    assert(#display.value == "Count: 5")
}

test counter {
    assert(count == 0)
}

test wrapper "conditional rendering" {
    assert(#conditional != null)
    visible = false
    assert(#conditional == null)
}

test wrapper "nested find" {
    assert(#hdr.value == "header")
}

test listcomp "for loop rendering" {
    assert(#item[0].value == "a")
    assert(#item[2].value == "c")
}
