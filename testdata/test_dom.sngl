import . "sngl://std"

component counter {
    var count = 0

    button #inc(text="+", @click { count += 1 })
    button #dec(text="-", @click { count -= 1 })
    text #display(value="Count: {count}")
}

component wrapper {
    var visible = true

    vbox {
        text #hdr(value="header")
        if visible {
            text #conditional(value="shown")
        }
    }
}

component listcomp {
    var items = ["a", "b", "c"]

    vbox {
        for item = items {
            text #item(value=item)
        }
    }
}

func testEventTriggering(t Test, c counter) {
    t.assert(c.count == 0)
    c.inc.click()
    t.assert(c.count == 1)
    c.inc.click()
    c.inc.click()
    t.assert(c.count == 3)
    c.dec.click()
    t.assert(c.count == 2)
    t.assert(c.display.value == "Count: 2")
}

func testDomUpdatesAfterMutation(t Test, c counter) {
    c.count += 1
    t.assert(c.display.value == "Count: 1")
    c.count += 4
    t.assert(c.display.value == "Count: 5")
}

func testCounter(t Test, c counter) {
    t.assert(c.count == 0)
}

func testConditionalRendering(t Test, c wrapper) {
    t.assert(c.conditional != null)
    c.visible = false
    t.assert(c.conditional == null)
}

func testNestedFind(t Test, c wrapper) {
    t.assert(c.hdr.value == "header")
}

func testForLoopRendering(t Test, c listcomp) {
    t.assert(c.item[0].value == "a")
    t.assert(c.item[2].value == "c")
}
