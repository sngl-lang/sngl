import . "sngl:ui"
import app "sngl:app"

// slot: A-tier — Wrapper uses slot{} to project children from main.
component Wrapper(children ...component) ui {
    vbox {
        text(value="header")
        children
        text(value="footer")
    }
}

component main ui {
    Wrapper {
        text(value="projected child")
    }
}

app.window {
    main
}
