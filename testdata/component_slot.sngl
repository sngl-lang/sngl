import . "sngl:ui"

// slot: A-tier — Wrapper uses slot{} to project children from main.
component Wrapper(children ...component) node {
    vbox {
        text(value="header")
        children
        text(value="footer")
    }
}

component main node {
    Wrapper {
        text(value="projected child")
    }
}

window {
    main
}
