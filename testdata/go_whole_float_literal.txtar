A `float` whose value is whole has to keep its point in Go, because Go reads an
untyped constant with no point as an *integer* constant.

Most positions survive without it: `m.total = 2` against a float64 field, or
`(m.total / 10)` against a float64 operand, are converted by the other half of
the expression. The position with no other half is `:=`, where the literal is
the only thing the local's type can be read off -- `acc := 2` is an `int`, and
the next two lines then do not compile:

    acc := 2
    acc = (acc + m.total)   // invalid operation: mismatched types int and float64
    return (acc / 4)        // integer division, and the wrong return type

So the claim here is narrow and worth stating narrowly: this is about the
spelling of the literal, not about arithmetic the folder would have settled.
`2.0 / 4.0` written as such never reaches a backend -- the folder answers it
first, in every position reachable from a program -- which is why the fixture
divides by a *variable* instead.

deny out/go/bubbletea/model.go `(?m)^\tacc := 2$` -- a whole float local spelled without its point is an int to Go, and the two lines after it stop compiling
deny out/go/fyne/model.go `(?m)^\tacc := 2$` -- the same local, on the other Go backend
-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
        fyne
    }
}

window {
    var total = 1.5

    func scaled() float {
        var acc = 2.0
        acc = acc + total
        return acc / total
    }

    text(value="{scaled()}")
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	total float64

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.total = 1.5
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) scaled() float64 {
	acc := 2.0
	acc = (acc + m.total)
	return (acc / m.total)
}

func (m Model) Total() float64 {
	return m.total
}

func (m Model) SetTotal(v float64) Model {
	m.total = v
	return m
}

type setTotalMsg struct{ value float64 }

func SetTotalCmd(v float64) tea.Cmd {
	return func() tea.Msg { return setTotalMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setTotalMsg:
		m = m.SetTotal(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(m.scaled())))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package ui

import (
	"fmt"
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/widget"
)

// Model holds the state for this SNGL UI.
type Model struct {
	total float64

	__n0 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.total = 1.5
	return m
}

func (m *Model) scaled() float64 {
	acc := 2.0
	acc = (acc + m.total)
	return (acc / m.total)
}

func (m *Model) Total() float64 {
	return m.total
}

func (m *Model) SetTotal(v float64) {
	m.total = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText(fmt.Sprint(m.scaled()))
	content := fyne.CanvasObject(m.__n0)
	return content
}
