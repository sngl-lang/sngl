A color literal in a Style the build can read only part of folds whole: the
optimizer drops a field written as its declaration's default, and the const
evaluator read a struct literal's fields as written, so `#336699` beside a
held `padding` lost its `a` and html's static style said `#33669900`,
transparent. It reads what ir.StructLit.Field answers for each field now, the
default included, as the interpreter does.

-- app.sngl --
import ui "sngl:ui"

output {
    none { html }
    go {
        fyne
        gtk4
    }
}

var pad ui.measurement = 0px

ui.window {
    ui.vbox(style={background=#336699}) {
        ui.text(value="a")
    }
    ui.vbox(style={padding=pad, background=#336699}) {
        ui.text(value="b")
    }
    ui.text(value="c", style={padding=pad, background=#336699})
    ui.text(value="d", style={padding=pad, color=#336699})
}
