A span of rich text is no GObject subclass: gtk4 writes it in SNGL as a
GListStore of the spans in it, what it says a value C holds on it
(sngl:x/c's held) and its flow's store let go through a static callback, so
the flow's markup is written by the platform's own SNGL in both languages.
The program prints the Pango markup of a paragraph, flips a branch in it,
and prints it again: nested runs, an escaped link, a monospace run and one
styled with a color, a size, a family and both lines.

exec out/c/gtk4 -- said.txt
exec out/go/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"
import md "sngl:ui/markup"

c.link(include="peek.h", pkgConfig=["gtk4"], sources=["peek.c", "peek.h"])

#[c.native("peek")]
func peek(n ui.node)

output {
    c { gtk4 }
    go { gtk4 }
}

var (
    loud = true
    ticks = 0
)

time.timer(interval=100ms, @tick {
    ticks += 1
    if ticks == 2 {
        peek(flow)
        loud = false
    }
    if ticks == 4 {
        peek(flow)
        gtk4.quit()
    }
})

ui.window(title="t") {
    ui.vbox {
        md.paragraph #flow {
            md.text(value="quiet <&> ")
            if loud {
                md.bold {
                    md.text(value="LOUD")
                    md.italic {
                        md.text(value="er")
                    }
                }
            } else {
                md.link(href="https://example.com/?a=1&b=2") {
                    md.text(value="soft")
                }
            }
            md.monospace {
                md.text(value=" end")
            }
            md.run(style={color=color{r=255, g=0, b=16, a=255}, fontSize=13.5px, underline=true, strike=true, fontFamily="Serif"}) {
                md.text(value="styled")
            }
        }
    }
}
-- peek.c --
#include "peek.h"

#include <stdio.h>

void peek(GtkWidget *w) {
    puts(gtk_label_get_label(GTK_LABEL(w)));
    fflush(stdout);
}
-- peek.h --
#include <gtk/gtk.h>

// Prints the markup the label w is shows.
void peek(GtkWidget *w);
-- said.txt --
quiet &lt;&amp;&gt; <b>LOUD<i>er</i></b><tt> end</tt><u><s><span font_family="Serif" foreground="#FF0010" font_desc="13.5px">styled</span></s></u>
quiet &lt;&amp;&gt; <a href="https://example.com/?a=1&amp;b=2">soft</a><tt> end</tt><u><s><span font_family="Serif" foreground="#FF0010" font_desc="13.5px">styled</span></s></u>
-- out/c/gtk4/main.c --
