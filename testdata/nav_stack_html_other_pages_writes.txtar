A handler beside a stack writes every node that shows what it changed, on
whichever page that node is, and on a static site each page is a document of
its own holding none of the others' nodes. Each document leaves out its
writes to the other pages' nodes: written, the label's `textContent` threw on
the home document, whose page holds no label, and the handler stopped before
it wrote the heading that is there.

deny out/none/html/index.html `"first!"` -- the home document writes no item page's label, which it holds no element for
deny out/none/html/item/index.html `"items!"` -- nor the item document the home page's heading

-- site.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    none {
        html
    }
}

context #tone("plain")

func shout(s string) => tone == "loud" ? "{s}!" : s

component site ui.node {
    var picked = "plain"

    ui.select #pick(:value=picked) {
        ui.choice(label="plain")
        ui.choice(label="loud")
    }
    tone(picked) {
        nav.stack #pages {
            nav.page #item(href="/item", title="Item") {
                ui.text #label(value=shout("first"))
            }
            nav.page #home(href="/", title="Items") {
                ui.text #heading(value=shout("items"))
                ui.button #toItem(text="first", @click { pages.go(item) })
            }
        }
    }
}

ui.window {
    site()
}
