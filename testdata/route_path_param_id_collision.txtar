A path parameter and a node `#id` may share a name, and each read says which
it meant.

They could not before. The checker read `{pkg}` off the href and synthesized a
var called `pkg`, while `#pkg` bound a handle under the same name with nothing
declaring either -- so which one a body's `pkg` reached fell out of the order
two scopes were pushed in, and neither answer was chosen by anybody. Writing
both was the failing case that put the parameters back in the body's scope at
all.

The parameters are a declared struct now and the body reads them through the
name its own population wrote, so `pkg` is the page's handle and `v.pkg` is
the path's -- and `v` is the caller's word, not the declaration's. The handle
read is the page's record, whose `href` is the pattern rather than the
request's path, and it is here to show the two names resolving apart.

deny out/go/html/server.go `state\.pkg` -- the path parameter is a field of the slot's binding, never a name of its own
deny out/go/html/server.go `PathValue` -- a client-only route bakes the page; the server reads nothing of the request, and the page's script reads its own path

-- collide.sngl --
import "sngl:platform/html"
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    go {
        html
    }
}

struct PageParams {
    pkg string
}

ui.window(title="t") {
    nav.stack #pages {
        nav.page #pkg(href=`/p/{pkg}`, title="t", params=PageParams{}) {
            component content(v) {
                html.a(href=pkg.href, innerText=v.pkg)
            }
        }
    }
}
-- out/go/html/server.go --
package main

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /p/{pkg}", handlePkg)
	return mux
}

// PageParams is what route "/p/{pkg}" takes from the request.
type PageParams struct {
	Pkg string
}

func handlePkg(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from collide.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>t</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<a id=\"$0\" href=\"/p/{pkg}\">\n</a>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { v: null, visible__inst0: true };\n  state.v = ((__m) => __m ? { ...{}, pkg: decodeURIComponent(__m[1]) } : {})(location.pathname.match(/^\\/p\\/([^/]*)$/));\n  var $0 = document.getElementById(\"$0\");\n  function __sngl_init() {\n    $0.innerText = state.v.pkg;\n  }\n  __sngl_init();\n})();\n</script>\n</body></html>\n"))
}

func main() {
	http.ListenAndServe(":8080", Handler())
}
