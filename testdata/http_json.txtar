sngl:http and sngl:json on each language: a request, its status checked and
its body decoded, through the language's runtime handed a descriptor of the
type -- Go's pkg/go/sngljson and snglhttp, JavaScript's page helper, Kotlin's
SnglCodec beside the screen. A function that waits on a request is a suspend
function on Kotlin, and a handler or an effect's mount that waits is started
on a coroutine of its own. Response.checked is http's own SNGL, declared in
the program like any library struct's method a body calls.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `\nfun lookup\(` -- a function that waits is a suspend function on Kotlin
deny out/go/fyne/model.go `m\.checked` -- the local `checked` is no Model member, though a method of that name is declared

-- app.sngl --
import async "sngl:async"
import http "sngl:http"
import json "sngl:json"
import . "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
    }
    kotlin {
        android
    }
}

const server = "http://127.0.0.1:47819"

enum Kind {
    #[json.identifier("hard-cover")]
    hardcover
    paperback
}

struct Echo {
    method string
    #[json.identifier("raw_query")]
    query  option[string]
    kind   Kind
}

struct Page {
    #[http.identifier("page-size")]
    size option[int]
    tags list[string]
}

func lookup(name string) async.Result[Echo] {
    match var r = http.get(url="{server}/echo/{http.pathEscape(name)}", query=Page{size=20, tags=["a"]}) {
        failed { return {failed=r} }
        ok {
            match var checked = r.checked() {
                failed { return {failed=checked} }
                ok { return json.decode[Echo](checked.body) }
            }
        }
    }
}

component panel node {
    var key = "a"
    var answer option[Echo] = null
    var sent = 0
    async.query(on=key, fetch=lookup, :value=answer)
    text(value=answer != null ? json.encode(answer) : "-")
    button(text="Send", @click {
        match var r = http.send(method=http.Method.post, url="{server}/echo", headers={"X-Sngl"="on"}, body=json.encode(Echo{method="m", query=null, kind=Kind.hardcover})) {
            ok { sent = r.status }
            failed { sent = -1 }
        }
    })
}

window {
    panel
}
