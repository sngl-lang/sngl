An image on gtk4, in both languages, as GTK shows it. The program writes
three files beside it -- a 16 by 16 PNG, a file of words named as a PNG and
an empty one -- and shows the first in an image once they are there, a file
that is missing in a second, and a drawing in a third, with a drawing as the
window's icon. Each time it prints what the program heard -- the loads, the
failures with why, the clicks -- and what GTK holds: the window's icon, by
the counter in its name, and how many of the icon theme's directories hold
its file, and each picture's fit, its texture's size and first pixel, and
what holds it. Between prints it presses the first image, changes its fit,
the URL it shows and the drawing's width and the icon's color, takes the
icon away, and at last brings the PNG back.

exec out/c/gtk4 -- said.txt
exec out/go/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"
import draw "sngl:ui/draw"

c.link(include="peek.h", pkgConfig=["gtk4"], sources=["peek.c", "peek.h"])

#[c.native("peek")]
func peek(n ui.window)

#[c.native("press")]
func press(n ui.window)

#[c.native("write_files")]
func writeFiles()

c.link(include="stdio.h", system=true)

#[c.native("puts")]
#[go.native("fmt", "fmt.Println")]
func say(s string)

output {
    c { gtk4 }
    go { gtk4 }
}

var (
    ticks = 0
    ready = false
    url = "dot.png"
    fit = ui.ObjectFit.contain
    width = 30.0
    iconShown = true
    iconColor = #FF0000
    loads = 0
    failed = ""
    missing = ""
    clicks = 0
)

func report() {
    say("loads {loads}, clicks {clicks}, failed [{failed}], missing [{missing}]")
    peek(main)
}

time.timer(interval=100ms, @tick {
    ticks += 1
    if ticks == 1 {
        writeFiles()
        ready = true
    }
    if ticks == 3 {
        report()
        press(main)
        fit = ui.ObjectFit.cover
        width = 41.5
        iconColor = #0000FF
        url = "words.png"
    }
    if ticks == 5 {
        report()
        fit = ui.ObjectFit.none
        url = "empty.png"
        iconShown = false
    }
    if ticks == 7 {
        report()
        fit = ui.ObjectFit.fill
        url = "dot.png"
    }
    if ticks == 9 {
        report()
        gtk4.quit()
    }
})

ui.window #main(title="t") {
    component favicon {
        if iconShown {
            draw.image(width=8.0, height=8.0) {
                draw.rect(x=0.0, y=0.0, w=8.0, h=8.0, style={fill=iconColor})
            }
        }
    }
    ui.image(fit=fit, @click { clicks += 1 }, @load { loads += 1 }, @error(e) { failed = e.message }) {
        if ready {
            ui.file(path=url)
        }
    }
    ui.image(@error(e) { missing = e.message }) {
        ui.file(path="missing.png")
    }
    ui.image {
        draw.image(width=width, height=10.0) {
            draw.rect(x=0.0, y=0.0, w=width, h=10.0, style={fill=#00FF00})
        }
    }
}
-- peek.c --
#include "peek.h"

#include <stdio.h>
#include <string.h>
#include <unistd.h>

static const unsigned char dot[] = {
    0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d,
    0x49, 0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00, 0x00, 0x10,
    0x08, 0x02, 0x00, 0x00, 0x00, 0x90, 0x91, 0x68, 0x36, 0x00, 0x00, 0x00,
    0x18, 0x49, 0x44, 0x41, 0x54, 0x78, 0x9c, 0x62, 0xf9, 0xcf, 0x40, 0x1a,
    0x60, 0x82, 0x31, 0x46, 0x35, 0x8c, 0x6a, 0x18, 0x7e, 0x1a, 0x00, 0x03,
    0x00, 0x49, 0x5e, 0x01, 0x22, 0x7b, 0x7a, 0x3a, 0x17, 0x00, 0x00, 0x00,
    0x00, 0x49, 0x45, 0x4e, 0x44, 0xae, 0x42, 0x60, 0x82,
};

void write_files(void) {
    g_file_set_contents("dot.png", (const char *)dot, sizeof dot, NULL);
    g_file_set_contents("words.png", "no picture\n", -1, NULL);
    g_file_set_contents("empty.png", "", 0, NULL);
}

static void pictures(GtkWidget *w) {
    for (GtkWidget *c = gtk_widget_get_first_child(w); c != NULL; c = gtk_widget_get_next_sibling(c)) {
        if (GTK_IS_PICTURE(c)) {
            GdkPaintable *p = gtk_picture_get_paintable(GTK_PICTURE(c));
            printf("  picture fit %d in %s", gtk_picture_get_content_fit(GTK_PICTURE(c)), G_OBJECT_TYPE_NAME(gtk_widget_get_parent(c)));
            if (GDK_IS_TEXTURE(p)) {
                GdkTexture *t = GDK_TEXTURE(p);
                int tw = gdk_texture_get_width(t), th = gdk_texture_get_height(t);
                guchar *px = g_malloc((gsize)tw * th * 4);
                gdk_texture_download(t, px, (gsize)tw * 4);
                printf(" texture %dx%d first %02x%02x%02x%02x", tw, th, px[0], px[1], px[2], px[3]);
                g_free(px);
            } else {
                printf(" %s", p ? G_OBJECT_TYPE_NAME(p) : "empty");
            }
            printf("\n");
        }
        pictures(c);
    }
}

void peek(GtkWidget *box) {
    GtkWindow *win = GTK_WINDOW(gtk_widget_get_root(box));
    const char *icon = gtk_window_get_icon_name(win);
    char prefix[64];
    snprintf(prefix, sizeof prefix, "sngl-icon-%d-", (int)getpid());
    if (icon == NULL) {
        printf("icon none\n");
    } else if (g_str_has_prefix(icon, prefix)) {
        GtkIconTheme *theme = gtk_icon_theme_get_for_display(gtk_widget_get_display(box));
        char **dirs = gtk_icon_theme_get_search_path(theme);
        char *file = g_strdup_printf("%s.png", icon);
        int found = 0;
        for (char **d = dirs; d && *d; d++) {
            char *path = g_build_filename(*d, file, NULL);
            found += g_file_test(path, G_FILE_TEST_IS_REGULAR);
            g_free(path);
        }
        g_free(file);
        g_strfreev(dirs);
        printf("icon %s files %d\n", icon + strlen(prefix), found);
    } else {
        printf("icon %s\n", icon);
    }
    pictures(box);
    fflush(stdout);
}

/* Presses the first image: the click gesture of the box holding the first
 * picture. */
static GtkWidget *first_picture(GtkWidget *w) {
    for (GtkWidget *c = gtk_widget_get_first_child(w); c != NULL; c = gtk_widget_get_next_sibling(c)) {
        if (GTK_IS_PICTURE(c)) return c;
        GtkWidget *f = first_picture(c);
        if (f != NULL) return f;
    }
    return NULL;
}

void press(GtkWidget *box) {
    GtkWidget *pic = first_picture(box);
    if (pic == NULL) return;
    GListModel *cs = gtk_widget_observe_controllers(gtk_widget_get_parent(pic));
    for (guint i = 0; i < g_list_model_get_n_items(cs); i++) {
        GObject *c = g_list_model_get_item(cs, i);
        if (GTK_IS_GESTURE_CLICK(c)) g_signal_emit_by_name(c, "pressed", 1, 0.0, 0.0);
        g_object_unref(c);
    }
    g_object_unref(cs);
}
-- peek.h --
#include <gtk/gtk.h>

// Writes dot.png, words.png and empty.png beside the program.
void write_files(void);

// Prints the window's icon and each picture in the window whose toplevel
// box is box.
void peek(GtkWidget *box);

// Presses the image holding the window's first picture.
void press(GtkWidget *box);
