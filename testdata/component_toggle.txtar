package main

import "testing"

func TestToggleFlips(t *testing.T) {
	__snglTestComponent := newTestComponent()
	c := __snglTestComponent
	_ = c
	if !((c.on == false)) { t.Errorf("assert failed: %s", "(c.on == false)") }
	c.on = true
	if !((c.on == true)) { t.Errorf("assert failed: %s", "(c.on == true)") }
	c.on = false
	if !((c.on == false)) { t.Errorf("assert failed: %s", "(c.on == false)") }
}


func newTestComponent() Model { return New() }
