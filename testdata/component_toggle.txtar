A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_toggle.sngl --
import . "sngl:ui"
import . "sngl:test"

// toggle: state-binding fixture — flipping the bound `checked` var
// propagates to the switch, and the label sits after the switch.
component main node {
    var on = false
    toggle(checked=on, label="Notifications")
}

func testToggleFlips(t Test, c main) {
    t.assert(c.on == false)
    c.on = true
    t.assert(c.on == true)
    c.on = false
    t.assert(c.on == false)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
