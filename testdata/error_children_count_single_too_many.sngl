import . "sngl://std"
import tr "sngl://tree"

// Component declares exactly one child (bare type T).
// Two children: error.
component RequiresOne(slot _ tr.one) {
    vbox {
        slot
    }
}

component main {
    RequiresOne { // ERROR(check) "requires exactly one child"
        text(value="a")
        text(value="b")
    }
}
