import . "sngl:ui"
import family "sngl:family"

// Component declares exactly one child (bare type T).
// Two children: error.
component RequiresOne(content ...component family.one) node {
    vbox {
        content
    }
}

component main node {
    RequiresOne { // ERROR(check) "requires exactly one child"
        text(value="a")
        text(value="b")
    }
}

window {
    main
}
