import . "sngl:ui"
import . "sngl:app"
import tr "sngl:tree"

// Component declares exactly one child (bare type T).
// Two children: error.
component RequiresOne(content ...component tr.one) node {
    vbox {
        content
    }
}

component main node {
    RequiresOne { // ERROR(check) "requires exactly one child"
        text(value="a")
        text(value="b")
    }
}

window {
    main
}
