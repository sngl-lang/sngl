// A native mark says the declaration IS the host identifier, so only a form
// that names a value and makes none can carry one. A const is that; a var is a
// cell the program assigns to, and nothing it wrote could reach the host's.
//
// The var here is component-local because that is the form that reaches the
// mark with an ir.Var in hand -- a top-level `var` is marked with no symbol at
// all and gets the "cannot mark a var" answer from the same handler.
//
// And the flags describe a *call*, which a const has none of.
import ui "sngl:ui"
import go "sngl:language/go"

#[go.native("math", "math.E", method)] // ERROR(check) "a const names a value and makes none"
const e float = 2.718

output {
    go {
        fyne
    }
}

component box() ui.node {
    #[go.native("math", "math.Pi")] // ERROR(check) "a host value the program cannot assign to is a const"
    var pi float = 0.0

    ui.text(value=string(pi))
}

ui.window(title="t") {
    box()
}
