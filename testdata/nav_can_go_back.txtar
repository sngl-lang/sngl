-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestNotAtTheStart(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(!(len(c.pages__history) > 0)) { t.Errorf("assert failed: %s", "!(len(c.pages__history) > 0)") }
	if !(!(len(c.pages__history) > 0)) { t.Errorf("assert failed: %s", "!(len(c.pages__history) > 0)") }
}

func TestAfterAGo(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.toAboutClick()
	if !((len(c.pages__history) > 0)) { t.Errorf("assert failed: %s", "(len(c.pages__history) > 0)") }
	if !((len(c.pages__history) > 0)) { t.Errorf("assert failed: %s", "(len(c.pages__history) > 0)") }
}

func TestTheWindowsBackReturns(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.toAboutClick()
	c.mainBack()
	if !((c.backs == 1)) { t.Errorf("assert failed: %s", "(c.backs == 1)") }
	if !((c.pages__current.Title == "Home")) { t.Errorf("assert failed: %s", "(c.pages__current.Title == \"Home\")") }
	if !(!(len(c.pages__history) > 0)) { t.Errorf("assert failed: %s", "!(len(c.pages__history) > 0)") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
