A window's up arrow, from `canGoBack=pages.canGoBack()` and `@back`: android's
TopAppBar navigation icon and a BackHandler ahead of the NavHost's, gtk4's
header bar or a row over the content, fyne's row over the content, and
bubbletea's title line, where esc is the back. A window given no `canGoBack`
draws none of it. html is left out: a `go` there loads another document,
which ends a test (cmd/sngl/testdata/window_app_bar_runs.txt has html's).

-- app.sngl --
import . "sngl:test"
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
}

component app root {
    var backs = 0

    ui.window #main(title=pages.current.title, canGoBack=pages.canGoBack(), @back {
        backs += 1
        pages.back()
    }) {
        nav.stack #pages {
            nav.page #home(href="/", title="Home") {
                ui.text(value="home")
            }
            nav.page #about(href="/about", title="About") {
                ui.text(value="about")
            }
        }
        ui.button #toAbout(text="About", @click { pages.go(about) })
    }
}

app()

func testNotAtTheStart(t Test, c app) {
    t.assert(!c.pages.canGoBack())
    t.assert(!c.main.canGoBack)
}

func testAfterAGo(t Test, c app) {
    c.toAbout.click()
    t.assert(c.pages.canGoBack())
    t.assert(c.main.canGoBack)
}

func testTheWindowsBackReturns(t Test, c app) {
    c.toAbout.click()
    c.main.back()
    t.assert(c.backs == 1)
    t.assert(c.main.title == "Home")
    t.assert(!c.pages.canGoBack())
}
