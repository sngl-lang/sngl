Go gives an untyped constant a *default type* -- `int` for a whole number,
`float64` for a fractional one -- and that is not the type the program
declared.

**A local takes the declared type.** `:=` reads the default type off the
initializer, so a `float32` became a float64 and a whole `float` became an int:

    var acc float32 = 1.0   ->  acc := 1.0   // float64; `acc + scale` does not compile
    var acc float  = 2.0    ->  acc := 2     // int; same

`mix` below is the first of those. LocalVarText writes the type out for a
numeric local, and only for a numeric one: a string, a bool, a struct or a
slice each have exactly one Go type that `:=` reads off a correct initializer,
and spelling a widget handle's type is what tips gtk4 out of the cgo-free mode
it emits twice to reach.

deny out/go/bubbletea/model.go `(?m)^\tacc := ` -- a numeric local carries its declared type; inferred, a float32 is a float64
-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
    }
}

window {
    var scale float32 = 2.0

    func mix() float32 {
        var acc float32 = 1.0
        acc = acc + scale
        return acc
    }

    text(value="{mix()}")
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	*modelState
}

// modelState is what every copy of a Model shares.
type modelState struct {
	scale          float32
	visible__inst0 bool

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{&modelState{}}
	m.scale = 2.0
	m.visible__inst0 = true
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) mix() float32 {
	var acc float32 = 1.0
	acc = (acc + m.scale)
	return acc
}

func (m Model) Scale() float32 {
	return m.scale
}

func (m Model) SetScale(v float32) Model {
	m.scale = v
	return m
}

type setScaleMsg struct{ value float32 }

func SetScaleCmd(v float32) tea.Cmd {
	return func() tea.Msg { return setScaleMsg{value: v} }
}

func (m Model) Visible__inst0() bool {
	return m.visible__inst0
}

func (m Model) SetVisible__inst0(v bool) Model {
	m.visible__inst0 = v
	return m
}

type setVisible__inst0Msg struct{ value bool }

func SetVisible__inst0Cmd(v bool) tea.Cmd {
	return func() tea.Msg { return setVisible__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setScaleMsg:
		m = m.SetScale(msg.value)
	case setVisible__inst0Msg:
		m = m.SetVisible__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			if m.visible__inst0 {
				m.visible__inst0 = false
			}
			if !(m.visible__inst0) {
				return m, tea.Quit
			}
			return m, nil
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	if m.visible__inst0 {
		content = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(m.mix())))
	}
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
