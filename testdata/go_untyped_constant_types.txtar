Go gives an untyped constant a *default type* -- `int` for a whole number,
`float64` for a fractional one -- and that is not the type the program
declared. Two positions bite, and they need different answers.

**A local takes the declared type.** `:=` reads the default type off the
initialiser, so a `float32` became a float64 and a whole `float` became an int:

    var acc float32 = 1.0   ->  acc := 1.0   // float64; `acc + scale` does not compile
    var acc float  = 2.0    ->  acc := 2     // int; same

`mix` below is the first of those. LocalVarText writes the type out for a
numeric local, and only for a numeric one: a string, a bool, a struct or a
slice each have exactly one Go type that `:=` reads off a correct initialiser,
and spelling a widget handle's type is what tips gtk4 out of the cgo-free mode
it emits twice to reach.

**An `any` element takes the literal's spelling**, because no annotation
reaches inside a composite literal. `[]any{2}` holds an `int`, and comparing
that interface against a `float64` is false however equal the numbers are --
`boxed` returns "differ" rather than "same", and it compiles either way, which
is what makes it worth pinning. goFloatLiteral keeps the point on a whole
float so the element holds a float64.

The pair is also why neither fix replaces the other: the annotation cannot
reach the element, and the spelling cannot name float32.

deny out/go/bubbletea/model.go `(?m)^\tacc := ` -- a numeric local carries its declared type; inferred, a float32 is a float64
deny out/go/bubbletea/model.go `\[\]any\{2,` -- a whole float in an `any` element keeps its point, or the interface holds an int and never equals the float64 beside it
-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
    }
}

window {
    var scale float32 = 2.0

    func mix() float32 {
        var acc float32 = 1.0
        acc = acc + scale
        return acc
    }

    func boxed() string {
        var xs list<dyn> = [2.0, "a"]
        var f float = 2.0
        return xs[0] == f ? "same" : "differ"
    }

    text(value="{mix()} {boxed()}")
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	scale float32

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.scale = 2.0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) mix() float32 {
	var acc float32 = 1.0
	acc = (acc + m.scale)
	return acc
}

func (m Model) boxed() string {
	xs := []any{2.0, "a"}
	var f float64 = 2.0
	var __lt0 string
	if xs[0] == f {
		__lt0 = "same"
	} else {
		__lt0 = "differ"
	}
	return __lt0
}

func (m Model) Scale() float32 {
	return m.scale
}

func (m Model) SetScale(v float32) Model {
	m.scale = v
	return m
}

type setScaleMsg struct{ value float32 }

func SetScaleCmd(v float32) tea.Cmd {
	return func() tea.Msg { return setScaleMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setScaleMsg:
		m = m.SetScale(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(((fmt.Sprint(m.mix()) + " ") + "same")))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
