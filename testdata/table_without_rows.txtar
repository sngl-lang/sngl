A table given no rows lowers them to an empty list of its rows' record and a
lambda mapping each, and nothing else names the record: it is declared
beside them all the same.

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        win32
    }
}

component page ui.node {
    var cols = ["a", "b"]
    ui.button(text="more", @click {
        cols.push("c")
    })
    ui.table(columns=cols, rows=[])
}

ui.window {
    page()
}
