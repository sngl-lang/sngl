A higher-order function run(f) calls its funcvar parameter. One call site
passes a sync func, another an async native. The g3 conservative rule is that
any async candidate in pts(f-param) makes `f()` awaited, so run itself is
emitted async and each of its call sites awaits it.

-- app.sngl --
import . "sngl:ui"
import api "js:./api"

output {
    none {
        html
    }
}

func syncHello() string {
    return "sync"
}

func run(f func() string) {
    f()
}

component main node {
    button(text="RunSync", @click { run(syncHello) })
    button(text="RunAsync", @click { run(api.fetchHello) })
    text(value="hi")
}

window {
    main
}
-- api/index.ts --
export async function fetchHello(): Promise<string> { return "hi"; }
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<button id="$0">
  <span>RunSync</span>
</button>
<button id="$1">
  <span>RunAsync</span>
</button>
<span>hi</span>

<script>
(() => {
  // sngl-virt:/sngl/api/index.ts
  async function fetchHello() {
    return "hi";
  }

  // sngl-entry.js
  var state = {};
  function syncHello() {
    return "sync";
  }
  async function run(f) {
    await f();
  }
  var $0 = document.getElementById("$0");
  var $1 = document.getElementById("$1");
  $0.addEventListener("click", async function() {
    await run(syncHello());
  });
  $1.addEventListener("click", async function() {
    await run(fetchHello);
  });
})();
</script>
</body></html>
