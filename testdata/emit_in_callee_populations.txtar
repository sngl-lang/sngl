An event a component fires reaches the caller's handler when the emit sits in
a slot population the component wrote, or in a component its body holds that
is built at run time.

Both inliners substitute a component's events before splicing the caller's
content into its slots, since an emit in that content is the caller's own.
That order needs the event walk to reach every population the component body
writes, because nothing walks them for events after the splice. It reached
neither: an entry population written at an insertion
(`layout() { component content { ... } }` in `Frame`) left `done(8)` for the
caller's body, and a named population on a nested node
(`Card { component header { ... } }` in `Titled`) lost `named(9)` under
either order.

`Picker` is the case the order itself is for in passNoInlineComponents. It has
state and sits under a `for` over state, so on a target that keeps an
instance's own state it is built at run time and never spliced. Its body is
lowered on its own, `Wrap` is spliced into it with `picked(7)` as slot
content, and matched against `Wrap`'s handlers the emit found none and was
dropped. bubbletea splices `Picker` per copy instead and never met it.

deny * `emit\(` -- an emit is substituted away by lowering
-- app.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component Wrap(children ...component) ui.node {
    var width = 1

    ui.hbox {
        ui.text(value="w{width}")
        children
    }
}

component Picker(@picked int) ui.node {
    var taps = 0

    Wrap {
        ui.button(text="tap {taps}", @click {
            taps = taps + 1
            picked(7)
        })
    }
}

component Frame(@done int, layout component(content component ui.node) ui.node) ui.node {
    layout() {
        component content {
            ui.button(text="done", @click { done(8) })
        }
    }
}

component Card(header component() ui.node) ui.node {
    var opened = 0

    ui.vbox {
        ui.text(value="opened {opened}")
        header()
    }
}

component Titled(@named int) ui.node {
    var hits = 0

    Card {
        component header {
            ui.button(text="named {hits}", @click { named(9) })
        }
    }
}

ui.window {
    var got = 0
    var xs = [1]

    ui.vbox {
        for var x = xs {
            Picker(@picked(v) { got = v + x })
        }
        Frame(@done(v) { got = v }) {
            component layout(c) {
                ui.hbox {
                    c
                }
            }
        }
        Titled(@named(v) { got = v })
        ui.text(value="got={got}")
    }
}
