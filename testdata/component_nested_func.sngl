// A `func` written inside another function body, run rather than read: this
// fixture is compiled and executed by every platform's test runner, which is
// what says the hoisted declarations reach a host that builds.
//
// `step` and `reset` each write their own `mark`, so the two are told apart by
// the emitted name and not by the written one; `sum` recurses; `outer` reaches
// a second level down. None of them is pure, because passInlinePure folds a
// pure nested func into its caller and hides the whole question -- `log` is
// there to be written and not to be read back.

import . "sngl:test"
import . "sngl:ui"

component main node {
    var log = ""
    var total = 0

    func step(a int) int {
        func mark(k int) int {
            log = log + "!"
            return k * 2
        }
        return mark(a) + 1
    }

    func reset(a int) int {
        func mark(k int) int {
            log = log + "?"
            return k - 1
        }
        return mark(a)
    }

    func outer(a int) int {
        func sum(k int) int {
            func note(j int) int {
                log = log + "."
                return j
            }
            if k <= 0 {
                return 0
            }
            return note(k) + sum(k - 1)
        }
        return sum(a)
    }

    effect(@mount {
        total = step(3) + reset(10) + outer(3)
    })

    text(value="{log}{total}")
}

// step: 3*2+1 = 7. reset: 10-1 = 9. outer: 3+2+1 = 6. The two `mark`s differ
// in what they compute, so one taken for the other moves the total.
func testEachNestedFuncRunsUnderItsOwnBody(t Test, c main) {
    t.assert(c.total == 22)
}

window {
    main
}
