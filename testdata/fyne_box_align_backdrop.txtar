A box's style and a label's background reach fyne.

- A box whose style names a gap, a padding or an alignment is
  `fynelayout.New`'s from the start, whatever its children ask: built as Fyne's
  own box, it spaced its children by the theme, and a box adopted later
  (`fynelayout.Adopt`) cannot know its style's gap.
- `alignItems` places each child at its own minimum across the box
  (`fynelayout.NewAligned`), where Fyne's box stretched every one, so a card's
  lines were never centred.
- A label whose style gives it a background is drawn on a
  `fynetheme.Backdrop`, which paints the colour its theme answers: Fyne
  colours no label's box, so a badge was plain text. A colour read from state
  is a new theme on the override, which repaints the backdrop.

deny out/go/fyne/model.go `__n2 = container\.NewVBox\(\)` -- the gapped column is no Fyne box
deny out/go/fyne/model.go `__n3 = container\.NewHBox\(\)` -- nor is the aligned row
deny out/go/fyne/model.go `NewThemeOverride\(m\.__n[15],` -- and neither badge is bare text

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
    }
}

component page ui.node {
    var hot = false

    ui.vbox(style={gap=12px, padding=8px}) {
        ui.hbox(style={gap=8px, alignItems=center}) {
            ui.text(value="Tall", style={fontSize=28px})
            ui.badge(value="Steady", style={background=#3366cc, color=#ffffff})
            ui.badge(value="Shifting", style={background=hot ? #cc3333 : #339933, color=#ffffff})
        }
        ui.vbox(style={alignItems=end}) {
            ui.text(value="At the end")
        }
        ui.button(text="Flip", @click { hot = !hot })
    }
}

ui.window {
    page()
}
