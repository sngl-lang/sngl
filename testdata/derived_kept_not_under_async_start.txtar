A derived function work async.start begins calls keeps nothing
(internal/lower/memo.go): Go runs that work on a goroutine, and writing its
cell there would race the drawing thread reading it. `counted` is computed
each time it is called; `shown`, which only the drawing thread calls, keeps
its answer.

-- app.sngl --
import async "sngl:async"
import ui "sngl:ui"

output {
    go {
        gtk4
    }
}

component shelf ui.node {
    var items = ["a"]
    var seen = 0

    func counted() list[string] {
        return items.map(func(s string) => "{s}#")
    }

    func shown() list[string] {
        return items.map(func(s string) => "{s}!")
    }

    ui.vbox {
        ui.text(value=counted().format())
        ui.text(value=shown().format())
        ui.button(text="count", @click { async.start(func() { seen = counted().length() }) })
    }
}

ui.window {
    shelf()
}
