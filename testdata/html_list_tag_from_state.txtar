html's markup.list is one `ol` or `ul` element, and `tag` is a #[construct]
prop of html's element: a value read only while the element is built. A list
whose `ordered` reads state is a render slot that rebuilds the element, both
where it stands and in each copy of a loop over state, which rebuilds it from
the copy's setter.

deny out/none/html/index.html `createElement\("element"\)` -- every element is created under its tag
deny out/none/html/index.html `\.tag = ` -- a tag is never written after the element is built
-- app.sngl --
import ui "sngl:ui"
import markup "sngl:ui/markup"

output {
    none { html }
}

struct L {
    ordered bool
    start   int
}

var numbered = false
var lists = [L{ordered=true, start=3}, L{ordered=false, start=1}]

ui.window(title="lists") {
    ui.button(text="flip", @click {
        numbered = !numbered
        lists = [L{ordered=!lists[0].ordered, start=lists[0].start}]
    })
    markup.list(ordered=numbered, start=4) {
        markup.listItem {
            markup.paragraph {
                markup.text(value="fixed")
            }
        }
    }
    for var l = lists {
        markup.list(ordered=l.ordered, start=l.start) {
            markup.listItem {
                markup.paragraph {
                    markup.text(value="copy")
                }
            }
        }
    }
}
