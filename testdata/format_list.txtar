A list's format is its elements' formats joined by sep, an option's its
value's or none, and an enum's the format the compiler declares, its member's
name; a named argument the list or option does not declare is the element's.
The optimizer inlines each into a map and a join at the element's own format.
A list's appendFormat loops, so it is copied at the list's types and called
(`__list_appendFormat__list_int`), each element appended by the int's own
appendFormat and the enum's, which declares none, as its format's string. The
tests run on every target, the interpreter included
(testdata/format_options.sngl).

-- format_list.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}

enum Hue {
    red
    green
}

func joined(xs list[int], hs list[Hue]) string {
    var b builder
    xs.appendFormat(&b, sep="-", width=2, pad="0")
    b.add("|")
    hs.appendFormat(&b, sep="/")
    return b.string()
}

component lists node {
    var xs = [10, 11, 12]
    var ys list[option[float]] = [1.5, null]
    var hs = [Hue.red, Hue.green]
    text #out(value="{xs, sep="; ", base=16} {ys, none="-", places=2} {hs}")
    text #built(value=joined(xs, hs))
    button #grow(text="grow", @click {
        xs.push(255)
        hs.push(Hue.green)
    })
}

func testLists(t Test, c lists) {
    t.assert(c.out.value == "a; b; c 1.50, - red, green")
    t.assert(c.built.value == "10-11-12|red/green")
    c.grow.click()
    t.assert(c.out.value == "a; b; c; ff 1.50, - red, green, green")
    t.assert(c.built.value == "10-11-12-255|red/green/green")
}

window {
    lists()
}
