A route is named for its window, and a harness root has none. A fixture
with tests is built with its component under test isolated as the root, so
its windows are cleared and the route is the synthesized one around the
component. That route took the component's name, `shop`, and came out as
handleShop, where `sngl generate` of the same source, with the anonymous
window in place, emits handleIndex. A component's name is not a window's, and
which name a handler gets must not depend on whether a harness ran.

deny out/go/html/server.go `handleShop` -- the isolated component's name is not a route name

-- shop.sngl --
import . "sngl:ui"
import . "sngl:test"

component shop node {
    var n = 0
    button #add(text="add", @click {
        n = n + 1
    })
    text(value="{n}")
}

func testAdds(t Test, c shop) {
    c.add.click()
    t.assert(c.n == 1)
}

window {
    shop
}

output {
    go {
        html
    }
}
-- out/go/html/server.go --
package main

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleIndex)
	return mux
}

func handleIndex(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from shop.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<button id=\"$0\" data-sngl-id=\"add\">\n  <span>add</span>\n</button>\n<span id=\"__n0\" data-sngl-id=\"__n0\">\n</span>\n\n<script>\nwindow.__sngl_markup = Array.from(document.body.childNodes)\n  .filter((n) => n.nodeName !== \"SCRIPT\").map((n) => n.cloneNode(true));\nwindow.__sngl_reset = () => {\n  for (const n of Array.from(document.body.childNodes)) {\n    if (n.nodeName !== \"SCRIPT\") n.remove();\n  }\n  const first = document.body.firstChild;\n  for (const n of window.__sngl_markup) document.body.insertBefore(n.cloneNode(true), first);\n  window.__sngl_boot();\n};\nwindow.__sngl_boot = () => {\n(() => {\n  // sngl-entry.js\n  var state = { n: 0 };\n  state.addClick = () => $0.click();\n  if (typeof window !== \"undefined\") {\n    window.__sngl_state = state;\n  }\n  function testAdds(t, c) {\n    c.add();\n    t.assert(c.n === 1);\n  }\n  if (typeof window !== \"undefined\") {\n    Object.assign(window, { testAdds });\n  }\n  function String(v) {\n    return \"\" + v;\n  }\n  var $0 = document.getElementById(\"$0\");\n  var __n0 = document.querySelector('[data-sngl-id=\"__n0\"]');\n  $0.addEventListener(\"click\", function() {\n    state.n = state.n + 1;\n    __n0.textContent = String(state.n);\n  });\n  function __sngl_init() {\n    __n0.textContent = String(state.n);\n  }\n  __sngl_init();\n})();\n};\nwindow.__sngl_boot();\n</script>\n</body></html>\n"))
}

func main() {
	http.ListenAndServe(":8080", Handler())
}
