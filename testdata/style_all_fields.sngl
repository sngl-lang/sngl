// Every field `Style` declares, written once. The declaration and the CSS
// mapping behind it are held in step by internal/htmlutil's
// TestStyleFieldsAllReachCSS; this fixture is the other half — it checks that
// each field is spelled and typed the way a caller writes it, on every
// registered platform.

import . "sngl:ui"

component main node {
    vbox(style={
        padding = 1px,
        paddingTop = 1px,
        paddingRight = 1px,
        paddingBottom = 1px,
        paddingLeft = 1px,
        paddingX = 1px,
        paddingY = 1px,
        margin = 1px,
        marginTop = 1px,
        marginRight = 1px,
        marginBottom = 1px,
        marginLeft = 1px,
        marginX = 1px,
        marginY = 1px,
        gap = 1px,
        width = 10px,
        minWidth = 10px,
        height = 10px,
        maxWidth = 10px,
        maxHeight = 10px,
        flex = 1.0,
        flexDirection = FlexDirection.rowReverse,
        alignItems = Alignment.stretch,
        justifyContent = Justification.spaceBetween,
        position = Position.relative,
        top = 0,
        bottom = 0,
        left = 0,
        right = 0,
        zIndex = 1,
        color = #112233,
        fontSize = 12px,
        fontFamily = "serif",
        fontWeight = FontWeight.bold,
        fontStyle = FontStyle.italic,
        textAlign = TextAlign.center,
        maxLines = 2,
        background = #445566,
        borderRadius = 2px,
        borderColor = #778899,
        borderWidth = 1px,
        border = "1px solid #000",
        borderBottom = "1px solid #000",
        borderLeft = "1px solid #000",
        borderCollapse = "collapse",
        borderStyle = BorderStyle.dashed,
        opacity = 0.5,
        cursor = "pointer",
        display = Display.inlineBlock,
        overflow = Overflow.auto,
        listStyleType = ListStyle.disc,
    }) {
        text(value="styled")
    }
}

window {
    main
}
