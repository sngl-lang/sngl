// Every field `Style` declares, written once. The declaration and the CSS
// mapping behind it are held in step by internal/htmlutil's
// TestStyleFieldsAllReachCSS; this fixture is the other half — it checks that
// each field is spelled and typed the way a caller writes it, on every
// registered platform.

import . "sngl:ui"

component main node {
    vbox(style={
        padding = 1,
        paddingTop = 1,
        paddingRight = 1,
        paddingBottom = 1,
        paddingLeft = 1,
        paddingX = 1,
        paddingY = 1,
        margin = 1,
        marginTop = 1,
        marginRight = 1,
        marginBottom = 1,
        marginLeft = 1,
        marginX = 1,
        marginY = 1,
        gap = 1,
        width = 10,
        minWidth = 10,
        height = 10,
        maxWidth = 10,
        maxHeight = 10,
        flex = 1.0,
        flexDirection = FlexDirection.rowReverse,
        alignItems = Alignment.stretch,
        justifyContent = Justification.spaceBetween,
        position = Position.relative,
        top = 0,
        bottom = 0,
        left = 0,
        right = 0,
        zIndex = 1,
        color = #112233,
        fontSize = 12,
        fontFamily = "serif",
        fontWeight = FontWeight.bold,
        fontStyle = FontStyle.italic,
        textAlign = TextAlign.center,
        maxLines = 2,
        background = #445566,
        borderRadius = 2,
        borderColor = #778899,
        borderWidth = 1,
        border = "1px solid #000",
        borderBottom = "1px solid #000",
        borderLeft = "1px solid #000",
        borderCollapse = "collapse",
        borderStyle = BorderStyle.dashed,
        opacity = 0.5,
        cursor = "pointer",
        display = Display.inlineBlock,
        overflow = Overflow.auto,
        listStyleType = ListStyle.disc,
    }) {
        text(value="styled")
    }
}

window {
    main
}
