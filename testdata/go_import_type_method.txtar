A program's method on a type a go: import declares is a free function taking
the value, as one on the program's own struct is: Go attaches no method to
another package's type.

deny * `func \(m \*Model\) sum` -- the method is no Model method

-- app.sngl --
import ui "sngl:ui"
import . "go:image"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
}

var bonus = 0

func Point.sum(q Point) int {
    return q.x + q.y + bonus
}

var p = Point{x=1, y=2}

ui.window(title="t") {
    ui.text(value="{p.sum()}")
    ui.button(text="go", @click {
        bonus += 1
        p = Point{x=p.x + 1, y=p.y}
    })
}
