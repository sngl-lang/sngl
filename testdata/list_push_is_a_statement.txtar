fun MainScreen() {
    val items = remember { mutableStateListOf("a") }
    val mirror = remember { mutableStateListOf<String>() }
    var count by remember { mutableStateOf(0) }

    Column {
        Button(onClick = {
            items.add("self")
        }, modifier = Modifier.safeDrawingPadding()) {
            Text(text = "self", modifier = Modifier)
        }
        Button(onClick = {
