func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setItemsMsg:
		m = m.SetItems(msg.value)
	case setMirrorMsg:
		m = m.SetMirror(msg.value)
	case setCountMsg:
		m = m.SetCount(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.items = append(m.items, "self")
		case msg.Code == tea.KeyEnter && m.__focusID == 1:
			m.items = append(m.items, "other")
			m.mirror = m.items
		case msg.Code == tea.KeyEnter && m.__focusID == 2:
			m.items = append(m.items, "nested")
			m.count = len(m.items)
