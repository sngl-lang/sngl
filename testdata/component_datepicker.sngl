import . "sngl:std"

// datepicker: state-binding fixture — mutating the bound `value`
// (date) propagates to the picker.
component main {
    var d date
    datepicker(value=d, placeholder="Pick a date")
}

func testDatepickerValueMutates(t Test, c main) {
    var fresh date
    c.d = fresh
    t.assert(true)
}
