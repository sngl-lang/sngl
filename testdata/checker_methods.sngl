component main {
    var n = 5
    var name = "hello"

    func int.double(x int) int = x * 2
    func int.noop(x int) = x
    func string.exclaim(s string) string = "{s}!"

    computed doubled = n.double()
    computed nooped = n.noop()
    computed excited = name.exclaim()
    computed nsDouble = int.double(3)
    computed nsNoop = int.noop(7)

    text(value=string(doubled))
}
