component main {
    var n = 5
    var name = "hello"

    func int.double(x int) x * 2
    func int.noop(x int) x
    func string.exclaim(s string) "{s}!"

    func doubled() n.double()
    func nooped() n.noop()
    func excited() name.exclaim()
    func nsDouble() int.double(3)
    func nsNoop() int.noop(7)

    text(value=string(doubled))
}
