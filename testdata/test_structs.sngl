struct Point {
    x int = 0
    y int = 0
}

component shapes {
    var p = Point{x=10, y=20}
    var name = "origin"
    text(value="{p.x}")
}

func testStructFieldAccess(t Test, c shapes) {
    t.assert(c.p.x == 10)
    t.assert(c.p.y == 20)
}

func testStructFieldMutation(t Test, c shapes) {
    c.p.x = 99
    t.assert(c.p.x == 99)
    t.assert(c.p.y == 20)
}
