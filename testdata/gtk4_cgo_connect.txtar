With the cgo option, gtk4 connects a handler through GLib's own
g_signal_connect_data, the handler crossing as a C callback the widget package
declares (declgen's writeConnect): the program is cgo already, so nothing in
gtk4rt stands between it and GTK. A property notification hands its handler
the GParamSpec before the context, so the switch's `notify::active` is its
event's own protocol. The test clicks the button through GTK's signal, which
reaches the closure through the dispatcher the Go file exports.

deny out/go/gtk4/model.go `gtk4rt\.Connect` -- with cgo, a handler is connected by GLib, not gtk4rt
-- app.sngl --
import ui "sngl:ui"
import go "sngl:language/go"
import test "sngl:test"

output {
    go {
        gtk4(gir="builtin", cgo=true)
    }
}

component main ui.node {
    var n = 0
    var on = false
    ui.vbox {
        ui.button #count(text="{n}", @click {
            n += 1
        })
        ui.toggle(:checked=on, label="on")
    }
}

ui.window(title="t") {
    main()
}

func testClickReachesTheClosure(t test.Test, c main) {
    c.count.click()
    c.count.click()
    t.assert(c.n == 2)
}
