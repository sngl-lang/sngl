A style field that reads state follows it on the two render-model targets.

A ternary in a style literal is hoisted by NoTernary into a `var __ltN` ahead
of the node on bubbletea, and each emitter read the field back by pattern: an
enum member was matched against its literal spelling, so a temp matched
nothing. bubbletea dropped `fontWeight`, `fontStyle` and `textAlign` and left
the temp unread, which Go refuses -- the program did not build. The same
happened to any field a terminal does not draw (`fontSize` here). Worse, an
enum-typed temp resolved to no name and was spelled as the member of that
name, `"__lt0"`, so comparing it would have compared a constant.

android keeps the ternary and dropped the three enum fields the same way; a
measurement that reads state came out as `Measurement(…).dp`, which names no
extension Compose declares. Its static `textAlign` never matched either, being
compared against `"center"` where the member evaluates to `TextAlign.CENTER`.

The markup half is the same defect one walk over: a flow's seed and a run's
`SpanStyle` were resolved at compile time, so a weight, slant or decoration
reading state was dropped on both targets, and on bubbletea the hoisted
ternary inside a flow lost its assignments.

`8px * n` is the Go emitter's: it scaled each base of a measurement by an int,
which Go does not do to a float64.

deny out/go/bubbletea/model.go `"__lt\d+"` -- a hoisted temp is a name, not the enum member of that name
deny out/go/bubbletea/model.go `\* m\.n[,}]` -- an int scales a float64 base only once converted
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `Measurement\(px = [0-9.]+\)\)\.(dp|sp)` -- a measurement reaches .dp and .sp as its magnitude
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `FontWeight\.[A-Z]+\b` -- the stdlib's enums are not declared on android; each member maps to Compose's own value

-- app.sngl --
import ui "sngl:ui"
import markup "sngl:ui/markup"

output {
    go {
        bubbletea
    }
    kotlin {
        android
    }
}

ui.window #home(title="style") {
    var on = false
    var n = 1

    ui.vbox {
        ui.button(text="toggle", @click {
            on!!
            n += 1
        })
        ui.text(value="weight", style={fontWeight=on ? bold : normal})
        ui.text(value="slant", style={fontStyle=on ? italic : normal, textAlign=on ? center : right})
        ui.text(value="still", style={textAlign=center})
        ui.text(value="left", style={textAlign=left, opacity=1.0, borderWidth=0px})
        ui.text(value="justified", style={textAlign=justify})
        ui.text(value="nested", style={textAlign=on ? center : (n > 2 ? left : right)})
        ui.text(value="grown", style={fontSize=(on ? 20px : 10px) * 2})
        ui.text(value="box", style={
            padding = on ? 16px : 8px,
            width = on ? 160px : 80px,
            fontSize = on ? 20px : 12px,
            opacity = on ? 0.5 : 1.0,
            borderWidth = on ? 1px : 0px,
            color = on ? #ff0000 : #00ff00,
        })
        ui.text(value="scaled", style={paddingLeft=8px * n})
        markup.richText(style={fontWeight=on ? bold : normal, fontSize=on ? 20px : 12px}) {
            markup.text("flow ")
            markup.run(style={
                fontWeight = on ? markup.Weight.inherit : markup.Weight.lighter,
                fontStyle = on ? markup.Slant.italic : markup.Slant.inherit,
                fontSize = on ? 18px : 0px,
                underline = on,
            }) {
                markup.text("run")
            }
            if on {
                markup.run(style={fontStyle=n > 2 ? markup.Slant.italic : markup.Slant.normal}) {
                    markup.text(" gated")
                }
            }
            markup.run(style={color=on ? color{a=0} : #ff0000}) {
                markup.text(" tinted")
            }
        }
    }
}
