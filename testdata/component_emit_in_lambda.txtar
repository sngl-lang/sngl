A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_emit_in_lambda.sngl --
// An emit written inside a lambda a handler passes on reaches the call site's
// handler, as one written in the handler itself does.

import . "sngl:test"
import . "sngl:ui"

func run(f func()) {
    f()
}

component chooser(@picked) node {
    button #pick(text="pick", @click {
        run(func() {
            picked()
        })
    })
}

component main node {
    var picks = 0
    chooser #ch(@picked { picks += 1 })
    text(value="picks={picks}")
}

func testTheEmitReachesTheHandler(t Test, c main) {
    c.ch.pick.click()
    t.assert(c.picks == 1)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
