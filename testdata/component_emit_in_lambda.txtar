// Code generated by sngl (gtk4) from component_emit_in_lambda.sngl; DO NOT EDIT.

package main

import (
	"duckfam.us/sngl/pkg/go/gtk4rt"
	"fmt"
)

// Model holds the state and widget references for this SNGL UI.
type Model struct {
	picks  int
	ch     gtk4rt.Handle
	__n0   gtk4rt.Handle
	__root gtk4rt.Handle
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	m.picks = 0
	return m
}

func Run(f func()) {
	f()
}

func (m *Model) ch_clicked_handler() {
	Run(func() {
		m.picks += 1
		gtk4rt.LabelSetText(m.__n0, ("picks=" + fmt.Sprint(m.picks)))
	})
}

func (m *Model) ch_picked_handler() {
	m.picks += 1
	gtk4rt.LabelSetText(m.__n0, ("picks=" + fmt.Sprint(m.picks)))
}

func (m *Model) Picks() int {
	return m.picks
}

func (m *Model) SetPicks(v int) {
	m.picks = v
}

func (m *Model) buildWidgetTree() {
	if m.__root != nil {
		return
	}
	m.__root = gtk4rt.BoxNew(gtk4rt.OrientationVertical, 6)
	m.ch = gtk4rt.ButtonNew()
	gtk4rt.ButtonSetLabel(m.ch, "pick")
	gtk4rt.Connect(m.ch, "clicked", m.ch_clicked_handler)
	m.__n0 = gtk4rt.LabelNew("")
	gtk4rt.LabelSetText(m.__n0, ("picks=" + fmt.Sprint(m.picks)))
	gtk4rt.BoxAppend(m.__root, m.ch)
	gtk4rt.BoxAppend(m.__root, m.__n0)
}

// BuildUI constructs the widget tree and returns the top-level window.
func (m *Model) BuildUI(app gtk4rt.Handle) gtk4rt.Handle {
	m.buildWidgetTree()
	win := gtk4rt.ApplicationWindowNew(app)
	gtk4rt.WindowSetDefaultSize(win, 480, 640)
	gtk4rt.WindowSetChild(win, m.__root)
	return win
}

// chClick fires the "clicked" signal on the #ch widget; for tests.
func (m *Model) chClick() {
	gtk4rt.Emit(m.ch, "clicked")
}
