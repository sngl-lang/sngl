package main

import (
	"fmt"
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	picks int

	ch   *widget.Button
	__n0 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.picks = 0
	return m
}

func Run(f func()) {
	f()
}

func (m *Model) ch_click_handler() {
	Run(func() {
		m.picks += 1
		m.__n0.SetText(("picks=" + fmt.Sprint(m.picks)))
	})
}

func (m *Model) ch_picked_handler() {
	m.picks += 1
	m.__n0.SetText(("picks=" + fmt.Sprint(m.picks)))
}

// chClick invokes the OnTapped callback on the #ch widget; for tests.
func (m *Model) chClick() {
	if m.ch.OnTapped != nil {
		m.ch.OnTapped()
	}
}

func (m *Model) Picks() int {
	return m.picks
}

func (m *Model) SetPicks(v int) {
	m.picks = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.ch = widget.NewButton("", nil)
	m.ch.SetText("pick")
	m.ch.OnTapped = m.ch_click_handler
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText(("picks=" + fmt.Sprint(m.picks)))
	var parts []fyne.CanvasObject
	parts = append(parts, m.ch)
	parts = append(parts, m.__n0)
	return container.NewVBox(parts...)
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
