A style field that reads state is written where the page runs: on first
render, and again wherever that state changes.

html built a style literal's CSS at build time from the fields it could read,
and a field reading state read as nothing -- so `color = active == 0 ? … : …`
wrote no color at all, in the markup, on first render or in the updater, and
`padding = 2px * active` likewise. Each such field is now a `style.setProperty`
through a helper that spells its value the way the build spells a literal one:
a color as `#rrggbb` or `rgba()`, a length with its unit (a value in several
bases as a `calc()`), an enum member kebab-cased.

The page's `hint` is lowered, so its handler carries the writes and its
updater is init-only. The row is a runtime instance, whose factory writes the
fields on creation and on every change of `on`. The fixed half of a field
(`borderWidth`'s `border-style`) comes along with the dynamic half.

deny out/none/html/index.html `setAttribute\("style", \{` -- the style attribute is written as text, never as the struct itself

-- style.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
}

component row(label string) ui.node {
    var on = false

    ui.button(
        text = label,
        style = {
            fontWeight = on ? bold : normal,
            paddingX = on ? 8px : 2px,
            borderWidth = on ? 2px : 0px,
        },
        @click { on = !on },
    )
}

ui.window {
    var active = 0
    var items = ["a", "b"]

    ui.button(text="x", @click { active = 1 })
    ui.text(value="hint", style={
        color = active == 0 ? #ffffff : #33333380,
        padding = 2px * active,
        width = active == 0 ? 10rem : 3px + 2em,
        textAlign = center,
    })
    for var it = items {
        row(label=it)
    }
    ui.button(text="more", @click { items = ["a", "b", "c"] })
}
