What a gtk4 canvas, text, flow and entry are on GTK, through the widgets
the runtime makes: peek.c prints each canvas's content size, whether it
expands and the scale its drawing is painted at, read off the cairo
context its paint is handed, for each scaling mode; a text's alignment and
what a press of it runs; a flow's
alignment and wrapping; and how many times an entry reports "changed" as
gtk4.setEntryText writes its text, which is none.

exec out/c/gtk4 -- said.txt
exec out/go/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"
import draw "sngl:ui/draw"
import md "sngl:ui/markup"

c.link(include="peek.h", pkgConfig=["gtk4"], sources=["peek.c", "peek.h"])

#[c.native("say")]
func say(s string)

#[c.native("peek_scale")]
func peekScale(ctx gtk4.CairoContext, k int)

#[c.native("peek_canvas")]
func peekCanvas(n ui.node, k int)

#[c.native("peek_label")]
func peekLabel(n ui.node, what string)

#[c.native("peek_press")]
func peekPress(n ui.node)

#[c.native("peek_watch")]
func peekWatch(n ui.node)

#[c.native("peek_changes")]
func peekChanges(n ui.node)

output {
    c { gtk4 }
    go { gtk4 }
}

var (
    ticks = 0
    clicks = 0
)

time.timer(interval=100ms, @tick {
    ticks += 1
    if ticks == 3 {
        peekCanvas(center, 0)
        peekCanvas(fit, 1)
        peekCanvas(fill, 2)
        peekCanvas(stretch, 3)
        peekLabel(words, "text")
        peekLabel(flow, "flow")
        peekPress(words)
        peekWatch(field)
    }
    if ticks == 4 {
        peekPress(words)
        gtk4.setEntryText(field, "second")
    }
    if ticks == 5 {
        peekChanges(field)
        say("clicks {clicks}")
        gtk4.quit()
    }
})

ui.window(title="t") {
    ui.vbox {
        draw.canvas #center(width=40px, height=20px) {
            gtk4.Paint(@draw(e) { peekScale(e.ctx, 0) })
        }
        draw.canvas #fit(width=40px, height=20px, scalingMode=draw.ScalingMode.fit) {
            gtk4.Paint(@draw(e) { peekScale(e.ctx, 1) })
        }
        draw.canvas #fill(width=40px, height=20px, scalingMode=draw.ScalingMode.fill) {
            gtk4.Paint(@draw(e) { peekScale(e.ctx, 2) })
        }
        draw.canvas #stretch(width=40px, height=20px, scalingMode=draw.ScalingMode.stretch) {
            gtk4.Paint(@draw(e) { peekScale(e.ctx, 3) })
        }
        ui.text #words(value="words", @click {
            clicks += 1
            say("pressed words")
        })
        md.paragraph #flow {
            md.text(value="a flow")
        }
        ui.input #field(value="first")
    }
}
-- peek.c --
#include "peek.h"

#include <stdio.h>

void say(const char *s) {
    puts(s);
    fflush(stdout);
}

static double scales[4][2];

void peek_scale(cairo_t *cr, int k) {
    cairo_matrix_t m;
    cairo_get_matrix(cr, &m);
    scales[k][0] = m.xx;
    scales[k][1] = m.yy;
}

void peek_canvas(GtkWidget *w, int k) {
    GtkDrawingArea *a = GTK_DRAWING_AREA(w);
    printf("canvas %d: content %dx%d, allocated %dx%d, hexpand %d, vexpand %d, scale %.3f %.3f\n", k,
           gtk_drawing_area_get_content_width(a), gtk_drawing_area_get_content_height(a), gtk_widget_get_width(w),
           gtk_widget_get_height(w), gtk_widget_get_hexpand(w), gtk_widget_get_vexpand(w), scales[k][0], scales[k][1]);
    fflush(stdout);
}

void peek_label(GtkWidget *w, const char *what) {
    GtkLabel *l = GTK_LABEL(w);
    printf("%s: %s, label \"%s\", xalign %.1f, wrap %d\n", what, G_OBJECT_TYPE_NAME(w), gtk_label_get_label(l),
           gtk_label_get_xalign(l), gtk_label_get_wrap(l));
    fflush(stdout);
}

/* A press of w's click gesture, as a pointer makes one. */
void peek_press(GtkWidget *w) {
    GListModel *m = gtk_widget_observe_controllers(w);
    int n = 0;
    for (guint i = 0; i < g_list_model_get_n_items(m); i++) {
        GtkEventController *c = g_list_model_get_item(m, i);
        if (GTK_IS_GESTURE_CLICK(c)) {
            n++;
            g_signal_emit_by_name(c, "pressed", 1, 0.0, 0.0);
        }
        g_object_unref(c);
    }
    g_object_unref(m);
    printf("pressed %d gesture(s)\n", n);
    fflush(stdout);
}

static int changes;

static void changed(GtkEditable *e, gpointer data) {
    changes++;
}

void peek_watch(GtkWidget *w) {
    g_signal_connect(w, "changed", G_CALLBACK(changed), NULL);
}

void peek_changes(GtkWidget *w) {
    printf("entry \"%s\", changed %d time(s)\n", gtk_editable_get_text(GTK_EDITABLE(w)), changes);
    fflush(stdout);
}
-- peek.h --
#include <gtk/gtk.h>

void say(const char *s);
void peek_scale(cairo_t *cr, int k);
void peek_canvas(GtkWidget *w, int k);
void peek_label(GtkWidget *w, const char *what);
void peek_press(GtkWidget *w);
void peek_watch(GtkWidget *w);
void peek_changes(GtkWidget *w);
-- said.txt --
canvas 0: content 40x20, allocated 1280x20, hexpand 0, vexpand 0, scale 1.000 1.000
canvas 1: content 40x20, allocated 1280x185, hexpand 1, vexpand 1, scale 9.250 9.250
canvas 2: content 40x20, allocated 1280x185, hexpand 1, vexpand 1, scale 32.000 32.000
canvas 3: content 40x20, allocated 1280x185, hexpand 1, vexpand 1, scale 32.000 9.250
text: GtkLabel, label "words", xalign 0.0, wrap 0
flow: GtkLabel, label "a flow", xalign 0.0, wrap 1
pressed words
pressed 1 gesture(s)
pressed words
pressed 1 gesture(s)
entry "second", changed 0 time(s)
clicks 2
