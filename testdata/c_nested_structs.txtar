package main

import "testing"

func TestNestedStructsCross(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.go__r0Click()
	if !((c.said == "451157 | 451157 9 5 -1 2 2026-11-1 | 451156 9 5 -1 2 2025-11-1 | 3 6 7 8 1999-12-31 | 141 kept 2 false")) { t.Errorf("assert failed: %s", "(c.said == \"451157 | 451157 9 5 -1 2 2026-11-1 | 451156 9 5 -1 2 2025-11-1 | 3 6 7 8 1999-12-31 | 141 kept 2 false\")") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
