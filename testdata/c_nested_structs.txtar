}

type setSaidMsg struct{ value string }

func SetSaidCmd(v string) tea.Cmd {
	return func() tea.Msg { return setSaidMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setSaidMsg:
		m = m.SetSaid(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.MouseClickMsg:
		if msg.Button == tea.MouseLeft {
			if s, ok := m.__clicks.At(msg.X, msg.Y); ok {
				cmds = append(cmds, m.__press(s))
			}
		}
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.said = m.run()
		}
	}
	return m, tea.Batch(cmds...)
}

// __press is a click on s: focus moves to it and s's key is pressed there,
// as a key pressed on the stop Tab reached is. A stop Tab passes over gives
// focus back once it is pressed.
func (m Model) __press(s snglStop) tea.Cmd {
	m.__focusID = s.slot
	var cmd tea.Cmd
	if s.press {
		_, cmd = m.Update(s.key)
	}
	return cmd
}

// go__r0Click activates the #go__r0 widget the way a keypress does; for tests.
func (m *Model) go__r0Click() {
	prev := m.__focusID
	m.__focusID = 0
	nm, cmd := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
	_ = m.View()
	_ = cmd
}

func (m Model) View() tea.View {
	m.__clicks.Reset()
	var content string
	contentFocused := (m.__focusID == 0)
	contentPrefix := " "
	if contentFocused {
		contentPrefix = ">"
	}
	contentText := contentPrefix + " " + fmt.Sprint(m.said)
	content = tui.Within(tui.Focused(tui.ButtonLook(BoxLook(Style{FlexDirection: "unset", AlignItems: "unset", JustifyContent: "unset", Position: "unset", FontWeight: "unset", FontStyle: "unset", TextAlign: "unset", WhiteSpace: "unset", BorderStyle: "unset", Display: "unset", ListStyleType: "unset"}, true)), contentFocused), tui.Avail(m.width), contentText).Render(contentText)
	content = m.__clicks.Mark(snglStop{slot: 0, pos: 0, press: true, key: tea.KeyPressMsg{Code: tea.KeyEnter}}, content)
	content = m.__clicks.Scan(content, 0, 0)
	v := tea.NewView(content)
	v.AltScreen = true
	v.MouseMode = tea.MouseModeCellMotion
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
