A lambda parameter that happens to share the handler's parameter name is its
own binding. The handler's event is substituted by name, so every identifier
spelled the same was replaced: `e > 1` inside the lambda emitted
`e2.target > 1`, comparing a DOM node property against an int. The lambda's
parameter now stands for itself, while the handler's own `e` still resolves to
the DOM event and reads its value through `e.target`.

deny out/none/html/index.html `e2.target` -- the lambda's parameter is an int, so nothing may read a DOM property off it
-- app.sngl --
import . "sngl:ui"

output {
    none {
        html
    }
}

component main node {
    var xs list<int> = [1, 2, 3]
    var n int = 0
    var name = ""
    input(value=name, @input(e) {
        name = e.value
        n = xs.filter(func(e int) => e > 1).length()
    })
    text(value="{n}")
}

window {
    main
}
-- out/none/html/index.html --
