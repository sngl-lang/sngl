import . "sngl:ui"
import . "sngl:test"

output {
    none { html }
}

// Children written bare are the caller's, wherever the callee inserts them, so
// #body is main's ref. What the callee writes in its own body is the callee's,
// reached through the instance's id. A population written by name is a
// declaration with a scope of its own, reached through the node it populates:
// `c.shell.head`.
//
// Slot content is written in the caller's body, so it reads the caller's
// scope -- #body interpolates main's `title`, not anything of frame's.
func testSuppliedSlotContentIsAddressable(t Test, c main) {
    t.assert(c.body.value == "Hello in the rest slot")
    t.assert(c.shell.head.value == "Hello")
    t.assert(c.shell.own.value == "frame's own")
}

// An insertion point the caller supplied nothing for renders its own block.
// Only there, so a node in it is an option.
func testUnfilledSlotRendersItsFallback(t Test, c bare) {
    t.assert(c.fallback != null && c.fallback.value == "nothing supplied")
}

component frame(children ...component, header component) node {
    vbox {
        header {}
        text #own(value="frame's own")
        children
    }
}

component bare(children ...component) node {
    vbox {
        children {
            text #fallback(value="nothing supplied")
        }
    }
}

component main node {
    var title = "Hello"

    frame #shell {
        text #body(value="{title} in the rest slot")
        component header {
            text #head(value=title)
        }
    }
}

window {
    main
}
