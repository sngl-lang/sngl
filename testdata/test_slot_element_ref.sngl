import . "sngl:ui"
import . "sngl:test"

output {
    none { html }
}

// What a call site supplies to a user component is part of the rendered tree,
// so a #id inside it resolves like any other. Both routes in: ordinary
// children fill the rest slot, `component header { … }` fills a named one.
//
// Slot content is written in the caller's body, so it reads the caller's
// scope -- #head interpolates main's `title`, not anything of frame's.
func testSuppliedSlotContentIsAddressable(t Test, c main) {
    t.assert(c.body.value == "in the rest slot")
    t.assert(c.f.head.value == "Hello")
    t.assert(c.own.value == "frame's own")
}

// An insertion point the caller supplied nothing for renders its own block.
func testUnfilledSlotRendersItsFallback(t Test, c bare) {
    t.assert(c.fallback.value == "nothing supplied")
}

component frame(children ...component, header component) node {
    vbox {
        header {}
        text #own(value="frame's own")
        children
    }
}

component bare(children ...component) node {
    vbox {
        children {
            text #fallback(value="nothing supplied")
        }
    }
}

component main node {
    var title = "Hello"

    frame #f {
        text #body(value="in the rest slot")
        component header {
            text #head(value=title)
        }
    }
}

window {
    main
}
