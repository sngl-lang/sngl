A route's markup is built at compile time, so anything it renders has to be a
literal or an expression over something known per request.

ListLambdas is the language's other withdrawal from html's route mode, for the
same reason the ternary is: `.filter`/`.map` in markup are rendered by html,
and the Go emitter writes an inline lambda directly where it does emit one, so
lowering them away would rewrite markup the JS filling the hole writes
verbatim.

The ternary case is in route_path_param_ternary.txtar, and the path var the
route mode rests on in route_path_param_param.txtar.

-- lambda.sngl --
import "sngl:platform/html"
import ui "sngl:ui"

output {
    go {
        html
    }
}

ui.window #home(title="t", href="/") {
    var nums list<int> = [1, 2, 3]

    html.span(innerText=string(nums.filter(func(n) => n > 1).length()))
}
-- out/go/html/server.go --
package ui

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleHome)
	return mux
}

func handleHome(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Write([]byte("<!-- Code generated by sngl (html) from lambda.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>t</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<span id=\"__n0\" data-sngl-id=\"__n0\">\n</span>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { nums: [1, 2, 3] };\n  function String(v) {\n    return \"\" + v;\n  }\n  var __n0 = document.querySelector('[data-sngl-id=\"__n0\"]');\n  function __sngl_init() {\n    __n0.innerText = String(state.nums.filter((n) => n > 1).length);\n  }\n  __sngl_init();\n})();\n</script>\n</body></html>\n"))
}
