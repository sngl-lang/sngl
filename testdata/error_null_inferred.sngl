import . "sngl:ui"

// `null` says nothing about what it is the absence of, so a declaration that
// names no type cannot take its type from one: it would hold a type only
// `null` is assignable to -- a context no provider could set, a var no write
// could change. Refused where the type is inferred, as an empty list is;
// annotated, the same values are fine.
func show<A>(a A) A {
    return a
}

func nothing() => null // ERROR(check) "cannot infer a type from null"

const c = null // ERROR(check) "cannot infer a type from null"

context #who(null) // ERROR(check) "cannot infer a type from null"

const nobody option<string> = null

context #someone(nobody)

component C(label = null) node { // ERROR(check) "cannot infer a type from null"
    var x = null                 // ERROR(check) "cannot infer a type from null"
    var l = [null]               // ERROR(check) "cannot infer a type from null"
    var s = {a=null}             // ERROR(check) "cannot infer a type from null"
    var t = true ? null : null   // ERROR(check) "cannot infer a type from null"
    var g = show(null)           // ERROR(check) "cannot infer a type from null"
    var ok option<string> = null
    var ok2 option<string> = show(null)
    var f = func() => null // ERROR(check) "cannot infer a type from null"

    func local() {
        var y = null // ERROR(check) "cannot infer a type from null"
    }

    text(value="x")
}

window {
    C
}
