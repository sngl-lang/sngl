import . "sngl:ui"
import . "sngl:test"

component state node {
    var count = 0
    var name = "init"

    text(value="{count}")
}

func testFirstTestMutates(t Test, c state) {
    c.count = 42
    c.name = "changed"
    t.assert(c.count == 42)
    t.assert(c.name == "changed")
}

func testSecondTestSeesFreshState(t Test, c state) {
    t.assert(c.count == 0)
    t.assert(c.name == "init")
}

func testSubtestsGetSnapshots(t Test, c state) {
    c.count = 10
    t.assert(c.count == 10)

    t.test("subtest sees parent state", func(t, c) {
        t.assert(c.count == 10)
        c.count = 99
        t.assert(c.count == 99)
    })

    t.test("another subtest also sees parent state", func(t, c) {
        t.assert(c.count == 10)
    })
}

window {
}
