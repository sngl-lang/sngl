A window's menu and its way back, in both languages, as GTK shows them: the
program prints the window's title bar, its back and menu buttons, the menu
model behind the menu button -- each item's label and action and each
submenu's items -- and the entries the popover draws, each one's role (a
check where its submenu has a checked entry), whether it is checked and
whether it can be picked. It picks entries by their actions -- one with a
label the picks count, a disabled one, which does nothing, and a size --
lets a way back and a third top-level entry come, prints it all again, picks
that entry, presses the back button, and prints it a last time.

exec out/c/gtk4 -- said.txt
exec out/go/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"

c.link(include="peek.h", pkgConfig=["gtk4"], sources=["peek.c", "peek.h"])

#[c.native("peek")]
func peek(n ui.window)

#[c.native("pick")]
func pick(n ui.window, action string)

#[c.native("press_back")]
func pressBack(n ui.window)

c.link(include="stdio.h", system=true)

#[c.native("puts")]
#[go.native("fmt", "fmt.Println")]
func say(s string)

output {
    c { gtk4 }
    go { gtk4 }
}

const sizes = ["Small", "Medium", "Large"]

var (
    ticks = 0
    size = "Medium"
    saved = 0
    closed = 0
    helped = 0
    backs = 0
    later = false
)

time.timer(interval=100ms, @tick {
    ticks += 1
    if ticks == 3 {
        peek(main)
        pick(main, "sngl.e0")
        pick(main, "sngl.e1")
        pick(main, "sngl.e4")
        later = true
    }
    if ticks == 6 {
        say("saved {saved}, closed {closed}, size {size}")
        peek(main)
        pick(main, "sngl.e5")
        pressBack(main)
    }
    if ticks == 9 {
        say("helped {helped}, backs {backs}")
        peek(main)
        gtk4.quit()
    }
})

ui.window #main(title="t", canGoBack=later && backs == 0, @back { backs += 1 }) {
    component menu {
        ui.menuItem(label="File") {
            ui.menuItem(label="Save {saved}", @select { saved += 1 })
            ui.menuItem(label="Close", disabled=true, @select { closed += 1 })
        }
        ui.menuItem(label="Size") {
            for var s = sizes {
                ui.menuItem(label=s, checked=s == size, @select { size = s })
            }
        }
        if later {
            ui.menuItem(label="Help", @select { helped += 1 })
        }
    }
    ui.text(value="body")
}
-- peek.c --
#include "peek.h"

#include <stdio.h>
#include <string.h>

static GtkWindow *window_of(GtkWidget *box) {
    return GTK_WINDOW(gtk_widget_get_root(box));
}

/* The first descendant of w of the type named, or NULL. */
static GtkWidget *find(GtkWidget *w, GType type) {
    for (GtkWidget *c = gtk_widget_get_first_child(w); c != NULL; c = gtk_widget_get_next_sibling(c)) {
        if (G_TYPE_CHECK_INSTANCE_TYPE(c, type)) return c;
        GtkWidget *f = find(c, type);
        if (f != NULL) return f;
    }
    return NULL;
}

static GtkWidget *back_button(GtkWidget *w) {
    for (GtkWidget *c = gtk_widget_get_first_child(w); c != NULL; c = gtk_widget_get_next_sibling(c)) {
        if (GTK_IS_BUTTON(c) && !GTK_IS_MENU_BUTTON(gtk_widget_get_parent(c)) &&
            g_strcmp0(gtk_button_get_icon_name(GTK_BUTTON(c)), "go-previous-symbolic") == 0) return c;
        GtkWidget *f = back_button(c);
        if (f != NULL) return f;
    }
    return NULL;
}

static void model(GMenuModel *m, int depth) {
    for (int i = 0; i < g_menu_model_get_n_items(m); i++) {
        char *label = NULL, *action = NULL;
        g_menu_model_get_item_attribute(m, i, G_MENU_ATTRIBUTE_LABEL, "s", &label);
        g_menu_model_get_item_attribute(m, i, G_MENU_ATTRIBUTE_ACTION, "s", &action);
        printf("%*s%s %s\n", depth * 2 + 2, "", label ? label : "-", action ? action : "-");
        g_free(label);
        g_free(action);
        GMenuModel *sub = g_menu_model_get_item_link(m, i, G_MENU_LINK_SUBMENU);
        if (sub != NULL) {
            model(sub, depth + 1);
            g_object_unref(sub);
        }
    }
}

static void items(GtkWidget *w) {
    for (GtkWidget *c = gtk_widget_get_first_child(w); c != NULL; c = gtk_widget_get_next_sibling(c)) {
        if (strcmp(G_OBJECT_TYPE_NAME(c), "GtkModelButton") == 0) {
            char *text = NULL;
            int role = 0;
            gboolean active = FALSE;
            g_object_get(c, "text", &text, "role", &role, "active", &active, NULL);
            printf("  item %s role %d active %d sensitive %d\n", text ? text : "-", role, active, gtk_widget_is_sensitive(c));
            g_free(text);
        }
        items(c);
    }
}

void peek(GtkWidget *box) {
    GtkWindow *win = window_of(box);
    GtkWidget *bar = gtk_window_get_titlebar(win);
    printf("bar %s\n", bar ? G_OBJECT_TYPE_NAME(bar) : "none");
    GtkWidget *back = back_button(bar ? bar : box);
    printf("back %s\n", back ? (gtk_widget_get_visible(back) ? "shown" : "hidden") : "none");
    GtkWidget *menu = bar ? find(bar, GTK_TYPE_MENU_BUTTON) : NULL;
    printf("menu %s\n", menu ? (gtk_widget_get_visible(menu) ? "shown" : "hidden") : "none");
    if (menu != NULL) {
        GtkPopover *pop = gtk_menu_button_get_popover(GTK_MENU_BUTTON(menu));
        if (pop != NULL) {
            model(gtk_popover_menu_get_menu_model(GTK_POPOVER_MENU(pop)), 0);
            items(GTK_WIDGET(pop));
        }
    }
    fflush(stdout);
}

void pick(GtkWidget *box, const char *action) {
    gtk_widget_activate_action(GTK_WIDGET(window_of(box)), action, NULL);
}

void press_back(GtkWidget *box) {
    GtkWindow *win = window_of(box);
    GtkWidget *bar = gtk_window_get_titlebar(win);
    GtkWidget *back = back_button(bar ? bar : box);
    if (back != NULL) g_signal_emit_by_name(back, "clicked");
}
-- peek.h --
#include <gtk/gtk.h>

// Prints the title bar, the back and menu buttons and the menu of the
// window whose toplevel box is box.
void peek(GtkWidget *box);

// Activates the window's action named.
void pick(GtkWidget *box, const char *action);

// Clicks the window's back button.
void press_back(GtkWidget *box);
