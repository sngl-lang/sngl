`close` is a predeclared Go identifier, so on the Go targets the node `bar`
writes as `#close` is `close__r0`. Tests taking two components make this a
build of the whole program, where bar is spliced into the window and its
node stands in the package body, which no member of bar renames; a test's
select off its own instance follows the rename itself (passReservedNodeIDs).

deny out/go/bubbletea/model_test.go `c\.closeClick` -- the trigger names the node by the id it was renamed to
deny out/go/fyne/model_test.go `c\.closeClick` -- the trigger names the node by the id it was renamed to
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component bar node {
    var closed = 0
    button #close(text="x{closed}", @click { closed = closed + 1 })
}

component other node {
    var n = 0
    button #inc(text="{n}", @click { n = n + 1 })
}

func testClose(t Test, c bar) {
    c.close.click()
    t.assert(c.closed == 1)
}

func testOther(t Test, c other) {
    c.inc.click()
    t.assert(c.n == 1)
}

window {
    bar
    other
}
