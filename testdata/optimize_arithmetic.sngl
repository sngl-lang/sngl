import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

component arithfold node {
    // Integer arithmetic
    var add = 3 + 4  // FOLD 7
    var sub = 10 - 3 // FOLD 7
    var mul = 6 * 7  // FOLD 42
    var div = 20 / 4 // FOLD 5
    var mod = 17 % 5 // FOLD 2

    // Float arithmetic
    var fadd = 1.5 + 2.5 // FOLD 4.0
    var fsub = 5.0 - 1.5 // FOLD 3.5
    var fmul = 2.5 * 4.0 // FOLD 10.0
    var fdiv = 7.5 / 2.5 // FOLD 3.0

    // Comparisons (int)
    var lt = 3 < 5   // FOLD true
    var lte = 5 <= 5 // FOLD true
    var gt = 7 > 3   // FOLD true
    var gte = 3 >= 4 // FOLD false

    // Comparisons (float)
    var flt = 1.5 < 2.5 // FOLD true
    var fgt = 3.5 > 2.5 // FOLD true

    // Boolean logic
    var band = true && true   // FOLD true
    var bor = false || true   // FOLD true
    var bandf = true && false // FOLD false
    var borf = false || false // FOLD false

    // Unary operations
    var neg = -42     // FOLD -42
    var fneg = -3.14  // FOLD -3.14
    var bnot = !false // FOLD true

    // Equality
    var eq = 5 == 5  // FOLD true
    var neq = 5 != 3 // FOLD true

    // String concat
    var cat = "hello" + " " + "world" // FOLD "hello world"

    // String comparisons
    var slt = "abc" < "def"   // FOLD true
    var sgt = "xyz" > "abc"   // FOLD true
    var slte = "abc" <= "abc" // FOLD true
    var sgte = "def" >= "abc" // FOLD true

    // Ternary
    var tern = true ? 1 : 2   // FOLD 1
    var ternf = false ? 1 : 2 // FOLD 2

    text(value="{add}")
}

func testFoldedValues(t Test, c arithfold) {
    t.assert(c.add == 7)
    t.assert(c.sub == 7)
    t.assert(c.mul == 42)
    t.assert(c.div == 5)
    t.assert(c.mod == 2)
    t.assert(c.neg == -42)
    t.assert(c.bnot == true)
    t.assert(c.eq == true)
    t.assert(c.neq == true)
    t.assert(c.cat == "hello world")
    t.assert(c.tern == 1)
    t.assert(c.ternf == 2)
}

app.window {
}
