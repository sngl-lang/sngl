An effect keyed on a prop of a component built at run time re-mounts when the
prop changes, on every target.

`Watch` is under a `for` and has state, so it is built at run time and `tag`
reaches it through a setter. passEffect settles after every write to a var a
key reads, and ran while `tag` was still a parameter nothing could write; the
setter passComponentProps then gave it wrote the cell and settled nothing, so
html, fyne and gtk4 kept the first mount. The setter now settles the brackets
whose keys read its cell.

The prop shares its name with the page's `tag`, which android's test mode
rewrites to `state.tag` by name: the rewrite reached `Watch`'s own prop too,
in a composable with no `state` in scope.

The test runs on every target: the mount under `x`, then the re-mount under
`y` after the click.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `DisposableEffect\(state\.` -- the key is Watch's own prop
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component Watch(tag string, @seen string) node {
    var n = 0

    vbox {
        text(value="watch {tag} {n}")
        effect(on=tag, @mount(k) { seen(k) })
    }
}

component main node {
    var items = ["a"]
    var tag = "x"
    var log = ""

    vbox {
        button #bump(text="go", @click { tag = "y" })
        for var i = items {
            Watch(tag="{i}{tag}", @seen(s) { log = log + s + " " })
        }
    }
}

func testRemount(t Test, c main) {
    t.assert(c.log == "ax ")
    c.bump.click()
    t.assert(c.log == "ax ay ")
}

window {
    main
}
