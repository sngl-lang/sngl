package main

import "testing"

func TestRemount(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.log == "ax ")) { t.Errorf("assert failed: %s", "(c.log == \"ax \")") }
	c.bumpClick()
	if !((c.log == "ax ay ")) { t.Errorf("assert failed: %s", "(c.log == \"ax ay \")") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
