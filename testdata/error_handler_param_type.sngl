// A handler parameter's type is optional and must agree with the signature
// the compiler already holds.

import . "sngl:ui"

component main node {
    var count = 0
    effect(on=count, @update(v string) { // ERROR(check) "cannot use string as int for parameter \"v\" of @update"
        count = 1
    })
    vbox {
        input(value="", @change(e bool) { // ERROR(check) "cannot use bool as string for parameter \"e\" of @change"
            count = 1
        })
    }
}

window {
    main
}
