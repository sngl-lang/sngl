// A window's #id declares a binding, so a name the file already declares is a
// clash and is reported at the window. `window #home` and a `const home` are
// two declarations of one name in one scope, and the read that reaches for
// `home` afterwards can only mean one of them.
//
// Distinct from error_window_id_collision.sngl, which is two windows sharing
// an id: both are the package's one-name rule, and this is the half a
// declaration of another kind supplies.
import . "sngl:ui"

const home int = 1

window #home(title="Home") { // ERROR(check) "home is already declared in this scope"
    text(value="hi")
}
