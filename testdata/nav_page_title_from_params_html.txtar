A window titled `pages.current.title`, where a page gives `titleOf`, served in
route mode: the home document's title folds to its <title>, and the item's,
which the params its route binds name, is set as its script starts
(`document.title`), since nothing knows it before the request.

-- app.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    go {
        html
    }
}

struct Item {
    name string
}

func named(p Item) => "Item {p.name}"

ui.window #w(title=pages.current.title) {
    nav.stack #pages {
        nav.page #home(href="/", title="Home") {
            ui.text(value="home")
        }
        nav.page #item(href=`/items/{name}`, title="Item", params=Item{name="first"}, titleOf=named) {
            component content(p) {
                ui.text(value=p.name)
            }
        }
    }
}
-- out/go/html/server.go --
package main

import (
	"fmt"
	"log"
	"net"
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleHome)
	mux.HandleFunc("GET /items/{name}", handleItem)
	return mux
}

// Item is what route "/items/{name}" takes from the request.
type Item struct {
	Name string
}

func handleHome(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Home</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<span>home</span>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { visible__inst0: true };\n})();\n</script>\n</body></html>\n"))
}

func handleItem(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<span id=\"$0\">\n</span>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { p: null, visible__inst0: true };\n  state.p = ((__m) => __m ? { ...{}, name: decodeURIComponent(__m[1]) } : {})(location.pathname.match(/^\\/items\\/([^/]*)$/));\n  document.title = \"Item \" + state.p.name;\n  function Item(name) {\n    return { name };\n  }\n  var $0 = document.getElementById(\"$0\");\n  function __sngl_init() {\n    $0.textContent = state.p.name;\n  }\n  __sngl_init();\n})();\n</script>\n</body></html>\n"))
}

func main() {
	ln, err := net.Listen("tcp", ":8080")
	if err != nil {
		log.Fatal(err)
	}
	host, port, _ := net.SplitHostPort(ln.Addr().String())
	if ip := net.ParseIP(host); ip == nil || ip.IsUnspecified() {
		host = "localhost"
	}
	fmt.Println("http://" + net.JoinHostPort(host, port))
	log.Fatal(http.Serve(ln, Handler()))
}
