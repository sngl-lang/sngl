A call handing a node's handle to a function that writes a two-way prop
through it is inlined (HandleParams), and an allocation another parameter
borrows is bound to a local the inlined body reads. The release follows the
body, where the call's statement ends. ReleaseTemps used to take any
synthesized local holding an allocation for one ErrorCatch bound ahead of a
call, and released this one after the body's first statement, before the
second read it.

deny out/go/bubbletea/model.go `[Cc]lose\w*\(__arg\d+\)\n[^\n]*__arg\d+` -- nothing reads the argument after its release

-- app.sngl --
import macro "sngl:macro"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

#[macro.owned(close)]
struct file {
    fd int
}

func close(f file) {
}

func open(fd int) => file{fd=fd}

component toggle(:on bool = false) ui.node {
    ui.checkbox(label="on", :checked=on)
}

func toggle.setup(t toggle, f file) {
    t.on = f.fd > 0
    t.on = f.fd > 1
}

component main ui.node {
    var shown = false
    var n = 1

    ui.vbox {
        toggle #box(:on=shown)
        ui.button(text="setup", @click {
            box.setup(open(n))
        })
    }
}

ui.window {
    main()
}
