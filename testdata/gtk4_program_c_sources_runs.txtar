A gtk4 program's own C is compiled into it in Go as in C, whatever else
it declares. A function the program declares with both a C name and a Go
spelling of its own -- `say`, puts in C and fmt.Println in Go -- is no
wrapper of a package's C, so it leaves the program calling twice, which
twice.c defines, directly: Go once read it as a wrapper and took the
program's own C for a wrapper package's, compiling none of it, so the link
found no `twice`.

exec out/c/gtk4 -- said.txt
exec out/go/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"

c.link(include="twice.h", sources=["twice.c", "twice.h"])

#[c.native("twice")]
func twice(n int) int

c.link(include="stdio.h", system=true)

#[c.native("puts")]
#[go.native("fmt", "fmt.Println")]
func say(s string)

output {
    c { gtk4 }
    go { gtk4 }
}

var said = false

time.timer(interval=100ms, @tick {
    if !said {
        said = true
        say("twice 21 is {twice(21)}")
        gtk4.quit()
    }
})

ui.window(title="t") {
    ui.text(value="t")
}
-- twice.c --
#include "twice.h"

int twice(int n) {
    return n * 2;
}
-- twice.h --
// n, twice.
int twice(int n);
-- said.txt --
twice 21 is 42
-- out/c/gtk4/main.c --
