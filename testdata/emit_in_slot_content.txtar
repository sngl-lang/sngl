An event emitted from inside a platform container's slot content reaches the
caller's handler.

passInlinePure substituted an override's slots before its events, so the walk
that replaces an emit with the call site's handler body also walked the
content the caller had just spliced in. An emit there names the *caller's*
event; matched against the override's handlers it found none and was dropped
as an event nobody subscribed to. `picked(i)` inside `hbox { ... }` was lost
the moment the hbox override inlined, whether or not a loop sat between them.
The handler-transfer rule then carried `@picked` onto the hbox's element, and
clicking a button did nothing, on every target. The same order in
passNoInlineComponents is `emit_in_callee_populations.txtar`.

deny * `emit\(` -- an emit is substituted away by lowering
deny out/none/html/index.html `addEventListener\("picked"` -- the emit is substituted into the click, not left as a DOM event nothing dispatches
-- app.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
    }
    none {
        html
    }
    kotlin {
        android
    }
}

component Picker(@picked(v int)) ui.node {
    ui.hbox {
        for var i = [1, 2, 3] {
            ui.button(text="p{i}", @click { picked(i) })
        }
    }
}

component Stepper(@changed(v int)) ui.node {
    ui.hbox {
        ui.button(text="inc", @click { changed(5) })
    }
}

ui.window {
    var got = 0

    ui.vbox {
        Picker(@picked(v) { got = v })
        ui.text(value="got={got}")
        Stepper(@changed(n) { got = n })
    }
}
