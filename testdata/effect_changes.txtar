An effect's list change events, lowered by passEffect.

Each bracket with a change handler keeps a queue -- three parallel lists of a
kind, an index and an item -- which a write the bracket handles appends to
through a note function: after a push, an insert, a write inside an element
and a clear, and before a remove, while the removed item is still there. The
scope's settle drains the queue in the order the writes were made, then runs
`@update` if a write no change handler describes reached the key. Which a
write is follows from comparing its target's path with the key's, so a write
beside a field key (`h.other`) reports nothing, and one replacing what holds
it (`h = …`) is `@update`'s.

On android a list in a data class's field is a read-only `List`, so
`h.items.push(2)` rebuilds it and copies the path back, as a field write does.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `h__inst0\.items\.add\(` -- a data class's list field is read-only; the write rebuilds it
deny out/go/bubbletea/model.go `todos__inst0\[__i\+1:\]\.\.\.\)\n\t*\}\n\t*m\.__effect0_note_remove` -- a remove is noted before the write, while the removed item is still there
deny out/none/html/index.html `\}\)\(state\.todos__inst0, __effect_at0\);\n\s*__effect0_note_remove` -- a remove is noted before the write, while the removed item is still there
deny out/go/bubbletea/model.go `m\.h__inst0\.Other = 3\n\t*m\.__effect1_dirty = true` -- a write beside a field key reports nothing
deny out/none/html/index.html `__effect0_items\.push\(state\.todos__inst0\[at\]\)` -- the queued item is a copy, not the element JavaScript holds by reference
deny out/go/bubbletea/model.go `m\.h__inst0 = Holder\{Items: \[\]int\{5\}, Other: 0\}\n\t*m\.__effects0_settle` -- replacing what holds a field key reaches @update

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

struct Todo {
    title string
    done  bool = false
}

struct Holder {
    items list[int]
    other int = 0
}

component todoList ui.node {
    var todos list[Todo] = []
    var saved list[string] = []

    effect(
        on = todos,
        @update(t) {
            saved.push("all {t.length()}")
        },
        @insert(at, t) {
            saved.push("insert {at} {t.title}")
        },
        @remove(at, t) {
            saved.push("remove {at} {t.title}")
        },
        @set(at, t) {
            saved.push("set {at} {t.done}")
        },
    )

    func add(title string) {
        todos.push(Todo{title=title})
    }

    func toggle(i int) {
        for var k, &todo = todos {
            if k == i {
                todo.done = !todo.done
            }
        }
    }

    func dropLast() {
        todos.remove(todos.length() - 1)
    }

    func reset() {
        todos.clear()
    }

    ui.button(text="add", @click {
        add("a")
    })
    ui.button(text="toggle", @click {
        toggle(0)
    })
    ui.button(text="drop", @click {
        dropLast()
    })
    ui.button(text="reset", @click {
        reset()
    })
    ui.text(value=saved.join(","))
}

component field ui.node {
    var h = Holder{items=[1]}
    var n = 0

    effect(
        on = h.items,
        @update {
            n += 1
        },
        @insert(at, x) {
            n += x
        },
    )

    ui.button(text="push", @click {
        h.items.push(2)
    })
    ui.button(text="sibling", @click {
        h.other = 3
    })
    ui.button(text="swap", @click {
        h = Holder{items=[5]}
    })
    ui.text(value="{n}")
}

ui.window(title="Changes") {
    todoList
    field
}
