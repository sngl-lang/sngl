Content a recursive component hands its own recursive call reads the scope it
was written in. `frame(n=n - 1) { text(value="level {n}") }` sits in frame's
body, so its `n` is the enclosing frame's, and `frame(n=2)` renders "top",
"level 2", "level 1".

The optimizer unrolls the recursion by splicing each call, and the content's
`n` is the very parameter the callee rebinds: bound with the callee's value it
rendered "level 1", "level 0" on html, silently. The interpreter, which mounts
content in the caller's scope, always answered "level 2", "level 1".

deny * `level 0` -- the deepest content is the n=1 frame's, written where n is 1

-- m.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        bubbletea
    }
}

component frame(n int, content ...component ui.node) ui.node {
    ui.vbox {
        content
        if n > 0 {
            frame(n=n - 1) {
                ui.text(value="level {n}")
            }
        }
    }
}

ui.window(title="t") {
    frame(n=2) {
        ui.text(value="top")
    }
}
