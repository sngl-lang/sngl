A type owned by what it holds has a release the lowering synthesizes once per
type on the program's package -- `__release_list_file` loops the list newest
first, `__release_option_file` tests for a value, `__release_entry` releases
the struct's owned field -- and a var of one is released on overwrite and at
unmount through it, as a var of the owned type is. An element write releases
what it replaces once the new value is in place, `remove` what it took out,
and `clear` what the list held. The temp `pair` answers is released after
its statement, and the literal of constants is made once.

deny * `close\(close` -- a composed release calls the element's, never itself

-- app.sngl --
import macro "sngl:macro"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
    kotlin {
        android
    }
    none {
        html
    }
}

#[macro.owned(close)]
struct file {
    fd int
}

var closed list[int] = []

func close(f file) {
    closed.push(f.fd)
}

func open(fd int) => file{fd=fd}

const func fixed(fd int) => file{fd=fd}

func count(fs list[file]) => fs.length

func pair(a int, b int) => [open(a), open(b)]

struct entry {
    name string
    f    file
}

component page ui.node {
    var fs = [open(1)]
    var byName map[string, file] = {"a"=open(2)}
    var current option[file] = null
    var e = entry{name="first", f=open(3)}
    var n = 0

    ui.vbox {
        ui.button(text="push", @click {
            fs.push(open(n))
        })
        ui.button(text="replace", @click {
            fs[0] = open(n)
            byName["a"] = open(n)
            e.f = open(n)
            current = open(n)
        })
        ui.button(text="remove", @click {
            fs.remove(n)
        })
        ui.button(text="clear", @click {
            fs.clear()
        })
        ui.button(text="count", @click {
            n = count(pair(n, 1)) + count([fixed(8), fixed(9)])
        })
        ui.text(value="{fs.length} {byName.length} {e.name} {n}")
    }
}

ui.window(title="t") {
    page
}
