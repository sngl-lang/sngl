	m.__built = true
	m.__n0 = fynelayout.NewToplevel()
	m.__n0.SetTitle("App")
	m.__n0.SetVisible(m.visible__inst0)
	m.__n0.OnClosed = m.__n0_closed_handler
	m.__n0.OnVisible = m.__n0_visible_handler
	m.__n2 = container.NewVBox()
	m.__n3 = widget.NewLabel("")
	m.__n3.SetText("App page")
	m.__n2.Add(m.__n3)
