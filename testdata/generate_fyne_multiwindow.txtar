Regression test for #36: multiple window blocks + link navigation.
All windows must be emitted; navigate() must exist; link with internal
href must call navigate instead of opening the OS browser.

Per-window build methods

Navigation method

Window container fields on Model (use \s+ for alignment spaces)

BuildUI hides inactive window on startup; navigate shows/hides containers

Link-tap interception: the link's OnTapped override that calls
navigate("settings") is not yet wired through the lowered IR path —
link has no Event-binding declaration in fyne.sngl, so the
AttachHandler intrinsic finds no target. The remaining scaffold
(above) is correct.
Tracked: declarative-lowering href-to-navigate rewrite, or add an
Event binding to link in fyne.sngl.
grep 'm\.navigate\("settings"\)' out/model.go
-- app.sngl --
import . "sngl:ui"
import . "sngl:app"

output { go { fyne(main=true) } }

component main {
    window #app(title="App") {
        vbox {
            text(value="App page")
            link(href="settings", text="Go to Settings")
        }
    }
    window #settings(title="Settings") {
        vbox {
            text(value="Settings page")
        }
    }
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	activeWindow      string
	windowAppBox      *fyne.Container
	windowSettingsBox *fyne.Container
	__n0              *fyne.Container
	__n1              *widget.Label
	__n2              *widget.Hyperlink
	__n3              *fyne.Container
	__n4              *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

// BuildUI creates the widget tree. Call once.
func (m *Model) BuildUI() fyne.CanvasObject {
	if m.activeWindow == "" {
		m.activeWindow = "app"
	}
	m.windowAppBox = container.NewStack(m.buildWindowApp())
	m.windowSettingsBox = container.NewStack(m.buildWindowSettings())
	if m.activeWindow != "app" {
		m.windowAppBox.Hide()
	}
	if m.activeWindow != "settings" {
		m.windowSettingsBox.Hide()
	}
	var windowObjects []fyne.CanvasObject
	windowObjects = append(windowObjects, m.windowAppBox)
	windowObjects = append(windowObjects, m.windowSettingsBox)
	return container.NewStack(windowObjects...)
}

func (m *Model) navigate(name string) {
	m.activeWindow = name
	m.windowAppBox.Hide()
	m.windowSettingsBox.Hide()
	switch name {
	case "app":
		m.windowAppBox.Show()
	case "settings":
		m.windowSettingsBox.Show()
	}
}

func (m *Model) buildWindowApp() fyne.CanvasObject {
	m.__n0 = container.NewVBox()
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText("App page")
	m.__n0.Add(m.__n1)
	m.__n2 = widget.NewHyperlink("", nil)
	m.__n0.Add(m.__n2)
	return m.__n0
}

func (m *Model) buildWindowSettings() fyne.CanvasObject {
	m.__n3 = container.NewVBox()
	m.__n4 = widget.NewLabel("")
	m.__n4.SetText("Settings page")
	m.__n3.Add(m.__n4)
	return m.__n3
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
