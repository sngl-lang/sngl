Regression test for #36: several `window` blocks in one package, plus a link
between them. Every window is emitted as its own buildWindow<Name> method, and
each is an OS window of its own: BuildUI wraps each one's content in the
snglWindow record that shows it (window_several.txtar).

A link does not navigate between them, and is not meant to: a window is a
surface and a link names a destination, which is `sngl:ui/nav`'s page
(SNGL_PLUGINS.md, decision 15). fyne's in-window switcher, which is what an
href would have navigated, is gone with it; the link still opens the OS
browser.

-- app.sngl --
import . "sngl:ui"

output { go { fyne(main=true) } }

window #app(title="App") {
    vbox {
        text(value="App page")
        link(href="settings", text="Go to Settings")
    }
}

window #settings(title="Settings") {
    vbox {
        text(value="Settings page")
    }
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	app      *snglWindow
	settings *snglWindow
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

// snglWindow is one window of the program: the fyne window the host shows,
// around a widget tree the program builds once.
type snglWindow struct {
	title   string
	content fyne.CanvasObject
	onClose func()
	w       fyne.Window
	mounted bool
	open    bool
}

var (
	snglApp     fyne.App
	snglStarted bool
	snglHidden  bool
	snglWindows []*snglWindow
	snglAnchor  fyne.Window
)

// Mount says the window exists. Before the loop starts it is created when the
// loop does; after, it is created and put on screen at once.
func (w *snglWindow) Mount() {
	if w.mounted {
		return
	}
	w.mounted = true
	snglWindows = append(snglWindows, w)
	if snglStarted {
		w.create()
		w.Open()
	}
}

// Unmount closes the fyne window. The content is kept for a later Mount.
func (w *snglWindow) Unmount() {
	if !w.mounted {
		return
	}
	w.mounted = false
	w.open = false
	for i, x := range snglWindows {
		if x == w {
			snglWindows = append(snglWindows[:i], snglWindows[i+1:]...)
			break
		}
	}
	if w.w != nil {
		w.w.SetContent(container.NewStack())
		w.w.Close()
		w.w = nil
	}
}

// Open puts a mounted window on screen.
func (w *snglWindow) Open() {
	w.open = true
	if w.w != nil {
		w.w.Show()
	}
}

// Close takes the window off screen; Open brings it back as it was.
func (w *snglWindow) Close() {
	w.open = false
	if w.w != nil {
		w.w.Hide()
	}
}

func (w *snglWindow) create() {
	if w.w != nil {
		return
	}
	w.w = snglApp.NewWindow(w.title)
	// fyne lays SetContent's tree out against the current size, so the
	// content goes in before the resize.
	w.w.SetContent(w.content)
	w.w.Resize(fyne.NewSize(480, 640))
	w.w.SetCloseIntercept(w.closeRequested)
}

// closeRequested is the window manager's close. The handler decides what it
// means; with none, the window hides. Either way a close that leaves nothing
// on screen ends the program, unless it started with nothing on screen.
func (w *snglWindow) closeRequested() {
	if w.onClose != nil {
		w.onClose()
	} else {
		w.Close()
	}
	if snglHidden {
		return
	}
	for _, x := range snglWindows {
		if x.open {
			return
		}
	}
	snglApp.Quit()
}

// snglRunWindows runs the loop over the windows mounted so far and those
// mounted later. show puts the mounted ones on screen at start.
func snglRunWindows(show bool) {
	snglHidden = !show
	snglAnchor = snglApp.NewWindow("")
	snglStarted = true
	for _, w := range append([]*snglWindow(nil), snglWindows...) {
		w.create()
		if show || w.open {
			w.Open()
		}
	}
	snglApp.Run()
}

// BuildUI creates every window's widget tree. Call once.
func (m *Model) BuildUI() fyne.CanvasObject {
	if m.app != nil {
		return m.app.content
	}
	m.app = &snglWindow{title: "App", content: m.buildWindowApp()}
	m.app.Mount()
	m.settings = &snglWindow{title: "Settings", content: m.buildWindowSettings()}
	m.settings.Mount()
	return m.app.content
}

func (m *Model) buildWindowApp() fyne.CanvasObject {
	__n0 := container.NewVBox()
	__n1 := widget.NewLabel("")
	__n1.SetText("App page")
	__n0.Add(__n1)
	__n2 := widget.NewHyperlink("", nil)
	__n0.Add(__n2)
	return __n0
}

func (m *Model) buildWindowSettings() fyne.CanvasObject {
	__n3 := container.NewVBox()
	__n4 := widget.NewLabel("")
	__n4.SetText("Settings page")
	__n3.Add(__n4)
	return __n3
}

func main() {
	snglApp = app.New()
	m := New()
	m.BuildUI()
	snglRunWindows(true)
	_ = os.Stderr
}
