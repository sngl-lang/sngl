Regression test for #36: several `window` blocks in one package, plus link
navigation. Every window is emitted as its own buildWindow<Name> method with a
container field on the Model, BuildUI hides the inactive one at startup, and
navigate() shows and hides those containers.

What is not wired yet is the link's own tap interception. `link` declares no
event binding in fyne.sngl, so the AttachHandler intrinsic finds no target and
nothing rewrites an internal href into `m.navigate("settings")` -- the link
still opens the OS browser. The scaffold around it, above, is correct. The fix
is either a declarative-lowering href-to-navigate rewrite or an event binding
on link.

-- app.sngl --
import . "sngl:ui"

output { go { fyne(main=true) } }

window #app(title="App") {
    vbox {
        text(value="App page")
        link(href="settings", text="Go to Settings")
    }
}

window #settings(title="Settings") {
    vbox {
        text(value="Settings page")
    }
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	activeWindow      string
	windowAppBox      *fyne.Container
	windowSettingsBox *fyne.Container
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

// BuildUI creates the widget tree. Call once.
func (m *Model) BuildUI() fyne.CanvasObject {
	if m.activeWindow == "" {
		m.activeWindow = "app"
	}
	m.windowAppBox = container.NewStack(m.buildWindowApp())
	m.windowSettingsBox = container.NewStack(m.buildWindowSettings())
	if m.activeWindow != "app" {
		m.windowAppBox.Hide()
	}
	if m.activeWindow != "settings" {
		m.windowSettingsBox.Hide()
	}
	var windowObjects []fyne.CanvasObject
	windowObjects = append(windowObjects, m.windowAppBox)
	windowObjects = append(windowObjects, m.windowSettingsBox)
	return container.NewStack(windowObjects...)
}

func (m *Model) navigate(name string) {
	m.activeWindow = name
	m.windowAppBox.Hide()
	m.windowSettingsBox.Hide()
	switch name {
	case "app":
		m.windowAppBox.Show()
	case "settings":
		m.windowSettingsBox.Show()
	}
}

func (m *Model) buildWindowApp() fyne.CanvasObject {
	__n0 := container.NewVBox()
	__n1 := widget.NewLabel("")
	__n1.SetText("App page")
	__n0.Add(__n1)
	__n2 := widget.NewHyperlink("", nil)
	__n0.Add(__n2)
	return __n0
}

func (m *Model) buildWindowSettings() fyne.CanvasObject {
	__n3 := container.NewVBox()
	__n4 := widget.NewLabel("")
	__n4.SetText("Settings page")
	__n3.Add(__n4)
	return __n3
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
