// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	__ctx_theme string
	caught      string
	__focusID   int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.__ctx_theme = "light"
	m.caught = ""
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Caught() string {
	return m.caught
}

func (m Model) SetCaught(v string) Model {
	m.caught = v
	return m
}

type setCaughtMsg struct{ value string }

func SetCaughtCmd(v string) tea.Cmd {
	return func() tea.Msg { return setCaughtMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setCaughtMsg:
		m = m.SetCaught(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			{
				e := ErrorEvent{Message: "boom", Kind: ""}
				_ = e
				m.caught = m.__ctx_theme
			}
		}
	}
	return m, tea.Batch(cmds...)
}

// goClick activates the #go widget the way a keypress does; for tests.
func (m *Model) goClick() {
	prev := m.__focusID
	m.__focusID = 0
	nm, _ := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = lipgloss.NewStyle().Render(part0Prefix + " " + fmt.Sprint("Go"))
	parts = append(parts, part0)
	var part1 string
	part1 = lipgloss.NewStyle().Render(fmt.Sprint(m.caught))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
