Regression test for the if-multi-child variable collision.

When an `if` body contains more than one statement under a single parent
slot, every child rendered into the *same* `<innerVar>` and prior children
would be clobbered. Worse, any child that itself emitted
`<innerVar>Children` (every container does) collided with its sibling and
the generated Go failed to compile with "redeclared in this block".

Post-Plan-C the window body flows through WalkLowered and the
declarative lowering pass emits AppendChild for every NodeInst
declared inside conditional/loop bodies, threaded back to the
surrounding parent. Verify each `text(...)` widget inside the `if`
is constructed AND added to the surrounding vbox.

The vbox is __n3; the three text children are __n0..__n2 (allocated in pass-1).
The labels do not escape __renderSlot0 (created, added, and tracked in
m.__slot0 all within that scope), so the node-escape lower pass emits them
as distinct function-local variables — which also rules out the original
variable collision this test guards against.

Each label inside the if-body is appended to the parent via __renderSlot0.
-- app.sngl --
import . "sngl:ui"
import . "sngl:app"

output { go { fyne(main=true) } }

component main {
    var visible = true

    window #app(title="t") {
        vbox {
            if visible {
                text(value="A")
                text(value="B")
                text(value="C")
            }
        }
    }
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	visible bool
	__root  *fyne.Container
	__slot0 []fyne.CanvasObject

	__n3 *fyne.Container
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.visible = true
	m.__root = container.NewVBox()
	m.__slot0 = nil
	return m
}

func (m *Model) __renderSlot0(container *fyne.Container) {
	for _, __entry := range m.__slot0 {
		container.Remove(__entry)
	}
	m.__slot0 = nil
	if m.visible {
		__n0 := widget.NewLabel("")
		__n0.SetText("A")
		container.Add(__n0)
		m.__slot0 = append(m.__slot0, __n0)
		__n1 := widget.NewLabel("")
		__n1.SetText("B")
		container.Add(__n1)
		m.__slot0 = append(m.__slot0, __n1)
		__n2 := widget.NewLabel("")
		__n2.SetText("C")
		container.Add(__n2)
		m.__slot0 = append(m.__slot0, __n2)
	}
}

func (m *Model) Visible() bool {
	return m.visible
}

func (m *Model) SetVisible(v bool) {
	m.visible = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n3 = container.NewVBox()
	m.__renderSlot0(m.__n3)
	content := fyne.CanvasObject(m.__n3)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
