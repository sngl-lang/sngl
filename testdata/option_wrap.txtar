A bare `T` written where an `option<T>` is declared is a conversion the
checker inserts, the same way it inserts one for every other implicit
coercion -- and the same way, each language spells it for itself.

Go's option<T> is *T, so the promotion needs a box; Kotlin's is T? and
JavaScript's is the value itself, and both emit the operand unchanged. The box
is a helper taking its argument by value, not `&`: `&` needs an addressable
operand, so `&nextBox()` does not compile, and where it does compile it aliases
-- a SNGL struct is a value, so a write to `b` after `Holder{inner=b}` must not
reach what the holder kept.

The read back out is the narrowing unwrap, here through a field: `*` binds
looser than a selector in Go, so the deref parenthesises itself.

deny out/go/bubbletea/model.go `Inner: &` -- the promotion boxes a copy, and & would hand the option a window onto the operand
deny out/go/bubbletea/model.go `\(\*Box\)\(` -- a cast is what the generic conversion path emits and it does not compile
deny out/go/bubbletea/model.go `\*\(m\.h\.Inner\)\.Value` -- an unparenthesised deref of a narrowed path reads the field, not the pointer

-- app.sngl --
import . "sngl:ui"
import app "sngl:app"

output {
    go {
        bubbletea
    }
    none {
        html
    }
    kotlin {
        android
    }
}

struct Box {
    value int = 0
}

struct Holder {
    inner option<Box> = null
}

component main ui {
    var b = Box{value=3}
    var h = Holder{inner=b}
    var seen = 0

    button(text="read", @click {
        if h.inner != null {
            seen = h.inner.value
        }
    })
    text(value=string(seen))
}

app.window {
    main
}
