Tests taking two different components cannot share a build rooted at either,
so the archive is built as the program is written, and each test's instance is
the one the program renders: `one` and `two` are each spliced into the window
once, and a test reaches what each splice made of its state, its nodes and its
methods (internal/lower/test_reach.go). Both write a `#b` their tests reach,
so the second is `b__own0` (passTestRefOwner), and `two`'s test clicks that one.

`sngl test`, which roots a build at each component, is
cmd/sngl/testdata/test_reach_nested_runs.txt.

deny out/go/bubbletea/model_test.go `c\.(a|z|b\.)\b` -- every member is reached through what the splice made of it
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

component one node {
    var a = 0
    func reset() {
        a = 0
    }
    button #b(text="a", @click {
        a = a + 1
    })
}

component two node {
    var z = 10
    button #b(text="z", @click {
        z = z + 1
    })
}

func testOne(t Test, c one) {
    c.b.click()
    t.assert(c.a == 1)
    c.reset()
    t.assert(c.a == 0)
}

func testTwo(t Test, c two) {
    c.b.click()
    t.assert(c.z == 11)
}

window {
    one
    two
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
