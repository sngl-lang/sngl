A recursive component forwarding the children it was handed to its own
recursion, from two callers handing it different children.

Each level of `frame` renders what its caller handed it and hands the same to
the level below, so the recursive site's children are an insertion of
`frame`'s own slot. Every copy of `frame` holds a clone of that one site, and
a copy keyed by the site alone was made for the first caller and reused by the
second: BETA's tree rendered ALPHA from the second level down. The key now
includes where the site's children were cloned from, which for a forwarded
insertion is the caller's own children, so ALPHA's levels share one copy and
BETA's another -- and the recursion still ends, since a copy meeting its own
site with the children it was made for reuses itself.
-- app.sngl --
import . "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
    none {
        html
    }
}

component frame(n int, content ...component node) node {
    var open = true

    vbox {
        content
        if n > 0 {
            frame(n=n - 1) {
                content
            }
        }
    }
}

var depth = 2

window {
    vbox {
        frame(n=depth) {
            text(value="ALPHA")
        }
        frame(n=depth) {
            text(value="BETA")
        }
        button(text="deeper", @click { depth += 1 })
    }
}
