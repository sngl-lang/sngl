package main

import "testing"

func TestOperandOnce(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.onceClick()
	if !((c.got == 101)) { t.Errorf("assert failed: %s", "(c.got == 101)") }
	if !((c.n == 1)) { t.Errorf("assert failed: %s", "(c.n == 1)") }
}

func TestPathInPlace(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.pathClick()
	if !((c.got == 7)) { t.Errorf("assert failed: %s", "(c.got == 7)") }
}

func TestNestedOnce(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.nestedClick()
	if !((c.got == 101)) { t.Errorf("assert failed: %s", "(c.got == 101)") }
	if !((c.n == 1)) { t.Errorf("assert failed: %s", "(c.n == 1)") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
