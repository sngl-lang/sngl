A spread's operand is evaluated once, whatever number of fields it fills.
`add(...next())` expands to named arguments, each a read of one field, and
each read used to evaluate the operand again: next() ran twice, so got was
201 where the interpreter's reading of the program is 101. passSpreadOnce
binds a computed operand to a temp ahead of the statement, which is where the
interpreter evaluates it too; a plain path like `...p` is read in place.

The nested spread shows the order: the inner operand is bound first, then the
outer one that reads it.

deny out/go/bubbletea/model.go `next\(\)\.x` -- the operand is bound once, not read per field
deny out/none/html/index.html `next\(\)\.x` -- the same on JavaScript

-- spread.sngl --
import . "sngl:ui"
import . "sngl:test"

struct Pair {
    x int
    y int
}

component panel node {
    var n = 0
    var got = 0
    var p = Pair{x=3, y=4}
    func next() Pair {
        n = n + 1
        return Pair{x=n, y=n * 100}
    }
    func add(x int, y int) => x + y
    func swap(x int, y int) => Pair{x=y, y=x}
    button #once(text="once", @click {
        got = add(...next())
    })
    button #path(text="path", @click {
        got = add(...p)
    })
    button #nested(text="nested", @click {
        got = add(...swap(...next()))
    })
    text(value="{got}")
}

func testOperandOnce(t Test, c panel) {
    c.once.click()
    t.assert(c.got == 101)
    t.assert(c.n == 1)
}

func testPathInPlace(t Test, c panel) {
    c.path.click()
    t.assert(c.got == 7)
}

func testNestedOnce(t Test, c panel) {
    c.nested.click()
    t.assert(c.got == 101)
    t.assert(c.n == 1)
}

window {
    panel
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
