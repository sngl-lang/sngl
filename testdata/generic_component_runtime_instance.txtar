A generic component built at run time -- stateful, under a `for` -- is copied
per instantiation on a target that does not emit a generic component: Go and
Kotlin get `show__int` and `show__string`, each with its `list[T]` prop, its
`struct { v T }` prop, event parameter, state and method at the bound types.
html keeps the one generic factory. A two-way prop of type T bound at the
call site is written back by a handler taking the bound type, which Go
refused as `func(any)` where the copy's setter takes `func(int)`.

deny out/go/fyne/model.go `(?m)^\t\w+\s+(\*|\[\]|func\()*(any|T)\b` -- no record field erases T
deny out/go/gtk4/model.go `(?m)^\t\w+\s+(\*|\[\]|func\()*(any|T)\b` -- no record field erases T
deny out/kotlin/android/MainScreen.kt `\bAny\b` -- every copy's types are concrete
deny out/none/html/index.html `show__` -- JavaScript keeps the one generic component

-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
        gtk4
    }
    kotlin {
        android
    }
}

component show[T any](
    xs list[T],
    w  struct {
        v T
    },
    @chose(w struct {
        v T
    }),
) {
    var held = w
    var hits = 0
    func boxed() struct {
        v T
    } {
        return {v=held.v}
    }
    ui.button(text="{hits} {xs.length}", @click {
        hits = hits + 1
        held = boxed()
        chose(held)
    })
}

// Held under an `if`, so it is built at run time.
component held[T any](:value T, next T) {
    var hits = 0
    ui.button(text="{hits}", @click {
        hits += 1
        value = next
    })
}

var items = [1, 2]
var names = ["a", "b"]
var got = 0
var said = ""
var shown = true
var n = 0

ui.window(title="x") {
    for var i = items {
        show(xs=[i], w={v=i}, @chose(w) { got = w.v })
    }
    for var s = names {
        show(xs=[s], w={v=s}, @chose(w) { said = w.v })
    }
    if shown {
        held(:value=n, next=4)
    }
}
