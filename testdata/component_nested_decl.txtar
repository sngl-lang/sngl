	gtk4rt.BoxAppend(m.__n0, m.__n1)
	m.__n5 = gtk4rt.LabelNew("")
	gtk4rt.LabelSetText(m.__n5, "cell c")
	gtk4rt.BoxAppend(m.__n0, m.__n5)
