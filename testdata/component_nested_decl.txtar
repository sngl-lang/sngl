A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_nested_decl.sngl --
// A component declared in a body binds in that body's scope and is
// instantiated there. Two bodies each declaring their own is the case a flat
// emitted namespace would break, so both are here and both are rendered.

import . "sngl:ui"

component first() node {
    component row(label = "") node {
        text(value="row " + label)
    }

    component labelled(label = "") node {
        vbox {
            row(label=label)
        }
    }

    vbox {
        row(label="a")
        labelled(label="b")
    }
}

component second() node {
    component cell(label = "") node {
        text(value="cell " + label)
    }

    cell(label="c")
}

component main node {
    vbox {
        first()
        second()
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
