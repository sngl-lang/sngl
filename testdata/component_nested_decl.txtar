// Model holds the state for this SNGL UI.
type Model struct {
	__n0 *fyne.Container
	__n1 *fyne.Container
	__n2 *widget.Label
	__n3 *fyne.Container
	__n4 *widget.Label
	__n5 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = container.NewVBox()
	m.__n1 = container.NewVBox()
	m.__n2 = widget.NewLabel("")
	m.__n2.SetText("row a")
	m.__n1.Add(m.__n2)
	m.__n3 = container.NewVBox()
	m.__n4 = widget.NewLabel("")
	m.__n4.SetText("row b")
	m.__n3.Add(m.__n4)
	m.__n1.Add(m.__n3)
	m.__n0.Add(m.__n1)
	m.__n5 = widget.NewLabel("")
	m.__n5.SetText("cell c")
	m.__n0.Add(m.__n5)
	content := fyne.CanvasObject(m.__n0)
	return content
}
