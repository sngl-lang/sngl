func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setCaughtMsg:
		m = m.SetCaught(msg.value)
	case setAfterMsg:
		m = m.SetAfter(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.viaCall()
		case msg.Code == tea.KeyEnter && m.__focusID == 1:
			m.viaRaise()
		}
	}
	return m, tea.Batch(cmds...)
}

// callClick activates the #call widget the way a keypress does; for tests.
func (m *Model) callClick() {
	prev := m.__focusID
	m.__focusID = 0
	nm, _ := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
}

// raiseClick activates the #raise widget the way a keypress does; for tests.
func (m *Model) raiseClick() {
	prev := m.__focusID
	m.__focusID = 1
	nm, _ := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = lipgloss.NewStyle().Render(part0Prefix + " " + fmt.Sprint("Call"))
	parts = append(parts, part0)
	var part1 string
	part1Focused := (m.__focusID == 1)
	part1Prefix := " "
	if part1Focused {
		part1Prefix = ">"
	}
	part1 = lipgloss.NewStyle().Render(part1Prefix + " " + fmt.Sprint("Raise"))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
