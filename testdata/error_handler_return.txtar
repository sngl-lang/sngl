A `return` in an @error handler ends the handler, and execution carries on
after the call it caught: the interpreter runs the handler as a block of its
own (invokeHandler stops at the return). A handler inlined as a plain block
returned from the function it was inlined into instead, so the statement after
the call never ran -- on JavaScript and Kotlin for a call's own @error, and on
every target for the @error on a direct error.raise. A handler holding a
return now runs as a function of its own: a closure on Go, an arrow on
JavaScript, a local fun on Kotlin. One without is inlined as before.

The test executes on bubbletea, fyne and android; the html page is run by
cmd/sngl/testdata/call_error_handler_runs.txt.

deny out/go/bubbletea/model.go `(?m)^\t\treturn\n\t\}\n\tm\.after` -- on Go the handler on a direct raise is a closure, not a bare block
deny out/none/html/index.html `(?m)^\s+return;\n\s+\}\n\s+;?\n?\s+state2?\.after` -- a handler's return is inside a function of its own

-- ret.sngl --
import . "sngl:ui"
import . "sngl:test"

func check(n int) {
    if n > 1 {
        error.raise("too big", "range")
    }
}

component main node {
    var caught = ""
    var after = ""

    func viaCall() {
        check(5, @error(e) {
            caught = caught + "c"
            if caught != "" {
                return
            }
            caught = "unreached"
        })
        after = after + "c"
    }

    func viaRaise() {
        error.raise("r", "", @error(e) {
            caught = caught + "r"
            return
        })
        after = after + "r"
    }

    button #call(text="Call", @click { viaCall() })
    button #raise(text="Raise", @click { viaRaise() })
}

func testReturnEndsOnlyTheHandler(t Test, c main) {
    c.call.click()
    c.raise.click()
    t.assert(c.caught == "cr")
    t.assert(c.after == "cr")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
        html
    }
    kotlin {
        android
    }
    none {
        html
    }
}
