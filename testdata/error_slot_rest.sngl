// The three rules the rest slot carries beyond an ordinary slot's.
//
// `...` says a slot collects the children written bare, so there is one of
// them per component; those children are written once, with no per-invocation
// site to bind a parameter at; and they are the same content an explicit
// population by name supplies, so writing both populates the slot twice.

import . "sngl:ui"
import app "sngl:app"

component twice(head ...component, tail ...component) node { // ERROR(check) "declares a second rest slot \"tail\""
    vbox {
        head
        tail
    }
}

component scoped(children ...component(string)) node { // ERROR(check) "rest slot \"children\" takes no parameters"
    vbox {
        children
    }
}

component card(children ...component) node {
    vbox {
        children
    }
}

component main node {
    vbox {
        card() { // ERROR(check) "slot \"children\" is populated by name and by the children written bare"
            component children {
                text(value="by name")
            }
            text(value="bare")
        }
    }
}

app.window {
    main
}
