// The three rules the rest slot carries beyond an ordinary slot's.
//
// `...` says a slot collects the children written bare, so there is one of
// them per component; a scoped one is read by the names its own declaration
// writes, since bare children have no binding site of their own to name them
// at; and they are the same content an explicit population by name supplies,
// so writing both populates the slot twice.

import . "sngl:ui"

component twice(head ...component, tail ...component) node { // ERROR(check) "declares a second rest slot \"tail\""
    vbox {
        head
        tail
    }
}

component scoped(children ...component(string)) node { // ERROR(check) "each parameter needs a name"
    vbox {
        children
    }
}

component card(children ...component) node {
    vbox {
        children
    }
}

component main node {
    vbox {
        card() { // ERROR(check) "slot \"children\" is populated by name and by the children written bare"
            component children {
                text(value="by name")
            }
            text(value="bare")
        }
    }
}

window {
    main
}
