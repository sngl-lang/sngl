// The three rules the rest slot carries beyond an ordinary slot's.
//
// `...` says a slot collects the children written bare, so there is one of
// them per component; a scoped one hands its arguments to the population
// written by name and to nothing else, because a spread has nowhere to write
// a name and so nothing to collect them into; and bare children are the same
// content an explicit population supplies, so writing both populates the slot
// twice.

import . "sngl:ui"

component twice(head ...component, tail ...component) node { // ERROR(check) "declares a second rest slot \"tail\""
    vbox {
        head
        tail
    }
}

component scoped(children ...component(n int) node) node {
    vbox {
        children(1)
    }
}

component card(children ...component) node {
    vbox {
        children
    }
}

component main node {
    vbox {
        scoped {
            text(value="{n}") // ERROR(check) "undefined: n"
        }
        card() { // ERROR(check) "slot \"children\" is populated by name and by the children written bare"
            component children {
                text(value="by name")
            }
            text(value="bare")
        }
    }
}

window {
    main
}
