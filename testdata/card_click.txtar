-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestClickOpens(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.rowClickAt("1")
	if !((c.opened == "two")) { t.Errorf("assert failed: %s", "(c.opened == \"two\")") }
	c.rowClickAt("0")
	if !((c.opened == "one")) { t.Errorf("assert failed: %s", "(c.opened == \"one\")") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
