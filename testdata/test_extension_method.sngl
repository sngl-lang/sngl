// Extension method via top-level form (peer of nested form). Checker
// verifies registration; runtime dispatch via interpreter is a follow-up.
struct Vec2 {
    x, y int
}

func Vec2.dot(a Vec2, b Vec2) => a.x*b.x + a.y*b.y

component main {
    var u = Vec2{x = 1, y = 2}
    var v = Vec2{x = 3, y = 4}
    text(value=string(u.dot(v)))
}
