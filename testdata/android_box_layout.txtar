What a box's Style says of its children is an argument Compose takes for the
Row or Column, not a Modifier: `gap` and `justifyContent` the main axis's
Arrangement, `alignItems` the cross axis's Alignment. Neither was emitted, so
on android every box laid its children edge to edge and at its start -- the
Pokédex's stat rows uncentred and its tabs' lines touching.

-- m.sngl --
import ui "sngl:ui"

output {
    kotlin {
        android
    }
}

ui.window {
    ui.vbox(style={gap=8px, alignItems=center}) {
        ui.hbox(style={gap=4px, alignItems=center}) {
            ui.text(value="HP")
            ui.text(value="45")
        }
        ui.hbox(style={justifyContent=spaceBetween, alignItems=end}) {
            ui.text(value="Total")
            ui.text(value="318")
        }
        ui.hbox(style={gap=4px, justifyContent=center}) {
            ui.text(value="Grass")
            ui.text(value="Poison")
        }
        ui.vbox(style={justifyContent=end}) {
            ui.text(value="Last")
        }
    }
}
