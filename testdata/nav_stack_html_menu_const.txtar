A window's menu beside a stack, on a static site of two documents. The menu's
entries loop over a list const, which a site of more than one page writes once
as an asset each page that names it loads: the menu spreads the loop's list,
`[...sizes.map(...)]`, and the `.` ending the spread read as a member access,
so no page loaded `sizes` and the home page raised as it loaded. The render
func drawing the menu and `choose` are the package's, shared by both
documents, and wrote the about page's text on the home page too, where no
element for it is; each document's copy leaves those writes out, as
nav_stack_html_other_pages_writes.txtar's body does.

deny out/none/html/index.html `"about "` -- the home document writes no text of the about page, which it holds no element for

-- app.sngl --
import ui "sngl:ui"
import nav "sngl:ui/nav"

output {
    none {
        html
    }
}

const sizes = ["Small", "Medium", "Large"]

var size = "Medium"

func choose(s string) {
    size = s
}

ui.window #main(title="Sizes") {
    component menu {
        ui.menuItem(label="Size") {
            ui.menuItem(label="Default", checked=size == "Medium", @select { size = "Medium" })
            for var s = sizes {
                ui.menuItem(label=s, checked=s == size, @select { choose(s) })
            }
        }
    }
    nav.stack #pages {
        nav.page #home(href="/", title="Home") {
            ui.text(value="home")
        }
        nav.page #about(href="/about", title="About") {
            ui.text(value="about {size}")
        }
    }
}
