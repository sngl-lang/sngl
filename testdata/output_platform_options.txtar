A platform carrying options parses as a call, not a visual node -- the two
forms buildPlatformOutput has always accepted. The scan that decides which
target packages to load read only the node form, so an optioned platform was
dropped from the target set and its `component sngl.X` overrides never
merged: the build emitted the abstract stdlib body instead of the widget.
fyne's `component sngl.text` override is what turns a text node into a Label
the model holds a handle on, so without it the model has no field and the
tree is an anonymous empty label.

It only showed with a mixed output block, which is why both targets are
declared here. A block whose platforms all carry options resolves to no
targets at all, and that falls back to loading every registered target --
which is why the one-target case looked fine.

-- app.sngl --
import . "sngl:ui"

output {
    none { html }
    go {
        fyne(package="app")
    }
}

window #w {
    text(value="hello")
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package app

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	__n0 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText("hello")
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
