A sngl:seq sequence compiles to a loop and never to a list. Written directly
in a loop head it is the host's counting loop; held in a variable or passed to
a function it is the pull sequence iter[int] is, which the consumer drives one
value at a time -- a range func in Go, a generator in JS, an IntProgression in
Kotlin.

Three targets from one source, so the three spellings of the same construct
read side by side. That is the reason for one archive per fixture rather than
one per target.

Nothing here builds a slice to walk a sequence, which is the whole reason the
package exists -- and is a claim about absence, which a golden shows but does
not state:

deny out/go/bubbletea/model.go `held := \[\]int` -- the held sequence is a range func, not a materialised slice
deny out/none/html/index.html `__out\.push\(` -- the generator yields; it does not fill an array first
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `\.toList\(\)` -- an IntProgression is iterated where it is built

-- app.sngl --
import "sngl:seq"
import . "sngl:ui"

output {
    go {
        bubbletea
    }
    none {
        html
    }
    kotlin {
        android
    }
}

func total(xs iter[int]) int {
    var sum = 0
    for var x = xs {
        sum = sum + x
    }
    return sum
}

component main node {
    var n = 6
    var total2 = 0

    button(text="sum", @click {
        for var i = seq.range(1, n) {
            total2 = total2 + i
        }
        for var d = seq.step(n, 0, -2) {
            total2 = total2 + d
        }
        var held iter[int] = seq.count(n)
        for var h = held {
            total2 = total2 + h
        }
        for var h2 = seq.count(n) {
            total2 = total2 + h2
        }
        var ys list[int] = [1, 2, 3]
        total2 = total2 + total(ys)
    })
    text(value=string(total2))
}

window {
    main
}
