import . "sngl:ui"
import . "sngl:dialog"

output {
    kotlin {
        android
    }
}

component main node {
    var n = 0

    vbox {
        button(style={padding=4px}, text="bump", @click { n += 1 })
        button(text="quiet")
        badge(style={padding=6px}, value="7")
        link(href="/", text="Home")
        image(alt="logo") {
            remote(url="/logo.png")
        }
        chip(label="Tag")
        toolbar(style={padding=9px}) {
            button(text="New")
        }
        menubar {
            menuItem(label="File")
        }
        avatar(initials="JD")
    }
}

window {
    main
}
