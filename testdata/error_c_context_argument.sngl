// No caller passes a callback's context: the compiler does, from the closure
// the call hands the callback. A positional argument goes to the parameter
// after it.
import c "sngl:x/c"

c.link(include="calls.h")

#[c.native("each")]
func each(f func(int), #[c.context] data c.pointer, n int)

func call() {
    each(func(i int) {}, 3)
    each(func(i int) {}, data=c.pointer{}, n=3) // ERROR(check) "parameter \"data\" is what C hands its callback, or calls to release it, which the compiler passes"
    each(func(i int) {}, 3, 4)                  // ERROR(check) "too many arguments"
}
