An entry's text reaches it through the override's own effect, which writes
only a value the entry does not already show.

The input override used to bind `text = value`, so a runtime instance's
changed handler wrote the value back to the entry it came from.
gtk_editable_set_text deletes and reinserts, firing "changed" for each, so that
handler re-entered itself until the stack overflowed. Now the handler only
reads the entry, and an `effect` keyed on the value calls setEntryText when
entryText differs. The canvas keeps this program on the cgo path, and the loop
makes Search a runtime instance. codegen/platform/gtk4/entry_echo_test.go types
into the entry and reads the label.

deny out/go/gtk4/model.go `C\.gtk_editable_set_text\(` -- the override writes the text through setEntryText, never a bound prop
-- app.sngl --
import draw "sngl:ui/draw"
import ui "sngl:ui"

output {
    go {
        gtk4
    }
}

component Search ui.node {
    var search = ""

    ui.vbox {
        ui.input #box(:value=search)
        ui.text(value=search)
    }
}

ui.window {
    ui.vbox {
        draw.canvas(width=10px, height=10px) {
            draw.circle(cx=5.0, cy=5.0, r=2.0)
        }
        for var i = [1] {
            Search()
        }
    }
}
