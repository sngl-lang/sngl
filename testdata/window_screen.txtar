// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	shown     bool
	closes    int
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.shown = true
	m.closes = 0
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Shown() bool {
	return m.shown
}

func (m Model) SetShown(v bool) Model {
	m.shown = v
	return m
}

type setShownMsg struct{ value bool }

func SetShownCmd(v bool) tea.Cmd {
	return func() tea.Msg { return setShownMsg{value: v} }
}

func (m Model) Closes() int {
	return m.closes
}

func (m Model) SetCloses(v int) Model {
	m.closes = v
	return m
}

type setClosesMsg struct{ value int }

func SetClosesCmd(v int) tea.Cmd {
	return func() tea.Msg { return setClosesMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setShownMsg:
		m = m.SetShown(msg.value)
	case setClosesMsg:
		m = m.SetCloses(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			if m.shown {
				m.shown = false
				m.closes += 1
				if m.closes < 3 {
					m.shown = true
				}
			}
			if !(m.shown) {
				return m, tea.Quit
			}
			return m, nil
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.shown = false
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	if m.shown {
		var contentParts []string
		var contentPart_0 string
		contentPart_0 = lipgloss.NewStyle().Render(fmt.Sprint((("closed " + fmt.Sprint(m.closes)) + " times")))
		contentParts = append(contentParts, contentPart_0)
		var contentPart_1 string
		contentPart_1Focused := (m.__focusID == 0)
		contentPart_1Prefix := " "
		if contentPart_1Focused {
			contentPart_1Prefix = ">"
		}
		contentPart_1 = lipgloss.NewStyle().Render(contentPart_1Prefix + " " + fmt.Sprint("Hide"))
		contentParts = append(contentParts, contentPart_1)
		content = lipgloss.JoinVertical(lipgloss.Left, contentParts...)
	}
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
