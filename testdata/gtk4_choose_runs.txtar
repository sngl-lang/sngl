What a user chooses among on gtk4, read off GTK's own widgets in C and Go: a
drop-down offered its labels and a calendar selected a day, neither of which
reports itself, a drop-down selecting a label, which does, and what a check
button, a switch and an entry hold.

An offer of the labels the drop-down already has keeps its model, which a
popup a user has open is on; labels split at each newline, an empty one
among them, and no labels at all are no choices; a chosen label among none
of them selects nothing. A day no month has selects nothing, and a year
before 1000 is written with four digits.

exec out/c/gtk4 -- said.txt
exec out/go/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"

c.link(include="peek.h", pkgConfig=["gtk4"], sources=["peek.c", "peek.h"])

#[c.native("watch")]
func watch(drop ui.node, cal ui.node)

#[c.native("peek_drop")]
func peekDrop(n ui.node)

#[c.native("peek_cal")]
func peekCal(n ui.node)

#[c.native("say")]
func say(s string)

output {
    c { gtk4 }
    go { gtk4 }
}

var (
    ticks = 0
    pick = "b"
    day option[time.date] = "2024-03-05"
)

func offer(labels string, chosen string) {
    gtk4.offerChoices(drop, labels, chosen)
    peekDrop(drop)
    say("label [{gtk4.dropDownLabel(drop)}]")
}

func choose(label string) {
    gtk4.selectLabel(drop, label)
    peekDrop(drop)
    say("label [{gtk4.dropDownLabel(drop)}]")
}

func select(y int, m int, d int) {
    gtk4.selectDay(cal, y, m, d)
    peekCal(cal)
    var on = gtk4.calendarDate(cal)
    say("date {on == null ? "none" : on.format()}")
}

time.timer(interval=100ms, @tick {
    ticks += 1
    if ticks == 2 {
        watch(drop, cal)
        peekDrop(drop)
        say("label [{gtk4.dropDownLabel(drop)}]")
        offer("x\ny", "y")
        offer("x\ny", "x")
        offer("x\ny", "z")
        offer("p\n\nq", "")
        offer("", "")
        offer("a\nb\nc", "c")
        choose("a")
        choose("missing")
        peekCal(cal)
        select(2024, 2, 29)
        select(2023, 2, 30)
        select(999, 1, 2)
        say("check {gtk4.checkActive(check)} switch {gtk4.switchActive(flip)} entry [{gtk4.entryText(entry)}]")
        gtk4.setEntryText(entry, "typed")
        say("entry [{gtk4.entryText(entry)}]")
    }
    if ticks == 3 {
        gtk4.quit()
    }
})

ui.window(title="t") {
    ui.vbox {
        ui.select #drop(:value=pick) {
            ui.choice(label="a", value="a")
            ui.choice(label="b", value="b")
            ui.choice(label="c", value="c")
        }
        ui.datepicker #cal(:value=day)
        ui.checkbox #check(label="c", checked=true)
        ui.toggle #flip(checked=false)
        ui.input #entry(value="hello")
    }
}
-- peek.c --
#include "peek.h"

#include <stdio.h>

static int selects;
static int days;
static GListModel *last;

static void on_selected(GObject *o, GParamSpec *ps, gpointer data) {
    selects++;
}

static void on_day(GtkCalendar *c, gpointer data) {
    days++;
}

void watch(GtkWidget *drop, GtkWidget *cal) {
    g_signal_connect(drop, "notify::selected", G_CALLBACK(on_selected), NULL);
    g_signal_connect(cal, "day-selected", G_CALLBACK(on_day), NULL);
}

void peek_drop(GtkWidget *w) {
    GListModel *m = gtk_drop_down_get_model(GTK_DROP_DOWN(w));
    guint n = m != NULL ? g_list_model_get_n_items(m) : 0;
    printf("model %s, %u:", m == last ? "kept" : "new", n);
    for (guint i = 0; i < n; i++) {
        printf(" [%s]", gtk_string_list_get_string(GTK_STRING_LIST(m), i));
    }
    guint at = gtk_drop_down_get_selected(GTK_DROP_DOWN(w));
    if (at == GTK_INVALID_LIST_POSITION) {
        printf("; selected none");
    } else {
        printf("; selected %u", at);
    }
    printf("; notified %d\n", selects);
    fflush(stdout);
    last = m;
}

void peek_cal(GtkWidget *w) {
    GDateTime *dt = gtk_calendar_get_date(GTK_CALENDAR(w));
    printf("calendar %d %d %d; day-selected %d\n", g_date_time_get_year(dt), g_date_time_get_month(dt), g_date_time_get_day_of_month(dt), days);
    g_date_time_unref(dt);
    fflush(stdout);
}

void say(const char *s) {
    puts(s);
    fflush(stdout);
}
-- peek.h --
#include <gtk/gtk.h>

// watch counts the drop-down's notify::selected and the calendar's
// day-selected; peek_drop prints the drop-down's model, whether it is the one
// the last peek saw, its labels and its selection, and peek_cal the day the
// calendar has; say prints s.
void watch(GtkWidget *drop, GtkWidget *cal);
void peek_drop(GtkWidget *w);
void peek_cal(GtkWidget *w);
void say(const char *s);
-- said.txt --
model new, 3: [a] [b] [c]; selected 1; notified 0
label [b]
model new, 2: [x] [y]; selected 1; notified 0
label [y]
model kept, 2: [x] [y]; selected 0; notified 0
label [x]
model kept, 2: [x] [y]; selected 0; notified 0
label [x]
model new, 3: [p] [] [q]; selected 1; notified 0
label []
model new, 0:; selected none; notified 0
label []
model new, 3: [a] [b] [c]; selected 2; notified 0
label [c]
model kept, 3: [a] [b] [c]; selected 0; notified 1
label [a]
model kept, 3: [a] [b] [c]; selected 0; notified 1
label [a]
calendar 2024 3 5; day-selected 0
calendar 2024 2 29; day-selected 0
date 2024-02-29
calendar 2024 2 29; day-selected 0
date 2024-02-29
calendar 999 1 2; day-selected 0
date 0999-01-02
check true switch false entry [hello]
entry [typed]
