static sngl_string *sngl_list_string_at(sngl_list_string l, int64_t i) {
	if (i < 0 || i >= l.len) {
		sngl_panic("index out of range");
	}
	return &l.data[i];
}

static int64_t sngl_opt_or_int(sngl_opt_int o, int64_t otherwise) {
	return o.ok ? o.value : otherwise;
}

static sngl_opt_int sngl_opt_int_int_parse(sngl_string s, int64_t base) {
	sngl_opt_int o = {0};
	o.ok = sngl_int_parse(s, base, &o.value);
	return o;
}

static void sngl_list_string_grow(sngl_list_string *l, int64_t n) {
	if (l->len + n <= l->cap) {
		return;
	}
	int64_t cap = l->cap * 2;
	if (cap < l->len + n) {
		cap = l->len + n;
