A `@run` handler that reads no state is called the way it was emitted.

The build makes the handler a function of the program's, and a function that
touches no state is emitted free on the Go targets rather than as a Model
method. Each host's main spelled the call `m.__run(…)` regardless, against a
file declaring `func __run`, and the program did not compile.

deny out/go/gtk4/callbacks.go `m\.__run` -- __run is free here
deny out/go/fyne/model.go `m\.__run` -- likewise

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4(@run(args, run) {
            if args.length > 0 {
                run()
            }
        })
        fyne(@run(args, run) {
            run()
        })
    }
}

ui.window {
    ui.text(value="hi")
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	__n0 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

func __run(args []string, run func()) {
	run()
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText("hi")
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	m := New()
	content := m.BuildUI()
	ran := false
	__run(os.Args[1:], func() {
		ran = true
		w := a.NewWindow("SNGL App")
		w.SetContent(content)
		w.Resize(fyne.NewSize(480, 640))
		w.ShowAndRun()
	})
	if !ran {
		a.Run()
	}
}
-- out/go/gtk4/callbacks.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

import "git.duckfam.us/jonathan/sngl/pkg/go/gtk4rt"

func main() {
	gtk4rt.Init()
	m := New()
	m.buildWidgetTree()
	ran := false
	__run(gtk4rt.Args(), func() {
		ran = true
		gtk4rt.Run(m.BuildUI)
	})
	if !ran {
		gtk4rt.RunHidden(m.BuildUI)
	}
}
-- out/go/gtk4/model.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

import (
	"git.duckfam.us/jonathan/sngl/pkg/go/gtk4rt"
)

// Model holds the state and widget references for this SNGL UI.
type Model struct {
	__n0   gtk4rt.Handle
	__root gtk4rt.Handle
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	return m
}

func __run(args []string, run func()) {
	if len(args) > 0 {
		run()
	}
}

func (m *Model) buildWidgetTree() {
	if m.__root != nil {
		return
	}
	m.__root = gtk4rt.BoxNew(gtk4rt.OrientationVertical, 6)
	m.__n0 = gtk4rt.LabelNew("")
	gtk4rt.LabelSetText(m.__n0, "hi")
	gtk4rt.BoxAppend(m.__root, m.__n0)
}

// BuildUI constructs the widget tree and returns the top-level window.
func (m *Model) BuildUI(app gtk4rt.Handle) gtk4rt.Handle {
	m.buildWidgetTree()
	win := gtk4rt.ApplicationWindowNew(app)
	gtk4rt.WindowSetDefaultSize(win, 480, 640)
	gtk4rt.WindowSetChild(win, m.__root)
	return win
}
