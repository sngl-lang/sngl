// An argument passes a value, and nothing at a call site annotates one with a
// type. `ArgList` and `ParamList` are separate productions again -- a
// population binds names through the second -- so a type after an argument is
// a parse error rather than something the builder has to refuse.

import . "sngl:ui"

component main {
    vbox {
        text(value string) // ERROR(parse) "unexpected identifier, expected \")\""
    }
}
