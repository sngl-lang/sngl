A component built at run time that renders a fallible call still builds
under a boundary.

Its body is shared by every instance, so a raise its render makes answers to
no boundary around one instance: it is the host's throw, as it was before
render raises were caught. Counting it among the raises a handler lets out
refused the program -- "a raise in row cannot reach the @error around this
instance" -- where it had built.

-- app.sngl --
import ui "sngl:ui"

func label(n int) string {
    if n == 1 {
        error.raise("one is refused", "bad")
    }
    return "n{n}"
}

component row(n int) ui.node {
    var clicks = 0
    ui.text(value=label(n))
    ui.button(text="go", @click {
        clicks += 1
    })
}

component list ui.node {
    var ns = [0, 2]
    var problem = ""
    boundary(@error(e) {
        problem = e.message
    }) {
        for var i = ns {
            row(n=i)
        }
    }
}

ui.window {
    list
}

output {
    go {
        fyne
    }
    none {
        html
    }
}
