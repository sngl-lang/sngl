A read of a two-way prop after the body wrote it reads what it wrote: the
write is a report its caller answers in its own time, and a component built
at run time on android, whose caller writes the prop back at its next
recomposition, handed `change(value)` the value it held before.
-- app.sngl --
import test "sngl:test"
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
    }
    kotlin {
        android
    }
}

component picker(:value string = "", @change(v string)) ui.node {
    var taps = 0

    ui.button #pick(text="pick", @click {
        taps += 1
        value = "b"
        change(value)
    })
}

component page ui.node {
    var chosen = "a"
    var heard = ""
    var on = true

    if on {
        picker #p(:value=chosen, @change(v) { heard = v })
    }
}

func testTheReadSeesTheWrite(t test.Test, c page) {
    var p = c.p
    if p != null {
        p.pick.click()
    }
    t.assert(c.chosen == "b")
    t.assert(c.heard == "b")
}

ui.window {
    page
}
