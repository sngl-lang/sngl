A component var of funcvar type that receives both a sync and an async
candidate at different call sites. The slot is auto-promoted to Async (g3)
so the invocation handler awaits unconditionally.

The "Run" handler wrapper is async because the handler slot may hold async.

The funcvar call site on the promoted-async slot is awaited.
-- app.sngl --
import . "sngl:ui"
import api "js:./api"

output {
    none {
        html
    }
}

func syncFetch() string {
    return "sync"
}

component main {
    var handler func() string = api.fetchHello
    button(text="UseSync", @click { handler = syncFetch })
    button(text="UseAsync", @click { handler = api.fetchHello })
    button(text="Run", @click { handler() })
    text(value="hi")
}
-- api/index.ts --
export async function fetchHello(): Promise<string> { return "hi"; }
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<button id="$0">
  <span>UseSync</span>
</button>
<button id="$1">
  <span>UseAsync</span>
</button>
<button id="$2">
  <span>Run</span>
</button>
<span>hi</span>

<script>
(() => {
  // sngl-virt:/sngl/api/index.ts
  async function fetchHello() {
    return "hi";
  }

  // sngl-entry.js
  var state = { handler: null };
  state.handler = fetchHello;
  function $syncFetch() {
    return "sync";
  }
  var $0 = document.getElementById("$0");
  var $1 = document.getElementById("$1");
  var $2 = document.getElementById("$2");
  $0.addEventListener("click", function() {
    state.handler = $syncFetch();
  });
  $1.addEventListener("click", function() {
    state.handler = fetchHello;
  });
  $2.addEventListener("click", async function() {
    await state.handler();
  });
})();
</script>
</body></html>
