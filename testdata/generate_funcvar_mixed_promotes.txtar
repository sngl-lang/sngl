  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<button id="$0">
  <span>UseSync</span>
</button>
<button id="$1">
  <span>UseAsync</span>
</button>
<button id="$2">
  <span>Run</span>
</button>
<span>hi</span>

<script>
(() => {
  // sngl-virt:/sngl/api/index.ts
  async function fetchHello() {
    return "hi";
  }

  // sngl-entry.js
  var state = { handler__inst0: null };
  state.handler__inst0 = fetchHello;
  function syncFetch() {
    return "sync";
  }
  var $0 = document.getElementById("$0");
  var $1 = document.getElementById("$1");
  var $2 = document.getElementById("$2");
  $0.addEventListener("click", function() {
    state.handler__inst0 = syncFetch();
  });
  $1.addEventListener("click", function() {
    state.handler__inst0 = fetchHello;
  });
  $2.addEventListener("click", async function() {
    await state.handler__inst0();
  });
})();
</script>
</body></html>
