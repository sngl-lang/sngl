A component var of funcvar type receives both a sync and an async candidate,
at two different call sites. The slot is auto-promoted to Async (g3), so the
"Run" handler wrapper is emitted async and the call through the var is awaited
unconditionally rather than decided at runtime.

-- app.sngl --
import . "sngl:ui"
import api "js:./api"

output {
    none {
        html
    }
}

func syncFetch() string {
    return "sync"
}

component main node {
    var handler func() string = api.fetchHello
    button(text="UseSync", @click { handler = syncFetch })
    button(text="UseAsync", @click { handler = api.fetchHello })
    button(text="Run", @click { handler() })
    text(value="hi")
}

window {
    main
}
-- api/index.ts --
export async function fetchHello(): Promise<string> { return "hi"; }
-- out/none/html/index.html --
