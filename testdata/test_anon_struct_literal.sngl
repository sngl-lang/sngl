import . "sngl://std"

struct Point {
    x int = 0
    y int = 0
}

func originPlus(p Point) => p.x + p.y

component main {
    var named Point = {x = 3, y = 4}
    var inline = {x = 1, y = 2}
    var fromCall = originPlus({x = 5, y = 6})

    text(value=string(named.x + named.y))
}

func testAnonLiteralAssign(t Test, c main) {
    t.assert(c.named.x == 3)
    t.assert(c.named.y == 4)
}

func testAnonLiteralInferred(t Test, c main) {
    t.assert(c.inline.x == 1)
}
