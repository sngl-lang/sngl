package main

import "testing"

func TestMountRaiseIsCaught(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.caught == "too big;")) { t.Errorf("assert failed: %s", "(c.caught == \"too big;\")") }
}

func TestHandlerCallIsCaught(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.stmtClick()
	if !((c.caught == "too big;too big;")) { t.Errorf("assert failed: %s", "(c.caught == \"too big;too big;\")") }
	if !((c.after == "s")) { t.Errorf("assert failed: %s", "(c.after == \"s\")") }
}

func TestLambdaCallCatchesItsOwn(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.lamClick()
	if !((c.caught == "too big;lam:lam;")) { t.Errorf("assert failed: %s", "(c.caught == \"too big;lam:lam;\")") }
	if !((c.after == "l")) { t.Errorf("assert failed: %s", "(c.after == \"l\")") }
}


func newTestComponent() Model { return New() }
