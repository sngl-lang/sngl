package main

import "testing"

func TestTableSelectedMutates(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.idx == 0)) { t.Errorf("assert failed: %s", "(c.idx == 0)") }
	c.idx = 3
	if !((c.idx == 3)) { t.Errorf("assert failed: %s", "(c.idx == 3)") }
}


func newTestComponent() Model { return New() }
