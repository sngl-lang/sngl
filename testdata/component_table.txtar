-- component_table.sngl --
import . "sngl:ui"
import . "sngl:test"

// table: state-binding fixture — mutating the bound `selected`
// index changes the chosen row.
component main node {
    var idx = 0
    table(columns=["Name", "Role"], selectable=true, selected=idx)
}

func testTableSelectedMutates(t Test, c main) {
    t.assert(c.idx == 0)
    c.idx = 3
    t.assert(c.idx == 3)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
