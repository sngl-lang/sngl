  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<div id="$0" style="overflow:auto">
  <span id="__n0" data-sngl-id="__n0">
  </span>
</div>
<button id="$1">
  <span>hit</span>
</button>

<script>
(() => {
  // sngl-entry.js
  var state = { n: 0 };
  function String(v) {
    return "" + v;
  }
  var $0 = document.getElementById("$0");
  var $1 = document.getElementById("$1");
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  $0.addEventListener("scrollend", function() {
    state.n = state.n + 1;
    __n0.textContent = String(state.n);
  });
  $1.addEventListener("click", function() {
    state.n = state.n + 1;
    __n0.textContent = String(state.n);
  });
  $1.addEventListener("contextmenu", function() {
    state.n = 0;
    __n0.textContent = String(state.n);
  });
  function __sngl_init() {
    __n0.textContent = String(state.n);
  }
  __sngl_init();
})();
</script>
</body></html>
