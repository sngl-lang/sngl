import . "sngl:ui"
import . "sngl:test"

component editor node {
    var name = ""
    var lastCommit = ""

    input #field(
        value = name,
        @input(e) { name = e },
        @change(e) { lastCommit = e },
    )
    text #display(value=name)
}

func testInputFiresOnEachKeystroke(t Test, c editor) {
    t.assert(c.name == "")
    c.field.input("h")
    t.assert(c.name == "h")
    c.field.input("hello")
    t.assert(c.name == "hello")
}

func testInputUpdatesBoundText(t Test, c editor) {
    c.field.input("world")
    t.assert(c.display.value == "world")
}

func testChangeFiresOnCommit(t Test, c editor) {
    c.field.change("committed")
    t.assert(c.lastCommit == "committed")
}

window {
}
