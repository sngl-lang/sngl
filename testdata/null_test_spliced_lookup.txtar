A component whose body tests what it was handed, spliced under its caller's
null test of the value it hands it, keeps the read under the test: the
Pokédex's habitat lookup once read `about.habitat.name` above its
`if about.habitat != null`, and html threw on a species with none.
-- app.sngl --
import . "sngl:test"
import . "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
    }
    kotlin {
        android
    }
}

struct Place {
    name string
}

struct About {
    habitat option[Place]
}

var asked list[string] = []

func wanted(key string) => !asked.contains(key)

// Asks for `slug` where nothing has, as the Pokédex's lookups do.
component lookup(slug string) node {
    if wanted("habitat/{slug}") {
        effect(on=slug, @mount(s) { asked.push("habitat/{s}") })
    }
}

component page node {
    var about = About{habitat=null}

    if about.habitat != null {
        lookup(slug=about.habitat.name)
    }
    text #habitat(value=about.habitat != null ? about.habitat.name : "Unknown")
    button #found(text="Found", @click { about = About{habitat=Place{name="forest"}} })
}

func testANullHabitatAsksNothing(t Test, c page) {
    t.assert(c.habitat.value == "Unknown")
    t.assert(asked.length() == 0)
    c.found.click()
    t.assert(c.habitat.value == "forest")
    t.assert(asked.length() == 1 && asked[0] == "habitat/forest")
}

window {
    page
}
