
A zero-arg computed function whose body calls an async native is lowered by the
NoAsyncReactive pass: the reactive read site becomes a synchronous state-field
access, and an async kicker fires at startup to fill that field.

Calling greeting() from a visual prop triggers the hoist path, which
synthesises __hoist_N (renamed from greeting) and then lowers it into three
pieces -- the settled-state field __async___hoist_0 holding the zero value "",
the kicker $compute___hoist_0 that awaits the original fetchHello call and
resolves it, and the synchronous wrapper __hoist_0 that reads the field. The
kicker is called at startup, so the initial value is fetched.
-- app.sngl --
import . "sngl:ui"
import api "js:./api"
import app "sngl:app"

output {
    none {
        html
    }
}

func greeting() => api.fetchHello("world")

component main ui {
    text(value=greeting())
}

app.window {
    main
}
-- api/index.ts --
export async function fetchHello(name: string): Promise<string> { return "hi " + name; }
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<span>
</span>

<script>
(() => {
  // sngl-virt:/sngl/api/index.ts
  async function fetchHello(name) {
    return "hi " + name;
  }

  // sngl-entry.js
  var state = { __async___hoist_0: "" };
  function __hoist_0() {
    return state.__async___hoist_0;
  }
  async function $compute___hoist_0() {
    state.__async___hoist_0 = await fetchHello("world");
  }
  $compute___hoist_0();
})();
</script>
</body></html>
