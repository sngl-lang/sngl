* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<span id="__n0" data-sngl-id="__n0">
</span>
<button id="$0">
  <span>go</span>
</button>

<script>
(() => {
  // sngl-entry.js
  var state = { a__inst0: "unset", b__inst0: "unset" };
  var $0 = document.getElementById("$0");
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  $0.addEventListener("click", function() {
    state.a__inst0 = btoa("hi");
    __n0.textContent = state.a__inst0 + state.b__inst0;
    state.b__inst0 = btoa("hi");
    __n0.textContent = state.a__inst0 + state.b__inst0;
  });
  function __sngl_init() {
    __n0.textContent = state.a__inst0 + state.b__inst0;
  }
  __sngl_init();
})();
</script>
</body></html>
