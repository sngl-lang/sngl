A #[js.native] declaration names a JavaScript identifier that already exists,
so the build emits no declaration for it and every call is spelled with the
name the mark wrote rather than the SNGL name it was declared under. Both
declarations here name `btoa`, and only one of them is spelled that way.

The stub is the failure worth naming. Emitted like any other bodyless
signature, `same` came out as `function btoa(s) { return ""; }` -- a
declaration shadowing the global it names, so the page parses, runs, and
answers with nothing -- and `renamed` as `function renamed(s) { return ""; }`,
which nothing shadows and nothing calls.

deny out/none/html/index.html `function btoa\(` -- the global already exists; a declaration here would shadow it
deny out/none/html/index.html `function renamed\(` -- the same declaration under its SNGL name, which nothing calls either
deny out/none/html/index.html ` renamed\(` -- a call carries the foreign name, never the SNGL one
-- app.sngl --
import . "sngl:ui"
import js "sngl:language/js"

output { none { html } }

#[js.native("btoa")]
func btoa(s string) string

#[js.native("btoa")]
func renamed(s string) string

component main node {
    var a = "unset"
    var b = "unset"

    text(value=a + b)
    button(text="go", @click {
        a = btoa("hi")
        b = renamed("hi")
    })
}

window {
    main
}
-- out/none/html/index.html --
