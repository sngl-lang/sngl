Go codegen for a `for` over `map<K, V>`: the two-variable loop in the handler
becomes Go's own `for k, v := range`, with nothing between it and the map
field.

-- app.sngl --
import . "sngl:ui"
import app "sngl:app"

output { go { bubbletea } }

component main ui {
    var scores map<string, int> = {alice=10, bob=20}
    var total = 0
    button(text="sum", @click {
        for var k, v = scores {
            total = total + v
        }
    })
    text(value=string(total))
}

app.window {
    main
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	scores    map[string]int
	total     int
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.scores = map[string]int{"alice": 10, "bob": 20}
	m.total = 0
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Scores() map[string]int {
	return m.scores
}

func (m Model) SetScores(v map[string]int) Model {
	m.scores = v
	return m
}

type setScoresMsg struct{ value map[string]int }

func SetScoresCmd(v map[string]int) tea.Cmd {
	return func() tea.Msg { return setScoresMsg{value: v} }
}

func (m Model) Total() int {
	return m.total
}

func (m Model) SetTotal(v int) Model {
	m.total = v
	return m
}

type setTotalMsg struct{ value int }

func SetTotalCmd(v int) tea.Cmd {
	return func() tea.Msg { return setTotalMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setScoresMsg:
		m = m.SetScores(msg.value)
	case setTotalMsg:
		m = m.SetTotal(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			for k, v := range m.scores {
				m.total = (m.total + v)
			}
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = lipgloss.NewStyle().Render(part0Prefix + " " + fmt.Sprint("sum"))
	parts = append(parts, part0)
	var part1 string
	part1 = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(m.total)))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
