A release written `{}` is a function every target defines, as the spec's
example writes one. An empty function the program wrote is otherwise inlined
away with its calls, so each emitter took an empty block for a native with
nothing to emit; a release is called by lowering after the inliner ran, and
the call named a function the output lacked -- on Go, Kotlin and JavaScript
alike (`codegen.HasBody`).

-- app.sngl --
import macro "sngl:macro"
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

#[macro.owned(close)]
struct file {
    fd int
}

func close(f file) {
}

func open(fd int) => file{fd=fd}

func size(f file) => f.fd * 10

ui.window {
    var n = 1

    ui.button(text="open", @click {
        n = size(open(n))
    })
    ui.text(value="{n}")
}
