import . "sngl://std"

// Literal struct spread: `...{a=0, b=2}` splices its written fields onto the
// target literal (last write wins), exercised through parse + check + lower by
// the flatten_struct_spread pass. Kept platform-agnostic so the generic
// testdata checkers can consume it.
struct S {
    a int = 0
    b int = 0
}

component main {
    var x S = {a=1, ...{a=0, b=2}}
    text(value=string(x.a) + "/" + string(x.b))
}
