Work a click hands to async.start runs off bubbletea's event loop, which owns
the Model's state, so the literal closes over a snapshot of the Model taken
where it is made: `m := m.snapshot()` ahead of the literal, and a snapshot
method copying each list, map and struct holding one deeply. A closure kept in
state and called inside a later Update stays on the shared state.
codegen/platform/bubbletea/async_run_test.go runs it under -race.

deny out/go/bubbletea/model.go `go func\(\) \{` -- the work closes over a snapshot, not the state the loop owns
-- app.sngl --
import async "sngl:async"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

struct Row {
    name string
    tags list[string]
}

var (
    n = 1
    rows list[Row] = [Row{name="a", tags=["x"]}]
    counts map[string, int] = {"a"=1}
    later func() = func() {}
)

ui.window(title="Async") {
    ui.button(text="read", @click {
        async.start(func() {
            if n + rows[0].tags.length() + counts.length() < 0 {
                n = 0
            }
        })
    })
    ui.button(text="arm", @click {
        later = func() {
            n = n + 1
        }
    })
    ui.button(text="fire", @click {
        later()
    })
}
-- out/go/bubbletea/model.go --
