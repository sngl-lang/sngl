win32 draws a canvas as a window of its runtime's that GDI+ paints, and
places it as any other node: `draw.canvas` is the platform's `Canvas`, whose
drawing -- each shape as the calls of the context its override makes -- is
the handler of its `@paint`, connected by its `on` (passCanvasPaint). The
board's drawing reads `hits`, so its own click asks for a paint through its
`#[gen.protocol(redraw)]`, as the dot's button does for the record's canvas,
which the record holds (passCanvasRedraw). A canvas under a branch is made in
its render slot and held where a handler elsewhere redraws it, and where a test
finds it gone with its branch. One a loop renders is a component built at run
time, whose click a closure relays and whose update loop that closure writes,
which no list of the package's holds (passIterKind walks closureFuncs). A
path's `arcTo` solves its corner with `math.atan2`, which C writes as math.h's.

-- app.sngl --
import ui "sngl:ui"
import test "sngl:test"
import draw "sngl:ui/draw"

output {
    c {
        win32
    }
}

component dot(r float) ui.node {
    var n = 0
    ui.vbox {
        draw.canvas(width=40px, height=40px) {
            draw.circle(cx=20.0, cy=20.0, r=r + float(n))
        }
        ui.button(text="grow", @click {
            n += 1
        })
    }
}

component main ui.node {
    var hits = 0
    var on = true
    var rs = [4.0, 8.0]
    ui.vbox {
        draw.canvas #board(width=40px, height=40px, scalingMode=draw.ScalingMode.fit, @click {
            hits += 1
        }) {
            draw.rect(x=0.0, y=0.0, w=float(hits), h=10.0, style=draw.Style{lineCap=draw.LineCap.round})
        }
        ui.button #flip(text="flip", @click {
            on = !on
        })
        if on {
            draw.canvas #pic(width=60px, height=20px) {
                draw.line(x1=0.0, y1=0.0, x2=float(hits), y2=20.0, style=draw.Style{stroke=#336699})
            }
        }
        for var r = rs {
            dot(r=r)
            draw.canvas(width=20px, height=20px, @click {
                hits += 1
            }) {
                draw.ellipse(cx=10.0, cy=10.0, rx=r, ry=float(hits), style=draw.Style{fill=#ff0000})
            }
        }
        draw.canvas(width=100px, height=40px) {
            draw.path(style=draw.Style{stroke=#000000, strokeWidth=2.0, lineJoin=draw.LineJoin.round}) {
                draw.moveTo(x=0.0, y=40.0)
                draw.lineTo(x=0.0, y=0.0)
                draw.arcTo(cx=60.0, cy=0.0, x=60.0, y=40.0, r=10.0)
                draw.bezierTo(cx1=70.0, cy1=0.0, cx2=80.0, cy2=40.0, x=90.0, y=20.0)
                draw.close()
            }
            draw.canvasText(x=4.0, y=30.0, content="hi", style=draw.Style{fill=#000000, fontSize=12.0, fontFamily="serif"})
        }
    }
}

ui.window(title="t") {
    main()
}

func testClickRedraws(t test.Test, c main) {
    c.board.click()
    c.board.click()
    t.assert(c.hits == 2)
}

func testBranch(t test.Test, c main) {
    t.assert(c.pic != null)
    c.flip.click()
    t.assert(c.pic == null)
}
