Async colouring crosses the boundary from a native import into SNGL. `loadAll`
declares nothing about async, but it calls a `js:` function that is declared
async, so it is emitted as `async function loadAll` with the native call
awaited at the site.

-- app.sngl --
import . "sngl:ui"
import api "js:./api"

output {
    none {
        html
    }
}

func loadAll() {
    api.fetchHello("test")
}

component main {
    button(text="Go", @click { loadAll() })
}
-- api/index.ts --
export async function fetchHello(url: string): Promise<string> { return "hi"; }
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<button id="$0">
  <span>Go</span>
</button>

<script>
(() => {
  // sngl-virt:/sngl/api/index.ts
  async function fetchHello(url) {
    return "hi";
  }

  // sngl-entry.js
  var state = {};
  async function loadAll() {
    await fetchHello("test");
  }
  var $0 = document.getElementById("$0");
  $0.addEventListener("click", async function() {
    await loadAll();
  });
})();
</script>
</body></html>
