`method` on a Go native mark calls the identifier on its first argument.

Without it a native name is emitted as written, with the receiver handed to it
as argument zero: `gfx.Context.Circle(c, 1, 2, 3)`. That is valid Go — a method
expression — but it is not how anyone writes Go, and it is not expressible at
all in a language whose methods are properties of the receiver (see
native_method_js.txtar).

Which shape a host API wants is the API's to say, so it is a flag rather than a
rule: cairo takes its context first and wants the default, a Go method wants
this.

The mark's name keeps its own qualifier, since a Go package's name is not a
function of its import path; the receiver supplies package and type here, so
only the last segment is emitted. `gfx.Reset(c)` in the same output is the
unflagged form, for contrast -- the same declaration shape, called the other
way.

deny out/go/bubbletea/model.go `Context\.Circle\(` -- the method expression is what the flag replaces

-- app.sngl --
import ui "sngl:ui"
import go "sngl:language/go"

output {
    go {
        bubbletea
    }
}

#[go.native("example.com/gfx", "gfx.Context")]
struct Ctx {}

#[go.native("example.com/gfx", "gfx.Context.Circle", method)]
func Ctx.circle(cx float, cy float, r float)

#[go.native("example.com/gfx", "gfx.Reset")]
func reset(c Ctx)

component main() ui.node {
    var n = 0

    func paint(c Ctx) {
        c.circle(1.0, 2.0, 3.0)
        reset(c)
    }

    ui.button(text="draw", @click { n += 1 })
}

ui.window {
    main()
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"example.com/gfx"
	"fmt"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	n__inst0  int
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.n__inst0 = 0
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) paint__inst0(c gfx.Context) {
	c.Circle(1, 2, 3)
	gfx.Reset(c)
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) N__inst0() int {
	return m.n__inst0
}

func (m Model) SetN__inst0(v int) Model {
	m.n__inst0 = v
	return m
}

type setN__inst0Msg struct{ value int }

func SetN__inst0Cmd(v int) tea.Cmd {
	return func() tea.Msg { return setN__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setN__inst0Msg:
		m = m.SetN__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.n__inst0 += 1
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	contentFocused := (m.__focusID == 0)
	contentPrefix := " "
	if contentFocused {
		contentPrefix = ">"
	}
	content = lipgloss.NewStyle().Render(contentPrefix + " " + fmt.Sprint("draw"))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
