gtk4's `ui.datepicker` override writes `GtkCalendar #cal`, and main writes a
`#cal` of its own that `c.cal` names. The calendar is another body's node, so
it is renamed `cal__own0`, and the effect in the override that reads it with
it (internal/lower/test_ref_owner.go).

cmd/sngl/testdata/test_ref_owner_library_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        gtk4
    }
}

component main node {
    var shown = false
    vbox {
        datepicker
        button #t(text="t", @click { shown = !shown })
        if shown {
            text #cal(value="c")
        }
    }
}

func testCal(t Test, c main) {
    t.assert(c.cal == null)
    c.t.click()
    t.assert(c.cal != null)
    c.t.click()
    t.assert(c.cal == null)
}

window {
    main
}
