A view loop html writes into its markup evaluates its iterable at build time,
and an element holding a `measurement` -- a multi-base unit, a magnitude per
base -- is one it can evaluate: the optimizer holds it as the interpreter's
unit value and spells it back per base. It used to be unevaluable, and the
unroll then wrote one copy of the body with its variable bound to nothing.

deny out/none/html/index.html `<span>\s*</span>` -- every copy is written with its row bound
-- app.sngl --
import ui "sngl:ui"

output {
    none { html }
}

struct Row {
    label  string
    indent ui.measurement
}

const rows = [Row{label="a", indent=4px}, Row{label="b", indent=1rem + 2px}]

ui.window {
    ui.vbox {
        for var r = rows {
            ui.text(value=r.label, style={paddingLeft=r.indent})
        }
    }
}
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<div style="display:flex;flex-direction:column">
  <span style="padding-left:4px">a</span>
  <span style="padding-left:calc(2px + 16em)">b</span>
</div>

<script>
(() => {
  // sngl-entry.js
  var state = { visible__inst0: true };
})();
</script>
</body></html>
