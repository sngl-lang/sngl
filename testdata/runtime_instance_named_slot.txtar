package main

import "testing"

func TestEachCopyRendersItsOwnCells(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.mounted == "1:1 1:11 2:2 2:12 ")) { t.Errorf("assert failed: %s", "(c.mounted == \"1:1 1:11 2:2 2:12 \")") }
	c.addClick()
	if !((c.mounted == "1:1 1:11 2:2 2:12 3:3 3:13 ")) { t.Errorf("assert failed: %s", "(c.mounted == \"1:1 1:11 2:2 2:12 3:3 3:13 \")") }
}


func newTestComponent() Model { return New() }
