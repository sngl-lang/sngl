fun _snglFloatStr(v: Double): String =
    if (v.isFinite() && v == kotlin.math.floor(v) && kotlin.math.abs(v) < 9.007199254740992E15) v.toLong().toString() else v.toString()

fun _snglSplit(s: String, sep: String): List<String> =
    if (sep.isEmpty()) s.map { it.toString() } else s.split(sep)

class MainScreenState {
    val items = mutableStateListOf(1, 2)
    var mounted by mutableStateOf("")
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainScreen(state: MainScreenState = remember { MainScreenState() }) {

    Column(modifier = Modifier.safeDrawingPadding()) {
        Button(onClick = {
            state.items.add(3)
        }, modifier = Modifier.testTag("add")) {
            Text(text = "add", modifier = Modifier)
        }
        for (i in state.items) {
            Card(start = i, cell = { row ->
                Text(text = ((("item " + i.toString()) + " row ") + row.toString()), modifier = Modifier)
                DisposableEffect(((i.toString() + ":") + row.toString())) {
                    val __snglEffectKey = ((i.toString() + ":") + row.toString())
                    run {
                        val k = __snglEffectKey
                        state.mounted = ((state.mounted + k) + " ")
                    }
                    onDispose {
                    }
                }
            })
        }
        for (i in state.items) {
            Card(start = i)
        }
    }
}

@Composable
fun Card(start: Int = 0, cell: (@Composable (Int) -> Unit)? = null) {
    val rows = remember { mutableStateListOf(start, (start + 10)) }

    Column(modifier = Modifier) {
        Button(onClick = {
            rows.add((start + 100))
        }, modifier = Modifier) {
            Text(text = "more", modifier = Modifier)
        }
        for (r in rows) {
            if (cell != null) {
                cell(r)
            } else {
                Text(text = "empty", modifier = Modifier)
            }
        }
    }
}
