A sql: import on Go runs each statement through snglsql, naming the engine's
own package so only its driver is linked; the rows arrive as JSON and are
decoded by the codec every target holds. An int64 literal handed to an
option[int64] keeps its width, and the zero return after a match over an
async.Result[list[T]] is a slice of the right type.

deny out/go/bubbletea/model.go `snglpostgresql|snglmysql|\[\]any\{\}|snglSome\(252\)` -- one engine's driver, typed literals

-- app.sngl --
import books "sql:./db/query.sql"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

component main ui.node {
    var count int64 = 0
    var title = "-"
    var found option[list[books.FindRow]] = null
    books.find(pattern="%a%", :value=found)
    ui.button(text="Add", @click {
        match var id = books.addCall(title="Tehanu", pages=252) {
            ok { count = id }
            failed { title = id.message }
        }
    })
    ui.button(text="Count", @click {
        match var n = books.countCall() {
            ok { count = n.or(0) }
            failed { count = -1 }
        }
    })
    ui.text(value="{count} {title}")
}

ui.window {
    main
}
-- db/schema.sql --
CREATE TABLE books (
  id    INTEGER PRIMARY KEY,
  title TEXT NOT NULL,
  pages INTEGER
);
-- db/query.sql --
-- sngl:schema schema.sql

-- name: Add :execlastid
INSERT INTO books (title, pages) VALUES (?, ?);

-- name: Count :one
SELECT count(*) FROM books;

-- name: Find :many
SELECT id, title FROM books WHERE title LIKE sqlc.arg(pattern);
