A builder grows text in place. Go holds one as a []byte and Kotlin as a
StringBuilder, each answering add, line and string itself and copying one
where a store copies a value; JavaScript, and so html, takes
passStringBuilders, which writes the builder as the string it builds and each
add as a `+=`. The tests run on every target, the interpreter included
(testdata/builder.sngl).

deny out/go/fyne/model.go `\+= ` -- Go adds to a []byte rather than to a string
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `\+= ` -- Kotlin appends to a StringBuilder rather than adding to a string
deny out/none/html/index.html `StringBuilder|\b[bc](__own)?\.(add|line|string)\(` -- the script holds a builder as a string

-- builder.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}

struct Page {
    title string
    body  builder
}

func lines(names list[string]) string {
    var b builder
    for var n = names {
        b.line(n)
    }
    return b.string()
}

func heading(b ref[builder], title string) {
    b.add("# ")
    b.line(title)
}

func touched(b builder) string {
    b.add("!")
    return b.string()
}

func pages() string {
    var p = Page{title="t"}
    p.body.line("one")
    var q = p
    q.body.line("two")
    return "{p.body}|{q.body}"
}

component main node {
    var shown = ""

    button #go(text="Go", @click {
        var b builder
        b.add("x")
        b.line()
        heading(&b, "T")
        var c = b
        c.add("y")
        shown = string(b) + "|" + touched(c) + "|" + lines([shown + "a", "b"]) + "|" + pages()
    })
    text(value=shown)
}

window {
    main()
}

func testBuilds(t Test, c main) {
    c.go.click()
    t.assert(c.shown == "x\n# T\n|x\n# T\ny!|a\nb\n|one\n|one\ntwo\n")
}
