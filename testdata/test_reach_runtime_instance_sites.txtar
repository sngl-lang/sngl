A test reaches through a component the program renders at several sites --
`badge` under an `if`, under a `for`, and twice inside `panel` -- each
site's nodes and state its own: passTestReach copies the component for
each site a test reaches into (`badge__site0`), so an id names one site's
node. `c.p.inner` and `c.p.fixed` reach through two instances, one built at
run time inside one that is spliced.

cmd/sngl/testdata/test_reach_runtime_instance_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component badge(label string) node {
    var hits = 0
    text #shown(value="[{label}:{hits}]")
    button #hit(text="hit", @click {
        hits = hits + 1
    })
    if hits >= 2 {
        text #done(value="done")
    }
}

component panel node {
    var open = true
    vbox {
        if open {
            badge #inner(label="in")
        }
        badge #fixed(label="fixed")
    }
}

component main node {
    var show = true
    var names list[string] = ["a", "b"]
    vbox {
        if show {
            badge #b(label="one")
        }
        for var n = names {
            badge #r(label=n)
        }
        panel #p
    }
}

func testEachSiteIsItsOwn(t Test, c main) {
    if c.b != null {
        c.b.hit.click()
        t.assert(c.b.hits == 1)
    }
    if c.r[1] != null {
        c.r[1].hit.click()
        c.r[1].hit.click()
        t.assert(c.r[1].hits == 2)
        t.assert(c.r[1].done != null)
        t.assert(c.r[0].done == null)
        t.assert(c.r[1].shown.value == "[b:2]")
    }
    if c.b != null {
        t.assert(c.b.done == null)
        t.assert(c.b.hits == 1)
    }
}

func testReachesThroughTwoInstances(t Test, c main) {
    if c.p.inner != null {
        c.p.inner.hit.click()
        t.assert(c.p.inner.hits == 1)
        t.assert(c.p.inner.label == "in")
        t.assert(c.p.fixed.hits == 0)
    } else {
        t.assert(false)
    }
    c.p.fixed.hit.click()
    t.assert(c.p.fixed.hits == 1)
    t.assert(c.p.fixed.shown.value == "[fixed:1]")
}

window {
    main
}
