package main

import (
	"fmt"
	"testing"
)

func TestEachSiteIsItsOwn(t *testing.T) {
	c := newTestComponent()
	_ = c
	if c.show {
		c.hit__reach0Click()
		if !((c.bReadHits() == 1)) { t.Errorf("assert failed: %s", "(c.bReadHits() == 1)") }
	}
	if (1 < len(c.names)) {
		c.hit__reach1ClickAt("1")
		c.hit__reach1ClickAt("1")
		if !((c.rReadHitsAt("1") == 2)) { t.Errorf("assert failed: %s", "(c.rReadHitsAt(\"1\") == 2)") }
		if !(c.done__reach0PresentAt("1")) { t.Errorf("assert failed: %s", "c.done__reach0PresentAt(\"1\")") }
		if !(!c.done__reach0PresentAt("0")) { t.Errorf("assert failed: %s", "!c.done__reach0PresentAt(\"0\")") }
		if !(((((("[" + c.names[1]) + ":") + fmt.Sprint(c.rReadHitsAt("1"))) + "]") == "[b:2]")) { t.Errorf("assert failed: %s", "(((((\"[\" + c.names[1]) + \":\") + fmt.Sprint(c.rReadHitsAt(\"1\"))) + \"]\") == \"[b:2]\")") }
	}
	if c.show {
		if !(!c.done__reach1Present()) { t.Errorf("assert failed: %s", "!c.done__reach1Present()") }
		if !((c.bReadHits() == 1)) { t.Errorf("assert failed: %s", "(c.bReadHits() == 1)") }
	}
}

func TestReachesThroughTwoInstances(t *testing.T) {
	c := newTestComponent()
	_ = c
	if c.open__inst0 {
		c.hit__reach2Click()
		if !((c.innerReadHits() == 1)) { t.Errorf("assert failed: %s", "(c.innerReadHits() == 1)") }
		if !(true) { t.Errorf("assert failed: %s", "true") }
		if !((c.hits__inst0 == 0)) { t.Errorf("assert failed: %s", "(c.hits__inst0 == 0)") }
	} else {
		if !(false) { t.Errorf("assert failed: %s", "false") }
	}
	c.hit__reach3Click()
	if !((c.hits__inst0 == 1)) { t.Errorf("assert failed: %s", "(c.hits__inst0 == 1)") }
	if !(((("[fixed:" + fmt.Sprint(c.hits__inst0)) + "]") == "[fixed:1]")) { t.Errorf("assert failed: %s", "(((\"[fixed:\" + fmt.Sprint(c.hits__inst0)) + \"]\") == \"[fixed:1]\")") }
}

