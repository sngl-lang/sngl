package main

import (
	"fmt"
	"testing"
)

func TestEachSiteIsItsOwn(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if c.show {
		c.hit__reach0Click()
		if !((c.hits__inst0 == 1)) { t.Errorf("assert failed: %s", "(c.hits__inst0 == 1)") }
	}
	if (1 < len(c.names)) {
		c.hit__reach1ClickAt("1")
		c.hit__reach1ClickAt("1")
		if !((func() int { if __v, __ok := c.hits__inst1[__identified0(c.names)[1].Id]; __ok { return __v }; return 0 }() == 2)) { t.Errorf("assert failed: %s", "(func() int { if __v, __ok := c.hits__inst1[__identified0(c.names)[1].Id]; __ok { return __v }; return 0 }() == 2)") }
		if !(c.done__reach0PresentAt("1")) { t.Errorf("assert failed: %s", "c.done__reach0PresentAt(\"1\")") }
		if !(!c.done__reach0PresentAt("0")) { t.Errorf("assert failed: %s", "!c.done__reach0PresentAt(\"0\")") }
		if !(((((("[" + c.names[1]) + ":") + fmt.Sprint(func() int { if __v, __ok := c.hits__inst1[__identified0(c.names)[1].Id]; __ok { return __v }; return 0 }())) + "]") == "[b:2]")) { t.Errorf("assert failed: %s", "(((((\"[\" + c.names[1]) + \":\") + fmt.Sprint(func() int { if __v, __ok := c.hits__inst1[__identified0(c.names)[1].Id]; __ok { return __v }; return 0 }())) + \"]\") == \"[b:2]\")") }
	}
