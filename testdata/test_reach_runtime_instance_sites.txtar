func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setShowMsg:
		m = m.SetShow(msg.value)
	case setNamesMsg:
		m = m.SetNames(msg.value)
	case setHits__inst0Msg:
		m = m.SetHits__inst0(msg.value)
	case setHits__inst1Msg:
		m = m.SetHits__inst1(msg.value)
	case setOpen__inst0Msg:
		m = m.SetOpen__inst0(msg.value)
	case setHits__inst2Msg:
		m = m.SetHits__inst2(msg.value)
	case setHits__inst3Msg:
		m = m.SetHits__inst3(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.MouseClickMsg:
		if msg.Button == tea.MouseLeft {
			if s, ok := m.__clicks.At(msg.X, msg.Y); ok {
				cmds = append(cmds, m.__press(s))
			}
		}
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0 && (m.__pressing || m.__focusShown()):
			m.hits__inst0 = (m.hits__inst0 + 1)
		case msg.Code == tea.KeyEnter && m.__focusID == 1 && (m.__pressing || m.__focusShown()):
			func() {
				__focusPos1 := 0
				for __copy0, n := range __identified0(m.names) {
					_ = __copy0
					_ = n
					if m.__focusLoop1_cursor == __focusPos1 {
						var __cell2_hits__inst1 int = func() int {
							if __v, __ok := m.hits__inst1[n.Id]; __ok {
								return __v
							}
							return 0
						}()
						__cell2_hits__inst1 = (func() int {
							if __v, __ok := m.hits__inst1[n.Id]; __ok {
								return __v
							}
							return 0
						}() + 1)
						m.hits__inst1[n.Id] = __cell2_hits__inst1
						return
					}
					__focusPos1++
				}
			}()
		case msg.Code == tea.KeyEnter && m.__focusID == 2 && (m.__pressing || m.__focusShown()):
			m.hits__inst2 = (m.hits__inst2 + 1)
		case msg.Code == tea.KeyEnter && m.__focusID == 3 && (m.__pressing || m.__focusShown()):
			m.hits__inst3 = (m.hits__inst3 + 1)
		}
	}
	m.__focusSettle()
	return m, tea.Batch(cmds...)
}

// __press is a click on s: focus moves to it and s's key is pressed there,
// as a key pressed on the stop Tab reached is. A stop Tab passes over gives
// focus back once it is pressed.
func (m Model) __press(s snglStop) tea.Cmd {
	prev := [...]int{m.__focusID, m.__focusLoop1_cursor}
	m.__focusID = s.slot
	switch s.slot {
	case 1:
		m.__focusLoop1_cursor = s.pos
	}
	tabbed := m.__focusShown()
	var cmd tea.Cmd
	if s.press {
		m.__pressing = true
		_, cmd = m.Update(s.key)
		m.__pressing = false
	}
	if !tabbed {
		m.__focusID = prev[0]
		m.__focusLoop1_cursor = prev[1]
	}
	return cmd
}

