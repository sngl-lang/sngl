A provider whose value reads state updates a component built at run time.

An instance under a reactive `for` is not spliced, so nothing substitutes the
provider's value into it: passContext threads the value as an argument named
for the component's hidden `__ctx_label` var, and the instance has to take it
the way it takes any prop. It could not. The factory declared the var from the
context's default and ignored the argument, so every instance read "a" under
any provider -- and a provider reading state was refused outright, the var
having no setter for the update to reach.

passComponentProps now turns the hidden var into a prop of the instance,
defaulting to the context's default, so it is read from the constructor, kept
in a cell and absorbed by `__set___ctx_label` like the declared `n`.

-- main.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

context #label("a")

component show(n int) ui.node {
    ui.text(value="{label} {n}")
}

ui.window #home(title="t", href="/") {
    var txt = "b"
    var xs = [1, 2]

    ui.vbox {
        ui.button(text="flip", @click { txt = "c" })
        label(txt) {
            for var x = xs {
                show(n=x)
            }
        }
    }
}
