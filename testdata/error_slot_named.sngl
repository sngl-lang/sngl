// What a named slot rejects.
//
// The declaration is in the parameter list. What a call site writes is a
// population naming one of the callee's slots, matched by name and bound by
// position -- so a name it does not declare, a second population of one slot,
// and a count that does not match are each refused where they are written.

import . "sngl:ui"
import app "sngl:app"

struct Row {
    title string
}

component table(rows list<Row>, cell component(Row)) node {
    vbox {
        for var r = rows {
            cell(r)
        }
        // An insertion passes values positionally: the declaration carries
        // types and no names, so there is nothing for a named argument to
        // bind to.
        cell(value=r) // ERROR(check) "takes positional arguments"
        cell()        // ERROR(check) "takes 1 argument(s), got 0"
    }
}

// A slot is resolved as a tag from anywhere in the body, so a func or var of
// the same name is a collision the parameter list on its own cannot see. Left
// unreported, the call in a handler became a slot insertion nothing renders and
// codegen panicked on it.
component collidesWithFunc(ping component, children ...component) node {
    func ping() {} // ERROR(check) "already declared as a slot"
    vbox {
        ping {
            text(value="fb")
        }
    }
}

component main node {
    table(rows=[]) {
        component cell(row) {
            text(value=row.title)
        }
        // Two populations of one slot: the second has nowhere to go.
        component cell(row) { // ERROR(check) "is already populated"
            text(value=row.title)
        }
        // A name the callee does not declare.
        component nope { // ERROR(check) "has no slot"
            text(value="x")
        }
    }

    table(rows=[]) {
        // A population binds names to the insertion's arguments, so the
        // count has to match what the slot declares.
        component cell(row, extra) { // ERROR(check) "binds 2 parameter(s), but declares 1"
            text(value=row.title)
        }
    }
}

app.window {
    main
}
