Each spliced copy of an override holds its own node handles.

gtk4's datepicker override reads `#cal` from its own effect, and its input
override reads `#entry` the same way. passInlinePure copied the body per call
site but left the handle shared, so two of either in one window held one
`#cal` and uniqueNodeIDs refused the effect's read as unable to say which copy
it meant. freshNodeHandles gives each splice its own; the test types into
each input and checks the other kept its own value.

-- app.sngl --
import . "sngl:test"
import time "sngl:time"
import ui "sngl:ui"

output {
    go {
        gtk4
    }
}

component main ui.node {
    var a = ""
    var b = ""
    var d option[time.date] = null

    ui.vbox {
        ui.input #first(:value=a)
        ui.input #second(:value=b)
        ui.datepicker(:value=d)
        ui.datepicker()
    }
}

func testEachInputIsItsOwn(t Test, c main) {
    c.first.input("x")
    c.second.input("y")
    t.assert(c.a == "x")
    t.assert(c.b == "y")
}

ui.window {
    main
}
