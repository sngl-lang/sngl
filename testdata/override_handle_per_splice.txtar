func main() {
	runtime.LockOSThread()
	app := C.gtk_application_new(nil, C.G_APPLICATION_NON_UNIQUE)
	C.g_signal_connect_data((C.gpointer)(unsafe.Pointer(app)),
		snglActivateSignal,
		C.GCallback(C.snglActivate), nil, nil, 0)
	status := C.g_application_run((*C.GApplication)(unsafe.Pointer(app)), 0, nil)
	if status != 0 {
