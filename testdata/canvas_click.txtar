package main

import "testing"

func TestClickCounts(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.boardClick()
	if !((c.hits == 1)) { t.Errorf("assert failed: %s", "(c.hits == 1)") }
	c.boardClick()
	if !((c.hits == 2)) { t.Errorf("assert failed: %s", "(c.hits == 2)") }
}

