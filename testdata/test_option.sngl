struct Todo {
    text string = ""
    done bool = false
}

func testOptionDefaultsToNull(t Test, c main) {
    t.assert(c.name == null)
    t.assert(c.count != null)
    t.assert(c.todo == null)
    t.assert(c.flag != null)
}

func testOptionAcceptsConcreteValues(t Test, c main) {
    c.name = "hello"
    t.assert(c.name != null)
    t.assert(c.name == "hello")
    c.count = 42
    t.assert(c.count == 42)
}

component main {
    var (
        name option<string>
        count option<int> = 5
        todo option<Todo> = null
        flag option<bool> = true
    )

    text(value="test")
}
