-- component_menubar.sngl --
import . "sngl:ui"
import . "sngl:dialog"

// menubar: A-tier — declaration only.
component main node {
    menubar(items=["File", "Edit", "View", "Help"])
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from component_menubar.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentChildren []string
	content = lipgloss.JoinHorizontal(lipgloss.Top, contentChildren...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
