A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

html writes the bar's entries into the page, one button per record, so the
loop over them unrolls at build time with each record's `@select` handler a
constant: each button calls its own entry's handler.

deny out/none/html/index.html `it\.select` -- each copy calls its record's handler, not a loop variable nothing declares

-- component_menubar.sngl --
import . "sngl:ui"
import . "sngl:dialog"

// menubar: A-tier — declaration only.
component main node {
    var last = ""
    menubar {
        menuItem(label="File") {
            menuItem(label="Open", @select {
                last = "open"
            })
        }
        menuItem(label="Edit", @select {
            last = "edit"
        })
        menuItem(label="View")
        menuItem(label="Help")
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
