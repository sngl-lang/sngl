-- component_menubar.sngl --
import . "sngl:ui"
import . "sngl:dialog"

// menubar: A-tier — declaration only.
component main node {
    menubar(items=["File", "Edit", "View", "Help"])
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
