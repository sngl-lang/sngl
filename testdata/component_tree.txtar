package main

import (
	"charm.land/bubbles/v2/list"
	"charm.land/bubbletea/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/tui"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	sel       string
	__focusID int

	widget0 list.Model

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.sel = ""
	m.__focusID = 0
	m.widget0 = tui.NewList(tui.StringItems([]string{"Documents", "Photos", "Music"}), 40, 10)
	m.resizeWidgets()
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
	m.resizeWidgets()
}

// resizeWidgets sizes each bubbles widget to the current terminal extent.
func (m *Model) resizeWidgets() {
	m.widget0.SetSize(tui.WidgetWidth(m.width), tui.WidgetHeight(m.height))
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Sel() string {
	return m.sel
}

func (m Model) SetSel(v string) Model {
	m.sel = v
	return m
}

type setSelMsg struct{ value string }

func SetSelCmd(v string) tea.Cmd {
	return func() tea.Msg { return setSelMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setSelMsg:
		m = m.SetSel(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
		m.resizeWidgets()
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		}
	}
	if m.__focusID == 0 {
		m.widget0, cmd = m.widget0.Update(msg)
		cmds = append(cmds, cmd)
		m.sel = tui.SelectedString(m.widget0)
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = m.widget0.View()
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
