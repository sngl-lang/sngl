	m.sel__inst0 = ""
	m.__focusID = 0
	m.widget0 = tui.NewList(tui.StringItems([]string{"Documents", "Photos", "Music"}), 40, 10)
	m.resizeWidgets()
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
	m.resizeWidgets()
}

// resizeWidgets sizes each bubbles widget to the current terminal extent.
func (m *Model) resizeWidgets() {
	m.widget0.SetSize(tui.WidgetWidth(m.width), tui.WidgetHeight(m.height))
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Sel__inst0() string {
	return m.sel__inst0
}

func (m Model) SetSel__inst0(v string) Model {
	m.sel__inst0 = v
	return m
}

type setSel__inst0Msg struct{ value string }

func SetSel__inst0Cmd(v string) tea.Cmd {
	return func() tea.Msg { return setSel__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setSel__inst0Msg:
		m = m.SetSel__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
		m.resizeWidgets()
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		}
	}
	if m.__focusID == 0 {
		m.widget0, cmd = m.widget0.Update(msg)
		cmds = append(cmds, cmd)
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = m.widget0.View()
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
