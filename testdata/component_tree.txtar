A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_tree.sngl --
import . "sngl:ui"
import . "sngl:test"

// tree: state-binding fixture — mutating the bound `selected`
// label changes the chosen node.
component main node {
    var sel = ""
    tree(:selected=sel) {
        treeItem(label="Documents") {
            treeItem(label="Taxes")
        }
        treeItem(label="Photos")
        treeItem(label="Music")
    }
}

func testTreeSelectedMutates(t Test, c main) {
    t.assert(c.sel == "")
    c.sel = "Photos"
    t.assert(c.sel == "Photos")
    c.sel = "Music"
    t.assert(c.sel == "Music")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
