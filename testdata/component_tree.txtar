package main

import "testing"

func TestTreeSelectedMutates(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.sel == "")) { t.Errorf("assert failed: %s", "(c.sel == \"\")") }
	c.sel = "Photos"
	if !((c.sel == "Photos")) { t.Errorf("assert failed: %s", "(c.sel == \"Photos\")") }
	c.sel = "Music"
	if !((c.sel == "Music")) { t.Errorf("assert failed: %s", "(c.sel == \"Music\")") }
}


func newTestComponent() Model { return New() }
