`async.query` written straight into a loop, its fetch a function that blocks,
on the Go targets. The query is built per copy, so `fetch` is a prop of the
instance it is, and the call through the prop runs on a goroutine with the
rest of the mount posted back, as a fetch the query is spliced with does
(async_query_go.txtar). Coloured by nothing, it ran on the drawing thread.
The fetch is read off the instance before the goroutine starts, as the key
is: a setter on the drawing thread writes it.

deny out/go/fyne/model.go `go func\(\) \{\n\s*r := c\.` -- the goroutine reads no state: the fetch and the key are bound before it starts
deny out/go/gtk4/model.go `go func\(\) \{\n\s*r := c\.` -- the goroutine reads no state: the fetch and the key are bound before it starts

-- app.sngl --
import async "sngl:async"
import go "sngl:language/go"
import ui "sngl:ui"

#[go.native("time", "time.Sleep")]
#[go.async]
func sleep(ns int)

func lookup(name string) async.Result[int] {
    sleep(1000)
    return {ok=name.length()}
}

component lengths ui.node {
    var names = ["blueberry", "fig"]
    var total = 0

    ui.vbox {
        for var n = names {
            async.query(on=n, fetch=lookup, @load(got) { total += got })
        }
        ui.text(value="{total}")
        ui.button(text="add", @click { names.push("grape") })
    }
}

ui.window {
    lengths()
}

output {
    go {
        fyne
        gtk4
    }
}
-- out/go/fyne/model.go --
