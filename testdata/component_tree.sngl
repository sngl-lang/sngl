import . "sngl:std"

// tree: state-binding fixture — mutating the bound `selected`
// label changes the chosen node.
component main {
    var sel = ""
    tree(items=["Documents", "Photos", "Music"], selected=sel)
}

func testTreeSelectedMutates(t Test, c main) {
    t.assert(c.sel == "")
    c.sel = "Photos"
    t.assert(c.sel == "Photos")
    c.sel = "Music"
    t.assert(c.sel == "Music")
}
