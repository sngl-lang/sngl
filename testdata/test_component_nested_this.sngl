component counter {
    var n = 0
    func bump()  { n += 1 }       // bare field
    func reset() { this.n = 0 }   // explicit this
    func value() int => n         // bare field in expression body
}

component main {
    counter()
}

func testComponentThisElision(t Test, c main) {
    var cc = c.children[0]
    cc.bump()
    cc.bump()
    cc.bump()
    t.assert(cc.value() == 3)
    cc.reset()
    t.assert(cc.value() == 0)
}
