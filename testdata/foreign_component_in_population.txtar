A stateful component from an imported package, rendered only inside a slot
population, has its body inlined like any other.

The lowering widens its inline set with the imported components a build
renders, found by walking every body from the program's own. That walk read a
node's children and handlers and not its populations, nor the populations an
insertion writes for a slot's component entries, so `lib.counter` here was
never reached, stayed a node, and html drew the stdlib `text` it renders as a
bare `<text>` element with nothing in it. A component with no state was
unaffected, being substituted by the optimizer before the question is asked.

`page` is the second position: `lib.tally` is the content an insertion
supplies for a component entry. Each component is instantiated once, because
two instances of one imported stateful component share a node id and read
their props before binding them on html, which is a separate defect.

deny * `<text` -- ui.text is html's span; a raw element means the body was never inlined

-- app.sngl --
import ui "sngl:ui"
import lib "./lib"

output {
    none {
        html
    }
}

component frame(main component ui.node) ui.node {
    ui.vbox {
        main
    }
}

component site(page component(content component ui.node) ui.node) ui.node {
    page {
        component content {
            lib.tally
        }
    }
}

ui.window {
    frame {
        component main {
            lib.counter
        }
    }
    site {
        component page(body) {
            body
        }
    }
}
-- lib/lib.sngl --
import ui "sngl:ui"

component counter ui.node {
    var n = 1

    ui.text(value="n is {n}")
}

component tally ui.node {
    var n = 2

    ui.text(value="tally is {n}")
}
