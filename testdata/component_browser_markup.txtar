A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_browser_markup.sngl --
// The markup each sngl:ui component leaves in a live page once its script has
// run, read in the browser: what the golden shows is the document as written,
// and some of what an element ends up carrying is set by script.

import "sngl:test/browser"
import . "sngl:test"
import . "sngl:ui"

component widgets node {
    var name = "Bob"
    var fruit = "b"
    var pick = "y"
    var note = "hi"
    var sel = 0
    var open = true
    vbox #col {
        text #text(value="HELLO")
    }
    vbox #styled(style={gap=8px, background=#ff0000}) {
        text(value="A")
    }
    text #colored(value="A", style={color=#112233})
    hbox #row {
        text(value="A")
    }
    button #button(text="CLICK")
    input #input(:value=name)
    checkbox #check(label="ok", checked=true)
    image #image(alt="pic") {
        remote(url="/x.png")
    }
    link #link(text="Home", href="/")
    select #select(:value=fruit, placeholder="pick") {
        choice(label="a")
        choice(label="b")
        choice(label="c")
    }
    radio #radio(:value=pick) {
        choice(label="x")
        choice(label="y")
    }
    textarea #area(:value=note, rows=3)
    tabs #tabs(:selected=sel) {
        tab(label="One") {
            text(value="panel")
        }
        tab(label="Two") {
            text(value="other")
        }
    }
    table #table(columns=["A", "B"]) {
        tableRow(cells=["1", "2"])
        tableRow(cells=["3", "4"])
    }
    tree #tree {
        treeItem(label="root") {
            treeItem(label="child")
        }
    }
    modal #modal(open=open, title="Dialog") {
        component content {
            text(value="body")
        }
    }
    divider #divider()
    badge #badge(value="3")
}

func has(t Test, markup string, parts list[string]) {
    for var p = parts {
        if markup.indexOf(p) < 0 {
            t.assert(markup == p)
        }
    }
}

func testEachComponentsMarkup(t Test, c widgets) {
    has(t, browser.markup(c.col), ["flex-direction:column", ">HELLO<"])
    has(t, browser.markup(c.text), ["<span", "HELLO"])
    has(t, browser.markup(c.styled), ["flex-direction:column", "gap:8px", "background-color:#ff0000"])
    has(t, browser.markup(c.colored), ["color:#112233"])
    has(t, browser.markup(c.row), ["flex-direction:row"])
    has(t, browser.markup(c.button), ["<button", "CLICK"])
    has(t, browser.markup(c.input), ["<input"])
    has(t, browser.markup(c.check), ["type=\"checkbox\"", "ok"])
    has(t, browser.markup(c.image), ["<img", "src=\"/x.png\"", "aria-label=\"pic\""])
    has(t, browser.markup(c.link), ["<a", "href=\"/\"", "Home"])
    has(t, browser.markup(c.select), ["<select", "<option", ">a<", ">b<", ">c<", "pick"])
    has(t, browser.markup(c.radio), ["<fieldset", "type=\"radio\"", "value=\"x\"", "value=\"y\""])
    has(t, browser.markup(c.area), ["<textarea", "rows=\"3\""])
    has(t, browser.markup(c.tabs), ["role=\"tablist\"", "One", "Two", "panel"])
    has(t, browser.markup(c.table), ["<table", "<thead", "<tbody", ">A<", ">B<", ">1<", ">4<"])
    has(t, browser.markup(c.tree), ["<ul", "<li", "root", "child"])
    has(t, browser.markup(c.modal), ["Dialog", "body"])
    has(t, browser.markup(c.divider), ["<hr"])
    has(t, browser.markup(c.badge), ["3"])
}

window {
    widgets
}

output {
    none {
        html
    }
}
