A component's own names do not collide with the names the Go targets emit.

Two collisions, each a name a program may reasonably write:

- a prop named `container` was the fyne record ctor's parameter, shadowing
  the `container` package the ctor builds boxes with
  (`container.NewVBox undefined (type string ...)`); ctor parameters are
  `__a_<prop>` now, and only the ctor names them.
- a var named `parent` on gtk4, or `__parent` on fyne, was read inside a
  render slot whose own parameter has that name, and the Go context -- which
  resolves by name -- rendered the read as the parameter
  (`parent > 0 (mismatched types gtk4rt.Handle and untyped int)`). A read
  whose symbol is a state var of the scope is that var, whatever local shares
  its name.
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
        gtk4
    }
}

component row(container string) node {
    var parent = 0
    var __parent = 0

    hbox {
        if parent + __parent > 0 {
            text(value="{container}")
        }
        button(text="hit", @click {
            parent += 1
            __parent += 1
        })
    }
}

component main node {
    var parent = 1
    var xs = ["a", "b"]

    vbox {
        if parent > 0 {
            text(value="p {parent}")
        }
        button #bump(text="bump", @click { parent += 1 })
        for var x = xs {
            row(container=x)
        }
    }
}

func testBump(t Test, c main) {
    c.bump.click()
    t.assert(c.parent == 2)
}

window {
    main
}
