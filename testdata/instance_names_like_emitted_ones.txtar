package main

import "testing"

func TestBump(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.bumpClick()
	if !((c.parent == 2)) { t.Errorf("assert failed: %s", "(c.parent == 2)") }
}

