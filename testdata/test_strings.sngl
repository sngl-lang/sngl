component greeting {
    var name = "world"
    var msg = "hello"

    text(value="{msg}")
}

func testConcatenation(t Test, c greeting) {
    t.assert("hello" + " " + "world" == "hello world")
}

func testInterpolation(t Test, c greeting) {
    t.assert("hello {c.name}" == "hello world")
}

func testLength(t Test, c greeting) {
    t.assert("hello".length() == 5)
    t.assert("".length() == 0)
}

func testContains(t Test, c greeting) {
    t.assert("hello world".contains("world"))
    t.assert(!"hello world".contains("xyz"))
}

func testStringConcatAssignment(t Test, c greeting) {
    c.msg += " world"
    t.assert(c.msg == "hello world")
}
