component greeting {
    var name = "world"
    var msg = "hello"

    text(value="{msg}")
}

test greeting "concatenation" {
    assert("hello" + " " + "world" == "hello world")
}

test greeting "interpolation" {
    assert("hello {name}" == "hello world")
}

test greeting "len" {
    assert(len("hello") == 5)
    assert(len("") == 0)
}

test greeting "contains" {
    assert("hello world".contains("world"))
    assert(!"hello world".contains("xyz"))
}

test greeting "string concat assignment" {
    msg += " world"
    assert(msg == "hello world")
}
