import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

struct Inner {
    value int = 0
}

struct Outer {
    inner Inner = Inner{value=0}
    label string = ""
}

component main ui {
    var nested Outer = {inner={value=5}, label="hi"}

    text(value=string(nested.inner.value))
}

func testNestedAnon(t Test, c main) {
    t.assert(c.nested.inner.value == 5)
    t.assert(c.nested.label == "hi")
}

app.window {
    main
}
