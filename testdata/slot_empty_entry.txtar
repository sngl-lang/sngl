A component entry a population forwards into a slot asked `.empty` is
answered by what the component inserting the population populated it with,
on every target.
testdata/slot_empty_entry.sngl is the interpreter's answer.

deny * `SlotEmpty` -- every `.empty` is answered before codegen

-- app.sngl --
import . "sngl:ui"

component boxed(content ...component node) node {
    text(value=content.empty ? "boxed empty" : "boxed full")
    content
}

component frame(layout component(content component node) node) node {
    layout {
        component content {
            text(value="inner")
        }
    }
}

component framed(inner ...component node, layout component(content component node) node) node {
    layout {
        component content {
            inner
        }
    }
}

component main node {
    var shown = false
    frame {
        component layout(content) {
            boxed {
                content
            }
        }
    }
    framed {
        component layout(content) {
            boxed {
                content
            }
        }
        if shown {
            text(value="shown")
        }
    }
    button #show(text="show", @click { shown = true })
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
