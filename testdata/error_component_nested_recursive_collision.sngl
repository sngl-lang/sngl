// Two bodies each declaring a recursive `node`. Both names are correctly
// scoped, and a recursion cycle is what passNoInlineComponents leaves standing
// -- so both reach codegen under the declared name and every backend emits one
// host component twice. Interim until #198 renames per body; without it
// `sngl generate` writes two `renderNode` methods into one Go file and exits 0.

import . "sngl:ui"

component first() node {
    component node(depth = 0) node {
        vbox {
            text(value="{depth}")
            if depth < 2 {
                node(depth=depth + 1)
            }
        }
    }

    node(depth=0)
}

component second() node {
    component node(depth = 0) node { // ERROR(check) "is declared twice in this package and both declarations recurse"
        vbox {
            text(value="d{depth}")
            if depth < 2 {
                node(depth=depth + 1)
            }
        }
    }

    node(depth=0)
}

component main node {
    vbox {
        first()
        second()
    }
}

window {
    main
}
