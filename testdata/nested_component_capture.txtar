A component declared in a body reads and writes that body's state, on every
target (#202). `inner` names `count`, `label` and `bump()`, which `outer`
declares -- a var, a prop and a method.

What the shape is here for: `inner` declares a var of its own, so
passInlinePure will not substitute it and the capture has to survive
passNoInlineComponents. Two instantiations of `inner` inside one `outer` share
that `outer`'s `count` -- the accepted cost -- while `runs` stays per
instantiation; two instantiations of `outer` do not share, so the golden shows
one `count` per `outer` and one `runs` per `inner`.

Before spliceNestedCaptures the nested body was substituted after its owner
was already inlined and gone, so the captured names reached each backend with
nothing declaring them: `count` as a bare identifier and `label` never
substituted by the call site's argument.

deny * `\bcount\b` -- the captured var is the owner's, so every target names the per-owner-instance clone and never the declared name
deny * `\blabel\b` -- the captured prop is substituted by the instantiation's argument, so no target emits its name
deny * `\bbump\b` -- the owner's method is cloned per owner instance, so every target calls the clone and never the declared name
deny * `\bhit\b` -- `tap` captures nothing but `hit()`, so the method alone has to mark it for the splice

-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
    }
    none {
        html
    }
    kotlin {
        android
    }
}

component outer(label = "") node {
    var count = 0

    func bump() { count = count + 100 }

    component inner(step = 1) node {
        var runs = 0

        vbox {
            text(value="{label} {count} {runs}")
            button(text="+", @click {
                count = count + step
                runs = runs + 1
                bump()
            })
        }
    }

    vbox {
        inner(step=1)
        inner(step=10)
    }
}

// A nested body whose *only* capture is the owner's method: nothing about the
// vars or props marks `tap` as capturing, so the method has to.
component methodOnly() node {
    var hits = 0

    func hit() { hits = hits + 1 }

    component tap() node {
        var taps = 0

        button(text="tap", @click {
            hit()
            taps = taps + 1
        })
    }

    vbox {
        tap()
        text(value="{hits}")
    }
}

component main node {
    vbox {
        outer(label="a")
        outer(label="b")
        methodOnly()
        methodOnly()
    }
}

window {
    main
}
