What a node's style says of its size and face reaches fyne, and an instance
whose body renders no node takes no room on fyne or gtk4.

- A width or a height is recorded with the node's share (`ShareSized`), and the
  box holding it lays it out at that size in place of its own minimum: Fyne
  asks no widget to be a size, so a picture was as large as its file, and an
  image read no style at all.
- A bold or italic label is given that face as its own TextStyle beside the
  theme that draws it so: a label measures itself in its TextStyle, and one
  drawn bold by its theme alone measured regular and was cut short.
- An instance that renders nothing -- a request in a `for` -- is a hidden
  object (`fynelayout.Nothing`, gtk4's hidden label): it was a blank label, a
  row of space for every request a page made.

deny out/go/fyne/model.go `(Root = |return )widget\.NewLabel\(""\)` -- a request's instance is no blank label
deny out/go/gtk4/model.go `Root = gtk4rt\.LabelNew\(""\)|return C\.gtk_label_new\(nil\)\n` -- nor on gtk4, where it is hidden

-- app.sngl --
import seq "sngl:seq"
import ui "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
}

// Renders nothing, and asks for something per copy.
component asker(n int) ui.node {
    var seen = 0

    effect(on=n, @mount(k) { seen = k })
}

component page ui.node {
    var count = 3

    ui.vbox {
        ui.hbox {
            ui.image(alt="dot", style={width=96px, height=48px}) {
                ui.remote(url="https://example.com/dot.png")
            }
            ui.text(value="Heading", style={fontWeight=bold, width=120px})
        }
        for var i = seq.count(count) {
            asker(n=i)
        }
        ui.button(text="More", @click { count += 1 })
    }
}

ui.window {
    page()
}
