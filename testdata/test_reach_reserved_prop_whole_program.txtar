`close` is a predeclared Go identifier, so on the Go targets dlg's `#close`
is `close__r0`, and a test's select of it follows. main's prop `close` is no
node and keeps its name, as a prop does whatever a target reserves, so
testProp's `c.close` still reads it. Tests taking two components make this a
build of the whole program.

deny out/go/bubbletea/model_test.go `c\.close__r0 ==` -- a prop is not the node a reserved id renamed
deny out/go/fyne/model_test.go `c\.close__r0 ==` -- a prop is not the node a reserved id renamed
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component dlg node {
    var n = 0
    button #close(text="x{n}", @click { n = n + 1 })
}

component main(close string = "p") node {
    vbox {
        text #t(value=close)
        dlg #d
    }
}

func testProp(t Test, c main) {
    t.assert(c.close == "p")
    t.assert(c.t.value == "p")
}

func testDlg(t Test, c dlg) {
    c.close.click()
    t.assert(c.n == 1)
}

window {
    main
}
