An event's override writes the prop it names through `this` as it would
by its bare name: `this.value = to` is the override's `value`, which the
instance holding it rewrites, where a select off the receiver reached fyne
as `this.Value = to`.
-- app.sngl --
import android "sngl:platform/android"
import bubbletea "sngl:platform/bubbletea"
import fyne "sngl:platform/fyne"
import gtk4 "sngl:platform/gtk4"
import html "sngl:platform/html"
import test "sngl:test"
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
        gtk4
        bubbletea
    }
    kotlin {
        android
    }
}

component dial(:value int, @change(to int)) ui.node

component dial[html.platform](value, @change) {
    ui.button(text="{value}", @click {
        value += 1
        change(value)
    })
}

func dial.change[html.platform](to) {
    this.value = to
    change(to)
}

component dial[fyne.platform](value, @change) {
    ui.button(text="{value}", @click {
        value += 1
        change(value)
    })
}

func dial.change[fyne.platform](to) {
    this.value = to
    change(to)
}

component dial[gtk4.platform](value, @change) {
    ui.button(text="{value}", @click {
        value += 1
        change(value)
    })
}

func dial.change[gtk4.platform](to) {
    this.value = to
    change(to)
}

component dial[bubbletea.platform](value, @change) {
    ui.button(text="{value}", @click {
        value += 1
        change(value)
    })
}

func dial.change[bubbletea.platform](to) {
    this.value = to
    change(to)
}

component dial[android.platform](value, @change) {
    ui.button(text="{value}", @click {
        value += 1
        change(value)
    })
}

func dial.change[android.platform](to) {
    this.value = to
    change(to)
}

component page ui.node {
    var n = 0
    var heard = 0

    dial #d(:value=n, @change(to) { heard = to })
}

func testTheOverrideWritesThroughThis(t test.Test, c page) {
    c.d.change(3)
    t.assert(c.n == 3)
    t.assert(c.heard == 3)
}

ui.window {
    page
}
