A zero-argument function named where its result is expected is called.
`doubled` returns an int and is written on a string prop, and the call used to
be emitted only when the return type already matched the prop -- so this case
went through a func-to-string conversion instead and html rendered an empty
span. The definition is emitted either way; what this pins is that it is
called.

-- app.sngl --
import . "sngl:ui"

output {
    none {
        html
    }
}

component main {
    var count = 2
    func doubled() => count * 2
    text(value=string(doubled))
}
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<span id="__n0" data-sngl-id="__n0">
</span>

<script>
(() => {
  // sngl-entry.js
  var state = { count: 2 };
  function main_doubled(state2) {
    return state2.count * 2;
  }
  function String(v) {
    return "" + v;
  }
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  function __sngl_init() {
    __n0.textContent = String(main_doubled(state));
  }
  __sngl_init();
})();
</script>
</body></html>
