An owned value a component holds lives as long as the node. `f` is released
after a click overwrites it, once the new value is in place, since the new one
is computed from it. `label`, an owned derived value, is a var made once when
the instance is, with an effect keyed on what it reads whose `@update` makes
it again and releases the old one. An effect ahead of the rest of the body
releases both when the node unmounts. Here that happens when the `if` it sits
under goes false.

deny * `close\(open\(` -- a derived value read is a read of its var, never an allocation released per read

-- app.sngl --
import ui "sngl:ui"
import macro "sngl:macro"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
}

#[macro.owned(close)]
struct file {
    fd int
}

var closed = 0

func close(f file) {
    closed += 1
}

func open(fd int) => file{fd=fd}

component holder(n int) ui.node {
    var f = open(1)
    var extra = 0

    func label() => open(n * 10 + extra)

    ui.button(text="{f.fd} {label.fd}", @click {
        f = open(f.fd + 1)
        extra += 1
    })
}

var shown = true
var n = 1

ui.window(title="t") {
    if shown {
        holder(n=n)
    }
    ui.button(text="{closed}", @click {
        shown = !shown
        n += 1
    })
}
