// A zero-arg computed is auto-called wherever its result is what the position
// wants. The for iterator was the exception: `for var c = chars` reported the
// func type itself as a bad iterator, so every loop over derived data had to
// spell the call out.

import . "sngl:ui"
import . "sngl:test"

component main node {
    var word = "abc"

    func letters() => string.split(word, "")

    vbox {
        for var c = letters {
            text(value=c)
        }
        for var i, c = letters {
            text(value="{i}{c}")
        }
    }
}

func testComputedIterator(t Test, c main) {
    t.assert(c.letters().length() == 3)
}

window {
    main
}
