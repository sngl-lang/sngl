A scroll's `direction` reaches gtk4rt through the set gtk4.sngl declares for
it, `_set_Scroll_direction`, which calls gtk4rt.ScrollSetDirection with the
axis as a Go string: the program stays wrapped, holding no C string. gtk4rt
sets the scrolled window's two policies, lays the content out at its natural
size along each axis that scrolls, and reads @reachEnd along x in a scroll
moving sideways (pkg/go/gtk4rt/reach_across_test.go).

A scroll given no direction is set "vertical", ui.ScrollDirection's default,
which is how a scroll ScrollNew makes already moves.
deny out/go/gtk4/model.go `import "C"` -- the direction crosses as a Go string, so the program stays wrapped
-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
    }
}

ui.window(title="t") {
    ui.scroll #down {
        ui.text(value="rows")
    }
    ui.scroll #across(direction=horizontal) {
        ui.text(value="columns")
    }
    ui.scroll #either(direction=both) {
        ui.text(value="a page")
    }
}
-- out/go/gtk4/callbacks.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

import "duckfam.us/sngl/pkg/go/gtk4rt"

func main() {
	gtk4rt.Init()
	m := New()
	m.buildWidgetTree()
	gtk4rt.RunWindows(true)
}
