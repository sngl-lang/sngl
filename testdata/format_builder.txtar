-- format_builder.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}

struct Tag {
    name string = ""
}

func Tag.format(t Tag, upper bool = false) => upper ? "#" + t.name.upper() : "#" + t.name

func Tag.appendFormat(t Tag, out ref[builder], upper bool = false) {
    out.add("#")
    out.add(upper ? t.name.upper() : t.name)
}

component tags node {
    var tag = Tag{name="go"}
    var n = 3
    text #out(value="{tag} and {tag, upper=true}, {n, width=2}")
    button #rename(text="rename", @click {
        tag = Tag{name="sngl"}
    })
}

func testBuilt(t Test, c tags) {
    t.assert(c.out.value == "#go and #GO,  3")
    c.rename.click()
    t.assert(c.out.value == "#sngl and #SNGL,  3")
}

window {
    tags()
}
