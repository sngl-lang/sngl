A request moved off the drawing thread reads the context its fetch reads
before it goes: the query's fetch is the caller's lambda, which the optimizer
inlines into the goroutine only after the lowering bound the arguments it
could see, and on gtk4 and fyne the goroutine read the instance's server
while a render rewrote it.
-- app.sngl --
import async "sngl:async"
import http "sngl:http"
import . "sngl:ui"

output {
    go {
        fyne
    }
}

context #server("https://example.com")

func lookup(key string, life async.Lifetime) async.Result[string] {
    match var r = http.get(url="{server}/{key}", life=life) {
        ok {
            return {ok=r.body}
        }
        failed {
            return {failed=r}
        }
    }
}

component asker(key string) node {
    var got option[string] = null

    async.query(on=key, fetch=lookup, :value=got)
    text(value=got != null ? got : "…")
}

component page node {
    var on = true
    var where = "https://pokeapi.co"

    server(where) {
        if on {
            asker(key="one")
        }
    }
    button(text="Move", @click { where = "https://elsewhere.example" })
}

window {
    page
}
