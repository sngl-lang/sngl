func snglRun(args []string, run func()) {
	__run(args, run)
}

var snglStarted bool

func snglStart() {
	if snglStarted {
		fmt.Fprintf(os.Stderr, "%s: run called again; an application runs once per process\n", "app.sngl:16:16")
		os.Exit(2)
	}
	snglStarted = true
	snglWin32Present()
	snglWin32Run()
	snglTeardown()
}

