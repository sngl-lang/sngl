win32's @run in Go, as testdata/win32_c_run_handler_runs.txtar has it in C:
the handler runs before the loop, with the command line, and `run` presents
the windows the build held hidden and runs the loop through the wrappers, so
the code after it waits for the loop to end. Not called, the handler returns
and the loop runs with no window, which only the program's quit ends; the
application tears down -- the probe's @unmount -- as the loop exits.

exec out/go/win32 -- hidden.txt
exec out/go/win32 --window x -- shown.txt
-- app.sngl --
import go "sngl:language/go"
import time "sngl:time"
import ui "sngl:ui"
import win32 "sngl:platform/win32"

#[go.native("fmt", "fmt.Println")]
func say(s string)

var (
    n = 0
    stopped = false
)

output {
    go {
        win32(@run(args, run) {
            start(args, run)
        })
    }
}

func start(args list[string], run func()) {
    say("before {args.length}")
    n = args.length
    if args.contains("--window") {
        run()
    }
    say("after")
}

time.timer(interval=100ms, @tick {
    if !stopped {
        stopped = true
        say("tick {n}")
        win32.quit()
    }
})

component probe ui.node {
    effect(@unmount {
        say("unmount")
    })
    ui.text(value="{n}")
}

ui.window {
    probe()
}
-- hidden.txt --
before 0
after
tick 0
unmount
-- shown.txt --
before 2
tick 2
unmount
after
-- out/go/win32/main.go --
