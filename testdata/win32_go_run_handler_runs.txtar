	m.__effects0_torn = true
	__effect1_teardown()
	__effect0_teardown()
}

func __n0_visible_handler(__visible bool) {
	m.visible__inst0 = __visible
	cgo.SnglWin32SetVisible(m.__n0, m.visible__inst0)
}

func snglInit() {
	m = &snglState{}
	m.n = 0
	m.stopped = false
	m.handle__inst0 = 0
	m.visible__inst0 = true
	m.__effect0_key = (time.Duration(0) * time.Millisecond)
	m.__effect0_live = []time.Duration{}
	m.__effect0_desired = []time.Duration{}
	m.__effect1_live = []bool{}
	m.__effect1_desired = []bool{}
	m.__effects0_settling = false
	m.__effects0_pending = false
