	"fmt"
	"os"
	"runtime"
	"slices"
	"time"
)

func snglSome[T any](v T) *T {
	return &v
}

type ErrorEvent struct {
	Message string
	Kind    string
}

type snglState struct {
	n                   int
	stopped             bool
	handle__inst0       int
	visible__inst0      bool
	__effect0_key       time.Duration
	__effect0_live      []time.Duration
	__effect0_desired   []time.Duration
	__effect1_live      []bool
	__effect1_desired   []bool
	__effects0_settling bool
	__effects0_pending  bool
	__effects0_torn     bool
	__effects0_steps    int
	__n0                cgo.HWND
	__n1                cgo.HWND
}

var m = &snglState{}

func Start(args []string, run func()) {
	fmt.Println(("before " + fmt.Sprint(len(args))))
	m.n = len(args)
	cgo.SnglWin32SetText(m.__n1, fmt.Sprint(m.n))
	if slices.Index(args, "--window") >= 0 {
		run()
	}
	fmt.Println("after")
}

func __run(args []string, run func()) {
	Start(args, run)
}

func __effect0_mount() {
	m.handle__inst0 = cgo.SnglWin32Every(int(m.__effect0_key/time.Millisecond), func() {
		if !m.stopped {
			m.stopped = true
			fmt.Println(("tick " + fmt.Sprint(m.n)))
			cgo.SnglWin32Quit()
		}
	})
}

func __effect0_unmount() {
	cgo.SnglWin32Cancel(m.handle__inst0)
}

func __effect0_down() {
	m.__effect0_desired = []time.Duration{}
	m.__effect0_desired = append(m.__effect0_desired, (time.Duration(100) * time.Millisecond))
	for __effect0_i, _ := range m.__effect0_live {
		var __effect0_j int = ((len(m.__effect0_live) - 1) - __effect0_i)
		if __effect0_j >= len(m.__effect0_desired) {
			m.__effect0_key = m.__effect0_live[__effect0_j]
			__effect0_unmount()
		} else {
			if m.__effect0_desired[__effect0_j] != m.__effect0_live[__effect0_j] {
				m.__effect0_key = m.__effect0_live[__effect0_j]
				__effect0_unmount()
			}
		}
	}
}

func __effect0_up() {
	for __effect0_i, __effect0_k := range m.__effect0_desired {
		if __effect0_i >= len(m.__effect0_live) {
			m.__effect0_key = __effect0_k
			__effect0_mount()
		} else {
			if m.__effect0_live[__effect0_i] != __effect0_k {
				m.__effect0_key = __effect0_k
				__effect0_mount()
			}
		}
	}
	m.__effect0_live = m.__effect0_desired
}

func __effect0_teardown() {
	for __effect0_ti, _ := range m.__effect0_live {
