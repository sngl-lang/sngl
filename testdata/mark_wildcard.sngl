// #[wildcard] on a component prop says which prop names nobody declared the
// component still accepts, and what type their values have. The prop collects
// every name it matched, keyed by that name, so the body can read them —
// without that the values are accepted and then reach nothing.

import . "sngl://std"
import . "sngl://platforms"

component attrs(
    label string = "",
    #[wildcard("data[A-Za-z0-9]+")] data map<string, string>,
) {
    text(value=label)
    text(value="{data.length()}")
}

// #[wildcard] on an event declaration says which event names nobody declared
// the component still accepts. Nothing is collected, unlike a prop: a handler
// is bound under the name it was written with, so the names stay distinct
// without a map to hold them.
component surface(
    @click ClickEvent,
    #[wildcard("on[A-Z][A-Za-z]*")] @event,
) {
    text(value="x")
}

// #[wildcard] on a component says which node names nobody declared still
// resolve to it, and `into` names the prop the matched name is bound to. The
// names stand in one position — a visual node's — which is the only place they
// are looked for.
#[wildcard("box[A-Za-z0-9]*", "which")]
component anyBox(which string = "") {
    text(value=which)
}

struct rowAttrs {
    dataRole string = "row"
}

component main() {
    window {
        attrs(label="hi", dataRole="row", dataIndex7="3")
        // A name the wildcard covers reaches the component it belongs to, and
        // arrives in the prop `into` named.
        boxRed()
        // A spread field is a written prop name like any other, so one the
        // wildcard covers is collected into it rather than becoming an arg
        // named after a prop that does not exist — which every backend
        // dropped.
        attrs(...rowAttrs{})
        // A declared event and two the wildcard covers, on one node.
        surface(@click {}, @onHover {}, @onDragEnd {})
        // The declared name still binds: a wildcard adds names, it does not
        // take its own away.
        attrs(data={dataRole = "plain"})
    }
}
