A drawn image whose size reads state builds on fyne.

Its size is its constructor's, and the drawn source has no setter for it. A
write reading state goes to a setter where there is one, and one with none
is still the constructor's: sent to the setter, it was reported as reaching
nothing and the program did not build.

-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"

component dot(size float) ui.node {
    ui.image(alt="Dot") {
        draw.image(width=size, height=size) {
            draw.circle(cx=8.0, cy=8.0, r=4.0, style={fill=#3366CC})
        }
    }
}

component gallery ui.node {
    var w = 16.0
    ui.vbox {
        ui.image(alt="Dot") {
            draw.image(width=w, height=16.0) {
                draw.circle(cx=8.0, cy=8.0, r=4.0, style={fill=#3366CC})
            }
        }
        dot(size=20.0)
        ui.button(text="grow", @click {
            w += 1.0
        })
    }
}

ui.window {
    gallery
}

output {
    go {
        fyne
    }
}
