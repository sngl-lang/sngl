import . "sngl:ui"
import . "sngl:test"
import math "sngl:math"

component mathfold node {
    // Trig functions
    var fsin = math.sin(0.0)          // FOLD 0.0
    var fcos = math.cos(0.0)          // FOLD 1.0
    var ftan = math.tan(0.0)          // FOLD 0.0
    var fasin = math.asin(0.0)        // FOLD 0.0
    var facos = math.acos(1.0)        // FOLD 0.0
    var fatan = math.atan(0.0)        // FOLD 0.0
    var fatan2 = math.atan2(0.0, 1.0) // FOLD 0.0
    var fpow = math.pow(2.0, 3.0)     // FOLD 8.0

    // String-to-number conversions
    var si = int("42")    // FOLD 42
    var sf = float("3.5") // FOLD 3.5

    // Float division
    var fmod = 10.0 / 3.0 // FOLD 3.3333333333333335

    text(value="{fsin}")
}

func testTrigAndConversions(t Test, c mathfold) {
    t.assert(c.fsin == 0.0)
    t.assert(c.fcos == 1.0)
    t.assert(c.ftan == 0.0)
    t.assert(c.si == 42)
}

window {
}
