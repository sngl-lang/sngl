A struct a directory import declares is copied into each target's build whole,
reached or not, because lowering adds it to the program and writes it there.

Shared with the checked package instead, it was renamed by the first target
that reserved its name: html reserves `state`, so the html build renamed the
checked `state` to `state__r0` and bubbletea, built after it in the same run,
emitted `State__r0` where a bubbletea build on its own emits `State`.

deny out/go/bubbletea/model.go `State__r0` -- one target's renames stay in its own build
-- app.sngl --
import ui "sngl:ui"
import bubbletea "sngl:platform/bubbletea"
import w "./w"

var k = 2

func label(x int) string {
    return "plain"
}

func label[bubbletea.platform]() {
    var t = w.state{n=3}
    t.n = t.n + x
    return "{t.n}"
}

ui.window(title="t") {
    ui.text(value=label(k))
    ui.button(text="more", @click { k = k + 1 })
}

output {
    none {
        html
    }
    go {
        bubbletea
    }
}
-- w/w.sngl --
struct state {
    n int = 1
}
-- out/go/bubbletea/model.go --
