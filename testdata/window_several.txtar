// snglWindow is one window of the program: the fyne window the host shows,
// around a widget tree the program builds once.
type snglWindow struct {
	title   string
	content fyne.CanvasObject
	onClose func()
	w       fyne.Window
	mounted bool
	open    bool
}

var (
	snglApp     fyne.App
	snglStarted bool
	snglHidden  bool
	snglWindows []*snglWindow
	snglAnchor  fyne.Window
)

// Mount says the window exists. Before the loop starts it is created when the
// loop does; after, it is created and put on screen at once.
func (w *snglWindow) Mount() {
	if w.mounted {
		return
	}
	w.mounted = true
	snglWindows = append(snglWindows, w)
	if snglStarted {
		w.create()
		w.Open()
	}
}

// Unmount closes the fyne window. The content is kept for a later Mount.
func (w *snglWindow) Unmount() {
	if !w.mounted {
		return
	}
	w.mounted = false
	w.open = false
	for i, x := range snglWindows {
		if x == w {
			snglWindows = append(snglWindows[:i], snglWindows[i+1:]...)
			break
		}
	}
	if w.w != nil {
		w.w.SetContent(container.NewStack())
		w.w.Close()
		w.w = nil
	}
}

// Open puts a mounted window on screen.
func (w *snglWindow) Open() {
	w.open = true
	if w.w != nil {
		w.w.Show()
	}
}

// Close takes the window off screen; Open brings it back as it was.
func (w *snglWindow) Close() {
	w.open = false
	if w.w != nil {
		w.w.Hide()
	}
}

func (w *snglWindow) create() {
	if w.w != nil {
		return
	}
	w.w = snglApp.NewWindow(w.title)
	// fyne lays SetContent's tree out against the current size, so the
	// content goes in before the resize.
	w.w.SetContent(w.content)
	w.w.Resize(fyne.NewSize(480, 640))
	w.w.SetCloseIntercept(w.closeRequested)
}

// closeRequested is the window manager's close. The handler decides what it
// means; with none, the window hides. Either way a close that leaves nothing
// on screen ends the program, unless it started with nothing on screen.
func (w *snglWindow) closeRequested() {
	if w.onClose != nil {
		w.onClose()
	} else {
		w.Close()
	}
	if snglHidden {
		return
	}
	for _, x := range snglWindows {
		if x.open {
			return
		}
	}
	snglApp.Quit()
}

// snglRunWindows runs the loop over the windows mounted so far and those
// mounted later. show puts the mounted ones on screen at start.
func snglRunWindows(show bool) {
	snglHidden = !show
	snglAnchor = snglApp.NewWindow("")
	snglStarted = true
	for _, w := range append([]*snglWindow(nil), snglWindows...) {
		w.create()
		if show || w.open {
			w.Open()
		}
	}
	snglApp.Run()
}

// BuildUI creates every window's widget tree. Call once.
func (m *Model) BuildUI() fyne.CanvasObject {
	if m.main != nil {
		return m.main.content
	}
	m.main = &snglWindow{title: "Main", content: m.buildWindowMain()}
	m.main.Mount()
	m.log = &snglWindow{title: "Log", content: m.buildWindowLog(), onClose: m.__log_close}
	m.log.Mount()
	return m.main.content
}

func (m *Model) buildWindowMain() fyne.CanvasObject {
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText((("closed the log " + fmt.Sprint(m.closes)) + " times"))
	__n3 := widget.NewButton("", nil)
	__n3.SetText("Log")
	__n3.OnTapped = m.__n3_click_handler
	return container.NewVBox(m.__n0, __n3)
}

func (m *Model) buildWindowLog() fyne.CanvasObject {
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText(fmt.Sprint(m.closes))
	m.__renderSlot0(m.__root1)
	__n4 := widget.NewButton("", nil)
	__n4.SetText("Hide main")
	__n4.OnTapped = m.__n4_click_handler
	m.__root1.Objects = append(m.__root1.Objects, m.__n1, __n4)
	return m.__root1
}

func main() {
	snglApp = app.New()
	m := New()
	m.BuildUI()
	snglRunWindows(true)
	_ = os.Stderr
}
