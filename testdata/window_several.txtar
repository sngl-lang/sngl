Two windows are two OS windows on gtk4 and fyne, each opened and closed by its
`#id`, and every window the tree holds is on screen once `run` is called.

A window the window manager closes runs its `@close`, and the tree decides
whether it still exists: `log` writes state and stays, so its close is only
what the handler did. `main` writes none, so its close hides it, and the
program ends when a close leaves no window on screen.

Each window's content is built once, into a box of its own, and outlives the
toplevel around it.

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
        fyne
    }
}

var closes = 0

ui.window #main(title="Main") {
    ui.text(value="closed the log {closes} times")
    ui.button(text="Log", @click {
        log.open()
    })
}

ui.window #log(title="Log", @close {
    closes += 1
    log.close()
}) {
    ui.text(value="{closes}")
    // A reactive `if` at the root of the second window re-renders into that
    // window's own box, `__root1`, not the first window's.
    if closes > 2 {
        ui.text(value="closed often")
    }
    ui.button(text="Hide main", @click {
        main.close()
    })
}
