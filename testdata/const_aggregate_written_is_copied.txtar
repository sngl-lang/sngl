A list const that reaches storage the program may write is copied there, and
read by name everywhere else.

A reference to a list or map const names the one declaration every reader
sees, so it cannot be handed to something that writes it: `var a = xs` and
`a.push(5)` would push onto `xs`. A var initializer, an assignment, a return
and an argument to a parameter the callee writes each still take a literal
copy -- `grow` pushes onto its parameter, so `grow(xs)` passes `[1, 2]` --
while `sumFrom` only reads its parameter and is handed `xs` itself.

deny out/none/html/index.html `grow\(xs\)` -- grow writes its parameter, so it is handed a copy
deny out/go/bubbletea/model.go `Grow\(m\.xs\)` -- grow writes its parameter, so it is handed a copy
deny out/none/html/index.html `sumFrom\(\[` -- sumFrom only reads its parameter, so it is handed the declared list
deny out/go/bubbletea/model.go `SumFrom\(\[\]int` -- sumFrom only reads its parameter, so it is handed the declared list

-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
    }
    none {
        html
    }
}

const xs = [1, 2]

func grow(ys list[int]) {
    ys.push(3)
}

func sumFrom(ys list[int], start int) int {
    var s = start
    for var y = ys {
        s = s + y
    }
    return s
}

window {
    var a = xs
    var n = 0

    text(value="{sumFrom(xs, n)} {a.length()}")
    button(text="go", @click {
        a.push(5)
        grow(xs)
        n = n + 1
    })
}
