    label?.invoke(SnglTextAlign.LEFT)
}

fun flip(r: Mood): Mood {
    var held = r
    var other = Mood.SAD
    if ((held == other)) {
    	return Mood.HAPPY
    }
    return other
}

fun shape(n: Int): String {
    var out = ""
    for (a in listOf(SnglJustification.START, SnglJustification.END)) {
    	out = (out + a.toString())
    }
    return (out + (if ((n > 1)) SnglDisplay.FLEX else SnglDisplay.BLOCK).toString())
}
