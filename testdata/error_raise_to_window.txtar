A window's @error is the boundary fyne and gtk4 have, and a raise in a called
function reaches it the way it reaches a boundary on the other targets: the
click handler's body is one catch block whose handler is the window's, so the
panic from requireAge is recovered there and `problem = "after"` never runs.

The handler's own widget write is translated with the body it is rendered in.
It sits on the window rather than in the handler, so a walk over the handler's
statements did not reach it, and fyne emitted the bare `__n0.Text =` a lowering
writes -- a field no Fyne widget has.

`deep` is a component, so the checker resolves its click against its own body,
where there is no boundary; passErrorScope resolves it to the window once the
instance is spliced into the window's tree.

deny out/go/fyne/model.go `(?m)^\s*__n0\.Text =` -- the handler's write is a setter, as the body's is
deny * `_handler\(\) \{\n\tm\.age = RequireAge` -- the component's click is a catch block too: its raise reaches the window rendering it

-- app.sngl --
import . "sngl:ui"

func requireAge(s string) int {
    if s.length == 0 {
        error.raise("an age is required", "validation")
    }
    return int(s)
}

var problem = "none"
var age = 0

component deep node {
    button(text="Deep", @click {
        age = requireAge("")
        problem = "deep after"
    })
}

window #home(title="raise", @error(e) {
    problem = e.message
}) {
    vbox {
        button(text="Save", @click {
            age = requireAge("")
            problem = "after"
        })
        button(text="Check", @click {
            requireAge("", @error(e) {
                problem = "call: " + e.kind
            })
        })
        deep()
        text(value="problem={problem}")
    }
}

output {
    go {
        fyne
        gtk4
    }
}
