import . "sngl:ui"
import app "sngl:app"

// A void method referenced bare types void, not dyn -- the same as calling it.
component main ui {
    var n = 0

    func bump() {
        n += 1
    }

    func oops() {
        var x = this.bump // ERROR(check) "expression yields no value"
        n += x
    }

    text(value=string(n))
}

app.window {
    main
}
