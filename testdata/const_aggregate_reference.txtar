A read of a list or map const that does not fold is a read of the declaration,
on every target.

`entries[pick]` and `labels.get(key, …)` index the declared value rather than
a literal written out where they are read, and a language target's loop walks
`entries` by name. The Go targets hold a const as a Model field, which is
where the literal is spelled; html declares it ahead of the state, whose
initializers may read it.

Android had never emitted a package const, since every read of one used to be
a literal; it declares them as top-level `val`s now. It is not in the output
block only because a record for it needs a JDK and the Android SDK.

deny out/go/bubbletea/model.go `\}\[m\.pick\]|\}\[m\.key\]` -- the index reads the declared value, not a literal written at the read
deny out/go/fyne/model.go `\}\[m\.pick\]|\}\[m\.key\]` -- the index reads the declared value, not a literal written at the read
deny out/go/gtk4/model.go `\}\[m\.pick\]|\}\[m\.key\]` -- the index reads the declared value, not a literal written at the read
deny out/none/html/index.html `\]\[state\.pick\]|\]\)\.has` -- the index reads the declared value, not a literal written at the read

-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
}

struct Entry {
    title string
    href  string
}

const entries = [Entry{title="Home", href="/"}, Entry{title="About", href="/about.html"}]
const labels map[string, string] = {"home"="Start", "about"="Us"}

window {
    var pick = 0
    var key = "home"

    vbox {
        for var e = entries {
            text(value=e.title)
        }
        text(value=entries[pick].title)
        text(value=labels.get(key, "?"))
        button(text="next", @click {
            pick = (pick + 1) % entries.length()
            key = pick == 0 ? "home" : "about"
        })
    }
}
