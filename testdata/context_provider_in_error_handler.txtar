A context provider written inside an @error handler has to be lowered like one
written anywhere else: spliced out, with the reads under it answered by the
value it provides. The context pass walked a node's event handlers and a
boundary's content, and not a boundary's @error, a window's @error or a
call's own @error. A provider there survived the pass: with a read directly
under it the pass's own surviving-read check refused the build, and with the
read inside a called func instead the provider reached codegen, where
irwalk.EvalStmt has no case for one and all four targets below panicked.

Each handler assigns the provided value, 5 and 7, where the enclosing scope
provides 2 and the default is 1. A call's @error is covered by
internal/lower's TestLowerProviders_InHandlers rather than here: no target
emits that handler at all yet, so its golden would show nothing of the
provider.
-- handler.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
        html
    }
    kotlin {
        android
    }
    none {
        html
    }
}

context #depth(1)

var fromWindow = ""

component main node {
    var fromBoundary = ""
    boundary(@error(e) {
        depth(5) {
            fromBoundary = "{depth}"
        }
    }) {
        button #go(text="Go", @click { error.raise("boom", "") })
    }
    text(value=fromBoundary)
}

window(@error(e) {
    depth(7) {
        fromWindow = "{depth}"
    }
}) {
    button #fail(text="Fail", @click { error.raise("window", "") })
    text(value=fromWindow)
    depth(2) {
        main
    }
}
