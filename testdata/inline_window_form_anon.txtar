NoInlineComponents inlines user components into the app root. It used to look
for a `component main` and give up when there was none — but a program that
declares its windows at top level has no main, so every component stayed
un-inlined for that whole form. Platforms that rely on the pass then met IR
they do not handle: fyne panicked in irwalk on the ir.SlotInst that survived.

This is that shape: a top-level window holding a component with a slot, and no
main anywhere. The window is the root, so `table` inlines and its slot content
lands in the output rather than surviving as an ir.SlotInst.

A package with neither a main nor a window is left alone instead, since every
component there is its own entry point; and a component no root reaches is
dropped -- those two are in inline_window_form_lone.txtar.

-- anon.sngl --
import . "sngl:ui"
import . "sngl:app"

struct Row {
    title string
}

component table(rows list<Row>, children ...component) node {
    vbox {
        for var r = rows {
            text(value=r.title)
        }
        children
    }
}

window #w(href="/index.html", title="x") {
    table(rows=[Row{title="alpha"}]) {
        text(value="inner")
    }
}

output { go { fyne } }
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from anon.sngl; DO NOT EDIT.

package ui

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
)

type Row struct {
	Title string
}

// Model holds the state for this SNGL UI.
type Model struct {
	__n0 *fyne.Container
	__n1 *widget.Label
	__n2 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = container.NewVBox()
	for _, r := range []Row{Row{Title: "alpha"}} {
		m.__n1 = widget.NewLabel("")
		m.__n1.SetText(r.Title)
		m.__n0.Add(m.__n1)
	}
	m.__n2 = widget.NewLabel("")
	m.__n2.SetText("inner")
	m.__n0.Add(m.__n2)
	content := fyne.CanvasObject(m.__n0)
	return content
}
