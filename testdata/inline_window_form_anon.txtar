func (m *Model) BuildUI() fyne.CanvasObject {
	__n0 := container.NewVBox()
	for _, r := range []Row{Row{Title: "alpha"}} {
		__n1 := widget.NewLabel("")
		__n1.SetText(r.Title)
		__n0.Add(__n1)
	}
	__n2 := widget.NewLabel("")
	__n2.SetText("inner")
	__n0.Add(__n2)
	content := fyne.CanvasObject(__n0)
	return content
}
