Kotlin carries SNGL's `color` as a `Color` data class the file declares, and
the file declared it only for a canvas or a library helper whose signature
named the type. A `const typeColors map[string, color]` and its
`func typeInk(kind string) color` spelled `Color` with no declaration, and
the build failed on "Unresolved reference 'Color'". A const, var, local or
signature of the program that holds a color declares it.

-- m.sngl --
import ui "sngl:ui"

output {
    kotlin {
        android
    }
}

const typeColors map[string, color] = {"grass"=#7ac74c, "fire"=#ee8130}

func typeInk(kind string) color {
    if kind == "electric" {
        return #222222
    }
    return #ffffff
}

component badge ui.node {
    var kind = "grass"

    ui.button(text="Fire", @click { kind = "fire" })
    ui.badge(value=kind, style={background=typeColors.get(kind, #68a090), color=typeInk(kind)})
}

ui.window {
    badge()
}
