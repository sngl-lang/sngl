import . "sngl:ui"
import . "sngl:test"

func isEven(n int) bool {
    return n == 0 ? true : isOdd(n - 1)
}

func isOdd(n int) bool {
    return n == 0 ? false : isEven(n - 1)
}

component main node {
    var e = isEven(4)
    var o = isOdd(4)

    text(value=string(e))
}

func testMutualEven(t Test, c main) {
    t.assert(c.e == true)
}

func testMutualOdd(t Test, c main) {
    t.assert(c.o == false)
}

window {
    main
}
