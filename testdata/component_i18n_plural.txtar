A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_i18n_plural.sngl --
// A plural in a $"..." template takes its category from the argument each
// time the handler formats it: one, then other.

import "sngl:i18n"
import . "sngl:test"
import . "sngl:ui"

component main node {
    var count = 0
    var label = ""
    text(value=label)
    button #add(text="add", @click {
        count = count + 1
        label = $"You have {count, plural, one{# item} other{# items}}"
    })
}

func testOneThenOther(t Test, c main) {
    c.add.click()
    t.assert(c.label == "You have 1 item")
    c.add.click()
    t.assert(c.label == "You have 2 items")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
