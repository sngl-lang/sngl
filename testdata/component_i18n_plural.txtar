package main

import "testing"

func TestOneThenOther(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.addClick()
	if !((c.label == "You have 1 item")) { t.Errorf("assert failed: %s", "(c.label == \"You have 1 item\")") }
	c.addClick()
	if !((c.label == "You have 2 items")) { t.Errorf("assert failed: %s", "(c.label == \"You have 2 items\")") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
