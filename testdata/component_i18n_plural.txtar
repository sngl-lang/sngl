            state.count = (state.count + 1)
            state.label = I18n.translate(state.__ctx_locale, "You have {count, plural, one{# item} other{# items}}", "You have {count, plural, one{# item} other{# items}}", mapOf("count" to state.count))
        }, modifier = Modifier.testTag("add").safeDrawingPadding(), colors = ButtonDefaults.buttonColors(containerColor = androidx.compose.ui.graphics.Color.Unspecified, contentColor = androidx.compose.ui.graphics.Color.Unspecified), shape = CircleShape) {
            Text(text = "add", modifier = Modifier)
        }
    }
}
