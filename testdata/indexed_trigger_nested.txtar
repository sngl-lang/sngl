-- out/go/fyne/model_test.go --
package main

import "testing"

func TestOneCopyOfANestedLoop(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.cellClickAt("1/0")
	if !((c.log == "c")) { t.Errorf("assert failed: %s", "(c.log == \"c\")") }
	c.cellClickAt("0/1")
	if !((c.log == "b")) { t.Errorf("assert failed: %s", "(c.log == \"b\")") }
	c.markChangeAt("1/0", true)
	if !((c.log == "c true")) { t.Errorf("assert failed: %s", "(c.log == \"c true\")") }
	c.pinClickAt("1/0")
	if !((c.log == "r")) { t.Errorf("assert failed: %s", "(c.log == \"r\")") }
	c.tickClickAt("1/0")
	if !((c.log == "10")) { t.Errorf("assert failed: %s", "(c.log == \"10\")") }
	c.evenClickAt("1")
	if !((c.log == "2")) { t.Errorf("assert failed: %s", "(c.log == \"2\")") }
	c.dotClickAt("1")
	if !((c.log == "2.")) { t.Errorf("assert failed: %s", "(c.log == \"2.\")") }
}

func TestAfterTheLoopsRenderAgain(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.swapClick()
	c.cellClickAt("1/2")
	if !((c.log == "g")) { t.Errorf("assert failed: %s", "(c.log == \"g\")") }
	c.cellClickAt("0/0")
	if !((c.log == "d")) { t.Errorf("assert failed: %s", "(c.log == \"d\")") }
	c.markChangeAt("1/1", true)
	if !((c.log == "f true")) { t.Errorf("assert failed: %s", "(c.log == \"f true\")") }
}

