A test triggers one copy of a node nested loops render by its path,
`c.cell[1][0].click()`, on every target: the copy in the first loop's second
iteration and the second loop's first, which no position among all the copies
names without knowing how many each earlier iteration rendered.

passCopyKeys stamps each copy of an id a test indexes with its key in
`__copy` -- each loop's index, outermost first, "1/0" -- and hands a
component built at run time the key of the copy it stands in, which the
checkbox's implicit-state wrapper is. Each language's test lowerer hands the
key to the invoker's `At` variant and each target finds the copy carrying it.

`#pin` is under constant loops, which html writes into the page's markup.
`#tick` is under two `seq.count` loops, which fold to lists the checker
wrapped as sequences: given an index, each is walked as its list. `#even` is
under a sequence held in a var, a pull sequence, whose index is the counter
passIndexedIter puts beside the loop, which every view walk -- bubbletea's
invokers, android's screen -- must keep.
`#dot` is under a counted loop that binds nothing, which is given an element
of its own to count on beside its index.
cmd/sngl/testdata/indexed_trigger_nested_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"
import seq "sngl:seq"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

const grid = [["p", "q"], ["r"]]

component main node {
    var rows = [["a", "b"], ["c"]]
    var evens = seq.step(0, 4, 2)
    var dots = 2
    var log = ""
    vbox {
        button #swap(text="swap", @click { rows = [["d"], ["e", "f", "g"]] })
        for var row = rows {
            hbox {
                for var it = row {
                    button #cell(text=it, @click { log = it })
                    checkbox #mark(label=it, @change(on) { log = "{it} {on}" })
                }
            }
        }
        for var row = grid {
            hbox {
                for var it = row {
                    button #pin(text=it, @click { log = it })
                }
            }
        }
        for var r = seq.count(2) {
            hbox {
                for var k = seq.count(2) {
                    button #tick(text="{r}{k}", @click { log = "{r}{k}" })
                }
            }
        }
        hbox {
            for var e = evens {
                button #even(text="{e}", @click { log = "{e}" })
            }
            for seq.count(dots) {
                button #dot(text=".", @click { log = "{log}." })
            }
        }
        text(value=log)
    }
}

func testOneCopyOfANestedLoop(t Test, c main) {
    c.cell[1][0].click()
    t.assert(c.log == "c")
    c.cell[0][1].click()
    t.assert(c.log == "b")
    c.mark[1][0].change(true)
    t.assert(c.log == "c true")
    c.pin[1][0].click()
    t.assert(c.log == "r")
    c.tick[1][0].click()
    t.assert(c.log == "10")
    c.even[1].click()
    t.assert(c.log == "2")
    c.dot[1].click()
    t.assert(c.log == "2.")
}

func testAfterTheLoopsRenderAgain(t Test, c main) {
    c.swap.click()
    c.cell[1][2].click()
    t.assert(c.log == "g")
    c.cell[0][0].click()
    t.assert(c.log == "d")
    c.mark[1][1].change(true)
    t.assert(c.log == "f true")
}

window {
    main
}
