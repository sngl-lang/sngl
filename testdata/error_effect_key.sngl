// `on` is the identity of a lifetime: while it holds the same value this is the
// same effect. Every target therefore has to agree on when two of them are the
// same value, and not every type gets that agreement — Go refuses to compare
// two lists at all, JS compares two objects by identity. The settle's only
// answer for such a key was to end and begin the bracket on every pass, which
// is `+` under `sngl test` and `+,-,+` compiled, so it is refused where the key
// is written instead.
//
// A struct is comparable exactly when its fields are, which is what makes a
// compound key a struct of the values rather than a list of them — and the
// diagnostic for a list says so, because that is the mistake being made.

import . "sngl:ui"

struct pair {
    a int
    b string
}

struct hasList {
    tags list<string>
}

component main node {
    var (
        x = 0
        y = "s"
        xs list<int> = [1]
        m map<string, int> = {"a"=1}
        o option<int> = 1
    )

    // The forms that do work, here so the rule is not read as "no key at all".
    // A bracket with no `on` lives as long as its node; a compound key is a
    // declared struct of the values.
    effect(@mount {})

    effect(on=x, @mount {})

    effect(on=pair{a=x, b=y}, @mount {})

    effect(on=xs, @mount {}) // ERROR(check) "a key over several values is a struct of them, not a list"

    effect(on=m, @mount {}) // ERROR(check) "a key over several values is a struct of them, not a map"

    effect(on=o, @mount {}) // ERROR(check) "option<int> does not"

    effect(on=hasList{tags=["a"]}, @mount {}) // ERROR(check) "list<string> (field tags of struct hasList)"

    // A bodyless node carrying a #id parses as a call rather than a visual
    // node. That is one more spelling, not one more rule, and the rule is
    // stated over the instances a package holds rather than over the paths
    // that build one.
    effect #tagged(on=xs, @mount {}) // ERROR(check) "list<int> does not"
}

// The rule's other half is at the call site. An `on` typed by the component's
// own type parameter is admitted where it is written -- judging a parameter
// there would make a generic component undeclarable -- so the only place T
// becomes a type is the call that binds it. Unchecked, the bracket reached
// bubbletea as `m.__effect0_live[i] != k` over a []int, which Go does not
// compile, and html as `!==` over an array, which is identity.
component keyed<T>(k T) node {
    effect(on=k, @mount {})

    text(value="keyed")
}

component keys node {
    var n = 0
    var xs list<int> = [1]

    keyed(k=n)

    keyed(k=xs) // ERROR(check) "component keyed keys an effect on a value this call binds to list<int>"
}

window {
    main
}
