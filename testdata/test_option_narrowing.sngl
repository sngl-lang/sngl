import . "sngl:ui"
import . "sngl:test"

struct Node {
    value int = 0
    next  option[Node] = null
}

func double(n int) int {
    return n * 2
}

func valueOf(n Node) int {
    return n.value
}

// Builds its answer by pushing onto a list of its own, which writes nothing
// a caller holds: a call of it leaves a narrowing of state standing.
func upTo(n int) list[int] {
    var out list[int] = []
    for var i = [1, 2, 3, 4] {
        if i <= n {
            out.push(i)
        }
    }
    return out
}

component main node {
    var maybe option[int] = 3
    var absent option[int] = null

    vbox {
        if maybe != null {
            text #present(value=string(double(maybe)))
        }
        if absent == null {
            text #missing(value="none")
        } else {
            text(value=string(double(absent)))
        }
        if maybe != null && maybe > 2 {
            text #chained(value=string(double(maybe)))
        }
        if maybe != null {
            for var i = upTo(maybe) {
                text(value=string(i))
            }
        }
    }
}

func testNarrowsInThenBranch(t Test, c main) {
    t.assert(c.present != null && c.present.value == "6")
}

func testNarrowsInElseBranch(t Test, c main) {
    t.assert(c.missing != null && c.missing.value == "none")
}

func testNarrowsThroughAndChain(t Test, c main) {
    t.assert(c.chained != null && c.chained.value == "6")
}

func testNarrowsAFieldPath(t Test) {
    var tail = Node{value=4}
    var head = Node{value=1, next=tail}
    var got = 0
    if head.next != null {
        got = valueOf(head.next)
    }
    t.assert(got == 4)
}

// A path through an option narrowed already is a path too: `head.next`
// below the test on `head` reads through the unwrap that test made.
func testNarrowsAFieldPathUnderANarrowedOption(t Test) {
    var head option[Node] = Node{value=1, next=Node{value=4}}
    var got = 0
    if head != null && head.next != null {
        got = valueOf(head.next)
    }
    if head != null {
        if head.next != null {
            got += valueOf(head.next)
        }
    }
    t.assert(got == 8)
}

func testNarrowsATernaryArm(t Test) {
    var maybe option[int] = 5
    var got = maybe != null ? double(maybe) : 0
    t.assert(got == 10)
}

func testNegatedTestNarrowsTheElseArm(t Test) {
    var maybe option[int] = 5
    var got = maybe == null ? 0 : double(maybe)
    t.assert(got == 10)
}

window {
    main
}
