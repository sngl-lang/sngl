// A field written twice has no one type for the declaration to carry, and the
// literal has one initializer more than the struct has fields. Reported rather
// than given a type, which is what giving up here would mean; the literal is
// invalid, so a read of it adds no error of its own.

import . "sngl:ui"

component main node {
    var s = {a=1, a=2} // ERROR(check) "duplicate field \"a\" in struct literal"

    text(value=string(s.a))
}

window {
    main
}
