An effect under a loop, keyed on the element the loop binds with `&`.

passRefLoop has made the key `xs[i].items`, so its cell steps through the
loop's index, and each copy is a cell of its own. A write notes the copy it
reached -- the index it wrote at -- in the queue's fourth column, or in
`dirtyAt` for one only @update describes, and the settle runs each copy's
records and @update inside the loop it rebuilds. A list mutation of what the
loop walks moves the elements from where it inserts or removes, so `shift`
marks those copies before the write; a push adds a copy, which is reported
nothing.

deny out/go/bubbletea/model.go `append\(m\.xs__inst0, Row[^\n]*\n\t*m\.__effect0_` -- a push to what the loop walks moves no copy, so it notes nothing
deny out/go/bubbletea/model.go `slices\.Insert\(m\.xs__inst0[^\n]*\n\t*\}\n\t*m\.__effect0_note_shift` -- the copies an insert moves are marked before the write, against the length it had

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

struct Row {
    items list[int] = []
    n     int = 0
}

component rows ui.node {
    var xs list[Row] = [Row{items=[1]}, Row{items=[2]}]
    var log list[string] = []

    ui.vbox {
        for var &x = xs {
            effect(
                on = x.items,
                @update(v) {
                    log.push("update {v.length()}")
                },
                @insert(at, item) {
                    log.push("insert {at} {item}")
                },
            )
        }
    }

    ui.button(text="grow", @click {
        xs[1].items.push(5)
    })
    ui.button(text="same", @click {
        xs[1].items = [2]
    })
    ui.button(text="push", @click {
        xs.push(Row{})
    })
    ui.button(text="first", @click {
        xs.insert(0, Row{items=[9]})
    })
    ui.text(value=log.join(","))
}

ui.window(title="Rows") {
    rows
}
