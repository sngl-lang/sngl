// SKIP(codegen) "names sngl:platform/html, which a per-platform harness does not register; the html output is pinned by bodyless_component_override.txtar"
// A bodyless component is a signature, and an override is what supplies the
// render. One override is what the declaration requires, the same as for a
// bodyless func: the checker does not know which target a build picks.

import ui "sngl:ui"
import html "sngl:platform/html"

component gap(w int) ui.node

component gap[html.platform](w) {
    ui.text(value="{w}")
}

component card() ui.node {
    ui.vbox {
        gap(w=4)
    }
}

ui.window {
    card()
}
