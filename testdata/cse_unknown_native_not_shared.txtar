A function whose body calls a native nothing declares const is not pure: the
host may answer differently each time, and nothing in the program says it
will not. Inferred purity used to skip such a call -- an undeclared native's
purity is unknown, and unknown ranked below pure -- so `roll` came out pure
and passCSE merged the statement's two calls into one, rolling once for both
dice. The block body is what keeps the optimizer from inlining `roll` first,
which hid the merge by leaving two calls to the native itself.

deny out/none/html/index.html `__cse` -- the two calls are two rolls, not one shared value
-- app.sngl --
import . "sngl:ui"
import api "js:./api"

output {
    none {
        html
    }
}

func roll() float {
    var n = api.random()
    return n
}

var total = 0.0

window {
    button(text="{total}", @click { total = roll() + roll() })
}
-- api/index.ts --
export function random(): number { return Math.floor(Math.random() * 6) + 1; }
