// Valid children counts for all three child-type forms.

import . "sngl:ui"
import family "sngl:family"

component RequiresOne(content ...component family.one) node {
    vbox { content }
}

component OptionalOne(content ...component option[node]) node {
    vbox { content }
}

component AnyChildren(children ...component) node {
    vbox { children }
}

component main node {
    RequiresOne {
        text(value="exactly one")
    }
    OptionalOne {}
    OptionalOne {
        text(value="one is ok")
    }
    AnyChildren {}
    AnyChildren {
        text(value="one")
        text(value="two")
        text(value="three")
    }
}

window {
    main
}
