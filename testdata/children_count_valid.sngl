// Valid children counts for all three child-type forms.

import . "sngl:ui"
import tr "sngl:tree"

component RequiresOne(slot _ tr.one) {
    vbox { slot }
}

component OptionalOne(slot _ option<tr.default>) {
    vbox { slot }
}

component AnyChildren(slot _) {
    vbox { slot }
}

component main {
    RequiresOne {
        text(value="exactly one")
    }
    OptionalOne {}
    OptionalOne {
        text(value="one is ok")
    }
    AnyChildren {}
    AnyChildren {
        text(value="one")
        text(value="two")
        text(value="three")
    }
}
