// Valid children counts for all three child-type forms.

import . "sngl:ui"
import tr "sngl:tree"

component RequiresOne(content ...component tr.one) {
    vbox { content }
}

component OptionalOne(content ...component option<tr.default>) {
    vbox { content }
}

component AnyChildren(children ...component) {
    vbox { children }
}

component main {
    RequiresOne {
        text(value="exactly one")
    }
    OptionalOne {}
    OptionalOne {
        text(value="one is ok")
    }
    AnyChildren {}
    AnyChildren {
        text(value="one")
        text(value="two")
        text(value="three")
    }
}
