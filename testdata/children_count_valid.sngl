// Valid children counts for all three child-type forms.

import . "sngl:ui"
import tr "sngl:tree"
import app "sngl:app"

component RequiresOne(content ...component tr.one) ui {
    vbox { content }
}

component OptionalOne(content ...component option<ui>) ui {
    vbox { content }
}

component AnyChildren(children ...component) ui {
    vbox { children }
}

component main ui {
    RequiresOne {
        text(value="exactly one")
    }
    OptionalOne {}
    OptionalOne {
        text(value="one is ok")
    }
    AnyChildren {}
    AnyChildren {
        text(value="one")
        text(value="two")
        text(value="three")
    }
}

app.window {
    main
}
