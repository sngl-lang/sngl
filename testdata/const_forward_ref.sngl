import . "sngl:ui"
import app "sngl:app"

// Const initializers may forward-reference a const declared later in the file.
// Pass1 registers every top-level const as a name shell before checking any
// initializer (checkPendingConstInits), so declaration order does not matter.
const A = B + 1
const B = 10
component main node {
    text(value="{A}")
}

app.window {
    main
}
