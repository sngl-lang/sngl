import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

struct Vec {
    x int = 0
    y int = 0
}

component geo node {
    var pos = Vec{x=5, y=10}
    func sum() => pos.x + pos.y

    text(value="{sum}")
}

func testStructReassignment(t Test, c geo) {
    c.pos = Vec{x=100, y=200}
    t.assert(c.pos.x == 100)
    t.assert(c.pos.y == 200)
}

func testComputedFromStruct(t Test, c geo) {
    t.assert(c.sum == 15)
    c.pos.x = 20
    t.assert(c.sum == 30)
}

app.window {
}
