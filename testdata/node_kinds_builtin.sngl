import . "sngl:ui"
import . "sngl:time"

// The built-in visual nodes, unshadowed: each dispatches to its own compiler
// construct off the #[builtin] mark rather than off the literal name.
component main node {
    timer(interval=1s, @tick {})
    boundary(@error(e) {}) {
        text(value="guarded")
    }
}

component wrapper(children ...component) node {
    vbox {
        children
    }
}

window {
    main
}
