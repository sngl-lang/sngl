package main

import "testing"

func TestNestedBodyReadsAndWritesTheOwnersVar(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.seen == 2)) { t.Errorf("assert failed: %s", "(c.seen == 2)") }
	if !((c.count == 3)) { t.Errorf("assert failed: %s", "(c.count == 3)") }
}


