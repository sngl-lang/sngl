A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_scroll.sngl --
import . "sngl:ui"
import . "sngl:test"

// scroll: a control inside a scroll that moves both ways is pressed as
// one outside it is.
component main node {
    var taps = 0
    scroll(direction=both) {
        button #tap(text="tap", @click { taps += 1 })
    }
}

func testAControlInsideAScrollIsPressed(t Test, c main) {
    t.assert(c.taps == 0)
    c.tap.click()
    t.assert(c.taps == 1)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
