package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	x float64
	y float64

	__n0 *container.Scroll
	__n1 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.x = 0.0
	m.y = 0.0
	return m
}

func (m *Model) X() float64 {
	return m.x
}

func (m *Model) SetX(v float64) {
	m.x = v
}

func (m *Model) Y() float64 {
	return m.y
}

func (m *Model) SetY(v float64) {
	m.y = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = container.NewVScroll(nil)
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText("content")
	m.__n0.Content = m.__n1
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
