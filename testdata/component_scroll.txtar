package main

import "testing"

func TestScrollOffsetsMutate(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.x == 0.0)) { t.Errorf("assert failed: %s", "(c.x == 0.0)") }
	if !((c.y == 0.0)) { t.Errorf("assert failed: %s", "(c.y == 0.0)") }
	c.x = 12.5
	c.y = 42.0
	if !((c.x == 12.5)) { t.Errorf("assert failed: %s", "(c.x == 12.5)") }
	if !((c.y == 42.0)) { t.Errorf("assert failed: %s", "(c.y == 42.0)") }
}


func newTestComponent() Model { return New() }
