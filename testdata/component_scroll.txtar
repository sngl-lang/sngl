}

type setXMsg struct{ value float64 }

func SetXCmd(v float64) tea.Cmd {
	return func() tea.Msg { return setXMsg{value: v} }
}

func (m Model) Y() float64 {
	return m.y
}

func (m Model) SetY(v float64) Model {
	m.y = v
	return m
