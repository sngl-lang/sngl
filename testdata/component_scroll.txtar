type Model struct {
	x__inst0 float64
	y__inst0 float64
	__n0     gtk4rt.Handle
	__n1     gtk4rt.Handle
	__root   gtk4rt.Handle
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	m.x__inst0 = 0.0
	m.y__inst0 = 0.0
	return m
}

func (m *Model) X__inst0() float64 {
