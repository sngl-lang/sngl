-- component_scroll.sngl --
import . "sngl:ui"
import . "sngl:test"

// scroll: state-binding fixture — mutating bound scrollX/scrollY
// propagates through the scroll viewport.
component main node {
    var x = 0.0
    var y = 0.0
    scroll(direction="both", scrollX=x, scrollY=y) {
        text(value="content")
    }
}

func testScrollOffsetsMutate(t Test, c main) {
    t.assert(c.x == 0.0)
    t.assert(c.y == 0.0)
    c.x = 12.5
    c.y = 42.0
    t.assert(c.x == 12.5)
    t.assert(c.y == 42.0)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
