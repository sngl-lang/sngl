package main

import "testing"

func TestAControlInsideAScrollIsPressed(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.taps == 0)) { t.Errorf("assert failed: %s", "(c.taps == 0)") }
	c.tapClick()
	if !((c.taps == 1)) { t.Errorf("assert failed: %s", "(c.taps == 1)") }
}


