// A type reached through a package is the same type, so a static method on it
// is called the same way. Both spellings are here.

import ui "sngl:ui"
import draw "sngl:ui/draw"
import . "sngl:ui/draw"

component m(angle float) ui.node {
    var c = draw.Point{x=50.0, y=50.0}

    // Qualified through the alias.
    var a = draw.Point.polar(c, 40.0, angle)
    // And bare, through the dot import.
    var b = Point.polar(c, 40.0, angle)

    ui.text(value="{a.x} {b.y} {draw.Point.distance(a, b)}")
}

ui.window {
    m(angle=1.0)
}
