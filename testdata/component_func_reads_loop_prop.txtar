A component's function reading one of its props, where the component is
spliced under a loop with the prop bound to the loop's variable, and where
bubbletea would build it at run time. A spliced component's functions are
hoisted out of the loops around it and take the loop variables they read as
parameters; bubbletea splices a component with functions rather than build it
as a render function of the Model, whose methods cannot read the props the
render function is handed. A function taken as a value there is a lambda
passing them on.

cmd/sngl/testdata/component_func_reads_loop_prop_runs.txt runs it on all six.

deny out/go/fyne/model.go `shout__inst0\(\) string` -- the hoisted function takes the loop variable it reads
deny out/none/html/index.html `function shout__inst0\(\)` -- the hoisted function takes the loop variable it reads
deny out/go/fyne/model.go `m\.suffix__inst0\(__item\)` -- the function taken as a value is bound to the loop variable

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component row(label string) node {
    func shout() string {
        var out = ""
        for var c = [1, 2] {
            out = out + label + "{c}"
        }
        return out
    }
    text(value=shout())
}

component tagged(label string) node {
    func suffix(s string) string {
        return s + label
    }
    text(value=["q"].map(suffix)[0])
}

component main node {
    var shown = true
    var name = "n"
    vbox {
        button #hide(text="h", @click { shown = false })
        for var x = ["p", "q"] {
            row(label=x)
            tagged(label=x)
        }
        if shown {
            row #only(label=name)
        }
    }
}

func testRowsRender(t Test, c main) {
    t.assert(c.only != null)
    c.hide.click()
    t.assert(c.only == null)
}

window {
    main
}
