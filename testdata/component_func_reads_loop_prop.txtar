package main

import "testing"

func TestRowsRender(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	c.hideClick()
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
