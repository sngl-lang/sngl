package main

import "testing"

func TestRowsRender(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	c.hideClick()
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
