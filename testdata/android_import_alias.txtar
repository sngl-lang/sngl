Every Compose name the android screen uses reaches it through an explicit
import -- never a star -- and an explicit import outranks a declaration of the
file's own package. So a program declaring a component that becomes `Text` or
`Card` would have every call of it captured by Material's, and the emitter's
own calls of Material's would reach the program's under a star. Instead the
import set knows what the file declares, and imports Material's under an
alias.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `^import androidx\.compose\.material3\.Text$` -- the program's Text owns the simple name
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `^import [\w.]+\.\*$` -- no star import
-- app.sngl --
import ui "sngl:ui"

output {
    kotlin {
        android
    }
}

// State, under a loop: each copy is built at run time, so each is a
// composable the file declares rather than a body spliced away.
component text(label string) ui.node {
    var taps = 0
    ui.button(text="[{label}] {taps}", @click {
        taps = taps + 1
    })
}

component card(content option[component ui.node]) ui.node {
    var open = true
    if open {
        ui.card {
            content
        }
    }
}

ui.window(title="Alias") {
    for var l = ["a", "b"] {
        card {
            component content {
                text(label=l)
                ui.text(value="Material's")
            }
        }
    }
}
