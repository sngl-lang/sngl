import . "sngl:ui"

// HOVER(add) "func add(a int, b int) int"
// HOVER(add) "Adds two integers."
// HOVER(add) "Returns their sum."
// Adds two integers.
// Returns their sum.
func add(a int, b int) int { return a + b }

// HOVER(tick) "func tick()"
func tick() {}

// HOVER(double) "func double(x int) int"
func double(x int) int { return x * 2 }

struct Counter {
    n int
}

// A receiver the declaration writes is shown as written, `this` or not.
// HOVER(bump) "func Counter.bump(this ref[Counter])"
func Counter.bump(this ref[Counter]) {
    this.n += 1
}

// HOVER(twice) "func twice(f func(int) int, x int) int"
func twice(f func(int) int, x int) int { return f(f(x)) }
