import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

var theme = "light"

component card node {
    text #out(value=theme)
}

component main node {
    button #toggle(text="toggle", @click { theme = "dark" })
    card #cd()
}

func testGlobalVarReactivity(t Test, c main) {
    var cd = c.cd
    t.assert(cd.out.value == "light")
    c.toggle.click()
    t.assert(cd.out.value == "dark")
}

app.window {
    main
}
