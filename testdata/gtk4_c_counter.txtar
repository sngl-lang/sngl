gtk4 writes a program in C: its widgets are the ones the cgo option declares,
which call GTK as C does, and a handler is a closure GLib holds -- its
dispatcher, and its captures on the heap, which GLib releases with the
widget. A component's state is the box NoRef made of it, which the closure
shares with the build.

The counter starts at 0 and a click adds one, which the label shows.

-- app.sngl --
import ui "sngl:ui"
import c "sngl:language/c"

output {
    c {
        gtk4(gir="builtin")
    }
}

component main ui.node {
    var n = 0
    ui.vbox {
        ui.button #count(text="{n}", @click {
            n += 1
        })
    }
}

ui.window(title="t") {
    main()
}
