A branch and a loop body each holding several nodes, and a counted loop that
never reads its variable, on every target.

bubbletea rendered every node of an `if` body, or of a loop body, into the
one string the branch or iteration produces, so the loop kept only its last
node and two stateful components in one `if` redeclared the var the first had
declared (`no new variables on left side of :=`). Each node is now its own
part: a loop joins them with its iterations, a branch the way its container
joins its children.

A counted loop whose body never names its variable was `for i := range n`
with `i` unused, which Go refuses: in a func, and in the length func
bubbletea's focus order writes for a loop of buttons over `seq.count`.

The run records are the assertion: every target builds and the test passes.

deny out/go/bubbletea/model.go `for i := range` -- nothing reads i
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"
import seq "sngl:seq"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component Counter(label string) node {
    var n = 0

    button(text="{label} {n}", @click { n += 1 })
}

component main node {
    var show = true
    var k = 3
    var picked = 0
    var xs = [1, 2]

    func count() int {
        var total = 0
        for var i = seq.count(k) {
            total += 1
        }
        return total
    }

    vbox {
        if show {
            Counter(label="a")
            Counter(label="b")
        }
        for var x = xs {
            text(value="first {x}")
            text(value="second {x}")
        }
        for var i = seq.count(k) {
            button(text="pick", @click { picked += count() })
        }
    }
}

func testCount(t Test, c main) {
    t.assert(c.count() == 3)
}

window {
    main
}
