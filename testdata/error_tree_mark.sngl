// What #[tree.kind] refuses. A tree is named by a struct that holds nothing:
// the declaration is the identity, so there is nothing to store in it and
// nothing for a component to carry the mark for.

import tr "sngl:tree"
import ui "sngl:ui"
import app "sngl:app"

#[tr.kind] // ERROR(check) "a tree struct holds nothing"
struct sized {
    n int
}

#[tr.kind] // ERROR(check) "a tree is named by a struct"
component marked() ui.ui {}

app.window {
}
