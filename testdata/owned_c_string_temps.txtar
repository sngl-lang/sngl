A string a program hands its own C function is a `c.str` it owns, and
ReleaseTemps frees it once the statement that made it is done: in a loop,
each iteration's before the next; in a `return`, after the result is bound
and before the function returns; and a constant one once, at teardown, from a
Model field New sets. A statement that may raise while one is live runs in a
catch block of its own, which frees it and raises again to the boundary.
`Free` is sngl:x/c's, promoted when the release first calls it, and fyne's
and bubbletea's preambles include the <stdlib.h> that declares the `C.free` it
calls.

-- app.sngl --
import ui "sngl:ui"
import macro "sngl:macro"
import go "sngl:language/go"
import "c:string.h"

output {
    go {
        fyne
        bubbletea
        gtk4
    }
}

#[macro.cnative("strlen")]
func cLength(s string) int

func total(words list[string]) int {
    var n = 0
    for var w = words {
        n += cLength(w)
    }
    return n
}

func measured(s string) int {
    return cLength(s + "!")
}

func positive(n int) int {
    if n == 0 {
        error.raise("empty", "")
    }
    return n
}

var v = 0
var word = ""
var problem = ""

ui.window(title="t") {
    ui.boundary(@error(e) {
        problem = e.message
    }) {
        ui.button(text="{v}", @click {
            v = total(["a", "bc"]) + measured("x") + cLength("const")
        })
        ui.button(text="{problem}", @click {
            v = positive(cLength(word))
        })
    }
}
