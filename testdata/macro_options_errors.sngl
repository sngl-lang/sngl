// #[options] marks the struct that declares a build-option schema. A form with
// no fields to check an output() argument against refuses it.

import . "sngl:macro"
import app "sngl:app"

#[options] // ERROR(check) "#[options] cannot mark"
var bad = 5

#[options] // ERROR(check) "#[options] cannot mark"
enum Bad {
    a
    b
}

#[options]
#[options] // ERROR(check) "already marked"
struct Twice {
    gadget string = ""
}

app.window {
}
