// A mark means the same thing wherever the declaration sits. A component-local
// var and const carry one just as a top-level one does, and an unknown macro
// on either is the same error.
import . "sngl:ui"

component main node {
    #[nosuchmacro] // ERROR(check) "unknown macro \"nosuchmacro\""
    var x = 1

    #[alsonosuch] // ERROR(check) "unknown macro \"alsonosuch\""
    const y = 2

    text(value=string(x) + string(y))
}

window {
    main
}
