A data component's events are functions of its record, which the container
calls: the call site's handler is the function, closing over the call site's
scope, and an event nobody handled is one that does nothing. A write in a
handler patches what reads it on a mutation target, wherever the handler runs
-- here from inside a loop over the records, which is itself inside a lambda
the container hands a slot. A raise in one is resolved against the caller's
boundaries, past the container's own.

`testdata/family_data_events.sngl` is the interpreter's half and
`cmd/sngl/testdata/family_data_events_runs.txt` runs this on all six.

deny out/none/html/index.html `\bout\.textContent` -- a patch inside a record's handler names the element the page emitted
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `: Any = null` -- an event field is a function type, not Any
-- app.sngl --
import . "sngl:ui"

component action(label string, @run(), @pick(n int)) action

// Runs every record's handlers: the container acting on what it was handed,
// under a boundary of its own.
component bar(actions ...component action, controls component(fire func()) node) node {
    var inner = ""
    vbox {
        boundary(@error(e) {
            inner = e.message
        }) {
            controls(func() {
                for var a = actions {
                    a.run()
                    a.pick(a.label.length)
                }
            })
        }
        text(value=inner)
    }
}

component main node {
    var count = 0
    var picked = 0
    var names = ["x", "yy"]
    vbox {
        bar #b {
            action(label="inc", @run {
                count = count + 1
            })
            action(label="none")
            for var n = names {
                action(label=n, @pick(k) {
                    picked = picked + k * 10 + n.length
                })
            }
            component controls(fire) {
                button #all(text="all", @click {
                    fire()
                })
            }
        }
        text(value="{count} {picked}")
    }
}

component failing node {
    var caught = ""
    var after = false
    vbox {
        boundary(@error(e) {
            caught = e.message
        }) {
            bar #b {
                action(label="boom", @run {
                    error.raise("boom", "test")
                    after = true
                })
                component controls(fire) {
                    button #all(text="all", @click {
                        fire()
                    })
                }
            }
        }
    }
}

window {
    main
    failing
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
