component config {
    const max = 100
    const label = "limit"
    var count = 0
    computed remaining = max - count

    text(value="{remaining}", key="out")
}

test config "const values" {
    assert(max == 100)
    assert(label == "limit")
    assert(root._find("out").value == "100")
}

test config "computed from const" {
    count = 30
    assert(remaining == 70)
    assert(root._find("out").value == "70")
}
