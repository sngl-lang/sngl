component config {
    const max = 100
    const label = "limit"
    var count = 0
    func remaining() => max - count

    text #out (value="{remaining} remaining")
}

test config "const values" {
    assert(max == 100)
    assert(label == "limit")
    assert(#out.value == "100 remaining")
}

test config "computed from const" {
    count = 30
    assert(remaining == 70)
    assert(#out.value == "70 remaining")
}
