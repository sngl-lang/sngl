import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

component config node {
    const max = 100
    const label = "limit"
    var count = 0
    func remaining() => max - count

    text #out(value="{remaining} remaining")
}

func testConstValues(t Test, c config) {
    t.assert(c.max == 100)
    t.assert(c.label == "limit")
    t.assert(c.out.value == "100 remaining")
}

func testComputedFromConst(t Test, c config) {
    c.count = 30
    t.assert(c.remaining == 70)
    t.assert(c.out.value == "70 remaining")
}

app.window {
}
