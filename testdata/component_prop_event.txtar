A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_prop_event.sngl --
import . "sngl:ui"

component Button(variant = "primary", @click(v int)) node {
    button(text="Click me", @click { click(1) })
}

component main node {
    var count = 0

    Button(variant="primary", @click(e) { count += e })
    text(value=string(count))
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
