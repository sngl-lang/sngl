A `#id` written in a slot population reaches its siblings there, inside a
vbox or a canvas as at the top. A circle's radius read beside the canvas is
the expression the prop was given (passNodePropReads), on every target.

deny * `\bdot\b` -- the read is answered at build time; no target names the shape

-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"

component card(top component() ui.node) ui.node {
    ui.vbox {
        top()
    }
}

ui.window(title="t") {
    card {
        component top {
            ui.vbox {
                ui.text #label(value="inside")
            }
            draw.canvas(width=10px, height=10px) {
                draw.circle #dot(cx=5.0, cy=5.0, r=5.0)
            }
            ui.text(value="radius {dot.r}")
        }
    }
}

output {
    none {
        html
    }
    go {
        gtk4
        fyne
        bubbletea
    }
    kotlin {
        android
    }
}
