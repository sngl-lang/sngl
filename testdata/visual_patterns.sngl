import . "sngl:ui"
import app "sngl:app"

component Card(title = "Card", subtitle = "", children ...component) ui {
    vbox {
        text(value=title)
        text(value=subtitle)
    }
}

component main ui {
    var (
        items = ["a", "b", "c"]
        show = true
        count = 0
        searchText = ""
    )

    vbox {
        input #searchBox(value=searchText, @change(e) { searchText = e })
        text #searchLabel(value="Search: " + searchText)
        for var idx, item = items {
            Card(subtitle=string(idx), title=string(item)) {
                text(value="content")
            }
        }
        button(text="Click", @click { count += 1 })
    }
}

app.window {
    main
}
