component Card(title = "Card", subtitle = "") list<component> {
    vbox {
        text(value=title)
        text(value=subtitle)
    }
}

component main {
    var (
        items = ["a", "b", "c"]
        show = true
        count = 0
        searchText = ""
    )

    vbox {
        input #searchBox(value=searchText, @change={ searchText = event })
        text(ref="searchLabel", value="Search: " + searchText)
        for item, idx = items {
            Card(subtitle=string(idx), title=item) {
                @attrs(data="extra")
                text(value="content")
            }
        }
        button(text="Click", @click={ count += 1 })
    }
}
