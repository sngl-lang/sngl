win32 writes a program in C with no placement code of its own: the platform
asks for `placement`, which turns each node operation into a call of the
protocol functions lib/platform/win32 declares, and the C language writes
that program whole. What the generator adds is `main`, which builds the
program in a turn and runs the message loop, and the manifest, whose
`target` line has the build cross-compile with MinGW.

The `if` places its text through the box's insertBefore, ahead of the
hbox; each control's handler is a closure the runtime releases with its
window; the window's title crosses as UTF-16 and each Look as one C struct.

-- app.sngl --
import ui "sngl:ui"

output {
    c {
        win32
    }
}

component main ui.node {
    var n = 0
    var name = ""
    var on = false
    ui.vbox {
        ui.text(value="Count {n}")
        ui.button #inc(text="More", @click { n += 1 })
        ui.input #who(value=name, @change(v) { name = v })
        ui.checkbox #flag(checked=on, @change(v) { on = v })
        if n > 2 {
            ui.text(value="Big")
        }
        ui.hbox {
            ui.spacer()
        }
    }
}

ui.window(title="Counter") {
    main()
}
-- out/c/win32/main.c --
