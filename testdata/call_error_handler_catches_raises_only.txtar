A call's @error catches a raise and nothing else. Go recovers only an
ErrorEvent and re-panics the rest; JavaScript caught everything thrown, a
TypeError included, and Kotlin every Exception, CancellationException and an
integer divide by zero included, so a host fault ran the handler as though the
program had raised. JavaScript now rethrows what carries no `kind`, and Kotlin
catches SnglRaise alone.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `catch \(__err: Exception\)` -- only a raise is caught
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `as\? SnglRaise` -- the catch already says what it holds

-- raises.sngl --
import . "sngl:ui"

func ratio(n int) int {
    if n > 5 {
        error.raise("too big", "range")
    }
    return 10 / n
}

component panel node {
    var caught = ""
    var got = 0
    button #b(text="b", @click {
        ratio(0, @error(e) {
            caught = e.message
        })
    })
    text(value="{caught}{got}")
}

window {
    panel
}

output {
    kotlin {
        android
    }
    none {
        html
    }
}
