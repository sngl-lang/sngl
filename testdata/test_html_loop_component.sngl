import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

struct Item {
    name string = ""
}

component card(name = "") ui {
    var clicks = 0
    button(text="{name} ({clicks})", @click { clicks += 1 })
}

component main ui {
    var items list<Item> = [
        {name="a"},
        {name="b"},
    ]
    for var item = items {
        card(name=item.name)
    }
    button #add(text="add", @click { items.push({name="x"}) })
}

func testLoopComponentMountsInstances(t Test, c main) {
    t.assert(true)
}

app.window {
    main
}
