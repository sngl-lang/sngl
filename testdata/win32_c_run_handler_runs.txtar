win32's @run, as gtk4's and fyne's (testdata/platform_run_handler_runs.txtar):
the handler runs before the loop, with the command line, and `run` presents
the windows the build held hidden and runs the loop, so the code after it
waits for the loop to end. Not called, the handler returns and the loop runs
with no window, which only the program's quit ends. Each run ends from the
tick, which quits: the loop exits and the application tears down -- the
probe's @unmount -- before `run` returns, so "after" follows it where run
was called and precedes the tick where it was not.

exec out/c/win32 -- hidden.txt
exec out/c/win32 --window x -- shown.txt
-- app.sngl --
import c "sngl:x/c"
import macro "sngl:macro"
import time "sngl:time"
import ui "sngl:ui"
import win32 "sngl:platform/win32"

c.link(include="stdio.h", system=true)

#[macro.cnative("puts")]
func say(s string)

var (
    n = 0
    stopped = false
)

output {
    c {
        win32(@run(args, run) {
            start(args, run)
        })
    }
}

func start(args list[string], run func()) {
    say("before {args.length}")
    n = args.length
    if args.contains("--window") {
        run()
    }
    say("after")
}

time.timer(interval=100ms, @tick {
    if !stopped {
        stopped = true
        say("tick {n}")
        win32.quit()
    }
})

component probe ui.node {
    effect(@unmount {
        say("unmount")
    })
    ui.text(value="{n}")
}

ui.window {
    probe()
}
-- hidden.txt --
before 0
after
tick 0
unmount
-- shown.txt --
before 2
tick 2
unmount
after
-- out/c/win32/main.c --
