A #[foreign] mark does not make a declaration foreign: the backend still
emits it, body and all. So the lowering passes have to walk that body like
any other.

NoContext rewrites a context read into a hidden field on the component and
threads it through every function that reads one. A function it skips keeps
an ir.ContextRead, which no language emitter has a case for — the build panics
rather than producing anything. Skipping the marked one is what an imported
declaration deserves, because an import has no body here at all.

What the output does *not* carry is the `"dark"` the provider sets. `label` is
a top-level func rather than a component's, so NoContext threads it the
package-level cell and the page renders `theme=light`. That was already true
-- the `__ctx_theme__inst0 = "dark"` beside it was read by nobody -- and what
changed is only that the shake now removes the cell as well. The provider
reaching a top-level reader is its own question and this archive does not
answer it; it is here so that the body is walked at all.
-- app.sngl --
import . "sngl:ui"
import . "sngl:macro"

output {
    go {
        bubbletea
    }
}

context #theme("light")

#[foreign("js:./api", "label")]
func label() string {
    return "theme=" + theme
}

component Toolbar node {
    text(value=label())
}

window #home(title="Home", href="/") {
    theme("dark") {
        Toolbar()
    }
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	__ctx_theme string

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.__ctx_theme = "light"
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) label() string {
	return ("theme=" + m.__ctx_theme)
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(m.label()))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
