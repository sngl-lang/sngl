import . "sngl://std"
import "sngl://i18n"

// Plain translatable string with no interpolation.
component i18nBasic {
    var label = $"Login"

    // Triple-quoted form (whitespace-trimmed by ICU template lowering).
    var paragraph = $"""
        Welcome back. Please sign in to continue.
    """

    text(value=label)
}

func testBasicEnglish(t Test, c i18nBasic) {
    t.setLocale("en")
    t.assert(c.label == "Login")
    t.assert(c.paragraph == "Welcome back. Please sign in to continue.")
}
