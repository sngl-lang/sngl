-- out/go/fyne/model_test.go --
package main

import "testing"

func TestCheckboxCarriesChecked(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.boxChange(true)
	if !((c.seen == "box true true")) { t.Errorf("assert failed: %s", "(c.seen == \"box true true\")") }
	if !((c.on == true)) { t.Errorf("assert failed: %s", "(c.on == true)") }
	c.boxChange(false)
	if !((c.seen == "box false false")) { t.Errorf("assert failed: %s", "(c.seen == \"box false false\")") }
	if !((c.on == false)) { t.Errorf("assert failed: %s", "(c.on == false)") }
}

func TestToggleCarriesChecked(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.swChange(true)
	if !((c.seen == "sw true")) { t.Errorf("assert failed: %s", "(c.seen == \"sw true\")") }
	if !((c.lit == true)) { t.Errorf("assert failed: %s", "(c.lit == true)") }
	c.swChange(false)
	if !((c.seen == "sw false")) { t.Errorf("assert failed: %s", "(c.seen == \"sw false\")") }
	if !((c.lit == false)) { t.Errorf("assert failed: %s", "(c.lit == false)") }
}

