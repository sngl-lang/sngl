package main

import "testing"

func TestLevels(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.depth == 2)) { t.Errorf("assert failed: %s", "(c.depth == 2)") }
}

-- out/go/fyne/testcomponent_test.go --
package main

import "fyne.io/fyne/v2/test"

func newTestComponent() *Model {
	test.NewApp()
	return &Model{}
}

func mountTestComponent(m *Model, preset map[string]bool) *Model {
	m.__init(preset)
	m.BuildUI()
	return m
}
