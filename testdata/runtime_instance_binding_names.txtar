A recursive component whose prop, slot and population parameters are named
the way generated code names its own locals, on every target.

bubbletea renders `frame` as a method on the Model and each population as a
closure, both in a scope holding the receiver `m` and the `result`/`part`
locals the view emitter declares. A population parameter named `m` shadowed
the receiver (`m.mark undefined`), and a prop, slot or parameter named
`result` or `part` was redeclared beside the emitter's own. Each such name is
bound with a trailing underscore there, which no emitted name ends in.

android emitted a population parameter as written, so one named `in` -- a
Kotlin hard keyword -- was `{ in -> }`; the parameter, the insertion of a slot
so named, and every read of the local are escaped now.

The run records are the assertion: each target compiles and runs the test.

deny out/go/bubbletea/model.go `func\(m int\)` -- a population parameter named m shadows the Model receiver
deny out/go/bubbletea/model.go `renderFrame\(result int` -- a prop named result is redeclared by the method's own result local
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `\{ in ->` -- in is a Kotlin hard keyword
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component frame(result int, m string, part component(depth int) node) node {
    vbox {
        text(value="{m}")
        part(result)
        if result > 0 {
            frame(result=result - 1, m=m) {
                component part(d) {
                    part(d)
                }
            }
        }
    }
}

component main node {
    var depth = 2
    var mark = "*"

    vbox {
        frame(result=depth, m="top") {
            component part(m) {
                text(value="level {m} {mark}")
            }
        }
        frame(result=depth - 1, m="second") {
            component part(result) {
                text(value="r {result} {mark}")
            }
        }
        frame(result=depth - 2, m="third") {
            component part(in) {
                text(value="in {in} {mark}")
            }
        }
    }
}

func testLevels(t Test, c main) {
    t.assert(c.depth == 2)
}

window {
    main
}
