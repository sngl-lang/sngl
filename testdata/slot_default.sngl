// The default slot is declared in the parameter list too, written like a named
// one with the identifier omitted. A component's whole contract is then the one
// list: props, events, the default slot and any named ones.
//
// It takes no parameters — the grammar reaches a parameter list only past an
// identifier — because the caller fills it with ordinary children, and there is
// no population site to bind anything at.

import . "sngl://std"

component card(caption string, slot) {
    vbox {
        text(value = caption)
        slot
    }
}

component panel(slot, slot header) {
    vbox {
        header {
            text(value = "(untitled)")
        }
        slot
    }
}

component main {
    card(caption = "hi") {
        text(value = "child")
    }
    panel() {
        slot header {
            text(value = "Head")
        }
        text(value = "body")
    }
}
