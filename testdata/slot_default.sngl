// The default slot is declared in the parameter list too, under the name `_`.
// A component's whole contract is then the one list: props, events, and slots,
// with nothing to distinguish the default one but its name.
//
// It takes no invocation parameters, because the caller fills it with ordinary
// children and there is no population site to bind anything at.

import . "sngl:ui"

component card(caption string, children ...component) {
    vbox {
        text(value=caption)
        children
    }
}

component panel(children ...component, header component) {
    vbox {
        header {
            text(value="(untitled)")
        }
        children
    }
}

component main {
    card(caption="hi") {
        text(value="child")
    }
    panel() {
        component header {
            text(value="Head")
        }
        text(value="body")
    }
}
