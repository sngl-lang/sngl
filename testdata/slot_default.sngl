// The rest slot is declared in the parameter list like any other slot, with
// `...` on its type. A component's whole contract is then the one list: props,
// events, and slots, with nothing to distinguish the rest one but that bound.
//
// It takes no invocation parameters, because the caller fills it with ordinary
// children, written once, with nothing to bind them to.

import . "sngl:ui"
import app "sngl:app"

component card(caption string, children ...component) ui {
    vbox {
        text(value=caption)
        children
    }
}

component panel(children ...component, header component) ui {
    vbox {
        header {
            text(value="(untitled)")
        }
        children
    }
}

component main ui {
    card(caption="hi") {
        text(value="child")
    }
    panel() {
        component header {
            text(value="Head")
        }
        text(value="body")
    }
}

app.window {
    main
}
