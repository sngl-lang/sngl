A prop read in a boundary's fallback is the call site's argument once the
component is inlined. The optimizer inlines `lister` before lowering -- its
`for` over a prop unrolls -- and substitutes the params it finds in the body,
which it found with a walk of its own that skipped a fallback. So `msg` was
never bound: html read an undeclared `msg`, and gtk4 did not compile.

deny out/none/html/index.html `textContent = msg\b` -- the fallback shows the argument the call site gave
deny out/go/gtk4/model.go `LabelSetLabel\(\w+, msg\)` -- likewise

-- app.sngl --
import ui "sngl:ui"

component lister(items list[string], msg string) ui.node {
    ui.vbox {
        for var x = items {
            ui.text(value=x)
        }
        boundary {
            ui.button(text="boom", @click { error.raise("x", "boom") })
            component failed {
                ui.text(value=msg)
            }
        }
    }
}

ui.window(title="t") {
    lister(items=["a", "b"], msg="sorry it broke")
}

output {
    none {
        html
    }
    go {
        gtk4
        bubbletea
    }
}
