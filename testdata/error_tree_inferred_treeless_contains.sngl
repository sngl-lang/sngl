// The family-parameter rule reads an inferred family too, and has to wait for
// one: `badge` is a widget because its body renders one, so a component that
// takes the family it is placed in may no more contain it than it may contain
// the `text` inside it. Asked while the family was still unsettled, the
// question has no answer and the rule lets it through.

import ui "sngl:ui"

component logger<F>(label string) F {
    badge(label=label) // ERROR(check) "component logger takes the family it is placed in, so it may not contain the node component badge"
}

component badge(label string) {
    ui.text(value=label)
}

ui.window {
    logger(label="x")
}
