
Who unrolls a constant loop, part two: the platform has a say as well as the
language.

html writes its view as markup -- a file in static mode, a string in a
handler in route mode -- and the only iteration it can emit is over an
expression that varies with the request. A `for` over a compile-time constant
is not one, so nothing iterates it and the loop renders its body once with
its variable bound to nothing. `sngl doc --http` lost its whole package list
that way under --lang go: seven links became a single empty <a>.

Both modes are built from the one source, because static mode is the same
platform answering the same way: three links, spelled out, in the file and in
the handler alike. A constant loop over an *empty* list is
unroll_static_view_empty.txtar.

deny out/go/html/server.go `range` -- the three iterations are markup in the handler's string; no loop survives for Go to run
-- app.sngl --
import "sngl:platform/html"
import ui "sngl:ui"

output {
    go {
        html
    }
    none {
        html
    }
}

const packages list<string> = ["alpha", "beta", "gamma"]

ui.window #home(title="Docs") {
    html.nav {
        for var p = packages {
            html.a(href="/p/" + p, innerText=p)
        }
    }
}
-- out/go/html/server.go --
package main

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleHome)
	return mux
}

func handleHome(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Docs</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<nav>\n  <a href=\"/p/alpha\">alpha</a>\n  <a href=\"/p/beta\">beta</a>\n  <a href=\"/p/gamma\">gamma</a>\n</nav>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = {};\n})();\n</script>\n</body></html>\n"))
}

func main() {
	http.ListenAndServe(":8080", Handler())
}
-- out/none/html/index.html --
