An enum whose members carry payloads, on every target: Go holds a value as a
struct of a tag and a field per payload member, its zero the first member's;
JavaScript as `{tag, value}`, compared by a helper; Kotlin as a sealed class
of a data class per payload member and a data object per member carrying none.
A match over one is the chain of the members' tests, each arm binding its
payload where it reads it, and a selector read is an option of the payload.

-- app.sngl --
import . "sngl:ui"

output {
    none {
        html
    }
    go {
        gtk4
        fyne
        bubbletea
    }
    kotlin {
        android
    }
}

struct Size {
    w float
    h float
}

struct Failure {
    message string
    code    int
}

enum Result[T any] {
    ok     T
    failed Failure
}

enum Shape {
    empty
    circle float
    rect   Size
}

// The first member is the zero value, with its payload's zero.
var held Shape

func area(s Shape) float {
    match var v = s {
        empty { return 0.0 }
        circle { return 3.0 * v * v }
        rect { return v.w * v.h }
    }
}

func label(r Result[int]) => match var v = r {
    ok => "ok {v}"
    failed => "failed: {v.message}"
}

func describe(s Shape) => match s {
    circle => "round"
    else => "not round"
}

// In an arm that names no member carrying a payload, the name is the subject.
func kind(s Shape) => match var v = s {
    circle => "round"
    else => "area {area(v)}"
}

func half(n int) Result[int] {
    if n % 2 != 0 {
        return {failed={message="odd", code=n}}
    }
    return Result[int]{ok=n / 2}
}

func orZero(r Result[int]) int {
    // The selector is an option, so the null test narrows it.
    if r.ok != null {
        return r.ok
    }
    return 0
}

component panel node {
    var shape Shape = Shape.empty
    var result = half(4)

    text #shownArea(value="{area(shape)}")
    text #outcome(value=label(result))
    text #facts(value="{area(held)} {orZero(result)} {describe(shape)} {result == Result[int]{ok=2}}")
    text #radius(value=match var r = shape {
        circle => "{r}"
        else => "none"
    })
    match var r = shape {
        circle { text #round(value="radius {r}") }
        else {}
    }

    button #grow(text="Grow", @click {
        shape = match var r = shape {
            empty => {circle=1.0}
            circle => {circle=r + 1.0}
            rect => Shape.empty
        }
    })
    button #odd(text="Odd", @click { result = half(3) })
}

window {
    panel()
}
