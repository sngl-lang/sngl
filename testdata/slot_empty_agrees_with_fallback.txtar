A slot's fallback stands where `.empty` says its content renders nothing:
after content of several statements, under an `if` on the same answer that
`.empty` is spliced as. testdata/slot_empty_agrees_with_fallback.sngl is the
interpreter's answer.

deny * `SlotEmpty` -- every `.empty` is answered before codegen

-- app.sngl --
import . "sngl:ui"

component card(content ...component node) node {
    text(value=content.empty ? "asks: empty" : "asks: full")
    vbox {
        content {
            text(value="fallback")
        }
    }
}

component main node {
    var a = false
    var b = false
    var xs list[int] = []
    var mounted = 0
    card #two {
        if a {
            text(value="a")
        }
        if b {
            text(value="b")
        }
    }
    card #loop {
        for var x = xs {
            text(value="{x}")
        }
    }
    card #lifetime {
        effect(@mount { mounted = mounted + 1 })
    }
    text(value="mounted {mounted}")
    button #show(text="show", @click {
        b = true
        xs = [7]
    })
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
