A forwarded slot's `.empty` is the caller's own: where a component built at
run time hands its content on (a recursion, a stateful component under a
loop), the instantiation's answer asks the caller's slot, so the caller is
handed that answer in turn as a prop of its own.

deny * `SlotEmpty` -- every `.empty` is answered before codegen

-- app.sngl --
import . "sngl:ui"

component tree(d int, content option[component node]) node {
    text(value=content.empty ? "empty {d}" : "full {d}")
    if d > 0 {
        tree(d=d - 1) {
            component content {
                content
            }
        }
    }
}

component inner(content ...component option[node]) node {
    var n = 0
    text(value=content.empty ? "empty" : "has")
    button(text="{n}", @click { n = n + 1 })
    content
}

component outer(content list[component option[node]]) node {
    var m = 0
    button(text="{m}", @click { m = m + 1 })
    for var y = [1] {
        inner {
            content
        }
    }
}

component main node {
    var n = 2
    var xs = [1, 2]
    tree(d=n) {
        component content {
            text(value="x")
        }
    }
    tree(d=n)
    for var x = xs {
        outer
        outer {
            component content {
                text(value="a{x}")
            }
        }
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
