// A directive carrying only options and no block parses as a call rather than
// a visual node, so it reaches the rule by the other route.
import . "sngl:ui"
import app "sngl:app"

component main ui {
    output(name="x") // ERROR(check) "output may only be written at the root of a file"

    text(value="hi")
}

app.window {
    main
}
