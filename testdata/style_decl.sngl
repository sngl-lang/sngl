import . "sngl:ui"

const primary = Style{
    color = #0000ff,
    fontWeight = bold,
    fontSize = 16px,
}

const secondary = Style{
    color = #777777,
    fontStyle = italic,
}

component main node {
    vbox {
        text(value="hello", style=primary)
        text(value="world", style=secondary)
    }
}

window {
    main
}
