A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_spinner.sngl --
import . "sngl:ui"

// spinner: A-tier — the real stdlib signature exposes only
// label/variant/size (no `visible` prop). Declaration-only fixture.
component main node {
    spinner(label="Loading...", variant=circle, size=large)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
