A function taken as a value is bound where it is taken, so the component
taking one reads what the function reads: `adapter` takes `where` under the
`server` its caller provided, and the call through what it took answers that
provider's value, not the default. The component
taking the value used to be no reader of the context at all -- only a call
counted -- so it was handed no value and bound the default.
-- app.sngl --
import . "sngl:test"
import . "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
    }
    kotlin {
        android
    }
}

context #server("default")

func where(n int) string {
    return "{server} {n}"
}

// Takes where as a value and calls it through what it took.
component adapter node {
    var got = "-"
    button #ask(text="ask", @click {
        var f = where
        got = f(1)
    })
    text(value=got)
}

component provided node {
    server("mirror") {
        adapter #a
    }
}

component plain node {
    adapter #a
}

func testValueReadsTheProvider(t Test, c provided) {
    c.a.ask.click()
    t.assert(c.a.got == "mirror 1")
}

func testValueReadsTheDefault(t Test, c plain) {
    c.a.ask.click()
    t.assert(c.a.got == "default 1")
}

window {
    provided
    plain
}
