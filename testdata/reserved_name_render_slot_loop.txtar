A loop over state is re-rendered by a function of its own, and the loop that
function writes is the one the program wrote, symbols and all: what its body
reads resolves to them, and passReservedNames renames the loop variable by
them. Rebuilt from its names alone, a loop variable `m` -- the Go targets'
receiver -- was never renamed, and fyne wrote `for _, m := range m.items`
with the body reading the model through the element.

deny * `, m := range` -- the loop variable does not shadow the receiver
-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
        fyne
        bubbletea
    }
}

var items = [1, 2, 3]

component row(label int) ui.node {
    var hits = 0
    ui.button(text="{label} {hits}", @click { hits += 1 })
}

ui.window(title="loop") {
    ui.vbox {
        for var m = items {
            row(label=m)
        }
        ui.button(text="more", @click { items.push(4) })
    }
}
