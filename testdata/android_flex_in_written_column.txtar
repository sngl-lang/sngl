import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    kotlin {
        android
    }
}

var details = true

if details {
    ui.window(title="Flex") {
        ui.text(value="top")
        nav.stack #pages {
            nav.page #home(href="/", title="Home") {
                ui.text(value="head")
                ui.scroll(style={flex=1}) {
                    ui.text(value="page grows")
                }
            }
        }
        ui.scroll(style={flex=1}) {
            ui.text(value="window grows")
        }
        ui.text(value="bottom")
    }
}
