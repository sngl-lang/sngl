// Two anonymous structs are the same type when they agree on their fields'
// names and types, and a field's type is a declaration rather than a spelling.
// `Style` here and `sngl:ui`'s `Style` are two declarations, so the two
// literals below are two types.
//
// The signature used to be built from `ir.Type.String()`, which is a
// diagnostic: it prints a named type unqualified, so both fields read `Style`
// and the two collapsed into one declaration. The program then compiled, with
// `sngl:ui`'s Style silently become the local one.
//
// Both types print alike for the same reason, which is why the message below
// reads as it does.

import . "sngl:ui"
import ui "sngl:ui"

struct Style {
    x int = 0
}

func takeMine(v struct {
    s Style
}) => v.s.x

component main {
    var theirs = {s=ui.Style{}}
    var n = takeMine(theirs) // ERROR(check) "cannot pass struct { s Style } as struct { s Style }"

    text(value=string(n))
}
