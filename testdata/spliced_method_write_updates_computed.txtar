A component spliced into the page renders a computed, and a method two calls
down writes the state the computed reads, on the mutation targets.

The inliner clones each of `Card`'s funcs with its state renamed per
instantiation (`hits__inst0`), and renamed the idents in the body but not the
func's `Reads`: `shown__inst0` still said it read `Card`'s original `hits`,
which is not reactive in the page. So a write to `hits__inst0` found no
dependent in the computed and the text kept `top:0:6` -- in a handler the call
site's own propagation hid it, and in the mount's `bump` -> `add` chain nothing
did. passInstanceSlots copies a component the same way for `Row`, whose
population it splices in, and its copy's `summary` had the same gap.

deny out/none/html/index.html `function add__inst\d+\(n\) \{\n\s+state\.hits__inst\d+ = state\.hits__inst\d+ \+ n;\n\s+\}` -- the write re-renders the text reading shown()
deny out/none/html/index.html `marks = marks \+ n;\n\s+__n\d+\.textContent = "foot` -- the copy's write re-renders summary() before the foot
-- app.sngl --
import . "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
    none {
        html
    }
}

component Card(label string) node {
    var hits = 0

    func add(n int) {
        hits = hits + n
    }

    func bump() {
        add(2)
    }

    func fact(n int) int {
        if n <= 1 {
            return 1
        }
        return n * fact(n - 1)
    }

    func shown() string {
        return "{label}:{hits}:{fact(3)}"
    }

    vbox {
        text(value=shown())
        effect(@mount { bump() })
    }
}

component Row(label string, foot component(v int) node) node {
    var marks = 0

    func mark(n int) {
        marks = marks + n
    }

    func summary() string {
        return "{label}={marks}"
    }

    vbox {
        text(value=summary())
        foot(marks)
        effect(@mount { mark(2) })
    }
}

component main node {
    var items = ["a", "b"]

    vbox {
        Card(label="top")
        for var it = items {
            Row(label=it) {
                component foot(v) {
                    text(value="foot {it} {v}")
                }
            }
        }
    }
}

window {
    main
}
