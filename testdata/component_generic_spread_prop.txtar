-- component_generic_spread_prop.sngl --
// A struct spread supplies a generic component's props without any of them
// being written, so a type parameter is bound from the spread struct's field of
// that name. `...a` gives `on` the type of `a.on`, which is what types the
// `@mount(v)` payload -- read as a positional argument instead, the spread
// bound T to the struct and the handler was rejected.
import . "sngl:ui"

struct pageArgs {
    on int
}

component main node {
    var page = 3
    // A literal field rather than `on=page`: bubbletea emits a struct-literal
    // var initialized from another var as `PageArgs{On: ""}`, which is a defect
    // of its own and not this fixture's subject.
    var a = pageArgs{on=1}

    effect(...a, @mount(v) {
        page = v + 1
    })

    text(value="page=" + string(page))
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
