// g_object_unref takes a gpointer, and a declaration that names it directly
// would need a cast a SNGL override has no way to write. The shim is where the
// cast belongs -- it is C, which is what this preamble is.
static void sngl_unref_pixbuf(GdkPixbuf *p) {
    if (p != NULL) g_object_unref(p);
}

static void sngl_set_entry_text(GtkEditable *e, const char *t) {
    const char *cur = gtk_editable_get_text(e);
    if (t == NULL) t = "";
    if (cur != NULL && strcmp(cur, t) == 0) return;
    gtk_editable_set_text(e, t);
}
*/
import "C"

import (
	"git.duckfam.us/jonathan/sngl/pkg/go/gtk4rt"
	"time"
	"unsafe"
)

func mustParseDuration(s string) time.Duration {
	d, err := time.ParseDuration(s)
	if err != nil {
		panic(err)
	}
	return d
}

// Model holds the state and widget references for this SNGL UI.
type Model struct {
	__n0     *C.GtkBox
	bar      *C.GtkProgressBar
	__root   *C.GtkBox
	timer0ID uint
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	m.startTimers()
	return m
}

// startTimers arms every schedule the program describes. A GLib timeout source
// already runs its callback on the main thread, so a tick body mutates the
// model in the same place a signal handler does.
//
// Armed unconditionally and gated inside: flipping the gate then pauses and
// resumes with no re-arming wiring, and the next tick simply fires or skips.
func (m *Model) startTimers() {
	m.timer0ID = gtk4rt.Every(100, func() {
		if !(true) {
			return
		}
		m.__timer0_tick()
	})
}

// StopTimers removes every source startTimers armed.
func (m *Model) StopTimers() {
	gtk4rt.CancelEvery(m.timer0ID)
}

func (m *Model) __timer0_tick() {
	C.gtk_progress_bar_pulse(m.bar)
}

func (m *Model) buildWidgetTree() {
	if m.__root != nil {
		return
	}
	m.__root = (*C.GtkBox)(unsafe.Pointer(C.gtk_box_new(C.GTK_ORIENTATION_VERTICAL, 6)))
	m.__n0 = (*C.GtkBox)(unsafe.Pointer(C.gtk_box_new(0, C.int(0))))
	C.gtk_orientable_set_orientation((*C.GtkOrientable)(unsafe.Pointer(m.__n0)), C.GTK_ORIENTATION_VERTICAL)
	C.gtk_box_set_spacing((*C.GtkBox)(unsafe.Pointer(m.__n0)), C.int(6))
	m.bar = (*C.GtkProgressBar)(unsafe.Pointer(C.gtk_progress_bar_new()))
	C.gtk_progress_bar_set_fraction((*C.GtkProgressBar)(unsafe.Pointer(m.bar)), C.double(0))
	C.gtk_box_append((*C.GtkBox)(unsafe.Pointer(m.__n0)), (*C.GtkWidget)(unsafe.Pointer(m.bar)))
	C.gtk_box_append((*C.GtkBox)(unsafe.Pointer(m.__root)), (*C.GtkWidget)(unsafe.Pointer(m.__n0)))
}

// BuildUI constructs the widget tree and returns the top-level window.
func (m *Model) BuildUI(app *C.GtkApplication) *C.GtkWidget {
	m.buildWidgetTree()
	win := C.gtk_application_window_new(app)
	C.gtk_window_set_default_size((*C.GtkWindow)(unsafe.Pointer(win)), 480, 640)
	C.gtk_window_set_child((*C.GtkWindow)(unsafe.Pointer(win)), (*C.GtkWidget)(unsafe.Pointer(m.__root)))
	return win
}
