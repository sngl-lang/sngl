A `#id` names a handle to the rendered node, and a host method called on that
handle has to reach the field the target stores it in.

gtk4's declarations are generated from GIR, which describes a widget's
*properties* -- so a method that sets nothing has no generated form.
`gtk_progress_bar_pulse` is one: it moves the block along by a step and takes no
value, which is how GTK spells an indeterminate bar. It is hand-declared in
`gtk4.sngl` as the C identifier it is, and a program reaches it by naming the
widget `#bar` and calling `bar.pulse()`.

That emitted `C.gtk_progress_bar_pulse(bar)` against a field the same file
declares as `m.bar`, so the generated package did not build: `undefined: bar`.
Every other reference to that widget came out qualified, because gtk4's own
intrinsic path writes `m.<id>` itself; only a native call's receiver went
through the language's ident path, and that path asked `Ident.IsElementRef`.

`IsElementRef` is a fact about a *reference*, and only the `__nN` handles a
lowering pass synthesizes carry it -- a read of a program-written `#id` resolves
to the var the checker bound and carries nothing. So the marker belongs on the
declaration: `ir.Var.NodeHandle`, set where `declareNodeID` binds the name, and
tested rather than name-matched, the way `ir.Param.Receiver` is. Fixed in the Go
language context, which is what makes it true for fyne and bubbletea too rather
than only for the emitter that happened to show it.

deny out/go/gtk4/model.go `(?m)^\s*C\.gtk_progress_bar_pulse\(bar\)` -- the receiver is the model's field; a bare `bar` is a name nothing in the file declares

-- app.sngl --
import . "sngl:ui"
import "sngl:time"
import "sngl:platform/gtk4"

output {
    go {
        gtk4
    }
}

window {
    vbox {
        gtk4.GtkProgressBar #bar(fraction=0.0) {}
        time.timer(interval=100ms, @tick {
            bar.pulse()
        })
    }
}
-- out/go/gtk4/callbacks.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

/*
#include <gtk/gtk.h>

extern void sngl_gtk_idle_add(void* fn);
extern void snglActivate(GtkApplication* app, gpointer data);
*/
import "C"

import (
	"unsafe"
)

// snglCallbacks holds registered Go signal handlers indexed by int.
var snglCallbacks []func()

// The index arrives as GTK's user_data pointer round-tripped through
// GPOINTER_TO_INT, so a stray pointer lands here as an arbitrary int —
// negative included. Bound it on both sides. (//export must sit directly
// above the declaration, so this note goes above it.)
//
//export snglGoDispatch
func snglGoDispatch(idx C.int) {
	if idx >= 0 && int(idx) < len(snglCallbacks) {
		snglCallbacks[int(idx)]()
	}
}

//export snglIdleCallback
func snglIdleCallback(ptr unsafe.Pointer) {
	fn := *(*func())(ptr)
	fn()
}

func gtkPost(fn func()) {
	f := fn
	C.sngl_gtk_idle_add(unsafe.Pointer(&f))
}
-- out/go/gtk4/model.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

/*
#cgo pkg-config: gtk4
#include <gtk/gtk.h>
#include <stdlib.h>

extern void snglGoDispatch(int idx);
// g_signal_connect callbacks are invoked with the signal's signature
// (self, ...args, user_data). This one is (instance, user_data), which
// is the signature of a void signal that carries no arguments of its
// own — and gir.Signal.Connectable is what holds every connection to
// that shape, since otherwise GTK would pass the signal's first real
// argument into `data` and snglGoDispatch would fire a wildly wrong
// callback. 155 of GTK's 400 signals qualify; the rest are neither
// declared nor connectable.
static void sngl_cb(gpointer instance, gpointer data) {
    (void)instance;
    snglGoDispatch(GPOINTER_TO_INT(data));
}
static void sngl_connect(void* widget, const char* signal, int idx) {
    g_signal_connect((gpointer)widget, signal, G_CALLBACK(sngl_cb), GINT_TO_POINTER(idx));
}

extern void snglIdleCallback(void* fn);
static gboolean sngl_idle_tramp(gpointer data) {
    snglIdleCallback(data);
    return G_SOURCE_REMOVE;
}
void sngl_gtk_idle_add(void* fn) {
    g_idle_add(sngl_idle_tramp, fn);
}

// Variadic wrapper — cgo cannot call `g_signal_emit_by_name` directly
// (the `...` in its prototype trips the cgo type checker). Used by
// per-id test invokers to fire signals with no extra args.
static void sngl_emit(gpointer instance, const char *signal) {
    g_signal_emit_by_name(instance, signal);
}

// Reactive-safe entry setter — GtkEditable's set_text fires "changed"
