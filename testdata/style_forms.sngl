component main {
    vbox(style={gap=4, padding=8}) {
        text(value="styled") {
            style {
                font-size = 24
                font-weight = "bold"
                color = #007700
            }
        }
        button(text="click", style={margin=4}) {
            style {
                padding = 8
                background = #ff0000
            }
        }
    }
}
