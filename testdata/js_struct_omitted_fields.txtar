What a JavaScript struct literal writes for a field it leaves out, and how
two colors compare.

Today neither is right. An absent property reads undefined, where Go and
Kotlin read the field's zero, so `p.y + 1` is NaN and `p.c.r` throws. And a
color is an object in JavaScript, where `===` is reference identity, so
`tint == #000000` is false for every pair, black included.

-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
}

struct P {
    x int
    y int
    w float = 1.5
    c color
}

var p P = {x=1}
var tint = #336699

ui.window {
    ui.button(text="go", @click {
        p = {x=2}
        tint = #000000
    })
    ui.text(value="{p.y + 1} {p.w} {p.c.r}")
    ui.text(value=tint == #000000 ? "black" : "tinted")
    ui.text(value=tint != p.c ? "apart" : "same")
}
