A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_dyn_param.sngl --
// An explicit `dyn` is an annotation: it says the prop takes anything, which
// is what `context(default dyn)` in sngl:builtin means. Only a prop with
// neither an annotation nor a default is unannotated -- see
// error_untyped_param.sngl for that.
import . "sngl:ui"

component Holder(value dyn) node {
    text(value="held")
}

component main node {
    Holder(value=1)
    Holder(value="two")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
