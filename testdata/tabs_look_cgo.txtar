gtk4's `ui.tabs` in cgo mode, which tabs_look.txtar draws in wrapped mode: the
`Tabs` and its pages are made and filled through gtk4rt in either, so the
page an `if` adds reaches the stack the same way.

deny out/go/gtk4/model.go `"GtkButton"` -- a tab is a page of the stack, which the switcher shows
deny out/go/gtk4/model.go `C\.gtk_box_remove\(` -- a page leaves the stack through gtk4rt, as it came

-- app.sngl --
import ui "sngl:ui"
import "sngl:test"

component strip ui.node {
    var idx = 0
    var changed = -1
    var extra = false

    ui.tabs #tabs(:selected=idx, style={padding=8px}, @change(i) {
        changed = i
    }) {
        ui.tab(label="One") {
            ui.text(value="first panel")
        }
        ui.tab(label="Off", disabled=true) {
            ui.text(value="second panel")
        }
        if extra {
            ui.tab(label="More") {
                ui.text(value="more panel")
            }
        }
    }
}

func testPressingATabSelectsIt(t test.Test, c strip) {
    c.extra = true
    c.tabs.change(2)
    t.assert(c.idx == 2)
    t.assert(c.changed == 2)
    c.idx = 0
    c.extra = false
    t.assert(c.changed == 2)
}

ui.window(title="t") {
    strip
}

output {
    go {
        gtk4(cgo=true)
    }
}
