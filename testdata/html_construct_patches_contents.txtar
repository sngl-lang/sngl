A primitive whose #[construct] prop reads state is rebuilt when that prop
changes and patched for everything else it reads: typing into an input inside
an element whose tag reads state, or writing the label inside a list whose
`ordered` does, hands the live instance the new value through its setter and
re-renders nothing. Before, each such write rebuilt the element, and the input
lost its focus at every keystroke.


A component instance under the patched content rebuilds itself where it stands
when its own #[construct] prop changes, and takes nothing else with it.

deny out/none/html/index.html `state\.name = e\.currentTarget\.value;\s+__renderSlot` -- typing patches the input rather than rebuilding the element
deny out/none/html/index.html `state\.label = state\.label \+ "x";\s+__renderSlot` -- a label write patches the list rather than rebuilding it
deny out/none/html/index.html `state\.k = state\.k \+ 1;\s+__renderSlot` -- a seed change rebuilds the seeded instance alone
-- app.sngl --
import ui "sngl:ui"
import markup "sngl:ui/markup"
import html "sngl:platform/html"
import macro "sngl:macro"

output {
    none { html }
}

var big = false
var name = ""
var numbered = false
var label = "a"
var k = 0

component seeded(#[macro.construct] start int) ui.node {
    var n = start

    ui.text(value="{n}")
}

ui.window(title="construct") {
    ui.button(text="big", @click { big = !big })
    html.element(tag=big ? "section" : "div") {
        ui.input(:value=name)
        ui.text(value=name)
    }
    ui.button(text="flip", @click { numbered = !numbered })
    ui.button(text="grow", @click { label = label + "x" })
    markup.list(ordered=numbered, start=4) {
        markup.listItem {
            markup.paragraph {
                markup.text(value=label)
            }
        }
    }
    ui.button(text="bump", @click { k = k + 1 })
    if big {
        ui.vbox {
            seeded(start=k)
            ui.input(:value=name)
        }
    }
}
