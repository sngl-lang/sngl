
A program's override of a library component, and its method on a library type,
are recorded on the program rather than on the library declarations a check
shares (ir.Overlay, ir.Scope.Added), and a build installs them on what it builds
from. So html renders the program's avatar and bubbletea, for which there is no
override, the library's own body; and both call the program's int.twice.

deny out/none/html/index.html `<img` -- html renders the program's avatar, not sngl:ui's image of one
-- app.sngl --
import "sngl:platform/html"
import ui "sngl:ui"

func int.twice(x int) => x * 2

component ui.avatar[html.platform](initials) {
    html.span(class="program-avatar", innerText=initials)
}

var n = 4

ui.window(title="t") {
    ui.vbox {
        ui.avatar(initials="AB")
        ui.text(value="{n.twice()}")
        ui.button(text="more", @click { n = n + 1 })
    }
}

output {
    none {
        html
    }
    go {
        bubbletea
    }
}
