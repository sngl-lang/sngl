sngl:ui/nav on a static site: html declares `navigation`, so passNavigation
does not lower the stack to an if-chain, and html answers a page itself. A
page is one document -- the whole window with every other page pruned, so the
window and what sits beside the stack are the shell each document repeats --
written at the page's href: `/` is index.html, `/about` about/index.html,
`/settings.html` settings.html.

`pages.current` folds per document, so the window's title and the label
beside the stack are each document's own constant, and `pages.current == home`
is decided per document as well.

A `nav.link` is an `<a href>`, which a crawler and a middle click follow. A
button stays a button, even the Home one whose handler does nothing but go:
an `<a>` around a `<button>` is not HTML a browser agrees on. Its handler
navigates with `location.assign`, after the rest of its body where it has one,
and `back` is the browser's history.

A page's content is under `if pages.current.id == <id>`, which is what a page
not showing is not mounted means: each document folds it for its own page,
and the step the about page's effect settles by -- a function of the owner's,
which no document's fold reaches -- asks the record the document publishes.

deny * `pages__current` -- no if-chain over the pages: html answers the stack, so passNavigation's var never exists
deny * `pages__history` -- the history is the browser's
deny * `__renderSlot` -- a page is a document, not a slot re-rendered as the stack moves
deny out/none/html/index.html `about body` -- the home document prunes every other page
deny out/none/html/index.html `settings body` -- and this one
deny out/none/html/about/index.html `home body` -- the about document holds the about page alone
deny out/none/html/about/index.html `settings body` -- and not the settings page either
deny out/none/html/settings.html `home body` -- the settings document holds its own page alone
deny out/none/html/settings.html `about body` -- and not the about page either
deny out/none/html/index.html `Docs - About` -- each document's title is its own page's
deny out/none/html/about/index.html `on the home page` -- `pages.current == home` folded false in the about document
deny * `pages\.go|nav\.go|stack\.current` -- every navigation call is answered: a href, a location.assign, or a folded record

-- site.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    none {
        html
    }
}

struct Meta {
    label string
}

var visits = 0

ui.window #main(title="Docs - {pages.current.title}") {
    ui.vbox {
        nav.stack #pages {
            nav.page #home(href="/", title="Home", meta=Meta{label="home"}) {
                ui.text(value="home body")
            }
            nav.page #about(href="/about", title="About", meta=Meta{label="about"}) {
                ui.text(value="about body")
                effect(@mount {
                    visits += 1
                })
            }
            nav.page #settings(href="/settings.html", title="Settings", meta=Meta{label="settings"}) {
                ui.text(value="settings body")
            }
        }
        ui.text(value="label: {pages.current.meta.label}")
        if pages.current == home {
            ui.text(value="on the home page")
        }
        nav.link(to=about, text="About")
        ui.button(text="Home", @click {
            pages.go(home)
        })
        ui.button(text="Settings", @click {
            visits += 1
            pages.go(settings)
        })
        ui.button(text="Back", @click {
            pages.back()
        })
        ui.text(value="visits {visits}")
    }
}
