A prop reading records whose handler writes what the prop reads: the summary
here is drawn from `items`, and each record's `@select` writes `language`,
which the records' `checked` reads. The summary's update holds the handler and
the handler holds the update, so passReactivity writes the update once, as a
function of the component the handler calls, rather than splicing a copy of
the prop's expression into the handler that expression holds -- which made the
IR a cycle the next walk over it (`MatchLate`) followed until the stack ran
out. cmd/sngl/testdata/record_handler_prop_runs.txt runs it.

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
        html
    }
    kotlin {
        android
    }
    none {
        html
    }
}

const languages = ["en", "fr", "de"]

component picker(items ...component ui.menuItem) ui.node {
    ui.vbox {
        ui.text #summary(value=items.map(func(it) => it.checked ? "[{it.label}]" : it.label).join(" "))
        for var it = items {
            ui.button #pick(text=it.label, @click {
                it.select()
            })
        }
    }
}

component app root {
    var language = "en"

    ui.window(title="Languages") {
        picker #p {
            for var l = languages {
                ui.menuItem(label=l, checked=l == language, @select {
                    language = l
                })
            }
        }
    }
}

app()
