android's select keeps whether its menu is open in a var of its override,
which makes the var a cell of each select: spliced into the screen for one
written once, and the composable each copy is built as under a `for` or a
reactive `if` remembers its own.

A select built at run time is the override's body emitted as a composable of
the library declaration, which a call site reaching it with props omitted
hands only what it wrote, so the declaration's defaults are the composable's.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `expanded\d` -- the cell is the override's var, not a name the emitter numbers
-- app.sngl --
import ui "sngl:ui"

var rows = ["a", "b"]
var picks = ["", ""]
var shown = true
var one = ""

ui.window {
    ui.vbox {
        ui.select(:value=one) {
            ui.choice(label="x")
        }
        for var i, r = rows {
            ui.select(placeholder=r, @change(v) { picks[i] = v }) {
                ui.choice(label="x")
                ui.choice(label="y")
            }
        }
        if shown {
            ui.select(:value=one) {
                ui.choice(label="z")
            }
        }
        ui.button(text="t", @click { shown = !shown })
    }
}

output {
    kotlin {
        android
    }
}
