A context read handed to two lifted slot bodies reaches each as its own value.

The context lowering seeds a component body with one read of its hidden
`__ctx_label` var and handed that same node to every component call in the body
as the hidden argument. passSlotChildInstances lifts each `ui.vbox` below into
a component of its own and repoints every read it lifts at the new prop, in
place -- so lifting the first vbox renamed the second's argument too, and the
second was built with `__p0`, a name only the first declares, and go build
refused it on fyne.

-- main.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
}

context #label("a")

component show(n int) ui.node {
    var k = 0

    ui.button(text="{label} {n} {k}", @click { k = k + 1 })
}

component page() ui.node {
    var on = true

    ui.vbox {
        ui.button(text="flip", @click { on = !on })
        if on {
            ui.vbox {
                show(n=1)
            }
            ui.vbox {
                show(n=2)
            }
        }
    }
}

ui.window #home(title="t") {
    var txt = "b"
    var xs = [1]

    ui.vbox {
        ui.button(text="flip", @click { txt = "c" })
        label(txt) {
            for var x = xs {
                page()
            }
        }
    }
}
