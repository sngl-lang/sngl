component pricing {
    var price = 100
    var quantity = 2
    func total() => price * quantity

    text(value="{total}")
}

func testComputedValue(t T, c pricing) {
    t.assert(c.total == 200)
}

func testComputedUpdatesWithVar(t T, c pricing) {
    c.price = 50
    t.assert(c.total == 100)
    c.quantity = 5
    t.assert(c.total == 250)
}
