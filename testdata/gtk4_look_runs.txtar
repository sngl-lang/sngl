A box gtk4's runtime lays out, in both languages, as GTK places what it
holds: rows whose children grow by unequal flex and whose content is
justified each way, a column sharing its height, and grids of two columns
and flowing. The program prints each laid-out widget's layout manager, its
position and size in the window, and, for each box, its children's. It
widens the window between prints, so each layout is asked again.

exec out/c/gtk4 -- said.txt
exec out/go/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"

c.link(include="peek.h", pkgConfig=["gtk4"], sources=["peek.c", "peek.h"])

#[c.native("peek")]
func peek(n ui.window)

c.link(include="stdio.h", system=true)

#[c.native("puts")]
#[go.native("fmt", "fmt.Println")]
func say(s string)

output {
    c { gtk4 }
    go { gtk4 }
}

var (
    ticks = 0
    wide = false
    late = false
)

time.timer(interval=100ms, @tick {
    ticks += 1
    if ticks == 3 {
        say("narrow")
        peek(main)
        wide = true
        late = true
    }
    if ticks == 6 {
        say("wide")
        peek(main)
        gtk4.quit()
    }
})

component tile(w int) ui.node {
    ui.vbox(style={width=w * 1px, height=10px}) {}
}

component justified(how ui.Justification) ui.node {
    ui.hbox(style={width=300px, height=10px, gap=10px, justifyContent=how}) {
        tile(w=40)
        tile(w=30)
        if late {
            tile(w=20)
        }
    }
}

ui.window #main(title="t") {
    ui.vbox(style={gap=4px}) {
        justified(how=ui.Justification.start)
        justified(how=ui.Justification.center)
        justified(how=ui.Justification.end)
        justified(how=ui.Justification.spaceBetween)
        justified(how=ui.Justification.spaceAround)
        justified(how=ui.Justification.spaceEvenly)
        ui.hbox(style={width=wide ? 413px : 211px, height=10px, gap=5px}) {
            ui.vbox(style={flex=1.0, height=10px}) {}
            ui.vbox(style={flex=3.0, height=10px}) {}
            ui.text(value="words", style={flex=2.0})
        }
        ui.vbox(style={height=200px}) {
            ui.vbox(style={flex=1.0, width=10px}) {}
            ui.text(value="between")
            ui.vbox(style={flex=2.0, width=10px}) {}
        }
        ui.grid(columns=2, style={gap=3px, width=wide ? 300px : 150px}) {
            tile(w=20)
            tile(w=50)
            ui.text(value="a longer cell")
        }
        ui.grid(style={gap=2px, width=wide ? 200px : 90px}) {
            tile(w=40)
            tile(w=30)
            tile(w=50)
            ui.text(value="flow")
        }
    }
}
-- peek.c --
#include "peek.h"

#include <stdio.h>
#include <string.h>

static void walk(GtkWidget *w, GtkWidget *root, int depth) {
    for (GtkWidget *c = gtk_widget_get_first_child(w); c != NULL; c = gtk_widget_get_next_sibling(c)) {
        if (!gtk_widget_get_visible(c)) continue;
        graphene_rect_t b;
        if (!gtk_widget_compute_bounds(c, root, &b)) continue;
        GtkLayoutManager *m = gtk_widget_get_layout_manager(c);
        printf("%*s%s %s %g,%g %gx%g\n", depth * 2, "", G_OBJECT_TYPE_NAME(c), m ? G_OBJECT_TYPE_NAME(m) : "-",
               b.origin.x, b.origin.y, b.size.width, b.size.height);
        walk(c, root, depth + 1);
    }
}

void peek(GtkWidget *box) {
    walk(box, box, 0);
    fflush(stdout);
}
-- peek.h --
#include <gtk/gtk.h>

// Prints each widget the toplevel box holds, its layout manager and where
// it is in the box.
void peek(GtkWidget *box);
