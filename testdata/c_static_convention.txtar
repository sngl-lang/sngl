A static callback C calls with a calling convention other than the
platform's default, as Win32 calls a window procedure `CALLBACK`
(`__stdcall` on 32-bit x86). cgo exports only the default convention, so
the function C is handed is a static C function of the callbacks' preamble
carrying the one `#[c.static(convention=…)]` names, which calls the export;
a function answering it hands Go its pointer, since a static function has
no symbol cgo could take the address of. TEST_CC is x86-64's Microsoft
convention, which a Linux compiler calls with only where it is written: the
export called directly would read its arguments from the wrong registers.
A parameter or result written with an alias crosses as its C type, so a
`long long` crosses whole.

The test runs it: 7 * 1000 + 5000000000 + 2, measure wrote 4 alone and then
5 and 10, and 21 doubled.

-- app.sngl --
import ui "sngl:ui"
import c "sngl:x/c"
import go "sngl:language/go"
import test "sngl:test"

output {
    go {
        bubbletea
    }
}

c.link(include="calls.h", sources=["calls.c", "calls.h"])

#[c.native("test_count")]
struct Count = int

#[c.native("test_wide")]
struct Wide = int

struct Size {
    minimum int
    natural int
}

#[c.native("test_tick")]
func tick(#[c.type("test_tick_fn")] #[c.static(convention="TEST_CC")] f func(id Count, when Wide, name string) Wide) Wide

#[c.native("test_measure")]
func measure(#[c.type("test_measure_fn")] #[c.static(convention="TEST_CC")] #[c.outs] f func(forSize int) Size) int

#[c.native("test_plain")]
func plain(#[c.static(convention="TEST_CC")] f func(n int) int) int

func ticked(id int, when int, name string) => id * 1000 + when + name.length()

func sized(forSize int) => Size{minimum=forSize, natural=forSize * 2}

func doubled(n int) => n * 2

component main ui.node {
    var ticks = 0
    var sizes = 0
    var plains = 0
    ui.button #go(text="{ticks}", @click {
        ticks = tick(ticked)
        sizes = measure(sized)
        plains = plain(doubled)
    })
}

ui.window(title="t") {
    main()
}

func testConventionCallbacks(t test.Test, c main) {
    c.go.click()
    t.assert(c.ticks == 5000007002)
    t.assert(c.sizes == 460)
    t.assert(c.plains == 42)
}
-- calls.h --
// x86-64's Microsoft convention, which a Linux compiler calls with only
// where it is written.
#define TEST_CC __attribute__((ms_abi))

typedef unsigned test_count;
typedef long long test_wide;

typedef test_wide (TEST_CC *test_tick_fn)(test_count, test_wide, const char *);
typedef void (TEST_CC *test_measure_fn)(int, int *, int *);

// What f answers for 7, 5000000000 and "ab".
test_wide test_tick(test_tick_fn f);

// What f wrote: its minimum alone for 4, the natural's pointer NULL, then
// both for 5.
int test_measure(test_measure_fn f);

// What f answers for 21.
int test_plain(int (TEST_CC *f)(int));
-- calls.c --
#include <stddef.h>

#include "calls.h"

test_wide test_tick(test_tick_fn f) {
	return f(7, 5000000000LL, "ab");
}

int test_measure(test_measure_fn f) {
	int min = 0, nat = 0, only = 0;
	f(4, &only, NULL);
	f(5, &min, &nat);
	return only * 100 + min * 10 + nat;
}

int test_plain(int (TEST_CC *f)(int)) {
	return f(21);
}
