A ui.Style on gtk4 in the inline cgo mode a canvas puts a build in.
-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"

output {
    go {
        gtk4
    }
}

var tone = #336699

ui.window(title="Style") {
    ui.vbox(style={gap=12px, alignItems=ui.Alignment.end}) {
        ui.text(value="literal", style={color=#336699, padding=4px, background=#eeeeee})
        ui.button(text="recolor", style={color=tone, flex=1.0}, @click {
            tone = #993366
        })
        draw.canvas(width=40px, height=40px) {
            draw.circle(cx=20.0, cy=20.0, r=10.0)
        }
    }
}
