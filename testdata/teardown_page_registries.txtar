The exit handler a platform calls, `__snglTeardown`, was written by the effect
pass only where a page effect had a teardown, and emptied no registry: a page
whose every lifetime sat inside an instance it holds -- here `page`, under the
window's `if`, holding the picture its source decoded -- had no handler at all,
so nothing destroyed the instance at exit and the picture was held until the
process ended. The reactivity pass now gives the page the handler the instances
get, emptying the page's registries newest first ahead of any effect teardown,
and every target's main calls it (the ASan check in design/ownership.md found
the pokedex holding its pages this way).

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
        fyne
        bubbletea
    }
}

component page ui.node {
    var src = "a.png"

    ui.vbox {
        ui.image {
            ui.file(src)
        }
    }
}

var shown = true

ui.window(title="t") {
    ui.vbox {
        if shown {
            page
        }
        ui.button(text="flip", @click {
            shown = !shown
        })
    }
}
