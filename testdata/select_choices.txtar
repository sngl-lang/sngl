A select's choices are written as its children: `choice` names itself as its
family, so it is data, and every target is handed the choices as the list of
labels its widget takes -- a choice written once, and one per element of a
list the program replaces, which reaches the widget again when it changes.

The population is read by lower.DataFamilies before the first optimize, into
the select's `options` prop; the overrides map the records to their labels.

deny * `__list\d+` -- a prop's map is an expression, not a hoisted accumulator
-- app.sngl --
import ui "sngl:ui"

var fruits = ["Apple", "Banana"]
var pick = "Apple"

ui.window {
    ui.vbox {
        ui.select(:value=pick, placeholder="Pick") {
            ui.choice(label="None")
            for var f = fruits {
                ui.choice(label=f)
            }
        }
        ui.button(text="more", @click {
            fruits = ["Apple", "Banana", "Cherry"]
        })
    }
}

output {
    go {
        bubbletea
        fyne
    }
    none {
        html
    }
    kotlin {
        android
    }
}
