A constant loop on html is unrolled into the page, a copy of its body per
iteration, and a node in it carrying an `#id` is written once per copy under
that one id. Each copy is an element of its own, with its own variable: they
used to share the first copy's, so the second button was declared with the
first's DOM id and both listeners -- each holding its own copy's value -- went
onto the first button, while the second did nothing.

deny out/none/html/index.html `id="\$0"[\s\S]*id="\$0"` -- each copy is an element of its own
-- app.sngl --
import ui "sngl:ui"
import . "sngl:test"

component app ui.node {
    var last = ""
    for var x = ["a", "b"] {
        ui.button #opt(text=x, @click {
            last = x
        })
    }
}

func testSecond(t Test, c app) {
    c.opt[1].click()
    t.assert(c.last == "b")
}

ui.window {
    app
}

output {
    none {
        html
    }
}
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

