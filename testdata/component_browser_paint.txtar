    <img id="$7" alt=""/>
  </span>
  <span class="sngl-image sngl-image-contain" style="display:inline-block;overflow:hidden" aria-label="remote" role="img" class="sngl-image sngl-image-contain" data-sngl-id="remote">
    <img id="__n1" data-sngl-id="__n1" alt=""/>
