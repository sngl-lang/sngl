A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_browser_paint.sngl --
// What the browser made of a page's lengths and pictures: the CSS a
// measurement resolved to, and the pixels a drawing and an image source paint,
// read where the browser computed them.

import "sngl:test/browser"
import . "sngl:test"
import ui "sngl:ui"
import draw "sngl:ui/draw"

// A measurement's bases reach CSS by name and sum in calc().
component lengths ui.node {
    ui.vbox #box(style={width=2rem, padding=3px + 4px, gap=1rem + 2em}) {
        ui.text(value="x")
    }
}

func testMeasurementsAreCSSLengths(t Test, c lengths) {
    t.assert(browser.style(c.box, "width") == "32px")
    t.assert(browser.style(c.box, "padding-top") == "7px")
    t.assert(browser.style(c.box, "row-gap") == "48px")
}

component dot(r float) ui.node {
    ui.image(alt="dot") {
        draw.image(width=20.0, height=20.0) {
            draw.rect(x=0.0, y=0.0, w=r, h=20.0, style={fill=#ff0000})
        }
    }
}

func red(p color) bool {
    return p.a > 200 && p.r > 200 && p.g < 50
}

// A drawn source repaints when what it reads moves, a remote one follows its
// url, and an avatar with no source shows its placeholder.
component sources ui.node {
    var w = 5.0
    var url = "/a.png"
    ui.vbox {
        dot #d(r=w)
        ui.image #remote(alt="remote") {
            ui.remote(url=url)
        }
        // On html an avatar's own #id is lost: its override's root is an
        // `if`, which no id attaches to. The box around it carries one.
        ui.vbox #avatar {
            ui.avatar(initials="JD")
        }
        ui.button #grow(text="grow", @click {
            w = w + 5.0
            url = "/b.png"
        })
    }
}

func testImageSourcesPaint(t Test, c sources) {
    t.wait(func() => red(browser.pixel(c.d, 4, 10)), 2000)
    t.assert(red(browser.pixel(c.d, 4, 10)))
    t.assert(!red(browser.pixel(c.d, 5, 10)))
    t.assert(browser.markup(c.remote).indexOf("src=\"/a.png\"") >= 0)
    t.assert(browser.text(c.avatar) == "JD")
    t.assert(browser.markup(c.avatar).indexOf("<img") < 0)
    c.grow.click()
    t.wait(func() => red(browser.pixel(c.d, 9, 10)), 2000)
    t.assert(red(browser.pixel(c.d, 9, 10)))
    t.assert(!red(browser.pixel(c.d, 10, 10)))
    t.assert(browser.markup(c.remote).indexOf("src=\"/b.png\"") >= 0)
}

ui.window {
    lengths
    sources
}

output {
    none {
        html
    }
}
-- out/none/html/index.html --
