-- component_chip.sngl --
import . "sngl:ui"

// chip: A-tier — declaration + label binding.
component main node {
    hbox {
        chip(label="Tag")
        chip(label="Removable", removable=true)
        chip(label="Success", variant="success")
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
