import . "sngl://std"

struct Point {
    x float = 0.0
    y float = 0.0
}

enum Status { active, inactive, pending }

component main {
    const (
        MAX = 100
        LABEL = "items"
        DERIVED = MAX + 1
        GREETING = "hello" + " " + "world"
        NEG_VAL = -MAX
        IS_VALID = true && !false
        TERNARY_CONST = true ? 1 : 2
        CONVERTED = string(42)
        METHOD_CONST = "hello".length()
        NS_METHOD = int.abs(-5)
    )

    var count = 0
    var label = "test"
    var flag = true
    var ratio float = 1.5
    var items = [1, 2, 3]
    var pt Point = {x = 1.0, y = 2.0}
    var status Status = active

    func total() => count + MAX
    func desc() => label + ": " + string(count)
    func neg() => -count
    func isActive() => flag && count > 0
    func selected() => flag ? "yes" : "no"
    func floatCalc() => float(count) + ratio
    func methodResult() => "hello".length()
    func nsMethod() => int.abs(count)

    vbox {
        for item, i = items {
            text(value=string(item), key=string(i))
        }
        if flag {
            text(value=string(total), style={color = #ff0000, padding = 8})
        }
        text(value=desc)
    }
}
