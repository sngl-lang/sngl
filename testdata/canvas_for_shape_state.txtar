-- out/go/fyne/model_test.go --
package main

import "testing"

func TestMadeOncePerCopy(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.opened == 2)) { t.Errorf("assert failed: %s", "(c.opened == 2)") }
	if !((c.closed == 0)) { t.Errorf("assert failed: %s", "(c.closed == 0)") }
}

func TestRekeyedCopyReleasesItsOldValue(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.ws = []float64{3.0, 2.0}
	c.__effect2_rekey_mark()
	c.__effects0_settle()
	if !((c.opened == 3)) { t.Errorf("assert failed: %s", "(c.opened == 3)") }
	if !((c.closed == 1)) { t.Errorf("assert failed: %s", "(c.closed == 1)") }
	if !((c.lastClosed == 1)) { t.Errorf("assert failed: %s", "(c.lastClosed == 1)") }
}

func TestLeavingCopyReleases(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.ws = []float64{1.0}
	c.__effect2_rekey_mark()
	c.__effects0_settle()
	if !((c.closed == 1)) { t.Errorf("assert failed: %s", "(c.closed == 1)") }
	if !((c.lastClosed == 2)) { t.Errorf("assert failed: %s", "(c.lastClosed == 2)") }
}

