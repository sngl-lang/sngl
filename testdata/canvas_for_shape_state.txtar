A shape with state of its own under a `for` in a canvas keeps it per copy on
every target. A drawing is spliced into its canvas's draw routine, so a copy
of a shape cannot be built at run time the way a copy of a widget is; a target
that keeps instance state left the shape to that, and its effect's `@update`
then read the loop variable from a method that never bound it ("reads the loop
variable"). The shape is spliced per copy instead, its cells keyed by the copy
as bubbletea already did for every component under a `for`.

deny * `close\(load\(` -- a derived value read is a read of its var

-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"
import macro "sngl:macro"
import "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
}

#[macro.owned(close)]
struct pic {
    n int
}

var opened = 0
var closed = 0
var lastClosed = 0

func close(p pic) {
    closed += 1
    lastClosed = p.n
}

func load(n int) pic {
    opened += 1
    return pic{n=n}
}

component framed(w float) draw.shape {
    func p() => load(int(w))

    draw.rect(x=0.0, y=0.0, w=float(p.n), h=w)
}

component page ui.node {
    var ws = [1.0, 2.0]

    draw.canvas(width=200px, height=40px) {
        for var k = ws {
            framed(w=k)
        }
    }
}

func testMadeOncePerCopy(t test.Test, c page) {
    t.assert(opened == 2)
    t.assert(closed == 0)
}

func testRekeyedCopyReleasesItsOldValue(t test.Test, c page) {
    c.ws = [3.0, 2.0]
    t.assert(opened == 3)
    t.assert(closed == 1)
    t.assert(lastClosed == 1)
}

func testLeavingCopyReleases(t test.Test, c page) {
    c.ws = [1.0]
    t.assert(closed == 1)
    t.assert(lastClosed == 2)
}

ui.window(title="t") {
    page
}
