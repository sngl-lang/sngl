An owned var assigned what a blocking call answers is overwritten when the
answer arrives: the old value is bound beside the write, in the posted half,
so each call in flight releases the value it replaced. Bound ahead of the
goroutine, two clicks in flight both read the value before the first and
released it twice, and the first answer was never released.

deny out/go/fyne/model.go `__old\d+ := [^\n]*\n\s*(?:var __async_arg|go func)` -- the old value is read at the write, after the wait

-- app.sngl --
import go "sngl:language/go"
import macro "sngl:macro"
import ui "sngl:ui"

output {
    go {
        fyne
    }
}

#[macro.owned(close)]
struct file {
    fd int
}

func close(f file) {
}

#[go.native("time", "time.Sleep")]
#[go.async]
func sleep(ns int)

func fetchFile(n int) file {
    sleep(1000)
    return file{fd=n}
}

component editor ui.node {
    var n = 1
    var f = file{fd=0}

    ui.button(text="open", @click {
        f = fetchFile(n)
    })
    ui.text(value="{f.fd}")
}

ui.window {
    editor()
}
