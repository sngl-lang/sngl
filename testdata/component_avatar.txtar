A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_avatar.sngl --
import . "sngl:ui"

// avatar: A-tier — declaration + source/initials fallback.
component main node {
    hbox {
        avatar(initials="JD")
        avatar(initials="AB", variant=square) {
            component src {
                remote(url="https://example.com/a.png")
            }
        }
        avatar(initials="XY", size=large)
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
