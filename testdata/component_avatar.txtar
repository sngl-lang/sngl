)

// Model holds the state for this SNGL UI.
type Model struct {
	__n0 *fyne.Container
	__n1 *widget.Label
	__n2 *widget.Label
	__n3 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = container.NewHBox()
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText("JD")
	m.__n0.Add(m.__n1)
	m.__n2 = widget.NewLabel("")
	m.__n2.SetText("AB")
	m.__n0.Add(m.__n2)
	m.__n3 = widget.NewLabel("")
	m.__n3.SetText("XY")
	m.__n0.Add(m.__n3)
	content := fyne.CanvasObject(m.__n0)
	return content
}
