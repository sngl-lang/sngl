component counter {
    var count = 0
    var name = "hello"

    button(text="+", @click { count += 1 })
    text(value="Count: {count}")
}

func testStartsAtZero(t Test, c counter) {
    t.assert(c.count == 0)
}

func testIncrements(t Test, c counter) {
    t.assert(c.count == 0)
    c.count += 1
    t.assert(c.count == 1)
    t.test("multiple increments", func(t, c) {
    c.count += 5
    t.assert(c.count == 6)
})
}

func testStartsFreshEachTest(t Test, c counter) {
    t.assert(c.count == 0)
    t.assert(c.name == "hello")
}
