// The other direction of error_anon_struct_nominal.sngl: a declared struct is
// not the anonymous one that spells the same fields either. Nominal identity
// is symmetric, and interning does not make an anonymous struct the structural
// type every matching declaration converts to.

import . "sngl:ui"
import app "sngl:app"

struct Point {
    x int = 0
    y int = 0
}

func takeAnon(p struct {
    x int
    y int
}) => p.x + p.y

component main node {
    var named Point = {x=1, y=2}
    var b = takeAnon(named) // ERROR(check) "cannot pass Point as struct { x int, y int }"

    text(value=string(b))
}

app.window {
    main
}
