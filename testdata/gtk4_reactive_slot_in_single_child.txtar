A reactive `if` directly inside a card or a scroll renders on gtk4.

A slot renders into a GtkBox, so one directly inside a single-child container
renders into a box that is that container's child. gtk4 once did that only
for a GtkScrolledWindow and refused a GtkFrame with "wrap it in a vbox". The
runtime's `sngl_box_append` now asks `sngl_slot_host` for the box, which it
makes the container's child the first time, for a frame and a scroll alike.

deny out/go/gtk4/main.go `C\.gtk_frame` -- the frame is made through the generated wrappers (`cgo.GtkFrameNew`), not raw C
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
        gtk4
    }
}

component main node {
    var on = true

    vbox {
        card {
            if on {
                text(value="carded")
            }
        }
        scroll {
            if on {
                text(value="scrolled")
            }
        }
        button #flip(text="flip", @click { on = !on })
    }
}

func testFlip(t Test, c main) {
    c.flip.click()
    c.flip.click()
    t.assert(c.on)
}

window {
    main
}
