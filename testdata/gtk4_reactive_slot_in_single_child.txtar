A reactive `if` directly inside a card or a scroll renders on gtk4.

A slot renders into a GtkBox, so one directly inside a single-child container
renders into a box that is that container's child. Only the wrapped path did
that, and only for a GtkScrolledWindow: a GtkFrame had no gtk4rt constructor
or setter, which dropped the whole file to cgo, and the cgo path refused both
with "wrap it in a vbox". gtk4rt now wraps the frame, and the cgo path builds
the box through a preamble helper (gtk4.TestCgoSlotReRendersInPlace runs it).

deny out/go/gtk4/model.go `C\.gtk_frame` -- the frame is wrapped, so the file stays off cgo
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
        gtk4
    }
}

component main node {
    var on = true

    vbox {
        card {
            if on {
                text(value="carded")
            }
        }
        scroll {
            if on {
                text(value="scrolled")
            }
        }
        button #flip(text="flip", @click { on = !on })
    }
}

func testFlip(t Test, c main) {
    c.flip.click()
    c.flip.click()
    t.assert(c.on)
}

window {
    main
}
