      let __n0 = document.createElement("li");
      __n0.textContent = r;
      __n0.addEventListener("mouseover", () => {
        state.hits = state.hits + 1;
      });
      parent.appendChild(__n0);
      __slot0.push(__n0);
    }
  }
  var __slotAnchor_0 = document.querySelector('[data-sngl-slot="0"]');
  __renderSlot0(__slotAnchor_0);
  var $0 = document.getElementById("$0");
  var $1 = document.getElementById("$1");
  var $2 = document.getElementById("$2");
  var $3 = document.getElementById("$3");
  $0.addEventListener("error", function(e) {
