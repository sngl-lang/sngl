A whole-program test build whose second tested component writes a `#s` that a
test null-tests, beside a first one's instance of a component with a function
that raises: only the node the test names is the test's. The other
component's instance stays spliced, so its raise resolves to the boundary
around it.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
    }
    none {
        html
    }
}

component thrower(label string) node {
    func check() {
        if label == "x" {
            error.raise("empty", "validation")
        }
    }
    button(text=label, @click { check() })
}

component other node {
    var shown = false
    vbox {
        button #t(text="t", @click { shown = true })
        if shown {
            text #s(value="q")
        }
    }
}

component main node {
    var problem = "none"
    boundary(@error(e) {
        problem = e.message
    }) {
        thrower #q(label="x")
        other()
    }
}

func testOther(t Test, c other) {
    t.assert(c.s == null)
    c.t.click()
    t.assert(c.s != null)
}

func testMain(t Test, c main) {
    t.assert(c.problem == "none")
}

window {
    main
}
