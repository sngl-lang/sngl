package main

import "testing"

func TestOther(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(!c.sPresent()) { t.Errorf("assert failed: %s", "!c.sPresent()") }
	c.tClick()
	if !(c.sPresent()) { t.Errorf("assert failed: %s", "c.sPresent()") }
}

func TestMain(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.problem__inst0 == "none")) { t.Errorf("assert failed: %s", "(c.problem__inst0 == \"none\")") }
}

