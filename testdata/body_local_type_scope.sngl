import . "sngl:ui"

// A struct written in a component body is scoped to that body.
component bodyLocalStruct {
    struct Local {
        a int
    }

    var here = Local{a=1}

    text(value="${here.a}")
}

// The same in a function body, where the declaration is a statement. The
// field is deliberately not the one the component's Local carries: hoisting
// either declaration to file scope makes the other's literal name a field
// that declaration does not have.
func bodyLocalInFunc() int {
    struct Local {
        b int
    }

    var v = Local{b=2}
    return v.b
}

component main {
    bodyLocalStruct()
    text(value="${bodyLocalInFunc()}")
}
