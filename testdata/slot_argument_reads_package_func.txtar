A slot inserted with an argument that calls a package func nothing else
calls, inside a recursion, on every target.

`frame` inserts `label(twice(n))`. The call is the insertion's argument and
nothing else in the program names `twice`, so the shake reaches the func only
through `SlotInst.Args` -- and walking an insertion's children and not its
arguments dropped the declaration: `undefined: twice` on bubbletea, whose
render method is where the call is written.

The run records are the assertion: every target builds.

-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

func twice(n int) => n * 2

component frame(n int, label component(depth int) node) node {
    vbox {
        label(twice(n))
        if n > 0 {
            frame(n=n - 1) {
                component label(d) {
                    label(d)
                }
            }
        }
    }
}

window {
    var depth = 2

    vbox {
        frame(n=depth) {
            component label(d) {
                text(value="level {d}")
            }
        }
    }
}
