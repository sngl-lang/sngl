One window names another by id: `home.href` in the about page folds to the `/`
the home window declares, and `/` is the path the static site writes as
index.html. The reference is resolved at build time -- the golden's
`<a href="/">` is a literal.

-- site.sngl --
import . "sngl:ui"
import "sngl:platform/html"

output { none { html } }

window #home(title="Home", href="/") { text(value="home") }

window #about(title="About", href="/about.html") {
    html.a(href=home.href, innerText="Home")
}
-- out/none/html/about.html --
<!-- Code generated by sngl (html) from site.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>About</title>
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<a href="/">Home</a>

<script>
(() => {
  // sngl-entry.js
  var state = {};
})();
</script>
</body></html>
