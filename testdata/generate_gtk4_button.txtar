End-to-end gtk4 platform compile test, run against the bundled GIR
(gir="builtin") so it does not need system GTK4 development files. The
fixture's widgets descend from a Widget base class because that is where real
GIR declares visible/sensitive/hexpand/tooltip-text and where the stdlib
override bodies in lib/platforms/gtk4/gtk4.sngl are written against them -- so
this also checks that the parent-chain merge reaches them.

model.go is cgo: a `#include <gtk/gtk.h>` preamble and `import "C"`. Each
prop's setter is the C function the GIR names and each enum value is the
member's own C identifier (gtk_orientable_set_orientation with
C.GTK_ORIENTATION_VERTICAL, gtk_button_set_label), and constructors --
gtk_box_new, gtk_application_window_new, gtk_button_new -- come from the GIR
rather than from the class name. GtkImage.file is a property real GIR names no
setter for, so the platform carries a table of its own, and that table wins
where both name one.

tooltip-text and sensitive are declared only on Widget and reach GtkBox and
GtkButton down the parent chain. Their setters take a GtkWidget*, so the cast
is to the ancestor that declares the property and not to the widget's own
class -- cgo rejects a GtkBox* where a GtkWidget* is wanted. The GTK
entrypoint lands in callbacks.go as snglActivate, the //export'd activate
handler hooked to the GApplication.

deny out/go/gtk4/model.go `gtk_label_set_label` -- the platform's own setter table wins over the GIR name, so a label's text goes through gtk_label_set_text
deny out/go/gtk4/model.go `gtk_button_new_with_label` -- the GIR names gtk_button_new as the constructor; with_label is a separate one the emitter must not reach for
broken out/go/gtk4 -- `undefined: app`, and a GtkApplicationWindow is passed where gtk_window_set_child wants a GtkWindow
-- main.sngl --
import . "sngl:test"
import "sngl:platform/gtk4"
import ui "sngl:ui"

output {
    go {
        gtk4(gir="builtin", main=true)
    }
}

component main ui.node {
    var count int

    gtk4.GtkApplicationWindow(title="Test") {
        gtk4.GtkBox(orientation="vertical", tooltipText="a box") {
            gtk4.GtkLabel(label="hello") {}
            gtk4.GtkButton(label="click me", sensitive=true, @clicked { count = count + 1 }) {}
        }
    }
}

ui.window {
    main
}
-- out/go/gtk4/callbacks.go --
// Code generated by sngl (gtk4) from main.sngl; DO NOT EDIT.

package main

/*
#include <gtk/gtk.h>

extern void sngl_gtk_idle_add(void* fn);
extern void snglActivate(GtkApplication* app, gpointer data);
*/
import "C"

import (
	"fmt"
	"os"
	"runtime"
	"unsafe"
)

// snglCallbacks holds registered Go signal handlers indexed by int.
var snglCallbacks []func()

// The index arrives as GTK's user_data pointer round-tripped through
// GPOINTER_TO_INT, so a stray pointer lands here as an arbitrary int —
// negative included. Bound it on both sides. (//export must sit directly
// above the declaration, so this note goes above it.)
//
//export snglGoDispatch
func snglGoDispatch(idx C.int) {
	if idx >= 0 && int(idx) < len(snglCallbacks) {
		snglCallbacks[int(idx)]()
	}
}

//export snglIdleCallback
func snglIdleCallback(ptr unsafe.Pointer) {
	fn := *(*func())(ptr)
	fn()
}

func gtkPost(fn func()) {
	f := fn
	C.sngl_gtk_idle_add(unsafe.Pointer(&f))
}

//export snglActivate
func snglActivate(app *C.GtkApplication, _ C.gpointer) {
	m := New()
	win := m.BuildUI(app)
	C.gtk_window_present((*C.GtkWindow)(unsafe.Pointer(win)))
}

func main() {
	runtime.LockOSThread()
	app := C.gtk_application_new(nil, C.G_APPLICATION_NON_UNIQUE)
	C.g_signal_connect_data((C.gpointer)(unsafe.Pointer(app)),
		C.CString("activate"),
		C.GCallback(C.snglActivate), nil, nil, 0)
	status := C.g_application_run((*C.GApplication)(unsafe.Pointer(app)), 0, nil)
	if status != 0 {
		fmt.Fprintf(os.Stderr, "gtk: application exited with status %d\n", status)
		os.Exit(int(status))
	}
}
-- out/go/gtk4/model.go --
// Code generated by sngl (gtk4) from main.sngl; DO NOT EDIT.

package main

/*
#cgo pkg-config: gtk4
#include <gtk/gtk.h>
#include <stdlib.h>

extern void snglGoDispatch(int idx);
// g_signal_connect callbacks are invoked with the signal's signature
// (self, ...args, user_data). This one is (instance, user_data), which
// is the signature of a void signal that carries no arguments of its
// own — and gir.Signal.Connectable is what holds every connection to
// that shape, since otherwise GTK would pass the signal's first real
// argument into `data` and snglGoDispatch would fire a wildly wrong
// callback. 155 of GTK's 400 signals qualify; the rest are neither
// declared nor connectable.
static void sngl_cb(gpointer instance, gpointer data) {
    (void)instance;
    snglGoDispatch(GPOINTER_TO_INT(data));
}
static void sngl_connect(void* widget, const char* signal, int idx) {
    g_signal_connect((gpointer)widget, signal, G_CALLBACK(sngl_cb), GINT_TO_POINTER(idx));
}

extern void snglIdleCallback(void* fn);
static gboolean sngl_idle_tramp(gpointer data) {
    snglIdleCallback(data);
    return G_SOURCE_REMOVE;
}
void sngl_gtk_idle_add(void* fn) {
    g_idle_add(sngl_idle_tramp, fn);
}

// Variadic wrapper — cgo cannot call `g_signal_emit_by_name` directly
// (the `...` in its prototype trips the cgo type checker). Used by
// per-id test invokers to fire signals with no extra args.
static void sngl_emit(gpointer instance, const char *signal) {
    g_signal_emit_by_name(instance, signal);
}

// Reactive-safe entry setter — GtkEditable's set_text fires "changed"
// even when the new text equals the current text, which loops back
// through any change handler that wrote the mutating var and re-applies
// reactivity, blowing the stack. Skip the call when the value already
// matches.
// g_object_unref takes a gpointer, and a declaration that names it directly
// would need a cast a SNGL override has no way to write. The shim is where the
// cast belongs -- it is C, which is what this preamble is.
static void sngl_unref_pixbuf(GdkPixbuf *p) {
    if (p != NULL) g_object_unref(p);
}

static void sngl_set_entry_text(GtkEditable *e, const char *t) {
    const char *cur = gtk_editable_get_text(e);
    if (t == NULL) t = "";
    if (cur != NULL && strcmp(cur, t) == 0) return;
    gtk_editable_set_text(e, t);
}
*/
import "C"

import (
	"unsafe"
)

func boolToInt(b bool) int {
	if b {
		return 1
	}
	return 0
}

// Model holds the state and widget references for this SNGL UI.
type Model struct {
	count__inst0 int
	__n0         *C.GtkApplicationWindow
	__n1         *C.GtkBox
	__n2         *C.GtkLabel
	__n3         *C.GtkButton
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	m.count__inst0 = 0
	return m
}

func (m *Model) __n3_clicked_handler() {
	m.count__inst0 = (m.count__inst0 + 1)
}

func (m *Model) Count__inst0() int {
	return m.count__inst0
}

func (m *Model) SetCount__inst0(v int) {
	m.count__inst0 = v
}

func (m *Model) buildWidgetTree() {
	m.__n0 = (*C.GtkApplicationWindow)(unsafe.Pointer(C.gtk_application_window_new(app)))
	C.gtk_window_set_title((*C.GtkWindow)(unsafe.Pointer(m.__n0)), C.CString("Test"))
	m.__n1 = (*C.GtkBox)(unsafe.Pointer(C.gtk_box_new(0, C.int(0))))
	C.gtk_orientable_set_orientation((*C.GtkOrientable)(unsafe.Pointer(m.__n1)), C.GTK_ORIENTATION_VERTICAL)
	C.gtk_widget_set_tooltip_text((*C.GtkWidget)(unsafe.Pointer(m.__n1)), C.CString("a box"))
	m.__n2 = (*C.GtkLabel)(unsafe.Pointer(C.gtk_label_new(nil)))
	C.gtk_label_set_text((*C.GtkLabel)(unsafe.Pointer(m.__n2)), C.CString("hello"))
	C.gtk_box_append((*C.GtkBox)(unsafe.Pointer(m.__n1)), (*C.GtkWidget)(unsafe.Pointer(m.__n2)))
	m.__n3 = (*C.GtkButton)(unsafe.Pointer(C.gtk_button_new()))
	C.gtk_button_set_label((*C.GtkButton)(unsafe.Pointer(m.__n3)), C.CString("click me"))
	C.gtk_widget_set_sensitive((*C.GtkWidget)(unsafe.Pointer(m.__n3)), C.gboolean(boolToInt(true)))
	snglCallbacks = append(snglCallbacks, m.__n3_clicked_handler)
	C.sngl_connect(unsafe.Pointer(m.__n3), C.CString("clicked"), C.int((len(snglCallbacks) - 1)))
	C.gtk_box_append((*C.GtkBox)(unsafe.Pointer(m.__n1)), (*C.GtkWidget)(unsafe.Pointer(m.__n3)))
	C.gtk_window_set_child((*C.GtkApplicationWindow)(unsafe.Pointer(m.__n0)), (*C.GtkWidget)(unsafe.Pointer(m.__n1)))
}

// BuildUI constructs the widget tree and returns the top-level window.
func (m *Model) BuildUI(app *C.GtkApplication) *C.GtkWidget {
	m.buildWidgetTree()
	return (*C.GtkWidget)(unsafe.Pointer(m.__n0))
}
