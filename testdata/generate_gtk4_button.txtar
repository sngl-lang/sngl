End-to-end gtk4 platform compile test, run against the bundled GIR
(gir="builtin") so it does not need system GTK4 development files. The
fixture's widgets descend from a Widget base class because that is where real
GIR declares visible/sensitive/hexpand/tooltip-text and where the stdlib
override bodies in lib/platform/gtk4/gtk4.sngl are written against them -- so
this also checks that the parent-chain merge reaches them.

model.go is cgo: a `#include <gtk/gtk.h>` preamble and `import "C"`. Each
prop's setter is the C function the GIR names and each enum value is the
member's own C identifier (gtk_orientable_set_orientation with
C.GTK_ORIENTATION_VERTICAL, gtk_button_set_label), and constructors --
gtk_box_new, gtk_button_new -- come from the GIR rather than from the class
name. A window is not among them: GTK places a window in no container, so a
program writes ui.window and the platform makes the GtkApplicationWindow.
A label's text is GIR's setter for `label` too, gtk_label_set_label: no
table beside GIR picks another.

tooltip-text and sensitive are declared only on Widget and reach GtkBox and
GtkButton down the parent chain. Their setters take a GtkWidget*, so the cast
is to the ancestor that declares the property and not to the widget's own
class -- cgo rejects a GtkBox* where a GtkWidget* is wanted. The GTK
entrypoint lands in callbacks.go as snglActivate, the //export'd activate
handler hooked to the GApplication.

deny out/go/gtk4/model.go `gtk_label_set_text` -- GIR names gtk_label_set_label as the label property's setter, and nothing in Go chooses another
deny out/go/gtk4/model.go `gtk_button_new_with_label` -- the GIR names gtk_button_new as the constructor; with_label is a separate one the emitter must not reach for
-- main.sngl --
import . "sngl:test"
import gtk "gir:Gtk-4.0"
import ui "sngl:ui"

output {
    go {
        gtk4(gir="builtin", main=true)
    }
}

component main ui.node {
    var count int

    gtk.GtkBox(orientation="vertical", tooltipText="a box") {
        gtk.GtkLabel(label="hello") {}
        gtk.GtkButton(label="click me", sensitive=true, @clicked { count = count + 1 }) {}
    }
}

ui.window(title="Test") {
    main
}
-- out/go/gtk4/callbacks.go --
// Code generated by sngl (gtk4) from main.sngl; DO NOT EDIT.

package main

import "duckfam.us/sngl/pkg/go/gtk4rt"

func main() {
	gtk4rt.Init()
	m := New()
	m.buildWidgetTree()
	gtk4rt.RunWindows(true)
}
-- out/go/gtk4/model.go --
// Code generated by sngl (gtk4) from main.sngl; DO NOT EDIT.

package main

import "duckfam.us/sngl/pkg/go/gtk4rt"

// Model holds the state and widget references for this SNGL UI.
type Model struct {
	count__inst0   int
	visible__inst0 bool
	__n0           gtk4rt.Handle
	__n1           gtk4rt.Handle
	__n2           gtk4rt.Handle
	__n3           gtk4rt.Handle
	__built        bool
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	m.count__inst0 = 0
	m.visible__inst0 = true
	return m
}

func (m *Model) __n0_closed_handler() {
}

func (m *Model) __n0_visible_handler(__visible bool) {
	m.visible__inst0 = __visible
	gtk4rt.ToplevelSetVisible(m.__n0, m.visible__inst0)
}

func (m *Model) __n3_clicked_handler() {
	m.count__inst0 = (m.count__inst0 + 1)
}

func (m *Model) Count__inst0() int {
	return m.count__inst0
}

func (m *Model) SetCount__inst0(v int) {
	m.count__inst0 = v
}

func (m *Model) Visible__inst0() bool {
	return m.visible__inst0
}

func (m *Model) SetVisible__inst0(v bool) {
	m.visible__inst0 = v
}

func (m *Model) buildWidgetTree() {
	if m.__built {
		return
	}
	m.__built = true
	m.__n0 = gtk4rt.ToplevelNew()
	gtk4rt.ToplevelSetTitle(m.__n0, "Test")
	gtk4rt.ToplevelSetVisible(m.__n0, m.visible__inst0)
	gtk4rt.ToplevelOnClosed(m.__n0, m.__n0_closed_handler)
	gtk4rt.ToplevelOnVisible(m.__n0, m.__n0_visible_handler)
	m.__n1 = gtk4rt.New("GtkBox")
	gtk4rt.OrientableSetOrientation(m.__n1, 1)
	gtk4rt.SetString(m.__n1, "tooltip-text", "a box")
	m.__n2 = gtk4rt.New("GtkLabel")
	gtk4rt.LabelSetLabel(m.__n2, "hello")
	gtk4rt.BoxAppend(m.__n1, m.__n2)
	m.__n3 = gtk4rt.New("GtkButton")
	gtk4rt.ButtonSetLabel(m.__n3, "click me")
	gtk4rt.SetBool(m.__n3, "sensitive", true)
	gtk4rt.Connect(m.__n3, "clicked", m.__n3_clicked_handler)
	gtk4rt.BoxAppend(m.__n1, m.__n3)
	gtk4rt.BoxAppend(m.__n0, m.__n1)
	gtk4rt.AppAttach(m.__n0)
}

// BuildUI constructs the widget tree and returns a window showing the first
// window's content.
func (m *Model) BuildUI(app gtk4rt.Handle) gtk4rt.Handle {
	m.buildWidgetTree()
	return gtk4rt.ToplevelWindow(app, m.__n0)
}
