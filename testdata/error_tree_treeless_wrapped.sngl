// A component that takes the family it is placed in -- a type parameter in its
// return position -- is held to rendering nothing of a family of its own, and
// the rule is asked of what is under a wrapper too. A boundary and a context
// override put nothing in the tree themselves -- they say what happens when a
// raise reaches them, and what value the nodes under them read -- so a widget
// written inside one is a widget this component renders.
//
// The rule walked an `if` and a `for` and stopped there, so both of these
// passed in silence. It reads familyTransparent now, the one list
// checkFamilyMembership, familyEvidence, childrenFamily and insertsSlot all
// read.

import ui "sngl:ui"

context #theme("light")

component guarded<F>() F {
    boundary(@error(e) {}) {
        ui.text(value="x") // ERROR(check) "component guarded takes the family it is placed in, so it may not contain the node component text"
    }
}

component scoped<F>() F {
    theme("dark") {
        ui.text(value="y") // ERROR(check) "component scoped takes the family it is placed in, so it may not contain the node component text"
    }
}

ui.window {
    guarded()
    scoped()
}
