// Component-instance member access is typed, not silently `dyn`: a wrong-typed
// assignment or comparison through a component-typed value is caught. Before
// members resolved through scope this degraded to `dyn` and slipped through.
component counter {
    var count int = 0
    var label string = ""
    func doubled() => count * 2

    text(value="{count}")
}

func testTypedVar(t Test, c counter) {
    c.count = "hello" // ERROR(check) "cannot assign string to int"
}

func testTypedComputed(t Test, c counter) {
    t.assert(c.doubled == "no") // ERROR(check) "operator == not defined for int and string"
}
