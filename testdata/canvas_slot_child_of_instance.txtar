A canvas handed to a stateful component under a `for` keeps its shapes' drawing.

A stateful component under a loop is built at run time, and each child handed
to it is lifted into a component of its own, its handlers crossing as events.
The lifting walked the whole child, so the shapes' `@draw` handlers -- the
canvas's drawing, not anything the program subscribes to -- crossed too, as
events carrying a `DrawEvent` neither Go target declares
(`undefined: DrawEvent`). Shapes are skipped now, and their handlers'
parameters are held out of the props the lifting makes.

deny * `DrawEvent` -- a shape's drawing never crosses a component boundary
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"
import draw "sngl:ui/draw"

output {
    go {
        fyne
        gtk4
    }
    none {
        html
    }
}

component frame(children ...component) node {
    var hits = 0

    vbox {
        text(value="hits {hits}")
        children
        button(text="hit", @click { hits += 1 })
    }
}

component main node {
    var rs = [4.0, 8.0]

    vbox {
        for var r = rs {
            frame {
                draw.canvas(width=40px, height=40px) {
                    draw.circle(cx=20.0, cy=20.0, r=r)
                }
            }
        }
        button #add(text="add", @click { rs.push(12.0) })
    }
}

func testAdds(t Test, c main) {
    c.add.click()
    t.assert(c.rs.length == 3)
}

window {
    main
}
