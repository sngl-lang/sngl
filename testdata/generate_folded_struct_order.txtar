A struct that folds through the optimizer's value model comes back as the
checker built it: the declaration it names, the fields in the order they were
written, and the defaults the checker filled in after them.

It used to come back as a bare map, so the literal was rebuilt with its keys
in alphabetical order and with the entry the interpreter tagged the value's
type in — `__type: "Point"`, a field the struct does not have and Go will not
compile.

The struct is returned by a function so the fold has to go through a value:
a literal written in place is not re-derived from one. It is read into a
component var so it survives as an initializer rather than being measured and
discarded.

deny out/go/bubbletea/model.go `__type` -- the interpreter's type tag is not a field of Point, and Go will not compile a literal carrying it

-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
    }
}

struct Point {
    x int
    y int
    tag string = "none"
}

func origin() => Point{y=1, x=7}

component main node {
    var here = origin()

    text(value="{string(here.x)}")
}

window {
    main
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
)

type Point struct {
	X   int
	Y   int
	Tag string
}

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	here__inst0 Point

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.here__inst0 = Point{Y: 1, X: 7, Tag: "none"}
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Here__inst0() Point {
	return m.here__inst0
}

func (m Model) SetHere__inst0(v Point) Model {
	m.here__inst0 = v
	return m
}

type setHere__inst0Msg struct{ value Point }

func SetHere__inst0Cmd(v Point) tea.Cmd {
	return func() tea.Msg { return setHere__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setHere__inst0Msg:
		m = m.SetHere__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(m.here__inst0.X)))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
