A test reaches into a component built at run time -- `badge` under an `if`
over state, `tile` under a `for` -- through a named instance and through one
copy: a trigger (`c.b.hit.click()`, `c.r[1].tap.click()`), a null test
(`c.b.done == null`, `c.r[1].fin`), a one-way prop read (`c.b.label`, the
copy's `c.r[1].label`, a node's `c.r[1].face.value`), a var read
(`c.b.hits`, `c.r[1].taps`), a method call (`c.b.reset()`), and the copy's own
event (`c.r[0].tapped(7)`), which runs the handler its call site wrote.

passTestReach makes each node a test reaches a node of the test's instance,
`c.b.hit` being `c.hit` and `c.r[1].tap` the copy of `c.tap` under key "1",
which a node inside an instance built at run time already carries; a prop
read is the call site's expression, a loop's variable the list at the
copy's index; and a fired event is a function of the component the call
site is written in (`__fire_r_tapped__t0`). A member is read off the
instance the target holds for it (codegen.InstanceReads): fyne's and gtk4's
Model holds the record (`__inst_b`, `__insts_r`), html's instance hangs off
its root element, android's composable registers in `SnglInstances`, and
bubbletea, which splices both, reads the copy's cell.

cmd/sngl/testdata/test_reach_runtime_instance_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component badge(label string) node {
    var hits = 0
    func reset() {
        hits = 0
    }
    text #shown(value="[{label}:{hits}]")
    button #hit(text="hit", @click {
        hits = hits + 1
    })
    if hits >= 2 {
        text #done(value="done")
    }
}

component tile(label string, @tapped(n int)) node {
    var taps = 0
    text #face(value="<{label}:{taps}>")
    button #tap(text="tap", @click {
        taps = taps + 1
        tapped(taps)
    })
    if taps >= 2 {
        text #fin(value="fin")
    }
}

component main node {
    var show = true
    var names list[string] = ["a", "b"]
    var log = ""
    vbox {
        if show {
            badge #b(label="one")
        }
        for var i, n = names {
            tile #r(label="{i}{n}", @tapped(k) {
                log = log + "{n}{k};"
            })
        }
        button #toggle(text="t", @click {
            show = !show
        })
    }
}

func testReachesOneInstance(t Test, c main) {
    if c.b != null {
        t.assert(c.b.done == null)
        c.b.hit.click()
        t.assert(c.b.hits == 1)
        t.assert(c.b.label == "one")
        t.assert(c.b.shown.value == "[one:1]")
        c.b.hit.click()
        t.assert(c.b.done != null)
        c.b.reset()
        t.assert(c.b.hits == 0)
    } else {
        t.assert(false)
    }
    c.toggle.click()
    t.assert(c.b == null)
}

func testReachesOneCopy(t Test, c main) {
    if c.r[1] != null {
        t.assert(c.r[1].fin == null)
        c.r[1].tap.click()
        t.assert(c.r[1].taps == 1)
        t.assert(c.r[0].taps == 0)
        t.assert(c.r[1].label == "1b")
        t.assert(c.r[1].face.value == "<1b:1>")
        c.r[1].tap.click()
        t.assert(c.r[1].fin != null)
        t.assert(c.r[0].fin == null)
        t.assert(c.log == "b1;b2;")
    } else {
        t.assert(false)
    }
}

func testFiresACopysEvent(t Test, c main) {
    c.r[0].tapped(7)
    t.assert(c.log == "a7;")
    t.assert(c.r[0].taps == 0)
}

window {
    main
}
