package main

import (
	"fmt"
	"testing"
)

func TestReachesOneInstance(t *testing.T) {
	c := newTestComponent()
	_ = c
	if c.show {
		if !(!c.donePresent()) { t.Errorf("assert failed: %s", "!c.donePresent()") }
		c.hitClick()
		if !((c.bReadHits() == 1)) { t.Errorf("assert failed: %s", "(c.bReadHits() == 1)") }
		if !(true) { t.Errorf("assert failed: %s", "true") }
		if !(((("[one:" + fmt.Sprint(c.bReadHits())) + "]") == "[one:1]")) { t.Errorf("assert failed: %s", "(((\"[one:\" + fmt.Sprint(c.bReadHits())) + \"]\") == \"[one:1]\")") }
		c.hitClick()
		if !(c.donePresent()) { t.Errorf("assert failed: %s", "c.donePresent()") }
		c.bCallReset()
		if !((c.bReadHits() == 0)) { t.Errorf("assert failed: %s", "(c.bReadHits() == 0)") }
	} else {
		if !(false) { t.Errorf("assert failed: %s", "false") }
	}
	c.toggleClick()
	if !(!c.show) { t.Errorf("assert failed: %s", "!c.show") }
}

func TestReachesOneCopy(t *testing.T) {
	c := newTestComponent()
	_ = c
	if (1 < len(c.names)) {
		if !(!c.finPresentAt("1")) { t.Errorf("assert failed: %s", "!c.finPresentAt(\"1\")") }
		c.tapClickAt("1")
		if !((c.rReadTapsAt("1") == 1)) { t.Errorf("assert failed: %s", "(c.rReadTapsAt(\"1\") == 1)") }
		if !((c.rReadTapsAt("0") == 0)) { t.Errorf("assert failed: %s", "(c.rReadTapsAt(\"0\") == 0)") }
		if !((("1" + c.names[1]) == "1b")) { t.Errorf("assert failed: %s", "((\"1\" + c.names[1]) == \"1b\")") }
		if !(((((("<" + ("1" + c.names[1])) + ":") + fmt.Sprint(c.rReadTapsAt("1"))) + ">") == "<1b:1>")) { t.Errorf("assert failed: %s", "(((((\"<\" + (\"1\" + c.names[1])) + \":\") + fmt.Sprint(c.rReadTapsAt(\"1\"))) + \">\") == \"<1b:1>\")") }
		c.tapClickAt("1")
		if !(c.finPresentAt("1")) { t.Errorf("assert failed: %s", "c.finPresentAt(\"1\")") }
		if !(!c.finPresentAt("0")) { t.Errorf("assert failed: %s", "!c.finPresentAt(\"0\")") }
		if !((c.log == "b1;b2;")) { t.Errorf("assert failed: %s", "(c.log == \"b1;b2;\")") }
	} else {
		if !(false) { t.Errorf("assert failed: %s", "false") }
	}
}

func TestFiresACopysEvent(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.__fire_r_tapped__t0(7, 0)
	if !((c.log == "a7;")) { t.Errorf("assert failed: %s", "(c.log == \"a7;\")") }
	if !((c.rReadTapsAt("0") == 0)) { t.Errorf("assert failed: %s", "(c.rReadTapsAt(\"0\") == 0)") }
}

