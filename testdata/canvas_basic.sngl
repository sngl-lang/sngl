import . "sngl:ui"
import draw "sngl:ui/draw"

component myWidget node {
    draw.canvas(width=400px, height=300px) {
        draw.rect(x=10.0, y=10.0, w=100.0, h=50.0) {}
        draw.circle(cx=50.0, cy=50.0, r=30.0) {}
        draw.canvasText(x=20.0, y=80.0, content="hello") {}
    }
}

