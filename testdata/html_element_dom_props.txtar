A boolean attribute is present or absent, and setAttribute cannot say absent:
`setAttribute("open", false)` renders `open="false"`, which leaves a
<details> OPEN. Which props are boolean is what `element` declares, so both
the initial-render path and the JS-built path read the declaration instead of
each keeping a list -- the two lists disagreed on hidden, readonly, selected
and innerText, `open` was in neither, and `readonly` was written with the
attribute's casing where the DOM property is readOnly. Every boolean prop is a
DOM property write, in the DOM's casing, on both paths.

The prop the tag name binds to is read from the #[wildcard] mark's `into`
argument for the same reason: it names the element and is never an attribute.

deny out/none/html/index.html `setAttribute\("open"` -- open="false" is an open <details>; the boolean has to be a property write
deny out/none/html/index.html `setAttribute\("readonly"` -- the DOM property is readOnly, and the attribute's casing is what the old list got wrong
deny out/none/html/index.html `setAttribute\("hidden"` -- the JS-built path reads the same declaration, so hidden is a property write there too
deny out/none/html/index.html `tag="` -- tag names the element that was created; emitting it on that element would be the name twice
deny out/none/html/index.html `setAttribute\("tag"` -- same on the JS-built path: createElement consumed the prop, nothing is left to set

-- dom.sngl --
import . "sngl:ui"
import "sngl:platform/html"

output {
    none {
        html
    }
}

window {
    var shown bool = false
    var locked bool = true
    var rows list<string> = ["a"]

    html.details(open=shown) {
        html.input(readonly=locked)
    }
    html.element(tag="my-widget", role="main")
    for var r = rows {
        html.li(textContent=r, hidden=shown)
    }
}
