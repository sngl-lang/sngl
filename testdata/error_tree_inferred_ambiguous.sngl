// The two answers inference does not have. A body that renders members of two
// families does not say which of them the component joins, and a body that
// renders no member of any says nothing at all -- a slot insertion least of
// all, since what a slot with no declared family accepts is the family being
// inferred.
//
// The second is the wrapper, and it is the shape this lands on most often, so
// it is told what a wrapper wants: to be handed a family by its call site,
// which is the type parameter -- not the mark, which is for a component that
// renders nothing at all.

import d "sngl:ui/draw"
import ui "sngl:ui"

component mixed() { // ERROR(check) "component mixed: the body renders both node and shape, so name the tree it belongs to in the return position"
    ui.text(value="a")
    d.circle(cx=1.0, cy=1.0, r=1.0, style={fill=#FF0000})
}

component wrap(children ...component) { // ERROR(check) "component wrap: the body renders only what a caller supplies, so name the tree it belongs to in the return position -- or a type parameter, for a wrapper whose family is whatever it was handed"
    children
}

ui.window {
}
