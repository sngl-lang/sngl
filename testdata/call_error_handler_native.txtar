A `fails` Go native reports its failure as an error result rather than a
panic, so a call's own @error on one tests that result instead of recovering.
The handler runs with the error's text as the message, and the call's value is
not read. strconv.Atoi is the native because it fails on ordinary input and
needs no module.

deny out/go/bubbletea/model.go `v, _ := strconv\.Atoi` -- a handled failure is tested, not discarded

-- native.sngl --
import go "sngl:language/go"
import . "sngl:ui"
import . "sngl:test"

#[go.native("strconv", "strconv.Atoi", fails)]
func atoi(s string) int

component main node {
    var caught = ""
    var after = ""
    button #bad(text="Bad", @click {
        atoi("x", @error(e) { caught = e.message })
        after = after + "b"
    })
    button #good(text="Good", @click {
        atoi("7", @error(e) { caught = "never" })
        after = after + "g"
    })
    text(value="{caught}|{after}")
}

func testFailureIsCaught(t Test, c main) {
    c.bad.click()
    t.assert(c.caught == "strconv.Atoi: parsing \"x\": invalid syntax")
    t.assert(c.after == "b")
}

func testSuccessSkipsHandler(t Test, c main) {
    c.good.click()
    t.assert(c.caught == "")
    t.assert(c.after == "g")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
}
