package main

import "testing"

func TestFailureIsCaught(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.badClick()
	if !((c.caught == "strconv.Atoi: parsing \"x\": invalid syntax")) { t.Errorf("assert failed: %s", "(c.caught == \"strconv.Atoi: parsing \\\"x\\\": invalid syntax\")") }
	if !((c.after == "b")) { t.Errorf("assert failed: %s", "(c.after == \"b\")") }
}

func TestSuccessSkipsHandler(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.goodClick()
	if !((c.caught == "")) { t.Errorf("assert failed: %s", "(c.caught == \"\")") }
	if !((c.after == "g")) { t.Errorf("assert failed: %s", "(c.after == \"g\")") }
}


func newTestComponent() Model { return New() }
