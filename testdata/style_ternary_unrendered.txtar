A ternary in a style prop on a target that renders no `style`: passTernary
hoists the `c ? a : b` into a temp declared ahead of the node, and fyne and gtk4
write nothing for `style`, the platform's own prop rather than a widget's. With
the one statement reading it dropped, Go refused the temp as declared and not
used; the translator reads it into the blank identifier instead
(codegen.KeepLocalsRead).

deny out/go/fyne/model.go `__n\d+\.Style|SetStyle` -- fyne still renders nothing for style
-- app.sngl --
import ui "sngl:ui"

ui.window {
    var on = false
    ui.button(text="x", style={fontWeight=on ? ui.FontWeight.bold : ui.FontWeight.normal}, @click {
        on = !on
    })
}

output {
    go {
        fyne
        gtk4
    }
}
