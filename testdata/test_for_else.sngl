component emptylist {
    var items = []

    vbox {
        for item = items {
            text #item(value=item)
        } else {
            text #empty(value="No items yet")
        }
    }
}

func testShowsElseForEmptyList(t T, c emptylist) {
    t.assert(c.#empty.value == "No items yet")
}

func testHidesElseWhenListHasItems(t T, c emptylist) {
    c.items = ["hello"]
    t.assert(c.#item.value == "hello")
}
