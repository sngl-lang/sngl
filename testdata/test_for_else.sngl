component emptylist {
    var items list<string> = []

    vbox {
        for item = items {
            text #item(value=item)
        } else {
            text #empty(value="No items yet")
        }
    }
}

func testShowsElseForEmptyList(t Test, c emptylist) {
    t.assert(c.empty.value == "No items yet")
}

func testHidesElseWhenListHasItems(t Test, c emptylist) {
    c.items = ["hello"]
    t.assert(c.item.value == "hello")
}
