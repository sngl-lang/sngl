A type's alias generates nothing of its own: the checker writes the type it
names wherever the alias is written, so `P` is Point, `IntBox` Box[int], `Dir`
Direction and `Count` int in every target's output, and a method declared on
an alias is the declaration's. The tests run on every target, the
interpreter included (testdata/type_alias.sngl).

-- type_alias.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}

struct Point {
    x int = 0
    y int = 0
}

struct P = Point

func P.sum(this P) => this.x + this.y

struct Box[T any] {
    value T
}

struct IntBox = Box[int]

enum Direction { up, down }

enum Dir = Direction

struct Count = int

func Count.twice(this Count) => this * 2

component shown node {
    var p P = {x=1, y=2}
    var b = IntBox{value=4}
    var d Dir = Dir.up
    var c Count = 3
    text #sum(value=string(p.sum()))
    text #box(value=string(b.value))
    text #dir(value=d == Direction.up ? "up" : "down")
    text #twice(value=string(c.twice()))
    button #turn(text="turn", @click {
        d = Dir.down
        c = c + 1
        p = P{x=p.x + 1, y=p.y}
    })
}

func testShown(t Test, c shown) {
    t.assert(c.sum.value == "3" && c.box.value == "4")
    t.assert(c.dir.value == "up" && c.twice.value == "6")
    c.turn.click()
    t.assert(c.sum.value == "4" && c.dir.value == "down" && c.twice.value == "8")
}

window {
    shown()
}
