import . "sngl:std"

component counter {
    var count = 0

    vbox {
        text(value="Count: {count}")
        button(text="+", @click { count += 1 })
        if count > 0 {
            text(value="positive")
        } else {
            text(value="zero")
        }
    }
}

func testFoo(t Test, c counter) {
    c.count += 3
    t.snapshot("Foo")
}
