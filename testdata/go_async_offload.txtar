Go has no way to suspend a function, so a call that waits waits on whatever
goroutine made it -- and in a fyne program that is the goroutine drawing the
window. `#[go.async]` says a call blocks, and passAsyncOffload splits the body
it sits in: what came before stays where it was written, the blocking calls get
a goroutine, and everything after is posted back through fyne.Do.

The split is what the golden is for. `busy = true` is before the call and must
stay on the drawing thread; the assignment of the answer and `busy = false` are
after it, and must both be inside the posted closure. A `sleep` with nothing to
hand back and a `host` with an answer are the two shapes the split handles, and
they sit next to each other here so the goroutine holds both and posts once.

The empty BuildUI is not this fixture's doing: a fyne program whose root is a
component rather than a window emits its tree into a render func and leaves
BuildUI a placeholder, with or without a blocking call in it.

deny out/go/fyne/model.go `m.greeting = func\(\) string` -- the answer is bound on the goroutine and written back, never spliced into an assignment made on the drawing thread

-- app.sngl --
import . "sngl:ui"
import go "sngl:language/go"
import app "sngl:app"

#[go.native("time", "time.Sleep")]
#[go.async]
func sleep(ns int)

#[go.native("os", "os.Hostname", fails)]
#[go.async]
func host() string

component main ui {
    var (
        greeting = "idle"
        busy = false
    )

    text #out(value=greeting)
    button #load(text="load", @click {
        busy = true
        sleep(300000000)
        greeting = host()
        busy = false
    })
}

output(lang="go", platform="fyne")

app.window {
    main
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package ui

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/widget"
	"os"
	"time"
)

// Model holds the state for this SNGL UI.
type Model struct {
	greeting string
	busy     bool
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.greeting = "idle"
	m.busy = false
	return m
}

func (m *Model) host() string {
	return ""
}

func (m *Model) load_click_handler() {
	m.busy = true
	go func() {
		time.Sleep(300000000)
		__async_off0 := func() string { v, _ := os.Hostname(); return v }()
		fyne.Do(func() {
			m.greeting = __async_off0
			m.busy = false
		})
	}()
}

func (m *Model) Greeting() string {
	return m.greeting
}

func (m *Model) SetGreeting(v string) {
	m.greeting = v
}

func (m *Model) Busy() bool {
	return m.busy
}

func (m *Model) SetBusy(v bool) {
	m.busy = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	content := fyne.CanvasObject(widget.NewLabel(""))
	return content
}
