Inlining copies the argument to wherever the parameter is read, so a parameter
read twice evaluates its argument twice. That is the argument's problem and
not the function's — `double(x) => x + x` is as pure as they come, and
`double(bump())` counted by two.

Purity of the *callee* was the only condition, which is the wrong side of the
call: it permitted this, and forbade inlining a readonly function whose
argument was a literal.

deny out/go/bubbletea/model.go `bump\(\).*bump\(\)` -- The effect happens once. Either the call is kept or the argument is bound — what may not happen is two bumps where the program wrote one.
-- app.sngl --
import . "sngl:ui"
import . "sngl:app"

func double(x int) => x + x

component main {
    var n = 0

    func bump() int {
        n = n + 1
        return n
    }

    window(title="once") {
        text(value=string(double(bump())))
    }
}

output(lang="go", platform="bubbletea")
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	n int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.n = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) bump() int {
	m.n = (m.n + 1)
	return m.n
}

func Double(x int) int {
	return (x + x)
}

func (m Model) N() int {
	return m.n
}

func (m Model) SetN(v int) Model {
	m.n = v
	return m
}

type setNMsg struct{ value int }

func SetNCmd(v int) tea.Cmd {
	return func() tea.Msg { return setNMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setNMsg:
		m = m.SetN(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(Double(m.bump()))))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
