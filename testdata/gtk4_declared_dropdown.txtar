A select is a GtkDropDown, whose create is the one declgen declares for the
GIR class, offered its choices by offerChoices: gtk4rt.DropDownOffer as a
#[go.native], which builds the GtkStringList and copies the labels and the
chosen one into C itself. The inline-cgo path the canvas keeps the program
on calls it as a wrapped build does, so no generated helper makes a C string
for it and the preamble no longer carries its own sngl_drop_down_offer. The
one C.CString left is the window title's.
deny out/go/gtk4/model.go `snglDropDownOffer` -- the offer is gtk4rt's, not a template helper
deny out/go/gtk4/model.go `sngl_drop_down_offer` -- gtk4rt carries the C that builds the model
-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"
import go "sngl:language/go"

output {
    go {
        gtk4
    }
}

var fruits = ["Apple", "Banana"]
var pick = "Apple"

ui.window(title="t") {
    draw.canvas(width=20px, height=20px) {
        draw.line(x1=0.0, y1=0.0, x2=10.0, y2=10.0)
    }
    ui.select(:value=pick) {
        for var f = fruits {
            ui.choice(label=f)
        }
    }
}
