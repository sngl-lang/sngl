Multi-window html static output: each filename derives from that window's
folded href, not from its id and not from the source-line fallback a window
with no href would get. The golden's file set is the assertion -- an
`out/none/html/window_L1.html` would be an extra file, and the harness
compares the set both ways.

-- site.sngl --
import . "sngl:ui"
import . "sngl:app"

output { none { html } }

component main {
    window #home(title="Home", href="/") { text(value="home") }
    window #about(title="About", href="/about.html") { text(value="about") }
    window #intro(title="Intro", href="/docs/intro.html") { text(value="intro") }
}
-- out/none/html/about.html --
<!-- Code generated by sngl (html) from site.sngl; DO NOT EDIT. -->

