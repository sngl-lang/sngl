Markup under a reactive `if` on html.

The branch is a render slot, so its nodes are created on the client rather
than written into the page. html's markup primitives, `flow` and `inline`, take
their element as a `tag` prop, and the lowering creates a node under its
declaration's name -- so the slot built `<flow>` and `<inline>` elements until
the `tag` write became the `createElement` argument. The page walk already
read the prop, which is why the same markup outside a branch was right.

deny * `createElement\("(flow|inline)"\)` -- a primitive's element is its tag prop, not its declaration's name

-- doc.sngl --
import ui "sngl:ui"
import md "sngl:ui/markup"

output {
    go {
        html
    }
    none {
        html
    }
}

ui.window #home(title="doc") {
    var open = false

    ui.vbox {
        ui.button(text="toggle", @click { open!! })
        if open {
            md.paragraph {
                md.text(value="a ")
                md.bold {
                    md.text(value="bold")
                }
                md.text(value=" word")
            }
            md.codeBlock {
                md.text(value="sngl run")
            }
        }
    }
}
