class MainScreenTest {
    @get:Rule val composeRule = createAndroidComposeRule<ComponentActivity>()

    @Test fun testNullTestsFollowTheBranch() {
        val c = MainScreenState()
        @Suppress("UNUSED_VARIABLE") val composeTestRule = composeRule
        composeRule.setContent { MainScreen(c) }
        org.junit.Assert.assertTrue("c.shown", c.shown)
        org.junit.Assert.assertTrue("(composeTestRule.onAllNodes(androidx.compose.ui.test.hasTestTag(\"label\")).fetchSemanticsNodes().isNotEmpty() || SnglPresent.containsValue(\"label\"))", (composeTestRule.onAllNodes(androidx.compose.ui.test.hasTestTag("label")).fetchSemanticsNodes().isNotEmpty() || SnglPresent.containsValue("label")))
        composeTestRule.onNode(androidx.compose.ui.test.hasTestTag("toggle")).performSemanticsAction(androidx.compose.ui.semantics.SemanticsActions.OnClick); composeTestRule.waitForIdle()
        org.junit.Assert.assertTrue("!c.shown", !c.shown)
        org.junit.Assert.assertTrue("!(composeTestRule.onAllNodes(androidx.compose.ui.test.hasTestTag(\"label\")).fetchSemanticsNodes().isNotEmpty() || SnglPresent.containsValue(\"label\"))", !(composeTestRule.onAllNodes(androidx.compose.ui.test.hasTestTag("label")).fetchSemanticsNodes().isNotEmpty() || SnglPresent.containsValue("label")))
        composeTestRule.onNode(androidx.compose.ui.test.hasTestTag("toggle")).performSemanticsAction(androidx.compose.ui.semantics.SemanticsActions.OnClick); composeTestRule.waitForIdle()
        org.junit.Assert.assertTrue("c.shown", c.shown)
        org.junit.Assert.assertTrue("(composeTestRule.onAllNodes(androidx.compose.ui.test.hasTestTag(\"label\")).fetchSemanticsNodes().isNotEmpty() || SnglPresent.containsValue(\"label\"))", (composeTestRule.onAllNodes(androidx.compose.ui.test.hasTestTag("label")).fetchSemanticsNodes().isNotEmpty() || SnglPresent.containsValue("label")))
    }

}
