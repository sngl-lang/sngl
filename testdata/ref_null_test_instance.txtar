package main

import "testing"

func TestNullTestsFollowTheBranch(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	if !(c.labelPresent()) { t.Errorf("assert failed: %s", "c.labelPresent()") }
	c.toggleClick()
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.labelPresent()) { t.Errorf("assert failed: %s", "!c.labelPresent()") }
	c.toggleClick()
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	if !(c.labelPresent()) { t.Errorf("assert failed: %s", "c.labelPresent()") }
}

