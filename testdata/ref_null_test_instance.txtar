A test null-tests a component instance and a widget under a reactive `if`,
on every target, and both follow the branch.

The instance is built while the program runs, and is named: on fyne and gtk4
the slot's reconcile declares its position, the instance it builds and its
root under the program's id, which passNodeEscape knew only by a synthesized
`__nN` name, so the three were split between locals and Model fields and the
render did not compile. They are locals of the render now
(node_escape.go's reconcileLocal).

An instance has no widget of its own: on fyne and gtk4 it hands its root to a
`__present_<id>` field where the root is bound, and on android the call site
holds a token in SnglPresent while it is composed. A widget the render no
longer builds kept its field on fyne and gtk4, so it read as rendered after
the branch closed; the slot's reset clears what a test null-tests.

cmd/sngl/testdata/ref_null_test_instance_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component badge(label string) node {
    var hits = 0
    button #hit(text="hit {label} {hits}", @click { hits = hits + 1 })
}

component main node {
    var shown = true
    vbox {
        button #toggle(text="t", @click { shown = !shown })
        if shown {
            badge #b(label="x")
            text #label(value="y")
        }
    }
}

func testNullTestsFollowTheBranch(t Test, c main) {
    t.assert(c.b != null)
    t.assert(c.label != null)
    c.toggle.click()
    t.assert(c.b == null)
    t.assert(c.label == null)
    c.toggle.click()
    t.assert(c.b != null)
    t.assert(c.label != null)
}

window {
    main
}
