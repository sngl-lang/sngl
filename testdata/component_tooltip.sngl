// tooltip: state-binding fixture — driving the tooltip `text`
// from a state var. The stdlib prop isn't two-way bound, so this
// asserts the var mutation alone (component reads from it).
component main {
    var msg = "hello"
    tooltip(text=msg) {
        button(text="hover")
    }
}

func testTooltipTextMutates(t Test, c main) {
    t.assert(c.msg == "hello")
    c.msg = "goodbye"
    t.assert(c.msg == "goodbye")
}
