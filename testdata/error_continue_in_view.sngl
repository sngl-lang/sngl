// A view body's loop is a template stamped once per element, not a statement
// stream: there is no iteration for an escape to cut short.

import . "sngl:ui"
import app "sngl:app"

component main node {
    var xs list<int> = [1]

    for var x = xs {
        continue // ERROR(check) "cannot be written in a view body"
    }
}

app.window {
    main
}
