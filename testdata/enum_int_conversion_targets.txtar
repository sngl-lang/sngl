	if !((float64(slices.Index([]string{"butt", "round", "square"}, __snglTestComponent.cap__r0)) == 2.0)) { t.Errorf("assert failed: %s", "(float64(slices.Index([]string{\"butt\", \"round\", \"square\"}, __snglTestComponent.cap__r0)) == 2.0)") }
