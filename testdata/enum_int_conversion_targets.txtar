`int(e)` and `float(e)` of an enum are the index of the member it holds, on
every target: Go, which holds the member as its name, finds it among the
enum's, and C holds the index. testdata/enum_int_conversion.sngl pins the
interpreter's.

-- app.sngl --
import test "sngl:test"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
    c {
        win32
    }
}

enum Cap {
    butt
    round
    square
}

var cap = Cap.square

func ordinal(c Cap) => int(c)

func testEnumIndex(t test.Test) {
    t.assert(ordinal(Cap.butt) == 0)
    t.assert(ordinal(Cap.round) == 1)
    t.assert(int(cap) == 2)
    t.assert(float(cap) == 2.0)
}

ui.window {
    ui.text("{int(cap)}")
}
