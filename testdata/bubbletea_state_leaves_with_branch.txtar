bubbletea splices a component under an `if`, a `match` arm or a `for` into
the Model, so its vars are the Model's. Each time its position is taken
again the instance starts from its initializers, as on every other target:
`k` was 1 when the branch left and reads 0 the next time, and `f`, an owned
var, is a fresh value the next leave releases, rather than the one already
released.

-- app.sngl --
import ui "sngl:ui"
import macro "sngl:macro"
import "sngl:test"

output {
    go {
        bubbletea
    }
}

#[macro.owned(close)]
struct file {
    fd int
}

var log = ""

func close(f file) {
    log += "close {f.fd}; "
}

component child(n int) ui.node {
    var k = 0
    var f = file{fd=n}

    effect(@unmount {
        log += "left at {k}; "
    })
    ui.button #b(text="{k} {f.fd}", @click {
        k += 1
    })
}

component screen ui.node {
    var on = true
    var at = 0
    var xs = [1]
    var n = 1

    ui.vbox {
        if on {
            child #inIf(n=n)
        }
        match at {
            0 { child #inArm(n=n) }
            else {}
        }
        for var x = xs {
            child #inFor(n=x)
        }
    }
}

func testIf(t test.Test, c screen) {
    if c.inIf != null {
        c.inIf.b.click()
    }
    c.on = false
    c.n = 2
    c.on = true
    c.on = false
    t.assert(log == "left at 1; close 1; left at 0; close 2; ")
}

func testArm(t test.Test, c screen) {
    if c.inArm != null {
        c.inArm.b.click()
    }
    c.at = 1
    c.n = 2
    c.at = 0
    c.at = 1
    t.assert(log == "left at 1; close 1; left at 0; close 2; ")
}

func testFor(t test.Test, c screen) {
    c.inFor[0].b.click()
    c.xs = []
    c.xs = [2]
    c.xs = []
    t.assert(log == "left at 1; close 1; left at 0; close 2; ")
}

ui.window(title="t") {
    screen
}
