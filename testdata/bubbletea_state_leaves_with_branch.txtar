package main

import "testing"

func TestIf(t *testing.T) {
	c := newTestComponent()
	_ = c
	if c.on {
		c.b__reach0Click()
	}
	c.on = false
	c.__effects0_settle()
	c.n = 2
	c.on = true
	c.__effects0_settle()
	c.on = false
	c.__effects0_settle()
	if !((c.log == "left at 1; close 1; left at 0; close 2; ")) { t.Errorf("assert failed: %s", "(c.log == \"left at 1; close 1; left at 0; close 2; \")") }
}

func TestArm(t *testing.T) {
	c := newTestComponent()
	_ = c
	if (c.at == 0) {
		c.b__reach1Click()
	}
	c.at = 1
	c.__effects0_settle()
	c.n = 2
	c.at = 0
	c.__effects0_settle()
	c.at = 1
	c.__effects0_settle()
	if !((c.log == "left at 1; close 1; left at 0; close 2; ")) { t.Errorf("assert failed: %s", "(c.log == \"left at 1; close 1; left at 0; close 2; \")") }
}

func TestFor(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.b__reach2ClickAt("0")
	c.xs = []int{}
	c.__effects0_settle()
	c.xs = []int{2}
	c.__effects0_settle()
	c.xs = []int{}
	c.__effects0_settle()
	if !((c.log == "left at 1; close 1; left at 0; close 2; ")) { t.Errorf("assert failed: %s", "(c.log == \"left at 1; close 1; left at 0; close 2; \")") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
