A route's markup is built at compile time, so anything it renders has to be a
literal or an expression over something known per request.

A ternary in markup is html's to render, not the language's. Go has no ternary
and asks for it to be lowered into a temporary; that rewrote the expression
into a name the render model could not resolve, and the route was refused for
markup the JS filling the hole writes verbatim. So the route mode withholds the
NoTernary lowering and the ternary survives to codegen.

The same source is generated twice here: under `go`, where the restriction was,
and under `none`, the static backend that never had it. The path var this all
sits on is in route_path_param_param.txtar, and html's other withdrawal from
the Go lowering, list lambdas, in route_path_param_lambda.txtar.

-- ternary.sngl --
import . "sngl:app"
import "sngl:platform/html"
import ui "sngl:ui"

output {
    go {
        html
    }
    none {
        html
    }
}

component main ui.ui {
    var active = true
    window #home(title="t", href="/") {
        html.a(class=active ? "on" : "off", innerText="x")
    }
}
-- out/go/html/server.go --
package ui

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleHome)
	return mux
}

func handleHome(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Write([]byte("<!-- Code generated by sngl (html) from ternary.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>t</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<a id=\"__n0\" data-sngl-id=\"__n0\">x</a>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { active: true };\n  var __n0 = document.querySelector('[data-sngl-id=\"__n0\"]');\n  function __sngl_init() {\n    __n0.setAttribute(\"class\", state.active ? \"on\" : \"off\");\n  }\n  __sngl_init();\n})();\n</script>\n</body></html>\n"))
}

-- out/none/html/index.html --
<!-- Code generated by sngl (html) from ternary.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>t</title>
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<a id="__n0" data-sngl-id="__n0">x</a>

<script>
(() => {
  // sngl-entry.js
  var state = { active: true };
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  function __sngl_init() {
    __n0.setAttribute("class", state.active ? "on" : "off");
  }
  __sngl_init();
})();
</script>
</body></html>
