A component with state and a lifetime of its own, written inside a population
handed to a component built at run time, on every target.

`Card` has state and sits under a `for`, so it is built at run time; `Counter`
is written in `foot`, the population `Card` inserts. The inliner walked a
node's children and never its populations, so `Counter` was neither elected a
runtime instance nor kept: android emitted `foot` empty, and html, fyne and
gtk4 met it after its declaration was gone -- a prop they could neither write
nor rebuild, `__cf_Counter is not defined`, `c.renderCounter undefined`.

`Counter` reads both scopes: `i` is the caller's loop variable and `v` the
argument `Card` inserts `foot` with. The test runs on every target: each card
mounts its counter once, keyed by what it read.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `foot = \{ v ->\s*\}\)` -- the population holds a Counter; an empty lambda dropped it
-- app.sngl --
import . "sngl:test"
import . "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component Counter(tag string, @seen(v string)) node {
    var n = 0

    vbox {
        text(value="counter {tag} {n}")
        effect(on="{tag}:{n}", @mount(k) { seen(k) })
    }
}

component Card(start int, foot component(v int) node) node {
    var k = start * 2

    vbox {
        text(value="card {k}")
        foot(k)
    }
}

component main node {
    var items = [1, 2]
    var foots = ""

    vbox {
        for var i = items {
            Card(start=i) {
                component foot(v) {
                    Counter(tag="{i}/{v}", @seen(s) { foots = foots + s + " " })
                }
            }
        }
    }
}

func testMounts(t Test, c main) {
    t.assert(c.foots == "1/2:0 2/4:0 ")
}

window {
    main
}
