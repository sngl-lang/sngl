What the three Go platforms emit for a method on a unit and on a primitive
that touches a package var.

The same lift as a struct method -- Go has no receiver to hang either on, so
both come out as free functions taking the Model as a trailing parameter. The
unit receiver and the primitive receiver are both here, and the four denies
below name both.

deny * `(?m)^func \(m \*Model\) doubled\(` -- a unit method is lifted, never a Model method
deny * `(?m)^func \(m \*Model\) twice\(` -- and so is a method on a primitive
deny * `(?m)^func LenDoubled\(v Len\) Len` -- the lifted form takes the Model; without it the body names an undefined m
deny * `(?m)^func IntTwice\(n int\) int` -- same for the primitive receiver

-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
}

unit Len {
    mm
    cm = 10mm
}

var log string = ""

func Len.doubled(v Len) Len {
    log = log + "!"
    return v + v
}

func int.twice(n int) int {
    log = log + "?"
    return n * 2
}

component main node {
    var five Len = 5mm
    var d Len = 0mm
    var t2 = 0

    effect(@mount {
        d = five.doubled()
        t2 = 3.twice()
    })

    text(value="{d}{t2}")
}

window {
    main
}
