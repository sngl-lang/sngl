package main

import "testing"

func TestInitialCountIsZero(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.count == 0)) { t.Errorf("assert failed: %s", "(c.count == 0)") }
}


func newTestComponent() Model { return New() }
