  <title>t</title>
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<div id="__n0" data-sngl-id="__n0">
  <span id="s">
  </span>
</div>
<button id="$0">
</button>

<script>
(() => {
  // sngl-entry.js
  var state = { shown: false };
  var $0 = document.getElementById("$0");
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  $0.addEventListener("click", function() {
    state.shown = !state.shown;
    __n0.hidden = state.shown;
  });
  function __sngl_init() {
    __n0.hidden = state.shown;
  }
  __sngl_init();
})();
</script>
</body></html>
