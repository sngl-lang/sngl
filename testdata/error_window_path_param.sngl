// A window's path is held to the struct that says what it hands its body.
//
// Neither rule was askable while the placeholders were the declaration. A
// `{slug}` nobody else named declared a var, silently, and every parameter was
// a string because there was nothing to say otherwise -- so a path could name
// something the body never read, and a body could never say a page number was
// an int.
//
// One-directional: `page` below is a field the path does not name, and that is
// not an error. The path is one source of a request's values and the struct is
// meant to carry the others.

import ui "sngl:ui"

struct PageParams {
    pkg string
    page int
    tags list<string>
}

ui.window #a(title="t", href=`/p/{slug}`, params=PageParams{}) { // ERROR(check) "the path names {slug}, but the window's params have no field \"slug\""
    component content(v) {
        ui.text(value=v.pkg)
    }
}

ui.window #b(title="t", href=`/t/{tags}`, params=PageParams{}) { // ERROR(check) "path parameter {tags} arrives as text"
    component content(v) {
        ui.text(value=v.pkg)
    }
}
