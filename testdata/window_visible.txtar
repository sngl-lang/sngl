A window is a component: on gtk4 and fyne `ui.window` is overridden by the
platform's `Toplevel` primitive, and a node at the root of the package body is
attached to the application, which is what creating a toplevel means there.

`visible` is a two-way prop of the window, and the override binds it through to
the primitive (`:visible=visible`). `open` and `close` are ordinary methods of
`ui.window` that assign it, so `details.close()` writes `shown`, which
`details` binds, and `other.close()` writes the cell the window keeps for the
prop nothing bound (passImplicitState) -- which `other.visible` reads. The
host reports a window manager's close the same way, as `visible = false`, and
fires `@closed` after it.

deny * `gtk4rt\.Window\{|snglWindow|\.Mount\(\)|\.Unmount\(\)` -- a window is a Toplevel node, not a record kept beside the tree
deny * `\.open\(\)|\.close\(\)` -- open and close are the window's methods, spliced where they are called

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
        fyne
    }
}

var (
    shown = true
    closes = 0
)

ui.window #details(title="Details", :visible=shown, @closed {
    closes += 1
}) {
    ui.text(value="closed {closes} times")
    ui.button(text="Hide", @click {
        details.close()
    })
    ui.button(text="Other", @click {
        if other.visible {
            other.close()
        } else {
            other.open()
        }
    })
}

ui.window #other(title="Other") {
    ui.text(value="shown {shown}")
    ui.button(text="Details", @click {
        details.open()
    })
}
