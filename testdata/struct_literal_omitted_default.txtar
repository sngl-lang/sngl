    }
    kotlin {
        android
    }
}

struct Frontmatter {
    title  string = ""
    weight int = 0
    limit  int = maxWeight
}

var fm = Frontmatter{title="Home"}
var zero Frontmatter

const maxWeight = 9

window #w {
    text(value="{fm.title} {fm.weight} {fm.limit} {zero.weight}")
}
