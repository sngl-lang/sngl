Two components each name an instance they build under a reactive `if` `#b`.
An id is one component's, so each render declares its own position,
instance and root under it, as locals. passNodeEscape counted an id created
in two scopes as escaping, which split each reconcile between locals and
Model fields on fyne and gtk4 (`undefined: b__new`). An id escapes now where
a scope that does not create it reads it.

cmd/sngl/testdata/instance_id_in_two_components_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
component badge(label string) node {
    var hits = 0
    button #hit(text="{label}{hits}", @click { hits = hits + 1 })
}

component panel node {
    var on = true
    vbox {
        button #flip(text="f", @click { on = !on })
        if on {
            badge #b(label="p")
        }
    }
}

component main node {
    var shown = true
    var other = false
    vbox {
        button #ts(text="s", @click { shown = !shown })
        button #to(text="o", @click { other = !other })
        if shown {
            badge #b(label="m")
        }
        if other {
            panel
        }
    }
}

func testBothInstancesRender(t Test, c main) {
    c.ts.click()
    c.to.click()
    t.assert(c.other)
}

window {
    main
}
