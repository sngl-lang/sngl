package main

import "testing"

func TestBothInstancesRender(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.tsClick()
	c.toClick()
	if !(c.other) { t.Errorf("assert failed: %s", "c.other") }
}


func newTestComponent() Model { return New() }
