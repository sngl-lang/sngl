import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

// A zero-argument function named where its result is expected is called.
// It only worked when the return type already matched: `doubled` returns an
// int and `value` wants a string, so the call was declined and the value was
// wrapped in a conversion from func to string instead — which the html
// backend emitted as an empty span. The emission is covered by
// cmd/sngl/testdata; what this pins is that the call happens at all.
component main node {
    var count = 2
    func doubled() => count * 2
    text(value=string(doubled))
}

func testComputedPropIsCalled(t Test, c main) {
    t.assert(c.doubled() == 4)
}

app.window {
    main
}
