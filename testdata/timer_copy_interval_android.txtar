A timer a loop's copy wraps keeps its interval on android.

A timer under a `for` whose host holds a lifetime is built per copy, in a
component passImplicitState writes for it, so its interval reaches the
LaunchedEffect as that component's param rather than as the literal the
program wrote. android read the interval only as a literal and made anything
else a delay of 0: the effect looped without suspending, and a test waiting
on the timer spun Compose's test clock forever
(cmd/sngl/testdata/timer_tab_loop_wait_runs.txt hung).

deny out/kotlin/android/MainScreen.kt `delay\(0L\)` -- the copy's interval is its param, not 0
-- app.sngl --
import time "sngl:time"
import ui "sngl:ui"

output {
    kotlin {
        android
    }
}

component main ui.node {
    var idx = 0
    var ticks = [0, 0]
    ui.tabs(:selected=idx) {
        ui.tab(label="One") {
            for var i, n = ticks {
                time.timer(interval=20ms, @tick {
                    ticks[i] = ticks[i] + 1
                })
                ui.text(value="{n}")
            }
        }
    }
}

ui.window {
    main
}
