// A #[construct] prop is kept: the value the live instance was built from is
// held and compared against what the next render describes, and a difference is
// what rebuilds the instance. So every target has to agree on when two of them
// are the same value — the same requirement an effect's `on` carries, for the
// same reason. Go refuses to compare two lists at all and JS compares two
// objects by identity, so a mark on one of those would have the site rebuild on
// every render: the instance state the mark exists to preserve, thrown away by
// the mark.
//
// A struct is comparable exactly when its fields are, so the diagnostic names
// the offending field rather than the struct the author thought was fine.

import . "sngl:ui"
import . "sngl:macro"
import . "sngl:time"

struct pair {
    a int
    b string
}

struct hasMap {
    counts map<string, int>
}

enum mode {
    on
    off
}

unit length { px, em }

// The forms that do work: the scalars, an enum, a unit, and a struct of them.
component fine(
    #[construct] n int,
    #[construct] s string,
    #[construct] f float,
    #[construct] b bool,
    #[construct] m mode,
    #[construct] w length,
    #[construct] p pair,
) {
    text(value=s)
}

component seededList(
    #[construct] xs list<int>, // ERROR(check) "list<int> does not"
) {
    text(value=string(xs.length()))
}

component seededMap(
    #[construct] m map<string, int>, // ERROR(check) "map<string, int> does not"
) {
    text(value=string(m.length()))
}

component seededOption(
    #[construct] o option<int>, // ERROR(check) "option<int> does not"
) {
    text(value="o")
}

// `date` is a #[builtin] struct with no fields: each target holds its own, so
// walking the zero fields would answer "always equal" for two different days.
component seededDate(
    #[construct] d date, // ERROR(check) "date does not"
) {
    text(value="d")
}

// The struct is comparable only if every field is, and this one names which.
component seededStruct(
    #[construct] h hasMap, // ERROR(check) "map<string, int> (field counts of struct hasMap)"
) {
    text(value="h")
}

// The rule has a second half, at the call site. A #[construct] prop typed by a
// type parameter is admitted where it is written -- judging a parameter there
// would make a generic component undeclarable -- so the only place T becomes a
// type is the call. Unchecked, a list bound to one reached fyne's rebuild
// comparison as `m.__inst0_was_seed[i] == m.xs` over a []any holding a []int,
// which panics at runtime rather than reporting anything.
component seeded<T>(#[construct] seed T) {
    text(value="seeded")
}

component holder {
    var n = 1
    var xs list<int> = [1]

    seeded(seed=n)

    seeded(seed=xs) // ERROR(check) "bound to list<int> here"
}

// The call that binds T need not be the one that places the marked prop. Here
// `pass` hands its own parameter down, so `seeded`'s T is still a parameter at
// the inner call and only `pass(x=xs)` makes it a list -- which is why the rule
// is a walk down the instances rather than a check on the call that writes the
// prop. Unchecked, the marked prop reached html as
// `__inst1_was_seed[__inst1_i] === seed` over an array, which is identity.
component pass<T>(x T) {
    seeded(seed=x)
}

component passer {
    var n = 1
    var xs list<int> = [1]

    pass(x=n)

    pass(x=xs) // ERROR(check) "bound to list<int> here"
}
