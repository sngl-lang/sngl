A font size on gtk4 is the length every other one is: pixels, an em 16 of
them, as html, android and bubbletea read one.

gtk4 wrote a `fontSize` in points, as Pango reads a span's, with an em as
Adwaita's 11, while every other length was pixels with an em 11 of them: a
`fontSize=16px` label was 16pt, a third larger than html's, and a padding of
`1em` 11px beside text 1em tall drawn at 14.7. A label's look writes
`font-size` in px, and a flow's run takes its size in pixels through
`font_desc`, so the run and a label agree.

deny out/go/gtk4/model.go `font-size: [0-9.]+pt` -- a font size is pixels, as every other length
-- app.sngl --
import ui "sngl:ui"
import md "sngl:ui/markup"

output {
    go {
        gtk4
    }
}

ui.window {
    ui.vbox {
        ui.text(value="px", style={fontSize=16px})
        ui.text(value="em", style={fontSize=1.5em, padding=1em})
        md.paragraph {
            md.run(style={fontSize=2em}) {
                md.text(value="run")
            }
        }
    }
}
-- out/go/gtk4/callbacks.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

import "duckfam.us/sngl/pkg/go/gtk4rt"

func main() {
	gtk4rt.Init()
	m := New()
	m.buildWidgetTree()
	gtk4rt.RunWindows(true)
}
