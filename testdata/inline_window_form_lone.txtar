	m := &Model{}
	return m
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	return widget.NewLabel("")
}

func (m *Model) renderStandalone() fyne.CanvasObject {
	__n0 := container.NewVBox()
	__n1 := widget.NewLabel("")
	__n1.SetText("standalone")
	__n0.Add(__n1)
	return __n0
}
