NoInlineComponents inlines user components into the app root, which is
`component main` or the top-level windows. This package has neither: a lone
component that nothing instantiates.

Nothing is unreachable when there is no root, so the pass leaves the package
alone -- dropping what it cannot reach would empty the program. `standalone`
reaches the fyne output intact.

The other form, a window as the root, is in inline_window_form_anon.txtar.

-- lone.sngl --
import . "sngl:ui"

component standalone {
    vbox {
        text(value="standalone")
    }
}

output { go { fyne } }
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from lone.sngl; DO NOT EDIT.

package ui

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
)

// Model holds the state for this SNGL UI.
type Model struct {
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	return widget.NewLabel("")
}

func (m *Model) renderStandalone() fyne.CanvasObject {
	__n0 := container.NewVBox()
	__n1 := widget.NewLabel("")
	__n1.SetText("standalone")
	__n0.Add(__n1)
	return __n0
}
