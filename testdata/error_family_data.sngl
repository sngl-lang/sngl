// What a data component -- one that names itself as its family -- may say. It
// is a record of its props and events, so it declares those, slots of
// records and a rest slot of content, and renders nothing; a slot of its type is a value its container
// reads, so it is never inserted; and a record is written only where such a
// slot is populated.

import ui "sngl:ui"

component fruit(name string, ripe bool = true) fruit

component withBody(name string) withBody { // ERROR(check) "component withBody names itself as its family, so it is data, read as a value and never rendered: remove the block"
}

component clash(run string, @run()) clash // ERROR(check) "component clash: event @run is a field of its record, which a prop of that name already is"

component holder(name string, inner component ui.node) holder // ERROR(check) "component holder names itself as its family, so it is data, whose props, events, slots of records and one rest slot of content are all it declares: inner"

component apple(name string, ripe bool = true) fruit // ERROR(check) "component apple names fruit as its family, which is data: only fruit itself is a record, and a component composing them has a body"

component basket(fruits ...component fruit) ui.node {
    fruits // ERROR(check) "slot \"fruits\" is a list of fruit, read as a value and never inserted"
}

ui.window {
    basket {
        fruit(name="apple")
    }
    ui.vbox {
        fruit(name="pear") // ERROR(check) "fruit"
    }
}
