A handler a render slot builds patches what it changes outside the slot: the
button under the reactive loop writes `on`, and both labels below the loop
read it. gtk4 dropped the two writes from the slot's closure, leaving the
labels stale and the ternary's temp declared and unread, which Go refuses.

-- app.sngl --
import . "sngl:test"
import ui "sngl:ui"

output {
    go {
        gtk4
        fyne
    }
}

component panel ui.node {
    var on = true
    var rows = [1]
    for var r = rows {
        ui.button #off(text="Off {r}", @click {
            on = false
        })
    }
    ui.text(value="{on}")
    ui.text(value=on ? "yes" : "no")
}

func testOff(t Test, c panel) {
    c.off[0].click()
    t.assert(c.on == false)
}

ui.window {
    panel
}
