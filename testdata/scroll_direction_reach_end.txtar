A sideways scroll's `@reachEnd` measures the content's width: its end is the
right edge, which comes into view as the scroll moves along x.

android's trigger is the scroll's ScrollBy semantics action, which SnglScroll
reports as it would a finger's; a scroll that measured height scrolled
nothing along y, its content no taller than the viewport, and loaded no page.
html's sentinel sits after the content along the row and watches its left
edge against the box's right; `cmd/sngl/testdata/scroll_reach_end_sideways_runs.txt`
runs it in the browser. fyne's ReachScroll and gtk4's Scroll measure the
content's width and the horizontal offset. bubbletea fires nothing of
itself, and a test's trigger runs the handler.

A scroll moving either way reaches its end at the bottom, so the trigger,
which scrolls along both axes, loads a page there as a vertical one does.

-- app.sngl --
import seq "sngl:seq"
import test "sngl:test"
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
    kotlin {
        android
    }
}

component main ui.node {
    var shown = 10

    ui.scroll #list(direction=horizontal, style={height=120px}, @reachEnd {
        if shown < 30 {
            shown += 10
        }
    }) {
        ui.hbox(style={gap=8px}) {
            for var i = seq.range(0, shown) {
                ui.text(value="column {i}", style={width=160px})
            }
        }
    }
}

// Either way: the end is the bottom, which the trigger reaches as the
// vertical scroll alone does.
component grid ui.node {
    var shown = 40

    ui.scroll #cells(direction=both, style={height=240px}, @reachEnd {
        if shown < 60 {
            shown += 10
        }
    }) {
        ui.vbox {
            for var i = seq.range(0, shown) {
                ui.text(value="row {i}", style={height=48px, width=800px})
            }
        }
    }
}

func testReachEndSidewaysLoadsAPage(t test.Test, c main) {
    var before = c.shown
    c.list.reachEnd()
    t.assert(c.shown > before)
}

func testReachEndEitherWayLoadsAPage(t test.Test, c grid) {
    var before = c.shown
    c.cells.reachEnd()
    t.assert(c.shown > before)
}

ui.window {
    main
    grid
}
