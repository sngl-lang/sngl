-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestReachEndSidewaysLoadsAPage(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	var before int = c.shown__inst0
	c.listReachEnd()
	if !((c.shown__inst0 > before)) { t.Errorf("assert failed: %s", "(c.shown__inst0 > before)") }
}

func TestReachEndEitherWayLoadsAPage(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	var before int = c.shown__inst1
	c.cellsReachEnd()
	if !((c.shown__inst1 > before)) { t.Errorf("assert failed: %s", "(c.shown__inst1 > before)") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
