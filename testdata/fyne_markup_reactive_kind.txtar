A run whose kind or style reads state is written again on fyne when it moves.

fyne's span takes its kind and style in its constructor, and a write the
constructor was built from was answered as the constructor's. A write reading
state is the same expression when the state has moved, so the handler
writing `kind` or `style` again reached nothing: a document's runs, kinds
read from data, never took their token's color. A write reading state goes
to the span's setter now -- `SetToken` for a kind, `SetSpanStyle` for a
style -- and a constant one is still the constructor's.

-- main.sngl --
import ui "sngl:ui"
import markup "sngl:ui/markup"

output {
    go {
        fyne
    }
}

ui.window #home(title="t") {
    var kind = markup.Token.keyword
    var look = markup.SpanStyle{fontWeight=markup.Weight.bold}

    ui.vbox {
        ui.button(text="change", @click {
            kind = markup.Token.function
            look = markup.SpanStyle{fontStyle=markup.Slant.italic}
        })
        markup.richText {
            markup.token(kind=kind) {
                markup.text("moves")
            }
            markup.token(kind=markup.Token.keyword) {
                markup.text("stays")
            }
            markup.run(style=look) {
                markup.text("restyled")
            }
        }
    }
}
