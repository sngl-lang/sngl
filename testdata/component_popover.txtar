A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_popover.sngl --
import . "sngl:ui"
import . "sngl:test"

// popover: state-binding fixture — toggling bound `open` shows
// or hides the popover panel.
component main node {
    var visible = false
    popover(open=visible, position="bottom", openOn="click") {
        button(text="toggle")
    }
}

func testPopoverOpenToggles(t Test, c main) {
    t.assert(c.visible == false)
    c.visible = true
    t.assert(c.visible == true)
    c.visible = false
    t.assert(c.visible == false)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
