package main

import "testing"

func TestPopoverOpenToggles(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.visible == false)) { t.Errorf("assert failed: %s", "(c.visible == false)") }
	c.visible = true
	if !((c.visible == true)) { t.Errorf("assert failed: %s", "(c.visible == true)") }
	c.visible = false
	if !((c.visible == false)) { t.Errorf("assert failed: %s", "(c.visible == false)") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
