import "C"

import (
	"unsafe"
)

func boolToInt(b bool) int {
	if b {
		return 1
	}
	return 0
}

// Model holds the state and widget references for this SNGL UI.
type Model struct {
	visible bool
	__n0    *C.GtkPopover
	__n1    *C.GtkButton
	__root  *C.GtkBox
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	m.visible = false
	return m
}

func (m *Model) __n0_closed_handler() {
}

func (m *Model) __n1_clicked_handler() {
}

func (m *Model) Visible() bool {
	return m.visible
}

func (m *Model) SetVisible(v bool) {
	m.visible = v
}

func (m *Model) buildWidgetTree() {
	if m.__root != nil {
		return
	}
	m.__root = (*C.GtkBox)(unsafe.Pointer(C.gtk_box_new(C.GTK_ORIENTATION_VERTICAL, 6)))
	m.__n0 = (*C.GtkPopover)(unsafe.Pointer(C.gtk_popover_new()))
	C.gtk_widget_set_visible((*C.GtkWidget)(unsafe.Pointer(m.__n0)), C.gboolean(boolToInt(m.visible)))
	C.gtk_popover_set_autohide((*C.GtkPopover)(unsafe.Pointer(m.__n0)), C.gboolean(boolToInt(true)))
	snglCallbacks = append(snglCallbacks, m.__n0_closed_handler)
	C.sngl_connect(unsafe.Pointer(m.__n0), C.CString("closed"), C.int((len(snglCallbacks) - 1)))
	m.__n1 = (*C.GtkButton)(unsafe.Pointer(C.gtk_button_new()))
	C.gtk_button_set_label((*C.GtkButton)(unsafe.Pointer(m.__n1)), C.CString("toggle"))
	snglCallbacks = append(snglCallbacks, m.__n1_clicked_handler)
	C.sngl_connect(unsafe.Pointer(m.__n1), C.CString("clicked"), C.int((len(snglCallbacks) - 1)))
	C.gtk_popover_set_child((*C.GtkPopover)(unsafe.Pointer(m.__n0)), (*C.GtkWidget)(unsafe.Pointer(m.__n1)))
	C.gtk_box_append((*C.GtkBox)(unsafe.Pointer(m.__root)), (*C.GtkWidget)(unsafe.Pointer(m.__n0)))
}

// BuildUI constructs the widget tree and returns the top-level window.
func (m *Model) BuildUI(app *C.GtkApplication) *C.GtkWidget {
	m.buildWidgetTree()
	win := C.gtk_application_window_new(app)
	C.gtk_window_set_default_size((*C.GtkWindow)(unsafe.Pointer(win)), 480, 640)
	C.gtk_window_set_child((*C.GtkWindow)(unsafe.Pointer(win)), (*C.GtkWidget)(unsafe.Pointer(m.__root)))
