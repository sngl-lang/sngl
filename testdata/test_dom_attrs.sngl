component styled {
    var tag = "main"
    var mode = "active"

    text #t(class="header", key="t", value="hello")
    text #d(class=mode, key="d", value="dynamic")
}

test styled "static class" {
    assert(#t.class == "header")
}

test styled "dynamic class" {
    assert(#d.class == "active")
    mode = "inactive"
    assert(#d.class == "inactive")
}
