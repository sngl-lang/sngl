component styled {
    var tag = "main"
    var mode = "active"

    text #t(class="header", key="t", value="hello")
    text #d(class=mode, key="d", value="dynamic")
}

func testStaticClass(t T, c styled) {
    t.assert(c.#t.class == "header")
}

func testDynamicClass(t T, c styled) {
    t.assert(c.#d.class == "active")
    c.mode = "inactive"
    t.assert(c.#d.class == "inactive")
}
