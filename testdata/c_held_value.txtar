A value C holds, through sngl:x/c's held: a parameter written `c.held[T]`
hands C the context a closure's crossing would, finding a copy of the value
in cbind's registry until C calls the release the `#[c.release]` parameter
is handed, and a result written `option[c.held[T]]` finds it again, null
where C answers NULL or a context whose value is gone.

`put` holds a State per key, a closure among its fields, and `swap` hands C
another, which C lets the old one go for, as GLib's g_object_set_data_full
does. `forget` releases key 2 but leaves C answering its stale pointer,
which finds nothing. The test runs it.

-- app.sngl --
import ui "sngl:ui"
import c "sngl:x/c"
import go "sngl:language/go"
import test "sngl:test"

output {
    go {
        bubbletea
    }
}

c.link(include="held.h", sources=["held.c", "held.h"])

struct State {
    title string
    shown func() int
}

#[c.native("sngl_put")]
func put(key int, s c.held[State], #[c.release] release c.pointer)

#[c.native("sngl_get")]
func get(key int) option[c.held[State]]

#[c.native("sngl_forget")]
func forget(key int)

func describe(key int) string {
    var s = get(key)
    if s != null {
        return "{s.title} {s.shown()}"
    }
    return "none"
}

component main ui.node {
    var said = ""
    ui.button #run(text=said, @click {
        var k = 3
        put(1, State{title="one", shown=func() => k})
        put(2, State{title="two", shown=func() => k * 2})
        var first = describe(1)
        put(1, State{title="uno", shown=func() => k + 1})
        forget(2)
        said = "{first}, {describe(1)}, {describe(2)}, {describe(3)}"
    })
}

ui.window(title="t") {
    main()
}

func testHeldValuesComeBack(t test.Test, c main) {
    c.run.click()
    t.assert(c.said == "one 3, uno 4, none, none")
}
-- held.h --
// Holds data for key, letting what key held before go through the release
// it was handed.
void sngl_put(int key, void *data, void (*release)(void *));

// What key holds, or NULL.
void *sngl_get(int key);

// Lets what key holds go, and goes on answering its pointer.
void sngl_forget(int key);
-- held.c --
#include <stddef.h>

#include "held.h"

static struct {
	void *data;
	void (*release)(void *);
} slots[4];

void sngl_put(int key, void *data, void (*release)(void *)) {
	void *old = slots[key].data;
	void (*let)(void *) = slots[key].release;
	slots[key].data = data;
	slots[key].release = release;
	if (old != NULL) {
		let(old);
	}
}

void *sngl_get(int key) {
	return slots[key].data;
}

void sngl_forget(int key) {
	if (slots[key].release != NULL) {
		slots[key].release(slots[key].data);
		slots[key].release = NULL;
	}
}
