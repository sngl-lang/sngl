// The count wrappers are recognised by their #[builtin] kind, never by name, so
// a user declaration of either name shadows them like any other built-in.
//
// `option` here is an ordinary generic struct. Shadowed, it is not a wrapper
// and not a tree, so the slot is refused for naming a value type. Matching by
// name would instead read it as the wrapper and complain about the count, which
// is what tells the two implementations apart.

import . "sngl://std"

struct option<T> {
    v T
}

component frame(slot badge option<int>) { // ERROR(check) "a slot accepts a tree, and option<int> is not one"
    vbox {
        badge {}
    }
}
