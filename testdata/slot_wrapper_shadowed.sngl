// The count wrappers are recognized by their #[builtin] kind, never by name, so
// a user declaration of either name shadows them like any other built-in.
//
// `option` here is an ordinary generic struct. Shadowed, it is not a wrapper
// and not a tree, so the slot is refused for naming a value type. Matching by
// name would instead read it as the wrapper and complain about the count, which
// is what tells the two implementations apart.

import . "sngl:ui"

struct option[T any] {
    v T
}

component frame(badge component option[int]) node { // ERROR(check) "a slot accepts a family, and option[int] is not one"
    vbox {
        badge {}
    }
}

// The insertion count is recognized the same way: shadowed, `option[…]` around a
// slot counts nothing.
component tip(hint option[component]) node { // ERROR(check) "option[…] around a slot is not the builtin option, so it counts nothing"
    vbox {
        hint {}
    }
}

window {
}
