A canvas under a branch draws, and a write elsewhere redraws it, on every
target.

A canvas is a surface and a draw routine its owner holds, and under a branch
its render slot made it. Where it is painted through its protocol, placement
holds it where every function reaches it, so a click outside the slot redraws
it there. Where it is not, html's slot made the element and nothing drew into
it, and fyne's inserted a widget it never declared, which did not build. So a
canvas under a branch on those targets is a component built at run time, as
one under a loop is (passCanvasInstances): what it reads arrives as a prop,
which the click sets, and the setter redraws.

On html a redraw was also lost wherever the handler writing the state came
before the canvas: the handler is translated as its node is reached, and the
canvas had no element id until its own was written, so the redraw was an empty
statement. A canvas's id is now allocated by whichever asks first.

deny out/none/html/index.html `state\.grow \+= 1;\s*;\s*\}` -- the button before the page's canvas redraws it, not an empty statement
-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"

output {
    none {
        html
    }
    go {
        fyne
        gtk4
    }
    c {
        gtk4
        win32
    }
}

var grow = 0.0

component main ui.node {
    var w = 4.0
    var on = true
    ui.vbox {
        ui.button(text="grow", @click {
            w += 1.0
            grow += 1.0
        })
        ui.button(text="flip", @click {
            on = !on
        })
        draw.canvas(width=40px, height=40px) {
            draw.circle(cx=20.0, cy=20.0, r=grow, style=draw.Style{fill=#0000ff})
        }
        if on {
            draw.canvas(width=40px, height=40px) {
                draw.rect(x=0.0, y=0.0, w=w, h=10.0, style=draw.Style{fill=#ff0000})
            }
        }
    }
}

ui.window {
    main()
}
-- out/c/gtk4/main.c --
