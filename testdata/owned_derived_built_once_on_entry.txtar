-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestBuiltOnceOnReentry(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.hideClick()
	c.showClick()
	if !((c.opened == 2)) { t.Errorf("assert failed: %s", "(c.opened == 2)") }
	if !((c.closed == 1)) { t.Errorf("assert failed: %s", "(c.closed == 1)") }
	if !((c.updates == 0)) { t.Errorf("assert failed: %s", "(c.updates == 0)") }
}

func TestRebuiltOnAWriteWhileShown(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.bumpClick()
	if !((c.opened == 2)) { t.Errorf("assert failed: %s", "(c.opened == 2)") }
	if !((c.closed == 1)) { t.Errorf("assert failed: %s", "(c.closed == 1)") }
	if !((c.updates == 1)) { t.Errorf("assert failed: %s", "(c.updates == 1)") }
}


func newTestComponent() Model { return New() }
