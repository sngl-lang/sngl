An `@update` reports the writes made while its bracket ran, so a bracket
whose position is taken in the same pass as a write to its key is owed
nothing, as on the interpreter. `#show` writes `n` while the branch is hidden
and takes it back: `holder`'s `label`, an owned derived value, is made once
when it comes back, not made and then remade by its `@update`, and the
`effect` beside it reports nothing. On bubbletea, which splices `holder`,
the enter function built the value and the report in the same settle built
it again.

-- app.sngl --
import ui "sngl:ui"
import macro "sngl:macro"
import "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

#[macro.owned(close)]
struct file {
    fd int
}

var opened = 0
var closed = 0
var updates = 0

func open(fd int) file {
    opened += 1
    return file{fd=fd}
}

func close(f file) {
    closed += 1
}

component holder(n int) ui.node {
    func label() => open(n)

    ui.text("{label.fd}")
}

component screen ui.node {
    var shown = true
    var n = 1

    ui.vbox {
        ui.button #hide(text="h", @click {
            shown = false
        })
        ui.button #bump(text="b", @click {
            n += 1
        })
        ui.button #show(text="s", @click {
            n += 1
            shown = true
        })
        if shown {
            holder(n=n)
            effect(on=n, @update {
                updates += 1
            })
        }
    }
}

func testBuiltOnceOnReentry(t test.Test, c screen) {
    c.hide.click()
    c.show.click()
    t.assert(opened == 2)
    t.assert(closed == 1)
    t.assert(updates == 0)
}

func testRebuiltOnAWriteWhileShown(t test.Test, c screen) {
    c.bump.click()
    t.assert(opened == 2)
    t.assert(closed == 1)
    t.assert(updates == 1)
}

ui.window(title="t") {
    screen
}
