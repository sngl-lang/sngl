// SKIP(codegen) "names sngl:platform/none, which a per-platform harness does not register"

// An override's restated type is held to the one its declaration's default
// gives the prop, as to a written one.

import "sngl:platform/none"
import ui "sngl:ui"

struct Pad {
    size int
}

component tag(pad = Pad{size=1}) ui.node

component tag[none.platform](pad string) { // ERROR(check) "cannot use string as Pad for parameter \"pad\" of override \"tag\""
    ui.text(value="pad")
}

ui.window {
    tag()
}
