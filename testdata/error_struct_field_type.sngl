// A struct literal's field value is held to the field's type, as an
// initializer of that type is: named, expected-type and prop-position
// literals alike. A string is not an enum member, and a bool is not a length.
//
// Two coercions stay: an int widens to a float, and a bare number literal in
// a unit-typed field is that unit's first base (`padding = 16` is 16px). The
// second is a literal's spelling rather than an assignment rule, so a number
// held in a var is refused as `var l len = x` is, and duration, which has a
// host representation, takes none.

import . "sngl:ui"
import "sngl:time"

enum W { a, b }

unit len { px, em }

struct S {
    w W
    n int
    f float = 0.0
    o option<int>
    l len = 0px
}

struct Box<T> {
    v T
    o option<T>
    xs list<T>
}

struct Out {
    items list<S>
}

struct Wait {
    d time.duration
}

const ok = S{w=b, n=1, f=2, l=4}
const named = S{w="bold", n=1}                       // ERROR(check) "cannot use string as W for field \"w\" of S"
const count = S{w=a, n="x"}                          // ERROR(check) "cannot use string as int for field \"n\" of S"
const anon S = {w=a, n=true}                         // ERROR(check) "cannot use bool as int for field \"n\" of S"
const opt = S{w=a, n=1, o="x"}                       // ERROR(check) "cannot use string as option<int> for field \"o\" of S"
const nested = Out{items=[{w=a, n=1}, {w=a, n="y"}]} // ERROR(check) "cannot use string as int for field \"n\" of S"
const wait = Wait{d=5}                               // ERROR(check) "cannot use int as duration for field \"d\" of Wait"
const box Box<int> = {v=1, o=3, xs=[1]}
const badBox Box<int> = {v=1, o=3, xs=["a"]} // ERROR(check) "cannot use list<string> as list<int> for field \"xs\" of Box"

var x = 3
var held = S{w=a, n=1, l=x} // ERROR(check) "cannot use int as len for field \"l\" of S"

window {
    text(value="x", style={fontWeight=42}) // ERROR(check) "cannot use int as FontWeight for field \"fontWeight\" of Style"
    text(value="y", style={gap=true})      // ERROR(check) "cannot use bool as measurement for field \"gap\" of Style"
    text(value="z", style={color="teal"})  // ERROR(check) "invalid color literal \"teal\""
    text(value=string(ok.n), style={padding=16, fontWeight=bold})
    text(value=string(box.v))
}
