        Text(text = buildAnnotatedString {
            for (r in listOf(Run(kind = SnglToken.KEYWORD, text = "func"), Run(kind = SnglToken.FUNCTION, text = "main"))) {
                withStyle(SpanStyle(color = (tokenColor(Palette(), r.kind)).let { if (it.a == 0.toUByte()) when (r.kind) { SnglToken.KEYWORD -> MaterialTheme.colorScheme.primary; SnglToken.TYPE, SnglToken.FUNCTION -> MaterialTheme.colorScheme.secondary; SnglToken.CONSTANT, SnglToken.STRING, SnglToken.NUMBER -> MaterialTheme.colorScheme.tertiary; SnglToken.COMMENT -> MaterialTheme.colorScheme.onSurfaceVariant; else -> ComposeColor.Unspecified } else ComposeColor(it.r.toInt(), it.g.toInt(), it.b.toInt(), it.a.toInt()) })) {
                    append(r.text)
                }
            }
        }, modifier = Modifier.safeDrawingPadding(), style = LocalTextStyle.current.merge(TextStyle.Default))
    }
}

fun tokenColor(p: Palette, kind: SnglToken): Color {
    if ((kind == SnglToken.KEYWORD)) {
    	return p.keyword
    }
    if ((kind == SnglToken.TYPE)) {
    	return p.type
    }
    if ((kind == SnglToken.FUNCTION)) {
    	return p.function
    }
    if ((kind == SnglToken.VARIABLE)) {
    	return p.variable
    }
    if ((kind == SnglToken.CONSTANT)) {
    	return p.constant
    }
    if ((kind == SnglToken.STRING)) {
    	return p.string
    }
    if ((kind == SnglToken.NUMBER)) {
    	return p.number
    }
    if ((kind == SnglToken.COMMENT)) {
    	return p.comment
    }
    if ((kind == SnglToken.OPERATOR)) {
    	return p.operator
    }
    if ((kind == SnglToken.PUNCTUATION)) {
    	return p.punctuation
    }
    return p.plain
}
