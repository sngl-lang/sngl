// SKIP(codegen) "names sngl:platform/none, which a per-platform harness does not register"

// An override of an event names its receiver as the component declares it,
// selects the event's parameters and no others, and is a method of the
// target's override of the component, so a target with none has nothing for
// its body to read.

import "sngl:platform/none"
import ui "sngl:ui"

component pick[T any](:value T, @change(to T)) ui.node

component pick[none.platform](value, @change) {
    ui.vbox {}
}

func pick.change[none.platform](to) { // ERROR(check) "override \"pick.change\" names its receiver as pick declares it: pick[T]"
}

component dial(:value int, @change(to int)) ui.node

component dial[none.platform](value, @change) {
    ui.vbox {}
}

func dial.change[none.platform](by) { // ERROR(check) "override \"dial.change\" selects \"by\", which dial.change does not declare"
}

component knob(@turn(by int)) ui.node {
    ui.vbox {}
}

func knob.turn[none.platform](by) { // ERROR(check) "override \"knob.turn\" of an event is a method of the override of knob for \"none\", and there is none"
}

ui.window {
    pick(value=1)
    dial(value=1)
    knob()
}
