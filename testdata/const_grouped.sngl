import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

component main ui {
    const (
        MAX_ITEMS = 100
        DEFAULT_NAME = "unnamed"
        PI float = 3.14159
    )

    const SINGLE_CONST = 42

    var count = MAX_ITEMS

    text(value=DEFAULT_NAME)
    text(value=string(count))
    text(value=string(SINGLE_CONST))
}

func testConstants(t Test, c main) {
    t.assert(c.count == 100)
}

app.window {
    main
}
