import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

component conv ui {
    var count = 42
    var rate = 3.14
    var label = "hello"
    var active = true
    text #out(value="{count}")
}

func testStringConversion(t Test, c conv) {
    t.assert(string(c.count) == "42")
    t.assert(string(c.rate) == "3.14")
    t.assert(string(c.active) == "true")
}

func testIntConversion(t Test, c conv) {
    t.assert(int(c.rate) == 3)
    t.assert(int(c.count) == 42)
}

func testFloatConversion(t Test, c conv) {
    t.assert(float(c.count) == 42.0)
    t.assert(float(c.rate) == 3.14)
}

func testComparisons(t Test, c conv) {
    t.assert(c.count > 10)
    t.assert(c.count >= 42)
    t.assert(c.count < 100)
    t.assert(c.count <= 42)
    t.assert(10 < c.count)
    t.assert(c.rate > 3.0)
    t.assert(c.rate < 4.0)
}

func testUnaryNegation(t Test, c conv) {
    t.assert(-c.count == -42)
    t.assert(-c.rate == -3.14)
}

func testIntFloatPromotion(t Test, c conv) {
    t.assert(c.count + c.rate == 45.14)
    t.assert(c.rate * c.count > 131.0)
    t.assert(c.rate * c.count < 132.0)
}

func testInterpolationPrimitives(t Test, c conv) {
    t.assert("{c.count}" == "42")
    t.assert("{c.rate}" == "3.14")
    t.assert("{c.active}" == "true")
    t.assert("{c.label}" == "hello")
}

app.window {
}
