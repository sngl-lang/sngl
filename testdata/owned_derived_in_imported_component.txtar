-- out/go/fyne/model_test.go --
package main

import "testing"

func TestMadeOnce(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.opened == 1)) { t.Errorf("assert failed: %s", "(c.opened == 1)") }
	if !((c.closed == 0)) { t.Errorf("assert failed: %s", "(c.closed == 0)") }
}

func TestRekeyedReleasesTheOldValue(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.opened == 1)) { t.Errorf("assert failed: %s", "(c.opened == 1)") }
	c.n = 2
	c.__effect1_mark()
	c.__effects0_settle()
	if !((c.opened == 2)) { t.Errorf("assert failed: %s", "(c.opened == 2)") }
	if !((c.closed == 1)) { t.Errorf("assert failed: %s", "(c.closed == 1)") }
	if !((c.lastClosed == 1)) { t.Errorf("assert failed: %s", "(c.lastClosed == 1)") }
}

