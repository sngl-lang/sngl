An owned derived value in a component another package declares is a var of
the node on a target as it is on the interpreter, and its release is emitted.
`OwnedState` reached `p.framed` already -- a build's copy of a reached
package is its own to rewrite -- but `close` was declared nowhere: a user
package's functions are taken by what the program calls
(`reachableForeignFuncs`), and nothing calls a release before lowering writes
the call, so the Go emitted `close(…)` against Go's own builtin. The walk now
follows an owned type's release as it does the function that made the value.

deny * `close\(load\(` -- a derived value read is a read of its var

-- app.sngl --
import p "./p"
import ui "sngl:ui"
import "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
}

component page ui.node {
    var n = 1

    ui.vbox {
        p.framed(w=n)
    }
}

func testMadeOnce(t test.Test, c page) {
    t.assert(p.opened == 1)
    t.assert(p.closed == 0)
}

func testRekeyedReleasesTheOldValue(t test.Test, c page) {
    c.n = 2
    t.assert(p.opened == 2)
    t.assert(p.closed == 1)
    t.assert(p.lastClosed == 1)
}

ui.window(title="t") {
    page
}
-- p/p.sngl --
import ui "sngl:ui"
import macro "sngl:macro"

#[macro.owned(close)]
struct pic {
    n int
}

var opened = 0
var closed = 0
var lastClosed = 0

func close(p pic) {
    closed += 1
    lastClosed = p.n
}

func load(n int) pic {
    opened += 1
    return pic{n=n}
}

component framed(w int) ui.node {
    func picture() => load(w)

    ui.text(value="{picture.n}")
}
