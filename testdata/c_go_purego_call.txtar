A Go program whose `cgo` option is "purego" calls C with no cgo: each C
function it calls is a func variable of its own, bound at start through
purego (pkg/go/cload) to the function of that name in the library its
c.link names, here libm, and a call hands it Go's values. A double, an int
and a bool cross as the Go type of the C one's size, a string as purego
copies it, and a handle C holds opaquely (`FILE *`) as an unsafe.Pointer.

The test runs it: cos(0) is 1, abs(-3) is 3, '7' is a digit, strlen counts
"hello", and the file fopen opens closes.

deny out/go/bubbletea/model.go `import "C"` -- no cgo
deny out/go/bubbletea/sngl_purego.go `import "C"` -- nor where the functions are bound

-- app.sngl --
import c "sngl:x/c"
import test "sngl:test"
import ui "sngl:ui"

output {
    go(cgo="purego") {
        bubbletea
    }
}

c.link(include="math.h", system=true, library="m")

#[c.native("FILE *")]
struct File {}

#[c.native("cos")]
func cos(x float) float

#[c.native("abs")]
func abs(n int) int

#[c.native("isdigit")]
func isDigit(ch int) bool

#[c.native("unsigned long")]
struct Size = int

#[c.native("strlen")]
func length(s string) Size

#[c.native("fopen")]
func open(path string, mode string) File

#[c.native("fclose")]
func close(f File) int

component main ui.node {
    var n = -3
    ui.button(text="{abs(n)}", @click {
        n -= 1
    })
}

func testCallsC(t test.Test, c main) {
    t.assert(cos(0.0) == 1.0)
    t.assert(abs(c.n) == 3)
    t.assert(isDigit(55))
    t.assert(!isDigit(65))
    t.assert(length("hello") == 5)
    t.assert(close(open("/dev/null", "r")) == 0)
}

ui.window(title="t") {
    main()
}
