-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestCallsC(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((float64(snglC_cos(float64(0.0))) == 1.0)) { t.Errorf("assert failed: %s", "(float64(snglC_cos(float64(0.0))) == 1.0)") }
	if !((int(snglC_abs(int32(c.n))) == 3)) { t.Errorf("assert failed: %s", "(int(snglC_abs(int32(c.n))) == 3)") }
	if !((snglC_isdigit(int32(55)) != 0)) { t.Errorf("assert failed: %s", "(snglC_isdigit(int32(55)) != 0)") }
	if !(!(snglC_isdigit(int32(65)) != 0)) { t.Errorf("assert failed: %s", "!(snglC_isdigit(int32(65)) != 0)") }
	if !((int(snglC_strlen("hello")) == 5)) { t.Errorf("assert failed: %s", "(int(snglC_strlen(\"hello\")) == 5)") }
	if !((int(snglC_fclose(snglC_fopen("/dev/null", "r"))) == 0)) { t.Errorf("assert failed: %s", "(int(snglC_fclose(snglC_fopen(\"/dev/null\", \"r\"))) == 0)") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
