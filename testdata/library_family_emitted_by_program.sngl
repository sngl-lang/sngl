// SKIP(codegen) "names sngl:language/go, which a per-platform harness does not register"
// A program's gen.emit override of a library family answers for a bodyless
// host of that family, as a target package's would.
import gen "sngl:x/gen"
import go "sngl:language/go"
import draw "sngl:ui/draw"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

component draw.shape[go.language]() {
    gen.emit(file="shapes.txt", open="[\n", close="]\n")
}

component scene(shapes ...component draw.shape) root

ui.window {
    ui.text(value="hi")
}
