What html does with a ui.Style: a literal, a var, a prop and a reactive one
side by side, em and rem lengths and a sum of two, the spacing, size, color,
border, font and alignment fields, vbox and hbox children with `flex` and
`margin`, a Style in a constant loop the static fold unrolls, one in each page
of a stack, and one on an instance built at run time. Under --lang none and in
route mode under --lang go.

A narrower declaration is written after a wider one, so it wins: `padding`,
then `paddingX`, then `paddingTop`, and `border` before `borderWidth`. And a
`borderStyle` or a `border` beside a `borderWidth` is the line drawn, where
the width's default `solid` used to be written after it, and a side's border
shorthand comes after the width, color and style it narrows.

deny out/none/html/index.html `padding-top:4px;[^"]*padding:16px` -- the whole box's padding never comes after a side
deny out/none/html/index.html `border-width:3px;[^"]*border:1px` -- the border shorthand never comes after its width
deny out/none/html/index.html `border-style:dashed;[^"]*border-style:solid` -- borderWidth's default line never overrides a borderStyle
deny out/none/html/index.html `(?s)s\.paddingTop != null.*s\.paddingX != null` -- a held Style writes a side after its axis too
deny out/none/html/index.html `border:1px dashed #000;border-width:3px;border-style:solid` -- a border shorthand's line is not reset by the width's default
deny out/none/html/index.html `border-bottom:1px dashed #f00;[^"]*border-width:3px` -- a side's border is written after the width it narrows
deny out/none/html/index.html `\(s\.borderWidth != null && s\.borderStyle == null\)` -- a held Style's border shorthand keeps its line too
deny out/none/html/index.html `(?s)s\.borderBottom != null.*s\.borderWidth != null` -- a held Style writes a side's border after the width
-- app.sngl --
import ui "sngl:ui"
import nav "sngl:ui/nav"

output {
    go {
        html
    }
    none {
        html
    }
}

const tints list[color] = [#336699, #993366]

var held ui.Style = {color=#336699, fontSize=1em, paddingX=8px, background=#eeeeee}
var tone = #336699

component labelled(look ui.Style) {
    ui.text(value="prop", style=look)
}

component toggled(label string) ui.node {
    var on = false

    ui.button(text=label, style={fontWeight=on ? ui.FontWeight.bold : ui.FontWeight.normal, paddingX=on ? 8px : 2px}, @click { on = !on })
}

ui.window(title="Style") {
    var rows = ["a"]

    nav.stack #pages {
        nav.page #home(href="/", title="Home") {
            ui.vbox(style={gap=12px, padding=1rem, alignItems=ui.Alignment.center}) {
                ui.text(value="literal", style={color=#336699, fontSize=1em, paddingX=8px, background=#eeeeee})
                ui.text(value="var", style=held)
                labelled(look=held)
                ui.text(value="reactive", style={color=tone})
                ui.text(value="sum", style={width=3px + 2em, marginTop=1.5rem})
                ui.text(value="sides", style={padding=16px, paddingX=8px, paddingTop=4px, border="1px solid #000", borderWidth=3px})
                ui.text(value="lines", style={border="1px dashed #000", borderWidth=3px})
                ui.text(value="bottom", style={borderWidth=3px, borderBottom="1px dashed #f00"})
                ui.button(text="recolor", style={borderWidth=2px, borderColor=#ff0000, borderRadius=4px, borderStyle=ui.BorderStyle.dashed, minWidth=200px, height=2em}, @click {
                    tone = #993366
                })
                ui.text(value="type", style={fontFamily="monospace", fontWeight=ui.FontWeight.bold, fontStyle=ui.FontStyle.italic, textAlign=ui.TextAlign.center, maxLines=2, opacity=0.5})
                ui.hbox(style={justifyContent=ui.Justification.spaceBetween}) {
                    ui.button(text="one", style={flex=1.0, margin=4px})
                    ui.button(text="two", style={flex=2.0, marginLeft=1em})
                }
                ui.vbox {
                    ui.text(value="kept apart", style={margin=8px})
                    ui.text(value="beside", style={display=ui.Display.none})
                }
                for var t = tints {
                    ui.text(value="tint", style={color=t, paddingLeft=4px})
                }
                for var r = rows {
                    toggled(label=r)
                }
                ui.button(text="more", @click { rows = ["a", "b"] })
            }
        }
        nav.page #about(href="/about", title="About") {
            ui.text(value="about", style={color=#993366, padding=2em})
        }
    }
}
-- out/go/html/server.go --
package main

import (
	"fmt"
	"log"
	"net"
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleHome)
	mux.HandleFunc("GET /about", handleAbout)
	return mux
}

