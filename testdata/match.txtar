A match is the target's own switch where its language declares one: Go's
`switch` -- in bubbletea's View too -- Kotlin's `when` -- in a composable too,
which android's view renders -- and JavaScript's `switch` for a statement, its
ternaries for a value. The last arm of an exhaustive match is taken unasked, a
`default` or an `else`, except in Kotlin, which keeps its patterns so the
compiler checks the `when` covers the enum. A subject that calls anything is
evaluated once: a switch evaluates its own, and where the ternaries stand for
it, it is bound to a local ahead of the statement.

deny * `(?:roll__inst0|bump)\(\w*\)\)? ==` -- a subject that calls is evaluated once and its local compared, never called again per arm
deny * `==+ (?:"pending"|Status\.PENDING)` -- the last arm of an exhaustive match is taken unasked
deny out/go/bubbletea/model.go `if n == 0` -- describe's match is a switch
deny out/go/fyne/model.go `if __match` -- a handler's match is a switch on its subject
deny out/go/gtk4/model.go `__match\d` -- a switch evaluates its subject once, with no local bound for it
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `__match\d` -- a when evaluates its subject once, with no local bound for it
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `if \(\(status__inst0 == Status\.ACTIVE\)\)` -- a view's match is a when in the composable
deny out/go/bubbletea/model.go `if m\.status__inst0 == "active"` -- a view's match is a switch in View
deny out/none/html/index.html `if \(n === 0\)` -- describe's match is a switch

-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        gtk4
        fyne
        bubbletea
    }
    kotlin {
        android
    }
}

enum Status { active, inactive, pending }

var bumps = 0

func bump(s Status) Status {
    bumps = bumps + 1
    return s
}

func label(s Status) => match bump(s) {
    active => "on"
    else => "off"
}

func describe(n int) string {
    match n {
        0 { return "zero" }
        1, 2, 3 { return "few" }
        else { return "many" }
    }
}

component panel ui.node {
    var status Status = pending
    var rolls = 0

    func roll() Status {
        rolls = rolls + 1
        return status
    }

    match status {
        active { ui.text(value="on") }
        inactive { ui.text(value="off") }
        pending { ui.text(value="waiting") }
    }

    ui.text(value=match status {
        active => "on"
        else => "not on"
    })

    ui.text(value=match {
        rolls > 10 => "many"
        rolls > 0 => describe(rolls)
        else => "none"
    })

    var last = ""

    ui.button(text="Roll", @click {
        match roll() {
            active { status = Status.inactive }
            inactive { status = Status.pending }
            pending { status = Status.active }
        }
        last = match roll() {
            active => label(status)
            else => "rolled"
        }
    })
    ui.text(value=last)
}

ui.window {
    panel
}
