`match` is checked into an if/else-if chain where it is a statement and a
chain of ternaries where it is a value, so no backend learns there was one.
What the generated code shows is the lowering's two promises: the last arm of
an exhaustive match is taken unasked, and a subject that calls anything is
evaluated once in an imperative body, bound to a local ahead of the statement.

deny * `(?:roll__inst0|bump)\(\w*\)\)? ==` -- a subject that calls is evaluated once and its local compared, never called again per arm
deny * `==+ (?:"pending"|Status\.PENDING)` -- the last arm of an exhaustive match is taken unasked

-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        gtk4
        fyne
        bubbletea
    }
    kotlin {
        android
    }
}

enum Status { active, inactive, pending }

var bumps = 0

func bump(s Status) Status {
    bumps = bumps + 1
    return s
}

func label(s Status) => match bump(s) {
    active => "on"
    else => "off"
}

func describe(n int) string {
    match n {
        0 { return "zero" }
        1, 2, 3 { return "few" }
        else { return "many" }
    }
}

component panel ui.node {
    var status Status = pending
    var rolls = 0

    func roll() Status {
        rolls = rolls + 1
        return status
    }

    match status {
        active { ui.text(value="on") }
        inactive { ui.text(value="off") }
        pending { ui.text(value="waiting") }
    }

    ui.text(value=match status {
        active => "on"
        else => "not on"
    })

    ui.text(value=match {
        rolls > 10 => "many"
        rolls > 0 => describe(rolls)
        else => "none"
    })

    var last = ""

    ui.button(text="Roll", @click {
        match roll() {
            active { status = Status.inactive }
            inactive { status = Status.pending }
            pending { status = Status.active }
        }
        last = match roll() {
            active => label(status)
            else => "rolled"
        }
    })
    ui.text(value=last)
}

ui.window {
    panel
}
