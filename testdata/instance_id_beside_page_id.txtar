package main

import "testing"

func TestThePageKeepsItsNode(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.outer == "outer")) { t.Errorf("assert failed: %s", "(c.outer == \"outer\")") }
	c.on = false
	c.__effects0_settle()
	c.on = true
	c.__effects0_settle()
	if !((c.outer == "outer")) { t.Errorf("assert failed: %s", "(c.outer == \"outer\")") }
}


func newTestComponent() Model { return Model{&modelState{}} }

