A page's node and one of an instance built at run time under its `if` may
share an id, since uniqueNodeIDs holds ids apart per owner: fyne built the
instance's `#failed`, a box, from the page's `ui.text #failed`, as a
Label it then added children to.
-- app.sngl --
import test "sngl:test"
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
        gtk4
        bubbletea
    }
    kotlin {
        android
    }
}

component sign(:msg string = "inner") ui.node {
    ui.vbox {
        ui.text(msg)
        ui.button(text="again", @click { msg = "again" })
    }
}

component asked ui.node {
    var shown = true

    if shown {
        sign #failed()
    }
}

component page ui.node {
    var on = true
    var outer = "outer"

    ui.vbox {
        ui.text #failed(outer)
        if on {
            asked()
        }
    }
}

func testThePageKeepsItsNode(t test.Test, c page) {
    t.assert(c.failed.value == "outer")
    c.on = false
    c.on = true
    t.assert(c.failed.value == "outer")
}

ui.window {
    page
}
