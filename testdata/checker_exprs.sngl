import . "sngl:ui"

struct Config {
    name string = ""
    value int = 0
}

component Widget(title = "default", count = 0, active = true, items list<int> = [], config Config) node {
    func label() => title + ": " + string(count)
    func doubled() => count * 2
    func negated() => -count
    func toggled() => !active
    func selected() => active ? "yes" : "no"
    func converted() => float(count) + 0.5
    func namespaceMethod() => int.abs(count)
    func instanceMethod() => title.length()
    func fieldAccess() => config.name
    func indexAccess() => items[0]
    func listVal() => [1, 2, 3]
    func structVal() => Config{name="test", value=42}
    func interpVal() => "count={string(count)}"

    vbox {
        text(value=label)
        text(value=string(doubled))
        text(value=selected)
    }
}

component main node {
    var n = 10
    var active = true
    var things = [1, 2, 3]
    var cfg Config = {name="hello", value=5}

    Widget(title="test", count=n, active=active, items=things, config=cfg)
    text(value=string(n))
}

window {
    main
}
