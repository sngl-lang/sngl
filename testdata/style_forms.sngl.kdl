app {
    vbox style.padding=8 style.gap=4 {
        text value="styled" {
            @style {
                font-size 24
                font-weight "bold"
                color "#007700"
            }
        }
        button style.margin=4 text="click" {
            @style {
                padding 8
                background "#ff0000"
            }
        }
    }
}
