// A C struct's fields, and what a C function's `ref` fills, are values C has
// a type for that hold no memory either side owns: a scalar, a typedef's alias
// of one, or a C struct. A C struct crosses by value, so a callback, which
// hands C's values over as they are, takes none.
import c "sngl:x/c"

c.link(include="calls.h")

#[c.native("NAMED")]
struct Named {
    name string // ERROR(check) "field \"name\" of Named, the C struct NAMED, is a string"
    n    int
}

#[c.native("POINT")]
struct Point {
    x int
    y int
}

#[c.native("fill_name")]
func fillName(s ref[string]) // ERROR(check) "parameter \"s\" is a ref[string], and a ref a C function fills is to an int, float or bool"

#[c.native("fill_point")]
func fillPoint(p ref[Point])

#[c.native("fill_maybe_point")]
func fillMaybePoint(p ref[option[Point]]) // ERROR(check) "parameter \"p\" is a ref[option[Point]], and a ref a C function fills is to"

#[c.native("each_point")]
func eachPoint(f func(p Point), #[c.context] data c.pointer) // ERROR(check) "callback \"f\" takes a Point"
