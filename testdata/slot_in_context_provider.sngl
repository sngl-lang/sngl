// A slot insertion point nested inside a context provider is still an
// insertion point, for the rest slot and a named one alike. The two
// projections disagreed about a provider's children until they became one
// walk; the optimizer's inliner is what reaches this today.

import . "sngl:ui"

context #theme("light")

component framed(children ...component, caption component) node {
    theme("dark") {
        vbox {
            children
            caption {
                text(value="(none)")
            }
        }
    }
}

component main node {
    framed() {
        component caption {
            text(value="caption")
        }
        text(value="framed child")
    }
}

window {
    main
}
