A ui.tabs on gtk4 is a box holding a GtkNotebook, read here off GTK's own
widgets in C and Go: each tab a page whose tab shows its title, insensitive
where it is disabled, and the page shown the program's `selected`.

The program writing `selected` shows the page and reports nothing; the
user choosing a tab writes it and fires @change, unless the tab is
disabled, when the program's page comes back; a tab taken away and put
back is a page again, last; a title or a disabled flag written while the
tab is shown changes its tab.

exec out/c/gtk4 -- said.txt
exec out/go/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"

c.link(include="peek.h", pkgConfig=["gtk4"], sources=["peek.c", "peek.h"])

#[c.native("peek")]
func peek(tabs ui.node)

#[c.native("click_tab")]
func clickTab(tabs ui.node, k int)

#[c.native("say")]
func say(s string)

output {
    c { gtk4 }
    go { gtk4 }
}

var (
    ticks = 0
    at = 1
    changes = 0
    third = true
    second = "Two"
    locked = true
)

func look(what string) {
    say("{what}: selected {at}, changes {changes}")
    peek(strip)
}

time.timer(interval=100ms, @tick {
    ticks += 1
    if ticks == 2 {
        look("built")
        at = 2
    }
    if ticks == 3 {
        look("program chose 2")
        clickTab(strip, 0)
        look("user chose 0")
        clickTab(strip, 3)
        look("user chose disabled 3")
        third = false
    }
    if ticks == 4 {
        look("third taken away")
        third = true
    }
    if ticks == 5 {
        look("third put back")
        second = "Second"
        locked = false
    }
    if ticks == 6 {
        look("retitled and unlocked")
        clickTab(strip, 2)
        look("user chose 2")
        gtk4.quit()
    }
})

ui.window(title="t") {
    ui.tabs #strip(:selected=at, @change(i) { changes += 1 }) {
        ui.tab(label="One") {
            ui.text(value="one")
        }
        ui.tab(label=second) {
            ui.text(value="two")
        }
        if third {
            ui.tab(label="Three") {
                ui.text(value="three")
            }
        }
        ui.tab(label="Four", disabled=locked) {
            ui.text(value="four")
        }
    }
}
-- peek.c --
#include "peek.h"

#include <stdio.h>

static GtkNotebook *notebook(GtkWidget *tabs) {
    return GTK_NOTEBOOK(gtk_widget_get_first_child(tabs));
}

void peek(GtkWidget *tabs) {
    GtkNotebook *nb = notebook(tabs);
    int n = gtk_notebook_get_n_pages(nb);
    printf("  shown %d of %d:", gtk_notebook_get_current_page(nb), n);
    for (int i = 0; i < n; i++) {
        GtkWidget *page = gtk_notebook_get_nth_page(nb, i);
        GtkWidget *label = gtk_notebook_get_tab_label(nb, page);
        const char *text = gtk_notebook_get_tab_label_text(nb, page);
        printf(" [%s%s]", text ? text : "(none)", label && !gtk_widget_get_sensitive(label) ? " off" : "");
    }
    printf("\n");
    fflush(stdout);
}

void click_tab(GtkWidget *tabs, int k) {
    gtk_notebook_set_current_page(notebook(tabs), k);
}

void say(const char *s) {
    puts(s);
    fflush(stdout);
}
-- peek.h --
#include <gtk/gtk.h>

// peek prints the notebook a tabs holds: the page shown, and each page's tab
// title, " off" where its tab is insensitive; click_tab shows page k as a
// user's click on its tab does; say prints s.
void peek(GtkWidget *tabs);
void click_tab(GtkWidget *tabs, int k);
void say(const char *s);
-- said.txt --
built: selected 1, changes 0
  shown 1 of 4: [One] [Two] [Three] [Four off]
program chose 2: selected 2, changes 0
  shown 2 of 4: [One] [Two] [Three] [Four off]
user chose 0: selected 0, changes 1
  shown 0 of 4: [One] [Two] [Three] [Four off]
user chose disabled 3: selected 0, changes 1
  shown 0 of 4: [One] [Two] [Three] [Four off]
third taken away: selected 0, changes 1
  shown 0 of 3: [One] [Two] [Four off]
third put back: selected 0, changes 1
  shown 0 of 4: [One] [Two] [Three] [Four off]
retitled and unlocked: selected 0, changes 1
  shown 0 of 4: [One] [Second] [Three] [Four]
user chose 2: selected 2, changes 2
  shown 2 of 4: [One] [Second] [Three] [Four]
