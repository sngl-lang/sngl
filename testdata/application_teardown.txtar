Every host tears the application down where it ends: the root tree unmounts
(the probe's @unmount and the timer), and then `Teardown` releases the token
the tick builds from constants and, last, the one the package var holds. gtk4 and fyne do it when their loop exits,
bubbletea with the final model once its program returns, html on `pagehide`,
and android when MainScreen's composition is disposed with the activity --
remembered ahead of everything else there, so it is disposed after them.
Before android called nothing, and the token was never released.

testdata/platform_run_handler_runs.txtar runs it on gtk4 and fyne.

-- app.sngl --
import macro "sngl:macro"
import time "sngl:time"
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

#[macro.owned(release)]
struct token {
    id int
}

var log list[string] = []

func release(t token) {
    log.push("release {t.id}")
}

func report(t token) {
    log.push("tick {t.id}")
}

func issue(id int) => token{id=id}

var held = issue(3)

time.timer(interval=100ms, @tick {
    report(token{id=7})
    log.push("held {held.id}")
})

component probe ui.node {
    effect(@unmount {
        log.push("unmount")
    })
    ui.text(value=log.join(","))
}

ui.window {
    probe()
}
