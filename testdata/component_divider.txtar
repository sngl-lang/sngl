A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

On fyne a divider with no caption is a separator: it was a blank label, a
row of nothing where the line should be.

deny out/go/fyne/model.go `SetText\(""\)` -- no divider is a blank label

-- component_divider.sngl --
import . "sngl:ui"

// divider: A-tier — only style/direction/label, no testable state.
component main node {
    vbox {
        text(value="Section 1")
        divider
        text(value="Section 2")
        divider(label="OR")
        text(value="Section 3")
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
