A two-parameter event on an instance the build keeps.

The `card` instances sit under a loop over state, so on a target without
native reactivity each one is kept alive at run time rather than inlined, and
passInstanceEvents says its event as a func-typed prop: the declaration's two
parameters become the prop's signature, the emit a call of it, and the
handler the call site wrote the prop's value. event_params.txtar is the
inlined case.

deny * `emit\(` -- every emit is called through its prop or substituted, never left as a call to a function nothing declares

-- event_params_instance.sngl --
import . "sngl:ui"

component card(label string, @pick(index int, label string)) node {
    var clicks = 0

    button(text=label, @click {
        clicks += 1
        pick(clicks, label)
    })
}

component main node {
    var picked = ""
    var at = 0
    var names = ["a", "b"]

    for var n = names {
        card(label=n, @pick(i, l) {
            at = i
            picked = l
        })
    }
    text(value="{picked} at {at}")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
}
