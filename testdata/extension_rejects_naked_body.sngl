import sngl "sngl:ui"
import app "sngl:app"

// An override implements one declaration for one target and says which on its
// own name. Naming another package's declaration without one is not a
// declaration of anything.
component sngl.text { // ERROR(check) "must name the target it implements"
    span(textContent=value) {}
}

component main sngl.ui {
    text(value="hi")
}

app.window {
    main
}
