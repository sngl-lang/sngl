// The index of an assignment's target is a value read, not storage: a key or
// an index narrowed by a null test reads as what it holds there as anywhere,
// in `m[k].f = v`, `xs[i].f += 1` and a toggle, while the target itself is
// still the storage written. A `for` head's narrowing holds there too.
import "sngl:test"
import ui "sngl:ui"

struct Node {
    seen   bool = false
    hits   int = 0
    parent option[int] = null
}

var nodes map[int, Node] = {1=Node{}, 2=Node{parent=1}, 3=Node{parent=2}}
var row list[Node] = [Node{}, Node{}]

func mark(k option[int]) {
    if k != null {
        nodes[k].seen = true
        nodes[k].hits += 1
    }
}

func flip(i option[int]) {
    if i != null {
        row[i].seen!!
    }
}

func climb(start option[int]) int {
    var at = start
    var steps = 0
    for at != null {
        nodes[at].hits += 10
        steps += 1
        at = nodes[at].parent
    }
    return steps
}

func testANarrowedKeyIndexesATarget(t test.Test) {
    mark(2)
    mark(null)
    t.assert(nodes[2].seen)
    t.assert(nodes[2].hits == 1)
    t.assert(nodes[1].seen == false)
}

func testANarrowedIndexIndexesAToggle(t test.Test) {
    flip(1)
    t.assert(row[1].seen)
    t.assert(row[0].seen == false)
}

func testALoopHeadNarrowsATarget(t test.Test) {
    t.assert(climb(3) == 3)
    t.assert(nodes[1].hits == 10)
    t.assert(nodes[3].hits == 10)
}

ui.window(title="t") {
}
