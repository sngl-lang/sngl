An input's `@change` fires on commit on fyne and gtk4, with the committed text.

`sngl:ui` declares `@change(value string)` on input and textarea, fired on
commit. fyne's Entry wired `@input` and nothing else, so a handler for
`@change` was a Model method taking a payload no Go file declared; gtk4's
entry override did not connect a commit signal either. fyne now connects
`OnSubmitted` and gtk4 `activate`, and the override hands on what the host
reports -- the callback's string on fyne, the entry's text read off the widget
on gtk4 -- as the event's parameter, which the handler reads wherever it
likes. codegen/platform/fyne/input_change_run_test.go fires the callback and
reads the state it set.

deny * `\be\.Value\b` -- the handler's parameter is the text, not a struct holding it
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
        gtk4
    }
}

component Row(label string) node {
    var committed = ""

    vbox {
        input(@change(e) { committed = e })
        textarea(@change(e) { committed = "{label}:{e}" })
        text(value=committed)
    }
}

component main node {
    var last = ""
    var items = ["a"]

    vbox {
        input(@change(e) { last = "got " + e })
        text(value=last)
        for var it = items {
            Row(label=it)
        }
    }
}

func testChange(t Test, c main) {
    t.assert(c.last == "")
}

window {
    main
}
