An input's `@change` fires on commit on fyne and gtk4, with the committed text.

`sngl:ui` declares `@change ChangeEvent` on input and textarea, fired on
commit, and the interpreter fills the payload's first field with what the
host reported. fyne's Entry wired `@input` and nothing else, so a handler for
`@change` was a Model method taking a `ChangeEvent` no Go file declares; gtk4's
entry override did not connect a commit signal either. fyne now connects
`OnSubmitted` and gtk4 `activate`, and each reads the payload's value off what
the host hands over -- the callback's string on fyne, the entry's text on
gtk4 -- wherever the handler reads it, not only in a leading two-way bind.
codegen/platform/fyne/input_change_run_test.go fires the callback and reads
the state it set.

deny * `ChangeEvent` -- no handler is handed the SNGL event
deny * `\be\.Value\b` -- the payload is read off the host
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
        gtk4
    }
}

component Row(label string) node {
    var committed = ""

    vbox {
        input(@change(e) { committed = e.value })
        textarea(@change(e) { committed = "{label}:{e.value}" })
        text(value=committed)
    }
}

component main node {
    var last = ""
    var items = ["a"]

    vbox {
        input(@change(e) { last = "got " + e.value })
        text(value=last)
        for var it = items {
            Row(label=it)
        }
    }
}

func testChange(t Test, c main) {
    t.assert(c.last == "")
}

window {
    main
}
