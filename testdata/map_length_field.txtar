// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	stock map[string]int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.stock = map[string]int{"a": 1}
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Stock() map[string]int {
	return m.stock
}

func (m Model) SetStock(v map[string]int) Model {
	m.stock = v
	return m
}

type setStockMsg struct{ value map[string]int }

func SetStockCmd(v map[string]int) tea.Cmd {
	return func() tea.Msg { return setStockMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setStockMsg:
		m = m.SetStock(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(len(m.stock))))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
