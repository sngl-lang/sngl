An `i18n.locale("es-MX")` provider block threads its literal locale into every
i18n stdlib call in its subtree, resolved at compile time: the locale arrives
as the first argument to `i18n.NumberInt` rather than being looked up at
runtime, and the Go runtime package is imported for it.

A var declared inside the provider block is still component state -- `price`
gets a Model field and a setter, the same as one declared at the top level.
This locks the end-to-end behaviour demonstrated by hand in 932834d.

-- app.sngl --
import . "sngl:ui"
import "sngl:i18n"
import app "sngl:app"

output { go { bubbletea } }

component main node {
    var n = 1234
    i18n.locale("es-MX") {
        var price = i18n.numberInt(n, "decimal")
        text(value=price)
    }
}

app.window {
    main
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/i18n"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	n__inst0     int
	price__inst0 string

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.n__inst0 = 1234
	m.price__inst0 = i18n.NumberInt("es-MX", m.n__inst0, "decimal")
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) N__inst0() int {
	return m.n__inst0
}

func (m Model) SetN__inst0(v int) Model {
	m.n__inst0 = v
	return m
}

type setN__inst0Msg struct{ value int }

func SetN__inst0Cmd(v int) tea.Cmd {
	return func() tea.Msg { return setN__inst0Msg{value: v} }
}

func (m Model) Price__inst0() string {
	return m.price__inst0
}

func (m Model) SetPrice__inst0(v string) Model {
	m.price__inst0 = v
	return m
}

type setPrice__inst0Msg struct{ value string }

func SetPrice__inst0Cmd(v string) tea.Cmd {
	return func() tea.Msg { return setPrice__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setN__inst0Msg:
		m = m.SetN__inst0(msg.value)
	case setPrice__inst0Msg:
		m = m.SetPrice__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(m.price__inst0))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
