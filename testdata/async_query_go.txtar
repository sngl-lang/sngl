`async.query` over a fetch that blocks, on the Go targets. The mount's
blocking call runs on a goroutine and the rest of it is posted back to the
drawing thread, so the answer lands where the widgets are; the key the mount
was handed is read before the goroutine starts, since the next settle
overwrites it. A query in a component built per copy of a loop runs in each
copy's record.

deny out/go/fyne/model.go `go func\(\) \{\n\s*r := Lookup\(m\.` -- the goroutine reads no state: the key is bound before it starts
deny out/go/gtk4/model.go `go func\(\) \{\n\s*r := Lookup\(m\.` -- the goroutine reads no state: the key is bound before it starts

-- app.sngl --
import async "sngl:async"
import . "sngl:ui"
import go "sngl:language/go"

#[go.native("time", "time.Sleep")]
#[go.async]
func sleep(ns int)

func lookup(name string, life async.Lifetime) async.Result[int] {
    sleep(1000)
    if name == "" {
        return {failed={kind=async.FailureKind.request, message="no name", code="400"}}
    }
    return {ok=name.length()}
}

component detail node {
    var name = "apricot"
    var length option[int] = null
    var loading = false
    var failure option[async.Failure] = null

    async.query #q(on=name, fetch=lookup, :value=length, :pending=loading, :failure=failure)

    text(value=length != null ? "{length}" : "-")
    text(value="{loading}")
    text(value=failure != null ? failure.message : "")
    button(text="fig", @click { name = "fig" })
    button(text="again", @click { q.refresh() })
}

component card(name string) node {
    var length option[int] = null
    async.query(on=name, fetch=func(k string, life async.Lifetime) => lookup(k, life), :value=length)
    text(value=length != null ? "{name} {length}" : name)
}

component cards node {
    var names = ["blueberry", "fig"]
    for var n = names {
        card(name=n)
    }
    button(text="add", @click { names.push("grape") })
}

window {
    detail
    cards
}

output {
    go {
        fyne
        gtk4
    }
}
