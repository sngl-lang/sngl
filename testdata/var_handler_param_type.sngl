// A var handler's parameter is the value that changed, so the var's own type
// is the signature it binds against.
//
// SKIP(codegen) "#197: no backend binds a var handler its parameter. Every target already has the value in scope as the setter's own parameter, so the fix is a rename, not a mechanism -- html emits the body into $set_<var>(v) and bubbletea and fyne into Set<Var>(v), each splicing the declared name through unrenamed. Remove this directive in the commit that closes #197."

import . "sngl:ui"

component main {
    var count = 0 @change(v int) {
        count = v
    }
    vbox {
        button(text="+", @click {
            count = count + 1
        })
        text(value="{count}")
    }
}
