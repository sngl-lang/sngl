A function that takes nothing and returns a value is a computed only while it
writes nothing; one that writes, even a local of its own, is an ordinary
function. On the Go Model targets it is emitted free, and its call sites have
to say so too: they asked a looser question (no parameters, a result) and
spelled the call `m.five()`, a method the Model never declares.

deny out/go/fyne/model.go `m\.five\(` -- five is emitted free, so it is called free
deny out/go/bubbletea/model.go `m\.five\(` -- five is emitted free, so it is called free

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
    }
}

struct P {
    t string
}

func five() string {
    var p = P{t="a"}
    var q = p
    q.t = "b"
    return p.t + q.t
}

component main node {
    var shown = ""

    button #go(text="Go", @click { shown = five() })
    text(value=shown)
}

window {
    main()
}

func testFive(t Test, c main) {
    c.go.click()
    t.assert(c.shown == "ab")
}
