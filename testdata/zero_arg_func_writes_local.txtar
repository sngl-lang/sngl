}

type setShownMsg struct{ value string }

func SetShownCmd(v string) tea.Cmd {
	return func() tea.Msg { return setShownMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setShownMsg:
		m = m.SetShown(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.shown = Five()
		}
	}
	return m, tea.Batch(cmds...)
}

// go__r0Click activates the #go__r0 widget the way a keypress does; for tests.
func (m *Model) go__r0Click() {
	prev := m.__focusID
	m.__focusID = 0
	nm, _ := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = lipgloss.NewStyle().Render(part0Prefix + " " + fmt.Sprint("Go"))
	parts = append(parts, part0)
	var part1 string
	part1 = lipgloss.NewStyle().Render(fmt.Sprint(m.shown))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
