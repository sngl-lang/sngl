A struct the optimizer folds out of a function holds every field its literal
left out at its default or zero, as the interpreter has to for a read of one,
but is spelled back with only the fields the literal wrote: a backend reads a
field's presence as having been set, and `ui.Style` declares no defaults so
that an unset field inherits the platform's. A spread hands on what its source
left out as left out.

deny out/none/html/index.html `flex:0` -- an unwritten style field is not written as its zero
deny out/none/html/index.html `line-clamp:0` -- an unwritten style field is not written as its zero
-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
}

func base() => ui.Style{padding=8px}

func card() => ui.Style{...base(), gap=4px}

ui.window(title="styles") {
    ui.text(value="base", style=base())
    ui.text(value="card", style=card())
}
-- out/none/html/index.html --
