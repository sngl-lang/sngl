Go codegen for `$"..."` translatable strings: per-locale i18n.Translate wiring.

A static `$"Login"` compiles to i18n.Translate(locale, key, inlined, args) with
the key equal to the inlined template and an empty args map. A string with a
placeholder carries the binding in that map instead. The locale is read from
the component's hidden __ctx_locale field: NoContext lowers a context read to a
Var on the component, initialized to i18n.DefaultLocale() in New().

The runtime package is imported unaliased -- the last path segment is already
"i18n". That the *program's* alias for sngl:i18n does not decide any of this is
the point of generate_go_i18n_alias.txtar.

-- app.sngl --
import . "sngl:ui"
import "sngl:i18n"

output { go { bubbletea } }

component main {
    var greeting = $"Login"
    var user = "alice"
    var hello = $"Hello, {user}!"
    text(value=greeting)
    text(value=hello)
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/i18n"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	__ctx_locale string
	greeting     string
	user         string
	hello        string

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.__ctx_locale = i18n.DefaultLocale()
	m.greeting = i18n.Translate(m.__ctx_locale, "Login", "Login", map[string]any{})
	m.user = "alice"
	m.hello = i18n.Translate(m.__ctx_locale, "Hello, {user}!", "Hello, {user}!", map[string]any{"user": m.user})
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Greeting() string {
	return m.greeting
}

func (m Model) SetGreeting(v string) Model {
	m.greeting = v
	return m
}

type setGreetingMsg struct{ value string }

func SetGreetingCmd(v string) tea.Cmd {
	return func() tea.Msg { return setGreetingMsg{value: v} }
}

func (m Model) User() string {
	return m.user
}

func (m Model) SetUser(v string) Model {
	m.user = v
	return m
}

type setUserMsg struct{ value string }

func SetUserCmd(v string) tea.Cmd {
	return func() tea.Msg { return setUserMsg{value: v} }
}

func (m Model) Hello() string {
	return m.hello
}

func (m Model) SetHello(v string) Model {
	m.hello = v
	return m
}

type setHelloMsg struct{ value string }

func SetHelloCmd(v string) tea.Cmd {
	return func() tea.Msg { return setHelloMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setGreetingMsg:
		m = m.SetGreeting(msg.value)
	case setUserMsg:
		m = m.SetUser(msg.value)
	case setHelloMsg:
		m = m.SetHello(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0 = lipgloss.NewStyle().Render(fmt.Sprint(m.greeting))
	parts = append(parts, part0)
	var part1 string
	part1 = lipgloss.NewStyle().Render(fmt.Sprint(m.hello))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
