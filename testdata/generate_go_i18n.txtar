Go codegen for `$"..."` translatable strings: per-locale i18n.Translate wiring.

A static `$"Login"` compiles to i18n.Translate(locale, key, inlined, args) with
the key equal to the inlined template and an empty args map. A string with a
placeholder carries the binding in that map instead. The locale is read from
the component's hidden __ctx_locale field: NoContext lowers a context read to a
Var on the component, initialized to i18n.DefaultLocale() in New().

The runtime package is imported unaliased -- the last path segment is already
"i18n". That the *program's* alias for sngl:i18n does not decide any of this is
the point of generate_go_i18n_alias.txtar.

-- app.sngl --
import . "sngl:ui"
import "sngl:i18n"

output { go { bubbletea } }

component main node {
    var greeting = $"Login"
    var user = "alice"
    var hello = $"Hello, {user}!"
    text(value=greeting)
    text(value=hello)
}

window {
    main
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/i18n"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	__ctx_locale__inst0 string
	greeting__inst0     string
	user__inst0         string
	hello__inst0        string

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.__ctx_locale__inst0 = i18n.DefaultLocale()
	m.greeting__inst0 = i18n.Translate(m.__ctx_locale__inst0, "Login", "Login", map[string]any{})
	m.user__inst0 = "alice"
	m.hello__inst0 = i18n.Translate(m.__ctx_locale__inst0, "Hello, {user}!", "Hello, {user}!", map[string]any{"user": m.user__inst0})
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Greeting__inst0() string {
	return m.greeting__inst0
}

func (m Model) SetGreeting__inst0(v string) Model {
	m.greeting__inst0 = v
	return m
}

type setGreeting__inst0Msg struct{ value string }

func SetGreeting__inst0Cmd(v string) tea.Cmd {
	return func() tea.Msg { return setGreeting__inst0Msg{value: v} }
}

func (m Model) User__inst0() string {
	return m.user__inst0
}

func (m Model) SetUser__inst0(v string) Model {
	m.user__inst0 = v
	return m
}

type setUser__inst0Msg struct{ value string }

func SetUser__inst0Cmd(v string) tea.Cmd {
	return func() tea.Msg { return setUser__inst0Msg{value: v} }
}

func (m Model) Hello__inst0() string {
	return m.hello__inst0
}

func (m Model) SetHello__inst0(v string) Model {
	m.hello__inst0 = v
	return m
}

type setHello__inst0Msg struct{ value string }

func SetHello__inst0Cmd(v string) tea.Cmd {
	return func() tea.Msg { return setHello__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setGreeting__inst0Msg:
		m = m.SetGreeting__inst0(msg.value)
	case setUser__inst0Msg:
		m = m.SetUser__inst0(msg.value)
	case setHello__inst0Msg:
		m = m.SetHello__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0 = lipgloss.NewStyle().Render(fmt.Sprint(m.greeting__inst0))
	parts = append(parts, part0)
	var part1 string
	part1 = lipgloss.NewStyle().Render(fmt.Sprint(m.hello__inst0))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
