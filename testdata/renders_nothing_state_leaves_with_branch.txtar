A component that renders nothing is spliced where it is written on every
target, even under a reactive `if`, since there is no node to reconcile, so
its vars are its owner's. It still starts again from its initializers each
time the branch is taken: `k` is 1 at each mount, as on the interpreter,
rather than counting the mounts.

-- app.sngl --
import ui "sngl:ui"
import "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

var log = ""

component quiet ui.node {
    var k = 0

    effect(@mount {
        k += 1
        log += "{k} "
    })
}

component screen ui.node {
    var on = true

    ui.vbox {
        ui.button #t(text="t", @click {
            on = !on
        })
        if on {
            quiet
        }
    }
}

func testQuietStartsAgain(t test.Test, c screen) {
    c.on = false
    c.on = true
    t.assert(log == "1 1 ")
}

ui.window(title="t") {
    screen
}
