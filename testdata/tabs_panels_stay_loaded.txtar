        }
        SnglPager(modifier = styleModifier(Style(flex = 1.0), true).then(Modifier.weight(1.0f).fillMaxWidth()), selected = state.idx, disabled = listOf(Tab__record(label = "One", disabled = false, __id = 0), Tab__record(label = "Two", disabled = false, __id = 1), Tab__record(label = "Three", disabled = false, __id = 2)).map({ t: Tab__record -> t.disabled }), onSelect = { chosen ->
            state.idx = chosen
