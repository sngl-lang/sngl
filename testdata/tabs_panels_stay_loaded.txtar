-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestAPanelKeepsItsStateAcrossASwitch(t *testing.T) {
	c := newTestComponent()
	_ = c
	if c.cPresent() {
		c.pressClick()
		c.pressClick()
	}
	c.strip__changeClickAt("1")
	c.strip__changeClickAt("0")
	if !(c.cPresent()) { t.Errorf("assert failed: %s", "c.cPresent()") }
	if c.cPresent() {
		if !((c.hits__inst0 == 2)) { t.Errorf("assert failed: %s", "(c.hits__inst0 == 2)") }
	}
}

func TestABlockKeepsItsStateAcrossASwitch(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.strip__changeClickAt("1")
	if c.tapPresent() {
		c.tapClick()
	}
	c.strip__changeClickAt("0")
	c.strip__changeClickAt("1")
	if !(c.tapPresent()) { t.Errorf("assert failed: %s", "c.tapPresent()") }
	if c.tapPresent() {
		c.tapClick()
	}
	if !((c.seen == 2)) { t.Errorf("assert failed: %s", "(c.seen == 2)") }
}

func TestEveryPanelMountsWithTheTabs(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.mounts == 1)) { t.Errorf("assert failed: %s", "(c.mounts == 1)") }
	c.strip__changeClickAt("2")
	c.strip__changeClickAt("0")
	c.strip__changeClickAt("2")
	if !((c.mounts == 1)) { t.Errorf("assert failed: %s", "(c.mounts == 1)") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
