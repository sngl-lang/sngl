Every tab's panel is mounted with the tabs and kept while another is selected:
`ui.tabs` renders each panel in a box whose `display` is `none` unless its tab
is selected, where it rendered only the selected one under an `if`. fyne and
gtk4 hide the box, bubbletea renders none of it, html hides the tabpanel, and
android pages through every panel, none disposed.

android's pager reports a swipe through `onSelect`, a lambda the override
writes under `flexShare`; the call site's `@change` is spliced into it, where
an emit under a context provider used to be left for codegen, which wrote an
`onChange` nothing declared. html's panels sit in a `sngl-swipe`, the element
the page defines to hear one.

`tabs_panels_stay_loaded.sngl` runs the tests on the interpreter, and
`cmd/sngl/testdata/tabs_panels_stay_loaded_runs.txt` on every target.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `onChange` -- the override's change(k) is the call site's @change, spliced in

-- app.sngl --
import ui "sngl:ui"
import "sngl:test"

var mounts = 0

component counter ui.node {
    var hits = 0

    ui.button #press(text="{hits}", @click {
        hits += 1
    })
}

component later ui.node {
    effect(@mount {
        mounts += 1
    })
    ui.text(value="later")
}

component panels ui.node {
    var idx = 0
    var seen = 0
    var changes = 0

    ui.tabs #strip(:selected=idx, @change(i) {
        changes += 1
    }) {
        ui.tab(label="One") {
            counter #c
        }
        ui.tab(label="Two") {
            var taps = 0
            ui.button #tap(text="{taps}", @click {
                taps += 1
                seen = taps
            })
        }
        ui.tab(label="Three") {
            later
        }
    }
}

func testAPanelKeepsItsStateAcrossASwitch(t test.Test, c panels) {
    if c.c != null {
        c.c.press.click()
        c.c.press.click()
    }
    c.strip.change(1)
    c.strip.change(0)
    t.assert(c.c != null)
    if c.c != null {
        t.assert(c.c.hits == 2)
    }
}

func testABlockKeepsItsStateAcrossASwitch(t test.Test, c panels) {
    c.strip.change(1)
    if c.tap != null {
        c.tap.click()
    }
    c.strip.change(0)
    c.strip.change(1)
    t.assert(c.tap != null)
    if c.tap != null {
        c.tap.click()
    }
    t.assert(c.seen == 2)
}

func testEveryPanelMountsWithTheTabs(t test.Test, c panels) {
    t.assert(mounts == 1)
    c.strip.change(2)
    c.strip.change(0)
    c.strip.change(2)
    t.assert(mounts == 1)
}

ui.window(title="t") {
    panels
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
    kotlin {
        android
    }
}
