package main

import "testing"

func TestAPanelKeepsItsStateAcrossASwitch(t *testing.T) {
	c := newTestComponent()
	_ = c
	if c.c__r0Present() {
		c.pressClick()
		c.pressClick()
	}
	c.strip__changeChangeAt("1")
	c.strip__changeChangeAt("0")
	if !(c.c__r0Present()) { t.Errorf("assert failed: %s", "c.c__r0Present()") }
	if c.c__r0Present() {
		if !((c.c__r0ReadHits() == 2)) { t.Errorf("assert failed: %s", "(c.c__r0ReadHits() == 2)") }
	}
}

func TestABlockKeepsItsStateAcrossASwitch(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.strip__changeChangeAt("1")
	if c.tapPresent() {
		c.tapClick()
	}
	c.strip__changeChangeAt("0")
	c.strip__changeChangeAt("1")
	if !(c.tapPresent()) { t.Errorf("assert failed: %s", "c.tapPresent()") }
	if c.tapPresent() {
		c.tapClick()
	}
	if !((c.seen == 2)) { t.Errorf("assert failed: %s", "(c.seen == 2)") }
}

func TestEveryPanelMountsWithTheTabs(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.mounts == 1)) { t.Errorf("assert failed: %s", "(c.mounts == 1)") }
	c.strip__changeChangeAt("2")
	c.strip__changeChangeAt("0")
	c.strip__changeChangeAt("2")
	if !((c.mounts == 1)) { t.Errorf("assert failed: %s", "(c.mounts == 1)") }
}

