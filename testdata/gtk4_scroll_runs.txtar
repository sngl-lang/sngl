A scroll moving down reads its end along y, in both languages: a column
too short to fill the scroll asks for a row more each time it grows, until
it is tall enough that its end is more than half the scroll away. The
scroll is 300 pixels and each row 100, so it asks at 100, 200, 300 and 400,
and stops at 500. The program then prints what the scrolled window is --
its two policies, whether it takes its content's natural width, and the
widgets it holds down to the content, each scrollable's two policies with
it -- and turns it sideways, then both ways, printing each again once the
asking has stood still a while: a scroll turned reads its end afresh.

exec out/c/gtk4 -- said.txt
exec out/go/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import seq "sngl:seq"
import time "sngl:time"
import ui "sngl:ui"

c.link(include="peek.h", pkgConfig=["gtk4"], sources=["peek.c", "peek.h"])

#[c.native("peek")]
func peek(n ui.node)

c.link(include="stdio.h", system=true)

#[c.native("puts")]
#[go.native("fmt", "fmt.Println")]
func say(s string)

output {
    c { gtk4 }
    go { gtk4 }
}

var (
    asked = 0
    rows = 1
    seen = 0
    still = 0
    phase = 0
    way = ui.ScrollDirection.vertical
)

time.timer(interval=100ms, @tick {
    if asked == seen {
        still += 1
    } else {
        still = 0
    }
    seen = asked
    if still == 10 {
        still = 0
        say("{way}: asked {asked} for {rows} rows")
        peek(list)
        if phase == 0 {
            way = ui.ScrollDirection.horizontal
        } else if phase == 1 {
            way = ui.ScrollDirection.both
        } else {
            gtk4.quit()
        }
        phase += 1
    }
})

ui.window(title="t") {
    ui.vbox {
        ui.scroll #list(direction=way, style={width=300px, height=300px}, @reachEnd {
            asked += 1
            rows += 1
        }) {
            ui.vbox(style={gap=0px}) {
                for var i = seq.count(rows) {
                    ui.text(value="row {i}", style={height=100px})
                }
            }
        }
    }
}
-- peek.c --
#include "peek.h"

#include <stdio.h>

void peek(GtkWidget *w) {
    GtkScrolledWindow *sw = GTK_SCROLLED_WINDOW(w);
    GtkPolicyType h, v;
    gtk_scrolled_window_get_policy(sw, &h, &v);
    printf("policy %d %d, natural width %d:", h, v, gtk_scrolled_window_get_propagate_natural_width(sw));
    for (GtkWidget *c = gtk_scrolled_window_get_child(sw); c != NULL; c = gtk_widget_get_first_child(c)) {
        printf(" %s", G_OBJECT_TYPE_NAME(c));
        if (GTK_IS_SCROLLABLE(c)) {
            printf(" (%d %d)", gtk_scrollable_get_hscroll_policy(GTK_SCROLLABLE(c)),
                   gtk_scrollable_get_vscroll_policy(GTK_SCROLLABLE(c)));
        }
    }
    printf("\n");
    fflush(stdout);
}
-- peek.h --
#include <gtk/gtk.h>

// Prints what the scrolled window w is and holds.
void peek(GtkWidget *w);
-- said.txt --
vertical: asked 4 for 5 rows
policy 3 1, natural width 1: GtkViewport (0 1) GtkBox GtkBox GtkLabel
horizontal: asked 5 for 6 rows
policy 1 2, natural width 0: GtkViewport (1 0) GtkBox GtkBox GtkLabel
both: asked 5 for 6 rows
policy 1 1, natural width 0: GtkViewport (1 1) GtkBox GtkBox GtkLabel
