A route's markup is built at compile time, so anything it renders has to be a
literal or an expression over something known per request.

A window's URL template declares vars -- `/p/{pkg}` puts `pkg` in scope for the
body. Those are known per request exactly as state is, so markup over one
renders into a hole rather than being refused, and the dynamic path reaches the
Go mux as a pattern rather than a fixed string.

Two other expression forms had to be taken back from the Go lowering for the
same reason, each in its own archive: a ternary in route_path_param_ternary.txtar
and a list lambda in route_path_param_lambda.txtar.

`main` names ui.root because what it renders is a window. It said ui.node until
#214, which nothing checked, and the cost is visible in the diff that fixing it
produced: the route's markup carried no `pkg` at all -- an empty `<a>` and an
empty `state` -- where the two archives above render the hole this one now
renders.

-- param.sngl --
import "sngl:platform/html"
import ui "sngl:ui"

output {
    go {
        html
    }
}

component main ui.root {
    ui.window #pkg(title="t", href="/p/{pkg}") {
        html.a(href="/p/" + pkg, innerText=pkg)
    }
}
-- out/go/html/server.go --
package ui

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /p/{pkg}", handlePkg)
	return mux
}

func handlePkg(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Write([]byte("<!-- Code generated by sngl (html) from param.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>t</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<a id=\"__n0\" data-sngl-id=\"__n0\">\n</a>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { pkg: \"\" };\n  var __n0 = document.querySelector('[data-sngl-id=\"__n0\"]');\n  function __sngl_init() {\n    __n0.setAttribute(\"href\", \"/p/\" + state.pkg);\n    __n0.innerText = state.pkg;\n  }\n  __sngl_init();\n})();\n</script>\n</body></html>\n"))
}

