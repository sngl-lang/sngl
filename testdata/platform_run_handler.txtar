A platform's `@run` wraps the process start, and `run` presents the windows.

The handler is written on the platform's own node in the output block, which
is what says a platform supports it: gtk4 and fyne declare the event, and a
platform that does not -- html, android -- refuses it as an event nobody
declared. The build makes the handler a function of the program's, so every
lowering pass reads it as it reads any other, and each host's `main` calls it
with the command line and a `run` that builds the tree, presents the windows
and runs the loop. Not called, the tree is built and the loop runs with no
window presented, which is what a status bar launched by i3 wants.

-- app.sngl --
import go "sngl:language/go"
import time "sngl:time"
import ui "sngl:ui"

#[go.native("fmt", "fmt.Print")]
func print(s string)

#[go.native("os", "os.Exit")]
func exit(code int)

var n = 0

output {
    go {
        gtk4(@run(args, run) {
            start(args, run)
        })
        fyne(@run(args, run) {
            start(args, run)
        })
    }
}

// Before `run` is before the loop; after it, after the loop has exited. A
// write here is state the tree is built from, not an update to one.
func start(args list<string>, run func()) {
    print("before {args.length}\n")
    n = args.length
    if args.contains("--window") {
        run()
    }
    print("after\n")
}

time.timer(interval=100ms, @tick {
    print("tick {n}\n")
    exit(0)
})

ui.window {
    ui.text(value="{n}")
}
