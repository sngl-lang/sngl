A method on a type takes its receiver as its first parameter, whether it
names one (`q`) or says `this`, and keeps that name in its body: the page's
`state` is the page's, which the body may read as well. On android one
that reads the page's state is a function of the page, declared where that
state is and handed its receiver first; one that reads none is an extension.

deny out/none/html/index.html `state2` -- a type method's receiver is never renamed onto the page's state
deny out/none/html/index.html `function list_pick\(\)` -- the implicit receiver is a parameter
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `^fun Pt\.sum` -- a method reading the page's state is not declared outside it

-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
}

struct Pt {
    x int
    y int
}

var bonus = 1
var n = 1

func Pt.sum(q Pt) int {
    return q.x + q.y + bonus
}

func list[T].pick() => this[n]

func list[T].second() T {
    var i = 0
    for var x = this {
        if i == 1 {
            return x
        }
        i += 1
    }
    return this[0]
}

func Pt.flip(q Pt) Pt {
    var r = Pt{x=q.y, y=q.x}
    r.x += 1
    return r
}

var p = Pt{x=1, y=2}
var xs = [10, 20, 30]

ui.window(title="t") {
    ui.text(value="{p.sum()} {xs.pick()} {xs.second()} {p.flip().x}")
    ui.button(text="go", @click {
        bonus += 1
        n = 2
    })
}
