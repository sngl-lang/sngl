A scroll asking for the room its page leaves was a slit on fyne and gtk4.

fyne read a child's flex by its position in the box, and the `if` above the
scroll puts a render slot's anchor there, so the weight went to the hidden
anchor and the scroll was packed at its minimum. A share is now said on the
child it belongs to (`fynelayout.Share`). gtk4 rendered no field of `style`,
so the scroll never expanded; a flexing widget now expands along its box's
axis (`gtk4rt.Flex`), which GTK carries up to the window.
-- app.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
}

ui.window {
    var busy = false

    ui.vbox(style={flex=1}) {
        ui.button(text="toggle", @click { busy = !busy })
        if busy {
            ui.spinner(label="busy")
        }
        ui.scroll(style={flex=1}) {
            ui.text(value="rows")
        }
    }
}
