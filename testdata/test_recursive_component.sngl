struct TreeNode {
    value int = 0
    left dyn = null
    right dyn = null
}

component tree_view(node dyn = null) {
    vbox {
        text #val(value=string(node.value))
        if node.left != null {
            tree_view(node=node.left)
        }
        if node.right != null {
            tree_view(node=node.right)
        }
    }
}

component main {
    //       5
    //      / \
    //     3   8
    //    /
    //   1
    var leaf1 = TreeNode{value=1}
    var node3 = TreeNode{value=3, left=leaf1}
    var node8 = TreeNode{value=8}
    var root = TreeNode{value=5, left=node3, right=node8}

    tree_view(node=root)
}

func testRecursiveComponentRendersRoot(t T, c main) {
    t.assert(c.val[0].value == "5")
}

func testRecursiveComponentRendersChildren(t T, c main) {
    t.assert(c.val[1].value == "3")
    t.assert(c.val[2].value == "1")
    t.assert(c.val[3].value == "8")
}

func testRecursiveComponentMutation(t T, c main) {
    c.node3.right = TreeNode{value=4}
    t.assert(c.val[3].value == "4")
    t.assert(c.val[4].value == "8")
}
