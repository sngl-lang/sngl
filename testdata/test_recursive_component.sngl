import . "sngl:ui"
import . "sngl:test"

struct TreeNode {
    value int = 0
    left option<TreeNode> = null
    right option<TreeNode> = null
}

// Each level is an instance of its own, so `#val` names that level's text and
// no other: the levels below are reached through the ids of the instances
// holding them.
component tree_view(node TreeNode) node {
    vbox {
        text #val(value=string(node.value))
        if node.left != null {
            tree_view #left(node=node.left)
        }
        if node.right != null {
            tree_view #right(node=node.right)
        }
    }
}

component main node {
    //       5
    //      / \
    //     3   8
    //    /
    //   1
    var leaf1 = TreeNode{value=1}
    var node3 = TreeNode{value=3, left=leaf1}
    var node8 = TreeNode{value=8}
    var root = TreeNode{value=5, left=node3, right=node8}

    tree_view #top(node=root)
}

func testRecursiveComponentRendersRoot(t Test, c main) {
    t.assert(c.top.val.value == "5")
}

func testRecursiveComponentRendersChildren(t Test, c main) {
    var three = c.top.left
    t.assert(three != null)
    if three != null {
        t.assert(three.val.value == "3")
        t.assert(three.right == null)
        var one = three.left
        t.assert(one != null)
        if one != null {
            t.assert(one.val.value == "1")
        }
    }
    var eight = c.top.right
    t.assert(eight != null)
    if eight != null {
        t.assert(eight.val.value == "8")
    }
}

func testRecursiveComponentMutation(t Test, c main) {
    c.node3.right = TreeNode{value=4}
    var three = c.top.left
    t.assert(three != null)
    if three != null {
        var four = three.right
        t.assert(four != null)
        if four != null {
            t.assert(four.val.value == "4")
        }
    }
    t.assert(c.top.right != null)
    if c.top.right != null {
        t.assert(c.top.right.val.value == "8")
    }
}

window {
    main
}
