A view `for … else` over a *constant* iterable, which passViewForElse must not
be the thing that renders. The optimizer unrolls such a loop on a target with
no host language, and unrolling an empty one already yields the else -- so on
html the archive below holds the empty-state text as markup, with no loop and
no conditional left to lower.

The same program on bubbletea is the contrast that says the two are different
answers rather than one. A language target does not unroll -- its own compiler
can see the bounds -- so the loop reaches passViewForElse and is rewritten
there like any other, into a conditional whose test happens to be constant.
The fold after lowering then collapses it, which is why the empty case reads
as a plain line here too and the non-empty loop keeps its `for` and loses only
its unreachable else.

Both readings are the same claim: nothing in this file's output tests
emptiness at run time, because nothing in this file's iterables is unknown
until then. A view for-else that fires passViewForElse for real is
for_else_view.txtar, where the iterable is state.

deny out/none/html/index.html `for \(` -- the static path unrolls both loops away; a `for` reaching the markup would mean the else was decided at run time on a target that has none
deny out/go/bubbletea/model.go `len\(\[\]string` -- the emptiness test over a constant iterable does not survive the fold that runs after lowering

-- app.sngl --
import . "sngl:ui"
import app "sngl:app"

output {
    go {
        bubbletea
    }
    none {
        html
    }
}

const empty list<string> = []

const two list<string> = ["a", "b"]

component main ui {
    vbox {
        for var x = empty {
            text(value=x)
        } else {
            text(value="EMPTY CONST")
        }
        for var y = two {
            text(value=y)
        } else {
            text(value="NEVER")
        }
    }
}

app.window {
    main
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"strings"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentChildren []string
	var content_0 string
	content_0 = lipgloss.NewStyle().Render(fmt.Sprint("EMPTY CONST"))
	contentChildren = append(contentChildren, content_0)
	var content_1 string
	var content_1Items []string
	for _, y := range []string{"a", "b"} {
		_ = y
		var content_1Item string
		content_1Item = lipgloss.NewStyle().Render(fmt.Sprint(y))
		content_1Items = append(content_1Items, content_1Item)
	}
	content_1 = strings.Join(content_1Items, "\n")
	contentChildren = append(contentChildren, content_1)
	content = lipgloss.JoinVertical(lipgloss.Left, contentChildren...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
