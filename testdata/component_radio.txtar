A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_radio.sngl --
import . "sngl:ui"
import . "sngl:test"

// radio: state-binding fixture — mutating the bound `value` var
// changes the selected radio option.
component main node {
    var sel = "medium"
    radio(:value=sel, direction=horizontal) {
        choice(label="small", value="small")
        choice(label="medium", value="medium")
        choice(label="large", value="large")
    }
}

func testRadioValueMutates(t Test, c main) {
    t.assert(c.sel == "medium")
    c.sel = "large"
    t.assert(c.sel == "large")
    c.sel = "small"
    t.assert(c.sel == "small")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
