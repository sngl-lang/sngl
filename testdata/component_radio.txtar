class MainScreenState {
    var sel by mutableStateOf("medium")
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainScreen(state: MainScreenState = remember { MainScreenState() }) {

    Row(modifier = Modifier.safeDrawingPadding()) {
        for (opt in listOf("small", "medium", "large")) {
            Row(modifier = Modifier, verticalAlignment = Alignment.CenterVertically) {
                RadioButton(selected = (state.sel == opt), onClick = {
                    state.sel = opt
                })
                Text(text = opt, modifier = Modifier)
            }
        }
    }
}
