package main

import "testing"

func TestRadioValueMutates(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.sel == "medium")) { t.Errorf("assert failed: %s", "(c.sel == \"medium\")") }
	c.sel = "large"
	c.__wrote_sel()
	if !((c.sel == "large")) { t.Errorf("assert failed: %s", "(c.sel == \"large\")") }
	c.sel = "small"
	c.__wrote_sel()
	if !((c.sel == "small")) { t.Errorf("assert failed: %s", "(c.sel == \"small\")") }
}

