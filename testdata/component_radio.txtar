// Code generated by sngl (bubbletea) from component_radio.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	sel string

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.sel = "medium"
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Sel() string {
	return m.sel
}

func (m Model) SetSel(v string) Model {
	m.sel = v
	return m
}

type setSelMsg struct{ value string }

func SetSelCmd(v string) tea.Cmd {
	return func() tea.Msg { return setSelMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setSelMsg:
		m = m.SetSel(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentChildren []string
	content = lipgloss.JoinVertical(lipgloss.Left, contentChildren...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
