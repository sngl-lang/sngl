A `var` written in a slot entry's population is state of that block, as one
in any population is: passHoistState gives the block a component of its own.
Its walk reached a slot insertion's fallback and not its entries'
populations, so the var stayed a local of the render function while the
click handler wrote it from another -- gtk4 and bubbletea did not compile, and
html threw a ReferenceError on the first tap.

-- app.sngl --
import . "sngl:ui"

component each(item component(content component(x int) node) node) node {
    vbox {
        item() {
            component content(x) {
                vbox {
                    var taps = 0

                    button(text="tap", @click {
                        taps += 1
                    })
                    text(value="taps {taps}")
                }
            }
        }
    }
}

window {
    each {
        component item(content) {
            content(1)
        }
    }
}

output {
    none {
        html
    }
    go {
        gtk4
        bubbletea
    }
}
