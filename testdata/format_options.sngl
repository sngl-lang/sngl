// An interpolated field is its value's format: `{x}` is `x.format()`, and
// `{x, a, b}` is `x.format(a, b)`, its arguments checked as any call's are,
// named ones and defaults included. `string(x)` is `x.format()` too: there is
// no string cast besides it.

import . "sngl:test"

struct Point {
    x int = 0
    y int = 0
}

func Point.format(p Point, sep string = ",") => "({p.x}{sep}{p.y})"

func testIntBase(t Test) {
    var n = 255
    t.assert("{n, 16}" == "ff")
    t.assert("{n, base=2}" == "11111111")
    t.assert("{-n, 16}" == "-ff")
    t.assert("{0, 16}" == "0")
}

func testIntWidth(t Test) {
    var n = 42
    t.assert("{n, width=5}" == "   42")
    t.assert("{n, width=5, pad="0"}" == "00042")
    t.assert("{-n, width=5, pad="0"}" == "-0042")
    t.assert("{-n, width=5}" == "  -42")
    t.assert("{n, 16, 4, "0"}" == "002a")
    t.assert("{n, width=1}" == "42")
}

func testFloatPlaces(t Test) {
    var r = 3.14159
    t.assert("{r, places=2}" == "3.14")
    t.assert("{r, 0}" == "3")
    t.assert("{2.5, places=0}" == "3")
    t.assert("{-r, places=3}" == "-3.142")
    t.assert("{-0.001, places=2}" == "0.00")
    t.assert("{1.05, places=1}" == "1.1")
    t.assert("{r}" == string(r))
}

func testOwnFormat(t Test) {
    var p = Point{x=1, y=2}
    t.assert("{p}" == "(1,2)")
    t.assert("{p, sep=" "}" == "(1 2)")
    t.assert(string(p) == "(1,2)")
    t.assert(p.format(";") == "(1;2)")
}

func testStringIsFormat(t Test) {
    var n = 255
    var on = true
    t.assert(string(n) == "255")
    t.assert(string(n) == n.format())
    t.assert(string(on) == "true")
    t.assert(string([1, 2]) == "{[1, 2]}")
}

func testAppendFormat(t Test) {
    var b builder
    var n = 7
    n.appendFormat(&b, width=3, pad="0")
    b.add(" ")
    3.5.appendFormat(&b, places=2)
    t.assert(b.string() == "007 3.50")
}

// A type that also declares appendFormat is appended by it: a string with such
// a part is written by one builder rather than a `+` chain.
struct Tag {
    name string = ""
}

func Tag.format(t Tag, upper bool = false) => upper ? "#" + t.name.upper() : "#" + t.name

func Tag.appendFormat(t Tag, out ref[builder], upper bool = false) {
    out.add("#")
    out.add(upper ? t.name.upper() : t.name)
}

func testBuiltWithAppendFormat(t Test) {
    var tag = Tag{name="go"}
    var n = 3
    t.assert("{tag} and {tag, upper=true}, {n, width=2}" == "#go and #GO,  3")
    t.assert("[{tag, true}]" == "[#GO]")
    t.assert(string(tag) == "#go")
}

// A list's format is its elements' formats with sep between them, no
// brackets, and an option's is its value's or none; a named argument neither
// declares is the element's. A type that declares format and no appendFormat
// is appended as the string its format writes.
enum Hue {
    red
    green
}

enum Mood {
    calm
}

func Mood.format(m Mood, loud bool = false) => loud ? "CALM" : "calm"

func testListFormat(t Test) {
    var xs = [10, 11, 12]
    t.assert("{xs}" == "10, 11, 12")
    t.assert("{xs, sep="; ", base=16}" == "a; b; c")
    t.assert("{xs, "/", width=3, pad="0"}" == "010/011/012")
    var none list[int] = []
    t.assert("[{none}]" == "[]")
    var grid = [[1, 2], [3]]
    t.assert("{grid, sep=" | ", base=2}" == "1, 10 | 11")
    var ps = [Point{x=1, y=2}, Point{}]
    t.assert("{ps, sep=" "}" == "(1,2) (0,0)")
}

func testOptionFormat(t Test) {
    var o option[int] = null
    t.assert("[{o}]" == "[]")
    t.assert("{o, none="-"}" == "-")
    o = 255
    t.assert("{o, base=16}" == "ff")
    var ys list[option[float]] = [1.5, null]
    t.assert("{ys, none="?", places=2}" == "1.50, ?")
}

// An enum carrying no payload has the format the compiler declares, its
// member's name, where it declares none of its own.
func testEnumFormat(t Test) {
    var h = Hue.green
    t.assert("{h}" == "green")
    t.assert(h.format() == "green")
    var hs = [Hue.red, Hue.green]
    t.assert("{hs, sep="/"}" == "red/green")
    var ms = [Mood.calm]
    t.assert("{ms, loud=true}" == "CALM")
}

func testListAppendFormat(t Test) {
    var b builder
    var xs = [1, 2]
    xs.appendFormat(&b, sep="-", width=2, pad="0")
    b.add("|")
    var hs = [Hue.red, Hue.green]
    hs.appendFormat(&b)
    t.assert(b.string() == "01-02|red, green")
}
