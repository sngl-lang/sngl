	if !((c.joinedAt(5) == 3)) { t.Errorf("assert failed: %s", "(c.joinedAt(5) == 3)") }
	if !((c.widened[0] == 4.0)) { t.Errorf("assert failed: %s", "(c.widened[0] == 4.0)") }
	if !((c.widened[2] == 2.5)) { t.Errorf("assert failed: %s", "(c.widened[2] == 2.5)") }
	if !((c.floats[1] == 5.0)) { t.Errorf("assert failed: %s", "(c.floats[1] == 5.0)") }
	if !((c.fieldAt(1) == 2)) { t.Errorf("assert failed: %s", "(c.fieldAt(1) == 2)") }
	if !((c.holes[0] != nil)) { t.Errorf("assert failed: %s", "(c.holes[0] != nil)") }
	if !((c.holes[1] == nil)) { t.Errorf("assert failed: %s", "(c.holes[1] == nil)") }
	if !((c.leading[0] == nil)) { t.Errorf("assert failed: %s", "(c.leading[0] == nil)") }
	if !((c.leading[1] != nil)) { t.Errorf("assert failed: %s", "(c.leading[1] != nil)") }
}


