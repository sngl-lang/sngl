`[a, ...xs, b]` is a, then each element of xs, then b. Each target spells that
its own way: Go has no spread inside a composite literal, so the literal
becomes `slices.Concat` over the runs between spreads; JavaScript spreads the
array in place; Kotlin's `*` spreads an array into `listOf`'s vararg, and a
SNGL list is a `List` there, so it goes through `toTypedArray()` first.

The test is the claim. It runs on every target, so each one's answer for
`around`, `joinedLen` and `joinedAt` is executed rather than read, and
`copied` is written through after it is built to show it is a copy and not
xs itself.

`folded` is a const whose spread the optimizer evaluates, so no target sees
the spread at all. Spreading it into `ys` splices its folded elements into the
run beside them; `joinedAt` reads it where it is shared, so that spread stays.

The element type is settled across every element. `widened` is a list<float>,
so its spread of xs is a list<int> converted element by element -- a Go slice
cannot be cast to another element type, and a Kotlin List keeps the Ints it
held, where `widened[0] == 4.0` would not compile. `floats` is the same
conversion without a spread. `ps` checks its anonymous literal against the P
before it, and a null beside an int makes `holes` and `leading` option<int>.

deny out/go/bubbletea/model.go `\(\[\]float64\)\(` -- a slice of ints is not castable to a slice of floats; each element converts

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `\*[\w.]+[,)]` -- Kotlin spreads an array, not a List
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

const base = [1, 2]
const folded = [0, ...base, 3]

struct P {
    a int
}

component main node {
    var xs = [4, 5]
    var around = [0, ...xs, 9]
    var copied = [...xs]
    var aroundLen = around.length()
    var widened = [...xs, 2.5]
    var floats list<float> = xs
    var ps = [P{a=1}, {a=2}]
    var holes = [1, null]
    var leading = [null, 1]

    func joinedLen(extra int) int {
        var ys = [...xs, ...folded, extra]
        return ys.length()
    }

    func joinedAt(i int) => [...xs, ...folded][i]

    func fieldAt(i int) => ps[i].a

    func scribble() {
        copied[0] = 7
    }

    text(value="{aroundLen} {folded.length()}")
    button(text="scribble", @click { scribble() })
}

func testListSpread(t Test, c main) {
    t.assert(c.aroundLen == 4)
    t.assert(c.around[0] == 0)
    t.assert(c.around[1] == 4)
    t.assert(c.around[2] == 5)
    t.assert(c.around[3] == 9)
    c.scribble()
    t.assert(c.xs[0] == 4)
    t.assert(c.copied[0] == 7)
    t.assert(c.joinedLen(9) == 7)
    t.assert(c.joinedAt(1) == 5)
    t.assert(c.joinedAt(2) == 0)
    t.assert(c.joinedAt(5) == 3)
    t.assert(c.widened[0] == 4.0)
    t.assert(c.widened[2] == 2.5)
    t.assert(c.floats[1] == 5.0)
    t.assert(c.fieldAt(1) == 2)
    t.assert(c.holes[0] != null)
    t.assert(c.holes[1] == null)
    t.assert(c.leading[0] == null)
    t.assert(c.leading[1] != null)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
