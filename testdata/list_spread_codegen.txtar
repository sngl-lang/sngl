func TestListSpread(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.aroundLen == 4)) { t.Errorf("assert failed: %s", "(c.aroundLen == 4)") }
	if !((c.around[0] == 0)) { t.Errorf("assert failed: %s", "(c.around[0] == 0)") }
	if !((c.around[1] == 4)) { t.Errorf("assert failed: %s", "(c.around[1] == 4)") }
	if !((c.around[2] == 5)) { t.Errorf("assert failed: %s", "(c.around[2] == 5)") }
	if !((c.around[3] == 9)) { t.Errorf("assert failed: %s", "(c.around[3] == 9)") }
	c.scribble()
	if !((c.xs[0] == 4)) { t.Errorf("assert failed: %s", "(c.xs[0] == 4)") }
	if !((c.copied[0] == 7)) { t.Errorf("assert failed: %s", "(c.copied[0] == 7)") }
	if !((c.joinedLen(9) == 7)) { t.Errorf("assert failed: %s", "(c.joinedLen(9) == 7)") }
	if !((c.joinedAt(1) == 5)) { t.Errorf("assert failed: %s", "(c.joinedAt(1) == 5)") }
