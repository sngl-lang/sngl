A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

Two declarations of `count` is the point of the shape: `main` has one and
`Counter` has one, the inliner substitutes `Counter` into `main` and renames
each instantiation's state, so what every target declares is `count__inst0`
beside `count__inst1`. Both have to be *read* for that to be visible -- an
unread var is shaken, and `main`'s used to survive only because the window it
was hoisted onto was a shake root.

-- component_simple.sngl --
import . "sngl:ui"

component Counter(label = "", start = 0) node {
    var count = start

    hbox {
        text(value=label)
        button(text="+", @click { count = count + 1 })
    }
}

component main node {
    var count = 0

    text(value=string(count))
    Counter(label="Clicks", start=5)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
