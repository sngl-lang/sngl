Regression test for the textarea value-update path.

textarea(value=expr) and input(value=expr) must:
1. SetText with the value at BuildUI time (not just for bindTarget binds).
2. Re-sync the entry text whenever any var the value depends on changes.

Reactivity flows through the shared NoReactivity lowering pass: every
Assign that mutates a tracked Var has explicit `m.entry0.SetText(...)`
updates spliced after it, so we look for that inline form rather than
the older per-widget updateEntry0 method.

SetText takes the value unwrapped: the Entry intrinsic declares `text
string`, so a caller converts and no fmt.Sprint is emitted around it.

Init: SetText is emitted at BuildUI time for the textarea's value.
Post-Plan-C widget ids use the lowered __nN scheme rather than per-tag
counters; textarea is __n0 (vbox is __n1, button is __n2).

Reactive update spliced into the button's @click handler by the
NoReactivity lowering pass (button is __n2). Asserted as the assignment
followed by the re-sync, because the re-sync is spelled identically to the
BuildUI-time SetText above -- a grep for it alone would pass on that one and
claim 2 would go untested.
-- app.sngl --
import . "sngl:ui"
import . "sngl:app"

output {
    go { fyne(main=true) }
}

component main {
    var content = "initial value"

    window #app(title="t") {
        vbox {
            textarea(value=content, rows=4)
            button(text="set", @click { content = "after click" })
        }
    }
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	content string

	__n1 *fyne.Container
	__n0 *widget.Entry
	__n2 *widget.Button
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.content = "initial value"
	return m
}

func (m *Model) __n0_input_handler(s string) {
}

func (m *Model) __n2_click_handler() {
	m.content = "after click"
	m.__n0.SetText(m.content)
}

func (m *Model) Content() string {
	return m.content
}

func (m *Model) SetContent(v string) {
	m.content = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n1 = container.NewVBox()
	m.__n0 = widget.NewMultiLineEntry()
	m.__n0.SetText(m.content)
	m.__n0.SetPlaceHolder("")
	m.__n0.SetMinRowsVisible(4)
	m.__n0.OnChanged = m.__n0_input_handler
	m.__n1.Add(m.__n0)
	m.__n2 = widget.NewButton("", nil)
	m.__n2.SetText("set")
	m.__n2.OnTapped = m.__n2_click_handler
	m.__n1.Add(m.__n2)
	content := fyne.CanvasObject(m.__n1)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
