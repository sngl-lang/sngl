// A misspelled entry is a window nobody declared, reported where it is
// written. That is the reason it is an element reference rather than a string:
// a string that matched nothing would say nothing.

import app "sngl:app"
import ui "sngl:ui"

output(entry=hoem) // ERROR(check) "output entry: no window is declared with the id \"hoem\""

app.window #home(title="Home") {
    ui.text(value="hi")
}
