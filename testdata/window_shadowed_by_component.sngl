import . "sngl:ui"
import . "sngl:app"

// Built-ins are shadowable (design doc D3). A user `component window`
// resolves before the #[builtin("window")] declaration, so this
// instantiates as an ordinary node instance rather than registering a
// package window.
component window(label string, slot _) {
    text(value=label)
}

component main {
    window(label="ordinary node")
}
