import . "sngl:ui"

// A window's readable members are the builtin-node component's props;
// anything else is a hard error, not a silent dyn.
window #home(title="Home") {
    text(value="Home")
}

window #about(title="About") {
    text(value=home.nope) // ERROR(check) "no member \"nope\" on component window"
}
