A bodyless component renders from its override, and from nothing on a target
that has no override for it.

`component gap(w int) ui.node` with no block is a signature. One override
satisfies the checker -- it cannot know which target a build picks, the same
rule a bodyless func gets -- so this builds two targets to show what that
costs: html carries the override and renders the text, bubbletea has none and
renders nothing at all. That second half is the behaviour no other fixture
states, and the one that changes if the rule is ever made per-target.

The `.sngl` fixture of the same name carries the checker-level assertion and a
`SKIP(codegen)`, because a per-platform harness registers only its own
platform and cannot resolve `sngl:platform/html`.

deny out/go/bubbletea/model.go `gap` -- bubbletea has no override for gap, so nothing of it may reach the output

-- app.sngl --
import ui "sngl:ui"
import "sngl:platform/html"

output {
    none {
        html
    }
    go {
        bubbletea
    }
}

component gap(w int) ui.node

component gap[html.platform](w) {
    ui.text(value="gap {w}")
}

ui.window {
    ui.vbox {
        gap(w=4)
    }
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentChildren []string
	content = lipgloss.JoinVertical(lipgloss.Left, contentChildren...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
