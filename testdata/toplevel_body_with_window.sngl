// Several windows coexist at the top level, and `output(entry = …)` says
// which one the program opens at. Without it a build scopes to a single
// window and, past one, to none -- it refuses to guess, which is the gap the
// option closes.

import . "sngl:ui"

output(entry=home)

var visits = 0

window #home(title="Home", href="/") {
    vbox {
        text(value="visits: {visits}")
        link(href="/about", text="About")
    }
}

window #about(title="About", href="/about") {
    vbox {
        text(value="About")
        link(href="/", text="Home")
    }
}
