// A top-level body and declared windows coexist. The body is the root -- what
// the program shows when it opens -- and the windows are what it navigates to,
// which is why passRootWindow puts the body first rather than only supplying
// one when nothing else does.

import . "sngl:ui"
import . "sngl:app"

var visits = 0

vbox {
    text(value="visits: {visits}")
    link(href="/about", text="About")
}

window #about(title="About", href="/about") {
    vbox {
        text(value="About")
        link(href="/", text="Home")
    }
}
