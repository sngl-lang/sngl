// Several windows coexist at the top level, each a surface of its own. A
// single-Model build scopes to a single window and, past one, to none: it
// refuses to guess. Pages a user goes between are a nav.stack's, in one
// window, rather than windows.

import . "sngl:ui"

var visits = 0

window #home(title="Home") {
    vbox {
        text(value="visits: {visits}")
        link(href="/about", text="About")
    }
}

window #about(title="About") {
    vbox {
        text(value="About")
        link(href="/", text="Home")
    }
}
