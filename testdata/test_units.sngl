unit duration(ms, s = 1000ms, m = 60s, h = 60m)
unit measurement(px, em, rem = 16em, vw, vh, pct)

component units {
    var t1 = 1s + 500ms
    var t2 = 1h + 30m
    var m1 = 16px + 2em
    var m2 = 1rem + 2em

    text(value="test")
}

test units "duration arithmetic" {
    assert(1s == 1000ms)
    assert(1m == 60000ms)
    assert(1h == 3600000ms)
    assert(1s + 500ms == 1500ms)
    assert(1h + 30m == 5400000ms)
}

test units "measurement arithmetic" {
    assert(1rem == 16em)
    assert(1rem + 2em == 18em)
    assert(3px + 2px == 5px)
}

test units "mixed measurement components" {
    assert(16px + 2em == 2em + 16px)
}

test units "scalar multiplication" {
    assert(2 * 3px == 6px)
    assert(3px * 2 == 6px)
}

test units "scalar division" {
    assert(6px / 2 == 3px)
}

test units "subtraction" {
    assert(5px - 2px == 3px)
    assert(2s - 500ms == 1500ms)
}
