import . "sngl:ui"
import . "sngl:time"
import . "sngl:app"
import . "sngl:test"

unit duration { ms, s = 1000ms, m = 60s, h = 60m }
unit measurement { px, em, rem = 16em, vw, vh, pct }

component unitTypes node {
    var t1 duration = 1s
    var t2 duration = 500ms
    var m1 measurement = 10px
    var m2 measurement = 2em
    var sep duration = 1_000ms
    var sepPx measurement = 1_000px

    text(value="test")
}

func testUnderscoredDuration(t Test, c unitTypes) {
    t.assert(c.sep == 1s)
}

func testUnderscoredMeasurement(t Test, c unitTypes) {
    t.assert(c.sepPx == 1000px)
}

func testUnitArithmeticWithUnderscore(t Test, c unitTypes) {
    var ms duration = 1_000ms
    var px measurement = 1_000px

    t.assert(ms + 500ms == 1_500ms)
    t.assert(px * 2 == 2_000px)
}

func testZeroUnitLiteral(t Test, c unitTypes) {
    var zeroMs duration = 0ms
    var zeroPx measurement = 0px

    t.assert(zeroMs == 0s)
    t.assert(zeroPx == 0em)
}

window {
}
