unit duration(ms, s = 1000ms, m = 60s, h = 60m)
unit measurement(px, em, rem = 16em, vw, vh, pct)

component unitTypes {
    var t1 = 1s
    var t2 = 500ms
    var m1 = 10px
    var m2 = 2em
    var sep = 1_000ms
    var sepPx = 1_000px

    text(value="test")
}

func testUnderscoredDuration(t T, c unitTypes) {
    t.assert(c.sep == 1s)
}

func testUnderscoredMeasurement(t T, c unitTypes) {
    t.assert(c.sepPx == 1000px)
}

func testUnitArithmeticWithUnderscore(t T, c unitTypes) {
    t.assert(1_000ms + 500ms == 1_500ms)
    t.assert(1_000px * 2 == 2_000px)
}

func testZeroUnitLiteral(t T, c unitTypes) {
    t.assert(0ms == 0s)
    t.assert(0px == 0em)
}
