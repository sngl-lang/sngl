package main

import "testing"

func TestInstanceCopyPerRow(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((((0 < len(c.rows)) && (0 < len(c.rows[0]))) && (c.rows[0][0] != c.skip))) { t.Errorf("assert failed: %s", "(((0 < len(c.rows)) && (0 < len(c.rows[0]))) && (c.rows[0][0] != c.skip))") }
	if !(!(((0 < len(c.rows)) && (1 < len(c.rows[0]))) && (c.rows[0][1] != c.skip))) { t.Errorf("assert failed: %s", "!(((0 < len(c.rows)) && (1 < len(c.rows[0]))) && (c.rows[0][1] != c.skip))") }
	if !((((1 < len(c.rows)) && (0 < len(c.rows[1]))) && (c.rows[1][0] != c.skip))) { t.Errorf("assert failed: %s", "(((1 < len(c.rows)) && (0 < len(c.rows[1]))) && (c.rows[1][0] != c.skip))") }
	c.moveClick()
	if !(!(((0 < len(c.rows)) && (0 < len(c.rows[0]))) && (c.rows[0][0] != c.skip))) { t.Errorf("assert failed: %s", "!(((0 < len(c.rows)) && (0 < len(c.rows[0]))) && (c.rows[0][0] != c.skip))") }
	if !((((0 < len(c.rows)) && (1 < len(c.rows[0]))) && (c.rows[0][1] != c.skip))) { t.Errorf("assert failed: %s", "(((0 < len(c.rows)) && (1 < len(c.rows[0]))) && (c.rows[0][1] != c.skip))") }
	if !((((1 < len(c.rows)) && (1 < len(c.rows[1]))) && (c.rows[1][1] != c.skip))) { t.Errorf("assert failed: %s", "(((1 < len(c.rows)) && (1 < len(c.rows[1]))) && (c.rows[1][1] != c.skip))") }
}


func newTestComponent() Model { return New() }
