One copy of a component instance held by a record per row, null-tested on
every target. Each row's block declares state, so fyne and gtk4 build it as a
record of its own, whose slot lists its badges in the one Model map of copies
every row's record lists into.

cmd/sngl/testdata/indexed_ref_null_test_instance_rows_runs.txt runs it on all
six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component badge(label string) node {
    var hits = 0
    button #hit(text="hit {label} {hits}", @click { hits = hits + 1 })
}

component main node {
    var rows = [["a", "b"], ["a", "b"]]
    var skip = "b"
    vbox {
        button #move(text="m", @click { skip = "a" })
        for var r = rows {
            vbox {
                var local = 0
                text(value="{local}")
                for var n = r {
                    if n != skip {
                        badge #b(label=n)
                    }
                }
            }
        }
    }
}

func testInstanceCopyPerRow(t Test, c main) {
    t.assert(c.b[0][0] != null)
    t.assert(c.b[0][1] == null)
    t.assert(c.b[1][0] != null)
    c.move.click()
    t.assert(c.b[0][0] == null)
    t.assert(c.b[0][1] != null)
    t.assert(c.b[1][1] != null)
}

window {
    main
}
