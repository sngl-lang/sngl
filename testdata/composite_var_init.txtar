A state var initialized from a composite literal keeps the expressions inside it.

A struct, list or map literal is literal-SHAPED but its elements are arbitrary
expressions. LowerVarInit used to route all three to the literal-only translator,
whose fallback for a non-literal is `""` -- so a field reading another var emitted
`Left: ""`. It compiled wherever the field was `dyn`, because Go's `any` accepts a
string, which is why nothing caught it.

deny out/go/bubbletea/model.go `: ""` -- no field here is an empty string; that spelling is the literal-only fallback

-- app.sngl --
import . "sngl:ui"
import . "sngl:app"

output {
    go { bubbletea }
}

struct Node {
    value int = 0
    label string = ""
}

component main {
    var (
        first = Node{value=1, label="one"}
        second = Node{value=first.value, label=first.label}
        pair = [first.value, second.value]
    )

    window {
        vbox {
            text(value=second.label)
            text(value=string(pair.length()))
        }
    }
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
)

type Node struct {
	Value int
	Label string
}

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	first  Node
	second Node
	pair   []int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.first = Node{Value: 1, Label: "one"}
	m.second = Node{Value: m.first.Value, Label: m.first.Label}
	m.pair = []int{m.first.Value, m.second.Value}
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) First() Node {
	return m.first
}

func (m Model) SetFirst(v Node) Model {
	m.first = v
	return m
}

type setFirstMsg struct{ value Node }

func SetFirstCmd(v Node) tea.Cmd {
	return func() tea.Msg { return setFirstMsg{value: v} }
}

func (m Model) Second() Node {
	return m.second
}

func (m Model) SetSecond(v Node) Model {
	m.second = v
	return m
}

type setSecondMsg struct{ value Node }

func SetSecondCmd(v Node) tea.Cmd {
	return func() tea.Msg { return setSecondMsg{value: v} }
}

func (m Model) Pair() []int {
	return m.pair
}

func (m Model) SetPair(v []int) Model {
	m.pair = v
	return m
}

type setPairMsg struct{ value []int }

func SetPairCmd(v []int) tea.Cmd {
	return func() tea.Msg { return setPairMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setFirstMsg:
		m = m.SetFirst(msg.value)
	case setSecondMsg:
		m = m.SetSecond(msg.value)
	case setPairMsg:
		m = m.SetPair(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentChildren []string
	var content_0 string
	content_0 = lipgloss.NewStyle().Render(fmt.Sprint(m.second.Label))
	contentChildren = append(contentChildren, content_0)
	var content_1 string
	content_1 = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(len(m.pair))))
	contentChildren = append(contentChildren, content_1)
	content = lipgloss.JoinVertical(lipgloss.Left, contentChildren...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
