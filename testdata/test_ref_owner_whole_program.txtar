-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestMain(t *testing.T) {
	c := newTestComponent()
	_ = c
	if c.kPresent() {
		c.kClick()
	}
	if !((c.mh__inst0 == 1)) { t.Errorf("assert failed: %s", "(c.mh__inst0 == 1)") }
	c.tsClick()
	if !(!c.shown__inst0) { t.Errorf("assert failed: %s", "!c.shown__inst0") }
	if !(!c.kPresent()) { t.Errorf("assert failed: %s", "!c.kPresent()") }
}

func TestPanel(t *testing.T) {
	c := newTestComponent()
	_ = c
	if c.k__own0Present() {
		c.k__own0Click()
	}
	if !((c.ph__inst0 == 1)) { t.Errorf("assert failed: %s", "(c.ph__inst0 == 1)") }
	c.tpClick()
	if !(!c.on__inst0) { t.Errorf("assert failed: %s", "!c.on__inst0") }
	if !(!c.k__own0Present()) { t.Errorf("assert failed: %s", "!c.k__own0Present()") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
