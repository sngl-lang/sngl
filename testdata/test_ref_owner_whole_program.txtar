Tests taking two components make this a build of the whole program, and both
components write a `#b` and a `#k` their tests reach. Each id is kept by the
component whose test is declared first, main, and renamed in panel, so
panel's test names `b__own0` and `k__own0`, and each test's null tests and
clicks answer for its own component's nodes.

deny out/go/bubbletea/model_test.go `c\.b__1|c\.k__1` -- each test names its own component's node, not the second one uniqueNodeIDs numbered
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component badge(label string) node {
    var hits = 0
    button #hit(text="{label}{hits}", @click { hits = hits + 1 })
}

component panel node {
    var on = true
    var ph = 0
    vbox {
        button #tp(text="p", @click { on = !on })
        if on {
            badge #b(label="p")
            button #k(text="pk{ph}", @click { ph = ph + 1 })
        }
    }
}

component main node {
    var shown = true
    var mh = 0
    vbox {
        button #ts(text="s", @click { shown = !shown })
        if shown {
            badge #b(label="m")
            button #k(text="mk{mh}", @click { mh = mh + 1 })
        }
    }
}

func testMain(t Test, c main) {
    if c.k != null {
        c.k.click()
    }
    t.assert(c.mh == 1)
    c.ts.click()
    t.assert(c.b == null)
    t.assert(c.k == null)
}

func testPanel(t Test, c panel) {
    if c.k != null {
        c.k.click()
    }
    t.assert(c.ph == 1)
    c.tp.click()
    t.assert(c.b == null)
    t.assert(c.k == null)
}

window {
    main
    panel
}
