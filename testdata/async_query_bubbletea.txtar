`async.query` over a fetch that blocks, on bubbletea. The mount's blocking
call runs on a goroutine over a snapshot of the Model, and the rest of it is
posted back through `async.do`: a message Update receives and runs against the
Model the loop owns (#272), so the answer lands in the state View reads. The
key the mount was handed is read before the goroutine starts.

deny out/go/bubbletea/model.go `go func\(\) \{\n\s*r := Lookup\(m\.` -- the goroutine reads no state: the key is bound before it starts

-- app.sngl --
import async "sngl:async"
import . "sngl:ui"
import go "sngl:language/go"

#[go.native("time", "time.Sleep")]
#[go.async]
func sleep(ns int)

func lookup(name string) async.Result[int] {
    sleep(1000)
    if name == "" {
        return {failed={kind=async.FailureKind.request, message="no name", code="400"}}
    }
    return {ok=name.length()}
}

component detail node {
    var name = "apricot"
    var length option[int] = null
    var loading = false
    var failure option[async.Failure] = null

    async.query #q(on=name, fetch=lookup, :value=length, :pending=loading, :failure=failure)

    text(value=length != null ? "{length}" : "-")
    text(value="{loading}")
    text(value=failure != null ? failure.message : "")
    button(text="fig", @click { name = "fig" })
    button(text="again", @click { q.refresh() })
}

window {
    detail
}

output {
    go {
        bubbletea
    }
}
