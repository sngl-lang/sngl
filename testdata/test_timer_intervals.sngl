import . "sngl:ui"
import . "sngl:time"
import . "sngl:app"
import . "sngl:test"

output {
    none { html }
}

// A tick is one timer deadline, not one fire of everything: five ticks reach
// 500ms, where the fast timer is due at each 100ms boundary and the slow one
// only at the last.
func testEachTimerFiresAtItsOwnRate(t Test, c main) {
    t.tick()
    t.tick()
    t.tick()
    t.tick()
    t.tick()
    t.assert(c.fast == 5)
    t.assert(c.slow == 1)
}

component main {
    var (
        fast = 0
        slow = 0
    )

    timer(interval=100ms, enabled=true, @tick { fast += 1 })
    timer(interval=500ms, enabled=true, @tick { slow += 1 })

    text(value=string(fast))
}
