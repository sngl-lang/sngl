A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_browser_runtime.sngl --
// Components the page builds while it runs -- one per element of a list, one
// under a reactive `if`, one in a recursion -- reached by the ids they render
// and, under a loop, the copy's index in render order.

import macro "sngl:macro"
import "sngl:test/browser"
import . "sngl:test"
import . "sngl:ui"
import draw "sngl:ui/draw"

component badge(label string) node {
    var hits = 0
    text #shown(value="[{label}:{hits}]")
    button #hit(text="hit {label}", @click { hits = hits + 1 })
}

// Each instance keeps its own state: a click counts once, in the copy clicked.
component perElement node {
    var names list[string] = ["a", "b"]
    for var n = names {
        badge #b(label=n)
    }
}

func testEachInstanceKeepsItsOwnState(t Test, c perElement) {
    t.assert(browser.text(c.b[0].shown) == "[a:0]")
    c.b[0].hit.click()
    t.assert(browser.text(c.b[0].shown) == "[a:1]")
    t.assert(browser.text(c.b[1].shown) == "[b:0]")
}

// A prop reaches the leaf and leaves the instance's state alone.
component renamed node {
    var names list[string] = ["a"]
    var tag = "x"
    for var n = names {
        badge #b(label=n + tag)
    }
    button #rename(text="rename", @click { tag = "y" })
}

func testAPropReachesTheLeaf(t Test, c renamed) {
    c.b[0].hit.click()
    t.assert(browser.text(c.b[0].shown) == "[ax:1]")
    c.rename.click()
    t.assert(browser.text(c.b[0].shown) == "[ay:1]")
}

// Growing the list keeps the instances already there.
component growing node {
    var names list[string] = ["a", "b"]
    for var n = names {
        badge #b(label=n)
    }
    button #grow(text="grow", @click { names = ["a", "b", "c"] })
}

func testGrowingTheListKeepsTheOthers(t Test, c growing) {
    c.b[0].hit.click()
    c.b[1].hit.click()
    c.b[1].hit.click()
    c.grow.click()
    t.assert(browser.text(c.b[0].shown) == "[a:1]")
    t.assert(browser.text(c.b[1].shown) == "[b:2]")
    t.assert(browser.text(c.b[2].shown) == "[c:0]")
}

// A key keeps an instance with its element when one is inserted ahead of it,
// and two elements under one key are two instances.
component keyed node {
    var names list[string] = ["a", "b"]
    for var n = names {
        badge #b(label=n, key=n)
    }
    button #prepend(text="prepend", @click { names = ["z", "a", "b"] })
}

func testAKeyedInsertAtTheFrontKeepsTheOthers(t Test, c keyed) {
    c.b[1].hit.click()
    c.b[1].hit.click()
    c.prepend.click()
    t.assert(browser.text(c.b[0].shown) == "[z:0]")
    t.assert(browser.text(c.b[1].shown) == "[a:0]")
    t.assert(browser.text(c.b[2].shown) == "[b:2]")
}

component duplicates node {
    var names list[string] = ["a", "a"]
    for var n = names {
        badge #b(label=n, key=n)
    }
    button #churn(text="churn", @click { names = ["a", "a"] })
}

func testDuplicateKeysAreDistinctInstances(t Test, c duplicates) {
    t.assert(browser.count(c.b[0].shown) == 2)
    c.b[0].hit.click()
    c.churn.click()
    t.assert(browser.text(c.b[0].shown) == "[a:1]")
    t.assert(browser.text(c.b[1].shown) == "[a:0]")
}

// An instance under a reactive `if` starts again when its branch comes back.
component branch node {
    var shown = true
    button #toggle(text="toggle", @click { shown = !shown })
    if shown {
        badge #inner(label="i")
    }
}

func testReenteringABranchResetsItsInstance(t Test, c branch) {
    t.assert(c.inner != null)
    if c.inner != null {
        c.inner.hit.click()
        t.assert(browser.text(c.inner.shown) == "[i:1]")
    }
    c.toggle.click()
    t.assert(c.inner == null)
    c.toggle.click()
    t.assert(c.inner != null)
    if c.inner != null {
        t.assert(browser.text(c.inner.shown) == "[i:0]")
    }
}

component row(label string, @pick(v string)) node {
    var seen = 0
    button #btn(text="pick {label}:{seen}", @click {
        seen = seen + 1
        pick(label)
    })
}

// An instance's event reaches the handler its call site wrote, with what the
// row renders now rather than what it was built for.
component events node {
    var items list[string] = ["a", "b", "c"]
    var picked = ""
    text(value="picked={picked}")
    for var item = items {
        row #r(label=item, @pick { picked = item })
    }
    button #unshift(text="unshift", @click { items = ["z", "a", "b", "c"] })
}

func testAnInstancesEventReachesTheCallSite(t Test, c events) {
    c.r[0].btn.click()
    t.assert(c.picked == "a")
}

func testARetainedRowIsNotStale(t Test, c events) {
    c.unshift.click()
    t.assert(browser.text(c.r[0].btn) == "pick z:0")
    c.r[0].btn.click()
    t.assert(c.picked == "z")
}

component choice(label string, onpick func(string)) node {
    var hits = 0
    button #pick(text="pick {label}:{hits}", @click { onpick(label) })
}

// A callback handed to an instance as a prop writes the caller's state.
component callback node {
    var items list[string] = ["a", "b"]
    var picked = ""
    text #out(value="picked={picked}")
    for var item = items {
        choice #ch(label=item, onpick=func(s string) { picked = s })
    }
}

func testAFreshInstancesCallbackRepaints(t Test, c callback) {
    c.ch[0].pick.click()
    t.assert(browser.text(c.out) == "picked=a")
}

component seededBadge(#[macro.construct] start int, label string) node {
    var n = start
    text #shown(value="[{label}:{n}]")
    button #bump(text="bump", @click { n = n + 1 })
}

// A #[macro.construct] prop rebuilds the instance when its value changes, and only
// then; an ordinary prop is patched in place.
component rebased node {
    var names list[string] = ["a"]
    var base = 10
    var tag = "x"
    for var nm = names {
        seededBadge #b(start=base, label=nm + tag)
    }
    button #rebase(text="rebase", @click { base = base + 100 })
    button #touch(text="touch", @click { base = base })
    button #rename(text="rename", @click { tag = "y" })
}

func testAChangedConstructPropRebuilds(t Test, c rebased) {
    t.assert(browser.text(c.b[0].shown) == "[ax:10]")
    c.b[0].bump.click()
    c.rename.click()
    t.assert(browser.text(c.b[0].shown) == "[ay:11]")
    c.rebase.click()
    t.assert(browser.text(c.b[0].shown) == "[ay:110]")
}

func testAnUnchangedConstructPropKeepsTheInstance(t Test, c rebased) {
    c.b[0].bump.click()
    c.touch.click()
    c.rename.click()
    t.assert(browser.text(c.b[0].shown) == "[ay:11]")
}

component gauge(level = 0.0) node {
    var hits = 0.0
    button #hit(text="hit", @click { hits += 20.0 })
    draw.canvas #cv(width=100px, height=100px) {
        draw.rect(x=0.0, y=0.0, w=level + hits, h=40.0, style={fill=#ff0000}) {}
    }
}

func red(p color) bool {
    return p.a > 200 && p.r > 200 && p.g < 50
}

// Each instance's canvas draws its own state and redraws alone.
component gauges node {
    var levels list[float] = [10.0, 20.0]
    for var l = levels {
        gauge #g(level=l)
    }
}

func testEachInstancesCanvasDrawsItsOwnState(t Test, c gauges) {
    t.assert(red(browser.pixel(c.g[0].cv, 9, 10)))
    t.assert(!red(browser.pixel(c.g[0].cv, 10, 10)))
    t.assert(red(browser.pixel(c.g[1].cv, 19, 10)))
    c.g[0].hit.click()
    t.assert(red(browser.pixel(c.g[0].cv, 29, 10)))
    t.assert(!red(browser.pixel(c.g[1].cv, 20, 10)))
}

window {
    perElement
    renamed
    growing
    keyed
    duplicates
    branch
    events
    callback
    rebased
    gauges
}

output {
    none {
        html
    }
}
