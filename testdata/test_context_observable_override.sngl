// Observable end-to-end test: t.setContext(locale, ...) must change
// locale-dependent i18n output on every runner, not just compile cleanly.
// "1,234" (en-US) vs "1.234" (de-DE) — the thousands separator differs.

import . "sngl://std"

component Counter {
    var n = 1234
    func formatted() => i18n.numberInt(n, "decimal")
}

func testEnUsFormat(t Test, c Counter) {
    t.setContext(locale, "en-US")
    t.assert(c.formatted() == "1,234")
}

func testDeDeFormat(t Test, c Counter) {
    t.setContext(locale, "de-DE")
    t.assert(c.formatted() == "1.234")
}

func testLastWriteWins(t Test, c Counter) {
    t.setContext(locale, "de-DE")
    t.setContext(locale, "en-US")
    t.assert(c.formatted() == "1,234")
}
