import . "sngl:ui"
import . "sngl:test"

component promo node {
    var i int = 3
    var f float = 1.5
    text(value="hi")
}

func testIntPlusFloat(t Test, c promo) {
    t.assert(float(c.i) + c.f == 4.5)
}

func testFloatPlusInt(t Test, c promo) {
    t.assert(c.f + float(c.i) == 4.5)
}

func testIntMulFloat(t Test, c promo) {
    t.assert(float(c.i) * c.f == 4.5)
}

func testIntDivFloat(t Test, c promo) {
    t.assert(float(c.i) / c.f == 2.0)
}

func testMixedComparison(t Test, c promo) {
    t.assert(float(c.i) > c.f)
    t.assert(c.f < float(c.i))
    t.assert(float(c.i) >= 3.0)
    t.assert(c.f <= 2.0)
}

func testMixedEquality(t Test, c promo) {
    t.assert(3 == 3.0)
    t.assert(3.0 == 3)
    t.assert(float(c.i) == 3.0)
}

func testExplicitCastRoundTrip(t Test, c promo) {
    t.assert(int(c.f) == 1)
    t.assert(float(c.i) == 3.0)
}

window {
}
