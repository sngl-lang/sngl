A platform's @run runs before the loop, with the command line; `run` presents
the window and runs the loop, so the code after it waits for the loop to end.
Not called, the handler returns, the loop runs with no window, and the timer
still ticks -- which is how a status bar launched by i3 starts without a
window. Each run ends from the tick, which asks the process to stop: the loop
exits and the application tears down -- the probe's @unmount, then the token
the tick built from constants -- before `run` returns, so "after" follows
them where run was called and precedes the tick where it was not.

testdata/platform_run_handler.txtar is the same handler without the scenario.

exec out/go/gtk4 -- hidden.txt
exec out/go/gtk4 --window x -- shown.txt
exec out/go/fyne -- hidden.txt
exec out/go/fyne --window x -- shown.txt
-- app.sngl --
import go "sngl:language/go"
import macro "sngl:macro"
import time "sngl:time"
import ui "sngl:ui"

#[go.native("fmt", "fmt.Print")]
func print(s string)

#[go.native("syscall", "syscall.Signal")]
struct Signal {}

#[go.native("syscall", "syscall.SIGTERM")]
const sigterm Signal

#[go.native("syscall", "syscall.Getpid")]
func getpid() int

#[go.native("syscall", "syscall.Kill")]
func kill(pid int, sig Signal)

#[macro.owned(release)]
struct token {
    id int
}

func release(t token) {
    print("release {t.id}\n")
}

func report(t token) {
    print("tick {n} {t.id}\n")
}

var (
    n = 0
    stopped = false
)

output {
    go {
        gtk4(@run(args, run) {
            start(args, run)
        })
        fyne(@run(args, run) {
            start(args, run)
        })
    }
}

// Before `run` is before the loop; after it, after the loop has exited and
// the application has torn down. A write here is state the tree is built
// from, not an update to one.
func start(args list[string], run func()) {
    print("before {args.length}\n")
    n = args.length
    if args.contains("--window") {
        run()
    }
    print("after\n")
}

// The tick asks the process to stop, which ends the loop the way a window
// manager's close of the last window does.
time.timer(interval=100ms, @tick {
    if !stopped {
        stopped = true
        report(token{id=7})
        kill(getpid(), sigterm)
    }
})

component probe ui.node {
    effect(@unmount {
        print("unmount\n")
    })
    ui.text(value="{n}")
}

ui.window {
    probe()
}
-- hidden.txt --
before 0
after
tick 0 7
unmount
release 7
-- shown.txt --
before 2
tick 2 7
unmount
release 7
after
-- out/go/fyne/model.go --
