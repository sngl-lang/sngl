What C reaches with no context to hand back, and a function taking a
variable argument list. A callback marked `#[c.static]` is a function of the
package's by name, which Go exports to C as a function of its own in the
callbacks' file, so C calls it with nothing finding a closure; marked
`#[c.outs]`, what it answers is written through the pointers C hands it,
but one that is NULL; and a string C hands it is copied. cgo calls no
variadic function, so a `variadic` declaration is called through a C
function of its one shape, which the preamble defines. A function with an
empty body is one Go defines all the same: only its calls are inlined away.
A function pointer C may be handed NULL for is an option of a pointer at the
typedef `#[c.type]` names, handed `null`.

The test runs it: the mode is 7, measure wrote 4 alone and then 5 and 10,
`hear` heard "café" quietly and "ab" loudly, 1+2+3 is 6, C called
`ignore`, and `maybe` was handed NULL.

-- app.sngl --
import ui "sngl:ui"
import c "sngl:x/c"
import go "sngl:language/go"
import test "sngl:test"

output {
    go {
        bubbletea
    }
}

c.link(include="calls.h", sources=["calls.c", "calls.h"])

struct Size {
    minimum int
    natural int
}

#[c.native("sngl_layout")]
func layout(#[c.static] mode func(of int) int, #[c.static] #[c.outs] measure func(forSize int) Size) int

#[c.native("sngl_greet")]
func greet(#[c.static] hear func(name string, loud bool) int) int

#[c.native("sngl_then")]
func then(#[c.static] done func()) int

#[c.native("sngl_maybe")]
func maybe(#[c.type("sngl_notify")] gone option[c.pointer]) int

#[c.native("sngl_sum", variadic)]
func sum3(n int, a int, b int, c int) int

func mode(of int) => of + 2

func measure(forSize int) => Size{minimum=forSize, natural=forSize * 2}

func hear(name string, loud bool) => loud ? name.length() * 10 : name.length()

func ignore() {}

component main ui.node {
    var laid = 0
    var heard = 0
    var sum = 0
    var ran = 0
    var nulled = 0
    ui.button #go(text="{laid}", @click {
        laid = layout(mode, measure)
        heard = greet(hear)
        sum = sum3(3, 1, 2, 3)
        ran = then(ignore)
        nulled = maybe(null)
    })
}

ui.window(title="t") {
    main()
}

func testStaticCallbacks(t test.Test, c main) {
    c.go.click()
    t.assert(c.laid == 74510)
    t.assert(c.heard == 24)
    t.assert(c.sum == 6)
    t.assert(c.ran == 1)
    t.assert(c.nulled == 1)
}
-- calls.h --
// The mode, then what measure wrote: its minimum alone for 4, the natural's
// pointer NULL, then both for 5.
int sngl_layout(int (*mode)(int), void (*measure)(int, int *, int *));

// What hear answers for "café" quietly, plus for "ab" loudly.
int sngl_greet(int (*hear)(const char *, int));

// 1, once it has called done.
int sngl_then(void (*done)(void));

// 1 where it is handed no function to call.
typedef void (*sngl_notify)(void *);
int sngl_maybe(sngl_notify gone);

// The n ints after n, summed.
int sngl_sum(int n, ...);
-- calls.c --
#include <stdarg.h>
#include <stddef.h>
#include <stdio.h>

#include "calls.h"

int sngl_layout(int (*mode)(int), void (*measure)(int, int *, int *)) {
	int min = 0, nat = 0, only = 0;
	measure(4, &only, NULL);
	measure(5, &min, &nat);
	return mode(5) * 10000 + only * 1000 + min * 100 + nat;
}

int sngl_greet(int (*hear)(const char *, int)) {
	char buf[8];
	snprintf(buf, sizeof buf, "caf\xc3\xa9");
	int quiet = hear(buf, 0);
	buf[0] = 0;
	return quiet + hear("ab", 1);
}

int sngl_then(void (*done)(void)) {
	done();
	return 1;
}

int sngl_maybe(sngl_notify gone) {
	return gone == NULL;
}

int sngl_sum(int n, ...) {
	va_list ap;
	va_start(ap, n);
	int s = 0;
	for (int i = 0; i < n; i++) {
		s += va_arg(ap, int);
	}
	va_end(ap);
	return s;
}
