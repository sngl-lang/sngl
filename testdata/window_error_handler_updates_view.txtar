A window's @error that writes state a widget shows is inlined at each call it
catches, and the widget write it carries has to reach the platform's
translator there as well as where the handler is declared. codegen.WalkLowered
walked a call's callbacks and not the handler inlined beside it, so on fyne and
gtk4 the write came out in its lowered IR shape -- `__n0.Text = m.caught` and
`__n0.Label = m.caught`, a name nothing declares -- and neither program
compiled. Both the direct raise and the call to a raising function hit it.

deny out/go/fyne/model.go `(?m)^\s+__n0\.` -- the label is written through the widget's setter, on the Model's field
deny out/go/gtk4/model.go `(?m)^\s+__n0\.` -- the label is written through the runtime, on the Model's field

-- window.sngl --
import . "sngl:ui"

func risky(n int) int {
    if n > 1 {
        error.raise("too big", "range")
    }
    return n * 10
}

var caught = ""

window(@error(e) { caught = e.message }) {
    button #call(text="Call", @click { risky(5) })
    button #direct(text="Raise", @click { error.raise("direct", "") })
    text(value=caught)
}

output {
    go {
        bubbletea
        fyne
        gtk4
        html
    }
    kotlin {
        android
    }
    none {
        html
    }
}
