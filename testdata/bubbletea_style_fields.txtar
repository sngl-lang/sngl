A ui.Style on bubbletea, written as a literal and held in a var and a prop,
takes one function, style.sngl's lookOf, where the held ones went through a
Go helper that rendered `opacity=1` faint and read `1em` of padding as `.px`
alone, and both paths dropped `paddingX` and `bolder`. The input renders
inside its look, where its Widget dropped the style whole, and the hbox
shares its width with its `flex` children two to one.

deny out/go/bubbletea/model.go `__styleLipgloss` -- a held Style takes the function a literal does
deny out/go/bubbletea/model.go `if s\.Opacity != 0 \{` -- an opacity of 1 is not faint
deny out/go/bubbletea/model.go `= m\.widget0\.View\(\)\n` -- the input renders inside its look
-- app.sngl --
import seq "sngl:seq"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

var opaque ui.Style = {opacity=1.0, padding=1em, paddingX=16px, fontWeight=ui.FontWeight.bolder}

var faint ui.Style = {opacity=0.5, marginY=1rem}

component labelled(look ui.Style) {
    ui.text(value="prop", style=look)
}

ui.window(title="Style") {
    ui.vbox {
        ui.text(value="literal", style={opacity=1.0, padding=1em, paddingX=16px, fontWeight=ui.FontWeight.bolder})
        ui.text(value="var", style=opaque)
        labelled(look=faint)
        ui.input(placeholder="name", style={color=#336699, width=320px, borderWidth=1px})
        ui.hbox {
            ui.text(value="one", style={flex=1.0})
            ui.text(value="two", style={flex=2.0})
        }
        ui.vbox {
            ui.text(value="takes its own height", style={flex=1.0})
        }
        for var i = seq.count(2) {
            ui.hbox {
                ui.button(text="wide {i}", style={flex=1.0})
                ui.button(text="narrow")
            }
        }
        ui.text(value="capped", style={maxLines=2, borderWidth=1px})
    }
}
