component choice {
    var x = 10
    var y = 5
    var label = ""

    func bigger() => x > y ? "x" : "y"
    func desc() => x > 0 ? string(x) : "none"

    button #swap(text="swap", @click={
        x = y
        y = x
    })
    button #bump(text="bump", @click={
        x += 1
        y += 1
    })
    text #out(value=bigger)
}

func testTernaryComputed(t T, c choice) {
    t.assert(c.bigger == "x")
    c.x = 1
    t.assert(c.bigger == "y")
    c.x = 100
    t.assert(c.bigger == "x")
}

func testTernaryWithConversion(t T, c choice) {
    t.assert(c.desc == "10")
    c.x = -1
    t.assert(c.desc == "none")
}

func testMultiStatementEvent(t T, c choice) {
    c.#bump.@click()
    t.assert(c.x == 11)
    t.assert(c.y == 6)
}

func testStringAppend(t T, c choice) {
    c.label = "hello"
    c.label += " world"
    t.assert(c.label == "hello world")
}
