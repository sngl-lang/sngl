fun DrawScope.snglDrawText(content: String, x: Float, y: Float, c: ComposeColor, size: Float, family: String) {
    drawContext.canvas.nativeCanvas.drawText(content, x, y, android.graphics.Paint().apply {
        color = c.toArgb()
        textSize = size
        // The three CSS generic families Typeface names, and Typeface.create
        // falls back to the system default for anything else -- which is the
        // right answer for a family this device does not have. android read
        // fontFamily nowhere before this (#223).
        typeface = android.graphics.Typeface.create(family, android.graphics.Typeface.NORMAL)
    })
}

// A file that will not decode draws nothing rather than failing the frame,
// which is what every other target does with an unreadable source.
fun DrawScope.snglDrawImage(src: String, x: Float, y: Float, w: Float, h: Float) {
    val bmp = android.graphics.BitmapFactory.decodeFile(src) ?: return
    drawImage(
        image = bmp.asImageBitmap(),
        dstOffset = IntOffset(x.toInt(), y.toInt()),
        dstSize = IntSize(w.toInt(), h.toInt()),
    )
}

fun _snglFloatStr(v: Double): String =
    if (v.isFinite() && v == kotlin.math.floor(v) && kotlin.math.abs(v) < 9.007199254740992E15) v.toLong().toString() else v.toString()

fun _snglSplit(s: String, sep: String): List<String> =
    if (sep.isEmpty()) s.map { it.toString() } else s.split(sep)

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainScreen() {
    Canvas(modifier = Modifier.fillMaxWidth().aspectRatio(200f / 100f)) {
        scale(scale = minOf(size.width / 200f, size.height / 100f), pivot = Offset.Zero) {
            drawRect(color = androidx.compose.ui.graphics.Color(red = 51, green = 102, blue = 204, alpha = 255), topLeft = Offset(0.0.toFloat(), 0.0.toFloat()), size = Size(200.0.toFloat(), 100.0.toFloat()))
