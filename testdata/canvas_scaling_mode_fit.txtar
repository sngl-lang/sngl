// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = canvas.NewRaster(func(pw, ph int) image.Image {
		ctx := m.__n0Surface.Begin(pw, ph, 200, 100, "fit")
		m._canvasDraw0(ctx)
		return ctx.Result()
	})
	m.__n0.SetMinSize(fyne.NewSize(200, 100))
	content := fyne.CanvasObject(m.__n0)
