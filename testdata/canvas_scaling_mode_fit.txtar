import "C"

import (
	"git.duckfam.us/jonathan/sngl/pkg/go/snglcolor"
	"unsafe"
)

type PathCmd struct {
	Op  string
	X   float64
	Y   float64
	Cx1 float64
	Cy1 float64
	Cx2 float64
	Cy2 float64
	R   float64
}

// _snglCairoScale maps a drawing's own coordinate space onto the size GTK is
// drawing at. An empty mode leaves the context alone, which is what a canvas
// shown at its own size wants.
func _snglCairoScale(cr *C.cairo_t, pw, ph, w, h int, mode string) {
	if w <= 0 || h <= 0 || mode == "" {
		return
	}
	sx, sy := float64(pw)/float64(w), float64(ph)/float64(h)
	switch mode {
	case "stretch":
	case "fill":
		if sy > sx {
			sx = sy
		}
		sy = sx
	default:
		if sy < sx {
			sx = sy
		}
		sy = sx
	}
	C.cairo_scale(cr, C.double(sx), C.double(sy))
}

type Measurement struct {
	Px  float64
	Em  float64
	Vw  float64
	Vh  float64
	Pct float64
}

type CanvasStyle struct {
	Fill        snglcolor.Color
	Stroke      snglcolor.Color
	StrokeWidth float64
	LineCap     string
	LineJoin    string
	FontSize    float64
	FontFamily  string
}

type Color struct {
	R uint8
	G uint8
	B uint8
	A uint8
}

// Model holds the state and widget references for this SNGL UI.
type Model struct {
	__n0   *C.GtkDrawingArea
	__root *C.GtkBox
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	return m
}

func Paint(ctx *C.cairo_t, style CanvasStyle) {
	if style.Fill.A > 0 {
		Source(ctx, style.Fill)
		if style.Stroke.A > 0 {
			C.cairo_fill_preserve(ctx)
		} else {
			C.cairo_fill(ctx)
		}
	}
	if style.Stroke.A > 0 {
		C.cairo_set_line_width(ctx, C.double(style.StrokeWidth))
		C.cairo_set_line_cap(ctx, LineCap(style.LineCap))
		C.cairo_set_line_join(ctx, LineJoin(style.LineJoin))
		Source(ctx, style.Stroke)
		C.cairo_stroke(ctx)
	}
}

func Source(ctx *C.cairo_t, c snglcolor.Color) {
	C.cairo_set_source_rgba(ctx, C.double((float64(c.R) / 255.0)), C.double((float64(c.G) / 255.0)), C.double((float64(c.B) / 255.0)), C.double((float64(c.A) / 255.0)))
}

func LineCap(name string) C.cairo_line_cap_t {
	if name == "round" {
		return C.cairo_line_cap_t(C.int(1))
	}
	if name == "square" {
		return C.cairo_line_cap_t(C.int(2))
	}
	return C.cairo_line_cap_t(C.int(0))
}

func LineJoin(name string) C.cairo_line_join_t {
	if name == "round" {
		return C.cairo_line_join_t(C.int(1))
	}
	if name == "bevel" {
		return C.cairo_line_join_t(C.int(2))
	}
	return C.cairo_line_join_t(C.int(0))
}

func (m *Model) _canvasDraw0(ctx *C.cairo_t) {
	C.cairo_save(ctx)
	C.cairo_rectangle(ctx, C.double(0.0), C.double(0.0), C.double(200.0), C.double(100.0))
	Paint(ctx, CanvasStyle{Fill: snglcolor.Color{R: 51, G: 102, B: 204, A: 255}, Stroke: snglcolor.Color{A: 0, R: 0, G: 0, B: 0}, StrokeWidth: 1.0, LineCap: "butt", LineJoin: "miter", FontSize: 16.0, FontFamily: "sans-serif"})
	C.cairo_restore(ctx)
}

func (m *Model) buildWidgetTree() {
	if m.__root != nil {
		return
	}
	m.__root = (*C.GtkBox)(unsafe.Pointer(C.gtk_box_new(C.GTK_ORIENTATION_VERTICAL, 6)))
	m.__n0 = (*C.GtkDrawingArea)(unsafe.Pointer(C.gtk_drawing_area_new()))
	C.gtk_drawing_area_set_content_width(m.__n0, C.int(200))
	C.gtk_drawing_area_set_content_height(m.__n0, C.int(100))
	C.gtk_widget_set_hexpand((*C.GtkWidget)(unsafe.Pointer(m.__n0)), 1)
	C.gtk_widget_set_vexpand((*C.GtkWidget)(unsafe.Pointer(m.__n0)), 1)
	snglDrawFuncs = append(snglDrawFuncs, func(cr *C.cairo_t, pw, ph int) { _snglCairoScale(cr, pw, ph, 200, 100, "fit"); m._canvasDraw0(cr) })
	C.sngl_drawing_area_set_draw(unsafe.Pointer(m.__n0), C.int((len(snglDrawFuncs) - 1)))
	C.gtk_box_append((*C.GtkBox)(unsafe.Pointer(m.__root)), (*C.GtkWidget)(unsafe.Pointer(m.__n0)))
}

// BuildUI constructs the widget tree and returns the top-level window.
func (m *Model) BuildUI(app *C.GtkApplication) *C.GtkWidget {
	m.buildWidgetTree()
	win := C.gtk_application_window_new(app)
	C.gtk_window_set_default_size((*C.GtkWindow)(unsafe.Pointer(win)), 480, 640)
	C.gtk_window_set_child((*C.GtkWindow)(unsafe.Pointer(win)), (*C.GtkWidget)(unsafe.Pointer(m.__root)))
	return win
}
