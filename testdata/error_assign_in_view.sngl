// A view body describes a rendered tree, and nothing walks it looking for
// something to run. fyne wrote the assignment into its builder; bubbletea and
// html dropped it, silently, on a program that compiled clean.

import . "sngl:ui"
import app "sngl:app"

var n = 0

component main ui {
    n = 5 // ERROR(check) "not a statement in a view body"

    text(value="{n}")
}

app.window {
    main
}
