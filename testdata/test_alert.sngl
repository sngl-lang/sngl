component main {
    var (
        confirmed = false
        filePath = ""
    )

    text(value="alert test")
}

func testToastIsANoOpInTests(t T, c main) {
    Alert.toast("hello", "info")
}

func testInfoIsANoOpInTests(t T, c main) {
    Alert.info("some info")
}

func testWarnIsANoOpInTests(t T, c main) {
    Alert.warn("some warning")
}

func testErrorIsANoOpInTests(t T, c main) {
    Alert.error("some error")
}

func testConfirmReturnsTrueInTests(t T, c main) {
    c.confirmed = Alert.confirm("Are you sure?")
    t.assert(c.confirmed == true)
}

func testPickReturnsMockPath(t T, c main) {
    c.filePath = File.pick()
    t.assert(string.length(c.filePath) > 0)
}

func testPickFolderReturnsMockPath(t T, c main) {
    c.filePath = File.pickFolder()
    t.assert(string.length(c.filePath) > 0)
}
