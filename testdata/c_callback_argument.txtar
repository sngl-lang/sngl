A closure handed to a C function taking a callback crosses as the function
pointer C calls and the `void *` it hands back, which the declaration marks
`#[c.context]` and no caller passes. Go exports a dispatcher per callback
type in a file of its own, which finds the closure through cbind's registry
by the index the context holds.

`sum` holds its callback for the call, so the registration is released when
it returns; `keep` retains its own, which `fire` calls after `keep` returned;
and `hold` is handed the function releasing its own, marked `#[c.release]`,
which `drop` calls. The test runs it: 0+3+6+9 is 18, the kept closure fired
twice, and the held one once, since `poke` after `drop` reaches a context
whose closure is gone and does nothing, as a stray GLib callback would.

deny out/go/bubbletea/model.go `//export` -- the dispatchers are in a file of their own, whose preamble defines nothing to link
-- app.sngl --
import ui "sngl:ui"
import c "sngl:x/c"
import macro "sngl:macro"
import go "sngl:language/go"
import test "sngl:test"

output {
    go {
        bubbletea
    }
}

c.link(include="calls.h", sources=["calls.c", "calls.h"])

#[c.native("sngl_sum")]
func sum(n int, f func(int) int, #[c.context] data c.pointer) int

#[c.native("sngl_keep")]
func keep(#[macro.retains] f func(), #[c.context] data c.pointer)

#[c.native("sngl_fire")]
func fire()

#[c.native("sngl_hold")]
func hold(f func(), #[c.context] data c.pointer, #[c.release] release c.pointer)

#[c.native("sngl_poke")]
func poke()

#[c.native("sngl_drop")]
func drop()

component main ui.node {
    var n = 0
    var k = 3
    var fired = 0
    var poked = 0
    ui.button #count(text="{n}", @click {
        n = sum(4, func(i int) => i * k)
        keep(func() { fired += 1 })
        fire()
        fire()
        hold(func() { poked += 1 })
        poke()
        drop()
        poke()
    })
}

ui.window(title="t") {
    main()
}

func testCallbacksReachTheClosure(t test.Test, c main) {
    c.count.click()
    t.assert(c.n == 18)
    t.assert(c.fired == 2)
    t.assert(c.poked == 1)
}
-- calls.h --
// f(0) + ... + f(n-1), handing f data each time.
int sngl_sum(int n, int (*f)(int, void *), void *data);

// Keeps f and data for sngl_fire, which calls f(data).
void sngl_keep(void (*f)(void *), void *data);
void sngl_fire(void);

// Keeps f and data for sngl_poke, which calls f(data), and release for
// sngl_drop, which calls release(data) and keeps f and data for a stray
// sngl_poke.
void sngl_hold(void (*f)(void *), void *data, void (*release)(void *));
void sngl_poke(void);
void sngl_drop(void);
-- calls.c --
#include <stddef.h>

#include "calls.h"

int sngl_sum(int n, int (*f)(int, void *), void *data) {
	int sum = 0;
	for (int i = 0; i < n; i++) {
		sum += f(i, data);
	}
	return sum;
}

static void (*kept)(void *);
static void *keptData;

void sngl_keep(void (*f)(void *), void *data) {
	kept = f;
	keptData = data;
}

void sngl_fire(void) {
	if (kept != NULL) {
		kept(keptData);
	}
}

static void (*held)(void *);
static void *heldData;
static void (*heldRelease)(void *);

void sngl_hold(void (*f)(void *), void *data, void (*release)(void *)) {
	held = f;
	heldData = data;
	heldRelease = release;
}

void sngl_poke(void) {
	if (held != NULL) {
		held(heldData);
	}
}

void sngl_drop(void) {
	if (heldRelease != NULL) {
		heldRelease(heldData);
	}
}
