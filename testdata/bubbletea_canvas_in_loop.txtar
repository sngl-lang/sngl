A canvas a loop renders once per element draws each copy from that element.

bubbletea emitted every canvas's drawing as a Model method, `_canvasDrawN(ctx)`,
which View and the kitty transmit call with no arguments. A drawing under a
loop reads the loop's variables -- here the radius `s`, and the copy key a
spliced component's cell is read through -- which no method can see, so the Go
did not compile (`undefined: s`, `undefined: __copy0`).

A loop canvas's drawing is written inline where the iteration binds them, as
the rasteriser closure handed to tui. Each copy gets a surface of its own and a
kitty image ID of its own, the canvas's in the low bits and the copy's ordinal
above them; the transmit walks the view the way View does to reach every copy.
codegen/platform/bubbletea/canvas_loop_run_test.go runs it.

deny out/go/bubbletea/model.go `func \(m \*Model\) _canvasDraw0\(` -- a loop canvas's drawing reads the iteration's variables, so it is not a method
-- app.sngl --
import . "sngl:ui"
import draw "sngl:ui/draw"

output {
    go {
        bubbletea
    }
    none {
        html
    }
}

component Dot(r float) node {
    var big = false

    vbox {
        draw.canvas(width=16px, height=16px) {
            draw.circle(cx=8, cy=8, r=big ? r * 2 : r, style=draw.CanvasStyle{fill=color{r=255, a=255}})
        }
        button(text="grow", @click { big = !big })
    }
}

window {
    var sizes list<float> = [1.0, 6.0]

    vbox {
        for var s = sizes {
            Dot(r=s)
        }
    }
}
