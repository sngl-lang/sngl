A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_async_query.sngl --
// `async.query` over a fetch that waits. The answer to a key asked before the
// current one writes nothing, nor does one arriving after the query left the
// tree, and a refresh keeps the last answer while it asks again.

import async "sngl:async"
import "sngl:test/browser"
import . "sngl:test"
import . "sngl:ui"
import api "js:./api"

// How many answers have arrived, read or not.
var answered = 0

func lookup(name string) async.Result[float] {
    var n = api.lookupLength(name)
    answered += 1
    return {ok=n}
}

component latest node {
    var name = "slow"
    var length option[float] = null
    var loading = false
    var loads = 0

    async.query #q(
        on = name,
        fetch = lookup,
        :value = length,
        :pending = loading,
        @load { loads += 1 },
    )

    text #out(value=length != null ? "{length}" : "-")
    text #busy(value="{loading}")
    button #fast(text="Fast", @click { name = "fast" })
    button #again(text="Again", @click { q.refresh() })
}

func testTheLatestKeyWins(t Test, c latest) {
    var before = answered
    c.fast.click()
    t.wait(func() => answered >= before + 2, 2000)
    t.assert(browser.text(c.out) == "4")
    t.assert(browser.text(c.busy) == "false")
    t.assert(c.loads == 1)
}

func testARefreshKeepsTheAnswer(t Test, c latest) {
    c.fast.click()
    t.wait(func() => c.loads == 1, 2000)
    c.again.click()
    t.assert(browser.text(c.busy) == "true")
    t.assert(browser.text(c.out) == "4")
    t.wait(func() => c.loads == 2, 2000)
    t.assert(browser.text(c.busy) == "false")
}

component dropped node {
    var shown = true
    var loads = 0

    if shown {
        async.query(on="slow", fetch=lookup, @load { loads += 1 })
    }
    button #hide(text="Hide", @click { shown = false })
}

func testAnUnmountedQueryWritesNothing(t Test, c dropped) {
    var before = answered
    c.hide.click()
    t.wait(func() => answered > before, 2000)
    t.assert(c.loads == 0)
}

window {
    latest
    dropped
}

output {
    none {
        html
    }
}
-- api/index.ts --
// "slow" answers well after "fast" does, so a test can ask for both and see
// which one lands.
export async function lookupLength(name: string): Promise<number> {
    await new Promise((r) => setTimeout(r, name === "slow" ? 300 : 10));
    return name.length;
}
