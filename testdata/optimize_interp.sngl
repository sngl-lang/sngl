import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

component interpfold ui {
    // Unary float negation
    var fneg = -3.14 // FOLD -3.14
    var fneg2 = -2.5 // FOLD -2.5

    // Bool not
    var bnot = !true // FOLD false

    // Chained operations
    var chain = (2 + 3) * 4 // FOLD 20

    text(value=string(chain))
}

func testValues(t Test, c interpfold) {
    t.assert(c.fneg == -3.14)
    t.assert(c.bnot == false)
    t.assert(c.chain == 20)
}

app.window {
}
