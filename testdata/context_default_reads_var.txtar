A context whose default reads a package var builds on every target.

A read of a context is a read of its default wherever nothing provides one,
and the lowering writes the default at the read -- after the optimizer's
shake has run. The shake marked the context used and never walked its
default, so `initialTheme`, named nowhere else, was shaken away while every
Go target and android went on naming it: `undefined: initialTheme`.

-- main.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

var initialTheme = "light"

context #theme(initialTheme)

component show ui.node {
    ui.text(value=theme)
}

ui.window #home(title="t") {
    show()
}
