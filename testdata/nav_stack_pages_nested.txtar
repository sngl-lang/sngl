A page under loops inside loops, with params, on the targets that answer a
stack at run time: the lowered ones (gtk4, fyne, bubbletea) and android's
NavHost.

A copy is named by one index per enclosing loop, outermost first: the
record's `copy` is a `list<int>`, so the copy at "/" -- row b, column 3 -- is
`[1, 0]`, and a page compares its copy element by element against the loop
indices in scope. The page holds one params cell, the showing copy's, which
starts at the starting copy's params: the same search finds both
(`pages__start`, `cell__start_params`). On android each page is a route whose
class holds the copy, and its destination binds each loop's variables back
from it, by index into the iterable, before the content renders.

-- app.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    go {
        gtk4
        fyne
        bubbletea
    }
    kotlin {
        android
    }
}

struct Row {
    name string
    cols list<string>
}

struct Sel {
    pick string
}

const rows list<Row> = [
    {name="a", cols=["1", "2"]},
    {name="b", cols=["3"]},
]

component grid ui.node {
    nav.stack #pages {
        for var r = rows {
            for var c = r.cols {
                nav.page #cell(href=c == "3" ? "/" : "/" + r.name + "/" + c, title=r.name + c, params=Sel{pick=c}) {
                    component content(s) {
                        ui.text #line(value="{r.name} {c} picked {s.pick}")
                        ui.text(value=pages.current == cell ? "showing" : "hidden")
                        ui.button #pick(text="pick", @click { pages.go(cell, Sel{pick="x"}) })
                    }
                }
            }
        }
        nav.page #about(href="/about", title="About") {
            ui.text(value="about")
        }
    }
    ui.text #heading(value=pages.current.title)
    ui.button #toAbout(text="About", @click { pages.go(about) })
    ui.button #back(text="Back", @click { pages.back() })
}

ui.window(title="Grid") {
    grid
}
