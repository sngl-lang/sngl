A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_tabs.sngl --
import . "sngl:ui"
import . "sngl:test"

// tabs: each tab is a `tab` written as a child, and the panel shown is what
// the selected one was written with. `selected` is two-way bound, so the
// strip's click writes `idx`, and mutating `idx` changes the panel.
component main node {
    var idx = 0
    var changed = -1
    tabs(:selected=idx, @change(i) {
        changed = i
    }) {
        tab(label="Overview") {
            text(value="Overview content")
        }
        tab(label="Details") {
            text(value="Detail content")
        }
        tab(label="Settings", disabled=true) {
            text(value="Settings content")
        }
    }
}

func testTabsSelectedMutates(t Test, c main) {
    t.assert(c.idx == 0)
    c.idx = 2
    t.assert(c.idx == 2)
    c.idx = 1
    t.assert(c.idx == 1)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
