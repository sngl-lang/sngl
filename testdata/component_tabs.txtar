package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	idx int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.idx = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Idx() int {
	return m.idx
}

func (m Model) SetIdx(v int) Model {
	m.idx = v
	return m
}

type setIdxMsg struct{ value int }

func SetIdxCmd(v int) tea.Cmd {
	return func() tea.Msg { return setIdxMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setIdxMsg:
		m = m.SetIdx(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentChildren []string
	var content_0 string
	content_0 = lipgloss.NewStyle().Render(fmt.Sprint("Overview content"))
	contentChildren = append(contentChildren, content_0)
	var content_1 string
	content_1 = lipgloss.NewStyle().Render(fmt.Sprint("Detail content"))
	contentChildren = append(contentChildren, content_1)
	var content_2 string
	content_2 = lipgloss.NewStyle().Render(fmt.Sprint("Settings content"))
	contentChildren = append(contentChildren, content_2)
	content = lipgloss.JoinHorizontal(lipgloss.Top, contentChildren...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
