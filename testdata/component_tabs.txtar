-- component_tabs.sngl --
import . "sngl:ui"
import . "sngl:test"

// tabs: state-binding fixture — mutating the bound `selected`
// index changes the active tab.
component main node {
    var idx = 0
    tabs(items=["Overview", "Details", "Settings"], selected=idx) {
        text(value="Overview content")
        text(value="Detail content")
        text(value="Settings content")
    }
}

func testTabsSelectedMutates(t Test, c main) {
    t.assert(c.idx == 0)
    c.idx = 2
    t.assert(c.idx == 2)
    c.idx = 1
    t.assert(c.idx == 1)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
