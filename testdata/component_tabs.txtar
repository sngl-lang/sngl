package main

import "testing"

func TestTabsSelectedMutates(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.idx == 0)) { t.Errorf("assert failed: %s", "(c.idx == 0)") }
	c.idx = 2
	if !((c.idx == 2)) { t.Errorf("assert failed: %s", "(c.idx == 2)") }
	c.idx = 1
	if !((c.idx == 1)) { t.Errorf("assert failed: %s", "(c.idx == 1)") }
}


func newTestComponent() Model { return New() }
