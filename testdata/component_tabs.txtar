package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	idx int

	__n0 *fyne.Container
	__n1 *widget.Label
	__n2 *widget.Label
	__n3 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.idx = 0
	return m
}

func (m *Model) Idx() int {
	return m.idx
}

func (m *Model) SetIdx(v int) {
	m.idx = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = container.NewHBox()
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText("Overview content")
	m.__n0.Add(m.__n1)
	m.__n2 = widget.NewLabel("")
	m.__n2.SetText("Detail content")
	m.__n0.Add(m.__n2)
	m.__n3 = widget.NewLabel("")
	m.__n3.SetText("Settings content")
	m.__n0.Add(m.__n3)
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
