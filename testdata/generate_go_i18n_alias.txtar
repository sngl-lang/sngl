Go codegen for $"..." translatable strings: per-locale i18n.Translate wiring.

i18n runtime package is imported (no alias needed; last path segment is "i18n").

Static string $"Login" compiles to i18n.Translate(locale, key, inlined, args)
with key == inlinedTemplate and locale read from the component's hidden
__ctx_locale Model field (NoContext lowers context reads to a Var on the
component, initialized to i18n.DefaultLocale() in New()).

Empty args map is emitted for static strings with no placeholders.

Translatable string with placeholder: args map contains the placeholder binding.

The alias a program imports i18n under is not part of the entry point's
identity: the mark on the declaration is. Detection keyed on a receiver
named "i18n" would leave this build with no runtime import and no manifest.
-- alias.sngl --
import . "sngl:ui"
import t "sngl:i18n"

output { go { bubbletea } }

component main {
    var n int = 1234
    var s = t.numberInt(n, "decimal")
    text(value=s)
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from alias.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/i18n"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	__ctx_locale string
	n            int
	s            string

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.__ctx_locale = i18n.DefaultLocale()
	m.n = 1234
	m.s = i18n.NumberInt(m.__ctx_locale, m.n, "decimal")
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) N() int {
	return m.n
}

func (m Model) SetN(v int) Model {
	m.n = v
	return m
}

type setNMsg struct{ value int }

func SetNCmd(v int) tea.Cmd {
	return func() tea.Msg { return setNMsg{value: v} }
}

func (m Model) S() string {
	return m.s
}

func (m Model) SetS(v string) Model {
	m.s = v
	return m
}

type setSMsg struct{ value string }

func SetSCmd(v string) tea.Cmd {
	return func() tea.Msg { return setSMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setNMsg:
		m = m.SetN(msg.value)
	case setSMsg:
		m = m.SetS(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(m.s))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
