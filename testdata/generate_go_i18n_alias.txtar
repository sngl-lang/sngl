The alias a program imports sngl:i18n under is not part of the entry point's
identity: the mark on the declaration is. This one imports it as `t` and calls
t.numberInt, and still gets the runtime import and an i18n.NumberInt call.
Detection keyed on a receiver named "i18n" would leave this build with
neither.

The unaliased form, and what `$"..."` itself lowers to, is in
generate_go_i18n.txtar.

-- alias.sngl --
import . "sngl:ui"
import t "sngl:i18n"

output { go { bubbletea } }

component main node {
    var n int = 1234
    var s = t.numberInt(n, "decimal")
    text(value=s)
}

window {
    main
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from alias.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/i18n"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	__ctx_locale__inst0 string
	n__inst0            int
	s__inst0            string

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.__ctx_locale__inst0 = i18n.DefaultLocale()
	m.n__inst0 = 1234
	m.s__inst0 = i18n.NumberInt(m.__ctx_locale__inst0, m.n__inst0, "decimal")
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) N__inst0() int {
	return m.n__inst0
}

func (m Model) SetN__inst0(v int) Model {
	m.n__inst0 = v
	return m
}

type setN__inst0Msg struct{ value int }

func SetN__inst0Cmd(v int) tea.Cmd {
	return func() tea.Msg { return setN__inst0Msg{value: v} }
}

func (m Model) S__inst0() string {
	return m.s__inst0
}

func (m Model) SetS__inst0(v string) Model {
	m.s__inst0 = v
	return m
}

type setS__inst0Msg struct{ value string }

func SetS__inst0Cmd(v string) tea.Cmd {
	return func() tea.Msg { return setS__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setN__inst0Msg:
		m = m.SetN__inst0(msg.value)
	case setS__inst0Msg:
		m = m.SetS__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(m.s__inst0))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
