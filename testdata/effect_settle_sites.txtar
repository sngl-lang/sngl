Where a settle call lands, and what one settle does.

passEffect puts a settle after every write to a cell some bracket's position
reads. It used to find those writes with a descent of its own that reached an
owner's funcs and its view body, and matched only an assignment whose target
was a bare identifier -- so `items.push("b")`, which is the only form push has,
and every write made inside a timer handler settled nothing at all. The golden
is where that shows: the call is either after the write or it is not.

The settle itself is one function per scope rather than one per bracket. Two
brackets rekeyed by one write have to end both lifetimes before either begins
again -- the order interp's Reconcile produces -- and a settle per bracket
called in written order gives -A,+A,-B,+B instead. Read `__effects0_settle`
below: every `_down` before every `_up`, and the downs in reverse.

The re-entrancy guard is in the same function. A handler that writes the key's
cell reaches the settle again through the ordinary function it called, so the
running pass records that another is owed and takes it itself; the bound is
what interp's maxEffectSteps is, for the effect that rekeys itself forever.

deny * `__effect0_settle` -- one settle per scope, not one per bracket
deny * `__effect1_settle` -- likewise

-- app.sngl --
import . "sngl:time"
import . "sngl:ui"

output {
    go {
        bubbletea
    }
}

component main node {
    var (
        items list<string> = ["a"]
        k = 0
        log list<string> = []
    )

    timer(interval=1s, @tick {
        k = k + 1
    })

    effect(
        on=k,
        @mount {
            log.push("+A")
        },
        @unmount {
            log.push("-A")
        },
    )
    effect(
        on=k,
        @mount {
            log.push("+B")
        },
        @unmount {
            log.push("-B")
        },
    )

    for var it = items {
        effect(on=it, @mount(v) {
            log.push("+{v}")
        })
    }

    button(text="add", @click {
        items.push("b")
    })
    text(value=log.join(","))
}

window {
    main
}
