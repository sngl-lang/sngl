A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_browser_async.sngl --
// A handler awaiting an async JavaScript function patches what it wrote once
// the promise settles, called directly or through a func-typed var holding it.

import "sngl:test/browser"
import . "sngl:test"
import . "sngl:ui"
import api "js:./api"

component direct node {
    var greeting = "before"
    text #out(value=greeting)
    button #go(text="Go", @click {
        greeting = api.fetchHello()
    })
}

func testAnAwaitedCallIsPatched(t Test, c direct) {
    t.assert(browser.text(c.out) == "before")
    c.go.click()
    t.wait(func() => c.greeting == "after", 2000)
    t.assert(browser.text(c.out) == "after")
}

component stored node {
    var handler func() string = api.fetchHello
    var greeting = "before"
    text #out(value=greeting)
    button #go(text="Go", @click {
        greeting = handler()
    })
}

func testACallThroughAFuncVarIsAwaited(t Test, c stored) {
    c.go.click()
    t.wait(func() => c.greeting == "after", 2000)
    t.assert(browser.text(c.out) == "after")
}

window {
    direct
    stored
}

output {
    none {
        html
    }
}
-- api/index.ts --
export async function fetchHello(): Promise<string> {
    return "after";
}
-- out/none/html/index.html --
