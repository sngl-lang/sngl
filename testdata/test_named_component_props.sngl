import . "sngl://std"

component Pair(first string, second string) {
    func both() => first + "+" + second

    text(value=both())
}

component main {
    Pair("alpha", "beta")            // all positional
    Pair("gamma", second="delta")    // positional then named
    Pair(second="zeta", first="eta") // out-of-order named

    text(value="named component props")
}
