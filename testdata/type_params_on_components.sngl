// A component takes type parameters the way a struct and a func do, and they
// are bound the way a func's are: from what the call site supplies. There is no
// syntax for naming a type argument at a call site, so the props written there
// are the only statement of what the parameters are.
//
// Named outside the `component_*` glob on purpose: that one opts a fixture into
// every platform's native-compilation harness, and reaching a child instance
// through its `#id` -- which these assertions do -- is not something a compiled
// Model supports yet. It works in the checker and the interpreter, which is what
// this pins.
//
// A parameter no prop pins falls back to its default, which is how a prop can
// be left out entirely — `bracket()` states no key and needs no type argument.
// `sngl:builtin`'s `effect` defaults to `struct {}` for that reason; a user
// component needs a type whose values it can also write, since a prop with no
// default is required of it.

import . "sngl:test"
import . "sngl:ui"

component box<T>(item T, label string) node {
    text #out(value=label)
}

// The payload of an event follows the parameter, so a handler's argument is
// typed by the prop the caller passed.
component job<T>(seed T, @done T) node {
    text(value="job")
}

component bracket<T = int>(on T = 0) node {
    text #b(value="bracket")
}

// A slot's content is part of the call site, so it is checked against the
// specialization like the props are. `slot cell(T)` hands the population what
// the call bound T to; against the declaration it handed out a parameter still
// named T, and `v + 1` was "operator + not defined for T and int".
component grid<T>(seed T, cell component(T)) node {
    vbox {
        cell(seed)
    }
}

// A generic component holds state of its own parameter's type, which is most of
// what one is for. The parameters are registered in a scope that used to close
// before the body's declarations were collected, so `var last T` resolved
// against a scope that no longer had T in it: `unknown type "T"`, on a name the
// declaration two lines above introduces.
component holder<T>(on T, shown component(T)) node {
    var last T = on

    // A method names them too, in its signature and in its own body, which is
    // the first thing a generic component wants of them. The scope that holds
    // the parameters used to close before the body's nested funcs were
    // registered, so `func remember(v T)` was `unknown type "T"` -- on the
    // name the declaration four lines above introduces.
    func remember(v T) {
        var kept T = v
        last = kept
    }

    func firstOf(a T, b T) => a

    vbox {
        shown(firstOf(last, on))
    }
}

component main node {
    box #i(item=1, label="int")
    box #s(item="x", label="str")

    var got = 0
    job(seed=2, @done(v) {
        got = v
    })

    bracket #plain()
    bracket #keyed(on=7)

    grid(seed=2) {
        component cell(v) {
            text #cell(value=string(v + 1))
        }
    }
}

// In a component of its own: `holder` carries state, and a stateful instance
// takes the first node index in whatever component hosts it -- which
// codegen/platform/gtk4/component_event_param_test.go names for `job`'s
// handler in `main`.
component stateful node {
    holder(on=7) {
        component shown(v) {
            text #held(value=string(v))
        }
    }
}

func testOneDeclarationServesBothBindings(t Test, c main) {
    t.assert(c.i.out.value == "int")
    t.assert(c.s.out.value == "str")
}

func testAnUnpinnedParameterTakesItsDefault(t Test, c main) {
    t.assert(c.plain.b.value == "bracket")
    t.assert(c.keyed.b.value == "bracket")
}

func testASlotIsCheckedAgainstTheSpecialization(t Test, c main) {
    t.assert(c.cell.value == "3")
}

func testAGenericComponentHoldsStateOfItsOwnParameter(t Test, c stateful) {
    t.assert(c.held.value == "7")
}

window {
    main
}
