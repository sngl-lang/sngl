A `bool` argument of a C function crosses as C spells a boolean, 1 or 0: the
argument is sngl:x/c's `cbool` body, `cint(b ? 1 : 0)`, written in by
CMarshal and lowered like any other ternary. The Go backend panicked on one
instead, since cgo converts no Go bool to a `C.int`. `abs` stands in for a C
function taking a `gboolean`.

-- app.sngl --
import ui "sngl:ui"
import macro "sngl:macro"
import go "sngl:language/go"
import "c:stdlib.h"

output {
    go {
        fyne
        bubbletea
        gtk4
    }
}

#[macro.cnative("abs")]
func magnitude(on bool) int

var on = true
var v = 0

ui.window(title="t") {
    ui.button(text="{v}", @click {
        on = !on
        v = magnitude(on)
    })
}
