A window's declared title reached no platform at all.

And a child was added through a switch over C types -- two of them, actually:
the cgo path knew seven parents and the wrapped path three, so a frame or a
popover in wrapped mode fell through to raw cgo in a file built without cgo.
Both now come from the introspection data. The vbox nests so the append is a
real parent-child one; a top-level widget is parented to __root by BuildUI and
never reaches the append path at all.
-- app.sngl --
import . "sngl:ui"

output {
    go {
        gtk4
    }
}

window(title="Counter") {
    var count int = 0

    vbox {
        text(value=string(count))
        button(text="+", @click { count = count + 1 })
    }
}
-- out/go/gtk4/callbacks.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main
-- out/go/gtk4/model.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

import (
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/gtk4rt"
)

// Model holds the state and widget references for this SNGL UI.
type Model struct {
	count  int
	__n1   gtk4rt.Handle
	__n0   gtk4rt.Handle
	__n2   gtk4rt.Handle
	__root gtk4rt.Handle
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	m.count = 0
	return m
}

func (m *Model) __n2_clicked_handler() {
	m.count = (m.count + 1)
	gtk4rt.LabelSetText(m.__n0, fmt.Sprint(m.count))
}

func (m *Model) Count() int {
	return m.count
}

func (m *Model) SetCount(v int) {
	m.count = v
}

func (m *Model) buildWidgetTree() {
	if m.__root != nil {
		return
	}
	m.__root = gtk4rt.BoxNew(gtk4rt.OrientationVertical, 6)
	m.__n1 = gtk4rt.BoxNew(gtk4rt.OrientationHorizontal, 0)
	gtk4rt.OrientableSetOrientation(m.__n1, gtk4rt.OrientationVertical)
	gtk4rt.BoxSetSpacing(m.__n1, 6)
	m.__n0 = gtk4rt.LabelNew("")
	gtk4rt.LabelSetText(m.__n0, fmt.Sprint(m.count))
	gtk4rt.BoxAppend(m.__n1, m.__n0)
	m.__n2 = gtk4rt.ButtonNew()
	gtk4rt.ButtonSetLabel(m.__n2, "+")
	gtk4rt.Connect(m.__n2, "clicked", m.__n2_clicked_handler)
	gtk4rt.BoxAppend(m.__n1, m.__n2)
	gtk4rt.BoxAppend(m.__root, m.__n1)
}

// BuildUI constructs the widget tree and returns the top-level window.
func (m *Model) BuildUI(app gtk4rt.Handle) gtk4rt.Handle {
	m.buildWidgetTree()
	win := gtk4rt.ApplicationWindowNew(app)
	gtk4rt.WindowSetDefaultSize(win, 480, 640)
	gtk4rt.WindowSetTitle(win, "Counter")
	gtk4rt.WindowSetChild(win, m.__root)
	return win
}
