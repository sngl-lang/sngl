package main

import "testing"

func TestScopedRestPerCopy(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.mounted == "1:10 2:20 ")) { t.Errorf("assert failed: %s", "(c.mounted == \"1:10 2:20 \")") }
	c.addClick()
	if !((c.mounted == "1:10 2:20 3:30 ")) { t.Errorf("assert failed: %s", "(c.mounted == \"1:10 2:20 3:30 \")") }
}


func newTestComponent() Model { return New() }
