A scoped rest slot populated by name on a component built at run time, on
every target.

`children ...component(v int) node` hands its insertion's argument to a caller
that writes `component children(v) { … }`; children written bare would see
nothing. The argument is the callee's state, `k`, and the population also reads
the caller's loop variable, so each copy renders `{i} {v}` from two scopes.

On html, fyne and gtk4 the population is spliced into a copy of `Card` with
`v` bound to `k`; android passes it as a composable taking an `Int`, and
bubbletea splices `Card` with a cell per copy. The test runs on every target.

deny out/none/html/index.html `" " \+ String\(v\)` -- the population's parameter is bound to the copy's own state where it is inserted
deny out/go/fyne/model.go `fmt\.Sprint\(v\)` -- as above, for the fyne record
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `slotContent\(\)` -- the scoped rest slot is called with its argument
-- app.sngl --
import . "sngl:test"
import . "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component Card(start int, children ...component(v int) node) node {
    var k = start * 10

    vbox {
        text(value="card {k}")
        children(k)
    }
}

component main node {
    var items = [1, 2]
    var mounted = ""

    vbox {
        button #add(text="add", @click { items.push(3) })
        for var i = items {
            Card(start=i) {
                component children(v) {
                    text(value="scoped {i} {v}")
                    effect(on="{i}:{v}", @mount(k) { mounted = mounted + k + " " })
                }
            }
        }
    }
}

func testScopedRestPerCopy(t Test, c main) {
    t.assert(c.mounted == "1:10 2:20 ")
    c.add.click()
    t.assert(c.mounted == "1:10 2:20 3:30 ")
}

window {
    main
}
