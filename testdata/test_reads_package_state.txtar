A test reads package state after a click through the component the click
reached. bubbletea's test component is its Model held by value, and a test
binds its own copy of it; a read of a package var was spelled through the
harness's original rather than through the test's copy, so it read the state
from before the click. The interpreter, fyne and html already read the live
cell.

-- pkgstate.sngl --
import . "sngl:ui"
import . "sngl:test"

var total = 0

func bump() {
    total = total + 1
}

component panel node {
    button #b(text="Bump", @click {
        bump()
    })
    text(value="{total}")
}

func testBumpIsSeen(t Test, c panel) {
    c.b.click()
    t.assert(total == 1)
}

window {
    panel
}

output {
    go {
        bubbletea
        fyne
    }
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from pkgstate.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	total     int
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.total = 0
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) bump() {
	m.total = (m.total + 1)
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Total() int {
	return m.total
}

func (m Model) SetTotal(v int) Model {
	m.total = v
	return m
}

type setTotalMsg struct{ value int }

func SetTotalCmd(v int) tea.Cmd {
	return func() tea.Msg { return setTotalMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setTotalMsg:
		m = m.SetTotal(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.bump()
		}
	}
	return m, tea.Batch(cmds...)
}

// bClick activates the #b widget the way a keypress does; for tests.
func (m *Model) bClick() {
	prev := m.__focusID
	m.__focusID = 0
	nm, _ := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = lipgloss.NewStyle().Render(part0Prefix + " " + fmt.Sprint("Bump"))
	parts = append(parts, part0)
	var part1 string
	part1 = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(m.total)))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestBumpIsSeen(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.bClick()
	if !((c.total == 1)) { t.Errorf("assert failed: %s", "(c.total == 1)") }
}


func newTestComponent() Model { return New() }
