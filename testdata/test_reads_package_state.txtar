package main

import "testing"

func TestBumpIsSeen(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.bClick()
	if !((c.total == 1)) { t.Errorf("assert failed: %s", "(c.total == 1)") }
}


func newTestComponent() Model { return New() }
