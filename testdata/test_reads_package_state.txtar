A test reads package state after a click through the component the click
reached. bubbletea's test component is its Model held by value, and a test
binds its own copy of it; a read of a package var was spelled through the
harness's original rather than through the test's copy, so it read the state
from before the click. The interpreter, fyne and html already read the live
cell.

-- pkgstate.sngl --
import . "sngl:ui"
import . "sngl:test"

var total = 0

func bump() {
    total = total + 1
}

component panel node {
    button #b(text="Bump", @click {
        bump()
    })
    text(value="{total}")
}

func testBumpIsSeen(t Test, c panel) {
    c.b.click()
    t.assert(total == 1)
}

window {
    panel
}

output {
    go {
        bubbletea
        fyne
    }
}
-- out/go/bubbletea/model.go --
