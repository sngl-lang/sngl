// Code generated by sngl (fyne) from pkgstate.sngl; DO NOT EDIT.

package main

import (
	"fmt"
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	total int

	b    *widget.Button
	__n0 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.total = 0
	return m
}

func (m *Model) bump() {
	m.total = (m.total + 1)
	m.__n0.SetText(fmt.Sprint(m.total))
}

func (m *Model) b_click_handler() {
	m.bump()
}

// bClick invokes the OnTapped callback on the #b widget; for tests.
func (m *Model) bClick() {
	if m.b.OnTapped != nil {
		m.b.OnTapped()
	}
}

func (m *Model) Total() int {
	return m.total
}

func (m *Model) SetTotal(v int) {
	m.total = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.b = widget.NewButton("", nil)
	m.b.SetText("Bump")
	m.b.OnTapped = m.b_click_handler
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText(fmt.Sprint(m.total))
	var parts []fyne.CanvasObject
	parts = append(parts, m.b)
	parts = append(parts, m.__n0)
	return container.NewVBox(parts...)
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
