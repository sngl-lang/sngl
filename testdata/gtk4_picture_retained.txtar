gtk4's `Picture` names `refPicture` as its retain: the runtime counts a
picture's holders, so a program that keeps the picture a source derived --
the last one shown, while the URL moves on -- stores a reference, and the
decode is given back when the derived value and the var have both released
theirs. `last = picture` is written as `last = refPicture(picture)`, and
each holder's release is a `gtk4rt.UnrefPicture`.

-- app.sngl --
import ui "sngl:ui"
import gtk4 "sngl:platform/gtk4"

output {
    go {
        gtk4
    }
}

component page ui.node {
    var url = "a.png"

    func picture() => gtk4.loadPicture(url)

    var last = picture()

    func next() {
        last = picture()
        url = "b.png"
    }

    ui.vbox {
        ui.image {
            gtk4.ImageUrl(url=url, picture=picture)
        }
        ui.image {
            gtk4.ImageUrl(url=url, picture=last)
        }
        ui.button(text="next", @click {
            next()
        })
    }
}

ui.window(title="t") {
    page
}
