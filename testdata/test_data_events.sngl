component main {
    var count = 0
    var items = ["a", "b"]

    var tracked = 0 @change {
        count = count + 1
    }

    button #inc(text="+", @click { tracked = tracked + 1 })
    text(value=string(tracked))
}

// Basic test that the component parses and checks with data events.
// Data event execution is platform-specific; the none/testrunner
// does not currently fire @change handlers.
func testDataFieldExists(t Test, c main) {
    t.assert(c.tracked == 0)
    c.inc.click()
    t.assert(c.tracked == 1)
}
