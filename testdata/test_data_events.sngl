import . "sngl:ui"
import . "sngl:test"

// An effect keyed on a var reports each write to it: @update runs after the
// handler that wrote it.
component main node {
    var count = 0
    var tracked = 0

    effect(on=tracked, @update {
        count = count + 1
    })

    button #inc(text="+", @click { tracked = tracked + 1 })
    text(value=string(tracked))
}

func testUpdateReportsTheWrite(t Test, c main) {
    t.assert(c.count == 0)
    c.inc.click()
    t.assert(c.tracked == 1)
    t.assert(c.count == 1)
}

window {
    main
}
