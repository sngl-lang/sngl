// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package ui

import (
	"fmt"
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
)

// Model holds the state for this SNGL UI.
type Model struct {
	count   int
	tracked int

	__n1 *fyne.Container
	__n2 *widget.Button
	__n0 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.count = 0
	m.tracked = 0
	return m
}

func (m *Model) __n2_click_handler() {
	m.tracked = (m.tracked + 1)
}

func (m *Model) Count() int {
	return m.count
}

func (m *Model) SetCount(v int) {
	m.count = v
}

func (m *Model) Tracked() int {
	return m.tracked
}

func (m *Model) SetTracked(v int) {
	m.tracked = v
	m.count = (v + 1)
	m.__n0.SetText(fmt.Sprint(m.count))
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n1 = container.NewVBox()
	m.__n2 = widget.NewButton("", nil)
	m.__n2.SetText("+")
	m.__n2.OnTapped = m.__n2_click_handler
	m.__n1.Add(m.__n2)
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText(fmt.Sprint(m.count))
	m.__n1.Add(m.__n0)
	content := fyne.CanvasObject(m.__n1)
	return content
}
