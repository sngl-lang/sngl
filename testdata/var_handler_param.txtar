	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setCountMsg:
		m = m.SetCount(msg.value)
	case setTrackedMsg:
		m = m.SetTracked(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.tracked = (m.tracked + 1)
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentChildren []string
	var content_0 string
	content_0Focused := (m.__focusID == 0)
	content_0Prefix := " "
	if content_0Focused {
		content_0Prefix = ">"
	}
	content_0 = lipgloss.NewStyle().Render(content_0Prefix + " " + fmt.Sprint("+"))
	contentChildren = append(contentChildren, content_0)
	var content_1 string
	content_1 = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(m.count)))
	contentChildren = append(contentChildren, content_1)
	content = lipgloss.JoinVertical(lipgloss.Left, contentChildren...)
	v := tea.NewView(content)
	v.AltScreen = true
