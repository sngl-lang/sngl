A write in the package body does not name a kept instance's nodes.

A component built at run time -- one with state under a `for` -- holds its
nodes and its render slots in a record of its own. A write from a component's
body already left another component's alone (`reachable` in passReactivity),
but one from the package body still spliced an update for every reader: the
window's `@click { shown = !shown }` called the row's `__renderSlot0` and set
its `__n0` as if they were the Model's, and fyne and gtk4 did not build
(`undefined: __renderSlot0`, `m.__n0 undefined`). The write reaches the
row through what holds it instead: the page's `__refreshPage_shown` calls the
refresh each row carries for `shown`, which sets its text and re-renders its
`if` from the row's own record (design/instances.md,
`cmd/sngl/testdata/page_write_reaches_instance_runs.txt`).

deny out/go/fyne/model.go `^\s*__renderSlot0\(m\.__root\)` -- the row's slot is no Model method
deny out/go/gtk4/model.go `^\s*__renderSlot0\(m\.__root\)` -- as above, on gtk4
-- app.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
}

var shown = false
var names = ["a", "b"]

component row(name string) ui.node {
    var taps = 0

    ui.button(text=name, @click { taps += 1 })
    ui.text(value="{name} {shown}")
    if shown {
        ui.text(value="{name} {taps}")
    }
}

ui.window {
    ui.button(text="toggle", @click { shown = !shown })
    for var n = names {
        row(name=n)
    }
}
-- out/go/fyne/model.go --
