A `gir:` method's string parameter that GIR marks transfer-ownership="full"
is the callee's: GTK frees it, so the caller must not. girresolve declares
it `#[macro.moves]`, and the C string CMarshal allocates for it is handed
over rather than freed after the call. Its transfer-none sibling still frees.

GTK 4 has no widget method that takes a string transfer-full -- only
GtkStringList's `take`, which no view renders -- so this fixture's GIR, the
bundled subset plus two of GtkLabel's methods, says `set_text` takes its
string.

deny out/go/gtk4/model.go `(?m)^\s*C\.gtk_label_set_text\(m\.l, (__rel\d+)\)\n\s*Free\(` -- a transfer-full argument is GTK's to free

-- app.sngl --
import gtk "gir:Gtk-4.0"
import ui "sngl:ui"

output {
    go {
        gtk4(gir="testdata/gir/Gtk-4.0.gir")
    }
}

var n = 0

ui.window(title="t") {
    gtk.GtkLabel #l(label="") {}
    ui.button(text="go", @click {
        l.setMarkup("<b>{n}</b>")
        l.setText("{n}")
        n = n + 1
    })
}
