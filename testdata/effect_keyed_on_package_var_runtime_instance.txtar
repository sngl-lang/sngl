An effect in a component built at run time, keyed on a package var written
outside it, runs when the var is written: its `@update`, and the remount of a
keyed `@mount`, for the one instance under an `if` and for every copy under a
`for`. The effect lowering marks a key's `@update` and settles its scope after
each write to what the key reads, and the write in the page named the
instance's flag and settle bare: fyne, gtk4 and android did not build, and
html built and ran none of it. passEffectOutsideKeys hands the instance the
var as a prop, `__on_level`, which the site keeps every live instance's copy
of through its setter. cmd/sngl/testdata/effect_keyed_on_package_var_runs.txt
adds a query keyed on the var.

-- app.sngl --
import ui "sngl:ui"
import "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

var level = 0
var mounts list[int] = []

component gauge ui.node {
    var seen = 0

    effect(on=level, @update(n) {
        seen = n
    })
    effect(on=level, @mount(n) {
        mounts.push(n)
    })
    ui.text #shown(value="{seen}")
}

component app ui.node {
    var open = true
    var copies = [1, 2]

    ui.vbox {
        ui.button #raise(text="raise", @click {
            level += 1
        })
        if open {
            gauge #g
        }
        for var k = copies {
            gauge #row
        }
    }
}

ui.window(title="t") {
    app()
}

func testAWriteOutsideReachesTheEffect(t test.Test, c app) {
    c.raise.click()
    t.assert(c.g != null && c.g.seen == 1)
    t.assert(c.row[0].seen == 1 && c.row[1].seen == 1)
}

func testAWriteOutsideRemountsAKeyedEffect(t test.Test, c app) {
    c.raise.click()
    t.assert(mounts.join(",") == "0,0,0,1,1,1")
}
