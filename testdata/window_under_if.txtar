A window under an `if` that reads state is a node in a render slot, on gtk4 and
fyne: created when the condition turns true and destroyed when it turns false,
content and effects with it. The slot's parent is the application, so the
render removes the Toplevel from it, which is what destroying a toplevel means
there. On html the window is a `<dialog>` built by the slot, an instance of
its own whose teardown is the slot's.

Nothing in it survives the condition turning false, since a render builds its
body afresh. The effect in the window's body mounts with the slot and
unmounts with it, and `n`'s updater in the main window's click patches the
label only while the window exists.

deny * `gtk4rt\.Window\{|snglWindow|\.Mount\(\)|\.Unmount\(\)` -- a window is a Toplevel node, not a record kept beside the tree
deny * `__effect0_mount\(\) \{\n\s*m\.__win` -- no effect mounts a window; the slot does

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
        fyne
    }
    none {
        html
    }
}

var (
    details = false
    n = 0
    shown = 0
)

ui.window #main(title="Main") {
    ui.button(text="Details", @click {
        details = !details
    })
    ui.button(text="+", @click {
        n += 1
    })
    ui.text(value="shown {shown} times")
}

if details {
    ui.window(title="Load", @closed {
        details = false
    }) {
        ui.text(value="{n}")
        effect(@mount {
            shown += 1
        })
    }
}
