import . "sngl:ui"
import app "sngl:app"

// Bug: unknown method on string typechecks silently.
// String has built-in methods (length, contains, etc.) but unknown ones
// like `bogusMethod` produce no diagnostic.
component main node {
    var s = "hi"
    var bad = s.bogusMethod() // ERROR(check) "no method"
    text(value=s)
}

app.window {
    main
}
