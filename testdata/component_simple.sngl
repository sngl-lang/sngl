import . "sngl:ui"
import app "sngl:app"

component Counter(label = "", start = 0) ui {
    var count = start

    hbox {
        text(value=label)
        button(text="+", @click { count = count + 1 })
    }
}

component main ui {
    var count = 0

    Counter(label="Clicks", start=5)
}

app.window {
    main
}
