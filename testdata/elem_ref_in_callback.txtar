  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<span id="$0">
</span>

<script>
(() => {
  // sngl-entry.js
  var state = { n__inst0: 0 };
  function run(f) {
    f();
  }
  function __effect0_mount() {
    run(() => {
      state.n__inst0 += 1;
      $0.textContent = String(state.n__inst0);
    });
  }
  var __effect0_live = [];
  var __effect0_desired = [];
  var __effects0_settling = false;
  var __effects0_pending = false;
  var __effects0_steps = 0;
  function __effect0_down() {
    __effect0_desired = [];
    __effect0_desired.push(true);
  }
  function __effect0_up() {
    for (const [__effect0_i, __effect0_k] of __effect0_desired.entries()) {
      if (__effect0_i >= __effect0_live.length) {
        __effect0_mount();
      } else {
        if (__effect0_live[__effect0_i] !== __effect0_k) {
          __effect0_mount();
        }
      }
    }
    __effect0_live = __effect0_desired;
  }
  function __effects0_settle() {
    if (__effects0_settling) {
      __effects0_pending = true;
    } else {
      __effects0_settling = true;
      __effects0_pending = true;
      __effects0_steps = 0;
      while (__effects0_pending && __effects0_steps < 512) {
        __effects0_pending = false;
        __effects0_steps = __effects0_steps + 1;
