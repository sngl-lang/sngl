// Tests for t.setContext(): overriding a context value within a test body.
// A local context #locale declaration is used here because the stdlib locale
// context (Task 28) has not yet been added; each fixture declares its own.
//
// These tests verify that t.setContext(locale, ...) works as a replacement
// for t.setLocale(...): it updates env.locale so i18n calls in the component
// use the overridden locale.

context #locale("en-US")

component SetCtxGreeting {
    var label = $"Hello"
    text(value=label)
}

// Default locale (en-US) produces the expected English output.
func testSetContextDefaultLocale(t Test, c SetCtxGreeting) {
    t.setContext(locale, "en")
    t.assert(c.label == "Hello")
}

// Calling setContext is accepted and does not crash; locale is updated.
func testSetContextCallAccepted(t Test, c SetCtxGreeting) {
    t.setContext(locale, "es-MX")
    t.assert(true)
}

// Two sequential setContext calls: the second wins.
func testSetContextLastWriteWins(t Test, c SetCtxGreeting) {
    t.setContext(locale, "fr-FR")
    t.setContext(locale, "en")
    t.assert(c.label == "Hello")
}
