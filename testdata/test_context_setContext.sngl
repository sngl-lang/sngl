// Tests for t.setContext(): overriding a context value within a test body.
// Uses the stdlib `locale` context from lib/i18n.sngl.
//
// The component declares `label` as a `func` (not a `var`) so each read
// recomputes against the active locale — `var` is initial-value only,
// not derived. See sngl_var_vs_func_semantics in memory.

import . "sngl://std"

component SetCtxGreeting {
    func label() => $"Hello"
    text(value=label())
}

// Default locale produces the expected English output.
func testSetContextDefaultLocale(t Test, c SetCtxGreeting) {
    t.setContext(locale, "en")
    t.assert(c.label() == "Hello")
}

// Calling setContext is accepted and does not crash.
func testSetContextCallAccepted(t Test, c SetCtxGreeting) {
    t.setContext(locale, "es-MX")
    t.assert(true)
}

// Two sequential setContext calls: the second wins.
func testSetContextLastWriteWins(t Test, c SetCtxGreeting) {
    t.setContext(locale, "fr-FR")
    t.setContext(locale, "en")
    t.assert(c.label() == "Hello")
}
