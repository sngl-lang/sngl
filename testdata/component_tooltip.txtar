A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_tooltip.sngl --
import . "sngl:ui"
import . "sngl:test"

// tooltip: state-binding fixture — driving the tooltip `text`
// from a state var. The stdlib prop isn't two-way bound, so this
// asserts the var mutation alone (component reads from it).
component main node {
    var msg = "hello"
    tooltip(text=msg) {
        button(text="hover")
    }
}

func testTooltipTextMutates(t Test, c main) {
    t.assert(c.msg == "hello")
    c.msg = "goodbye"
    t.assert(c.msg == "goodbye")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
