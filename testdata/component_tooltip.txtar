type setMsgMsg struct{ value string }

func SetMsgCmd(v string) tea.Cmd {
	return func() tea.Msg { return setMsgMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setMsgMsg:
		m = m.SetMsg(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentChildren []string
	var content_0 string
	content_0Focused := (m.__focusID == 0)
	content_0Prefix := " "
	if content_0Focused {
		content_0Prefix = ">"
	}
	content_0 = lipgloss.NewStyle().Render(content_0Prefix + " " + fmt.Sprint("hover"))
	contentChildren = append(contentChildren, content_0)
	if m.__focusID == 0 {
		contentChildren = append(contentChildren, lipgloss.NewStyle().Faint(true).Render(fmt.Sprint(m.msg)))
	}
	content = lipgloss.JoinVertical(lipgloss.Left, contentChildren...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
