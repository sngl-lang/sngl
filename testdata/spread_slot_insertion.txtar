A spread into a slot insertion is its struct's fields written as named
arguments, bound to the slot's parameters by name the way a call binds them.
The checker used to keep the spread whole instead, so an ir.Spread reached
SlotInst.Args: Go rendered the bare struct where the slot takes a string,
Kotlin `*r.toTypedArray()`, and the interpreter panicked until an Eval arm
evaluated it to its operand -- right for none of the three.

`cell(...r)` fills both parameters from the fields, `unused` naming none;
`cell(count=7, ...p)` mixes a named argument with a spread of the other field.
Each target runs the test, which clicks the buttons the two populations render.

deny * `toTypedArray` -- a spread in an argument list is named arguments, not a vararg

-- spread_slot_insertion.sngl --
import . "sngl:ui"
import . "sngl:test"

struct Row {
    title string
    count int
    unused bool = false
}

struct Partial {
    title string
}

component whole(r Row, cell component(title string, count int)) node {
    vbox {
        cell(...r)
    }
}

component mixed(p Partial, cell component(title string, count int)) node {
    vbox {
        cell(count=7, ...p)
    }
}

component main node {
    var seen = ""
    whole(r=Row{title="row", count=3}) {
        component cell(t, n) {
            button #a(text=t, @click { seen = seen + t + string(n) + ";" })
        }
    }
    mixed(p=Partial{title="part"}) {
        component cell(t, n) {
            button #b(text=t, @click { seen = seen + t + string(n) + ";" })
        }
    }
}

func testSpreadIntoSlot(t Test, c main) {
    c.a.click()
    c.b.click()
    t.assert(c.seen == "row3;part7;")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
