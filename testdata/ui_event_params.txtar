	c.dayChange(snglSome(d))
	if !(snglOptEq(c.picked, d)) { t.Errorf("assert failed: %s", "snglOptEq(c.picked, d)") }
	if !((c.seen == "day")) { t.Errorf("assert failed: %s", "(c.seen == \"day\")") }
}

func TestButton(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.pressClick()
	c.pressClick()
	if !((c.clicks == 2)) { t.Errorf("assert failed: %s", "(c.clicks == 2)") }
}


