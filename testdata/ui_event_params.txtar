        org.junit.Assert.assertTrue("(c.seen == \"box false false\")", (c.seen == "box false false"))
        org.junit.Assert.assertTrue("(c.on == false)", (c.on == false))
    }

    @Test fun testToggle() {
        val c = MainScreenState()
        @Suppress("UNUSED_VARIABLE") val composeTestRule = composeRule
        composeRule.setContent { MainScreen(c) }
        composeTestRule.onNode(androidx.compose.ui.test.isToggleable() and (androidx.compose.ui.test.hasTestTag("sw") or androidx.compose.ui.test.hasAnyAncestor(androidx.compose.ui.test.hasTestTag("sw")))).performSemanticsAction(androidx.compose.ui.semantics.SemanticsActions.OnClick); composeTestRule.waitForIdle()
        org.junit.Assert.assertTrue("(c.seen == \"sw true\")", (c.seen == "sw true"))
        org.junit.Assert.assertTrue("(c.lit == true)", (c.lit == true))
        composeTestRule.onNode(androidx.compose.ui.test.isToggleable() and (androidx.compose.ui.test.hasTestTag("sw") or androidx.compose.ui.test.hasAnyAncestor(androidx.compose.ui.test.hasTestTag("sw")))).performSemanticsAction(androidx.compose.ui.semantics.SemanticsActions.OnClick); composeTestRule.waitForIdle()
