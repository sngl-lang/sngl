// boxChange activates the #box widget the way a keypress does; for tests.
func (m *Model) boxChange(_ bool) {
	prev := m.__focusID
	m.__focusID = 0
	nm, cmd := m.Update(tea.KeyPressMsg{Code: tea.KeySpace})
	*m = nm.(Model)
	m.__focusID = prev
	_ = m.View()
	_ = cmd
