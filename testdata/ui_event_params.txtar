`sngl:ui`'s form controls declare their events' parameters as a function
does, and every target hands a handler the value itself: a checkbox's and a
toggle's `@change(checked bool)`, an input's `@input(value string)`, a
datepicker's `@change(value option[time.date])`, a button's `@click()`. They
were one payload struct each -- `ToggleEvent{checked}`, `InputEvent{value}`,
`DateEvent{value}`, an empty `ClickEvent` -- which a handler read a field of
and every target declared, built and taught its test invokers.

Each override writes the two-way prop its control holds from what its host
reported and hands the same value on, so the bound var's write-back is the
override's own write; see testdata/toggle_change_payload.txtar for each host's
read. A test fires an event as the program would, `c.box.change(true)`, and
cmd/sngl/testdata/ui_event_params_runs.txt runs this program on every target.

deny * `(Change|Toggle|Input|Date|Click)Event` -- no target declares, builds or is handed a payload struct
deny out/none/html/index.html `e\.target\.` -- an element's handler is handed the DOM event, whose currentTarget the override reads
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"
import time "sngl:time"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component main node {
    var on = false
    var lit = false
    var name = ""
    var picked option[time.date] = null
    var seen = "none"
    var clicks = 0
    vbox {
        checkbox #box(:checked=on, label="a", @change(checked) { seen = "box {checked} {on}" })
        toggle #sw(checked=lit, label="b", @change(checked) {
            lit = checked
            seen = "sw {checked}"
        })
        input #field(:value=name, @input(value) { seen = "input {value} {name}" })
        datepicker #day(:value=picked, @change(value) { seen = value == null ? "no day" : "day" })
        button #press(text="go", @click { clicks += 1 })
        text(value=seen)
    }
}

func testCheckbox(t Test, c main) {
    c.box.change(true)
    t.assert(c.seen == "box true true")
    t.assert(c.on == true)
    c.box.change(false)
    t.assert(c.seen == "box false false")
    t.assert(c.on == false)
}

func testToggle(t Test, c main) {
    c.sw.change(true)
    t.assert(c.seen == "sw true")
    t.assert(c.lit == true)
    c.sw.change(checked=false)
    t.assert(c.seen == "sw false")
    t.assert(c.lit == false)
}

func testInput(t Test, c main) {
    c.field.input("ada")
    t.assert(c.seen == "input ada ada")
    t.assert(c.name == "ada")
}

func testDatepicker(t Test, c main) {
    var d time.date = "2024-03-05"
    c.day.change(d)
    t.assert(c.picked == d)
    t.assert(c.seen == "day")
}

func testButton(t Test, c main) {
    c.press.click()
    c.press.click()
    t.assert(c.clicks == 2)
}

window {
    main
}
