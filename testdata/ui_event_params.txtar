    @Test fun testInput() {
        val c = MainScreenState()
        @Suppress("UNUSED_VARIABLE") val composeTestRule = composeRule
        composeRule.setContent { MainScreen(c) }
        composeTestRule.onNode(androidx.compose.ui.test.hasTestTag("field")).performSemanticsAction(androidx.compose.ui.semantics.SemanticsActions.SetText) { it(androidx.compose.ui.text.AnnotatedString("ada")) }; composeTestRule.waitForIdle()
