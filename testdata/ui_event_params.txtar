package main

import "testing"

func TestCheckbox(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.boxChange(true)
	if !((c.seen == "box true true")) { t.Errorf("assert failed: %s", "(c.seen == \"box true true\")") }
	if !((c.on == true)) { t.Errorf("assert failed: %s", "(c.on == true)") }
	c.boxChange(false)
	if !((c.seen == "box false false")) { t.Errorf("assert failed: %s", "(c.seen == \"box false false\")") }
	if !((c.on == false)) { t.Errorf("assert failed: %s", "(c.on == false)") }
}

func TestToggle(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.swChange(true)
	if !((c.seen == "sw true")) { t.Errorf("assert failed: %s", "(c.seen == \"sw true\")") }
	if !((c.lit == true)) { t.Errorf("assert failed: %s", "(c.lit == true)") }
	c.swChange(false)
	if !((c.seen == "sw false")) { t.Errorf("assert failed: %s", "(c.seen == \"sw false\")") }
	if !((c.lit == false)) { t.Errorf("assert failed: %s", "(c.lit == false)") }
}

func TestInput(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.fieldInput("ada")
	if !((c.seen == "input ada ada")) { t.Errorf("assert failed: %s", "(c.seen == \"input ada ada\")") }
	if !((c.name == "ada")) { t.Errorf("assert failed: %s", "(c.name == \"ada\")") }
}

func TestDatepicker(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	d := mustParseDate("2024-03-05")
	c.dayChange(snglSome(d))
	if !(snglOptEq(c.picked, d)) { t.Errorf("assert failed: %s", "snglOptEq(c.picked, d)") }
	if !((c.seen == "day")) { t.Errorf("assert failed: %s", "(c.seen == \"day\")") }
}

func TestButton(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.pressClick()
	c.pressClick()
	if !((c.clicks == 2)) { t.Errorf("assert failed: %s", "(c.clicks == 2)") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
