A `fails` native in a handler body whose raises reach a window's @error fails
the way a raise does: its error result becomes a panic, the body's catch block
recovers it, and nothing after the call runs. Caught at its own call instead,
as it was, the handler ran with the error and the click went on -- to
`check("")`, whose raise ran the window's handler a second time.

deny out/go/bubbletea/model.go `__err != nil \{\n\s*e := ErrorEvent` -- the failure is raised to the catch block, not handled at the call
deny out/go/fyne/model.go `__err != nil \{\n\s*e := ErrorEvent` -- nor on fyne

-- app.sngl --
import . "sngl:ui"
import go "sngl:language/go"

#[go.native("os", "os.Hostname", fails)]
func host() string

func check(s string) {
    if s.length == 0 {
        error.raise("empty", "validation")
    }
}

var caught = "none"
var greeting = "idle"
var after = false

window #home(title="raise", @error(e) {
    caught = "window: " + e.message
}) {
    vbox {
        button(text="go", @click {
            host()
            after = true
            check("")
        })
        text(value=caught)
        text(value=greeting)
    }
}

output {
    go {
        bubbletea
        fyne
    }
}
