gtk4's @run in both languages, as fyne's and win32's
(testdata/platform_run_handler_runs.txtar, win32_c_run_handler_runs.txtar):
the tree is built before the loop and the handler runs with the command
line, and `run` presents the windows the build held hidden and runs the
loop, so the code after it waits for the loop to end. Not called, the
handler returns and the loop runs with no window, which only the program's
quit ends. Each run ends from the tick, which quits: the loop exits and the
application tears down -- the probe's @unmount -- before `run` returns, so
"after" follows it where run was called and precedes the tick where it was
not. The window's `visible` hears it held: the probe reads it, and the tick
reports it.

exec out/c/gtk4 -- hidden.txt
exec out/c/gtk4 --window x -- shown.txt
exec out/go/gtk4 -- hidden.txt
exec out/go/gtk4 --window x -- shown.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import macro "sngl:macro"
import time "sngl:time"
import ui "sngl:ui"

c.link(include="stdio.h", system=true)

#[macro.cnative("puts")]
#[go.native("fmt", "fmt.Println")]
func say(s string)

var (
    n = 0
    shown = true
    stopped = false
)

output {
    c {
        gtk4(@run(args, run) {
            start(args, run)
        })
    }
    go {
        gtk4(@run(args, run) {
            start(args, run)
        })
    }
}

func start(args list[string], run func()) {
    say("before {args.length}")
    n = args.length
    if args.contains("--window") {
        run()
    }
    say("after")
}

time.timer(interval=100ms, @tick {
    if !stopped {
        stopped = true
        say("tick {n} shown {shown}")
        gtk4.quit()
    }
})

component probe ui.node {
    effect(@unmount {
        say("unmount")
    })
    ui.text(value="{n}")
}

ui.window(:visible=shown) {
    probe()
}
-- hidden.txt --
before 0
after
tick 0 shown false
unmount
-- shown.txt --
before 2
tick 2 shown true
unmount
after
-- out/c/gtk4/main.c --
