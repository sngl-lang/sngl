import . "sngl:std"

// Bug: chained selector on a primitive value typechecks silently.
// Struct field access reaches an `int`, then a further `.zoo` is ignored —
// the checker emits no diagnostic for the unknown selector on `int`.
struct Point {
    x int = 0
    y int = 0
}

component main {
    var p = Point{x=1, y=2}
    var bad = p.x.zoo // ERROR(check) "no field"
    text(value="x")
}
