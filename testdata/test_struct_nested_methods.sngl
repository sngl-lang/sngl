import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

struct Point {
    x, y int
    func magnitude2() => this.x * this.x + this.y * this.y
    func translate(dx int, dy int) {
        this.x += dx
        this.y += dy
    }
    // `this.`-elision: bare field, bare sibling call
    func describe() => "({x},{y}) m2={magnitude2()}"
}

component main node {
    var p = Point{x=3, y=4}
    text(value=p.describe())
}

func testNestedMethodFieldAccess(t Test, c main) {
    t.assert(c.p.magnitude2() == 25)
}

func testNestedMethodMutation(t Test, c main) {
    c.p.translate(1, 2)
    t.assert(c.p.x == 4)
    t.assert(c.p.y == 6)
}

func testNestedMethodBareSiblingCall(t Test, c main) {
    t.assert(c.p.describe() == "(3,4) m2=25")
}

app.window {
    main
}
