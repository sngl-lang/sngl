// Nested methods on struct types. Interpreter dispatch for user-defined
// struct methods is a follow-up; this fixture verifies the checker accepts
// the syntax and desugars correctly. Runtime semantics covered by
// per-target codegen tests once the interpreter learns struct method
// dispatch.
struct Point {
    x, y int

    func magnitude2() => this.x*this.x + this.y*this.y
    func translate(dx int, dy int) {
        this.x += dx
        this.y += dy
    }
    func describe() => "({x},{y}) m2={magnitude2()}"
}

component main {
    var p = Point{x = 3, y = 4}
    text(value=p.describe())
}
