import org.robolectric.RobolectricTestRunner
import org.robolectric.annotation.Config
import org.robolectric.annotation.GraphicsMode

@RunWith(RobolectricTestRunner::class)
@Config(sdk = [33])
@GraphicsMode(GraphicsMode.Mode.NATIVE)
class MainScreenTest {
    @get:Rule val composeRule = createAndroidComposeRule<ComponentActivity>()

    @Test fun testIndexWritesReachTheMap() {
        val c = MainScreenState()
        @Suppress("UNUSED_VARIABLE") val composeTestRule = composeRule
        composeRule.setContent { MainScreen(c) }
        composeTestRule.onNode(androidx.compose.ui.test.hasTestTag("put")).performSemanticsAction(androidx.compose.ui.semantics.SemanticsActions.OnClick); composeTestRule.waitForIdle()
        org.junit.Assert.assertTrue("(c.counts.getOrDefault(\"a\", 0) == 7)", (c.counts.getOrDefault("a", 0) == 7))
        composeTestRule.onNode(androidx.compose.ui.test.hasTestTag("bump")).performSemanticsAction(androidx.compose.ui.semantics.SemanticsActions.OnClick); composeTestRule.waitForIdle()
        org.junit.Assert.assertTrue("(c.counts.getOrDefault(\"a\", 0) == 12)", (c.counts.getOrDefault("a", 0) == 12))
        org.junit.Assert.assertTrue("(c.counts.size == 1)", (c.counts.size == 1))
    }

}
