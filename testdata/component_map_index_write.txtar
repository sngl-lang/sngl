import "testing"

func TestIndexWritesReachTheMap(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.putClick()
	if !((func() int { if __v, __ok := c.counts["a"]; __ok { return __v }; return 0 }() == 7)) { t.Errorf("assert failed: %s", "(func() int { if __v, __ok := c.counts[\"a\"]; __ok { return __v }; return 0 }() == 7)") }
	c.bumpClick()
	if !((func() int { if __v, __ok := c.counts["a"]; __ok { return __v }; return 0 }() == 12)) { t.Errorf("assert failed: %s", "(func() int { if __v, __ok := c.counts[\"a\"]; __ok { return __v }; return 0 }() == 12)") }
	if !((len(c.counts) == 1)) { t.Errorf("assert failed: %s", "(len(c.counts) == 1)") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
