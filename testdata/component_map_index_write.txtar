A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_map_index_write.sngl --
// An index write and a compound index write in a handler reach the map the
// view reads.

import . "sngl:test"
import . "sngl:ui"

component main node {
    var counts map[string, int] = {}
    text(value="{counts.length()}:{counts.get("a", 0)}")
    button #put(text="put", @click { counts["a"] = 7 })
    button #bump(text="bump", @click { counts["a"] += 5 })
}

func testIndexWritesReachTheMap(t Test, c main) {
    c.put.click()
    t.assert(c.counts.get("a", 0) == 7)
    c.bump.click()
    t.assert(c.counts.get("a", 0) == 12)
    t.assert(c.counts.length() == 1)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
