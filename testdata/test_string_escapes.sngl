import . "sngl:ui"
import . "sngl:test"

component main node {
    var newline = "line1\nline2"
    var tab = "col1\tcol2"
    var quote = "she said \"hi\""
    var backslash = "path\\to\\file"
    var rawWithQuote = `say "hi" no\nescape`
    var tripleEmbed = """
        literal "quotes" and \n no interp
    """

    text(value=newline)
}

func testNewlineEscape(t Test, c main) {
    t.assert(c.newline == "line1\nline2")
}

func testTabEscape(t Test, c main) {
    t.assert(c.tab == "col1\tcol2")
}

func testQuoteEscape(t Test, c main) {
    t.assert(c.quote == `she said "hi"`)
}

func testBackslashEscape(t Test, c main) {
    t.assert(c.backslash == `path\to\file`)
}

window {
    main
}
