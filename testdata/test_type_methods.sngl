import . "sngl:ui"
import . "sngl:test"

func testTypeQualifiedCalls(t Test, c main) {
    t.assert(int.double(5) == 10)
    t.assert(int.abs(-3) == 3)
    t.assert(int.abs(7) == 7)
    t.assert(string.exclaim("hi") == "hi!")
}

func testMethodSyntaxCalls(t Test, c main) {
    t.assert(c.n.double() == 10)
    t.assert((-3).abs() == 3)
    t.assert(c.name.exclaim() == "hello!")
}

component main {
    var (
        n = 5
        name = "hello"
    )

    func int.double(x int) => x * 2
    func int.abs(x int) => x < 0 ? -x : x
    func string.exclaim(s string) => "{s}!"

    text(value="test")
}
