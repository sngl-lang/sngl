import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

component main ui {
    var x = 5
    var y = 3

    func bigger() => x > y

    button #bump(text="bump x", @click { x += 1 })
    text #out(value=bigger() ? "x" : "y")
}

func testReactiveMethodDrivesUpdate(t Test, c main) {
    t.assert(c.out.value == "x")
}

app.window {
    main
}
