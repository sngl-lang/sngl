package main

import "testing"

func TestStructsCrossBothWays(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.go__r0Click()
	if !((c.a == 12)) { t.Errorf("assert failed: %s", "(c.a == 12)") }
	if !(((((c.r.Left == 0) && (c.r.Top == 1)) && (c.r.Right == 5)) && (c.r.Bottom == 7))) { t.Errorf("assert failed: %s", "((((c.r.Left == 0) && (c.r.Top == 1)) && (c.r.Right == 5)) && (c.r.Bottom == 7))") }
	if !((c.r.Tag == 8)) { t.Errorf("assert failed: %s", "(c.r.Tag == 8)") }
	if !(((c.q == 3) && (c.rem == 2))) { t.Errorf("assert failed: %s", "((c.q == 3) && (c.rem == 2))") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
