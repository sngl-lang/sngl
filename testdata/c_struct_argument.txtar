A `#[c.native]` struct declaring fields is a SNGL struct with a C layout: the
program holds its own struct, and a call converts it field by field to the C
struct its name spells. A `ref` a C function takes is a pointer it fills:
lower.RefParams makes the call hand back what C wrote, as a function with a
body hands back what it wrote, and the translator hands C the address of a C
temp. The write lands on the caller's variable as an assignment, which every
later pass sees.

The test runs it through shipped C: a 3 by 4 rectangle is 12, growing it by 1
moves each edge and counts the move in the tag, a field written with a C
typedef's alias, which crosses as that type, and 17 / 5 fills two refs, 3 and
2.

deny out/go/bubbletea/model.go `r__inst0 +C\.SnglRect` -- the program holds its own struct, not cgo's
-- app.sngl --
import ui "sngl:ui"
import c "sngl:x/c"
import go "sngl:language/go"
import test "sngl:test"

output {
    go {
        bubbletea
    }
}

c.link(include="rect.h", sources=["rect.c", "rect.h"])

#[c.native("unsigned short")]
struct Tag = int

#[c.native("SnglRect")]
struct Rect {
    left   int
    top    int
    right  int
    bottom int
    tag    Tag
}

#[c.native("sngl_area")]
func area(r Rect) int

#[c.native("sngl_grow")]
func grow(r ref[Rect], by int)

#[c.native("sngl_divide")]
func divide(a int, b int, q ref[int], rem ref[int])

component main ui.node {
    var r = Rect{left=1, top=2, right=4, bottom=6, tag=7}
    var a = 0
    var q = 0
    var rem = 0
    ui.button #go(text="{a}", @click {
        a = area(r)
        grow(&r, 1)
        divide(17, 5, &q, &rem)
    })
}

ui.window(title="t") {
    main()
}

func testStructsCrossBothWays(t test.Test, c main) {
    c.go.click()
    t.assert(c.a == 12)
    t.assert(c.r.left == 0 && c.r.top == 1 && c.r.right == 5 && c.r.bottom == 7)
    t.assert(c.r.tag == 8)
    t.assert(c.q == 3 && c.rem == 2)
}
-- rect.h --
typedef struct {
	int left, top, right, bottom;
	unsigned short tag;
} SnglRect;

// The rectangle's area, handed by value.
int sngl_area(SnglRect r);

// Moves each edge of *r out by by, and counts the move in its tag.
void sngl_grow(SnglRect *r, int by);

// Writes a / b to *q and a % b to *rem.
void sngl_divide(int a, int b, int *q, int *rem);
-- rect.c --
#include "rect.h"

int sngl_area(SnglRect r) {
	return (r.right - r.left) * (r.bottom - r.top);
}

void sngl_grow(SnglRect *r, int by) {
	r->left -= by;
	r->top -= by;
	r->right += by;
	r->bottom += by;
	r->tag++;
}

void sngl_divide(int a, int b, int *q, int *rem) {
	*q = a / b;
	*rem = a % b;
}
