	"charm.land/lipgloss/v2"
	"fmt"
	"net/url"
	"time"
)

type Box struct {
	M url.Values
}

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	t__inst0     *time.Ticker
	boxes__inst0 []Box

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.t__inst0 = nil
	m.boxes__inst0 = []Box{}
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) T__inst0() *time.Ticker {
	return m.t__inst0
}

func (m Model) SetT__inst0(v *time.Ticker) Model {
	m.t__inst0 = v
	return m
}

type setT__inst0Msg struct{ value *time.Ticker }

func SetT__inst0Cmd(v *time.Ticker) tea.Cmd {
	return func() tea.Msg { return setT__inst0Msg{value: v} }
}

func (m Model) Boxes__inst0() []Box {
	return m.boxes__inst0
}

func (m Model) SetBoxes__inst0(v []Box) Model {
	m.boxes__inst0 = v
	return m
}

type setBoxes__inst0Msg struct{ value []Box }

func SetBoxes__inst0Cmd(v []Box) tea.Cmd {
	return func() tea.Msg { return setBoxes__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setT__inst0Msg:
		m = m.SetT__inst0(msg.value)
	case setBoxes__inst0Msg:
		m = m.SetBoxes__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(len(m.boxes__inst0))))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
