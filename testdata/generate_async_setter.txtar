Async colouring reaches a state var's setter. `count` has a `@change` handler
that calls an async native, and the handler runs inside the generated
`$set_count`, so the setter itself is emitted async with the native call
awaited in its body.

-- app.sngl --
import . "sngl:ui"
import api "js:./api"
import app "sngl:app"

output {
    none {
        html
    }
}

component main ui {
    var count = 0 @change {
        api.fetchHello("updated")
    }
    button(text="Go", @click { count = count + 1 })
    text(value=string(count))
}

app.window {
    main
}
-- api/index.ts --
export async function fetchHello(msg: string): Promise<string> { return msg; }
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<button id="$0">
  <span>Go</span>
</button>
<span id="__n0" data-sngl-id="__n0">
</span>

<script>
(() => {
  // sngl-virt:/sngl/api/index.ts
  async function fetchHello(msg) {
    return msg;
  }

  // sngl-entry.js
  var state = { count__inst0: 0 };
  async function $set_count__inst0(v) {
    state.count__inst0 = v;
    await fetchHello("updated");
  }
  function String(v) {
    return "" + v;
  }
  var $0 = document.getElementById("$0");
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  $0.addEventListener("click", function() {
    state.count__inst0 = state.count__inst0 + 1;
    __n0.textContent = String(state.count__inst0);
  });
  function __sngl_init() {
    __n0.textContent = String(state.count__inst0);
  }
  __sngl_init();
})();
</script>
</body></html>
