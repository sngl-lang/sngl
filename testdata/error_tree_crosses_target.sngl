// #[family.crosses] says a placement crosses a family, so it is written on a node
// or a slot insertion in a view and nowhere else. On a declaration it would
// say something about every placement of it, which is what the mark exists not
// to do.

import family "sngl:family"
import ui "sngl:ui"

#[family.crosses] // ERROR(check) "#[family.crosses] cannot mark a function; only a node or a slot insertion in a view is placed in a family"
func f() {}

#[family.crosses] // ERROR(check) "#[family.crosses] cannot mark a component; only a node or a slot insertion in a view is placed in a family"
component c ui.node {
    ui.text(value="c")
}

// A crossing node says it is not of the family its body is, so it is no
// evidence of which family that is: a body of nothing else names none.
component bare() { // ERROR(check) "component bare: the body names no family, so name the family it belongs to in the return position, or return a type parameter, `<F any>(…) F`, to take the family it is placed in"
    #[family.crosses]
    ui.text(value="bare")
}

ui.window(title="t") {
    c()
}
