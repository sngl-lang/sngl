What a boundary's fallback names is used. The shake walked a boundary's
handler and its content and not its fallback, so a function only the fallback
calls was shaken away while the call to it survived: html threw a
ReferenceError the moment the fallback rendered, and gtk4 and bubbletea did
not compile.

-- app.sngl --
import ui "sngl:ui"

var tries = 0

func sorry() string {
    return "failed after {tries}"
}

ui.window(title="t") {
    boundary {
        ui.button(text="boom", @click {
            tries += 1
            error.raise("x", "boom")
        })
        component failed {
            ui.text(value=sorry())
        }
    }
}

output {
    none {
        html
    }
    go {
        gtk4
        bubbletea
    }
}
