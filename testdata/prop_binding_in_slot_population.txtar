A `:prop=` binding is lowered to an event and a write-back wherever the node
stands in the view, a slot's population included. passPropBindings walked a
node's children, an `if`, a `for` and a fallback-less boundary by hand and
skipped a population written by name, so an input inside `component top { … }`
reached html with no listener at all: typing never reached `name`.

-- app.sngl --
import ui "sngl:ui"

var name = ""

component card(top component() ui.node) ui.node {
    ui.vbox {
        top()
    }
}

ui.window(title="t") {
    card {
        component top {
            ui.input(:value=name)
        }
    }
    ui.text(value="hello {name}")
}

output {
    none {
        html
    }
    go {
        gtk4
        fyne
        bubbletea
    }
}
