What a nested func may reach, in the three shapes the flat namespace makes
possible and the hoist makes necessary.

`deep` writes its own `deeper`, so the renamed names compose rather than
collide: `outer__deep__deeper`. `rec` calls itself, and `outer` calls both --
each of which is an ordinary call to a hoisted declaration, because all four
end up in one namespace. The enclosing function's params and locals are the
only thing out of reach, which is the other fixture
(testdata/error_nested_func_capture.sngl).

The order is the point of the rest. The hoist appends, so every one of these
landed after its only caller; android emits an owner's funcs as local `fun`s
inside one composable and a local function may not be referenced above its
declaration, so `orderNestedFuncs` puts each ahead of the body that wrote it.
Read top to bottom below and every callee precedes its caller.

deny * `\b(deeper|deep|rec)__` -- each is emitted under the chain of bodies that wrote it (outer__deep__deeper), so the written name never heads an emitted identifier

-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
    }
}

component main node {
    var n int = 0
    var log string = ""

    func outer(a int) int {
        func deep(k int) int {
            func deeper(j int) int {
                log = log + "."
                return j + 1
            }
            return deeper(k) * 2
        }

        func rec(k int) int {
            log = log + "!"
            if k <= 0 {
                return 0
            }
            return rec(k - 1) + k
        }
        return deep(a) + rec(a)
    }

    text(value="{n}{log}")
    button(text="go", @click {
        n = outer(n)
    })
}

window {
    main
}
