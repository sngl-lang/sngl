-- out/go/bubbletea/model_test.go --
package main

import (
	"duckfam.us/sngl/pkg/go/cload"
	"testing"
)

func TestHeldValuesComeBack(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	o := snglC_g_cancellable_new()
	snglC_g_object_set_data_full(o, "a", cload.Hold(State{Title: "one", Count: 1}), cload.Release())
	if !((Describe(o, "a") == "one 1")) { t.Errorf("assert failed: %s", "(Describe(o, \"a\") == \"one 1\")") }
	if !((Describe(o, "b") == "none")) { t.Errorf("assert failed: %s", "(Describe(o, \"b\") == \"none\")") }
	snglC_g_object_set_data_full(o, "a", cload.Hold(State{Title: "two", Count: 2}), cload.Release())
	snglC_g_object_set_data_full(o, "b", cload.Hold(State{Title: "three", Count: 3}), cload.Release())
	if !((Describe(o, "a") == "two 2")) { t.Errorf("assert failed: %s", "(Describe(o, \"a\") == \"two 2\")") }
	if !((Describe(o, "b") == "three 3")) { t.Errorf("assert failed: %s", "(Describe(o, \"b\") == \"three 3\")") }
	snglC_g_object_unref(o)
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
