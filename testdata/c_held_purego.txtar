A Go program calling C through purego hands C a held value (sngl:x/c's
held) as the uintptr pkg/go/cload's Hold answers, which finds a copy in
cbind's registry, and the release as the one C function cload makes for
every held value; a result written `option[c.held[T]]` finds it again
through cload.Held.

Here GObject holds it, as a platform's widget would: g_object_set_data_full
keeps a State under a key and lets the one it replaces go, and
g_object_unref lets go of what is left. The test runs it.

deny out/go/bubbletea/model.go `import "C"` -- no cgo

-- app.sngl --
import c "sngl:x/c"
import test "sngl:test"
import ui "sngl:ui"

output {
    go(cgo="purego") {
        bubbletea
    }
}

c.link(include="gio/gio.h", system=true, library="gio-2.0")

#[c.native("GCancellable *")]
struct Object {}

struct State {
    title string
    count int
}

#[c.native("g_cancellable_new")]
func newObject() Object

#[c.native("g_object_set_data_full")]
func hold(o Object, key string, s c.held[State], #[c.release] release c.pointer)

#[c.native("g_object_get_data")]
func held(o Object, key string) option[c.held[State]]

#[c.native("g_object_unref")]
func unref(o Object)

func describe(o Object, key string) string {
    var s = held(o, key)
    if s != null {
        return "{s.title} {s.count}"
    }
    return "none"
}

component main ui.node {
    ui.text("held")
}

func testHeldValuesComeBack(t test.Test, c main) {
    var o = newObject()
    hold(o, "a", State{title="one", count=1})
    t.assert(describe(o, "a") == "one 1")
    t.assert(describe(o, "b") == "none")
    hold(o, "a", State{title="two", count=2})
    hold(o, "b", State{title="three", count=3})
    t.assert(describe(o, "a") == "two 2")
    t.assert(describe(o, "b") == "three 3")
    unref(o)
}

ui.window(title="t") {
    main()
}
