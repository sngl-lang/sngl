A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_spacer.sngl --
import . "sngl:ui"

// spacer: A-tier — no testable state. Declaration validates
// parse + check + lower.
component main node {
    hbox {
        text(value="left")
        spacer
        text(value="right")
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
