A slot entry populated on a component built at run time, on every target.

`layout component(n int, content component node) node` hands its population
a value and a component entry. `Card` inserts `layout(k)` and populates the
entry with content reading its own state; the caller's population places
`content` inside a vbox of its own, reading its loop variable and `n`. Each
copy therefore renders the caller's frame around the callee's body, and the
entry's effect reports through `Card`'s own event.

On html, fyne and gtk4 the population is spliced into a copy of `Card`, `n`
bound to `k` and `content` to the entry's population. android passes `layout`
as a composable taking an `Int` and a nullable composable for the entry, and
`Card`'s `@report` as an `onReport` parameter -- which a user composable did
not declare, so the entry's emit named nothing. bubbletea splices. The test
runs on every target, and reads the two effects separately because targets
mount sibling effects in different orders.

deny out/none/html/index.html `String\(n\)` -- the population's value is bound to the copy's state where it is inserted
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `layout: \(@Composable \(Int, \(@Composable \(\) -> Unit\)\?\) -> Unit\)\? = null\) \{` -- the composable declares the event it emits
-- app.sngl --
import . "sngl:test"
import . "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component Card(start int, @report(v string), layout component(n int, content component node) node) node {
    var k = start

    vbox {
        layout(k) {
            component content {
                text(value="content {k}")
                effect(on=k, @mount(x) { report("c{x}") })
            }
        }
    }
}

component main node {
    var items = [1, 2]
    var heads = ""
    var contents = ""

    vbox {
        button #add(text="add", @click { items.push(3) })
        for var i = items {
            Card(start=i * 5, @report(s) { contents = contents + s + " " }) {
                component layout(n, content) {
                    vbox {
                        text(value="head {i} {n}")
                        effect(on="{i}:{n}", @mount(k) { heads = heads + k + " " })
                        content
                    }
                }
            }
        }
    }
}

func testEntryPerCopy(t Test, c main) {
    t.assert(c.heads == "1:5 2:10 ")
    t.assert(c.contents == "c5 c10 ")
    c.add.click()
    t.assert(c.heads == "1:5 2:10 3:15 ")
    t.assert(c.contents == "c5 c10 c15 ")
}

window {
    main
}
