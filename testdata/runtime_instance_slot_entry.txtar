-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestEntryPerCopy(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.heads == "1:5 2:10 ")) { t.Errorf("assert failed: %s", "(c.heads == \"1:5 2:10 \")") }
	if !((c.contents == "c5 c10 ")) { t.Errorf("assert failed: %s", "(c.contents == \"c5 c10 \")") }
	c.addClick()
	if !((c.heads == "1:5 2:10 3:15 ")) { t.Errorf("assert failed: %s", "(c.heads == \"1:5 2:10 3:15 \")") }
	if !((c.contents == "c5 c10 c15 ")) { t.Errorf("assert failed: %s", "(c.contents == \"c5 c10 c15 \")") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
