func (m *Model) directClick() {
	prev := m.__focusID
	m.__focusID = 0
	nm, _ := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
}

// calledClick activates the #called widget the way a keypress does; for tests.
func (m *Model) calledClick() {
	prev := m.__focusID
	m.__focusID = 1
	nm, _ := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = lipgloss.NewStyle().Render(part0Prefix + " " + fmt.Sprint("Direct"))
	parts = append(parts, part0)
	var part1 string
	part1Focused := (m.__focusID == 1)
	part1Prefix := " "
	if part1Focused {
		part1Prefix = ">"
	}
	part1 = lipgloss.NewStyle().Render(part1Prefix + " " + fmt.Sprint("Called"))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
