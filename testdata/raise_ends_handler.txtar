	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestDirectRaiseEndsHandler(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.directClick()
	c.directClick()
	if !((c.caught == 2)) { t.Errorf("assert failed: %s", "(c.caught == 2)") }
	if !((c.before == 2)) { t.Errorf("assert failed: %s", "(c.before == 2)") }
	if !((c.after == 0)) { t.Errorf("assert failed: %s", "(c.after == 0)") }
}

func TestCalledRaiseEndsHandler(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.calledClick()
	c.calledClick()
	if !((c.callCaught == "from check")) { t.Errorf("assert failed: %s", "(c.callCaught == \"from check\")") }
	if !((c.callBefore == 2)) { t.Errorf("assert failed: %s", "(c.callBefore == 2)") }
	if !((c.wrote == 2)) { t.Errorf("assert failed: %s", "(c.wrote == 2)") }
	if !((c.back == 0)) { t.Errorf("assert failed: %s", "(c.back == 0)") }
	if !((c.callAfter == 0)) { t.Errorf("assert failed: %s", "(c.callAfter == 0)") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
