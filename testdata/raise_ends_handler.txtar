A raise a boundary catches ends the event handler, as an exception would: what
the handler wrote before the raise stays written and nothing after it runs --
not in the handler, not in a caller between, not in the function that raised.
There is no rollback. The boundary's own handler runs in place of the rest.

Each button writes, raises, then writes again, and is clicked twice: the
second click runs the handler from the top again, so `before` counts both
clicks and `after` neither. `wrote` is the callee's half -- written in the
function that raises, ahead of the raise -- and `back` is the caller's,
written after the call returns, which it never does.

The records here execute the tests on bubbletea, fyne and android and only
compile gtk4 and html; cmd/sngl/testdata/raise_ends_handler_runs.txt runs the
same program on the interpreter, in a real Chromium and on gtk4.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

func stop(why string) {
    error.raise(why, "stop")
}

// The two cases keep disjoint state because html's test agent shares one
// page's state across the tests of a component.
component form node {
    var caught = 0
    var before = 0
    var after = 0

    var callCaught = ""
    var callBefore = 0
    var wrote = 0
    var back = 0
    var callAfter = 0

    func check() {
        wrote = wrote + 1
        stop("from check")
        wrote = wrote + 100
    }

    func submit() {
        check()
        back = back + 1
    }

    boundary(@error(e) {
        caught = caught + 1
    }) {
        button #direct(text="Direct", @click {
            before = before + 1
            error.raise("stop", "stop")
            after = after + 1
        })
    }

    boundary(@error(e) {
        callCaught = e.message
    }) {
        button #called(text="Called", @click {
            callBefore = callBefore + 1
            submit()
            callAfter = callAfter + 1
        })
    }
}

func testDirectRaiseEndsHandler(t Test, c form) {
    c.direct.click()
    c.direct.click()
    t.assert(c.caught == 2)
    t.assert(c.before == 2)
    t.assert(c.after == 0)
}

func testCalledRaiseEndsHandler(t Test, c form) {
    c.called.click()
    c.called.click()
    t.assert(c.callCaught == "from check")
    t.assert(c.callBefore == 2)
    t.assert(c.wrote == 2)
    t.assert(c.back == 0)
    t.assert(c.callAfter == 0)
}

window {
    form()
}

output {
    go {
        bubbletea
        fyne
        gtk4
        html
    }
    kotlin {
        android
    }
    none {
        html
    }
}
