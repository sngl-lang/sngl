// directClick activates the #direct widget the way a keypress does; for tests.
func (m *Model) directClick() {
	prev := m.__focusID
	m.__focusID = 0
	nm, cmd := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
	_ = m.View()
	_ = cmd
}

// calledClick activates the #called widget the way a keypress does; for tests.
func (m *Model) calledClick() {
	prev := m.__focusID
	m.__focusID = 1
	nm, cmd := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
	_ = m.View()
	_ = cmd
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = BoxLook(Style{FlexDirection: "unset", AlignItems: "unset", JustifyContent: "unset", Position: "unset", FontWeight: "unset", FontStyle: "unset", TextAlign: "unset", WhiteSpace: "unset", BorderStyle: "unset", Display: "unset", ListStyleType: "unset"}, true).Render(part0Prefix + " " + fmt.Sprint("Direct"))
	parts = append(parts, part0)
	var part1 string
	part1Focused := (m.__focusID == 1)
	part1Prefix := " "
	if part1Focused {
		part1Prefix = ">"
	}
	part1 = BoxLook(Style{FlexDirection: "unset", AlignItems: "unset", JustifyContent: "unset", Position: "unset", FontWeight: "unset", FontStyle: "unset", TextAlign: "unset", WhiteSpace: "unset", BorderStyle: "unset", Display: "unset", ListStyleType: "unset"}, true).Render(part1Prefix + " " + fmt.Sprint("Called"))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

