var plain = {o={v=1}}

// A generic component spliced where it is written is spliced at the types its
// call site bound: its state and its method name `struct { v int }`.
component tally[T any](
    w struct {
        v T
    },
    @picked(p struct {
        v T
    }),
) {
    var held struct {
        v T
    } = w
    func boxed(y T) struct {
        v T
    } {
        return {v=y}
    }
    ui.button(text="pick", @click {
        picked(boxed(held.v))
    })
}

var got = 0

ui.window(title="t") {
    ui.text(value="{unwrap({v=1}) + 1} {unwrap(wrap("w"))} {box.get()} {box.all[0].v} {outer.o.v} {opt.v == 3} {absent.v == null} {nums.v.length}")
    tally(w={v=1}, @picked(p) {
        got = p.v
    })
    ui.button(text="go", @click {
        box = Box[int]{inner={...wrap(n)}, all=[]}
        outer = plain
        absent = held[option[int]](n)
        nums.v.push(n)
        n = n + 1
    })
}
