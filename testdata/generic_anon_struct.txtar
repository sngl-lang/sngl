var box = Box[int]{inner={v=5}, all=[{v=6}]}
// A call inlined into another literal, and that literal's interned twin.
func held[T any](x T) => {v=x}

var outer = {o=held(1)}
// Folded at the type the call binds, not at the value's own: an option holding
