A Go program whose `cgo` option is "direct" calls gtk4's C itself: the
program writes `import "C"`, compiles the runtime's sources beside it, and
names no wrapper package, its handles and C structs spelled as cgo spells
them. Its entry and its posting are the program's own (sngl_rt.go), a
closure crossing as a context their trampoline looks up. The program runs:
the timer's handler is a callback C calls, and the canvas's paint and the
image's drawing are others.

deny out/go/gtk4/main.go `lib/platform/gtk4/cgo` -- no wrapper is called
deny out/go/gtk4/sngl_rt.go `lib/platform/gtk4/cgo` -- nor by the entry

exec out/go/gtk4 -- ran.txt
-- app.sngl --
import draw "sngl:ui/draw"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"

#[go.native("fmt", "fmt.Println")]
func say(s string)

output {
    go(cgo="direct") {
        gtk4
    }
}

var ticks = 0

time.timer(interval=100ms, @tick {
    ticks += 1
    if ticks == 3 {
        say("ticked {ticks}")
        gtk4.quit()
    }
})

ui.window(title="t") {
    ui.text(value="{ticks}")
    draw.canvas(width=40px, height=40px) {
        draw.circle(cx=20.0, cy=20.0, r=10.0 + float(ticks), style={fill=#3366CC})
    }
    ui.image {
        draw.image(width=20.0, height=20.0) {
            draw.rect(x=0.0, y=0.0, w=20.0, h=20.0, style={fill=#00AA00})
        }
    }
}
-- ran.txt --
ticked 3
-- out/go/gtk4/main.go --
