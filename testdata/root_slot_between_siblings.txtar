	gtk4rt.Connect(m.more, "clicked", m.more_clicked_handler)
	gtk4rt.BoxAppend(m.__root, m.__n11)
	gtk4rt.BoxAppend(m.__root, m.more)
}

// BuildUI constructs the widget tree and returns the top-level window.
func (m *Model) BuildUI(app gtk4rt.Handle) gtk4rt.Handle {
	m.buildWidgetTree()
	win := gtk4rt.ApplicationWindowNew(app)
	gtk4rt.WindowSetDefaultSize(win, 480, 640)
	gtk4rt.WindowSetChild(win, m.__root)
	return win
}

// moreClick fires the "clicked" signal on the #more widget; for tests.
func (m *Model) moreClick() {
	gtk4rt.Emit(m.more, "clicked")
}
