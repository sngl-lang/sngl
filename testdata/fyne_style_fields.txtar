A ui.Style on fyne, written as a literal and held in a var and a prop, takes
one function, style.sngl's lookOf, and each node it asks anything of is
shown in a fynelayout.Box carrying the Look it built. The held ones went
through a Go helper, __styleTheme, that read a `1em` fontSize as `.px` alone,
so as nothing, and both paths dropped paddingX, a label's background, the
border, the width, textAlign and fontFamily. A vbox with no `flex` child was
container.NewVBox, which dropped its gap, padding and alignItems and every
child's margin, and the weighted layout read only `margin`, so `marginLeft`
went too. Every box is fynelayout's now, reading a child's share off its Box.

deny out/go/fyne/model.go `__styleTheme` -- a held Style takes the function a literal does
deny out/go/fyne/model.go `container\.NewVBox\(\)` -- a vbox reads its gap, padding and alignment and its children's margins
deny out/go/fyne/model.go `\[\]float32\{4, 0\}` -- a child's marginLeft reaches the layout
-- app.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
    }
}

var held ui.Style = {color=#336699, fontSize=1em, paddingX=8px, background=#eeeeee}

component labelled(look ui.Style) {
    ui.text(value="prop", style=look)
}

ui.window(title="Style") {
    ui.vbox(style={gap=6px, padding=1rem, alignItems=ui.Alignment.center}) {
        ui.text(value="literal", style={color=#336699, fontSize=1em, paddingX=8px, background=#eeeeee})
        ui.text(value="var", style=held)
        labelled(look=held)
        ui.text(value="dropped", style={borderWidth=2px, borderColor=#ff0000, borderRadius=4px, width=200px, textAlign=ui.TextAlign.center, fontFamily="monospace"})
        ui.hbox {
            ui.button(text="one", style={flex=1.0, margin=4px})
            ui.button(text="two", style={flex=2.0, marginLeft=1em})
        }
        ui.vbox {
            ui.text(value="kept apart", style={margin=8px})
            ui.text(value="beside")
        }
    }
}
-- out/go/fyne/model.go --
