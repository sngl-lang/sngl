An `if` branch, a loop body or a boundary's content that renders more than one
node has to join them, since bubbletea renders each position into one string
var. Rendered one after another into that var, every node but the last was
lost -- silently for plain text, and as `partN := ...` redeclared, which does
not compile, for two focusable buttons. Each part now gets a var of its own
and the group is joined along the enclosing container's axis: vertically at
the root and in a vbox, horizontally in an hbox.

deny out/go/bubbletea/model.go `(?m)^\t+(part\d+) = .*\n\t+(part\d+) = ` -- no part is assigned twice in a row, which is what dropping the first looks like
deny out/go/bubbletea/model.go `(?m)^\t+part0Focused :=[^\n]*\n(?s:.*)^\t+part0Focused :=` -- one focus flag per button

-- parts.sngl --
import . "sngl:ui"

component main node {
    var on = true
    var caught = ""
    if on {
        button #a(text="A", @click { on = false })
        button #b(text="B", @click { on = false })
    }
    boundary(@error(e) { caught = e.message }) {
        button #c(text="C", @click { error.raise("c", "") })
        text(value=caught)
    }
    hbox {
        for var n = ["x", "y"] {
            text(value=n)
            text(value="|")
        }
    }
}

window {
    main
}

output {
    go {
        bubbletea
    }
}
