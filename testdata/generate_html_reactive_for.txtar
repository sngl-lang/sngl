A for-loop in a visual tree becomes a slot the html platform re-renders whole.
The emission is an accumulator `__slot0` holding the nodes the loop created, a
`__renderSlot0(parent)` that removes those, clears the accumulator and rebuilds
from `state.items`, and a `data-sngl-slot` anchor marking where they go. The
initial render calls it at bootstrap; a handler that mutates `items` calls it
again, and that second call is what makes the loop reactive.

Each is emitted once, which it was not until this golden showed it. A page
whose root is a component and not an explicit `window` is served as a window
whose Funcs are that component's, so every synthesized func reached
synthesizedFuncs from two sources -- and both loops that consume that list
ran, defining __renderSlot0 twice and calling it twice at startup, the second
call removing the nodes the first had just built.

The handler is the other thing that changed. `items = items.push("new")`
compiled to `state.items = state.items.push("new")`, and JavaScript's push
answers the new length -- so the list became 4 on the first click and the
re-render walked a number. It is the bare call now; list_push_is_a_statement
covers the rule across all three languages.
-- app.sngl --
import . "sngl:ui"

output { none { html } }

component main {
    var items list<string> = ["a", "b", "c"]
    button(text="add", @click { items = items.push("new") })
    for var item = items {
        text(value=item)
    }
}
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<button id="$0">
  <span>add</span>
</button>
<span data-sngl-slot="0" style="display:contents"></span>

<script>
(() => {
  // sngl-entry.js
  var state = { items: ["a", "b", "c"] };
  var __slot0 = [];
  function __renderSlot0(parent) {
    for (const __entry of __slot0) {
      parent.removeChild(__entry);
    }
    __slot0 = [];
    for (const item of state.items) {
      let __n0 = document.createElement("span");
      __n0.textContent = item;
      parent.appendChild(__n0);
      __slot0.push(__n0);
    }
  }
  var __slotAnchor_0 = document.querySelector('[data-sngl-slot="0"]');
  __renderSlot0(__slotAnchor_0);
  var $0 = document.getElementById("$0");
  $0.addEventListener("click", function() {
    state.items.push("new");
    __renderSlot0(__slotAnchor_0);
  });
})();
</script>
</body></html>
