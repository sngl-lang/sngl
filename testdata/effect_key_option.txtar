package main

import (
	"strings"
	"testing"
)

func TestSameValuesHoldTheLifetime(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((strings.Join(c.log, ",") == "+")) { t.Errorf("assert failed: %s", "(strings.Join(c.log, \",\") == \"+\")") }
	c.sameClick()
	if !((strings.Join(c.log, ",") == "+")) { t.Errorf("assert failed: %s", "(strings.Join(c.log, \",\") == \"+\")") }
}

func TestPresenceAndValueRekey(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.setClick()
	if !((strings.Join(c.log, ",") == "+,-,+")) { t.Errorf("assert failed: %s", "(strings.Join(c.log, \",\") == \"+,-,+\")") }
	c.againClick()
	if !((strings.Join(c.log, ",") == "+,-,+")) { t.Errorf("assert failed: %s", "(strings.Join(c.log, \",\") == \"+,-,+\")") }
	c.clear__r0Click()
	if !((strings.Join(c.log, ",") == "+,-,+,-,+")) { t.Errorf("assert failed: %s", "(strings.Join(c.log, \",\") == \"+,-,+,-,+\")") }
}

