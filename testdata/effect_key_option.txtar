An option in an effect's key compares by presence and then by what it
holds, never with the option's own ==: Go's option is a pointer, and two
reads of one value are two pointers. So a key of a struct holding options --
which is what an adapter's key is when its parameters are optional -- holds
one lifetime while the values hold, and the tests run on every target say so.
-- app.sngl --
import . "sngl:test"
import . "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
    }
    kotlin {
        android
    }
}

component keyed node {
    var limit option[int] = null
    var name option[string] = "a"
    var log list[string] = []
    button #same(text="same", @click {
        limit = null
        name = "a"
    })
    button #set(text="set", @click { limit = 2 })
    button #again(text="again", @click { limit = 2 })
    button #clear(text="clear", @click { name = null })
    effect(on={limit=limit, name=name}, @mount { log.push("+") }, @unmount { log.push("-") })
    text(value=log.join(","))
}

func testSameValuesHoldTheLifetime(t Test, c keyed) {
    t.assert(c.log.join(",") == "+")
    c.same.click()
    t.assert(c.log.join(",") == "+")
}

func testPresenceAndValueRekey(t Test, c keyed) {
    c.set.click()
    t.assert(c.log.join(",") == "+,-,+")
    c.again.click()
    t.assert(c.log.join(",") == "+,-,+")
    c.clear.click()
    t.assert(c.log.join(",") == "+,-,+,-,+")
}

window {
    keyed
}
