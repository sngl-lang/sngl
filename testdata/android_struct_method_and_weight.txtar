    var it by remember { mutableStateOf(Item(n = 3, span = 1.0)) }

    Column {
        Row(modifier = Modifier.safeDrawingPadding()) {
            Text(text = it.label(), modifier = Modifier.weight((it.span).toFloat()).fillMaxHeight())
        }
        Button(onClick = {
            it = Item(n = (it.n + 1), span = 1.0)
        }, modifier = Modifier.safeDrawingPadding()) {
            Text(text = "bump", modifier = Modifier)
        }
