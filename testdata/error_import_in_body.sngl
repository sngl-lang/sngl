import . "sngl:ui"
import app "sngl:app"

component inComponent node {
    import q "sngl:seq" // ERROR(check) "an import may only be written at the root of a file"

    for var i = q.count(3) {
        text(value="${i}")
    }
}

func inFunc() int {
    import r "sngl:seq" // ERROR(check) "an import may only be written at the root of a file"

    var total = 0
    for var i = r.count(3) {
        total = total + i
    }
    return total
}

component main node {
    inComponent()
    text(value="${inFunc()}")
}

app.window {
    main
}
