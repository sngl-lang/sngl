import . "sngl:ui"

component inComponent node {
    import q "sngl:seq" // ERROR(check) "an import may only be written at the root of a file"

    text(value="in a component")
}

func inFunc() int {
    import r "sngl:seq" // ERROR(check) "an import may only be written at the root of a file"

    return 0
}

component main node {
    inComponent()
    text(value="{inFunc()}")
}

window {
    main
}
