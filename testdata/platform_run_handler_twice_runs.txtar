A process runs one application. `run` presents the tree the host built
before the handler and tears it down before it returns, so a second `run`
would present a tree that has unmounted; building another would start a
second application whose state none of the handler's writes reached. The
second call is refused, naming the handler, and the process exits 2.

exec out/go/gtk4 exit=2 2>gtk4_refused.txt -- want.txt
exec out/go/fyne exit=2 2>fyne_refused.txt -- want.txt
-- app.sngl --
import go "sngl:language/go"
import time "sngl:time"
import ui "sngl:ui"

#[go.native("fmt", "fmt.Print")]
func print(s string)

#[go.native("syscall", "syscall.Signal")]
struct Signal {}

#[go.native("syscall", "syscall.SIGTERM")]
const sigterm Signal

#[go.native("syscall", "syscall.Getpid")]
func getpid() int

#[go.native("syscall", "syscall.Kill")]
func kill(pid int, sig Signal)

var stopped = false

output {
    go {
        gtk4(@run(args, run) {
            twice(run)
        })
        fyne(@run(args, run) {
            twice(run)
        })
    }
}

func twice(run func()) {
    run()
    print("returned\n")
    run()
    print("returned again\n")
}

time.timer(interval=100ms, @tick {
    if !stopped {
        stopped = true
        print("tick\n")
        kill(getpid(), sigterm)
    }
})

ui.window {
    effect(@unmount {
        print("unmount\n")
    })
    ui.text(value="hi")
}
-- want.txt --
tick
unmount
returned
-- gtk4_refused.txt --
app.sngl:24:15: run called again; an application runs once per process
-- fyne_refused.txt --
app.sngl:27:15: run called again; an application runs once per process
-- out/go/fyne/model.go --
