// for ... = expr binds to an iter<T>; list<T> implicitly converts.

func sum(xs list<int>) int {
    var total = 0
    for x = xs {
        total = total + x
    }
    return total
}

// Map iteration yields iter<(K, V)> — for-loop with key/value pair.
func keys(m map<string, int>) list<string> {
    var out list<string> = []
    for k, _ = m {
        out = out.push(k)
    }
    return out
}

// Function taking an iter<T> directly. A list<int> can be passed.
func count(xs iter<int>) int {
    var n = 0
    for _ = xs {
        n = n + 1
    }
    return n
}

func test() {
    var nums list<int> = [1, 2, 3]
    var n = count(nums) // list<int> implicitly converts to iter<int>
}
