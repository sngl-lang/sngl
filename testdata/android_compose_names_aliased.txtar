Every Compose name the android screen writes reaches it through Name, the
emitter's own spellings and the library's declarations alike: the Modifier
chain a Style builds, a Row's vertical alignment, a link's colour, a dialog's
shape. So a program may declare what those names are spelled as -- a
component `modifier`, a struct `alignment` -- and keep its names, the
imports aliased around them, where the platform used to reserve each and
rename the program's declaration.

What `chain` and `args` wrote as Kotlin text are declarations now: `then`
takes Modifier values a program builds from `#[kt.native]` calls, and a value
SNGL had no way to write -- `Alignment.CenterVertically`, a `MaterialTheme`
colour or shape -- is a host const a typed prop takes.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `__r\d` -- nothing the program declares is renamed
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `^import androidx\.compose\.ui\.Modifier$` -- the program's Modifier owns the simple name
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `^import androidx\.compose\.ui\.Alignment$` -- the program's Alignment owns the simple name
-- app.sngl --
import ui "sngl:ui"
import android "sngl:platform/android"

output {
    kotlin {
        android
    }
}

struct alignment {
    x int
}

struct textStyle {
    size int
}

// State, so each is a composable the file declares rather than a body
// spliced away.
component modifier(label string) ui.node {
    var taps = 0
    ui.button(text="{label} {taps}", @click {
        taps = taps + 1
    })
}

component dialog(content option[component ui.node]) ui.node {
    var open = true
    if open {
        ui.card {
            content
        }
    }
}

var checked = false
var shown = false
var a = alignment{x=1}
var t = textStyle{size=2}

ui.window(title="Names") {
    ui.scroll {
        android.Column(then=[android.modifier.fillMaxSize()]) {
            ui.checkbox(label="check", :checked=checked)
            ui.link(text="docs", href="https://example.com")
            ui.text(value="{a.x} {t.size}")
            for var l = ["a", "b"] {
                dialog {
                    component content {
                        modifier(label=l)
                    }
                }
            }
            ui.modal(title="m", open=shown) {
                component content {
                    ui.text(value="inside")
                }
            }
        }
    }
}
