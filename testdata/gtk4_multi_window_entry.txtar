gtk4 opens every window, and `output(entry = …)` says which one BuildUI returns.

Each window is a GtkApplicationWindow of its own over the one Model. BuildUI
presents every window but the entry and returns the entry for its caller to
present, so the entry is the one on top. With no entry named it is the
first; here it is `#two`, the second.

deny out/go/gtk4/model.go `gtk4rt\.WindowPresent\(win\)` -- the entry is returned for the caller to present, not presented twice

-- app.sngl --
import ui "sngl:ui"

output(entry=two) {
    go {
        gtk4
    }
}

ui.window #one(title="One") {
    ui.text(value="one")
}

ui.window #two(title="Two") {
    ui.text(value="two")
}
-- out/go/gtk4/callbacks.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

import "git.duckfam.us/jonathan/sngl/pkg/go/gtk4rt"

func main() {
	gtk4rt.Run(func(app gtk4rt.Handle) gtk4rt.Handle {
		return New().BuildUI(app)
	})
}
-- out/go/gtk4/model.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

import (
	"git.duckfam.us/jonathan/sngl/pkg/go/gtk4rt"
)

// Model holds the state and widget references for this SNGL UI.
type Model struct {
	__n0    gtk4rt.Handle
	__n1    gtk4rt.Handle
	__root  gtk4rt.Handle
	__root1 gtk4rt.Handle
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	return m
}

func (m *Model) buildWidgetTree() {
	if m.__root != nil {
		return
	}
	m.__root = gtk4rt.BoxNew(gtk4rt.OrientationVertical, 6)
	m.__n0 = gtk4rt.LabelNew("")
	gtk4rt.LabelSetText(m.__n0, "one")
	gtk4rt.BoxAppend(m.__root, m.__n0)
	m.__root1 = gtk4rt.BoxNew(gtk4rt.OrientationVertical, 6)
	m.__n1 = gtk4rt.LabelNew("")
	gtk4rt.LabelSetText(m.__n1, "two")
	gtk4rt.BoxAppend(m.__root1, m.__n1)
}

// BuildUI constructs the widget tree and returns the top-level window.
func (m *Model) BuildUI(app gtk4rt.Handle) gtk4rt.Handle {
	m.buildWidgetTree()
	win0 := gtk4rt.ApplicationWindowNew(app)
	gtk4rt.WindowSetDefaultSize(win0, 480, 640)
	gtk4rt.WindowSetTitle(win0, "One")
	gtk4rt.WindowSetChild(win0, m.__root)
	gtk4rt.WindowPresent(win0)
	win := gtk4rt.ApplicationWindowNew(app)
	gtk4rt.WindowSetDefaultSize(win, 480, 640)
	gtk4rt.WindowSetTitle(win, "Two")
	gtk4rt.WindowSetChild(win, m.__root1)
	return win
}
