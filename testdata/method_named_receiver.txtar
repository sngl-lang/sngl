A method may name its receiver: `func Op.symbol(o Op)` reads it as `o`.

Kotlin emits a method on a user type as an extension function, whose receiver
is `this` whatever the declaration called it. The body's `o` was rewritten by
name, and the ident emitter skips name rewrites for a parameter, so the body
read an `o` nothing declared and examples/calculator did not compile on
android.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `\b(o|gl)\b[.)=]` -- the named receiver is spelled `this` inside the extension

-- app.sngl --
import . "sngl:ui"

output {
    kotlin { android }
}

enum Op { add, sub }

func Op.symbol(o Op) string {
    if o == Op.add {
        return "+"
    }
    return "-"
}

struct Glyph {
    a bool = false
}

func Glyph.row(gl Glyph, row int) string {
    if gl.a {
        return "{row}"
    }
    return " "
}

window {
    var op = Op.add
    var g = Glyph{a=true}

    vbox {
        text(value=op.symbol())
        button(text="sub", @click { op = Op.sub })
        text(value=g.row(1))
        button(text="flip", @click { g = Glyph{a=!g.a} })
    }
}
