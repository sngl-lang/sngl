    val rev = remember { xs.reversed().toMutableStateList() }
    val evens = remember { xs.filter({ n -> ((n % 2) == 0) }).toMutableStateList() }
    val empty = remember { mutableStateListOf<Int>() }
    var idx by remember { mutableStateOf(xs.indexOf(2)) }

