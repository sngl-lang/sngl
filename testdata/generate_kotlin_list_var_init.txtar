A list-typed var whose initializer is an expression rather than a literal must
keep that expression in the state declaration instead of being replaced by an
empty list. A literal is still `mutableStateListOf` varargs; a computed one
keeps its expression with `.toMutableStateList()` appended to convert the
result to snapshot state. An empty list is typed explicitly, since Kotlin
cannot infer an element type from nothing. Scalars are untouched -- `idx` is an
ordinary `mutableStateOf` over the same expression.
-- app.sngl --
import . "sngl:ui"

output { kotlin { android } }

component main node {
    var xs list<int> = [3, 1, 2]
    var rev list<int> = xs.reverse()
    var evens list<int> = xs.filter(func(n int) => n % 2 == 0)
    var empty list<int> = []
    var idx int = xs.indexOf(2)
    text(value=string(rev.length()) + string(evens.length()) + string(empty.length()) + string(idx))
}

window {
    main
}
