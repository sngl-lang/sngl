// A type parameter may carry a default, the way a value parameter does. An
// argument list that stops short falls back to them, so this is a general
// feature rather than something one generic in the tree package special-cases.

import . "sngl://std"
import tr "sngl://tree"

struct Pair<A, B = string> {
    left A
    right B
}

struct Boxed<T = int> {
    v T
}

// A default is a type reference, so it may name a declaration further down the
// file the way a field may. Resolving it when the shell is registered reported
// this as unknown.
struct Forward<T = Later> {
    v T
}

struct Later {
    n int
}

// A default may name a parameter declared beside it, since the whole list is in
// scope while any of it resolves. The function form always could; the struct
// form resolved its defaults outside that scope and reported A as unknown.
struct Sibling<A, B = A> {
    left A
    right B
}

func idr<T, U = T>(a T, b U) => a

// `Pair<int>` fills B from its default; `Boxed` fills its only parameter and
// needs no argument list at all.
component show(
    p Pair<int> = {left=1, right="s"},
    q Pair<int, bool> = {left=2, right=true},
    b Boxed = {v=3},
    // tr.one's parameter defaults to the tree an ordinary component belongs
    // to, so the wrapper stands on its own.
    slot body tr.one,
) {
    vbox {
        text(value=p.right)
        text(value="{q.right}")
        text(value="{b.v}")
        body {}
    }
}

// A function's parameters take defaults the same way, and from the same struct:
// `empty` has no argument to infer T from, so it falls back rather than staying
// unbound.
func empty<T = string>() list<T> {
    return []
}

func pick<T = string>(v T) T {
    return v
}

component main {
    var names list<string> = empty()
    var greeting = pick("hi")

    show() {
        slot body {
            text(value="{names.length()}{greeting}")
        }
    }
}

// A method's body resolves the receiver's type parameters, not just its
// signature: `T` in the return type worked while `T` in a body declaration did
// not, so the declaration was accepted and its body was not.
func Boxed<T>.replace(b Boxed<T>, other T) T {
    var previous T = b.v
    return previous
}
