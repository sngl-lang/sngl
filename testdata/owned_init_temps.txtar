What a var's initializer makes and only borrows -- `open(fd)` in
`var n = size(open(fd))`, where `size` reads the file and answers a number --
is held with what holds the var and released with it. An initializer has no
statement around it to release a temp after, so OwnedState gives each such
allocation a var of its own declared ahead of the var that borrows it: the
component's `__init0` is an owned var of the component, released when the
node unmounts with `f`, whose initializer answers the value it makes; the
package's `__init1` is a package var, released at teardown. `seed` keeps the
package initializer from folding to a constant, which the optimizer does
ahead of every pass.

deny * `size\(open\(` -- an initializer's temp is bound to a var of its own, never left inline

-- app.sngl --
import ui "sngl:ui"
import macro "sngl:macro"

output {
    go {
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

#[macro.owned(close)]
struct file {
    fd int
}

func close(f file) {
}

func open(fd int) file {
    return file{fd=fd}
}

func size(f file) => f.fd * 10

component sized(fd int = 1) ui.node {
    var n = size(open(fd))
    var f = open(fd + 1)

    ui.text(value="{n} {f.fd}")
}

var seed = 4
var total = size(open(seed))

ui.window(title="t") {
    sized
    ui.text(value="{total}")
}
