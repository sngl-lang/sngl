Every write of a GIR class's prop is the call its #[gen.protocol(set)]
makes, which lowering splices as the write's value, its first render and
each write after alike: gtk4rt's wrapper where gtk4rt wraps the setter --
the label's text, the check button's state, the box's orientation, whose
"vertical" a match folds to its value -- so a program writing only those
keeps wrapped mode; GIR's setter otherwise, its receiver cast to the class
that declares it; and where GTK ships no setter, the preamble's
sngl_set_prop_* by the property's name. A string handed to C is a temp
ReleaseTemps frees after the write, or for a literal one made for the
application and freed at teardown. The entry's text is written through
gtk4rt.EditableSetTextQuiet, which copies it into C itself.
deny out/go/gtk4/model.go `__ctmp` -- no setter's string is the translator's
deny out/go/gtk4/model.go `__cstr\d+ = C\.CString\("(name|placeholder-text)"\)` -- a literal a setter hands C is ReleaseTemps', not the translator's
-- app.sngl --
import ui "sngl:ui"
import go "sngl:language/go"
import gtk "gir:Gtk-4.0"

output {
    go {
        gtk4
    }
}

var count = 0
var on = false
var name = "x"

ui.window(title="t") {
    gtk.GtkBox(orientation="vertical", spacing=4) {
        gtk.GtkLabel(label="clicked {count}", justify="center")
        gtk.GtkCheckButton(active=on)
        gtk.GtkSwitch(active=on)
        gtk.GtkLinkButton(uri="https://example.com/{count}")
        gtk.GtkEntry(placeholderText="name")
        ui.input(value=name)
        gtk.GtkButton(label="go", @clicked {
            count += 1
            on = !on
            name = ""
        })
    }
}
