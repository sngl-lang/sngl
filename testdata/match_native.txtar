Where a match is a switch and where it is still the if chain. A language
that declares `matches` writes a match statement as its own switch, and one
that declares `matchValues` a match expression; Go's switch assigning a temp
stands for the second. What stays the chain on every target: a match over an
option, which a host's switch compares differently from `==`; one whose arm
breaks out of a loop, which Go's and JavaScript's switch take as their own;
and a test's, which each language's test lowering writes out. A headless
match is a tagless switch in Go and a subjectless when in Kotlin, and the
chain in JavaScript, which has nothing to switch on. An initializer is no
statement: Go calls a func literal holding the switch where it stands.

deny out/go/bubbletea/model.go `switch d \{` -- an arm that breaks out of the loop is the chain
deny out/go/bubbletea/model.go `if n >= 90` -- a headless match is a tagless switch
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `if \(\(n >= 90\)\)` -- a headless match is a subjectless when
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `when \(state\.maybe\)` -- an option subject is compared as == compares one
deny * `unfolded` -- a match on a constant folds to the arm it takes
deny out/none/html/index.html `switch \(true\)` -- a headless match in JavaScript is the chain, not a switch on true

-- app.sngl --
import . "sngl:test"
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        gtk4
        fyne
        bubbletea
    }
    kotlin {
        android
    }
}

enum Dir { up, down, left, right }

const hand = Dir.left

// Headless: a tagless switch in Go and a subjectless when in Kotlin.
// JavaScript has nothing to switch on and writes the if chain.
func grade(n int) string {
    match {
        n >= 90 { return "a" }
        n >= 50 { return "b" }
        else { return "c" }
    }
}

// A break in an arm leaves the loop around the match, which Go's and
// JavaScript's switch would take as their own: the if chain.
func firstDown(ds list[Dir]) int {
    var at = -1
    for var i, d = ds {
        match d {
            down {
                at = i
                break
            }
            else {}
        }
    }
    return at
}

// An option is compared as `==` compares one: the if chain.
func name(d option[Dir]) => match d {
    null => "none"
    up => "up"
    else => "other"
}

func turned(d Dir) => match d {
    up => Dir.right
    right => Dir.down
    down => Dir.left
    left => Dir.up
}

component pad ui.node {
    var d Dir = up
    var maybe option[Dir] = null
    // An initializer holds no statement: a func literal called where it
    // stands in Go, a when in Kotlin.
    var axis = match d {
        up, down => "vertical"
        else => "horizontal"
    }
    // A lambda's body is a function's.
    var flips = [Dir.up, Dir.left].map(func(x Dir) => match x {
        up => Dir.down
        else => Dir.up
    })

    // A match on a constant is the arm it takes.
    match hand {
        left { ui.text(value="left-handed") }
        else { ui.text(value="unfolded") }
    }
    ui.text(value=axis)
    ui.text(value=name(maybe))
    ui.text(value=grade(firstDown(flips) * 60))
    ui.button #turn(text="Turn", @click {
        d = turned(d)
    })
}

func testHeadless(t Test) {
    t.assert(grade(95) == "a")
    t.assert(grade(60) == "b")
    t.assert(grade(10) == "c")
}

func testBreak(t Test) {
    t.assert(firstDown([Dir.up, Dir.down, Dir.down]) == 1)
    t.assert(firstDown([Dir.up]) == -1)
}

func testOption(t Test) {
    t.assert(name(null) == "none")
    t.assert(name(Dir.up) == "up")
    t.assert(name(Dir.left) == "other")
}

func testComponent(t Test, c pad) {
    t.assert(c.axis == "vertical")
    t.assert(c.maybe == null)
    t.assert(c.flips[0] == Dir.down)
    c.turn.click()
    // A test's own match.
    match c.d {
        right { t.assert(true) }
        else { t.assert(false) }
    }
}

ui.window {
    pad
}
