func TestDial(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(c.northPresent()) { t.Errorf("assert failed: %s", "c.northPresent()") }
	if !(!c.backPresent()) { t.Errorf("assert failed: %s", "!c.backPresent()") }
	if !(c.pickPresentAt("0")) { t.Errorf("assert failed: %s", "c.pickPresentAt(\"0\")") }
	if !(!c.pickPresentAt("1")) { t.Errorf("assert failed: %s", "!c.pickPresentAt(\"1\")") }
	c.spinClick()
	if !(!c.northPresent()) { t.Errorf("assert failed: %s", "!c.northPresent()") }
	c.spinClick()
	if !(c.backPresent()) { t.Errorf("assert failed: %s", "c.backPresent()") }
	c.spinClick()
	c.spinClick()
	if !((c.d__inst1 == "up")) { t.Errorf("assert failed: %s", "(c.d__inst1 == \"up\")") }
	if !(c.northPresent()) { t.Errorf("assert failed: %s", "c.northPresent()") }
}


