Where a match is a switch and where it is still the if chain. A language that
declares `matches` writes a match statement as its own switch, and one that
declares `matchValues` a match expression; Go's switch assigning a temp stands
for the second. A match over an option is a switch only in Kotlin, whose when
takes `null ->` beside the element's values; Go's switch would compare an
option's pointer, and JavaScript declares no `optionMatches`, so there it is
the chain. An arm that breaks out of a loop around the match names the loop in
Go and JavaScript, whose switch takes a bare break as its own; Kotlin's when
takes none, so its break is bare. What stays the chain on every target is a
test's, which each language's test lowering writes out. A headless match is a
tagless switch in Go and a subjectless when in Kotlin, and the chain in
JavaScript, which has nothing to switch on. A view body's match is a switch in
bubbletea's View, and in every walk Update and the test surface make of the
view, as it is a when in android's composable. An initializer is no statement:
Go calls a func literal holding the switch where it stands.

deny out/go/bubbletea/model.go `if d == "down"` -- an arm that breaks out of the loop is a switch, the loop labeled
deny out/none/html/index.html `if \(d === "down"\)` -- an arm that breaks out of the loop is a switch, the loop labeled
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `__loop|break@` -- Kotlin's when takes no break of its own, so the loop needs no label
deny out/go/bubbletea/model.go `if n >= 90` -- a headless match is a tagless switch
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `if \(\(n >= 90\)\)` -- a headless match is a subjectless when
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `state\.maybe == null` -- an option subject is a when in Kotlin, not the ternaries
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `\(n == null\)` -- an option statement subject is a when in Kotlin, not the chain
deny out/go/bubbletea/model.go `switch n \{` -- Go's switch compares an option's pointer, so it is the chain
deny out/none/html/index.html `switch \(n\)` -- JavaScript declares no optionMatches, so an option subject is the chain
deny out/go/bubbletea/model.go `if m\.d__inst1 == "up"` -- a view-body match is a switch in View and in the presence walks
deny out/go/bubbletea/model.go `if p == "up"` -- a match in a view loop is a switch in View, the focus count and the loop walks
deny * `unfolded` -- a match on a constant folds to the arm it takes
deny out/none/html/index.html `switch \(true\)` -- a headless match in JavaScript is the chain, not a switch on true

-- app.sngl --
import . "sngl:test"
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        gtk4
        fyne
        bubbletea
    }
    kotlin {
        android
    }
}

enum Dir { up, down, left, right }

const hand = Dir.left

// Headless: a tagless switch in Go and a subjectless when in Kotlin.
// JavaScript has nothing to switch on and writes the if chain.
func grade(n int) string {
    match {
        n >= 90 { return "a" }
        n >= 50 { return "b" }
        else { return "c" }
    }
}

// A break in an arm leaves the loop around the match, which Go's and
// JavaScript's switch would take as their own: the loop is labeled and the
// break names it.
func firstDown(ds list[Dir]) int {
    var at = -1
    for var i, d = ds {
        match d {
            down {
                at = i
                break
            }
            else {}
        }
    }
    return at
}

// An option is compared as `==` compares one: a when in Kotlin, the chain in
// Go and JavaScript.
func name(d option[Dir]) => match d {
    null => "none"
    up => "up"
    else => "other"
}

// The same as a statement, over an option of a number.
func count(n option[int]) string {
    match n {
        null { return "none" }
        0 { return "zero" }
        else { return "some" }
    }
}

func turned(d Dir) => match d {
    up => Dir.right
    right => Dir.down
    down => Dir.left
    left => Dir.up
}

component pad ui.node {
    var d Dir = up
    var maybe option[Dir] = null
    var tally option[int] = null
    // An initializer holds no statement: a func literal called where it
    // stands in Go, a when in Kotlin.
    var axis = match d {
        up, down => "vertical"
        else => "horizontal"
    }
    // A lambda's body is a function's.
    var flips = [Dir.up, Dir.left].map(func(x Dir) => match x {
        up => Dir.down
        else => Dir.up
    })

    // A match on a constant is the arm it takes.
    match hand {
        left { ui.text(value="left-handed") }
        else { ui.text(value="unfolded") }
    }
    ui.text(value=axis)
    ui.text(value=name(maybe))
    ui.text(value=count(tally))
    ui.text(value=grade(firstDown(flips) * 60))
    ui.button #turn(text="Turn", @click {
        d = turned(d)
    })
}

// A match in a view body: a switch in bubbletea's View and in every walk
// that follows the view, as it is a when in a composable.
component dial ui.node {
    var d Dir = up
    var picks = [Dir.up, Dir.down]
    var taps = 0
    match d {
        up { ui.text #north(value="north") }
        down, left {
            ui.button #back(text="Back", @click {
                taps += 1
            })
        }
        else { ui.text(value="east") }
    }
    for var p = picks {
        match p {
            up {
                ui.button #pick(text="Up", @click {
                    taps += 1
                })
            }
            else { ui.text(value="other") }
        }
    }
    ui.text(value=match d {
        up => "facing up"
        else => "turned"
    })
    ui.button #spin(text="Spin", @click {
        d = turned(d)
    })
}

func testHeadless(t Test) {
    t.assert(grade(95) == "a")
    t.assert(grade(60) == "b")
    t.assert(grade(10) == "c")
}

func testBreak(t Test) {
    t.assert(firstDown([Dir.up, Dir.down, Dir.down]) == 1)
    t.assert(firstDown([Dir.up]) == -1)
}

func testOption(t Test) {
    t.assert(name(null) == "none")
    t.assert(name(Dir.up) == "up")
    t.assert(name(Dir.left) == "other")
    t.assert(count(null) == "none")
    t.assert(count(0) == "zero")
    t.assert(count(3) == "some")
}

func testComponent(t Test, c pad) {
    t.assert(c.axis == "vertical")
    t.assert(c.maybe == null)
    t.assert(c.flips[0] == Dir.down)
    c.turn.click()
    // A test's own match.
    match c.d {
        right { t.assert(true) }
        else { t.assert(false) }
    }
}

func testDial(t Test, c dial) {
    t.assert(c.north != null)
    t.assert(c.back == null)
    t.assert(c.pick[0] != null)
    t.assert(c.pick[1] == null)
    c.spin.click()
    t.assert(c.north == null)
    c.spin.click()
    t.assert(c.back != null)
    c.spin.click()
    c.spin.click()
    t.assert(c.d == Dir.up)
    t.assert(c.north != null)
}

ui.window {
    pad
    dial
}
