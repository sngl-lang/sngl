package main

import (
	"fmt"
	"log"
	"net"
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleHome)
	return mux
}

func handleHome(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from doc.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>doc</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<div style=\"display:flex;flex-direction:column\">\n  <h1 style=\"margin:0px;font-size:32px;font-weight:bold;white-space:pre-wrap\"><span>Title</span></h1>\n  <p style=\"margin:0px;white-space:pre-wrap\"><span>a &lt; b &amp; &#34;c&#34;  two spaces\nand a newline</span></p>\n  <p style=\"margin:0px;white-space:pre-wrap\"><code><a href=\"https://example.com/?a=1&amp;b=2\"><span>mono link</span></a></code><a href=\"https://example.com/\"><code><span>link mono</span></code></a></p>\n  <pre class=\"sngl-code\" style=\"margin:0px;white-space:pre-wrap\"><code><span class=\"sngl-tok-keyword\"><span>func</span></span><span> </span><span class=\"sngl-tok-function\"><span>main</span></span></code></pre>\n  <p style=\"margin:0px;white-space:pre-wrap\"><u><s><em><span>all three</span></em></s></u></p>\n  <p style=\"margin:0px;white-space:pre-wrap\"><span>before </span><span class=\"sngl-image sngl-image-contain\" style=\"display:inline-block\" aria-label=\"an &#34;icon&#34; &amp; more\" role=\"img\"><img alt=\"\" src=\"/icon.png\"/></span><span> after</span></p>\n  <p style=\"margin:0px;white-space:pre-wrap\"><span style=\"color:#336699;font-size:20px;font-weight:bold\"><span>a styled run</span></span></p>\n  <blockquote style=\"margin:0px;padding-left:12px;font-style:italic;white-space:pre-wrap;border-left:3px solid #CCCCCC\"><span>quoted</span></blockquote>\n  <figcaption style=\"margin:0px;color:#666666;font-size:13px;white-space:pre-wrap\"><span>a caption</span></figcaption>\n</div>\n<style>\n:where(.sngl-code) { padding:12px;color:#1f2328;background-color:#f5f5f5;border-radius:4px }\n@media (prefers-color-scheme: dark) { :where(.sngl-code) { color:#e6edf3;background-color:#161b22 } }\n:where(.sngl-tok-keyword) { color:#cf222e }\n@media (prefers-color-scheme: dark) { :where(.sngl-tok-keyword) { color:#ff7b72 } }\n:where(.sngl-tok-function) { color:#8250df }\n@media (prefers-color-scheme: dark) { :where(.sngl-tok-function) { color:#d2a8ff } }\n.sngl-image { overflow: hidden; }\n.sngl-image img { display: block; width: 100%; height: 100%; object-fit: contain; }\n.sngl-image-cover img { object-fit: cover; }\n.sngl-image-fill img { object-fit: fill; }\n.sngl-image-none img { object-fit: none; }\n.sngl-image-scaleDown img { object-fit: scale-down; }\n</style>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { visible__inst0: true };\n})();\n</script>\n</body></html>\n"))
}

func main() {
	ln, err := net.Listen("tcp", ":8080")
	if err != nil {
		log.Fatal(err)
	}
	host, port, _ := net.SplitHostPort(ln.Addr().String())
	if ip := net.ParseIP(host); ip == nil || ip.IsUnspecified() {
		host = "localhost"
	}
	fmt.Println("http://" + net.JoinHostPort(host, port))
	log.Fatal(http.Serve(ln, Handler()))
}
