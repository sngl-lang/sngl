import . "sngl:test"
import . "sngl:ui"

// The string of one code point, its UTF-8: a code point no character is --
// negative, past U+10FFFF, or a surrogate half -- is U+FFFD, the replacement
// character, on every target. A constant one folds.
component fold node {
    var letter = string.fromCodePoint(65)    // FOLD "A"
    var accent = string.fromCodePoint(233)   // FOLD "é"
    var face = string.fromCodePoint(128512)  // FOLD "😀"
    var negative = string.fromCodePoint(-1)  // FOLD "�"
    var past = string.fromCodePoint(1114112) // FOLD "�"
    var half = string.fromCodePoint(55296)   // FOLD "�"
}

func of(n int) => string.fromCodePoint(n)

func testFromCodePoint(t Test) {
    t.assert(of(65) == "A")
    t.assert(of(233) == "é")
    t.assert(of(128512) == "😀")
    t.assert(of(128512).length() == 1)
    t.assert(of(1114111).length() == 1)
    t.assert(of(-1) == "�")
    t.assert(of(1114112) == "�")
    t.assert(of(55296) == "�")
    t.assert(of(57343) == "�")
}
