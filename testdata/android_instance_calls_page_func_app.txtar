The app build of `android_instance_calls_page_func.txtar`, which has no test
and so compiles MainScreen as an app has it: the page's state `remember`ed in
it, and a function reaching that state a local fun of it. A function a
composable of its own calls is declared at file level instead, with what it
reaches, as a package var such a composable names already was. `holder`
called `open`, a local of MainScreen, and did not compile
(`Unresolved reference 'open'`).

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
    kotlin {
        android
    }
    none {
        html
    }
}

var opened = 0
var log = ""

func note(s string) {
    log += s
}

func open() int {
    opened += 1
    note("o")
    return opened
}

component holder ui.node {
    var fd = open()

    ui.text #shows(value="{fd}")
}

component screen ui.node {
    var shown = true

    ui.vbox {
        ui.button #t(text="t", @click {
            shown = !shown
        })
        if shown {
            holder
        }
    }
}

ui.window(title="t") {
    screen
}
