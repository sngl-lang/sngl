import . "sngl:ui"

output {
    go {
        android
    }
}

func fib(n int) int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

component main node {
    var k int = 10
    text(value=string(fib(k)))
    button(text="+", @click { k = k + 1 })
}

window {
    main
}
