A C function taking a nullable string is declared with an `option[string]`
parameter, and CMarshal hands it a string as the C string `cstring` makes,
which ReleaseTemps frees after the call -- or at teardown, for a literal --
and `null` as NULL. `setlocale` takes either: a locale to set, or NULL to
ask for the current one.
-- app.sngl --
import ui "sngl:ui"
import macro "sngl:macro"
import go "sngl:language/go"
import "c:locale.h"

output {
    go {
        bubbletea
    }
}

#[macro.cnative("setlocale")]
func setLocale(category int, locale option[string])

var n = 0
var locale = "C"

ui.window(title="t") {
    ui.button(text="{n}", @click {
        setLocale(0, "C")
        setLocale(0, locale)
        setLocale(0, null)
        n = n + 1
    })
}
