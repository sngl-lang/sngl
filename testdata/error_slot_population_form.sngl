// A population binds names. Its list is the `ParamList` a component declares
// its props with, so the default, binding and event forms parse there too, and
// none of them names a position an insertion supplies.

import . "sngl:ui"
import app "sngl:app"

struct Row {
    title string
}

component table(rows list<Row>, cell component(Row)) node {
    vbox {
        for var r = rows {
            cell(r)
        }
    }
}

component main node {
    vbox {
        table(rows=[]) {
            component cell(row = Row{title="x"}) { // ERROR(check) "parameter \"row\" takes no default value"
                text(value=row.title)
            }
        }
        table(rows=[]) {
            component cell(:row) { // ERROR(check) "a population binds plain names"
                text(value="x")
            }
        }
        table(rows=[]) {
            component cell(@row) { // ERROR(check) "a population binds plain names"
                text(value="x")
            }
        }
    }
}

app.window {
    main
}
