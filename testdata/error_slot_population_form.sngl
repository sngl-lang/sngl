// A population binds names. Its list is the `ArgList` a call passes arguments
// with, so the named, binding and event forms parse there too, and none of
// them names a position.

import . "sngl:ui"

struct Row {
    title string
}

component table(rows list<Row>, slot cell(Row)) {
    vbox {
        for var r = rows {
            cell(r)
        }
    }
}

component main {
    vbox {
        table(rows=[]) {
            slot cell(row=1) { // ERROR(check) "parameter \"row\" of slot \"cell\" takes no default value: the component supplies what the name is bound to"
                text(value="x")
            }
        }
        table(rows=[]) {
            slot cell(:row=row) { // ERROR(check) "slot \"cell\": a population binds names, and :row is a prop binding"
                text(value="x")
            }
        }
        table(rows=[]) {
            slot cell(@click {}) { // ERROR(check) "slot \"cell\": a population binds names, and @click is an event handler"
                text(value="x")
            }
        }
        table(rows=[]) {
            slot cell(1) { // ERROR(check) "slot \"cell\": a population binds names, not expressions"
                text(value="x")
            }
        }
    }
}
