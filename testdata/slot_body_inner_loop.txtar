A node lifted out of a render slot's body keeps the loops it holds, and with
them the variables those loops bind.

Each row's `hbox` reads `tick`, so passSlotChildInstances lifts it into a
component built at run time and makes each free value it reads a prop. `cell`
looked free to that scan, being nobody's handler parameter, so the slot handed
the instance a `cell` that only the loop inside the instance binds, and the
generated Go named it where nothing declared it. A table's rows on gtk4 are
this shape.

-- app.sngl --
import . "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
    none { html }
}

component main node {
    var tick = 0
    var rows = [["a", "b"], ["c", "d"]]

    vbox {
        button #bump(text="bump", @click { tick += 1 })
        for var row = rows {
            hbox {
                for var cell = row {
                    text(value="{cell} {tick}")
                }
            }
        }
    }
}

window {
    main
}
