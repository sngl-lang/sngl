-- component_implicit_call_compare.sngl --
import . "sngl:ui"
import . "sngl:test"

// Regression: a bare zero-arg computed used in an expression must be
// implicitly called. `count > 0` previously failed typecheck with
// "operator > not defined for func and int" instead of calling count()
// and comparing the int result.
component main node {
    var n = 3
    func count() => n
    text(value=count > 0 ? "some" : "none")
}

func testImplicitCallCompare(t Test, c main) {
    t.assert(c.count == 3)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
