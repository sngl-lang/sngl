The drawing geometry helpers fold away wherever their inputs are constant.

`Point.polar` is the one that makes an arc, a dial hand or a regular polygon
writable -- the alternative is trigonometry spelled out at every call site.
Being plain SNGL over `sngl:builtin`'s trig is what lets it cost nothing: the
six tick marks below are laid out by angle and each arrives as a pair of
literals, and the hand's own `radius * cos(angle)` folds to a constant with
only the runtime centre left.

`float.tau()` is here for the same reason. Every override that sweeps a full
circle was writing 6.283185307179586 out by hand.

deny out/none/html/index.html `Math\.(cos|sin)\(` -- a constant angle is resolved at build time, not by the page
deny out/none/html/index.html `float\.tau|Point\.polar` -- the helpers are SNGL, not something the output calls

-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"
import seq "sngl:seq"

output {
    none {
        html
    }
}

component dial(angle float) ui.node {
    var c = draw.Point{x=50.0, y=50.0}

    draw.canvas(width=100px, height=100px) {
        draw.line(
            x1=c.x,
            y1=c.y,
            x2=draw.Point.polar(c, 40.0, angle).x,
            y2=draw.Point.polar(c, 40.0, angle).y,
            style=draw.CanvasStyle{stroke=color{r=255}, strokeWidth=2.0},
        )
        for var i = seq.count(6) {
            draw.circle(
                cx=draw.Point.polar(c, 45.0, float(i) * float.tau() / 6.0).x,
                cy=draw.Point.polar(c, 45.0, float(i) * float.tau() / 6.0).y,
                r=2.0,
                style=draw.CanvasStyle{fill=color{b=255}},
            )
        }
    }
}

ui.window {
    dial(angle=1.0)
}
