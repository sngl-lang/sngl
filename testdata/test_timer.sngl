output {
    js { html }
}

func testTickIncrementsProgress(t T, c main) {
    t.assert(c.progress == 0)
    t.assert(c.running == true)
    t.tick()
    t.assert(c.progress == 0.1)
    t.assert(c.running == true)
}

func testTickRespectsActiveVar(t T, c main) {
    c.running = false
    t.tick()
    t.assert(c.progress == 0)
}

component main {
    var (
        progress float = 0
        running = true
    )

    timer(interval=100ms, enabled=running, @tick {
        progress += 0.1
    })

    text(value=string(progress))
}
