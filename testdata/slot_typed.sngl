// A slot declares which family its content belongs to by naming that family's
// type, and how many it takes by wrapping it. Bare is any number — the default,
// and what a slot with no type at all means. `tr.one<T>` narrows it to exactly
// one and `option<T>` to none or one; those two are the only wrappers.
//
// A slot bounded to exactly one has no spelling for being absent, so it must be
// populated.

import . "sngl:ui"
import tr "sngl:tree"

component frame(body component tr.one, badge component option<tr.default>, rows component) {
    vbox {
        body {}
        badge {}
        rows {}
    }
}

// The rest slot carries a type the same way: `...` is the count bound, and
// what follows `component` is still the tree it accepts.
component strip(children ...component tr.default) {
    vbox {
        children
    }
}

component main {
    frame() {
        component body {
            text(value="one")
        }
    }
    frame() {
        component body {
            text(value="one")
        }
        component badge {
            text(value="b")
        }
        component rows {
            text(value="a")
            text(value="b")
        }
    }
    strip() {
        text(value="a")
        text(value="b")
    }
}
