// A slot declares which family its content belongs to by naming that family's
// type, and how many it takes by wrapping it. Bare is any number — the default,
// and what a slot with no type at all means. `tree.one<T>` narrows it to exactly
// one and `option<T>` to none or one; those two are the only wrappers.
//
// A slot bounded to exactly one has no spelling for being absent, so it must be
// populated.

import . "sngl://std"
import tr "sngl://tree"

component frame(slot body tr.one<component>, slot badge option<component>, slot rows) {
    vbox {
        body {}
        badge {}
        rows {}
    }
}

// The default slot carries a type the same way, written `slot()` rather than a
// bare `slot`: an optional name followed by an optional type is not LL(1), so
// the empty parameter list is what tells the two apart.
component strip(slot() component) {
    vbox {
        slot
    }
}

component main {
    frame() {
        slot body {
            text(value = "one")
        }
    }
    frame() {
        slot body {
            text(value = "one")
        }
        slot badge {
            text(value = "b")
        }
        slot rows {
            text(value = "a")
            text(value = "b")
        }
    }
    strip() {
        text(value = "a")
        text(value = "b")
    }
}
