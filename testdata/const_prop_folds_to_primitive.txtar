// BuildUI creates the widget tree and returns the first window's content.
func (m *Model) BuildUI() fyne.CanvasObject {
	if m.__built {
		return m.__n0.Container
	}
	m.__built = true
	m.__n0 = fynelayout.NewToplevel()
	m.__n0.SetVisible(m.visible__inst0)
	m.__n0.OnClosed = m.__n0_closed_handler
	m.__n0.OnVisible = m.__n0_visible_handler
	m.__n2 = container.NewVBox()
	m.__n1 = widget.NewLabel("…")
	m.__n1.SetText(m.reading)
	m.__n2.Add(m.__n1)
	m.__n0.Add(m.__n2)
