A const prop is folded by contract: whatever the call site wrote, the primitive
receives a literal, which is the one form its codegen reads. fyne's `spec` is
such a prop, and here it arrives through three things a Spec reader never had
to see before -- a const list the optimizer would otherwise keep as a reference
to its declaration, a const func building a record, and a const component
forwarding its own const prop into the primitive.

What this pins is the result, not which pass produces it: after lowering, a
primitive's prop is an assignment, and an assignment's value is folded owned,
which copies a list const as well. The fold that is only the contract's is
the build error for an argument that does not fold,
cmd/sngl/testdata/const_arg_unfoldable.txt.

deny out/go/fyne/model.go `NewLabel\(\)` -- the constructor's argument came from the folded list, not from nothing
deny out/go/fyne/model.go `labelArgs` -- the const list is folded into the Spec, not referenced
-- app.sngl --
import . "sngl:ui"
import "sngl:platform/fyne"

output {
    go {
        fyne
    }
}

const widgetPath = "fyne.io/fyne/v2/widget"

const labelArgs = [fyne.Arg{raw=`"…"`}]

const func widget(name string) => fyne.Native{path=widgetPath, name=name}

const component Shown(const spec fyne.Spec, text string) node {
    fyne.Widget(spec=spec, text=text)
}

var reading = "42"

window {
    vbox {
        Shown(
            spec=fyne.Spec{
                new = widget("NewLabel"),
                args = labelArgs,
                goType = widget("*Label"),
                setters = [fyne.Setter{prop="text", call="SetText"}],
            },
            text=reading,
        )
    }
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	reading string

	__n1 *fyne.Container
	__n0 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.reading = "42"
	return m
}

func (m *Model) Reading() string {
	return m.reading
}

func (m *Model) SetReading(v string) {
	m.reading = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n1 = container.NewVBox()
	m.__n0 = widget.NewLabel("…")
	m.__n0.SetText(m.reading)
	m.__n1.Add(m.__n0)
	content := fyne.CanvasObject(m.__n1)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
