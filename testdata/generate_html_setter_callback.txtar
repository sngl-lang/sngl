A user-defined func that mutates state is called from a click handler rather
than being one, and its mutations still have to reach the DOM. NoReactivity
lowering inlines a patch after each assignment inside the func itself, so
`main_update` writes `state.name` and then the node bound to it, and the
handler only calls it. The initial writes are inlined into `__sngl_init` for
the same reason: there is no per-prop updater to route them through, and no
`$set_name(v)` setter either.

deny out/none/html/index.html `\$u__n0_text` -- a bound prop has no updater function of its own; the write is inlined where the assignment is
deny out/none/html/index.html `\$u__n1_text` -- the same for the second bound node, whose only writes are in `main_update` and `__sngl_init`
-- app.sngl --
import . "sngl:ui"

output { none { html } }

component main node {
    var name = "World"
    var count int = 0

    func update(newName string, newCount int) {
        name = newName
        count = newCount
    }

    text(value=name)
    text(value=string(count))
    button(text="Update", @click { update("Hello", 5) })
}

window {
    main
}
-- out/none/html/index.html --
