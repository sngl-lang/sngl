A two-parameter event reaching every backend.

`@pick(index int, label string)` is declared with a parameter list and the
call site binds both by position -- or only the first, since a handler may
stop short. Every `row` is inlined, so the emit is replaced by the block the
call site wrote and each parameter is bound to its own argument.
event_params_instance.txtar is the same event on an instance the build keeps.

deny * `emit\(` -- every emit is substituted, never left as a call to a function nothing declares

-- event_params.sngl --
import . "sngl:ui"

component row(label string, index int, @pick(index int, label string)) node {
    button(text=label, @click { pick(index, label) })
}

component main node {
    var picked = ""
    var at = 0

    row(label="first", index=1, @pick(i, l) {
        at = i
        picked = l
    })
    row(label="second", index=2, @pick(i) { at = i })
    text(value="{picked} at {at}")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
}
