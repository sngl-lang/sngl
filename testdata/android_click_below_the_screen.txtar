A test clicks a node past the bottom of the screen on android as it does one
on it: by the node's own click action, as fyne and gtk4 run a widget's
callback. A touch lands where the node is drawn, and Robolectric's screen
ends a few hundred dp down, so `c.b[29]` in an unscrolled column was clicked
nowhere and the test failed on an unchanged value with nothing said.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"
import seq "sngl:seq"

output {
    kotlin {
        android
    }
}

component main node {
    var log = ""
    vbox {
        text(value=log)
        for var i = seq.count(30) {
            button #b(text="{i}", @click { log = "{i}" })
        }
    }
}

func testClickBelowTheScreen(t Test, c main) {
    c.b[29].click()
    t.assert(c.log == "29")
}

window {
    main
}
