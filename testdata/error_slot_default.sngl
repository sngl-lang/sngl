// The default slot is a slot like any other, named `_`, so declaring it twice
// is the ordinary name collision rather than a rule of its own.
//
// Its content arrives as the caller's ordinary children, which is the only way
// it differs — so there is no population to write, and writing one says so.

import . "sngl:ui"

component twice(slot _, slot _) { // ERROR(check) "name is already declared as a slot"
    vbox {
        slot
    }
}

// A scoped default slot has nowhere to collect its arguments: the content is
// written as ordinary children, with no binding site.
component scoped(slot _(string)) { // ERROR(check) "default slot takes no parameters"
    vbox {
        slot
    }
}

component card(slot _) {
    vbox {
        slot
    }
}

component main {
    card() {
        slot _ { // ERROR(check) "filled by ordinary children, not by name"
            text(value="x")
        }
    }
}
