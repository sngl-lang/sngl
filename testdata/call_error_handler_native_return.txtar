A `return` in the @error handler on a `fails` Go native ends the handler, not
the click handler it was inlined into. The failure is tested off the error
result rather than recovered, and that branch inlined the handler body bare:
on bubbletea the return had the Update method's two results to supply and did
not compile, and on fyne and gtk4 it silently skipped the rest of the click.
The body is a closure called in place when it holds a return, as
emitHandlerInvoke already does for a handler reached by a raise.

-- native.sngl --
import go "sngl:language/go"
import . "sngl:ui"
import . "sngl:test"

#[go.native("strconv", "strconv.Atoi", fails)]
func atoi(s string) int

component panel node {
    var caught = ""
    var after = ""
    button #bad(text="Bad", @click {
        atoi("x", @error(e) {
            caught = "c"
            if caught == "c" {
                return
            }
            caught = "never"
        })
        after = after + "b"
    })
    text(value="{caught}|{after}")
}

func testReturnEndsHandlerOnly(t Test, c panel) {
    c.bad.click()
    t.assert(c.caught == "c")
    t.assert(c.after == "b")
}

window {
    panel
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
}
