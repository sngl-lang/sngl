Two callers hand one component different children, which it forwards to a
runtime instance of another -- the copies passInstanceSlots makes must not be
shared between them.

`Row` is built at run time and forwards its children to `Card`, also built at
run time. Each `Row` site gets a copy with its own children spliced in, and
each copy then holds a `Card` site whose children are those forwarded ones.
The two `Card` sites are clones of the one site `Row`'s body wrote, so a copy
keyed by that site alone was made once, for ALPHA, and handed to BETA's row as
well: html rendered ALPHA in both rows and never BETA, and fyne passed `nil`
for the ALPHA copy's string prop and did not build. A copy is shared only by
sites whose children are clones of the same statements too, so `Row__slot0`
and `Row__slot1` each instantiate a `Card` copy of their own.

`Row` loops over a constant list, so its render slot is rendered by its
constructor and nothing else, and the slot's container is a local of the
constructor. A fyne or gtk4 record passed it to the render as a field it
never declares, and did not build.

deny out/go/fyne/model.go `newCard__slot\d+Instance\(c\.__model, nil\)` -- BETA's card is handed a copy whose prop BETA's children never lifted
deny out/go/gtk4/model.go `newCard__slot\d+Instance\(c\.__model, nil\)` -- as above, for the gtk4 record
-- app.sngl --
import . "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
    none {
        html
    }
}

component Card(children ...component) node {
    var hits = 0

    vbox {
        button(text="hit {hits}", @click { hits = hits + 1 })
        children
    }
}

component Row(children ...component) node {
    var open = true

    hbox {
        for var k = [1, 2] {
            Card {
                children
            }
        }
    }
}

var items = ["a", "b"]

window {
    vbox {
        for var it = items {
            Row {
                text(value="ALPHA {it}")
            }
        }
        for var it = items {
            Row {
                button(text="BETA")
            }
        }
    }
}
