package main

import "testing"

func TestStartsAtTheInitializer(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.language == "English")) { t.Errorf("assert failed: %s", "(c.language == \"English\")") }
	if !((c.load__string("language") == nil)) { t.Errorf("assert failed: %s", "(c.load__string(\"language\") == nil)") }
}

func TestAChangeOutlivesARemount(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.language = "Deutsch"
	c.__effect1_mark()
	c.__effects0_settle()
	if !(snglOptEq(c.load__string("language"), "Deutsch")) { t.Errorf("assert failed: %s", "snglOptEq(c.load__string(\"language\"), \"Deutsch\")") }
	c.shown = false
	c.__effects0_settle()
	c.language = "English"
	c.__effect1_mark()
	c.__effects0_settle()
	c.shown = true
	c.__effects0_settle()
	if !((c.language == "Deutsch")) { t.Errorf("assert failed: %s", "(c.language == \"Deutsch\")") }
}

func TestEachTestStartsWithNone(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.load__string("language") == nil)) { t.Errorf("assert failed: %s", "(c.load__string(\"language\") == nil)") }
	if !((c.language == "English")) { t.Errorf("assert failed: %s", "(c.language == \"English\")") }
}

func TestASeededValueIsLoaded(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.shown = false
	c.__effects0_settle()
	c.save__int("count", 7)
	c.shown = true
	c.__effects0_settle()
	if !((c.count == 7)) { t.Errorf("assert failed: %s", "(c.count == 7)") }
}

func TestAValueThatNoLongerReadsIsPassedOver(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.shown = false
	c.__effects0_settle()
	c.save__string("count", "seven")
	c.count = 2
	c.__effect3_mark()
	c.__effects0_settle()
	c.shown = true
	c.__effects0_settle()
	if !((c.count == 2)) { t.Errorf("assert failed: %s", "(c.count == 2)") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
