sngl:settings on each target. A test keeps its values in the library's
memory var, which is program state, so each starts with none: nothing opens
the platform's place, the program's own entry point being what opens it.

testdata/settings_kept.sngl's test of a store with a scope of its own is
not here: `t.setContext` makes `prefs` an instance built at run time, and a
write of a package var from the Model marks that instance's effect by a
name the Model does not have, so Go does not build.

-- app.sngl --
import settings "sngl:settings"
import test "sngl:test"
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
    kotlin {
        android
    }
}

var language = "English"
var count = 1

component prefs ui.node {
    settings.kept(name="language", :value=language)
    settings.kept(name="count", :value=count)
}

component app ui.node {
    var shown = true
    if shown {
        prefs
    }
}

func testStartsAtTheInitializer(t test.Test, c app) {
    t.assert(language == "English")
    t.assert(settings.load[string]("language") == null)
}

func testAChangeOutlivesARemount(t test.Test, c app) {
    language = "Deutsch"
    t.assert(settings.load[string]("language") == "Deutsch")
    c.shown = false
    language = "English"
    c.shown = true
    t.assert(language == "Deutsch")
}

func testEachTestStartsWithNone(t test.Test, c app) {
    t.assert(settings.load[string]("language") == null)
    t.assert(language == "English")
}

func testASeededValueIsLoaded(t test.Test, c app) {
    c.shown = false
    settings.save("count", 7)
    c.shown = true
    t.assert(count == 7)
}

func testAValueThatNoLongerReadsIsPassedOver(t test.Test, c app) {
    c.shown = false
    settings.save("count", "seven")
    count = 2
    c.shown = true
    t.assert(count == 2)
}

ui.window {
    app
}
