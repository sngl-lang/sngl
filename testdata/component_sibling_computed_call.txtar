A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_sibling_computed_call.sngl --
import . "sngl:ui"
import . "sngl:test"

// Regression: a block-bodied computed that calls a sibling computed must
// thread the component receiver, not a literal `this`. The checker's
// sibling-call elision (inferCall) desugars `double()` to `this.double()`,
// leaving Args[0] as the receiver *param* ident. Before the fix that param
// reached codegen verbatim, so Go emitted `m.double(this)` (undefined →
// gtk4/bubbletea/fyne compile error) and JS emitted `main_double(this)`
// (wrong receiver → html runtime error).
component main node {
    var n = 3
    func double() => n * 2
    func summary() string {
        var d = double()
        return "d={d}"
    }
    text(value=summary)
}

func testSiblingComputedCall(t Test, c main) {
    t.assert(c.summary == "d=6")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
