import . "sngl:std"

func testCallExpressionAndCallStatementRefs(t Test, c main) {
    t.assert(c.count == 0)
    c.increment(5)
    t.assert(c.count == 5)
    c.reset()
    t.assert(c.count == 0)
}

func testSubtestCallRefs(t Test, c main) {
    t.test("nested", func(t, c) {
        c.increment(1)
        t.assert(c.count == 1)
    })
}

component main {
    var count = 0

    func increment(n int) {
        count += n
    }
    func reset() {
        count = 0
    }

    text(value=string(count))
}
