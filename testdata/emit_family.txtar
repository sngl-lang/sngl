A family generated rather than rendered. `block` overrides itself for a
target with a gen.emit, each member overrides itself with a gen.node, and the
build writes one file per target from the host's content: walked at build time
in the order it is written, with a const loop unrolled, a member's defaults
filled in and a member's children between its open and close. `workspace`
has a body of its own, so it composes as any component does: its body is read
with its props bound, and needs no gen.node of its own.

The override is picked as any override is, platform before language: go on
bubbletea takes the Go language's, html takes its own. The host is consumed
where it is written, so nothing of it reaches the program a target generates.

deny out/go/bubbletea/model.go `(?i)bar|blocks|workspaces` -- the emitted host leaves nothing in the generated program
deny out/none/html/index.html `blocks` -- nor in the page

-- app.sngl --
import build "sngl:build"
import gen "sngl:x/gen"
import go "sngl:language/go"
import html "sngl:platform/html"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
    none {
        html
    }
}

component block build.family

component text(name string, full string, color string = "") block

component group(label string, items ...component block) block

component bar(blocks ...component block) root

component workspace(label string) block {
    text(name="ws", full=label)
}

component block[go.language] {
    gen.emit(file="blocks.txt", open="[\n", close="]\n")
}

component text[go.language] {
    gen.node(open="  {name}: {full} {color}\n")
}

component group[go.language] {
    gen.node(open="  <{label}>\n", close="  </{label}>\n")
}

component block[html.platform] {
    gen.emit(file="blocks.html", open="<ul>\n", close="</ul>\n")
}

component text[html.platform] {
    gen.node(open="<li class=\"{name}\">{full}</li>\n")
}

component group[html.platform] {
    gen.node(open="<li>{label}<ul>\n", close="</ul></li>\n")
}

const workspaces = ["web", "code"]

bar {
    for var w = workspaces {
        workspace(label=w)
    }
    group(label="sys") {
        text(name="load", full="0.5", color="#ff0000")
    }
}

ui.window {
    ui.text(value="hi")
}
-- out/go/bubbletea/blocks.txt --
[
  ws: web 
  ws: code 
  <sys>
  load: 0.5 #ff0000
  </sys>
]
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	visible__inst0 bool

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.visible__inst0 = true
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Visible__inst0() bool {
	return m.visible__inst0
}

func (m Model) SetVisible__inst0(v bool) Model {
	m.visible__inst0 = v
	return m
}

type setVisible__inst0Msg struct{ value bool }

func SetVisible__inst0Cmd(v bool) tea.Cmd {
	return func() tea.Msg { return setVisible__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setVisible__inst0Msg:
		m = m.SetVisible__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			if m.visible__inst0 {
				m.visible__inst0 = false
			}
			if !(m.visible__inst0) {
				return m, tea.Quit
			}
			return m, nil
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	if m.visible__inst0 {
		content = lipgloss.NewStyle().Render(fmt.Sprint("hi"))
	}
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
