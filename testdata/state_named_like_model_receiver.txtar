A var named `m` is a Model field, not the Model receiver it shares a name with.

The Go model platforms dispatch through a receiver named `m`, and the fields a
platform synthesizes -- a render slot, its anchor, a node handle -- are
selected off an `m` that carried no symbol. The Go context resolved that bare
name like any other, found the program's `var m`, and wrote `m.m.__slot0`
against an int. The receiver now carries a symbol of its own.
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
}

component counter(start int) node {
    var m = start
    var c = 0

    hbox {
        text(value="m {m} c {c}")
        button #inc(text="inc", @click {
            m += 1
            c += 1
        })
    }
}

component main node {
    var m = 1
    var xs = [1, 2]

    vbox {
        text(value="page {m}")
        button #bump(text="bump", @click { m += 1 })
        for var x = xs {
            counter(start=x)
        }
    }
}

func testBump(t Test, c main) {
    c.bump.click()
    t.assert(c.m == 2)
}

window {
    main
}
