// Two of one name in one body is that scope's duplicate, reported the way any
// other duplicate in a scope is.

import . "sngl:ui"
import app "sngl:app"

component main ui {
    component row(label = "") ui {
        text(value=label)
    }

    component row(label = "") ui { // ERROR(check) "row is already declared in this scope"
        text(value="second " + label)
    }

    row(label="a")
}

app.window {
    main
}
