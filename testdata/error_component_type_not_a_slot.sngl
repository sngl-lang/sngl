// A component type parses wherever a type does, and means a slot -- so only a
// component's parameter may carry one. Same for `...`, which bounds how many
// nodes a slot takes. The grammar is deliberately permissive here; the rule is
// stated where it is enforced.

import . "sngl:ui"
import app "sngl:app"

func take(c component) { // ERROR(check) "only a parameter of a component may have one"
}

struct Holder {
    c component // ERROR(check) "only a parameter of a component may have one"
}

component counts(xs ...int) ui { // ERROR(check) "only a slot's type may carry one"
    vbox {
        text(value="x")
    }
}

app.window {
}
