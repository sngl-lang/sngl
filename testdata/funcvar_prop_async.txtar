An async function handed to a component's func-typed prop. A prop is a slot
a function flows into as a parameter is, so a call through it inside the
component is awaited where the call site handed it an async function: the
click handler is an async wrapper and the call awaits -- here in an
instance built at run time, which keeps the prop and calls through it.

deny out/none/html/index.html `[^t] __prop_fetch\(\)` -- a call through a slot an async function flows into waits for it

-- app.sngl --
import . "sngl:ui"
import api "js:./api"

output {
    none {
        html
    }
}

component loader(fetch func() string) node {
    var label = ""
    text(value=label)
    button(text="Load", @click { label = fetch() })
}

var names = ["a", "b"]

window {
    for var n = names {
        loader(fetch=api.fetchHello)
    }
}
-- api/index.ts --
export async function fetchHello(): Promise<string> { return "hi"; }
