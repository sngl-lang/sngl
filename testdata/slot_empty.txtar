`.empty` is answered where the body is spliced, from what the call site
supplied: in a prop, in a var's initializer and in an `if` head alike. The
answer is matched to the slot by declaration, never by name, so a caller's own
`.empty` handed in as a prop argument is left for the caller's splice; and a
loop whose body renders nothing renders only its else, so it is empty exactly
when its iterable is non-empty or its else renders nothing.

-- app.sngl --
import . "sngl:ui"

// `.empty` answered where the body is spliced, in each position a body may
// ask it: a node's prop, a var's initializer, and an `if` head; and asked of
// content whose loop body renders nothing, where only the else can render.
component boxed(content option[component option[node]]) node {
    var started = content.empty
    text(value=content.empty ? "empty" : "has content")
    text(value=started ? "started empty" : "started with content")
    if content.empty {
        text(value="nothing")
    } else {
        vbox {
            content
        }
    }
}

component main node {
    var xs = [1]
    var shown = false
    boxed
    boxed {
        component content {
            text(value="a")
        }
    }
    boxed {
        component content {
            if shown {
                text(value="shown")
            }
        }
    }
    boxed {
        component content {
            for var x = xs {
            } else {
                text(value="no items")
            }
        }
    }
    button(text="show", @click { shown = true })
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
