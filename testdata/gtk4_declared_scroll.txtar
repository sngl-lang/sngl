A scroll is gtk4rt's GtkScrolledWindow, no GIR class, and is built through
the protocol gtk4.sngl declares for it by hand: its create is
gtk4rt.ScrollNew, its child goes in through gtk4rt.ScrolledWindowSetChild,
and its @reachEnd, which GTK raises no signal for, is connected through the
#[gen.protocol(on)] calling gtk4rt.ScrollOnReachEnd rather than through the
platform's connect. Each is a #[go.native], so the inline-cgo path the canvas
keeps the program on calls the same gtk4rt functions a wrapped build does,
and no C string is made for any of them: the one C.CString left is the
window title's, Toplevel being undeclared yet.
deny out/go/gtk4/model.go `C\.gtk_scrolled_window_set_child\(` -- the child goes in through gtk4rt, as in a wrapped build
deny out/go/gtk4/model.go `gtk4rt\.Connect\([^\n]*"reachEnd"` -- reachEnd is no GTK signal; the scroll's own on connects it
-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"
import go "sngl:language/go"

output {
    go {
        gtk4
    }
}

var pages = 1
var shown = true

ui.window(title="t") {
    draw.canvas(width=20px, height=20px) {
        draw.line(x1=0.0, y1=0.0, x2=10.0, y2=10.0)
    }
    ui.scroll #list(@reachEnd {
        pages += 1
    }) {
        ui.text(value="rows")
    }
    if shown {
        ui.scroll {
            ui.text(value="maybe")
        }
    }
}
