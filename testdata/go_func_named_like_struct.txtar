Go capitalizes a free function's name to export it, as it does a type's, so
`func bookRow` beside `struct BookRow` was emitted as a second `BookRow` and
a fyne build failed: "BookRow redeclared in this block". A free
function whose exported name a type of the package already holds is emitted,
and called, under that name with `Func` after it.

deny out/go/fyne/model.go `func BookRow\(` -- the struct holds the name

-- m.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
        bubbletea
    }
}

struct BookRow {
    name string
}

func bookRow(name string) BookRow {
    var row = BookRow{}
    for var w = string.split(name, " ") {
        row.name += w
    }
    return row
}

component shelf ui.node {
    var name = "Dune"

    ui.button(text="Emma", @click { name = "Emma" })
    ui.text(value=bookRow(name).name)
}

ui.window {
    shelf()
}
-- out/go/bubbletea/model.go --
