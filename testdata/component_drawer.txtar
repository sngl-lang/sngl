// Code generated by sngl (fyne) from component_drawer.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	open bool

	__n0 *fyne.Container
	__n1 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.open = false
	return m
}

func (m *Model) Open() bool {
	return m.open
}

func (m *Model) SetOpen(v bool) {
	m.open = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = container.NewVBox()
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText("drawer content")
	m.__n0.Add(m.__n1)
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
