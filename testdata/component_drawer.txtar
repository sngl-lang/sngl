package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/tui"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	open bool

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.open = false
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Open() bool {
	return m.open
}

func (m Model) SetOpen(v bool) Model {
	m.open = v
	return m
}

type setOpenMsg struct{ value bool }

func SetOpenCmd(v bool) tea.Cmd {
	return func() tea.Msg { return setOpenMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	overlayOpen := m.open
	_ = overlayOpen
	switch msg := msg.(type) {
	case setOpenMsg:
		m = m.SetOpen(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyEsc:
			switch {
			case m.open:
				m.open = false
			}
		}
	}
	if !overlayOpen {
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var overlay0 string
	var content string
	if m.open {
		var overlay0Children []string
		var overlay0_0 string
		overlay0_0 = lipgloss.NewStyle().Render(fmt.Sprint("drawer content"))
		overlay0Children = append(overlay0Children, overlay0_0)
		overlay0 = lipgloss.JoinVertical(lipgloss.Left, overlay0Children...)
	}
	content = tui.OverlaySide(content, overlay0, "right", m.width, m.height)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
