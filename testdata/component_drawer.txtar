		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyEsc:
			switch {
			case m.open__inst0:
				m.open__inst0 = false
			}
		}
	}
