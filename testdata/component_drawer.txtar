A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_drawer.sngl --
import . "sngl:ui"
import . "sngl:test"

// drawer: state-binding fixture — toggling bound `open` slides the
// drawer in/out.
component main node {
    var open = false
    drawer(open=open, side="right", size="medium") {
        component content {
            text(value="drawer content")
        }
    }
}

func testDrawerOpenToggles(t Test, c main) {
    t.assert(c.open == false)
    c.open = true
    t.assert(c.open == true)
    c.open = false
    t.assert(c.open == false)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
