win32 paints a `canvasImage` through its `drawSource`, as gtk4 does: a URL is
the context's `image`, which the canvas decodes once and paints again as a
fetched one arrives; a drawing is painted in place, its shapes between a save
that maps its space onto the box and clips to it and the restore. A
`draw.image` an image shows is the runtime's drawing, a picture whose bitmap
its shapes paint as the handler of its `@paint`, and a write to what they read
paints it again.

-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"

output {
    c {
        win32
    }
}

component main() ui.node {
    var r = 4.0
    ui.vbox {
        draw.canvas(width=40px, height=20px) {
            draw.canvasImage(x=1.0, y=2.0, w=8.0, h=4.0) {
                ui.remote(url="https://example.com/logo.png")
            }
            draw.canvasImage(x=10.0, y=2.0, w=8.0, h=4.0) {
                draw.image(width=16.0, height=8.0) {
                    draw.circle(cx=8.0, cy=4.0, r=r)
                }
            }
        }
        ui.image {
            draw.image(width=16.0, height=16.0) {
                draw.circle(cx=8.0, cy=8.0, r=r)
            }
        }
        ui.button(text="grow", @click {
            r += 1.0
        })
    }
}

ui.window {
    main()
}
