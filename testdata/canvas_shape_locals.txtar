Two shapes of one kind in a canvas are each a copy of their override's
drawing, spliced into the one paint handler, and each copy's locals are its
own: a path's `at`, an ellipse's `k`, `ox` and `oy`. Spliced as written,
the second `at` redefined the first in C, which refused the program.

-- app.sngl --
import draw "sngl:ui/draw"
import ui "sngl:ui"

output {
    c {
        win32
    }
}

ui.window(title="Shapes") {
    draw.canvas(width=100px, height=60px) {
        draw.path(style=draw.Style{stroke=#000000}) {
            draw.moveTo(x=0.0, y=0.0)
            draw.arcTo(cx=50.0, cy=0.0, x=50.0, y=50.0, r=10.0)
        }
        draw.path(style=draw.Style{stroke=#ff0000}) {
            draw.moveTo(x=10.0, y=10.0)
            draw.lineTo(x=90.0, y=50.0)
        }
        draw.ellipse(cx=20.0, cy=40.0, rx=10.0, ry=5.0)
        draw.ellipse(cx=70.0, cy=40.0, rx=10.0, ry=5.0)
    }
}
