component main {
    var hex = int.parse("FF", 16)
    var oct = int.parse("77", 8)
    var bin = int.parse("1010", 2)
    var big = 1_000_000
    var hexSep = int.parse("FFFF", 16)
    var pi = 3.141_592
    var zero = 0

    text(value=string(hex))
}

func testHexLiteral(t T, c main) {
    t.assert(c.hex == 255)
}

func testOctalLiteral(t T, c main) {
    t.assert(c.oct == 63)
}

func testBinaryLiteral(t T, c main) {
    t.assert(c.bin == 10)
}

func testUnderscoreSeparator(t T, c main) {
    t.assert(c.big == 1000000)
}

func testHexWithSeparator(t T, c main) {
    t.assert(c.hexSep == 65535)
}
