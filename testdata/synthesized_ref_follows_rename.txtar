body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<span id="__n0" data-sngl-id="__n0">
</span>

<script>
(() => {
  // sngl-entry.js
  var state = {};
  var __ctx_depth__inst0 = 0;
  function String(v) {
    return "" + v;
  }
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  function __sngl_init() {
    __n0.textContent = "depth " + String(__ctx_depth__inst0 + 1);
  }
  __sngl_init();
