An image under a reactive `if` is a local of the render slot that makes it,
and its fit and its events are written and connected there through the
gtk4rt natives its protocol declares, each handed that local. A wrapped
build used to read a node for them as the Model's field before the slot was
known, and handed them `m.__n2`, which the Model does not declare.
deny out/go/gtk4/model.go `gtk4rt\.ImageFrame(SetFit|On[A-Za-z]+)\(m\.` -- the image is the slot's local, not a Model field
-- app.sngl --
import ui "sngl:ui"
import go "sngl:language/go"

output {
    go {
        gtk4
    }
}

var shown = true
var clicks = 0

ui.window(title="t") {
    ui.vbox {
        if shown {
            ui.image(fit=contain, @click { clicks += 1 }) {
                ui.file("a.png")
            }
        }
        ui.button(text="toggle", @click { shown = !shown })
    }
}
