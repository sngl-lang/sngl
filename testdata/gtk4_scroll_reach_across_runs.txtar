A scroll moving sideways reads its end along x, in both languages: a row
too short to fill the scroll asks for a column more each time it grows,
until it is wide enough that its end is more than half the scroll away.
Read along y, the row's height never moved, and it asked once. The scroll
is 400 pixels and each column 150, so it asks at 150, 300, 450 and 600, and
stops at 750. The timer reports once the asking has stood still a while.

exec out/c/gtk4 -- asked.txt
exec out/go/gtk4 -- asked.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import seq "sngl:seq"
import time "sngl:time"
import ui "sngl:ui"

c.link(include="stdio.h", system=true)

#[c.native("puts")]
#[go.native("fmt", "fmt.Println")]
func say(s string)

output {
    c { gtk4 }
    go { gtk4 }
}

var (
    asked = 0
    columns = 1
    seen = 0
    still = 0
)

time.timer(interval=100ms, @tick {
    if asked > 0 && asked == seen {
        still += 1
    } else {
        still = 0
    }
    seen = asked
    if still == 10 {
        say("asked {asked} for {columns} columns")
        gtk4.quit()
    }
})

ui.window(title="t") {
    ui.vbox {
        ui.scroll(direction=ui.ScrollDirection.horizontal, style={width=400px}, @reachEnd {
            asked += 1
            columns += 1
        }) {
            ui.hbox(style={gap=0px}) {
                for var i = seq.count(columns) {
                    ui.text(value="column {i}", style={width=150px})
                }
            }
        }
    }
}
-- asked.txt --
asked 4 for 5 columns
-- out/c/gtk4/main.c --
