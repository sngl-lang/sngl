)

// Model holds the state for this SNGL UI.
type Model struct {
	__n0 *fyne.Container
	__n1 *widget.Button
	__n2 *widget.Button
	__n3 *widget.Button
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

func (m *Model) __n1_click_handler() {
}

func (m *Model) __n2_click_handler() {
}

func (m *Model) __n3_click_handler() {
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = container.NewHBox()
	m.__n1 = widget.NewButton("", nil)
	m.__n1.SetText("New")
	m.__n1.OnTapped = m.__n1_click_handler
	m.__n0.Add(m.__n1)
	m.__n2 = widget.NewButton("", nil)
	m.__n2.SetText("Open")
	m.__n2.OnTapped = m.__n2_click_handler
	m.__n0.Add(m.__n2)
	m.__n3 = widget.NewButton("", nil)
	m.__n3.SetText("Save")
	m.__n3.OnTapped = m.__n3_click_handler
	m.__n0.Add(m.__n3)
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
