-- component_toolbar.sngl --
import . "sngl:ui"

// toolbar: A-tier — declaration only.
component main node {
    toolbar {
        button(text="New")
        button(text="Open")
        button(text="Save")
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
