package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 1
	} else {
		if m.__focusID == 1 {
			m.__focusID = 2
		} else {
			if m.__focusID == 2 {
				m.__focusID = 0
			}
		}
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 2
	} else {
		if m.__focusID == 1 {
			m.__focusID = 0
		} else {
			if m.__focusID == 2 {
				m.__focusID = 1
			}
		}
	}
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentChildren []string
	var content_0 string
	content_0Focused := (m.__focusID == 0)
	content_0Prefix := " "
	if content_0Focused {
		content_0Prefix = ">"
	}
	content_0 = lipgloss.NewStyle().Render(content_0Prefix + " " + fmt.Sprint("New"))
	contentChildren = append(contentChildren, content_0)
	var content_1 string
	content_1Focused := (m.__focusID == 1)
	content_1Prefix := " "
	if content_1Focused {
		content_1Prefix = ">"
	}
	content_1 = lipgloss.NewStyle().Render(content_1Prefix + " " + fmt.Sprint("Open"))
	contentChildren = append(contentChildren, content_1)
	var content_2 string
	content_2Focused := (m.__focusID == 2)
	content_2Prefix := " "
	if content_2Focused {
		content_2Prefix = ">"
	}
	content_2 = lipgloss.NewStyle().Render(content_2Prefix + " " + fmt.Sprint("Save"))
	contentChildren = append(contentChildren, content_2)
	content = lipgloss.JoinHorizontal(lipgloss.Top, contentChildren...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
