The vocabulary a scheme importer needs to write down what it read. An archive
rather than a bare fixture because it imports `sngl:language/go`, and a
platform's own test harness registers only itself -- an archive names the
targets it is built for.

unverifiable out/go/bubbletea -- names example.com/todo, a package written to stand for an importer's output and deliberately not published

-- native_import_vocabulary.sngl --
// The vocabulary a scheme importer needs to write down what it read, in the
// shapes a generated import file uses. Every form here is one an importer
// emits and nothing else in the tree exercises:
//
//   - a field naming its foreign spelling with no package of its own
//   - `context`, for a Go function whose leading context.Context the SNGL
//     signature does not carry
//   - `#[unusable]`, for a declaration that exists over there and cannot be
//     reached from here
//
// Written by hand because the importer does not emit SNGL yet. When it does,
// this is the surface its output is checked against.
import go "sngl:language/go"
import macro "sngl:macro"
import . "sngl:ui"

const _pkg = "example.com/todo"

#[go.native(_pkg, "todo.Todo")]
struct Todo {
    #[go.native("ID")]
    id int
    #[go.native("Title")]
    title string
}

// Only the field is out of reach; the struct around it is fine.
#[go.native(_pkg, "todo.Bag")]
struct Bag {
    #[go.native("OK")]
    ok string
    #[go.native("Bad")]
    #[macro.unusable("field Bag.Bad has type not representable in SNGL")]
    bad dyn
}

// A leading context.Context the signature does not carry, and an error return
// unwrapped to the value.
#[go.native(_pkg, "todo.Fetch", context, fails)]
func Fetch(q string) Todo

#[go.native(_pkg, "todo.MultiReturn")]
#[macro.unusable("functions returning multiple values are not supported")]
func MultiReturn()

#[go.native(_pkg, "todo.Count")]
var Count int

window {
    text(value="{Count}")
}

output {
    go {
        bubbletea
    }
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from native_import_vocabulary.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"example.com/todo"
	"fmt"
	"os"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	visible__inst0 bool

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.visible__inst0 = true
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Visible__inst0() bool {
	return m.visible__inst0
}

func (m Model) SetVisible__inst0(v bool) Model {
	m.visible__inst0 = v
	return m
}

type setVisible__inst0Msg struct{ value bool }

func SetVisible__inst0Cmd(v bool) tea.Cmd {
	return func() tea.Msg { return setVisible__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setVisible__inst0Msg:
		m = m.SetVisible__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			if m.visible__inst0 {
				m.visible__inst0 = false
			}
			if !(m.visible__inst0) {
				return m, tea.Quit
			}
			return m, nil
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	if m.visible__inst0 {
		content = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(todo.Count)))
	}
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
