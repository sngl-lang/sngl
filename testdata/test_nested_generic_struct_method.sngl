// Generic struct with nested method. Checker verifies receiver-level
// type-param substitution for the desugared `this box<T>` parameter.
// Interpreter method dispatch is a follow-up.
struct box<T> {
    v T

    func get() => this.v
}

component main {
    var b box<int> = {v = 42}
    text(value=string(b.get()))
}
