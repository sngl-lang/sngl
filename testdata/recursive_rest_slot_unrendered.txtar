package main

import "testing"

func TestDeepens(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.deeperClick()
	if !((c.depth == 3)) { t.Errorf("assert failed: %s", "(c.depth == 3)") }
}

