A recursive component with a rest slot that nothing instantiates is not
emitted.

A recursion cycle is kept through the inliner whether or not anything renders
it, but only a cycle something instantiates is elected a runtime instance, so
`frame` reached fyne and gtk4 with its `content` insertion still in its body
and both panicked in irwalk on the *ir.SlotInst. The inliner now drops a cycle
nothing the program renders reaches.

deny * `frame` -- nothing renders frame, so no target emits it
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
        gtk4
    }
    none {
        html
    }
}

component frame(n int, content ...component node) node {
    var open = true

    vbox {
        content
        if n > 0 {
            frame(n=n - 1) {
                text(value="level {n}")
            }
        }
    }
}

component main node {
    var depth = 2

    vbox {
        button #deeper(text="deeper", @click { depth += 1 })
    }
}

func testDeepens(t Test, c main) {
    c.deeper.click()
    t.assert(c.depth == 3)
}

window {
    main
}
