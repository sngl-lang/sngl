An instance built at run time that writes page state it reads updates its
own readers once: the page's refresh reaches it as it reaches every other
instance reading `shown`, so its write runs none of its own updates beside
the refresh. Before, each was updated by the write's own updates and again
through the page (design/instances.md, *An instance reaches the page through
what holds it*).
-- app.sngl --
import ui "sngl:ui"

output {
    none { html }
    go {
        fyne
        gtk4
    }
}

var shown = false

component flip(n int) ui.node {
    var flips = 0
    ui.vbox {
        ui.button #go(text="flip", @click {
            flips = flips + 1
            shown = !shown
        })
        ui.text #line(value="{n} {shown}")
        if shown {
            ui.text(value="{n} extra")
        }
    }
}

ui.window {
    ui.vbox {
        ui.text(value="{shown}")
        for var i = [1, 2] {
            flip(n=i)
        }
    }
}
