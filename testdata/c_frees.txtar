A C function answering a string it hands over is marked `#[c.frees]` with
the C function freeing it: the call copies the string, then frees C's
pointer, but NULL, through a C function of the declaration's one shape
the preamble defines (cgo calls the freeing function with no knowledge of
its parameter's type). An `option[string]` is `null` where C answers NULL,
which is not freed. A `ref[string]` marked so is a pointer to NULL C fills,
copied and freed once C returns, and the empty string where C stored
nothing. A variadic C function answering one is freed the same.

The test runs it: each string reads as C wrote it, and C counts five frees
and no NULL handed to one.

-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import test "sngl:test"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

c.link(include="owned.h", sources=["owned.c", "owned.h"])

#[c.native("owned_name")]
#[c.frees("owned_free")]
func name(i int) string

#[c.native("owned_maybe")]
#[c.frees("owned_free")]
func maybe(i int) option[string]

#[c.native("owned_fill")]
func fill(i int, #[c.frees("owned_free")] out ref[string]) bool

#[c.native("owned_join", variadic)]
#[c.frees("owned_free")]
func join2(n int, a string, b string) string

#[c.native("owned_freed")]
func freed() int

component main ui.node {
    var first = ""
    var second = ""
    var some = false
    var none = false
    var filled = ""
    var empty = "kept"
    var joined = ""
    var count = 0
    ui.button #read(text="read", @click {
        first = name(1)
        second = name(2)
        var m = maybe(2)
        some = m != null && m == "née 2"
        none = maybe(3) == null
        filled = "kept"
        var was = fill(4, &filled)
        var wasnt = fill(5, &empty)
        if was && !wasnt {
            joined = join2(2, "a", "b")
        }
        count = freed()
    })
}

ui.window(title="t") {
    main()
}

func testOwnedStringsAreCopiedAndFreed(t test.Test, c main) {
    c.read.click()
    t.assert(c.first == "née 1")
    t.assert(c.second == "née 2")
    t.assert(c.some)
    t.assert(c.none)
    t.assert(c.filled == "née 4")
    t.assert(c.empty == "")
    t.assert(c.joined == "ab")
    t.assert(c.count == 500)
}
-- owned.h --
// A name for i, which the caller frees with owned_free.
char *owned_name(int i);

// owned_name(i) for an even i, NULL for an odd one.
char *owned_maybe(int i);

// Stores owned_name(i) in *out and answers 1 for an even i; stores nothing
// and answers 0 for an odd one.
int owned_fill(int i, char **out);

// The n strings after n, joined, which the caller frees with owned_free.
char *owned_join(int n, ...);

// Frees p, counting it, and NULL apart.
void owned_free(void *p);

// The frees counted, times 100, plus the NULLs among them.
int owned_freed(void);
-- owned.c --
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "owned.h"

static int frees, nulls;

char *owned_name(int i) {
	char *s = malloc(32);
	snprintf(s, 32, "n\xc3\xa9" "e %d", i);
	return s;
}

char *owned_maybe(int i) {
	return i % 2 == 0 ? owned_name(i) : NULL;
}

int owned_fill(int i, char **out) {
	if (i % 2 != 0) {
		return 0;
	}
	*out = owned_name(i);
	return 1;
}

char *owned_join(int n, ...) {
	char *s = calloc(64, 1);
	va_list ap;
	va_start(ap, n);
	for (int i = 0; i < n; i++) {
		strncat(s, va_arg(ap, const char *), 63 - strlen(s));
	}
	va_end(ap);
	return s;
}

void owned_free(void *p) {
	if (p == NULL) {
		nulls++;
		return;
	}
	frees++;
	free(p);
}

int owned_freed(void) {
	return frees * 100 + nulls;
}
