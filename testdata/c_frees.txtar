	var cmd tea.Cmd
	if s.press {
		_, cmd = m.Update(s.key)
	}
	return cmd
}

// readClick activates the #read widget the way a keypress does; for tests.
func (m *Model) readClick() {
	prev := m.__focusID
	m.__focusID = 0
	nm, cmd := m.Update(tea.KeyPressMsg{Code: tea.KeyEnter})
	*m = nm.(Model)
	m.__focusID = prev
	_ = m.View()
	_ = cmd
}

func (m Model) View() tea.View {
	m.__clicks.Reset()
	var content string
	contentFocused := (m.__focusID == 0)
	contentPrefix := " "
	if contentFocused {
		contentPrefix = ">"
	}
	contentText := contentPrefix + " " + fmt.Sprint("read")
	content = tui.Within(tui.Focused(tui.ButtonLook(BoxLook(Style{FlexDirection: "unset", AlignItems: "unset", JustifyContent: "unset", Position: "unset", FontWeight: "unset", FontStyle: "unset", TextAlign: "unset", WhiteSpace: "unset", BorderStyle: "unset", Display: "unset", ListStyleType: "unset"}, true)), contentFocused), tui.Avail(m.width), contentText).Render(contentText)
	content = m.__clicks.Mark(snglStop{slot: 0, pos: 0, press: true, key: tea.KeyPressMsg{Code: tea.KeyEnter}}, content)
	content = m.__clicks.Scan(content, 0, 0)
	v := tea.NewView(content)
	v.AltScreen = true
	v.MouseMode = tea.MouseModeCellMotion
	return v
}

func main() {
	p := tea.NewProgram(New())
	final, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
	if m, ok := final.(Model); ok {
		m.__snglTeardown()
	}
}
-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestOwnedStringsAreCopiedAndFreed(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.readClick()
	if !((c.first == "née 1")) { t.Errorf("assert failed: %s", "(c.first == \"née 1\")") }
	if !((c.second == "née 2")) { t.Errorf("assert failed: %s", "(c.second == \"née 2\")") }
	if !(c.some) { t.Errorf("assert failed: %s", "c.some") }
	if !(c.none) { t.Errorf("assert failed: %s", "c.none") }
	if !((c.filled == "née 4")) { t.Errorf("assert failed: %s", "(c.filled == \"née 4\")") }
	if !((c.empty == "")) { t.Errorf("assert failed: %s", "(c.empty == \"\")") }
	if !((c.joined == "ab")) { t.Errorf("assert failed: %s", "(c.joined == \"ab\")") }
	if !((c.count == 500)) { t.Errorf("assert failed: %s", "(c.count == 500)") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
