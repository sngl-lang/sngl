// else means the body never ran, and a loop with no condition always runs its
// body: the block is unreachable rather than an empty case.

import . "sngl:ui"
import app "sngl:app"

func f() int {
    for { // ERROR(check) "has no else case"
        return 1
    } else {
        return 2
    }
}

app.window {
}
