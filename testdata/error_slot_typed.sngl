// What a slot's declared count refuses.

import . "sngl://std"
import tr "sngl://tree"

component frame(slot body tr.one<component>, slot badge option<component>) {
    vbox {
        body {}
        badge {}
    }
}

component main {
    // Exactly one has no spelling for being absent — option<T> and a bare type
    // are what permit that.
    frame() // ERROR(check) "requires slot \"body\" to be populated"

    frame() {
        slot body { // ERROR(check) "takes exactly one node, got 2"
            text(value = "one")
            text(value = "two")
        }
        slot badge { // ERROR(check) "takes at most one node, got 2"
            text(value = "a")
            text(value = "b")
        }
    }
}
