// What a slot's declared count refuses.

import . "sngl:ui"
import family "sngl:family"

// A named slot's content type counts the nodes its population renders, as the
// rest slot's does; the wrapper around it counts the slot's insertions.
component frame(
    body  component family.one,
    badge option[component option[node]],
) node {
    vbox {
        body {}
        badge {}
    }
}

// The rest slot's count binds a bodyless call too: that path builds its
// NodeInst without going through the visual-node one, where a children count is
// what gets read.
component one(content ...component family.one) node {
    vbox {
        content
    }
}

component main node {
    // The childless form says what the `one() { }` form has always said: it
    // is one node either way, and one check.
    one() // ERROR(check) "component one requires exactly one child"

    frame() {
        component body { // ERROR(check) "takes exactly one node, and this renders 2"
            text(value="one")
            text(value="two")
        }
        component badge { // ERROR(check) "takes at most one node, and this renders 2"
            text(value="a")
            text(value="b")
        }
    }
}

window {
    main
}
