// What a slot's declared count refuses.

import . "sngl:ui"
import family "sngl:family"

// A named slot counts its insertions, so a count of nodes is not its to make.
component frame(
    body component tr.one,        // ERROR(check) "slot \"body\" counts its insertions, not its nodes: write `body component() T`"
    badge component option<node>, // ERROR(check) "slot \"badge\" counts its insertions, not its nodes: write `badge option<component() T>`"
) node {
    vbox {
        body {}
        badge {}
    }
}

// The rest slot's count binds a bodyless call too: that path builds its
// NodeInst without going through the visual-node one, where a children count is
// what gets read.
component one(content ...component family.one) node {
    vbox {
        content
    }
}

component main node {
    // The childless form says what the `one() { }` form has always said: it
    // is one node either way, and one check.
    one() // ERROR(check) "component one requires exactly one child"
}

window {
    main
}
