// What a slot's declared count refuses.

import . "sngl:ui"
import tr "sngl:tree"

component frame(body component tr.one, badge component option<tr.default>) {
    vbox {
        body {}
        badge {}
    }
}

// The rest slot's count binds a bodyless call too: that path builds its
// NodeInst without going through the visual-node one, where a children count is
// what gets read.
component one(content ...component tr.one) {
    vbox {
        content
    }
}

component main {
    one() // ERROR(check) "takes exactly one node, got 0"

    // Exactly one has no spelling for being absent — option<T> and a bare type
    // are what permit that.
    frame() // ERROR(check) "requires slot \"body\" to be populated"

    frame() {
        component body { // ERROR(check) "takes exactly one node, got 2"
            text(value="one")
            text(value="two")
        }
        component badge { // ERROR(check) "takes at most one node, got 2"
            text(value="a")
            text(value="b")
        }
    }
}
