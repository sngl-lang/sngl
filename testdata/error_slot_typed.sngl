// What a slot's declared count refuses.

import . "sngl://std"
import tr "sngl://tree"

component frame(slot body tr.one, slot badge option<tr.default>) {
    vbox {
        body {}
        badge {}
    }
}

// The default slot's count binds a bodyless call too: that path builds its
// NodeInst without going through the visual-node one, where a children count is
// what gets read.
component one(slot _ tr.one) {
    vbox {
        slot
    }
}

component main {
    one() // ERROR(check) "takes exactly one node, got 0"

    // Exactly one has no spelling for being absent — option<T> and a bare type
    // are what permit that.
    frame() // ERROR(check) "requires slot \"body\" to be populated"

    frame() {
        slot body { // ERROR(check) "takes exactly one node, got 2"
            text(value="one")
            text(value="two")
        }
        slot badge { // ERROR(check) "takes at most one node, got 2"
            text(value="a")
            text(value="b")
        }
    }
}
