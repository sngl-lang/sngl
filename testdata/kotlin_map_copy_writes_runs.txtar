A map copied into a local takes an entry write, and the list of a map's keys
takes a sort, on Kotlin: a copy is a read-only `Map`, since every write of a
map rebuilds it and reassigns the holder (a `MutableMap` local cannot take
the `Map` that `+` answers), and `keys()`/`values()` are mutable lists, as
a list literal a local holds is.

-- app.sngl --
import test "sngl:test"
import ui "sngl:ui"

output {
    kotlin {
        android
    }
}

func writes() string {
    var m map[string, int] = {b=2, a=1}
    var copy = m
    copy["z"] = 26
    var ks = copy.keys()
    ks.sort()
    var vs = m.values()
    vs.push(3)
    return "{m.length} {copy.length} {ks} {vs.length}"
}

component main ui.node {
    var said = ""
    ui.button #read(text="read", @click {
        said = writes()
    })
    ui.text(value=said)
}

ui.window(title="t") {
    main()
}

func testCopiedMapAndKeysAreWritable(t test.Test, c main) {
    c.read.click()
    t.assert(c.said == "2 3 a, b, z 3")
}
