Markdown parsed per page of a site.

A `for` over a const list of pages hands `md.document` a source that is only a
value once the page is: html writes a document per page, folding each with the
loop bound (codegen.Fold), and the parse is answered there -- a producer, stored
by its argument like any build-time function. The view loops inside the
document are then constant and unrolled, so each page is markup.

The build's refusal of a call only it can answer leaves a view's calls to the
fold on a target that has one; a target with none refuses this program at
`md.document` (`cmd/sngl/testdata/markdown_document_refused.txt`).

deny * `__cf_` -- each page's blocks are markup it holds
deny * `_parse` -- the parse is the build's; no script calls it

-- app.sngl --
import ui "sngl:ui"
import nav "sngl:ui/nav"
import md "sngl:ui/markup/md"

output {
    none {
        html
    }
}

struct Doc {
    href string
    body string
}

const docs = [Doc{href="/a.html", body="# A\n\nFirst *page*."}, Doc{href="/b.html", body="# B\n\n- second\n- page"}]

ui.window(title=pages.current.title) {
    nav.stack #pages {
        for var d = docs {
            nav.page(href=d.href, title=d.href) {
                md.document(source=d.body)
            }
        }
    }
}
