// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	names     []string
	total     int
	joined    string
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.names = []string{"a", "b"}
	m.total = 0
	m.joined = ""
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Names() []string {
	return m.names
}

func (m Model) SetNames(v []string) Model {
	m.names = v
	return m
}

type setNamesMsg struct{ value []string }

func SetNamesCmd(v []string) tea.Cmd {
	return func() tea.Msg { return setNamesMsg{value: v} }
}

func (m Model) Total() int {
	return m.total
}

func (m Model) SetTotal(v int) Model {
	m.total = v
	return m
}

type setTotalMsg struct{ value int }

func SetTotalCmd(v int) tea.Cmd {
	return func() tea.Msg { return setTotalMsg{value: v} }
}

func (m Model) Joined() string {
	return m.joined
}

func (m Model) SetJoined(v string) Model {
	m.joined = v
	return m
}

type setJoinedMsg struct{ value string }

func SetJoinedCmd(v string) tea.Cmd {
	return func() tea.Msg { return setJoinedMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setNamesMsg:
		m = m.SetNames(msg.value)
	case setTotalMsg:
		m = m.SetTotal(msg.value)
	case setJoinedMsg:
		m = m.SetJoined(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			for i, name := range m.names {
				m.total = (m.total + (i * 10))
				m.joined = (m.joined + name)
			}
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = lipgloss.NewStyle().Render(part0Prefix + " " + fmt.Sprint("run"))
	parts = append(parts, part0)
	var part1 string
	part1 = lipgloss.NewStyle().Render(fmt.Sprint(m.joined))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
