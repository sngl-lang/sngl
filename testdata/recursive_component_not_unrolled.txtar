import ui "sngl:ui"

output {
    kotlin {
        android
    }
    go {
        bubbletea
    }
}

struct Node {
    value int = 0
    left  option[Node] = null
    right option[Node] = null
}

component TreeView(node option[Node] = null) ui.node {
    if node != null {
        ui.vbox {
            ui.text(value=string(node.value))
            if node.left != null {
                TreeView(node=node.left)
            }
            if node.right != null {
                TreeView(node=node.right)
            }
        }
    }
}

ui.window(title="t") {
    var tree = Node{value=5, left=Node{value=3}, right=Node{value=8}}

    TreeView(node=tree)
}
