// A `#[cnative]` alias spells a C typedef of something SNGL already has: a
// number or a bool, which an argument crosses cast to, or a string, which
// crosses as UTF-16. A C type of anything else is a `#[cnative]` struct, and an
// alias takes no mark but this one, since it is what it names.
import macro "sngl:macro"

struct Point {
    x int
}

#[macro.cnative("POINT")] // ERROR(check) "marks an alias of Point; an alias spells a C typedef of int, float, bool or string"
struct P = Point

#[macro.cnative("INTS")] // ERROR(check) "marks an alias of list[int]"
struct Ints = list[int]

#[macro.cnative("const char *")] // ERROR(check) "a `char *` is what a string crosses as already"
struct Str = string

#[macro.cnative("UINT *")] // ERROR(check) "so it names a C scalar and no pointer"
struct UINTP = int

#[macro.cnative("UINT", cast)] // ERROR(check) "carries cast, which describes a conversion; an alias is a C type"
struct Cast = int

#[macro.cnative("BOX")] // ERROR(check) "names one C type, so the alias takes no type parameters"
struct Box[T any] = list[T]

#[macro.wildcard] // ERROR(check) "#[macro.wildcard] cannot mark an alias"
struct W = int

#[macro.cnative("UINT")]
struct UINT = int

#[macro.cnative("const unsigned short *")]
struct Wide = string
