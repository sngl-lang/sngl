A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_reactive_ternary_context.sngl --
import . "sngl:ui"
import . "sngl:test"

// reactive-ternary-context: a ternary whose condition reads a reactive var
// (`dark`) is used as a context-provider value, consumed by 2+ children.
// Regression for the ternary-vs-reactivity lowering order bug: ternary
// lowering must run AFTER reactivity so the synthesized `var __ltN` decl and
// its `if` assignment stay together (not split across a render-slot func) and
// the consumers carry a reactive dep on `dark`.
context #theme("light")

component ThemedBox(label = "") node {
    text(value="{label}: {theme}")
}

component main node {
    var dark = false
    vbox {
        button(text="toggle", @click { dark = !dark })
        theme(dark ? "dark" : "light") {
            ThemedBox(label="outer")
            ThemedBox(label="sibling")
        }
    }
}

func testThemeToggles(t Test, c main) {
    t.assert(c.dark == false)
    c.dark = true
    t.assert(c.dark == true)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
