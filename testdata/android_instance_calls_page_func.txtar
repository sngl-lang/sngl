A component composed on its own calls a package function that writes the
page's state, and names none of that state itself.

On android a component built at run time is a composable of its own. The
page's state is `remember`ed in MainScreen, or a member of the test build's
state class, and a function writing it was declared beside that state: a
local fun of MainScreen, a member of the class. The composable named neither:
only a read of a package var by name moved that state where it could reach it,
and a call was no such read, so `holder` did not compile
(`Unresolved reference 'state'`). The test build is what this compiles;
`android_instance_calls_page_func_app.txtar` is the app's.

-- app.sngl --
import ui "sngl:ui"
import "sngl:test"

output {
    go {
        bubbletea
    }
    kotlin {
        android
    }
    none {
        html
    }
}

var opened = 0
var log = ""

func note(s string) {
    log += s
}

func open() int {
    opened += 1
    note("o")
    return opened
}

component holder ui.node {
    var fd = open()

    ui.text #shows(value="{fd}")
}

component screen ui.node {
    var shown = true

    ui.vbox {
        ui.button #t(text="t", @click {
            shown = !shown
        })
        if shown {
            holder
        }
    }
}

func testOpensOnEachShow(t test.Test, c screen) {
    t.assert(opened == 1)
    c.shown = false
    c.shown = true
    t.assert(opened == 2)
    t.assert(log == "oo")
}

ui.window(title="t") {
    screen
}
