package main

import "testing"

func TestOpensOnEachShow(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.opened == 1)) { t.Errorf("assert failed: %s", "(c.opened == 1)") }
	c.shown = false
	c.__effects0_settle()
	c.shown = true
	c.__effects0_settle()
	if !((c.opened == 2)) { t.Errorf("assert failed: %s", "(c.opened == 2)") }
	if !((c.log == "oo")) { t.Errorf("assert failed: %s", "(c.log == \"oo\")") }
}


func newTestComponent() Model { return New() }
