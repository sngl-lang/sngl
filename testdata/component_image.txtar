)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	src__inst0 string

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.src__inst0 = "https://example.com/a.png"
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Src__inst0() string {
	return m.src__inst0
}

func (m Model) SetSrc__inst0(v string) Model {
	m.src__inst0 = v
	return m
}

type setSrc__inst0Msg struct{ value string }

func SetSrc__inst0Cmd(v string) tea.Cmd {
	return func() tea.Msg { return setSrc__inst0Msg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setSrc__inst0Msg:
		m = m.SetSrc__inst0(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint("[image]"))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
