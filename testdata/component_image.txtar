A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_image.sngl --
import . "sngl:ui"
import . "sngl:test"

// image: state-binding fixture — mutating the bound `src` var
// propagates to the image component.
component main node {
    var src = "https://example.com/a.png"
    image(src=src, alt="test")
}

func testImageSrcMutates(t Test, c main) {
    t.assert(c.src == "https://example.com/a.png")
    c.src = "https://example.com/b.png"
    t.assert(c.src == "https://example.com/b.png")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
