// Code generated by sngl (fyne) from component_image.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/canvas"
	"os"
)

// Model holds the state for this SNGL UI.
type Model struct {
	src string

	__n0 *canvas.Image
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.src = "https://example.com/a.png"
	return m
}

func (m *Model) Src() string {
	return m.src
}

func (m *Model) SetSrc(v string) {
	m.src = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = canvas.NewImageFromResource(nil)
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
