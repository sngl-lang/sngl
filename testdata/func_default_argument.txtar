A call that omits an argument passes the parameter's default: every emitted
function takes every parameter it declares, since Go has no default and no
emitter declares one. A skipped middle parameter is filled in its place, and a
component method's default reads the instance the call is made in -- its own
copy of the state, or the cells a copy built at run time keeps.

deny out/none/html/index.html `plus\(1\)` -- the default is written into the call
deny out/go/bubbletea/model.go `IntBump\(m\.n, &m\)` -- a method's default follows its receiver
deny * `add[_a-z0-9]*\(1\)` -- a component method's default is written too

-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
}

var n = 1
var rows = [1, 2]

func plus(k int, by int = 2) int {
    return k + by + n
}

func span(lo int, step int = 1, hi int = n + 10) int {
    return hi - lo + step + n
}

func int.bump(k int, by int = 3) int {
    return k + by + n
}

component counter(inc int) ui.node {
    var step = 2
    var total = 0

    func add(a int, by int = step + inc) {
        total += a + by
    }

    ui.button(text="{total}", @click {
        add(1)
    })
}

ui.window(title="t") {
    ui.text(value="{plus(1)} {span(1, hi=5)} {span(2)} {n.bump()}")
    ui.button(text="go", @click {
        n += 1
    })
    counter(inc=10)
    counter(inc=20)
    for var r = rows {
        counter(inc=r)
    }
}
