A block of a view that declares state and renders no widget -- a `var` and
an `effect`, both of which take the family they are placed in -- is still an
instance standing in a position, and its synthesized `__block_state<N>`
belongs to the family that position accepts: here the vbox's `ui.node`. Read
off its body alone it named none, and typing the slot it renders into
panicked the lowering on every target that builds instances at run time.
On bubbletea, which keeps a cell per copy rather than an instance, the
effect's handlers are handed the copy's key through `on`, since the settle
runs them outside the loop the key is built from. Inside a wrapper that takes
the family it is placed in, `wrap`, the block takes the family `wrap` stands
in.
-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        gtk4
        fyne
        bubbletea
    }
}

component wrap[T any](content ...component T) T {
    var k = 0
    effect(@mount { k = k + 1 })
    content
}

var items = [1, 2, 3]
var total = 0

ui.window(title="mounts") {
    ui.vbox {
        for var i = items {
            var seen = 0
            effect(@mount {
                seen = seen + 1
                total = total + 1
            })
        }
        wrap {
            for var j = items {
                var held = 0
                effect(@mount {
                    held = held + 1
                    total = total + held
                })
            }
        }
        ui.text(value="{total}")
    }
}
