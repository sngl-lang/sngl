sngl:remote/http declares `get` and leaves it open -- what an HTTP request *is*
is not a question any tier below a target can answer. sngl:language/go closes
it with an override whose body calls a declaration marked #[go.native], and
the whole chain has to arrive at the Go package that performs the request:
the import of pkg/go/remote/http, and the call spelled the way Go spells it
after that import.

Every link is load-bearing and each has been broken on its own: the language
package not loading at all, the override merging into nothing, and the native
call rendering as the SNGL name because only a namespace-qualified call site
consulted the mark.

deny out/go/bubbletea/model.go `httpGet` -- a native declaration *is* the foreign identifier rather than corresponding to one, so the SNGL name is not emitted anywhere

-- app.sngl --
import . "sngl:ui"
import . "sngl:app"
import http "sngl:remote/http"

window(title="get") {
    var url = "https://example.com/"

    text(value=http.get(url).body)
}

output {
    go {
        bubbletea()
    }
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/remote/http"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	url string

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.url = "https://example.com/"
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Url() string {
	return m.url
}

func (m Model) SetUrl(v string) Model {
	m.url = v
	return m
}

type setUrlMsg struct{ value string }

func SetUrlCmd(v string) tea.Cmd {
	return func() tea.Msg { return setUrlMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setUrlMsg:
		m = m.SetUrl(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(func() http.Response { v, _ := http.Get(m.url); return v }().Body))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
