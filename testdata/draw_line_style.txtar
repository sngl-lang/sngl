A stroke's cap and join and a path step's op are enums of sngl:ui/draw, and each
target maps the member to its own drawing API: cairo's enum values on gtk4,
Compose's StrokeCap and StrokeJoin on android, the Canvas2D strings on html,
and the Go rasterizer's names on fyne and bubbletea.

-- draw_line_style.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"

component art ui.node {
    draw.canvas(width=60px, height=40px) {
        draw.line(x1=4.0, y1=4.0, x2=56.0, y2=4.0, style={stroke=#336699, strokeWidth=4.0, lineCap=round})
        draw.path(style={stroke=#993366, strokeWidth=2.0, lineCap=square, lineJoin=bevel}) {
            draw.moveTo(x=4.0, y=12.0)
            draw.lineTo(x=30.0, y=36.0)
            draw.bezierTo(cx1=34.0, cy1=12.0, cx2=44.0, cy2=12.0, x=56.0, y=36.0)
            draw.arcTo(cx=56.0, cy=12.0, x=40.0, y=12.0, r=4.0)
            draw.close()
        }
    }
}

ui.window {
    art()
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
