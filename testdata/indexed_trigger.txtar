A test triggers one of the nodes a loop renders under one `#id` by its
index, `c.tap[1].click()`, on every target: the copy at that index in render
order, after the loop has rendered again too.

One loop's copy key is its index (ir.CopyKey), which passCopyKeys writes
on each copy and hands the checkbox's implicit-state wrapper; each language's
test lowerer calls the invoker's `At` variant with it (codegen.InvokerAt).
html finds the element carrying it in data-sngl-copy, and under it the
element the listener is on when that is not the named one -- a checkbox's
`<input>` in the `<label>` its id lands on. fyne and gtk4 keep the copies of
an id a test indexes in a map, and only such an id (ir.IndexedRefIDs).
bubbletea walks the loop as View counts it to find the copy's focus ordinal
and presses the key with the slot's cursor there. android finds the node
whose SnglCopy semantics property holds it.

bubbletea renders a text input per copy, a bubbles model each in a map keyed
by the copy (loopwidget.go); it used to keep one model field for every copy.

cmd/sngl/testdata/indexed_trigger_runs.txt runs it on all six.

deny out/go/bubbletea/model.go `\twidget\d+\s+textinput\.Model` -- a looped input is a model per copy, not one field
deny out/none/html/index.html `function test` -- a test is the test module's, lowered with its triggers, and the page writes no copy of it
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component main node {
    var items = ["a", "b"]
    var log = ""
    vbox {
        button #swap(text="swap", @click { items = ["c", "d", "e"] })
        for var it = items {
            button #tap(text=it, @click { log = it })
            checkbox #box(label=it, @change(on) { log = "{it} {on}" })
            input #field(value=it, @change(v) { log = "{it}={v}" })
        }
        text(value=log)
    }
}

func testOneCopy(t Test, c main) {
    c.tap[1].click()
    t.assert(c.log == "b")
    c.box[0].change(true)
    t.assert(c.log == "a true")
    c.field[1].change("x")
    t.assert(c.log == "b=x")
}

func testOneCopyAfterTheLoopRendersAgain(t Test, c main) {
    c.swap.click()
    c.tap[2].click()
    t.assert(c.log == "e")
    c.box[1].change(true)
    t.assert(c.log == "d true")
    c.field[0].change(value="y")
    t.assert(c.log == "c=y")
}

window {
    main
}
