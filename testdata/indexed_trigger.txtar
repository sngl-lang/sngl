package main

import "testing"

func TestOneCopy(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.tapClickAt("1")
	if !((c.log == "b")) { t.Errorf("assert failed: %s", "(c.log == \"b\")") }
	c.boxChangeAt("0", true)
	if !((c.log == "a true")) { t.Errorf("assert failed: %s", "(c.log == \"a true\")") }
	c.fieldChangeAt("1", "x")
	if !((c.log == "b=x")) { t.Errorf("assert failed: %s", "(c.log == \"b=x\")") }
}

func TestOneCopyAfterTheLoopRendersAgain(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.swapClick()
	c.tapClickAt("2")
	if !((c.log == "e")) { t.Errorf("assert failed: %s", "(c.log == \"e\")") }
	c.boxChangeAt("1", true)
	if !((c.log == "d true")) { t.Errorf("assert failed: %s", "(c.log == \"d true\")") }
	c.fieldChangeAt("0", "y")
	if !((c.log == "c=y")) { t.Errorf("assert failed: %s", "(c.log == \"c=y\")") }
}


func newTestComponent() Model { return New() }
