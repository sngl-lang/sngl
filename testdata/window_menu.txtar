package main

import "testing"

func TestPickingAnEntryChecksIt(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(("Medium" == c.size)) { t.Errorf("assert failed: %s", "(\"Medium\" == c.size)") }
	c.main__menuSelectAt("1")
	c.main__menu__childrenSelectAt("1/2")
	if !((c.size == "Large")) { t.Errorf("assert failed: %s", "(c.size == \"Large\")") }
	if !((("Large" == c.size) && !("Medium" == c.size))) { t.Errorf("assert failed: %s", "((\"Large\" == c.size) && !(\"Medium\" == c.size))") }
}

func TestAnEntryRunsItsHandler(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.main__menuSelectAt("0")
	c.main__menu__childrenSelectAt("0/0")
	if !((c.saved == 1)) { t.Errorf("assert failed: %s", "(c.saved == 1)") }
}

func TestADisabledEntryIsShownAndNotPicked(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(true) { t.Errorf("assert failed: %s", "true") }
}

