A window's menu on each target: android's app bar actions, each opening a
DropdownMenu of its submenu; gtk4's GMenu behind the header bar's menu
button; fyne's main menu; html's bar of `<details>` in a `<header>`; and no
menu on bubbletea, a terminal having no place for one. The entries are drawn
from the records the call site wrote, and a test's pick of one is a press of
what the window drew for it (lower.NameRecordPresses), where the target drew
something; bubbletea runs the record's own handler. testdata/window_menu.sngl
is the same program on the interpreter.

-- app.sngl --
import ui "sngl:ui"
import "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

const sizes = ["Small", "Medium", "Large"]

component app root {
    var size = "Medium"
    var saved = 0

    ui.window #main(title="Sizes") {
        component menu {
            ui.menuItem(label="File") {
                ui.menuItem(label="Save", @select { saved += 1 })
                ui.menuItem(label="Close", disabled=true)
            }
            ui.menuItem(label="Size") {
                for var s = sizes {
                    ui.menuItem(label=s, checked=s == size, @select { size = s })
                }
            }
        }
        ui.text #shown(value=size)
    }
}

app()

func testPickingAnEntryChecksIt(t test.Test, c app) {
    t.assert(c.main.menu[1].children[1].checked)
    c.main.menu[1].select()
    c.main.menu[1].children[2].select()
    t.assert(c.shown.value == "Large")
    t.assert(c.main.menu[1].children[2].checked && !c.main.menu[1].children[1].checked)
}

func testAnEntryRunsItsHandler(t test.Test, c app) {
    c.main.menu[0].select()
    c.main.menu[0].children[0].select()
    t.assert(c.saved == 1)
}

func testADisabledEntryIsShownAndNotPicked(t test.Test, c app) {
    t.assert(c.main.menu[0].children[1].label == "Close" && c.main.menu[0].children[1].disabled)
}
