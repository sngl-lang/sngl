A timer whose @tick body calls an async native produces an async
$timer_N_tick function in the generated JS.
The $timer_N_sync wrapper (which just calls tick + setTimeout) stays sync.

Timer tick function is async because the body awaits fetchHello.

The async native is awaited inside the tick body.
-- app.sngl --
import . "sngl:ui"
import . "sngl:time"
import . "sngl:app"
import api "js:./api"

output {
    none {
        html
    }
}

component main {
    var running = true
    var last = ""
    timer(interval=500ms, enabled=running, @tick {
        last = api.fetchHello("poll")
    })
    text(value=last)
}
-- api/index.ts --
export async function fetchHello(url: string): Promise<string> { return "data"; }
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<span id="__n0" data-sngl-id="__n0">
</span>

<script>
(() => {
  // sngl-virt:/sngl/api/index.ts
  async function fetchHello(url) {
    return "data";
  }

  // sngl-entry.js
  var state = { running: true, last: "" };
  function $set_running(v) {
    state.running = v;
    $timer_0_sync();
  }
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  var $timer_0 = null;
  async function $timer_0_tick() {
    state.last = await fetchHello("poll");
    __n0.textContent = state.last;
  }
  function $timer_0_sync() {
    if (state.running && !$timer_0) {
      $timer_0 = setInterval($timer_0_tick, 500);
    } else if (!state.running && $timer_0) {
      clearInterval($timer_0);
      $timer_0 = null;
    }
  }
  function __sngl_init() {
    __n0.textContent = state.last;
    $timer_0_sync();
  }
  __sngl_init();
})();
</script>
</body></html>
