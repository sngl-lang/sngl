A `return` in a window's @error ends the handler, and the handler is the catch
clause of the click body's catch block. Kotlin has no bare `return` inside the
`onClick` lambda that clause sits in, so a handler holding one runs as a local
fun, as a call's own @error already did. Go's clause is a deferred func and
JavaScript's ends the listener, so neither needs it.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `val e = __e\.event\n\s*caught` -- the handler holding a return is a local fun, not inlined into the lambda

-- app.sngl --
import . "sngl:ui"

func check(s string) {
    if s.length == 0 {
        error.raise("empty", "validation")
    }
}

var caught = "none"
var n = 0

window #home(title="raise", href="/index.html", @error(e) {
    caught = "window: " + e.message
    if n > 3 {
        return
    }
    n = n + 1
}) {
    vbox {
        button(text="go", @click {
            check("")
            n = 2
        })
        text(value=caught)
    }
}

output {
    none {
        html
    }
    go {
        bubbletea
        fyne
        gtk4
        html
    }
    kotlin {
        android
    }
}
