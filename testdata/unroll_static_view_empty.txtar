
Who unrolls a constant loop, part two: the platform has a say as well as the
language. html can only iterate over an expression that varies with the
request, so a `for` over a compile-time constant is unrolled into markup
instead -- three links in unroll_static_view.txtar.

Here the constant list is empty, and an expansion of nothing has to read as an
empty expansion rather than as an iterable the optimizer could not evaluate.
That distinction is the bug: it left an else-less loop standing, which
rendered one empty row per empty list. The span beside it stays, so the golden
shows the loop was dropped and not the whole nav.

deny out/go/html/server.go `class=[^>]*row` -- the loop runs no iterations, so its body is emitted zero times, not once with an unbound variable
-- empty.sngl --
import "sngl:platform/html"
import ui "sngl:ui"

output {
    go {
        html
    }
}

const packages list<string> = []

ui.window #home(title="Docs") {
    html.nav {
        html.span(innerText="still here")
        for var p = packages {
            html.li(class="row", innerText=p)
        }
    }
}
-- out/go/html/server.go --
package main

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleHome)
	return mux
}

func handleHome(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from empty.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Docs</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<nav>\n  <span>still here</span>\n</nav>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = {};\n})();\n</script>\n</body></html>\n"))
}

func main() {
	http.ListenAndServe(":8080", Handler())
}
