One copy of a component instance a loop renders under an `if`, null-tested,
on every target. html, fyne, gtk4 and android build the instance while the
program runs, so it is handed the key of the copy it stands in, as a node a
test indexes is: through the `__copy` prop, whose setter re-keys an instance a
render slot keeps and moves to another copy. An instance leaves its id's
copies as it is destroyed, whether its slot or what holds the slot destroys
it. bubbletea splices the instance and answers from the view.

cmd/sngl/testdata/indexed_ref_null_test_instance_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component badge(label string) node {
    var hits = 0
    button #hit(text="hit {label} {hits}", @click { hits = hits + 1 })
}

component main node {
    var names = ["a", "b", "c"]
    var skip = "b"
    var open = true
    vbox {
        button #move(text="m", @click { skip = "a" })
        button #shut(text="c", @click { open = false })
        if open {
            vbox {
                for var n = names {
                    if n != skip {
                        badge #b(label=n)
                    }
                }
            }
        }
    }
}

func testInstanceCopy(t Test, c main) {
    t.assert(c.b[0] != null)
    t.assert(c.b[1] == null)
    t.assert(c.b[2] != null)
    c.move.click()
    t.assert(c.b[0] == null)
    t.assert(c.b[1] != null)
    t.assert(c.b[2] != null)
    c.shut.click()
    t.assert(c.b[1] == null)
    t.assert(c.b[2] == null)
}

window {
    main
}
