A scroll's `direction` says which axis it scrolls, and each target scrolls
that one: a scroll given none scrolls vertically, `horizontal` sideways, and
`both` either way.

android's SnglScroll takes the axis, as `horizontalScroll`, `verticalScroll`
or both. fyne's ReachScroll is Fyne's VScroll, HScroll or Scroll. gtk4's
Scroll sets the scrolled window's two policies. html marks the box with a
class per axis, whose rule says overflow-x and overflow-y, where a scroll was
`overflow:auto` in both directions whatever it was given. bubbletea draws a
scroll as its content, cut off by the terminal, on every axis.

-- app.sngl --
import seq "sngl:seq"
import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
    kotlin {
        android
    }
}

component main ui.node {
    ui.vbox(style={gap=8px}) {
        ui.scroll #down(style={height=120px}) {
            ui.vbox {
                for var i = seq.range(0, 20) {
                    ui.text(value="row {i}")
                }
            }
        }
        ui.scroll #across(direction=horizontal) {
            ui.hbox(style={gap=8px}) {
                for var i = seq.range(0, 20) {
                    ui.text(value="column {i}", style={width=120px})
                }
            }
        }
        ui.scroll #either(direction=both, style={height=120px}) {
            ui.vbox {
                for var i = seq.range(0, 20) {
                    ui.text(value="a long line {i} that runs on past the right edge of a phone's screen")
                }
            }
        }
    }
}

ui.window {
    main
}
