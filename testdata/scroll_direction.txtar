fun columnSpacing(j: SnglJustification, gap: androidx.compose.ui.unit.Dp): androidx.compose.foundation.layout.Arrangement.Vertical = (when (j) { SnglJustification.SPACEBETWEEN -> Arrangement.SpaceBetween; SnglJustification.SPACEAROUND -> Arrangement.SpaceAround; SnglJustification.SPACEEVENLY -> Arrangement.SpaceEvenly; SnglJustification.CENTER -> Arrangement.spacedBy(gap, Alignment.CenterVertically); SnglJustification.END -> Arrangement.spacedBy(gap, Alignment.Bottom); SnglJustification.UNSET, SnglJustification.START -> Arrangement.spacedBy(gap) })

fun rowSpacing(j: SnglJustification, gap: androidx.compose.ui.unit.Dp): androidx.compose.foundation.layout.Arrangement.Horizontal = (when (j) { SnglJustification.SPACEBETWEEN -> Arrangement.SpaceBetween; SnglJustification.SPACEAROUND -> Arrangement.SpaceAround; SnglJustification.SPACEEVENLY -> Arrangement.SpaceEvenly; SnglJustification.CENTER -> Arrangement.spacedBy(gap, Alignment.CenterHorizontally); SnglJustification.END -> Arrangement.spacedBy(gap, Alignment.End); SnglJustification.UNSET, SnglJustification.START -> Arrangement.spacedBy(gap) })

