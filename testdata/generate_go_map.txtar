	"charm.land/lipgloss/v2"
	"fmt"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	scores    map[string]int
	size      int
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.scores = map[string]int{"alice": 10, "bob": 20}
	m.size = 0
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 1
	} else {
		if m.__focusID == 1 {
			m.__focusID = 0
		}
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 1
	} else {
		if m.__focusID == 1 {
			m.__focusID = 0
		}
	}
}

func (m Model) Scores() map[string]int {
	return m.scores
}

func (m Model) SetScores(v map[string]int) Model {
	m.scores = v
	return m
}

type setScoresMsg struct{ value map[string]int }

func SetScoresCmd(v map[string]int) tea.Cmd {
	return func() tea.Msg { return setScoresMsg{value: v} }
}

func (m Model) Size() int {
	return m.size
}

func (m Model) SetSize(v int) Model {
	m.size = v
	return m
}

type setSizeMsg struct{ value int }

func SetSizeCmd(v int) tea.Cmd {
	return func() tea.Msg { return setSizeMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setScoresMsg:
		m = m.SetScores(msg.value)
	case setSizeMsg:
		m = m.SetSize(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			m.size = len(m.scores)
		case msg.Code == tea.KeyEnter && m.__focusID == 1:
			m.size = func() int {
				if __v, __ok := m.scores["alice"]; __ok {
					return __v
				}
				return 0
			}()
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = lipgloss.NewStyle().Render(part0Prefix + " " + fmt.Sprint("count"))
	parts = append(parts, part0)
	var part1 string
	part1Focused := (m.__focusID == 1)
	part1Prefix := " "
	if part1Focused {
		part1Prefix = ">"
	}
	part1 = lipgloss.NewStyle().Render(part1Prefix + " " + fmt.Sprint("check"))
	parts = append(parts, part1)
	var part2 string
	part2 = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(m.size)))
	parts = append(parts, part2)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
