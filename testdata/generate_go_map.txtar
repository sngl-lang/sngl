Go codegen for `map<K, V>`: literal, index and method dispatch. The field is
declared on the Model as map[string]int, New() initialises it from the map
literal, and `scores.length()` dispatches to len(m.scores).

`scores.get(key, default)` dispatches to an inline if-ok idiom wrapped in a
func typed by the map's value type -- a `func() any` there would not assign to
an int.

-- app.sngl --
import . "sngl:ui"

output { go { bubbletea } }

component main {
    var scores map<string, int> = {alice=10, bob=20}
    var size = 0
    button(text="count", @click {
        size = scores.length()
    })
    button(text="check", @click {
        size = scores.get("alice", 0)
    })
    text(value=string(size))
}
-- out/go/bubbletea/model.go --
