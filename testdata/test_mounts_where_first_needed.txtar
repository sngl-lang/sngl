A test's component mounts where the test first needs it, on every target:
what the test set before that is what it starts from (passTestMount).
-- app.sngl --
import test "sngl:test"
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        fyne
        gtk4
        bubbletea
    }
    kotlin {
        android
    }
}

context #server("real")

component page(name string = "a") ui.node {
    var shown = name
    var running = true
    var asked = ""
    var mounts = 0

    effect(@mount {
        mounts += 1
        asked = "{server}/{name}"
    })
    ui.text #label(shown)
}

func testStartsFromWhatTheTestSet(t test.Test, c page) {
    t.setContext(server, "local")
    c.name = "b"
    c.running = false
    t.assert(c.asked == "local/b")
    t.assert(c.mounts == 1)
    t.assert(c.shown == "b")
    t.assert(!c.running)
}

func testAWriteAfterTheMountMovesIt(t test.Test, c page) {
    t.assert(c.asked == "real/a")
    c.name = "b"
    t.assert(c.shown == "a")
    t.assert(c.mounts == 1)
}

func testMountsAtTheEnd(t test.Test, c page) {
    c.name = "b"
}

ui.window {
    page()
}
