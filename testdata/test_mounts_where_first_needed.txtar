package main

import "testing"

func TestStartsFromWhatTheTestSet(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.__ctx_server = "local"
	c.name = "b"
	c.running = false
	c = mountTestComponent(c, map[string]bool{"__ctx_server": true, "name": true, "running": true})
	if !((c.asked == "local/b")) { t.Errorf("assert failed: %s", "(c.asked == \"local/b\")") }
	if !((c.mounts == 1)) { t.Errorf("assert failed: %s", "(c.mounts == 1)") }
	if !((c.shown == "b")) { t.Errorf("assert failed: %s", "(c.shown == \"b\")") }
	if !(!c.running) { t.Errorf("assert failed: %s", "!c.running") }
}

func TestAWriteAfterTheMountMovesIt(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !((c.asked == "real/a")) { t.Errorf("assert failed: %s", "(c.asked == \"real/a\")") }
	c.name = "b"
	if !((c.shown == "a")) { t.Errorf("assert failed: %s", "(c.shown == \"a\")") }
	if !((c.mounts == 1)) { t.Errorf("assert failed: %s", "(c.mounts == 1)") }
}

func TestMountsAtTheEnd(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.name = "b"
	c = mountTestComponent(c, map[string]bool{"name": true})
}

