`main` names nothing in particular, and a window whose `#id` is `main` is
routed like any other window: the first window is `/`, and this one, the
second, is `/main` and handled by `handleMain`.

It used to be taken for the index by name, so it was handed `/` and
`handleIndex` beside the first window's `/` -- two `GET /` patterns on one
mux, which net/http refuses with a panic when the server starts.

deny out/go/html/server.go `handleIndex` -- no window here is the index by name; `#main` was
deny out/go/html/server.go `(?s)"GET /",.*"GET /",` -- two routes on one pattern is the panic at startup

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        html
    }
}

ui.window #home(title="Home") {
    ui.text(value="home")
}

ui.window #main(title="Main") {
    ui.text(value="main")
}
-- out/go/html/server.go --
package main

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleHome)
	mux.HandleFunc("GET /main", handleMain)
	return mux
}

func handleHome(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Home</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<span>home</span>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = {};\n})();\n</script>\n</body></html>\n"))
}

func handleMain(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Main</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<span>main</span>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = {};\n})();\n</script>\n</body></html>\n"))
}

func main() {
	http.ListenAndServe(":8080", Handler())
}
