`main` names nothing in particular. The first window is html's document,
served at `/` and handled by `handleHome`, and this one, the second, is a
`<dialog>` in it -- a window whose `#id` is `main` is shown like any other.

It used to be taken for the index by name, so it was handed `/` and
`handleIndex` beside the first window's `/` -- two `GET /` patterns on one
mux, which net/http refuses with a panic when the server starts. Until html
showed a second window as a dialog, it was routed at `/main` instead.

deny out/go/html/server.go `handleIndex` -- no window here is the index by name; `#main` was
deny out/go/html/server.go `(?s)"GET /",.*"GET /",` -- two routes on one pattern is the panic at startup

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        html
    }
}

ui.window #home(title="Home") {
    ui.text(value="home")
}

ui.window #main(title="Main") {
    ui.text(value="main")
}
-- out/go/html/server.go --
package main

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleHome)
	return mux
}

func handleHome(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Home</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\ndialog { margin: auto; padding: 1em; }\n  </style>\n</head><body>\n\n<span>home</span>\n<dialog id=\"__n0\" data-sngl-id=\"__n0\" aria-label=\"Main\">\n  <header>\n    <span>Main</span>\n    <button id=\"$1\" aria-label=\"Close\">\n      <span>×</span>\n    </button>\n  </header>\n  <span>main</span>\n</dialog>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { visible__inst0: true };\n  var $1 = document.getElementById(\"$1\");\n  var __n0 = document.querySelector('[data-sngl-id=\"__n0\"]');\n  $1.addEventListener(\"click\", function() {\n    state.visible__inst0 = false;\n    __n0.open = state.visible__inst0;\n  });\n  function __sngl_init() {\n    __n0.open = state.visible__inst0;\n  }\n  __sngl_init();\n})();\n</script>\n</body></html>\n"))
}

func main() {
	http.ListenAndServe(":8080", Handler())
}
