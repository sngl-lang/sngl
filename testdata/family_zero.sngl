// SKIP(codegen) "a family value reaches a compiled target in C2's later commits"
// A family's zero is written as its literal with no fields, `suit{}`, and
// names no member: it is unequal to every member and equal to itself, and its
// props read as their types' zeros. An unbound family-typed two-way prop
// starts there.

import . "sngl:test"
import build "sngl:build"
import . "sngl:ui"

component suit(name string) build.family

component plain(name string) suit {}

component hand(name string, :held suit) suit {
    plain #spades(name="spades")
}

component table(name string) suit {
    hand #h(name="h")
}

func nothing() => suit{}

func testTheZeroNamesNoMember(t Test, c table) {
    t.assert(nothing() != c.h.spades)
    t.assert(nothing() == suit{})
    t.assert(nothing().name == "")
}

func testAnUnboundFamilyPropStartsAtTheZero(t Test, c table) {
    t.assert(c.h.held == suit{})
}
