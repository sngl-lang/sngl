A component with state of its own that holds a lifetime, under a loop.

-- app.sngl --
import ui "sngl:ui"
import time "sngl:time"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    none {
        html
    }
}

const periods list[time.duration] = [100ms, 250ms]

component ticker(period time.duration = 100ms) ui.node {
    var ticks = 0
    time.timer(interval=period, enabled=true, @tick { ticks = ticks + 1 })
    ui.text(value="{period}: {ticks}")
}

ui.window(title="t") {
    for var p = periods {
        ticker(period=p)
    }
}
