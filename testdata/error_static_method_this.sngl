// A method declared outside its type with no parameter of the type is
// static, so its body has no `this`: the error says how to name the receiver.
// A generic type's method names its receiver's parameters in brackets, for
// its parameters and body to use, and is static on the same terms.

struct Tally {
    failures int
    round    int
}

func Tally.failing() => this.failures > this.round // ERROR(check) "undefined: this — Tally.failing takes no Tally, so it is static; to call it on a value, name the receiver as its first parameter: func Tally.failing(this Tally, …)"

struct Box[T any] {
    value T
}

func Box[T].get() => this.value // ERROR(check) "undefined: this — Box[T].get takes no Box[T], so it is static; to call it on a value, name the receiver as its first parameter: func Box[T].get(this Box[T], …)"

func Box[T].make(v T) => Box[T]{value=v}

func use() {
    var b = Box.make(1)
    var c = b.make(2) // ERROR(check) "Box.make is static: its first parameter is not Box, so call it as Box.make(…)"
}

struct Money {
    cents int
}

// A first parameter named `this` is the receiver only where it is of the
// type: this one is an int, so the method is static.
func Money.half(this int) => this / 2

func spend() {
    var m = Money{cents=10}
    var h = Money.half(10)
    var g = m.half() // ERROR(check) "Money.half is static: its first parameter is not Money, so call it as Money.half(…)"
}
