A write to state a canvas draws from redraws it, from a click and from a
window's `@error` alike.

Two gaps, one per path. passCanvasReactivity put a redraw in every node
handler and not in a boundary's own @error -- which every window override
wraps its content in -- so the window's handler moved the circle on gtk4 and
fyne and nothing repainted it. And on html neither redraw was ever written:
each document is a clone of the lowered tree, and a redraw kept naming the
canvas it was written against rather than the document's copy, so the
emitter found no canvas to call and wrote an empty statement.

deny out/none/html/index.html `state\.r = 2[05];\s*;` -- a write to r is followed by the redraw, not an empty statement
deny out/none/html/index.html `state\.r = 2[05];\s*\}\s*;` -- likewise inside the catch block

-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"

output {
    none {
        html
    }
    go {
        gtk4
        fyne
    }
}

var r = 5.0

ui.window(title="t", @error(e) { r = 20.0 }) {
    draw.canvas(width=50px, height=50px) {
        draw.circle(cx=25.0, cy=25.0, r=r)
    }
    ui.button(text="grow", @click { r = 25.0 })
    ui.button(text="boom", @click { error.raise("x", "boom") })
}
