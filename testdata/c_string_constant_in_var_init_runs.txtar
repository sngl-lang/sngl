A constant string a C function is handed is made once, as a package-level
declaration of the program's, and given back at teardown. A package var whose
initializer calls such a function reads it as the program starts, so the
constant is made before any initializer runs: it was made after them all, and
`strlen` read NULL.

exec out/c/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"

c.link(include="string.h", system=true)

#[c.native("strlen")]
func cLength(s string) int

c.link(include="stdio.h", system=true)

#[c.native("puts")]
func say(s string)

output {
    c { gtk4 }
}

func measured() int {
    return cLength("four")
}

var n = measured()

time.timer(interval=10ms, @tick {
    say("n {n}, again {measured()}")
    gtk4.quit()
})

ui.window(title="t") {
    ui.text(value="x")
}
-- said.txt --
n 4, again 4
-- out/c/gtk4/main.c --
