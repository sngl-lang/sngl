import . "sngl://std"

// radio: state-binding fixture — mutating the bound `value` var
// changes the selected radio option.
component main {
    var sel = "medium"
    radio(options=["small", "medium", "large"], value=sel, direction="horizontal")
}

func testRadioValueMutates(t Test, c main) {
    t.assert(c.sel == "medium")
    c.sel = "large"
    t.assert(c.sel == "large")
    c.sel = "small"
    t.assert(c.sel == "small")
}
