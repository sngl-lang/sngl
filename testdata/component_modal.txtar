package main

import "testing"

func TestModalOpenToggles(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.open == false)) { t.Errorf("assert failed: %s", "(c.open == false)") }
	c.open = true
	if !((c.open == true)) { t.Errorf("assert failed: %s", "(c.open == true)") }
	c.open = false
	if !((c.open == false)) { t.Errorf("assert failed: %s", "(c.open == false)") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
