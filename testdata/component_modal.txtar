-- component_modal.sngl --
import . "sngl:ui"
import . "sngl:test"

// modal: state-binding fixture — toggling the bound `open` var
// opens/closes the dialog.
component main node {
    var open = false
    modal(open=open, title="Hello", closable=true) {
        text(value="body")
    }
}

func testModalOpenToggles(t Test, c main) {
    t.assert(c.open == false)
    c.open = true
    t.assert(c.open == true)
    c.open = false
    t.assert(c.open == false)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}
