import . "sngl:ui"
import . "sngl:test"

component main {
    var x = 0

    func reset() { x = 0 }
    func bump() { x += 1 }

    button #inc(text="+", @click { bump() })
    button #zero(text="0", @click { reset() })
    text #out(value=string(x))
}

func testMutationThroughMethod(t Test, c main) {
    t.assert(c.out.value == "0")
    c.inc.click()
    c.inc.click()
    t.assert(c.out.value == "2")
    c.zero.click()
    t.assert(c.out.value == "0")
}
