A win32 program built for 32-bit Windows: the same C, and a manifest whose
`target` line has the build compile it with i686 MinGW, whose `int` and
pointers the runtime's casts hold to.

-- app.sngl --
import ui "sngl:ui"

output {
    c {
        win32(arch="386")
    }
}

component main ui.node {
    var n = 0
    var name = ""
    var on = false
    ui.vbox {
        ui.text(value="Count {n}")
        ui.button #inc(text="More", @click { n += 1 })
        ui.input #who(value=name, @change(v) { name = v })
        ui.checkbox #flag(checked=on, @change(v) { on = v })
        if n > 2 {
            ui.text(value="Big")
        }
        ui.hbox {
            ui.spacer()
        }
    }
}

ui.window(title="Counter") {
    main()
}
