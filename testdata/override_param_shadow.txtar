A platform override's parameter does not capture a name the call site's code
reads. android's checkbox is `onCheckedChange = func(on) { checked = on;
change(on) }`, and the call site's `@change { on = !on }` is spliced in for
the emit: with a component `var on` beside it, the Kotlin lambda's `on` was
the program's `on` too, so the handler negated the parameter. The inliner
renames such a parameter where it splices the call site's code into the body
(freshenShadowingParams), counted per name (`on__p0`) so the rename shifts no
other name in the program.

cmd/sngl/testdata/override_param_shadow_runs.txt runs it on all six.

deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `\{ on ->` -- the override's parameter is renamed where the program reads an `on`
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component main node {
    var on = false
    var v = "x"
    var seen = ""
    vbox {
        checkbox #box(@change { on = !on })
        input #field(@input { v = v + "!" })
        toggle #sw(@change(c) { seen = "{c} {on}" })
    }
}

func testShadow(t Test, c main) {
    c.box.change(true)
    t.assert(c.on == true)
    c.field.input("q")
    t.assert(c.v == "x!")
    c.sw.change(true)
    t.assert(c.seen == "true true")
}

window {
    main
}
