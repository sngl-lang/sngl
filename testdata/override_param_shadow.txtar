package main

import "testing"

func TestShadow(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.boxChange(true)
	if !((c.on == true)) { t.Errorf("assert failed: %s", "(c.on == true)") }
	c.fieldInput("q")
	if !((c.v__r0 == "x!")) { t.Errorf("assert failed: %s", "(c.v__r0 == \"x!\")") }
	c.swChange(true)
	if !((c.seen == "true true")) { t.Errorf("assert failed: %s", "(c.seen == \"true true\")") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
