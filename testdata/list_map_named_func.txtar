`xs.map(f)` with `f` a named function, on the Go targets, which withhold
listLambdas so NoListLambdas turns the call into an accumulator loop.

The loop called `f` through the callee expression, and the Go emitters spell
a package function named as an expression the way they spell a Model field:
`m.half(__item0)`, against a Model with no such method. Now a named function
is called by name.

deny * `m\.half\(` -- a package function is not a Model member
-- mapped.sngl --
import . "sngl:test"
import . "sngl:ui"

func half(x int) int {
    return x / 2
}

component main node {
    var mapped = 0
    effect(@mount {
        mapped = [4].map(half)[0]
    })
    text(value="{mapped}")
}

func testANamedFunctionIsMapped(t Test, c main) {
    t.assert(c.mapped == 2)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
}
