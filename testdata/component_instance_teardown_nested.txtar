A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_instance_teardown_nested.sngl --
// Dropping a row destroys the instances it holds before its own bracket
// ends: a component built at run time per row, holding another of itself.
// Not on bubbletea, which keeps no state inside a recursion and says so.

import . "sngl:test"
import . "sngl:ui"

component nest(tag string, depth int, note func(string)) node {
    var kids list[string] = depth > 0 ? [tag + "-"] : []
    effect(on=tag, @unmount { note(tag) })
    text(value="[{tag}]")
    for var k = kids {
        nest(tag=k, depth=depth - 1, note=note)
    }
}

component main node {
    var rows list[string] = ["a", "b"]
    var log = ""
    button #drop(text="drop", @click { rows = ["a"] })
    text(value="log={log}")
    for var r = rows {
        nest(tag=r, depth=1, note=func(s string) { log = log + s + ";" })
    }
}

func testWhatARowHoldsIsDestroyedFirst(t Test, c main) {
    t.assert(c.log == "")
    c.drop.click()
    t.assert(c.log == "b-;b;")
}

window {
    main
}

output {
    go {
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
