-- out/go/fyne/model_test.go --
package main

import "testing"

func TestWhatARowHoldsIsDestroyedFirst(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.log == "")) { t.Errorf("assert failed: %s", "(c.log == \"\")") }
	c.dropClick()
	if !((c.log == "b-;b;")) { t.Errorf("assert failed: %s", "(c.log == \"b-;b;\")") }
}

