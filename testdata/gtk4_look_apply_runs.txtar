What a widget's look sets on it besides its layout, in both languages, read
back through GTK: a child growing in a box pins the box's expand and gives
it back once it grows no more, a contents growing with its child; a box's
alignItems aligns its children across it, one added later too, and a
fixed-size child of a stretching box sits at the start; a label's and an
editable's text alignment, lines and wrapping, set and given back; a
contents shown only while a child of it is; a hidden widget, a cursor, a
size request set and given back, a CSS color, and a box's spacing. The
program prints each widget the window holds, shown or not, then changes
every look and prints them again.

exec out/c/gtk4 -- said.txt
exec out/go/gtk4 -- said.txt
-- app.sngl --
import c "sngl:x/c"
import go "sngl:language/go"
import gtk4 "sngl:platform/gtk4"
import time "sngl:time"
import ui "sngl:ui"

c.link(include="peek.h", pkgConfig=["gtk4"], sources=["peek.c", "peek.h"])

#[c.native("peek")]
func peek(n ui.window)

c.link(include="stdio.h", system=true)

#[c.native("puts")]
#[go.native("fmt", "fmt.Println")]
func say(s string)

output {
    c { gtk4 }
    go { gtk4 }
}

var (
    ticks = 0
    flip = false
    rows = [1]
)

time.timer(interval=100ms, @tick {
    ticks += 1
    if ticks == 3 {
        say("before")
        peek(main)
        flip = true
    }
    if ticks == 6 {
        say("after")
        peek(main)
        gtk4.quit()
    }
})

// Two nodes, an instance of which a loop makes at run time: a contents
// holds them.
component pair(show bool) ui.node {
    var mounted = 0
    ui.effect(@mount { mounted += 1 })
    if show {
        ui.text(value="one")
        ui.text(value="two")
    }
}

// A contents, one of whose children grows.
component growing(on bool) ui.node {
    var mounted = 0
    ui.effect(@mount { mounted += 1 })
    ui.vbox(style=on ? ui.Style{flex=1.0, height=10px} : ui.Style{height=10px}) {}
    ui.text(value="beside")
}

ui.window #main(title="t") {
    ui.vbox(style={gap=4px}) {
        ui.hbox(style={width=300px, height=10px}) {
            ui.vbox(style=flip ? ui.Style{height=10px} : ui.Style{flex=1.0, height=10px}) {}
            ui.vbox(style={width=20px, height=10px}) {}
        }
        ui.hbox(style={width=300px, height=10px}) {
            for var r = rows {
                growing(on=!flip)
            }
        }
        ui.hbox(style={height=40px, alignItems=flip ? ui.Alignment.unset : ui.Alignment.center}) {
            ui.vbox(style={width=10px}) {}
        }
        ui.vbox(style={width=100px, alignItems=ui.Alignment.end}) {
            ui.vbox(style={height=5px}) {}
            if flip {
                ui.vbox(style={height=6px}) {}
            }
        }
        ui.hbox(style={alignItems=ui.Alignment.baseline}) {
            ui.text(value="base")
        }
        ui.vbox(style={width=100px}) {
            ui.vbox(style=flip ? ui.Style{} : ui.Style{width=30px, height=5px}) {}
        }
        ui.text(value="centered", style=flip ? ui.Style{} : ui.Style{textAlign=ui.TextAlign.center, maxLines=2, whiteSpace=ui.WhiteSpace.nowrap})
        ui.text(value="right", style={textAlign=ui.TextAlign.right, whiteSpace=ui.WhiteSpace.preWrap})
        ui.text(value="justified", style={textAlign=ui.TextAlign.justify, whiteSpace=ui.WhiteSpace.normal})
        ui.input(value="typed", style={textAlign=flip ? ui.TextAlign.left : ui.TextAlign.right})
        ui.button(text="pressed", style={textAlign=ui.TextAlign.center})
        for var r = rows {
            pair(show=flip)
        }
        ui.text(value="gone", style={display=flip ? ui.Display.none : ui.Display.unset})
        ui.text(value="pointed", style=flip ? ui.Style{} : ui.Style{cursor="pointer", width=50px, height=20px})
        ui.text(value="red", style=flip ? ui.Style{} : ui.Style{color=#ff0000})
        ui.vbox(style={gap=flip ? 7px : 3px}) {
            ui.text(value="a")
            ui.text(value="b")
        }
    }
}
-- peek.c --
#include "peek.h"

#include <stdio.h>

static void walk(GtkWidget *w, int depth) {
    for (GtkWidget *c = gtk_widget_get_first_child(w); c != NULL; c = gtk_widget_get_next_sibling(c)) {
        int rw, rh;
        gtk_widget_get_size_request(c, &rw, &rh);
        printf("%*s%s shown=%d h=%d/%d/%d v=%d/%d/%d align=%d,%d req=%dx%d", depth * 2, "", G_OBJECT_TYPE_NAME(c),
               gtk_widget_get_visible(c),
               gtk_widget_get_hexpand(c), gtk_widget_get_hexpand_set(c), gtk_widget_compute_expand(c, GTK_ORIENTATION_HORIZONTAL),
               gtk_widget_get_vexpand(c), gtk_widget_get_vexpand_set(c), gtk_widget_compute_expand(c, GTK_ORIENTATION_VERTICAL),
               gtk_widget_get_halign(c), gtk_widget_get_valign(c), rw, rh);
        if (GTK_IS_BOX(c) && GTK_IS_BOX_LAYOUT(gtk_widget_get_layout_manager(c)))
            printf(" spacing=%d", gtk_box_get_spacing(GTK_BOX(c)));
        if (GTK_IS_LABEL(c)) {
            GtkLabel *l = GTK_LABEL(c);
            printf(" xalign=%.2f justify=%d wrap=%d lines=%d ellipsize=%d", gtk_label_get_xalign(l), gtk_label_get_justify(l),
                   gtk_label_get_wrap(l), gtk_label_get_lines(l), gtk_label_get_ellipsize(l));
            GdkRGBA rgba;
            gtk_widget_get_color(c, &rgba);
            printf(" color=%.2f,%.2f,%.2f", rgba.red, rgba.green, rgba.blue);
        }
        if (GTK_IS_EDITABLE(c) && !GTK_IS_TEXT(c))
            printf(" alignment=%.2f", gtk_editable_get_alignment(GTK_EDITABLE(c)));
        GdkCursor *cur = gtk_widget_get_cursor(c);
        if (cur) printf(" cursor=%s", gdk_cursor_get_name(cur));
        printf("\n");
        walk(c, depth + 1);
    }
}

void peek(GtkWidget *box) {
    walk(box, 0);
    fflush(stdout);
}
-- peek.h --
#include <gtk/gtk.h>

// Prints each widget the toplevel box holds, shown or not, and what its look
// set on it: its expand, alignment, size request and visibility, a box's
// spacing, a label's text layout, an editable's alignment and its cursor.
void peek(GtkWidget *box);
