A component built at run time emitting its own event from inside a container
a platform overrides, on every target.

`Card` is under a `for` and has state, so it survives inlining with its
`report(k)` inside the vbox it renders. passInlinePure substitutes html's,
fyne's and gtk4's `vbox` override into `Card`'s body, and substituted the
override's events after splicing its children in -- so it met `report(k)`,
the caller's emit, found no handler of the vbox's for it, and dropped it: the
effect mounted and reported nothing, and fyne named a mount method it never
emitted. The events are substituted before the slots are spliced now, so
content supplied at the call site is never asked about the override's events.

android declared no parameter for a user composable's event, so the emit
named an `onReport` nothing declared and the call site's handler was never
passed. bubbletea splices `Card` and is here because the program is its too.

deny out/none/html/index.html `function __effect0_mount\(\) \{\n    \}` -- the mount's body is the emit, not nothing
-- app.sngl --
import . "sngl:test"
import . "sngl:ui"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component Card(n int, @report(v int)) node {
    var hits = 0

    vbox {
        text(value="{n} {hits}")
        effect(on=n, @mount(k) { report(k) })
    }
}

component main node {
    var items = [1, 2]
    var total = 0

    vbox {
        for var i = items {
            Card(n=i, @report(k) { total = total + k })
        }
    }
}

func testEffectReportsThroughItsEvent(t Test, c main) {
    t.assert(c.total == 3)
}

window {
    main
}
