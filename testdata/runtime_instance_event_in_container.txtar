@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainScreen(state: MainScreenState = remember { MainScreenState() }) {

    Column(modifier = Modifier.safeDrawingPadding()) {
        for (i in state.items) {
            Card(n = i, onReport = { k ->
                state.total = (state.total + k)
            })
        }
    }
}

@Composable
fun Card(n: Int = 0, onReport: ((Int) -> Unit)? = null) {
    var hits by remember { mutableStateOf(0) }

