A component's method calling another through `this` makes the call a bare
call does: the instance is the one the call is made in, and no target hands
it as an argument.

deny * `add[_a-z0-9]*\(this` -- the receiver is never an argument

-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
}

component counter ui.node {
    var hits = 0

    func add(by int) {
        hits += by
    }

    func twice() {
        this.add(1)
        add(2)
    }

    ui.button #b(text="{hits}", @click {
        twice()
    })
}

ui.window {
    counter()
}
