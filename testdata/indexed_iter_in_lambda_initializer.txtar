A two-variable loop over a pull sequence, inside a lambda, inside an
initializer.

The same hole as `ternary_in_lambda_initializer.txtar` in the sibling pass.
`passIndexedIter` takes `walk.go`'s enumeration and made its `expr` hook a
no-op, so a lambda *body* in a const-context expression -- which is an ordinary
statement list -- was never walked. A `sngl:seq` sequence hands out no ordinal,
so the counter this pass binds is the whole of how `for var i, v = …` works
over one; without it the loop reached the Go emitter intact and came out as
`for i, v := range slices.Values([]int{0, 1, 2})`, which does not compile --
ranging over an `iter.Seq[V]` permits one iteration variable.

`passIndexedIter` is one of the five always-on passes precisely because it
answers for every target, so the position it could not see was not a target's
problem to catch.

deny out/go/bubbletea/model.go `for i, v := range` -- a pull sequence yields one value; the ordinal comes from the counter

-- app.sngl --
import . "sngl:ui"
import seq "sngl:seq"

output {
    go {
        bubbletea
    }
}

var totals list<int> = [1].map(func(n int) {
    var acc = 0
    for var i, v = seq.count(3) {
        acc = acc + i + v + n
    }
    return acc
})

window {
    text(value="{totals.length}")
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package main

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"os"
	"slices"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	totals []int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.totals = func() []int {
		__out := make([]int, len([]int{1}))
		for __i, __item := range []int{1} {
			__out[__i] = func(n int) int {
				var acc int = 0
				var __iterIdx0 int = -1
				for v := range slices.Values([]int{0, 1, 2}) {
					__iterIdx0 += 1
					acc = (((acc + __iterIdx0) + v) + n)
				}
				return acc
			}(__item)
		}
		return __out
	}()
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Totals() []int {
	return m.totals
}

func (m Model) SetTotals(v []int) Model {
	m.totals = v
	return m
}

type setTotalsMsg struct{ value []int }

func SetTotalsCmd(v []int) tea.Cmd {
	return func() tea.Msg { return setTotalsMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setTotalsMsg:
		m = m.SetTotals(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	content = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(len(m.totals))))
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
