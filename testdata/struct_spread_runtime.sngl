import . "sngl:ui"
import app "sngl:app"

// Runtime (opaque) struct spread: `...base` where base is a variable cannot be
// flattened at compile time, so flatten_struct_spread lowers it to a
// __merge_Cfg(...) call chain that each backend emits in its own idiom.
struct Cfg {
    a int = 0
    b int = 0
}

component main ui {
    var base Cfg = {a=1}
    var merged Cfg = {...base, b=2}
    text(value=string(merged.a) + "/" + string(merged.b))
}

app.window {
    main
}
