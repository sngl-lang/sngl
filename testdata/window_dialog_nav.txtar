A `nav.stack` in a window html shows as a `<dialog>` navigates in place: html's
own answer to a stack -- a document per page, a `go` that loads another --
belongs to the document's window, and a dialog has no address of its own. So
the dialog's stack is lowered as a desktop's is (passNavigation): the page
showing is state, a link is a button, and `back` at the bottom does nothing.

deny out/none/html/index.html `location\.assign|history\.back` -- the dialog's stack never touches the document's address
deny out/none/html/index.html `<a ` -- a link in a dialog is a button, as on a desktop

-- app.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    none {
        html
    }
}

ui.window #main(title="Main") {
    ui.button(text="Settings", @click {
        settings.open()
    })
}

ui.window #settings(title="Settings", visible=false) {
    nav.stack #tabs {
        nav.page #general(href="/", title="General") {
            ui.text(value="general")
        }
        nav.page #advanced(href="/advanced", title="Advanced") {
            ui.text(value="advanced")
            nav.link(to=general, text="General")
            ui.button(text="Back", @click {
                tabs.back()
            })
        }
    }
    ui.button(text="Advanced", @click {
        tabs.go(advanced)
    })
}
