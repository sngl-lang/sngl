	_ = cmd
	switch msg := msg.(type) {
	case setHeldMsg:
		m = m.SetHeld(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
