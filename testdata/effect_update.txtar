An effect's @update, lowered by passEffect.

Each write to what `on` reads sets the bracket's dirty flag, and the scope's
settle runs the handler once per pass, before any lifetime moves: a list key,
which does not compare and so holds no lifetime, gets no live list and no
down/up at all. A handler settles once where it ends, so `addTwo`'s two pushes
are one report, which is what the interpreter does by settling after the
handler rather than inside it.

deny out/go/bubbletea/model.go `m\.todos__inst0 = append[^\n]*\n\t*m\.__effect0_dirty = true\n\t*m\.__effects0_settle\(\)\n\t*m\.todos__inst0 = append` -- two writes in one handler are one settle, not a settle each
deny out/go/bubbletea/model.go `__effect0_live` -- a key that does not compare holds no lifetime to keep the keys of

-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
        fyne
    }
    none {
        html
    }
}

struct Todo {
    title string
}

component saver node {
    var (
        todos list<Todo> = []
        saved = 0
    )

    effect(
        on = todos,
        @update(t) {
            saved = t.length()
        },
    )

    func addTwo() {
        todos.push(Todo{title="a"})
        todos.push(Todo{title="b"})
    }

    button(text="add", @click {
        addTwo()
    })

    text(value="{saved}")
}

window {
    saver
}
