import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

// popover: state-binding fixture — toggling bound `open` shows
// or hides the popover panel.
component main ui {
    var visible = false
    popover(open=visible, position="bottom", openOn="click") {
        button(text="toggle")
    }
}

func testPopoverOpenToggles(t Test, c main) {
    t.assert(c.visible == false)
    c.visible = true
    t.assert(c.visible == true)
    c.visible = false
    t.assert(c.visible == false)
}

app.window {
    main
}
