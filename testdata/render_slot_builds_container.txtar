A render slot that builds a container names the fyne package, not its own
argument.

A fyne render slot's func took the container it renders into as `container`,
which is also the name of the fyne package every box is built from. A slot
whose content is itself a box -- here each row of the loop, and the
`sngl:ui/markup` list item the second loop renders -- called `NewHBox` on its
argument and did not build.

deny out/go/fyne/model.go `\(container \*fyne\.Container\)` -- the parameter shadows the package
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"
import md "sngl:ui/markup"

output {
    go {
        fyne
        gtk4
    }
}

component main node {
    var items = ["a"]

    vbox {
        for var it = items {
            hbox {
                text(value=it)
            }
        }
        md.list {
            for var it = items {
                md.listItem(task=md.Task.done) {
                    text(value=it)
                }
            }
        }
        button #more(text="more", @click { items.push("b") })
    }
}

func testMore(t Test, c main) {
    c.more.click()
    t.assert(c.items.length == 2)
}

window {
    main
}
