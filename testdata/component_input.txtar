data class SnglInputEvent(val value: String)

fun _snglFloatStr(v: Double): String =
    if (v.isFinite() && v == kotlin.math.floor(v) && kotlin.math.abs(v) < 9.007199254740992E15) v.toLong().toString() else v.toString()

fun _snglSplit(s: String, sep: String): List<String> =
    if (sep.isEmpty()) s.map { it.toString() } else s.split(sep)

class MainScreenState {
    var name by mutableStateOf("World")
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainScreen(state: MainScreenState = remember { MainScreenState() }) {

    Column(modifier = Modifier.safeDrawingPadding()) {
        OutlinedTextField(value = state.name, readOnly = false, modifier = Modifier, onValueChange = { newValue ->
            val e = SnglInputEvent(newValue)
            state.name = e.value
        }, label = {
            Text(text = "Enter your name", modifier = Modifier)
        })
        Text(text = (("Hello, " + state.name) + "!"), modifier = Modifier)
    }
}
