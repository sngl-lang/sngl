// Model holds the state for this SNGL UI.
type Model struct {
	name string

	__n2 *fyne.Container
	__n0 *widget.Entry
	__n1 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.name = "World"
	return m
}

func (m *Model) __n0_input_handler(s string) {
	m.name = s
	m.__n0.SetText(m.name)
	m.__n1.SetText((("Hello, " + m.name) + "!"))
}

func (m *Model) Name() string {
	return m.name
}

func (m *Model) SetName(v string) {
	m.name = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n2 = container.NewVBox()
	m.__n0 = widget.NewEntry()
	m.__n0.SetText(m.name)
	m.__n0.SetPlaceHolder("Enter your name")
	m.__n0.OnChanged = m.__n0_input_handler
	m.__n2.Add(m.__n0)
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText((("Hello, " + m.name) + "!"))
	m.__n2.Add(m.__n1)
	content := fyne.CanvasObject(m.__n2)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
