// Code generated by sngl (android) from component_input.sngl; DO NOT EDIT.

package test.sngl.app

import androidx.activity.ComponentActivity
import androidx.compose.ui.test.junit4.createAndroidComposeRule
import androidx.compose.ui.test.onNodeWithTag
import androidx.compose.ui.test.performClick
import androidx.compose.ui.test.performTextReplacement
import org.junit.Assert.assertTrue
import org.junit.Rule
import org.junit.Test
import org.junit.runner.RunWith
import org.robolectric.RobolectricTestRunner
import org.robolectric.annotation.Config
import org.robolectric.annotation.GraphicsMode

@RunWith(RobolectricTestRunner::class)
@Config(sdk = [33])
@GraphicsMode(GraphicsMode.Mode.NATIVE)
class MainScreenTest {
    @get:Rule val composeRule = createAndroidComposeRule<ComponentActivity>()

    @Test fun testInputValueMutates() {
        val c = MainScreenState()
        @Suppress("UNUSED_VARIABLE") val composeTestRule = composeRule
        composeRule.setContent { MainScreen(c) }
        org.junit.Assert.assertTrue("(c.name == \"World\")", (c.name == "World"))
        composeTestRule.runOnUiThread {
            c.name = "SNGL"
        }
        composeTestRule.waitForIdle()
        org.junit.Assert.assertTrue("(c.name == \"SNGL\")", (c.name == "SNGL"))
        composeTestRule.runOnUiThread {
            c.name = (c.name + "!")
        }
        composeTestRule.waitForIdle()
        org.junit.Assert.assertTrue("(c.name == \"SNGL!\")", (c.name == "SNGL!"))
    }

}
