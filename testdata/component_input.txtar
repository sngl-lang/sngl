A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_input.sngl --
import . "sngl:ui"
import . "sngl:test"

// input: two-way state-binding fixture — the `:value` binding wires a
// widget→state writeback handler in addition to the state→widget sync.
// Every native platform must compile that synthesized writeback (regression
// guard for the gtk4 `undefined: __value` build break and the fyne/android
// dead-handler bugs); mutating the bound var still propagates as usual.
component main node {
    var name = "World"

    vbox {
        input(:value=name, placeholder="Enter your name")
        text(value="Hello, {name}!")
    }
}

func testInputValueMutates(t Test, c main) {
    t.assert(c.name == "World")
    c.name = "SNGL"
    t.assert(c.name == "SNGL")
    c.name = c.name + "!"
    t.assert(c.name == "SNGL!")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
