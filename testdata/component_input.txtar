// Model holds the state and widget references for this SNGL UI.
type Model struct {
	name   string
	__n2   gtk4rt.Handle
	__n0   gtk4rt.Handle
	__n1   gtk4rt.Handle
	__root gtk4rt.Handle
}

// New creates a Model with default values. Binds initialize
// sequentially so later inits can reference earlier `m.<name>` fields.
func New() *Model {
	m := &Model{}
	m.name = "World"
	return m
}

func (m *Model) __n0_changed_handler() {
	m.name = gtk4rt.EditableGetText(m.__n0)
	gtk4rt.EditableSetText(m.__n0, m.name)
	gtk4rt.LabelSetText(m.__n1, (("Hello, " + m.name) + "!"))
}

func (m *Model) Name() string {
	return m.name
}

func (m *Model) SetName(v string) {
	m.name = v
}

func (m *Model) buildWidgetTree() {
	if m.__root != nil {
		return
	}
	m.__root = gtk4rt.BoxNew(gtk4rt.OrientationVertical, 6)
	m.__n2 = gtk4rt.BoxNew(gtk4rt.OrientationHorizontal, 0)
	gtk4rt.OrientableSetOrientation(m.__n2, gtk4rt.OrientationVertical)
	gtk4rt.BoxSetSpacing(m.__n2, 6)
	m.__n0 = gtk4rt.EntryNew()
	gtk4rt.EditableSetText(m.__n0, m.name)
	gtk4rt.Connect(m.__n0, "changed", m.__n0_changed_handler)
	gtk4rt.BoxAppend(m.__n2, m.__n0)
	m.__n1 = gtk4rt.LabelNew("")
	gtk4rt.LabelSetText(m.__n1, (("Hello, " + m.name) + "!"))
	gtk4rt.BoxAppend(m.__n2, m.__n1)
	gtk4rt.BoxAppend(m.__root, m.__n2)
}

// BuildUI constructs the widget tree and returns the top-level window.
func (m *Model) BuildUI(app gtk4rt.Handle) gtk4rt.Handle {
	m.buildWidgetTree()
	win := gtk4rt.ApplicationWindowNew(app)
	gtk4rt.WindowSetDefaultSize(win, 480, 640)
	gtk4rt.WindowSetChild(win, m.__root)
