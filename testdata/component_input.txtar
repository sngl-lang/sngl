package main

import "testing"

func TestInputValueMutates(t *testing.T) {
	__snglTestComponent := newTestComponent()
	c := __snglTestComponent
	_ = c
	if !((c.name == "World")) { t.Errorf("assert failed: %s", "(c.name == \"World\")") }
	c.name = "SNGL"
	if !((c.name == "SNGL")) { t.Errorf("assert failed: %s", "(c.name == \"SNGL\")") }
	c.name = (c.name + "!")
	if !((c.name == "SNGL!")) { t.Errorf("assert failed: %s", "(c.name == \"SNGL!\")") }
}


func newTestComponent() Model { return New() }
