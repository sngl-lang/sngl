// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	name      string
	__focusID int

	widget0 textinput.Model

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.name = "World"
	m.__focusID = 0
	m.widget0 = textinput.New()
	m.widget0.Placeholder = "Enter your name"
	m.widget0.SetValue(m.name)
	m.widget0.Focus()
	m.resizeWidgets()
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
	m.resizeWidgets()
}

// resizeWidgets sizes each bubbles widget to the current terminal extent.
func (m *Model) resizeWidgets() {
	m.widget0.SetWidth(tui.WidgetWidth(m.width))
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) Name() string {
	return m.name
}

func (m Model) SetName(v string) Model {
	m.name = v
	m.widget0.SetValue(m.name)
	return m
}

type setNameMsg struct{ value string }

func SetNameCmd(v string) tea.Cmd {
	return func() tea.Msg { return setNameMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return textinput.Blink
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setNameMsg:
		m = m.SetName(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
		m.resizeWidgets()
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
			if m.__focusID == 0 {
				m.widget0.Focus()
			} else {
				m.widget0.Blur()
			}
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
			if m.__focusID == 0 {
				m.widget0.Focus()
			} else {
				m.widget0.Blur()
			}
		}
	}
	if m.__focusID == 0 {
		m.widget0, cmd = m.widget0.Update(msg)
		cmds = append(cmds, cmd)
		m.name = m.widget0.Value()
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentChildren []string
	var content_0 string
	content_0 = m.widget0.View()
	contentChildren = append(contentChildren, content_0)
	var content_1 string
	content_1 = lipgloss.NewStyle().Render(fmt.Sprint((("Hello, " + m.name) + "!")))
	contentChildren = append(contentChildren, content_1)
	content = lipgloss.JoinVertical(lipgloss.Left, contentChildren...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func main() {
	p := tea.NewProgram(New())
	_, err := p.Run()
	if err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}
