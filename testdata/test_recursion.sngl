component main {
    // Tail-recursive factorial with accumulator
    func factorial(n int, acc int) int {
        return n <= 1 ? acc : factorial(n - 1, n * acc)
    }

    // Tail-recursive sum (safe from overflow at high depth)
    func sumTo(n int, acc int) int {
        return n <= 0 ? acc : sumTo(n - 1, acc + n)
    }

    // Non-tail recursive fibonacci
    func fib(n int) int {
        return n <= 1 ? n : fib(n - 1) + fib(n - 2)
    }

    // Tail-recursive GCD (block form)
    func gcd(a int, b int) int {
        return b == 0 ? a : gcd(b, a % b)
    }

    text(value="placeholder")
}

func testTailRecursiveFactorial(t Test, c main) {
    t.assert(c.factorial(1, 1) == 1)
    t.assert(c.factorial(5, 1) == 120)
    t.assert(c.factorial(10, 1) == 3628800)
}

func testTailRecursiveSumProvesTco(t Test, c main) {
    t.assert(c.sumTo(0, 0) == 0)
    t.assert(c.sumTo(10, 0) == 55)
    // Depth > 100: would overflow stack without TCO
    t.assert(c.sumTo(200, 0) == 20100)
    t.assert(c.sumTo(1000, 0) == 500500)
}

func testRecursiveFibonacci(t Test, c main) {
    t.assert(c.fib(0) == 0)
    t.assert(c.fib(1) == 1)
    t.assert(c.fib(10) == 55)
}

func testRecursiveGcdBlockForm(t Test, c main) {
    t.assert(c.gcd(12, 8) == 4)
    t.assert(c.gcd(100, 75) == 25)
    t.assert(c.gcd(17, 13) == 1)
    // Depth > 100: proves TCO works for block form
    t.assert(c.gcd(10946, 6765) == 1)
}
