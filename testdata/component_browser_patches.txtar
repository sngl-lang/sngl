A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_browser_patches.sngl --
// What a page shows once a write has been patched into it, read in the
// browser: each case writes state through an event and reads the element
// that renders it, not the state, since the patch is what is under test.

import "sngl:test/browser"
import . "sngl:test"
import . "sngl:ui"

component picker node {
    var fruit = "apple"
    text #shown(value="picked: {fruit}")
    select #s(:value=fruit) {
        choice(label="apple")
        choice(label="banana")
        choice(label="cherry")
    }
}

func testASelectChangeReachesTheSpan(t Test, c picker) {
    t.assert(browser.text(c.shown) == "picked: apple")
    c.s.change("banana")
    t.assert(c.fruit == "banana")
    t.assert(browser.text(c.shown) == "picked: banana")
    t.assert(browser.text(c.s) == "banana")
}

func run(f func()) int {
    f()
    return 7
}

// A write inside a callback the handler hands on updates what reads it.
component callback node {
    var n = 0
    var handle = 0
    button #go(text="go", @click {
        handle = run(func() {
            n = n + 1
        })
    })
    text #out(value="n={n}")
}

func testAWriteInsideACallbackIsPatched(t Test, c callback) {
    c.go.click()
    t.assert(browser.text(c.out) == "n=1")
}

var base = 3

func doubled() => base * 2

func blocky() int {
    var x = base + 1
    return x * 3
}

// A computed is called under the name it is declared with.
component computed node {
    vbox {
        text #expr(value="expr={doubled()}")
        text #block(value="block={blocky()}")
    }
}

func testComputedsRender(t Test, c computed) {
    t.assert(browser.text(c.expr) == "expr=6")
    t.assert(browser.text(c.block) == "block=12")
}

// A narrowed option is a number in each branch that narrows it.
component narrowed node {
    var maybe option[int] = 3
    vbox #out {
        if maybe != null {
            text(value="[{maybe * 2}]")
        }
        if maybe == null {
            text(value="[none]")
        } else {
            text(value="[{maybe + 1}]")
        }
    }
    button #clear(text="clear", @click { maybe = null })
    button #set(text="set", @click { maybe = 21 })
}

func testANarrowedOptionIsArithmetic(t Test, c narrowed) {
    t.assert(browser.text(c.out) == "[6]\n[4]")
    c.clear.click()
    t.assert(browser.text(c.out) == "[none]")
    c.set.click()
    t.assert(browser.text(c.out) == "[42]\n[22]")
}

component toggled(body option[component]) node {
    var on = false
    button #t(text="toggle", @click { on = !on })
    vbox #box {
        if on {
            body {}
        }
    }
}

component scoped(ready option[component(int)]) node {
    var n = 0
    button #b(text="bump", @click { n = n + 1 })
    vbox #box {
        if n > 0 {
            ready(n) {}
        }
    }
}

// A named slot inside a reactive `if` renders with the branch, and a scoped one
// is handed its argument on each render.
component slots node {
    toggled #q {
        component body {
            text(value="SUPPLIED")
        }
    }
    scoped #r {
        component ready(v) {
            text(value="N={v}")
        }
    }
}

func testANamedSlotFollowsItsBranch(t Test, c slots) {
    t.assert(browser.text(c.q.box) == "")
    c.q.t.click()
    t.assert(browser.text(c.q.box) == "SUPPLIED")
    c.q.t.click()
    t.assert(browser.text(c.q.box) == "")
}

func testAScopedSlotIsHandedItsArgument(t Test, c slots) {
    c.r.b.click()
    t.assert(browser.text(c.r.box) == "N=1")
    c.r.b.click()
    t.assert(browser.text(c.r.box) == "N=2")
}

// Two branches of one stack: each render shows exactly one.
component carousel node {
    var a = 0
    button #next(text="next", @click { a = (a + 1) % 2 })
    stack #s {
        if a == 0 {
            text(value="ZERO")
        }
        if a == 1 {
            text(value="ONE")
        }
    }
}

func testACarouselShowsOneAtATime(t Test, c carousel) {
    t.assert(browser.text(c.s) == "ZERO")
    c.next.click()
    t.assert(browser.text(c.s) == "ONE")
    c.next.click()
    t.assert(browser.text(c.s) == "ZERO")
}

// An `if` at the root of a window's body.
component app root {
    var on = true
    window {
        button #t(text="t", @click { on = !on })
        if on {
            text #shown(value="SHOWN")
        }
    }
}

func testAnIfAtAWindowsRootFollowsItsState(t Test, c app) {
    t.assert(c.shown != null)
    if c.shown != null {
        t.assert(browser.text(c.shown) == "SHOWN")
    }
    c.t.click()
    t.assert(c.on == false)
    t.assert(c.shown == null)
}

window {
    picker
    callback
    computed
    narrowed
    slots
    carousel
}

app()

output {
    none {
        html
    }
}
