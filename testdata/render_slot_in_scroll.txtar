package main

import "testing"

func TestFlip(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.flipClick()
	c.flipClick()
	if !(c.on) { t.Errorf("assert failed: %s", "c.on") }
}

-- out/go/fyne/testcomponent_test.go --
package main

import "fyne.io/fyne/v2/test"

func newTestComponent() *Model {
	test.NewApp()
	return &Model{}
}

func mountTestComponent(m *Model, preset map[string]bool) *Model {
	m.__init(preset)
	m.BuildUI()
	return m
}
