package main

import "testing"

func TestFlip(t *testing.T) {
	__snglTestComponent := newTestComponent()
	c := __snglTestComponent
	_ = c
	c.flipClick()
	c.flipClick()
	if !(c.on) { t.Errorf("assert failed: %s", "c.on") }
}

