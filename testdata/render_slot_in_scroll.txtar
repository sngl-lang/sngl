A render slot directly inside a scroll renders into a box the scroll holds.

A render slot adds and removes any number of entries, and a scroll holds one
child. fyne passed the *container.Scroll to a slot func taking a
*fyne.Container and did not build; gtk4 handed the GtkScrolledWindow to
gtk_box_append and rendered nothing, with a CRITICAL per call. Each now keeps
a box as the scroll's child, made on the slot's first render and reused, and
renders the slot into it. A gtk4 container holding several children through a
call of its own -- a GtkStack -- is refused by name rather than handed to
gtk_box_append (cmd/sngl/testdata/render_slot_container_runs.txt).

deny out/go/fyne/model.go `__renderSlot\d+\(m\.__n1\)` -- the scroll is not the slot's container
deny out/go/gtk4/model.go `__renderSlot\d+\(m\.__n1\)` -- as above, for the scrolled window
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
        gtk4
    }
}

component main node {
    var on = true

    vbox {
        scroll {
            if on {
                text(value="on")
            }
        }
        button #flip(text="flip", @click { on = !on })
    }
}

func testFlip(t Test, c main) {
    c.flip.click()
    c.flip.click()
    t.assert(c.on)
}

window {
    main
}
