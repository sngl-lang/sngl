-- out/go/fyne/model_test.go --
package main

import "testing"

func TestAPageWithNoTitleOfIsItsTitle(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((c.pages__current.Title == "Home")) { t.Errorf("assert failed: %s", "(c.pages__current.Title == \"Home\")") }
}

func TestTheTitleIsOfTheParamsShowing(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.toFirstClick()
	if !((c.pages__current.Title == "Item first")) { t.Errorf("assert failed: %s", "(c.pages__current.Title == \"Item first\")") }
	c.toSecondClick()
	if !((c.pages__current.Title == "Item second")) { t.Errorf("assert failed: %s", "(c.pages__current.Title == \"Item second\")") }
	c.backClick()
	if !((c.pages__current.Title == "Item first")) { t.Errorf("assert failed: %s", "(c.pages__current.Title == \"Item first\")") }
	c.backClick()
	if !((c.pages__current.Title == "Home")) { t.Errorf("assert failed: %s", "(c.pages__current.Title == \"Home\")") }
}

func TestThePageItselfIsItsTitle(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.toSecondClick()
	if !(true) { t.Errorf("assert failed: %s", "true") }
}

