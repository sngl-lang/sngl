A loop of components on win32. A keyed `for` keeps each copy as a component
built at run time, which placement writes as a record in plain IR, so C
writes it as any program's struct and functions: `__child0__inst`, a box
held by pointer, holds the row's prop cells and its button; `__child0__new`
builds the body into it and sets its root; each setter takes it first and
reads the row through it. The loop's render calls the constructor for a new
key and the setters for one it keeps, and the closure the button is handed
captures the record's cell, as it captured the var.

-- app.sngl --
import ui "sngl:ui"

output {
    c {
        win32
    }
}

var names = ["ann", "bob", "cy"]
var picked = ""

ui.window {
    ui.vbox {
        for var name = names {
            ui.button(text=name, @click { picked = name })
        }
        ui.text(value=picked)
    }
}
-- out/c/win32/main.c --
