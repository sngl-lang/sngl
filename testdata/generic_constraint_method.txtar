A generic function whose constraint names a format calls the bound type's
own: `"{v}"` with v a T is the int's format at an int and Point's at a Point,
and `"{vs}"` with vs a list[T] forwards to them as well. The block-bodied
functions are not inlined, so each is copied per binding (`render__int`,
`render__Point`), and its calls through the constraint are the bound type's
own. The tests run on every target, the interpreter included
(testdata/generic_constraint_method.sngl).

-- generic_constraint_method.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}

struct Point {
    x int = 0
    y int = 0

    const func format() => "({x}, {y})"
}

func render[T methodsOf[struct {
    const func format() string
}]](label string, vs list[T]) string {
    var out = "{label}:"
    for var v = vs {
        out = out + " <{v}>"
    }
    return out + " [{vs}]"
}

func hex[T methodsOf[struct {
    const func format(base int) string
}]](v T) string {
    var s = v.format(16)
    return s
}

component shown node {
    var ns = [1, 2]
    var ps = [Point{x=1, y=2}]
    text #ints(value=render("n", ns))
    text #points(value=render("p", ps))
    text #hexed(value=hex(ns[0] + 254))
    button #grow(text="grow", @click {
        ns.push(3)
        ps.push(Point{y=4})
    })
}

func testShown(t Test, c shown) {
    t.assert(c.ints.value == "n: <1> <2> [1, 2]")
    t.assert(c.points.value == "p: <(1, 2)> [(1, 2)]")
    t.assert(c.hexed.value == "ff")
    c.grow.click()
    t.assert(c.ints.value == "n: <1> <2> <3> [1, 2, 3]")
    t.assert(c.points.value == "p: <(1, 2)> <(0, 4)> [(1, 2), (0, 4)]")
}

window {
    shown()
}
