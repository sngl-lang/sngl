package main

import "testing"

func TestShown(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !((Render__int("n", c.ns) == "n: <1> <2> [1, 2]")) { t.Errorf("assert failed: %s", "(Render__int(\"n\", c.ns) == \"n: <1> <2> [1, 2]\")") }
	if !((Render__Point("p", c.ps) == "p: <(1, 2)> [(1, 2)]")) { t.Errorf("assert failed: %s", "(Render__Point(\"p\", c.ps) == \"p: <(1, 2)> [(1, 2)]\")") }
	if !((Hex__int((c.ns[0] + 254)) == "ff")) { t.Errorf("assert failed: %s", "(Hex__int((c.ns[0] + 254)) == \"ff\")") }
	c.growClick()
	if !((Render__int("n", c.ns) == "n: <1> <2> <3> [1, 2, 3]")) { t.Errorf("assert failed: %s", "(Render__int(\"n\", c.ns) == \"n: <1> <2> <3> [1, 2, 3]\")") }
	if !((Render__Point("p", c.ps) == "p: <(1, 2)> <(0, 4)> [(1, 2), (0, 4)]")) { t.Errorf("assert failed: %s", "(Render__Point(\"p\", c.ps) == \"p: <(1, 2)> <(0, 4)> [(1, 2), (0, 4)]\")") }
}

