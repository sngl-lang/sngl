An owned value a statement may not make is released all the same, on a
target with ternaries and on one without: a ternary's or a match
expression's arm that allocates becomes an assignment to a local under an
`if` ahead of the statement, the right of `&&` or `||` likewise, and a
condition `for`'s head a function called per iteration whose `return`
releases what it made. An iterable head is bound before the loop and
released after it, and before a `return` that leaves the loop. A temp bound
before a later one raises is released by a catch block around that binding.
Nothing here is constant, so nothing folds and the application lifetime
holds none of it.

deny * `__arm[0-9]* = .*\?` -- a lifted arm is a statement, not a ternary assigned to the local
deny out/go/bubbletea/model.go `defer m\.close` -- a release is a statement, never deferred

-- app.sngl --
import ui "sngl:ui"
import macro "sngl:macro"
import go "sngl:language/go"
import kotlin "sngl:language/kotlin"

output {
    go {
        bubbletea
    }
    kotlin {
        android
    }
}

#[macro.owned(close)]
struct file {
    fd int
}

var opened = 0
var closed = 0

func close(f file) {
    closed += 1
}

func open(fd int) file {
    opened += 1
    return file{fd=fd}
}

func opener(fd int) file {
    if fd == 0 {
        error.raise("empty", "")
    }
    return open(fd)
}

func size(f file) => f.fd * 10

func openAll(fd int) list[file] {
    return [open(fd), open(fd + 1)]
}

func firstOf(fd int) int {
    for var f = openAll(fd) {
        return f.fd
    }
    return 0
}

var on = true
var n = 3
var v = 0
var problem = ""

ui.window(title="t") {
    ui.boundary(@error(e) {
        problem = e.message
    }) {
        ui.button #arm(text="{v}", @click {
            v = on ? size(open(1)) : 0
        })
        ui.button #match(text="{v}", @click {
            v = match n {
                3 => size(open(n))
                else => 0
            }
        })
        ui.button #and(text="{v}", @click {
            on = on && size(open(4)) == 40
        })
        ui.button #or(text="{v}", @click {
            on = on || size(open(6)) == 60
        })
        ui.button #head(text="{v}", @click {
            for size(open(n)) > 0 {
                n -= 1
            }
        })
        ui.button #walk(text="{v}", @click {
            v = firstOf(12)
        })
        ui.button #later(text="{problem}", @click {
            v = size(open(9)) + size(opener(0))
        })
    }
}
