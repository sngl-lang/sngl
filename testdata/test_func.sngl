test main "pure expression functions" {
    assert(add(2, 3) == 5)
    assert(add(0, 0) == 0)
    assert(add(-1, 1) == 0)
    assert(double(5) == 10)
    assert(double(0) == 0)
    assert(greet("World") == "Hello, World!")
}

test main "component methods" {
    assert(square(4) == 16)
    assert(square(0) == 0)
    assert(label() == "Count: 10")
}

test main "block functions" {
    assert(clamp(5, 0, 10) == 5)
    assert(clamp(-5, 0, 10) == 0)
    assert(clamp(15, 0, 10) == 10)
    assert(clamp(0, 0, 10) == 0)
    assert(clamp(10, 0, 10) == 10)
}

test main "void action functions" {
    assert(count == 10)
    reset()
    assert(count == 0)
    increment(5)
    assert(count == 5)
    increment(3)
    assert(count == 8)
}

component main {
    var count = 10

    func add(a int, b int) => a + b
    func double(x int) => x * 2
    func greet(name string) => "Hello, {name}!"
    func square(n int) => n * n
    func label() => "Count: {count}"
    func clamp(val int, lo int, hi int) int {
        var clamped = val < lo ? lo : val
        var result = clamped > hi ? hi : clamped
        return result
    }
    func reset() {
        count = 0
    }
    func increment(n int) {
        count += n
    }

    text(value=label())
}
