func testPureExpressionFunctions(t T, c main) {
    t.assert(c.add(2, 3) == 5)
    t.assert(c.add(0, 0) == 0)
    t.assert(c.add(-1, 1) == 0)
    t.assert(c.double(5) == 10)
    t.assert(c.double(0) == 0)
    t.assert(c.greet("World") == "Hello, World!")
}

func testComponentMethods(t T, c main) {
    t.assert(c.square(4) == 16)
    t.assert(c.square(0) == 0)
    t.assert(c.label() == "Count: 10")
}

func testBlockFunctions(t T, c main) {
    t.assert(c.clamp(5, 0, 10) == 5)
    t.assert(c.clamp(-5, 0, 10) == 0)
    t.assert(c.clamp(15, 0, 10) == 10)
    t.assert(c.clamp(0, 0, 10) == 0)
    t.assert(c.clamp(10, 0, 10) == 10)
}

func testVoidActionFunctions(t T, c main) {
    t.assert(c.count == 10)
    c.reset()
    t.assert(c.count == 0)
    c.increment(5)
    t.assert(c.count == 5)
    c.increment(3)
    t.assert(c.count == 8)
}

component main {
    var count = 10

    func add(a int, b int) => a + b
    func double(x int) => x * 2
    func greet(name string) => "Hello, {name}!"
    func square(n int) => n * n
    func label() => "Count: {count}"
    func clamp(val int, lo int, hi int) int {
        var clamped = val < lo ? lo : val
        var result = clamped > hi ? hi : clamped
        return result
    }
    func reset() {
        count = 0
    }
    func increment(n int) {
        count += n
    }

    text(value=label())
}
