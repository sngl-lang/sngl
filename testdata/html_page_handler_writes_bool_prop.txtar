Every page's handlers write a boolean prop through its DOM property. Each
html document is a clone of the window holding one page, and the generator
used to cache the element map it built for the first document and hand it to
every later one: there the node a handler patched was unknown, the write fell
through to `setAttribute("hidden", false)` -- an attribute present is an
element hidden -- and the docs site's search box showed no results on any
page but the first.

deny * `setAttribute\("hidden"` -- a boolean attribute is written as a property on every page, not only the first

-- site.sngl --
import ui "sngl:ui"
import nav "sngl:ui/nav"
import "sngl:platform/html"

output {
    none {
        html
    }
}

component Search() ui.node {
    var typed = ""

    html.div {
        html.input(type="search", @input(e) { typed = e.value })
        html.div(hidden=typed == "") {
            html.span(innerText=typed)
        }
    }
}

ui.window(title=pages.current.title) {
    nav.stack #pages {
        nav.page(href="/index.html", title="Home") {
            Search()
            ui.text(value="home")
        }
        nav.page(href="/a.html", title="A") {
            Search()
            ui.text(value="a")
        }
    }
}
