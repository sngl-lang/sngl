import . "sngl://std"
import "sngl://i18n"

// String-keyed selection.
component i18nSelect {
    var gender = "female"
    var pronoun = $"{gender, select,
        male{he}
        female{she}
        other{they}
    }"

    // Select with surrounding text.
    var status = "online"
    var indicator = $"User is {status, select,
        online{available now}
        away{idle}
        other{offline}
    }"

    text(value=pronoun)
}

func testSelectFemale(t Test, c i18nSelect) {
    t.setLocale("en")
    t.assert(c.pronoun == "she")
    t.assert(c.indicator == "User is available now")
}
