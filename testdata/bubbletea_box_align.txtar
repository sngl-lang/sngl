A box's `alignItems` reaches bubbletea, which joined every column at its left
and every row at its top whatever the style said, so a card's names sat at
its left.

- A column centered or at its end is `tui.ColumnAt`, each part placed across
  the widest; a box with a width also places the joined parts in it
  (`AlignHorizontal`), so the names sit in the middle of the card.
- A row is `tui.RowAt` down the tallest part (`AlignVertical`), and a row
  with a flexing part `tui.FlexRowAt`.
- A member read at run time, a Style held as a value among them, is looked
  up when the box draws; `stretch` and `start` are the plain join.

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

ui.window {
    var at = ui.Alignment.center
    var held = ui.Style{alignItems=end}
    ui.vbox(style={gap=16px}) {
        ui.vbox(style={alignItems=center, width=112px}) {
            ui.text(value="a name")
            ui.text(value="#1")
        }
        ui.hbox(style={alignItems=center, gap=8px}) {
            ui.vbox {
                ui.text(value="one")
                ui.text(value="two")
            }
            ui.text(value="beside")
        }
        ui.hbox(style={alignItems=end}) {
            ui.text(value="grows", style={flex=1})
            ui.vbox {
                ui.text(value="three")
                ui.text(value="four")
            }
        }
        ui.vbox(style={alignItems=at}) {
            ui.text(value="read")
            ui.text(value="at run time")
        }
        ui.vbox(style=held) {
            ui.text(value="held")
            ui.text(value="as a value")
        }
        ui.vbox(style={alignItems=stretch}) {
            ui.text(value="plain")
        }
        ui.button(text="move", @click {
            at = ui.Alignment.end
        })
    }
}
