A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_timer_schedules.sngl --
// A timer's schedule in a real browser, waited on in real time: html only,
// because t.wait is answered by the interpreter, on a clock it owns, and by
// html, and by no other compiled target yet.

import . "sngl:test"
import "sngl:time"
import . "sngl:ui"

component beat(label = "") node {
    var beats = 0
    time.timer(interval=20ms, enabled=true, @tick { beats += 1 })
    text(value="{label}={beats}")
}

// The root component's timer and one in a component it renders both fire.
component nested node {
    var seconds = 0
    time.timer(interval=20ms, enabled=true, @tick { seconds += 1 })
    beat #child(label="child")
    text(value="root={seconds}")
}

func testBothTimersFire(t Test, c nested) {
    t.wait(func() => c.seconds > 0 && c.child.beats > 0, 5000)
    t.assert(c.seconds > 0)
    t.assert(c.child.beats > 0)
}

// A branch is the gate: nothing fires before it appears or after it goes.
component gated node {
    var shown = false
    var n = 0
    button #toggle(text="toggle", @click { shown = !shown })
    if shown {
        time.timer(interval=20ms, enabled=true, @tick { n += 1 })
    }
    text(value="n={n}")
}

func testABranchIsTheGate(t Test, c gated) {
    t.wait(func() => false, 200)
    t.assert(c.n == 0)
    c.toggle.click()
    t.wait(func() => c.n > 0, 5000)
    t.assert(c.n > 0)
    c.toggle.click()
    var stopped = c.n
    t.wait(func() => false, 200)
    t.assert(c.n == stopped)
}

// A loop of timers keeps one schedule per copy, each at its own period.
component row node {
    var fast = 0
    var slow = 0
    var periods list[time.duration] = [20ms, 500ms]
    for var p = periods {
        time.timer(interval=p, enabled=true, @tick {
            if p == 20ms {
                fast += 1
            } else {
                slow += 1
            }
        })
    }
    text(value="fast={fast} slow={slow}")
}

func testARowKeepsOneScheduleEach(t Test, c row) {
    t.wait(func() => c.slow >= 2 && c.fast > c.slow * 5, 5000)
    t.assert(c.slow >= 2)
    t.assert(c.fast > c.slow * 5)
}

window {
    nested
    gated
    row
}

output {
    none {
        html
    }
}
