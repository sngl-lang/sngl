A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_checkbox.sngl --
import . "sngl:ui"
import . "sngl:test"

// checkbox: state-binding fixture — toggling the bound `checked`
// var propagates to the checkbox.
component main node {
    var on = false
    checkbox(:checked=on, label="Enable")
}

func testCheckboxToggles(t Test, c main) {
    t.assert(c.on == false)
    c.on = true
    t.assert(c.on == true)
    c.on = false
    t.assert(c.on == false)
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
