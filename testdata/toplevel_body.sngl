// A program's top level is a slot for the root tree, and a window is that
// tree's renderable member — so what a program writes there is the window it
// opens at, with the package's own vars as the state its body reads. The
// package is a state owner like the other two (ir.Owners), and passRootWindow
// lifts the window onto pkg.Windows so nothing downstream needs a third shape.
//
// A `node` written here is an error: it belongs to a family the package
// body does not accept. See error_toplevel_ui_node.sngl.

import . "sngl:ui"

var count = 0

var label = "clicks"

window {
    vbox {
        text(value="{label}: {count}")
        button #inc(text="+", @click { count = count + 1 })
    }
}
