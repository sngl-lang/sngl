type Model struct {
	n         int
	i         int
	total     int
	__focusID int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.n = 6
	m.i = 0
	m.total = 0
	m.__focusID = 0
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m *Model) __focusNext() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m *Model) __focusPrev() {
	if m.__focusID == 0 {
		m.__focusID = 0
	}
}

func (m Model) N() int {
	return m.n
}

func (m Model) SetN(v int) Model {
	m.n = v
	return m
}

type setNMsg struct{ value int }

func SetNCmd(v int) tea.Cmd {
	return func() tea.Msg { return setNMsg{value: v} }
}

func (m Model) I() int {
	return m.i
}

func (m Model) SetI(v int) Model {
	m.i = v
	return m
}

type setIMsg struct{ value int }

func SetICmd(v int) tea.Cmd {
	return func() tea.Msg { return setIMsg{value: v} }
}

func (m Model) Total() int {
	return m.total
}

func (m Model) SetTotal(v int) Model {
	m.total = v
	return m
}

type setTotalMsg struct{ value int }

func SetTotalCmd(v int) tea.Cmd {
	return func() tea.Msg { return setTotalMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setNMsg:
		m = m.SetN(msg.value)
	case setIMsg:
		m = m.SetI(msg.value)
	case setTotalMsg:
		m = m.SetTotal(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		case msg.Code == tea.KeyTab && msg.Mod == 0:
			m.__focusNext()
		case msg.Code == tea.KeyTab && msg.Mod == tea.ModShift:
			m.__focusPrev()
		case msg.Code == tea.KeyEnter && m.__focusID == 0:
			for m.i < m.n {
				m.i = (m.i + 1)
				if (m.i % 2) == 0 {
					continue
				}
				m.total = (m.total + m.i)
			}
			for {
				if m.total > 100 {
					break
				}
				m.total = (m.total + m.total)
			}
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var parts []string
	var part0 string
	part0Focused := (m.__focusID == 0)
	part0Prefix := " "
	if part0Focused {
		part0Prefix = ">"
	}
	part0 = lipgloss.NewStyle().Render(part0Prefix + " " + fmt.Sprint("run"))
	parts = append(parts, part0)
	var part1 string
	part1 = lipgloss.NewStyle().Render(fmt.Sprint(fmt.Sprint(m.total)))
	parts = append(parts, part1)
	content := lipgloss.JoinVertical(lipgloss.Left, parts...)
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
