The two loop forms that walk nothing, and the two escapes, in each host
language. Go has a bare `for`, so both forms are one -- the condition goes in
the head, and no head at all is `for {`. Kotlin's `for` takes an iterable, so
both are a `while`, as they are in JS. `break` and `continue` are spelled the
same in all three, which is why no language carries a hook for them.

deny out/go/bubbletea/model.go `range` -- there is no iterable in this program, so a range clause could only be a sequence the codegen invented

-- app.sngl --
import . "sngl:ui"

output {
    go {
        bubbletea
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component main node {
    var n = 6
    var i = 0
    var total = 0

    button(text="run", @click {
        for i < n {
            i = i + 1
            if i % 2 == 0 {
                continue
            }
            total = total + i
        }
        for {
            if total > 100 {
                break
            }
            total = total + total
        }
    })
    text(value=string(total))
}

window {
    main
}
