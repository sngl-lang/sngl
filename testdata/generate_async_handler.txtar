
An @click handler that calls an async native must be wrapped in an async
function, so the generated addEventListener takes an `async function` and the
state assignment inside it awaits fetchHello.
-- app.sngl --
import . "sngl:ui"
import api "js:./api"

output {
    none {
        html
    }
}

component main node {
    var greeting = ""
    button(text="Go", @click {
        greeting = api.fetchHello("world")
    })
    text(value=greeting)
}

window {
    main
}
-- api/index.ts --
export async function fetchHello(name: string): Promise<string> { return "Hello " + name; }
