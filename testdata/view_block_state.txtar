A `var` written in a block of a view is state of that block, on every
target, as a component's `var` is state of the component.

Rendered once -- the window's top level, the vbox `opened` is written in --
the block's vars join the block's owner under their own names, which is what
a window's top-level `var` always did: `opened` is package state here, beside
`visits`. Where a name is taken the later one is renamed. Under a `for`, an
`if` over state and a page, the block is an instance of a component
synthesized for it, `__block_state<N>`, and the inliner does with it what it
does with any component with state: one per copy under the loop, built again
when the branch or the page comes back. What the block reads of the loop
(`it`) arrives as a prop, and what it reads of its owner's state (`total`)
as a two-way prop bound to it, so a write in the copy is a write of the
owner's.

deny * `var n int = 0` -- a block's var is never a local of a render function
-- app.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        gtk4
        fyne
        bubbletea
    }
    kotlin {
        android
    }
}

const items list[string] = ["a", "b"]

component rows ui.node {
    var total = 0
    for var it = items {
        ui.hbox {
            var n = 0
            ui.button(text=it, @click {
                n += 1
                total += 1
            })
            ui.text(value="{it} {n}")
        }
    }
    ui.text(value="total {total}")
}

ui.window(title=pages.current.title) {
    var visits = 0

    ui.vbox {
        var opened = 0
        ui.button(text="open", @click { opened += 1 })
        ui.text(value="opened {opened} visits {visits}")
        rows
        nav.stack #pages {
            nav.page #home(href="/", title="Home") {
                var hits = 0
                ui.button(text="hit", @click {
                    hits += 1
                    visits += 1
                })
                ui.text(value="hits {hits}")
            }
            nav.page #about(href="/about", title="About") {
                ui.text(value="about")
            }
        }
        ui.button(text="about", @click { pages.go(about) })
    }
}
