Regression test for #35: the widget fields of a sub-component have to be
declared on the Model struct. NoInlineComponents inlines detailPanel into
main rather than emitting a render method for it, so its four text() nodes
are main's own labels (__n0..__n3, under the inlined vbox __n6) and its prop
references are substituted with the callsite argument, m.current.

deny out/go/fyne/model.go `renderDetailPanel` -- detailPanel is inlined, so no method of its own survives to be called

-- app.sngl --
import . "sngl:ui"

output { go { fyne } }

struct Issue {
    key string
    summary string
    status string
    assignee string
}

window #app(title="t") {
    var current = Issue{}

    vbox {
        text(value="header")
        detailPanel(it=current)
    }
}

component detailPanel(it Issue) node {
    vbox {
        text(value=it.key)
        text(value=it.summary)
        text(value=it.status)
        text(value=it.assignee)
    }
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package ui

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
)

type Issue struct {
	Key      string
	Summary  string
	Status   string
	Assignee string
}

// Model holds the state for this SNGL UI.
type Model struct {
	current Issue

	__n4 *fyne.Container
	__n5 *widget.Label
	__n6 *fyne.Container
	__n0 *widget.Label
	__n1 *widget.Label
	__n2 *widget.Label
	__n3 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.current = Issue{}
	return m
}

func (m *Model) Current() Issue {
	return m.current
}

func (m *Model) SetCurrent(v Issue) {
	m.current = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n4 = container.NewVBox()
	m.__n5 = widget.NewLabel("")
	m.__n5.SetText("header")
	m.__n4.Add(m.__n5)
	m.__n6 = container.NewVBox()
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText(m.current.Key)
	m.__n6.Add(m.__n0)
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText(m.current.Summary)
	m.__n6.Add(m.__n1)
	m.__n2 = widget.NewLabel("")
	m.__n2.SetText(m.current.Status)
	m.__n6.Add(m.__n2)
	m.__n3 = widget.NewLabel("")
	m.__n3.SetText(m.current.Assignee)
	m.__n6.Add(m.__n3)
	m.__n4.Add(m.__n6)
	content := fyne.CanvasObject(m.__n4)
	return content
}
