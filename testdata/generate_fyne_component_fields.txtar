Regression test for #35: the widget fields of a sub-component have to be
declared on the Model struct. NoInlineComponents inlines detailPanel into
main rather than emitting a render method for it, so its four text() nodes
are main's own labels (__n0..__n3, under the inlined vbox __n6) and its prop
references are substituted with the callsite argument, m.current.

deny out/go/fyne/model.go `renderDetailPanel` -- detailPanel is inlined, so no method of its own survives to be called

-- app.sngl --
import . "sngl:ui"

output { go { fyne } }

struct Issue {
    key string
    summary string
    status string
    assignee string
}

window #app(title="t") {
    var current = Issue{}

    vbox {
        text(value="header")
        detailPanel(it=current)
    }
}

component detailPanel(it Issue) node {
    vbox {
        text(value=it.key)
        text(value=it.summary)
        text(value=it.status)
        text(value=it.assignee)
    }
}
-- out/go/fyne/model.go --
