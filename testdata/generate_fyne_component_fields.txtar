Regression test for #35: sub-component widget fields must be declared on
the Model struct. After NoInlineComponents, detailPanel is inlined into main
rather than emitted as a separate renderDetailPanel method.

The inlined detailPanel's four text() nodes become Model fields.
__n6 is the inlined vbox; __n0..__n3 are the four labels.

Prop references are substituted with m.current (the callsite arg).

deny out/go/fyne/model.go `renderDetailPanel` -- detailPanel gets inlined — no renderDetailPanel method survives.
-- app.sngl --
import . "sngl:ui"
import . "sngl:app"

output { go { fyne } }

struct Issue {
    key string
    summary string
    status string
    assignee string
}

component main {
    var current = Issue{}

    window #app(title="t") {
        vbox {
            text(value="header")
            detailPanel(it=current)
        }
    }
}

component detailPanel(it Issue) {
    vbox {
        text(value=it.key)
        text(value=it.summary)
        text(value=it.status)
        text(value=it.assignee)
    }
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from app.sngl; DO NOT EDIT.

package ui

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/widget"
)

type Issue struct {
	Key      string
	Summary  string
	Status   string
	Assignee string
}

// Model holds the state for this SNGL UI.
type Model struct {
	current Issue

	__n4 *fyne.Container
	__n5 *widget.Label
	__n6 *fyne.Container
	__n0 *widget.Label
	__n1 *widget.Label
	__n2 *widget.Label
	__n3 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	m.current = Issue{}
	return m
}

func (m *Model) Current() Issue {
	return m.current
}

func (m *Model) SetCurrent(v Issue) {
	m.current = v
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n4 = container.NewVBox()
	m.__n5 = widget.NewLabel("")
	m.__n5.SetText("header")
	m.__n4.Add(m.__n5)
	m.__n6 = container.NewVBox()
	m.__n0 = widget.NewLabel("")
	m.__n0.SetText(m.current.Key)
	m.__n6.Add(m.__n0)
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText(m.current.Summary)
	m.__n6.Add(m.__n1)
	m.__n2 = widget.NewLabel("")
	m.__n2.SetText(m.current.Status)
	m.__n6.Add(m.__n2)
	m.__n3 = widget.NewLabel("")
	m.__n3.SetText(m.current.Assignee)
	m.__n6.Add(m.__n3)
	m.__n4.Add(m.__n6)
	content := fyne.CanvasObject(m.__n4)
	return content
}
