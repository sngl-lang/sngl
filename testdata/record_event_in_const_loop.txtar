A handler that only calls a record's event keeps the record's loop variable.

`a.run()` reads `a` through the callee of a call through a function value,
which the capture analysis did not walk. So a handler in a loop whose body
reads no state looked like it captured nothing, was promoted to a method of
the model, and named an `a` that only the loop binds. A menubar's entries on
gtk4 are this shape.

deny out/go/gtk4/model.go `_clicked_handler\(\) \{\n\s*a\.Run\(\)` -- the handler is a closure in the loop, not a method
deny out/go/fyne/model.go `_click_handler\(\) \{\n\s*a\.Run\(\)` -- as above, on fyne

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
    none { html }
}

component action(label string, @run()) action

component bar(items ...component action) ui.node {
    ui.hbox {
        for var a = items {
            ui.button(text=a.label, @click { a.run() })
        }
    }
}

component main ui.node {
    var picked = ""
    ui.vbox {
        ui.text(value=picked)
        bar {
            action(label="One", @run { picked = "one" })
            action(label="Two", @run { picked = "two" })
        }
    }
}

ui.window {
    main
}
