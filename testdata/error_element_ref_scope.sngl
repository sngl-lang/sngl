// A component's refs are the ids its own body writes. An id in a component it
// instantiates is that component's, and an id in a slot population is the
// population's: neither is reached off the outer instance directly. Each is
// reached through the node that holds it: `c.inbox.lbl`, `c.shell.head`.

import . "sngl:ui"
import . "sngl:test"

component badge node {
    text #lbl(value="x")
}

component frame(header component, children ...component) node {
    vbox {
        header {}
        text #own(value="frame's")
        children
    }
}

component page node {
    badge #inbox()
    frame #shell {
        text #body(value="bare")

        component header {
            text #head(value="head")
        }
    }
}

func testScope(t Test, c page) {
    var direct = c.lbl // ERROR(check) "no member \"lbl\" on component page"
    var through = c.inbox.lbl
    var inCallee = c.own // ERROR(check) "no member \"own\" on component page"
    var bare = c.body
    var populated = c.head // ERROR(check) "no member \"head\" on component page"
    var viaShell = c.shell.head
}

window {
}
