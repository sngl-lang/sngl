A value a null test narrows after a branch that always leaves, and in a
loop over `n != null` until the body assigns it, is read as what it holds
on every language: the checker writes each such read as the unwrap a
branch's narrowing is (ir.Conversion), which each backend spells as its
option's -- Go's `*n`, Kotlin's `n!!`, JavaScript's bare read and C's
`.value`. testdata/option_narrow_after_leave.sngl holds what the
interpreter answers.

-- app.sngl --
import test "sngl:test"
import ui "sngl:ui"

output {
    c {
        gtk4
    }
    go {
        bubbletea
    }
    kotlin {
        android
    }
    none {
        html
    }
}

func plusOne(x option[int]) int {
    if x == null {
        return 0
    }
    return x + 1
}

func orElse(x option[int]) int {
    if x != null {
        var seen = x
    } else {
        return -1
    }
    return x * 2
}

func firstBig(xs list[option[int]]) int {
    var total = 0
    for var x = xs {
        if x == null {
            continue
        }
        if x > 10 {
            total = total + x
            break
        }
        total = total + x
    }
    return total
}

func after(i int, count int) option[int] {
    if i + 1 < count {
        return i + 1
    }
    return null
}

func names(start option[int], xs list[string]) string {
    var out = ""
    var n = start
    for n != null {
        out = out + xs[n]
        n = after(n, xs.length())
    }
    return out
}

component main ui.node {
    var said = ""
    ui.button #read(text="read", @click {
        var xs = ["a", "b", "c"]
        said = "{plusOne(null)} {plusOne(4)} {orElse(null)} {orElse(3)} {firstBig([1, null, 2, 20, 5])} {names(0, xs)} [{names(null, xs)}]"
    })
    ui.text(value=said)
}

ui.window(title="t") {
    main()
}

func testNarrowedReadsHoldTheirValue(t test.Test, c main) {
    c.read.click()
    t.assert(c.said == "0 5 -1 6 23 abc []")
}
