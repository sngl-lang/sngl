package main

import "testing"

func TestNarrowedReadsHoldTheirValue(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.readClick()
	if !((c.said == "0 5 -1 6 23 abc []")) { t.Errorf("assert failed: %s", "(c.said == \"0 5 -1 6 23 abc []\")") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
