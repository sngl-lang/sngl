A handler reaches its widget through the #[gen.protocol(connect)] function
gtk4.sngl declares once, which passDeclarative splices into each
AttachHandler op on a widget a declared create made: gtk4rt.Connect, handed
the node as a Handle, the signal by the name GTK knows it -- notify::active
for @notifyActive, from the #[gen.connects] declgen writes on the event --
and the handler, put in place by the translator as a method or, in a `for`
row, a closure. gtk4rt registers the handler and copies the signal into C,
so even the inline-cgo path, which the canvas keeps the program on, calls no
C to connect one.
deny out/go/gtk4/model.go `C\.sngl_connect\(` -- the connect is gtk4rt's, not a cgo call the translator builds
deny out/go/gtk4/model.go `snglCallbacks` -- gtk4rt.Connect registers the handler through cbind
deny out/go/gtk4/model.go `C\.CString\("(clicked|notify::active)"\)` -- the signal crosses into C inside gtk4rt.Connect
-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"
import go "sngl:language/go"
import gtk "gir:Gtk-4.0"

output {
    go {
        gtk4
    }
}

var count = 0
var on = false
var picked = ""

ui.window(title="t") {
    draw.canvas(width=20px, height=20px) {
        draw.line(x1=0.0, y1=0.0, x2=10.0, y2=10.0)
    }
    gtk.GtkBox(spacing=4) {
        gtk.GtkButton(label="count", @clicked {
            count += 1
        })
        gtk.GtkSwitch(@notifyActive(s) {
            on = !on
        })
        for var name = ["a", "b"] {
            gtk.GtkButton(label=name, @clicked {
                picked = name
            })
        }
    }
}
