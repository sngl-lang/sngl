A window after html's document is a `<dialog>` in it, and a dialog is the
application's rather than a page's: every document a stack's pages are written
as carries it, in static mode and in route mode, each with its own state, as
each page already has. It sits where it is written: `help`, under an `if` over
state above the window holding the stack, is a render slot ahead of that
window's content in each document's body. The document is `site`, the first
window no `if` over state can take away.

-- app.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        html
    }
}

var (
    asked = false
    helps = 0
)

if asked {
    ui.window(title="Help", @closed {
        asked = false
    }) {
        ui.text(value="asked {helps} times")
    }
}

ui.window #site(title=pages.current.title) {
    ui.button(text="Help", @click {
        helps += 1
        asked = true
    })
    nav.stack #pages {
        nav.page #home(href="/", title="Home") {
            ui.text(value="home")
        }
        nav.page #about(href="/about", title="About") {
            ui.text(value="about")
        }
    }
}
-- out/go/html/server.go --
