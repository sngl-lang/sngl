// SKIP(codegen) "names sngl:platform/bubbletea, which a per-platform harness does not register"
import . "sngl:ui/draw"
import "sngl:platform/bubbletea"

// The base an override implements need not be this package's, and for every
// override in lib/ and in a target package it is not. pass2 decides which
// funcs it must leave to checkComponentBody by walking pkg.Components, which
// holds only what this package declared -- so a helper in an override of an
// imported component was checked a second time at package scope, where the
// body it belongs to is not in scope and `m` is undefined.
component circle[bubbletea.platform] {
    var m = 3.0

    func scaled() => m * 2.0

    rect(x=0.0, y=0.0, w=scaled(), h=scaled())
}
