A `#[construct]` prop written from state rebuilds the instance where it stands
on gtk4 and win32 as on html: the new instance goes in before the old one,
which comes out. `seeded` is recursive so that it stays an instance rather
than being inlined. The position is the container the build appended the first
one to, bound beside it as `__n2__pos`, since the handler that rebuilds it is
a function of its own. The test runs it.

-- app.sngl --
import macro "sngl:macro"
import test "sngl:test"
import ui "sngl:ui"

output {
    go {
        gtk4
        win32
    }
    c {
        gtk4
        win32
    }
}

component seeded(#[macro.construct] start int, more = 0) ui.node {
    var n = start
    ui.text(value="s:{n}")
    if more > 0 {
        seeded(start=start, more=more - 1)
    }
}

component App() ui.node {
    var k = 10
    ui.text(value="before")
    ui.button #bump(text="bump", @click { k = k + 1 })
    seeded #s(start=k)
    ui.text(value="after")
}

ui.window(title="H") {
    App()
}

func testBumpRebuilds(t test.Test, c App) {
    c.bump.click()
    c.bump.click()
    t.assert(c.s.n == 12)
}
