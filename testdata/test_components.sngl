component badge {
    param label = "default"
    param count = 0
    computed display = label

    text #lbl (value=display)
}

component dashboard {
    var name = "test"
    var total = 5

    vbox {
        badge(label=name, count=total)
        badge()
        text #foot (value="footer")
    }
}

test badge "param defaults" {
    assert(label == "default")
    assert(count == 0)
}

test badge "computed from params" {
    assert(display == "default")
    label = "custom"
    assert(display == "custom")
}

test dashboard "renders child component" {
    assert(#foot.value == "footer")
    assert(#lbl[0] != null)
}

test dashboard "component receives props" {
    assert(#lbl[0].value == "test")
}
