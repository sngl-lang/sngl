import . "sngl:std"

component badge(label = "default", count = 0) {
    func display() => label

    text #lbl(value=display)
}

component dashboard {
    var name = "test"
    var total = 5

    vbox {
        badge(label=name, count=total)
        badge()
        text #foot(value="footer")
    }
}

func testParamDefaults(t Test, c badge) {
    t.assert(c.label == "default")
    t.assert(c.count == 0)
}

func testComputedFromParams(t Test, c badge) {
    t.assert(c.display == "default")
    c.label = "custom"
    t.assert(c.display == "custom")
}

func testRendersChildComponent(t Test, c dashboard) {
    t.assert(c.foot.value == "footer")
    t.assert(c.lbl[0] != null)
}

func testComponentReceivesProps(t Test, c dashboard) {
    t.assert(c.lbl[0].value == "test")
}
