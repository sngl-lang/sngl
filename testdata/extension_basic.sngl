import . "sngl:ui"
import app "sngl:app"

// Bare `text(...)` user calls bind to the stdlib `text` component.
// When a platform ships `component sngl.text { platform <p> { ... } }`,
// the extension merge splices that body into stdlib text before
// pass2 — see TestExtensionMergeBasic in extension_test.go for the
// driver that registers a stub platform and asserts the splice.
//
// The fixture itself only exercises the user-facing surface: bare
// `text(value="hi")` must type-check without a registered platform
// (stdlib text's body stays abstract; the call still resolves to a
// known component with a known `value` prop).
component main node {
    text(value="hi")
}

app.window {
    main
}
