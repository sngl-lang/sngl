A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_treeless_in_canvas.sngl --
// A component that belongs to no tree goes in any of them. This is the case
// the rule exists for: an `effect` renders nothing, so it is no more a widget
// than it is a shape, and a lifetime bracket belongs in a drawing as much as
// in a layout. Before the change its omitted return position made it a member
// of the default family, and a canvas rejected it with
// "expected shape component in canvas".
//
// `timer` is the same shape of declaration and is placed beside it, because
// scheduling inside a drawing is what an animated canvas is made of.

import d "sngl:ui/draw"
import time "sngl:time"
import ui "sngl:ui"

var frame = 0

ui.window(title="drawing") {
    ui.vbox {
        d.canvas(width=40px, height=40px) {
            d.circle(cx=20.0, cy=20.0, r=float(frame), style={fill=#3366FF})
            effect(@mount { frame = 4 })
            time.timer(interval=100ms, @tick { frame = frame + 1 })
        }
    }
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
