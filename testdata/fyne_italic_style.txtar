A slanted run of text on fyne.

Fyne has no per-widget styling: a color or a face belongs to a theme, and what
this platform does about that is generate one per distinct set of paint
properties and wrap the node in a `container.ThemeOverride`. `fyneStyle` is
what it reads a style into, and it read `fontWeight` and not `fontStyle` -- so
`style={fontStyle=ui.FontStyle.italic}` type-checked, reached codegen, and came
out upright here while every other target slanted it.

The theme is the whole of the fix: `Theme.Font` already forces `Bold` on the
style every lookup in its subtree passes it, which is exactly what an italic
face needs done to it.

A second defect was in the way and is fixed with it: the theme declarations
always imported `image/color`, which Go refuses when nothing writes a colour
literal. Every fixture until this one had a colour somewhere in its themes, so
a program styling a slant and nothing else was the first to emit Go that does
not compile. The `run/go/fyne` record below is what says it does now.

deny out/go/fyne/model.go `Bold: true` -- a run that asked for a slant is not also given a weight
deny out/go/fyne/model.go `image/color` -- nothing here writes a colour literal, and Go refuses an import nothing uses
-- doc.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
    }
}

ui.window #home(title="doc") {
    ui.vbox {
        ui.text(value="slanted", style={fontStyle=ui.FontStyle.italic})
    }
}
-- out/go/fyne/model.go --
// Code generated by sngl (fyne) from doc.sngl; DO NOT EDIT.

package main

import (
	"fyne.io/fyne/v2"
	"fyne.io/fyne/v2/app"
	"fyne.io/fyne/v2/container"
	"fyne.io/fyne/v2/theme"
	"fyne.io/fyne/v2/widget"
	"git.duckfam.us/jonathan/sngl/pkg/go/fynetheme"
	"os"
)

var _snglTheme0 = fynetheme.Theme{Theme: theme.DefaultTheme(), Italic: true}

// Model holds the state for this SNGL UI.
type Model struct {
	__n0 *fyne.Container
	__n1 *widget.Label
}

// New creates a Model with default values.
func New() *Model {
	m := &Model{}
	return m
}

// BuildUI creates the widget tree. Call once; widgets are updated selectively.
func (m *Model) BuildUI() fyne.CanvasObject {
	m.__n0 = container.NewVBox()
	m.__n1 = widget.NewLabel("")
	m.__n1.SetText("slanted")
	m.__n0.Add(container.NewThemeOverride(m.__n1, _snglTheme0))
	content := fyne.CanvasObject(m.__n0)
	return content
}

func main() {
	a := app.New()
	w := a.NewWindow("SNGL App")
	m := New()
	w.SetContent(m.BuildUI())
	w.Resize(fyne.NewSize(480, 640))
	w.ShowAndRun()
	_ = os.Stderr
}
