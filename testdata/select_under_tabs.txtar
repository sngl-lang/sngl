A select in a tab is spliced into the `for` win32's and gtk4's `ui.tabs`
walks its tabs with, which runs once, over tabs nothing changes, so the node
stays a local of the loop's copy. The select's effects and its `@change`
read it from functions of their own, and named a local none of them could
reach (examples/pokedex, `#methodPick`): the package body, and a record's
render slot, now hold it as they hold a node a function makes for another,
the node made last.

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
        win32
    }
    c {
        gtk4
        win32
    }
}

var top = "a"
var shown = true

component moves() {
    var tab = 0
    var pick = "a"
    ui.tabs(:selected=tab) {
        ui.tab(label="One") {
            ui.text(value="one")
        }
        ui.tab(label="Two") {
            ui.select #methodPick(:value=pick) {
                ui.choice(label="A", value="a")
                ui.choice(label="B", value="b")
            }
        }
    }
}

ui.window {
    ui.vbox {
        ui.tabs {
            ui.tab(label="Top") {
                ui.select #topPick(:value=top) {
                    ui.choice(label="A", value="a")
                    ui.choice(label="B", value="b")
                }
            }
        }
        ui.button(text="toggle", @click { shown = !shown })
        if shown {
            moves()
        }
    }
}
