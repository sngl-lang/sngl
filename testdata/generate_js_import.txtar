<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<button id="$0">
  <span>add</span>
</button>
<span id="__n0" data-sngl-id="__n0">
</span>

<script>
(() => {
  // sngl-virt:/sngl/lib/index.ts
  function add(a, b) {
    return a + b;
  }

  // sngl-entry.js
  var state = { n: 0 };
  function String(v) {
    return "" + v;
  }
  var $0 = document.getElementById("$0");
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  $0.addEventListener("click", function() {
    state.n = add(2, 3);
    __n0.textContent = String(state.n);
  });
  function __sngl_init() {
    __n0.textContent = String(state.n);
  }
  __sngl_init();
})();
</script>
</body></html>
