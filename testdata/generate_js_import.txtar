A `js:` import is bundled by esbuild into the inline `<script>`: the function
body from lib/index.ts is emitted next to the entry code, and the call site
resolves to that local binding rather than to the SNGL alias `__sngl_n_lib`,
which esbuild is free to inline or rename. The whole bundle sits inside
esbuild's IIFE wrapper.
-- app.sngl --
import . "sngl:ui"
import lib "js:./lib"

output {
    none {
        html
    }
}

component main {
    var n = 0.0
    button(text="add", @click { n = lib.add(2.0, 3.0) })
    text(value=string(n))
}
-- lib/index.ts --
export function add(a: number, b: number): number {
    return a + b;
}
-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

