What a node's style says reaches gtk4, which read no field of it but `flex`.

- Every field gtk4 draws reaches `gtk4rt.SetLook` in a `gtk4rt.Look` that
  style.sngl's `lookOf` builds, each length in pixels: a width and a height a
  size request, and padding, margin, the face, the colors and the border
  radius CSS. A literal Style folds to a Look literal.
- A field reading state is read where the state is written, so the click
  restyles the label and the badge.
- A style held as a value, here a var, is read off the value at run time by
  the emitted `LookOf`, so it draws as a literal does and again as the var
  changes. A prop spread into a literal where the instance is inlined is a
  literal again, `cell`'s.
- A box's `alignItems` and a label's `textAlign` reach the Look too, which
  puts the box's children across it and the label's lines in it; `ui.text`'s
  label starts its lines at the left otherwise (`LabelSetXAlign`), as html's
  does, where a GtkLabel centered them.
- An image's style reaches gtk4's `Image`, whose width and height are its
  size whatever its picture's: a picture was its file's own size where it
  asked for 96.

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
    }
}

component cell(value string, style = ui.Style{}) ui.node {
    ui.text(value=value, style=style.over({width=80px}))
}

ui.window {
    var on = false
    var held = ui.Style{fontSize=20px, color=#aa0000}
    var names = ["a", "b"]
    ui.vbox(style={gap=12px, padding=16px}) {
        ui.text(value="title", style={textAlign=center, fontSize=28px, fontWeight=bold, color=on ? #cc0000 : #0000cc})
        ui.badge(value="badge", style={background=on ? #ff0000 : #00aa00, color=#ffffff})
        ui.text(value="held", style=held)
        ui.image(alt="dot", style={width=96px, height=96px}) {
            ui.remote(url="https://example.com/dot.png")
        }
        ui.hbox(style={gap=24px, marginY=4px, alignItems=center}) {
            for var s = names {
                cell(value=s, style={fontStyle=italic, background=#dddd00})
            }
        }
        ui.button(text="flip", @click {
            on = !on
            held = ui.Style{fontSize=1em}
        })
    }
}
