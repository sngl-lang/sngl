What a node's style says reaches gtk4, which read no field of it but `flex`.

- Every field gtk4rt draws is handed to `gtk4rt.SetStyle` in a `gtk4rt.Style`,
  each length in pixels: a width and a height are a size request, a gap a
  box's spacing, and padding, margin, the face, the colors and the border
  radius are CSS, a class per distinct style on one provider for the display.
- A field reading state is read where the state is written, so the click
  restyles the label and the badge.
- A style held as a value, here a var, is read off the value at run time by
  `snglStyle`, generated from the Style declaration, so it draws as a literal
  does and again as the var changes. A prop spread into a literal where the
  instance is inlined is a literal again, `cell`'s.
- An image's style reaches gtk4's `Image`, whose width and height are its
  size whatever its picture's: a picture was its file's own size where it
  asked for 96.

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
    }
}

component cell(value string, style = ui.Style{}) ui.node {
    ui.text(value=value, style={width=80px, ...style})
}

ui.window {
    var on = false
    var held = ui.Style{fontSize=20px, color=#aa0000}
    var names = ["a", "b"]
    ui.vbox(style={gap=12px, padding=16px}) {
        ui.text(value="title", style={fontSize=28px, fontWeight=bold, color=on ? #cc0000 : #0000cc})
        ui.badge(value="badge", style={background=on ? #ff0000 : #00aa00, color=#ffffff})
        ui.text(value="held", style=held)
        ui.image(alt="dot", style={width=96px, height=96px}) {
            ui.remote(url="https://example.com/dot.png")
        }
        ui.hbox(style={gap=24px, marginY=4px}) {
            for var s = names {
                cell(value=s, style={fontStyle=italic, background=#dddd00})
            }
        }
        ui.button(text="flip", @click {
            on = !on
            held = ui.Style{fontSize=1em}
        })
    }
}
