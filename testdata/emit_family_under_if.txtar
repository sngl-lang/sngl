	__n0 := widget.NewButton("", nil)
	__n0.SetText("tick")
	__n0.OnTapped = m.__n0_click_handler
	return __n0
}

func main() {
	snglApp = app.New()
	m := New()
	m.BuildUI()
	snglRunWindows(true)
	_ = os.Stderr
