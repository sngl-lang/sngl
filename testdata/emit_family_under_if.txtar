A generated host goes anywhere a root member goes: under an `if` at the root
of a file, and in a component whose family is `root`.

Under an `if` the host is rewritten where it stands, so the family's
`gen.emit` -- two effects -- sits under the same `if`, and passEffect gives
it what it gives any effect there: mounted when the condition turns true,
unmounted when it turns false, and settled on nothing while it is gone.
`@start` runs again each time the bar comes back.

In a root component the members function is the component's own, so the
inliner renames what it reads with everything else the component declares:
`ticks` is `ticks__inst0` in it, as it is in the component's body.

deny out/go/fyne/model.go `(?i)\bbar\b` -- no host reaches a backend
deny out/go/gtk4/model.go `(?i)\bbar\b` -- likewise

-- family.sngl --
import build "sngl:build"
import gen "sngl:x/gen"
import go "sngl:language/go"

component block build.family

component text(full string) block

component bar(blocks ...component block) root

struct Entry {
    full string
}

#[go.native("fmt", "fmt.Print")]
func print(s string)

func encode(members list<Entry>) string {
    var parts list<string> = []
    for var e = members {
        parts.push(e.full)
    }
    return parts.join("|")
}

component block[go.language] {
    gen.emit(
        render=encode,
        @start(members) {
            print("start\n")
        },
        @change(line) {
            print(line + "\n")
        },
    )
}

component text[go.language] {
    gen.node(value=Entry{full=full})
}
-- app.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
        gtk4
    }
}

var (
    shown = true
    n = 0
)

if shown {
    bar {
        text(full="n={n}")
    }
}

component statusline root {
    var ticks = 0
    bar {
        text(full="t={ticks}")
    }
    ui.window(title="Status") {
        ui.button(text="tick", @click {
            ticks += 1
        })
    }
}

statusline()

ui.window(title="Main") {
    ui.button(text="toggle", @click {
        shown = !shown
    })
    ui.button(text="+", @click {
        n += 1
    })
}
