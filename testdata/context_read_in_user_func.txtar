	part2Prefix := " "
	if part2Focused {
		part2Prefix = ">"
	}
	part2Text := part2Prefix + " " + fmt.Sprint("tap")
	part2 = tui.Within(tui.Focused(tui.ButtonLook(BoxLook(Style{FlexDirection: "unset", AlignItems: "unset", JustifyContent: "unset", Position: "unset", FontWeight: "unset", FontStyle: "unset", TextAlign: "unset", WhiteSpace: "unset", BorderStyle: "unset", Display: "unset", ListStyleType: "unset"}, true)), part2Focused), tui.Avail(m.width), part2Text).Render(part2Text)
