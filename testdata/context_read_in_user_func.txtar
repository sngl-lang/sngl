package main

import "testing"

func TestDefaultWhereNothingProvides(t *testing.T) {
	__snglTestComponent := newTestComponent()
	c := __snglTestComponent
	_ = c
	if !((c.plain == "d1")) { t.Errorf("assert failed: %s", "(c.plain == \"d1\")") }
	if !(true) { t.Errorf("assert failed: %s", "true") }
}

func TestCallsReadTheirCallersProvider(t *testing.T) {
	__snglTestComponent := newTestComponent()
	c := __snglTestComponent
	_ = c
	if !((c.under == "d5")) { t.Errorf("assert failed: %s", "(c.under == \"d5\")") }
	if !((c.inner == "d9")) { t.Errorf("assert failed: %s", "(c.inner == \"d9\")") }
	if !((c.chained == "rd5")) { t.Errorf("assert failed: %s", "(c.chained == \"rd5\")") }
	if !((c.recursed == "5")) { t.Errorf("assert failed: %s", "(c.recursed == \"5\")") }
	if !((c.method == "10")) { t.Errorf("assert failed: %s", "(c.method == \"10\")") }
	if !((c.lambda == "d5")) { t.Errorf("assert failed: %s", "(c.lambda == \"d5\")") }
	if !((c.mapped == "4:5")) { t.Errorf("assert failed: %s", "(c.mapped == \"4:5\")") }
}

func TestAFunctionValueIsBoundWhereItIsTaken(t *testing.T) {
	__snglTestComponent := newTestComponent()
	c := __snglTestComponent
	_ = c
	if !((c.taken == "2:1")) { t.Errorf("assert failed: %s", "(c.taken == \"2:1\")") }
}

func TestHandlersReadTheProviderTheyAreWrittenUnder(t *testing.T) {
	__snglTestComponent := newTestComponent()
	c := __snglTestComponent
	_ = c
	c.tapClick()
	if !((c.clicked == "d5")) { t.Errorf("assert failed: %s", "(c.clicked == \"d5\")") }
	c.wrapClick()
	if !((c.provided == "d7")) { t.Errorf("assert failed: %s", "(c.provided == \"d7\")") }
}


func newTestComponent() Model { return New() }
