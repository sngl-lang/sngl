A function that reads a context reads the provider its *caller* runs under.
`show()` below is one function, and under `depth(5)` it answers "d5", under
`depth(9)` "d9", and where nothing provides one the default "d1". That holds
for a function the program calls from a view body, from a handler, from
another function, from itself, and for a component's method.

It did not, twice over. The optimizer folded `show()` before anything lowered
the provider around it, evaluating the context against its default, so every
call came out as "d1" whatever enclosed it. And where a call survived to
lowering, a program's own function read one package-level `__ctx_depth` that
nothing under a provider ever set -- the library wrappers took the value as a
hidden parameter and the program's functions did not. Now every function that
transitively reads a context takes `__ctx_<name>` and every call passes the
value in scope where it is made; a method is one of them rather than a reader
of its component's own copy. The optimizer leaves such a call alone until then,
and folds it from its argument after, which is why the html page carries the
literal text.

A function taken as a value is bound where it is taken, as a lambda written
there is: `f` below reads "2:1" called under `depth(7)`, since a call through
a value cannot know what function it holds and so has nothing to pass. A
named function handed to `map` is taken at the call, so it reads "4:5".

Each value the tests check is copied into state by a mount effect or a
handler written where the call would be, because that is what a test can read
on every target. The interpreter's half is
cmd/sngl/testdata/context_read_in_user_func.txt.

-- funcs.sngl --
import . "sngl:test"
import . "sngl:ui"

context #depth(1)

func show() => "d{depth}"

func label(x int) => "{x}:{depth}"

func relay() string {
    var s = show()
    return "r" + s
}

func down(n int) string {
    if n <= 0 {
        return "{depth}"
    }
    return down(n - 1)
}

component main node {
    var plain = ""
    var under = ""
    var inner = ""
    var chained = ""
    var recursed = ""
    var method = ""
    var lambda = ""
    var mapped = ""
    var taken = ""
    var clicked = ""
    var provided = ""
    func twice() => "{depth * 2}"
    effect(@mount {
        plain = show()
        var f = label
        depth(7) {
            taken = f(2)
        }
    })
    depth(5) {
        effect(@mount {
            under = show()
            chained = relay()
            recursed = down(3)
            method = twice()
            lambda = [0].map(func(x int) => show())[0]
            mapped = [4].map(label)[0]
        })
        depth(9) {
            effect(@mount {
                inner = show()
            })
            text(value=show())
        }
        text(value=show())
        button #tap(text="tap", @click {
            clicked = show()
        })
    }
    button #wrap(text="wrap", @click {
        depth(7) {
            provided = show()
        }
    })
    text(value=show())
    text(value="{clicked} {provided}")
}

func testDefaultWhereNothingProvides(t Test, c main) {
    t.assert(c.plain == "d1")
    t.assert(show() == "d1")
}

func testCallsReadTheirCallersProvider(t Test, c main) {
    t.assert(c.under == "d5")
    t.assert(c.inner == "d9")
    t.assert(c.chained == "rd5")
    t.assert(c.recursed == "5")
    t.assert(c.method == "10")
    t.assert(c.lambda == "d5")
    t.assert(c.mapped == "4:5")
}

func testAFunctionValueIsBoundWhereItIsTaken(t Test, c main) {
    t.assert(c.taken == "2:1")
}

func testHandlersReadTheProviderTheyAreWrittenUnder(t Test, c main) {
    c.tap.click()
    t.assert(c.clicked == "d5")
    c.wrap.click()
    t.assert(c.provided == "d7")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
        html
    }
    kotlin {
        android
    }
    none {
        html
    }
}
