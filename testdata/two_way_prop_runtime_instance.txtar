A two-way prop written inside a component built at run time reports the
write to the call site's binding, on every target that builds one.

passPropBindings lowers the binding to an event named for the prop, and the
write inside the component to its emit. passInstanceEvents is what makes an
event of a run-time instance a func-typed prop, and it skipped one whose name
a prop already had -- which is every binding's -- so the emit reached codegen
as a call to `emit`, which nothing declares: Go that did not compile on gtk4
and fyne, and a page that threw on html. Such an event's prop is `__on_<prop>`.

Counter keeps a `var` of its own, so under the loop it is an instance built
at run time rather than spliced.

deny * `emit\(` -- the write-back is a call of the instance's __on_n prop
-- app.sngl --
import ui "sngl:ui"

output {
    none {
        html
    }
    go {
        gtk4
        fyne
    }
}

component Counter(:n int, label string) ui.node {
    var clicks = 0
    ui.button(text="{label} {clicks}", @click {
        clicks += 1
        n += 1
    })
}

ui.window(title="t") {
    var items list[string] = ["a"]
    var total = 0
    ui.vbox {
        for var it = items {
            Counter(:n=total, label=it)
        }
        ui.text(value="total {total}")
        ui.button(text="more", @click { items.push("b") })
    }
}
