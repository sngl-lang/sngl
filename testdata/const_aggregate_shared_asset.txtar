A list const read by several pages is written once, as a script every page
that reads it loads, and not into each page.

The optimizer used to substitute a const's value at every read, which is
right for `3` and wrong for a list: each page that read `entries` carried a
literal copy of all of it, and the docs site carried its 1,074-entry search
index 1,032 times. A reference to a list or map const now stays a reference,
so `entries[pick].title` below reads the one declaration at run time, and html
in static mode writes that declaration to `assets/consts/` and binds it at the
top of each page's script that names it.

Everything that can fold still does, reading through the declaration: the
unrolled `for`, a constant index, a field of it, and `.length()` -- `help.html`
reads only folded values and loads no asset at all.

deny out/none/html/index.html `title: "Home"` -- the page does not carry its own copy of the list
deny out/none/html/about.html `title: "Home"` -- the page does not carry its own copy of the list
deny out/none/html/help.html `assets/consts|__snglShared` -- a page whose reads all folded loads nothing

-- app.sngl --
import . "sngl:ui"

output {
    none {
        html
    }
}

struct Entry {
    title string
    href string
}

const entries = [Entry{title="Home", href="/"}, Entry{title="About", href="/about.html"}, Entry{title="Help", href="/help.html"}]

window #home(title="Home", href="/") {
    var pick = 0

    for var e = entries {
        link(text=e.title, href=e.href)
    }
    text(value=entries[1].title)
    text(value="{entries.length()} pages")
    button(text="next", @click { pick = (pick + 1) % entries.length() })
    text(value=entries[pick].title)
}

window #about(title="About", href="/about.html") {
    var shown = 2

    text(value=entries[shown].href)
}

window #help(title="Help", href="/help.html") {
    text(value=entries[2].title)
}
