A locale provider nested in a for-loop body threads the loop variable, not a
constant. Each iteration's subtree gets that iteration's locale, so the
generated `i18n.NumberInt` call inside the loop takes `l` as its locale
argument.

deny out/go/bubbletea/model.go `i18n\.NumberInt\(i18n\.DefaultLocale` -- the loop variable reaches the call; falling back to the default locale would mean the provider was ignored
deny out/go/bubbletea/model.go `i18n\.GetTranslator` -- a threaded locale is passed as an argument, and the process-wide translator is what the Go backend emits only when none was

-- app.sngl --
import . "sngl:ui"
import "sngl:i18n"

output { go { bubbletea } }

component main node {
    var locales = ["en-US", "fr-FR", "es-MX"]
    var n = 1234
    for var l = locales {
        i18n.locale(l) {
            text(value=i18n.numberInt(n, decimal))
        }
    }
}

window {
    main
}
