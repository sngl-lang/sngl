Multiple context providers inside a for-loop body: each iteration's
nested locale provider must thread its loop-variable locale into i18n
calls inside that iteration's subtree.

The for-loop iterates locales; each iteration's i18n.numberInt call
receives `l` (the loop variable, not the parent component's locale)
as its locale arg.

deny out/go/bubbletea/model.go `i18n\.NumberInt\(i18n\.DefaultLocale` -- Verify the threading isn't accidentally using the parent's default.
deny out/go/bubbletea/model.go `i18n\.GetTranslator` -- TODO state the claim
-- app.sngl --
import . "sngl:ui"
import "sngl:i18n"

output { go { bubbletea } }

component main {
    var locales = ["en-US", "fr-FR", "es-MX"]
    var n = 1234
    for var l = locales {
        i18n.locale(l) {
            text(value=i18n.numberInt(n, "decimal"))
        }
    }
}
-- out/go/bubbletea/model.go --
// Code generated by sngl (bubbletea) from app.sngl; DO NOT EDIT.

package ui

import (
	"charm.land/bubbletea/v2"
	"charm.land/lipgloss/v2"
	"fmt"
	"git.duckfam.us/jonathan/sngl/pkg/go/i18n"
	"strings"
)

// Model is the Bubble Tea model for this SNGL UI.
type Model struct {
	locales []string
	n       int

	width, height int
}

// New creates a Model with default bind values.
func New() Model {
	m := Model{}
	m.locales = []string{"en-US", "fr-FR", "es-MX"}
	m.n = 1234
	return m
}

// SetTerminalSize sets the terminal dimensions and resizes widgets.
func (m *Model) SetTerminalSize(w, h int) {
	m.width = w
	m.height = h
}

func (m Model) Locales() []string {
	return m.locales
}

func (m Model) SetLocales(v []string) Model {
	m.locales = v
	return m
}

type setLocalesMsg struct{ value []string }

func SetLocalesCmd(v []string) tea.Cmd {
	return func() tea.Msg { return setLocalesMsg{value: v} }
}

func (m Model) N() int {
	return m.n
}

func (m Model) SetN(v int) Model {
	m.n = v
	return m
}

type setNMsg struct{ value int }

func SetNCmd(v int) tea.Cmd {
	return func() tea.Msg { return setNMsg{value: v} }
}

func (m Model) Init() tea.Cmd {
	return nil
}

func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	var cmds []tea.Cmd
	var cmd tea.Cmd
	_ = cmd
	switch msg := msg.(type) {
	case setLocalesMsg:
		m = m.SetLocales(msg.value)
	case setNMsg:
		m = m.SetN(msg.value)
	case tea.WindowSizeMsg:
		m.width = msg.Width
		m.height = msg.Height
	case tea.KeyPressMsg:
		switch {
		case msg.Code == 'c' && msg.Mod == tea.ModCtrl:
			return m, tea.Quit
		}
	}
	return m, tea.Batch(cmds...)
}

func (m Model) View() tea.View {
	var content string
	var contentItems []string
	for _, l := range m.locales {
		_ = l
		var contentItem string
		contentItem = lipgloss.NewStyle().Render(fmt.Sprint(i18n.NumberInt(l, m.n, "decimal")))
		contentItems = append(contentItems, contentItem)
	}
	content = strings.Join(contentItems, "")
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}
