// list<T> methods preserve T through their signatures, returning concrete
// list<T> / list<U> rather than list<dyn>.

var xs list<int> = [1, 2, 3, 4]

// length is int.
var n int = xs.length()

// filter takes a func(T) bool and returns list<T>.
var evens list<int> = xs.filter(func(x int) => x % 2 == 0)

// map takes a func(T) U and returns list<U>.
var doubled list<int> = xs.map(func(x int) => x * 2)
var labels list<string> = xs.map(func(x int) => "{x}")

// push appends and returns list<T>.
var more list<int> = xs.push(5)
