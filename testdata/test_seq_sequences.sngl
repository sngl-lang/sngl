// sngl:seq's three constructors, run over the interpreter. Every bound is a
// parameter rather than a literal, so the numbers are produced as the loop
// runs instead of being folded into a list at build time -- the folded form
// is what the optimizer's own fixtures cover.

import "sngl:seq"
import . "sngl:test"

func counted(n int) string {
    var out list<int> = []
    for var i = seq.count(n) {
        out.push(i)
    }
    return out.join(",")
}

func ranged(start int, end int) string {
    var out list<int> = []
    for var i = seq.range(start, end) {
        out.push(i)
    }
    return out.join(",")
}

func stepped(start int, end int, by int) string {
    var out list<int> = []
    for var i = seq.step(start, end, by) {
        out.push(i)
    }
    return out.join(",")
}

// A sequence in a variable is an ordinary iter<int>: the numbers exist, and
// the loop head is no longer the seq call that produced them.
func held(n int) int {
    var seen iter<int> = seq.count(n)
    var total = 0
    for var i = seen {
        total = total + i
    }
    return total
}

// A loop that binds nothing still runs once per element.
func times(n int) int {
    var hits = 0
    for seq.count(n) {
        hits = hits + 1
    }
    return hits
}

func testCountStartsAtZero(t Test) {
    t.assert(counted(4) == "0,1,2,3")
}

func testCountOfNothing(t Test) {
    t.assert(counted(0) == "")
    t.assert(counted(-3) == "")
}

func testRangeEndIsExclusive(t Test) {
    t.assert(ranged(1, 5) == "1,2,3,4")
    t.assert(ranged(-2, 2) == "-2,-1,0,1")
}

func testRangeBackwardsIsEmpty(t Test) {
    t.assert(ranged(5, 5) == "")
    t.assert(ranged(5, 1) == "")
}

func testStepCountsUpAndDown(t Test) {
    t.assert(stepped(0, 10, 3) == "0,3,6,9")
    t.assert(stepped(10, 0, -2) == "10,8,6,4,2")
}

// A step of 0 stops rather than never terminating: the loop below has to end
// for this test to report at all.
func testStepOfZeroYieldsNothing(t Test) {
    t.assert(stepped(0, 10, 0) == "")
}

func testHeldSequenceIterates(t Test) {
    t.assert(held(5) == 10)
    t.assert(held(0) == 0)
}

func testLoopWithNoBinding(t Test) {
    t.assert(times(3) == 3)
    t.assert(times(0) == 0)
}
