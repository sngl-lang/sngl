`c.<id>` names the node the tested component's own body wrote, and a node of
the same id in a component it renders is not that node: a null test and a
trigger of `c.b` and `c.k` answer for main's, whichever of main's and panel's
was built last or comes first on the page.

cmd/sngl/testdata/test_ref_owner_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component badge(label string) node {
    var hits = 0
    button #hit(text="{label}{hits}", @click { hits = hits + 1 })
}

component panel node {
    var on = true
    var ph = 0
    vbox {
        if on {
            badge #b(label="p")
            button #k(text="pk{ph}", @click { ph = ph + 1 })
        }
    }
}

component main node {
    var shown = true
    var other = false
    var mh = 0
    vbox {
        button #ts(text="s", @click { shown = !shown })
        button #to(text="o", @click { other = !other })
        if other {
            panel
        }
        if shown {
            badge #b(label="m")
            button #k(text="mk{mh}", @click { mh = mh + 1 })
        }
    }
}

func testOwnB(t Test, c main) {
    t.assert(c.b != null)
    c.to.click()
    if c.k != null {
        c.k.click()
    }
    t.assert(c.mh == 1)
    c.ts.click()
    t.assert(c.b == null)
    t.assert(c.k == null)
}

window {
    main
}
