-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestOwnB(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	c.toClick()
	if c.kPresent() {
		c.kClick()
	}
	if !((c.mh == 1)) { t.Errorf("assert failed: %s", "(c.mh == 1)") }
	c.tsClick()
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.kPresent()) { t.Errorf("assert failed: %s", "!c.kPresent()") }
}


func newTestComponent() Model { return Model{&modelState{}} }

func mountTestComponent(m Model, preset map[string]bool) Model {
	m = m.__mount(preset)
	_ = m.View()
	return m
}
