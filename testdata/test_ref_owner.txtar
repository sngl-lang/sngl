package main

import "testing"

func TestOwnB(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	c.toClick()
	if c.kPresent() {
		c.kClick()
	}
	if !((c.mh == 1)) { t.Errorf("assert failed: %s", "(c.mh == 1)") }
	c.tsClick()
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.kPresent()) { t.Errorf("assert failed: %s", "!c.kPresent()") }
}

