output {
    js { html }
}

struct Config {
    name string = ""
    count int = 0
}

enum Status { active, inactive }

component Counter(label = "", count int) {
    text(value=label + ": " + string(count))
    button(text="+", @click { count = count + 1 })
}

component main {
    var (
        count = 0
        name = "World"
        active = true
        conf = Config{name="test", count=0}
    )

    const (
        MAX = 100
        MIN = 0
        LABEL = "Clicks: " + string(MAX)
    )

    func greeting() => "Hello, {name}"
    func doubled() => count * 2
    func clamped() => count > MAX ? MAX : count < MIN ? MIN : count

    func add(a int, b int) => a + b
    func reset() {
        count = 0
    }

    Counter(label="Count", count=count)
    text(value=greeting)
    button(text="reset", @click { reset() })

    for i, item = [1, 2, 3] {
        text(value=string(item))
    }

    if active {
        text(value="active")
    }
}

func testArithmetic(t Test, c main) {
    t.assert(c.count == 0)
    c.count = 5
    t.assert(c.count == 5)
    t.assert(c.doubled == 10)
}

func testConstUsage(t Test, c main) {
    t.assert(c.MAX == 100)
    t.assert(c.MIN == 0)
}
