import macro "sngl:macro"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

#[macro.owned(release)]
struct token {
    id int
}

var log list[string] = []

func release(t token) {
    log.push("release {t.id}")
}

func report(t token) {
    log.push("tick {t.id}")
}

ui.window {
    ui.button(text="a", @click {
        report(token{id=7})
    })
    ui.button(text="b", @click {
        report(token{id=7})
    })
    ui.text(value="{log.length}")
}
