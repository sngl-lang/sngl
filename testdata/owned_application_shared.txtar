A literal of an owned type written from constants is one application-lifetime
value however many statements write it: both handlers read `__rel0`, made
once and released once at teardown. CSE's key leaves a struct literal out,
since two writings of one are two values, so the pass keys literals itself.

deny out/go/bubbletea/model.go `__rel1` -- one declaration for one value

-- app.sngl --
import macro "sngl:macro"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

#[macro.owned(release)]
struct token {
    id int
}

var log list[string] = []

func release(t token) {
    log.push("release {t.id}")
}

func report(t token) {
    log.push("tick {t.id}")
}

ui.window {
    ui.button(text="a", @click {
        report(token{id=7})
    })
    ui.button(text="b", @click {
        report(token{id=7})
    })
    ui.text(value="{log.length}")
}
