A program name a target reserves is renamed, and nothing else changes.

Each name below is ordinary SNGL and something a target's generated code
cannot hold under that spelling. `range`, `chan` and the node id `go` are Go
keywords; `object` and the parameter `class` are Kotlin's, and `class` is
JavaScript's too. `len` is a Go builtin the emitted `xs.length` calls. `m` is
the Go Model's receiver, so a parameter of that name duplicates it; `fmt` is
an import every Go target writes, and a parameter of that name hides it from
the `fmt.Sprint` beside it; `cmd`, `cmds` and `msg` are locals of
bubbletea's `Update`; `width` is a field bubbletea's Model declares for itself; `state` is
the object html's script keeps the page's state in, so a parameter of that
name hides every read of it. A component `modifier` is android's
`fun Modifier`, which the `androidx.compose.ui.Modifier` import outranks, and
a struct `model` is the Go targets' `Model`.

Each target declares what it reserves -- a language its words, a platform the
identifiers its generated code introduces -- in a const prop of its
build-target node, `reservedWords` and `reservedNames`, and
`passReservedNames` renames a declaration whose name the build reserves, with
every reference to it. A struct field keeps its name: Go exports it and
JavaScript takes a keyword as a key, so only Kotlin escapes the field `class`,
in backticks.

deny out/go/bubbletea/model.go `(?m)^\s+(range|chan|go|width)\s` -- a Go keyword or a name bubbletea's Model already has is no field name
deny out/go/fyne/model.go `(?m)^\s+(range|chan|go)\s` -- a Go keyword is no field name
deny out/go/gtk4/model.go `(?m)^\s+(range|chan|go)\s` -- a Go keyword is no field name
deny * `\(m int` -- a parameter named for the receiver duplicates it
deny * `fmt int` -- a parameter named for an import hides the import
deny * `len int` -- a parameter named for a builtin hides the builtin
deny out/go/bubbletea/model.go `type Model struct \{\n\tn int` -- the program's struct is not the Model
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `fun Modifier\(` -- the Modifier import outranks a package member of that name
deny out/kotlin/android/app/src/main/java/test/sngl/app/MainScreen.kt `var (class|object)\b` -- a Kotlin keyword is written escaped or renamed
deny out/none/html/index.html `function add\(state\)` -- a parameter named for the state object hides it

-- app.sngl --
import . "sngl:ui"
import "sngl:platform/android"
import "sngl:platform/bubbletea"
import "sngl:platform/fyne"
import "sngl:platform/gtk4"
import "sngl:platform/html"

output {
    none {
        html
    }
    kotlin {
        android
    }
    go {
        bubbletea
        fyne
        gtk4
    }
}

struct Item {
    type  string
    class int
}

struct model {
    n int
}

var range = 1
var chan = 2
var m = 3
var cmd = 4
var object = 5
var width = 6
var it = Item{type="a", class=1}
var mod = model{n=1}
var rows = [1, 2]

func bump(m int, fmt int, class int) int {
    var cmds = m + fmt
    var msg = cmds + class
    return msg
}

func longest(len int, xs list<int>) int {
    return len + xs.length
}

func add(state int) {
    object = object + state
}

component modifier(label = "") node {
    var count = 0
    button(text="{label} {count}", @click {
        count = count + 1
    })
}

window(title="reserved") {
    vbox {
        button #go(text="go {range} {chan} {m} {cmd} {object} {width} {it.type} {it.class} {mod.n}", @click {
            range = bump(range, cmd, chan)
            m = m + 1
            add(1)
            width = longest(width, rows)
            it = Item{type="b", class=it.class + 1}
            mod = model{n=mod.n + 1}
        })
        for var r = rows {
            modifier(label="w{r}")
        }
        button(text="more", @click {
            rows = [...rows, 3]
        })
    }
}
