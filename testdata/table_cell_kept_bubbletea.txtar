bubbletea's table widget reports its cursor through `Widget.binds`, a
descriptor naming `selected` by string, so an unbound `selected` is still a
cell there: `table_static_under_loop.txtar` gives html's table none, and this
is the half that must not move. The text reading `t.selected` reads that cell.

deny out/go/bubbletea/model.go `m\.t\.Selected` -- the read names the cell, not a field of the widget

-- app.sngl --
import ui "sngl:ui"

output {
    go { bubbletea }
}

ui.window(title="table") {
    ui.vbox {
        ui.table #t(columns=["name"]) {
            ui.tableRow(cells=["a"])
            ui.tableRow(cells=["b"])
        }
        ui.table(columns=["name"]) {
            ui.tableRow(cells=["c"])
        }
        ui.text(value="{t.selected}")
    }
}
-- out/go/bubbletea/model.go --
