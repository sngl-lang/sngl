A card's style's border replaces the one GTK's theme draws on its frame
rather than drawing beside it.

A card is a GtkFrame, whose theme border is on the frame's own node, so the
look's border on a plain card replaces it. A clickable card is that frame
inside a frameless GtkButton carrying the look, so the look's border was the
button's and the frame still drew the theme's inside it: two borders. The
frame inside takes `border-style: none` where the style says anything of its
border, and keeps the theme's where it says nothing.

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        gtk4
    }
}

ui.window {
    var n = 0
    ui.vbox {
        ui.card(clickable=true, style={border="2px solid #cc0000", padding=8px}, @click { n += 1 }) {
            ui.text(value="bordered {n}")
        }
        ui.card(clickable=true, style={padding=8px}, @click { n += 1 }) {
            ui.text(value="themed")
        }
    }
}
-- out/go/gtk4/callbacks.go --
// Code generated by sngl (gtk4) from app.sngl; DO NOT EDIT.

package main

import "duckfam.us/sngl/pkg/go/gtk4rt"

func main() {
	gtk4rt.Init()
	m := New()
	m.buildWidgetTree()
	gtk4rt.RunWindows(true)
}
