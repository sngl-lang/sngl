import . "sngl:time"

output {
    go {
        bubbletea
    }
    none {
        html
    }
    kotlin {
        android
    }
}

component dotted node {
    var d date = date("2026-05-09")
    var t time = time("14:30:00")
    var dt datetime = datetime("2026-05-09T14:30:00")

    text(value=string(d))
    text(value=string(t))
    text(value=string(dt))
}

window {
    dotted
    qualified
}
-- qualified.sngl --
