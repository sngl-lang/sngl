// Bug: toggle (`!!`) accepts non-bool targets.
// Per audit (internal/checker/expr.go ToggleStmt): no check that target is bool;
// codegen would emit `!x` on whatever type slipped through.
component main {
    var i int = 0
    @click {
        i!! // ERROR(check) "bool"
    }
    text(value="{i}")
}
