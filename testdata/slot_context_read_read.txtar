import . "sngl:ui"

output {
    go {
        bubbletea
    }
    kotlin {
        android
    }
    none {
        html
    }
}

context #theme("light")

component framed(caption component) node {
    caption {
        text(value="(none)")
    }
}

component main node {
    framed() {
        component caption {
            text(value=theme)
        }
    }
}

window {
    main
}
