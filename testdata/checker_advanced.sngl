struct Pair {
    key string = ""
    val int = 0
}

component main {
    const (
        MSG = "count: {string(10)}"
        ITEMS = [1, 2, 3]
        PT = Pair{key: "a", val: 1}
        UPPER = "hello".upper()
        LIST_METHOD = string.length("test")
    )

    var count = 0
    var flag = true
    var label = "hello"
    var items = [10, 20, 30]
    var pair = Pair("key", 5)

    func interp() => "val: {string(count)}"
    func list() => [count, count + 1]
    func structVal() => Pair{key: label, val: count}
    func elemType() => items[0]
    func fieldType() => pair.key

    func myFunc() => 42

    vbox {
        text(value=interp)
        text(value=string(list[0]))
        button(text="add", @click={
            count += 1
            flag!!
        })
        button(text="reset", @click={ count = 0 })
    }
}

func testBasic(t T, c main) {
    t.assert(c.count == 0)
    t.assert(c.flag == true)
    t.assert(c.label == "hello")
}
