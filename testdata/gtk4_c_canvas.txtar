gtk4 draws a canvas in C as a GtkDrawingArea rt makes, whose draw function
paints the shapes with cairo once rt has scaled the context: the file's for the
board, and the record's for a dot, handed the record as its data. The
drawing reads state as the body does -- `hits` and `n` through the boxes NoRef
made of them, which it reaches through the flattened canvas -- and a click,
which a drawing area takes through a GtkGestureClick, queues a redraw.

The style's line cap is a member of an enum the shape's override brought
with it, which NoEnum, run after the splice, makes the ordinal C writes.

-- app.sngl --
import ui "sngl:ui"
import c "sngl:language/c"
import test "sngl:test"
import draw "sngl:ui/draw"

output {
    c {
        gtk4(gir="builtin")
    }
}

component dot(r float) ui.node {
    var n = 0
    ui.vbox {
        draw.canvas(width=40px, height=40px) {
            draw.circle(cx=20.0, cy=20.0, r=r + float(n))
        }
        ui.button(text="grow", @click {
            n += 1
        })
    }
}

component main ui.node {
    var hits = 0
    var rs = [4.0, 8.0]
    ui.vbox {
        draw.canvas #board(width=40px, height=40px, scalingMode=draw.ScalingMode.fit, @click {
            hits += 1
        }) {
            draw.rect(x=0.0, y=0.0, w=float(hits), h=10.0, style=draw.Style{lineCap=draw.LineCap.round})
        }
        for var r = rs {
            dot(r=r)
        }
    }
}

ui.window(title="t") {
    main()
}

func testClickRedraws(t test.Test, c main) {
    c.board.click()
    c.board.click()
    t.assert(c.hits == 2)
}
