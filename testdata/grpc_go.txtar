A grpc.call is written as code over the program's own Go types: a writer, a
reader and a zero per message it reaches and a number and a member lookup per
enum, each a protowire call per field, with snglgrpc carrying the bytes. No
descriptor and no reflection reaches the program.

deny out/go/bubbletea/model.go `protoreflect|dynamicpb|protojson` -- the messages are the program's own structs, written field by field

-- app.sngl --
import async "sngl:async"
import grpc "sngl:grpc"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

enum Kind {
    #[grpc.value(0)]
    unknown
    #[grpc.value(3)]
    paperback
}

#[grpc.message("shop.Tag")]
struct Tag {
    #[grpc.field(1)]
    name string = ""
}

enum Where {
    none
    #[grpc.field(8)]
    shelf string
    #[grpc.field(9)]
    held  Tag
}

#[grpc.message("shop.Book")]
struct Book {
    #[grpc.field(1, int32)]
    id     int = 0
    #[grpc.field(2)]
    kind   Kind = Kind.unknown
    #[grpc.field(3, sint64)]
    ranks  list[int] = []
    #[grpc.field(4)]
    tags   list[Tag] = []
    #[grpc.field(5)]
    scores map[string, float] = {}
    #[grpc.field(6)]
    next   option[Tag] = null
    #[grpc.field(7, bytes)]
    cover  string = ""
    where  Where = Where.none
}

#[grpc.message("shop.Get")]
struct Get {
    #[grpc.field(1, int32)]
    id int = 0
}

func fetch(id int) async.Result[Book] {
    return grpc.call[Get, Book](server="localhost:50051", method="/shop.Shop/GetBook", request={id=id})
}

component main ui.node {
    var title = "-"
    ui.button(text="Fetch", @click {
        match var b = fetch(1) {
            ok { title = "{b.id}" }
            failed { title = b.code }
        }
    })
    ui.text(value=title)
}

ui.window {
    main
}
-- out/go/bubbletea/model.go --
