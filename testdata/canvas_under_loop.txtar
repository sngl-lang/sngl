import "C"

import (
	"duckfam.us/sngl/pkg/go/snglcolor"
	"unsafe"
)

type PathCmd struct {
	Op  string
	X   float64
	Y   float64
	Cx1 float64
	Cy1 float64
	Cx2 float64
	Cy2 float64
	R   float64
}

// _snglCairoScale maps a drawing's own coordinate space onto the size GTK is
