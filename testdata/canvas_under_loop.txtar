A canvas under a `for` is a component built at run time, one per copy.

A canvas lowers to a surface and a draw routine its owner holds -- one field
and one method -- so the copies of a loop shared both: every copy painted into
the one surface, and the routine read the loop variable in a method that never
bound it, which fyne and gtk4 did not build. passCanvasInstances makes each
such canvas an instance whose record holds its own surface and routine; what
the drawing reads from the loop and from the page arrives as props, which the
loop's render slot sets again when either changes, and each setter redraws. A
handler written on the canvas crosses as an event, so `grow += 1.0` still
writes the page's state.

deny out/go/fyne/model.go `func \(m \*Model\) _canvasDraw` -- the drawing belongs to the copy's record
deny out/go/gtk4/model.go `func \(m \*Model\) _canvasDraw` -- as above
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"
import draw "sngl:ui/draw"

output {
    go {
        fyne
        gtk4
    }
    none {
        html
    }
}

component main node {
    var rs = [4.0, 8.0]
    var grow = 0.0

    vbox {
        for var r = rs {
            draw.canvas(width=40px, height=40px, @click { grow += 1.0 }) {
                draw.circle(cx=20, cy=20, r=r + grow, style=draw.Style{})
            }
        }
        for var r = [3.0, 5.0] {
            draw.canvas(width=40px, height=40px) {
                draw.circle(cx=20, cy=20, r=r, style=draw.Style{})
            }
        }
        button #add(text="add", @click {
            rs.push(12.0)
            grow += 1.0
        })
    }
}

func testGrows(t Test, c main) {
    c.add.click()
    t.assert(c.rs.length == 3)
}

window {
    main
}
