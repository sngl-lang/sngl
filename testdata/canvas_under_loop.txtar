package main

import "testing"

func TestGrows(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.addClick()
	if !((len(c.rs) == 3)) { t.Errorf("assert failed: %s", "(len(c.rs) == 3)") }
}

