A program that imports another platform's package -- here sngl:platform/none,
to write an override for it -- still gets the build target's own protocol
functions: placement splices win32's attach for the program's root whatever
the program names, so `_attachNode` and the helpers it calls are promoted
from the target's protocol and not only when some override happened to call
into the target's package.

-- app.sngl --
import "sngl:platform/none"
import ui "sngl:ui"

output {
    go {
        win32
    }
}

// Rendered on none alone; win32 builds the window without it.
component badge(label string) ui.node

component badge[none.platform](label) {
    ui.text(value=label)
}

component main ui.node {
    var n = 0
}

ui.window(title="w") {
    main
}
