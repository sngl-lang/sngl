A style field that reads state, on fyne.

Fyne has no per-widget paint: a color, a text size or a face belongs to a
theme, and a node gets one of its own through a `container.ThemeOverride`. The
build resolves a style it can read into a theme declared once
(`_snglTheme0` below), and a field reading state read as nothing -- so
`color = active == 0 ? … : …` came out as a `var __lt1` computed and never
used, in BuildUI and in the handler, which Go refuses to compile.

A node with such a field is now wrapped in its override when it is created,
and every write to its `style` -- first render, and each one the lowering puts
in a handler -- rebuilds the theme from the whole literal and refreshes the
override. The fields the build can read come along in that rebuild
(`fontStyle`, the static background). A node whose style reads no state keeps
its build-time theme. The row is a runtime instance, whose record holds its
own override. The tagged text is a plain node in a reactive loop, where
NoTernary's temp lands between the node's prop writes rather than ahead of
its create; its slot records the override, so a re-render removes it.

The override is a fynelayout.Box's now, and a write of `style` is a write of
the look style.sngl's lookOf builds from the whole Style, set on the box.

deny out/go/fyne/model.go `__lt\d+ = [^\n]*\n\t+\}\n\t*\}\n` -- a temp the lowering computes for a style field is read by the look write after it, not dropped at the end of the block
-- style.sngl --
import ui "sngl:ui"

output {
    go {
        fyne
    }
}

component row(label string) ui.node {
    var on = false

    ui.button(
        text = label,
        style = {
            fontWeight = on ? bold : normal,
            background = on ? #ff0000 : #0000ff,
        },
        @click { on = !on },
    )
}

ui.window {
    var active = 0
    var tags = ["p", "q"]

    ui.button(text="x", @click { active = 1 })
    ui.button(text="more", @click { tags = ["p", "q", "r"] })
    ui.text(value="hint", style={
        color = active == 0 ? #ffffff : #33333380,
        fontSize = 1px * (active * 4 + 12),
        fontStyle = italic,
    })
    ui.vbox(style={background=#101010, borderRadius=2px * active}) {
        ui.text(value="static", style={color=#00ff00})
        for var it = ["a", "b"] {
            row(label=it)
        }
    }
    for var t = tags {
        ui.text(value=t, style={color=active == 0 ? #ff0000 : #00ff00})
    }
}
