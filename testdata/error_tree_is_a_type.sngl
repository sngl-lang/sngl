// What the tree model refuses at a use site.

import . "sngl:ui"
import build "sngl:build"

component block build.family

component inline build.family

component document(children ...component block) node {}
component para(children ...component inline) block {}
component bold(weight int) inline {}

component main node {
    // A family is a type, whose values are handles to its members, and not
    // a value itself.
    var bad block = 0 // ERROR(check) "cannot initialize block with int"
    var named = block // ERROR(check) "block names a family, which is not a value"

    document() {
        bold(weight=700) // ERROR(check) "expected block component in document, got bold"
    }

    document() {
        para() {
            // A member with no slot hosts nothing: the old "a shape contains
            // shapes without saying so" rule is gone.
            bold(weight=1) { // ERROR(check) "does not accept children"
                bold(weight=2)
            }
        }
    }
}

window {
    main
}
