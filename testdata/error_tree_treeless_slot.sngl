// A component that takes the family it is placed in may render nothing of a
// family of its own, and inserting a slot that takes widgets puts widgets
// where it stands. The rule read the nodes a body renders and passed over a
// slot insertion, so this checked clean -- and the wrapper, placeable in any
// family, carried a button into a canvas, where html painted nothing for it and
// said nothing.
//
// Crossing a family is said at the placement, with #[family.crosses].

import ui "sngl:ui"
import draw "sngl:ui/draw"

component sneak<F>(content ...component ui.node) F {
    content // ERROR(check) "component sneak takes the family it is placed in, so it may not contain the node slot content"
}

ui.window(title="t") {
    draw.canvas(width=100px, height=100px) {
        sneak {
            ui.button(text="hi")
        }
    }
}
