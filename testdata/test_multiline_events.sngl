import . "sngl:ui"
import . "sngl:test"

component multi {
    var a = 0
    var b = 0
    var c = 0

    button #inc(text="go", @click {
        a += 1
        b += 2
        c += 3
    })
    text(value="{a}")
}

func testCompoundMutations(t Test, c multi) {
    c.a = 1
    c.b = 2
    c.a += c.b
    t.assert(c.a == 3)
}

func testMultipleAssignments(t Test, c multi) {
    c.a = 10
    c.b = 20
    c.c = c.a + c.b
    t.assert(c.c == 30)
}
