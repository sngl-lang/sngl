component main {
    text(value="test")
}

func testIntMinMaxAbsClamp(t T, c main) {
    t.assert(int.min(3, 7) == 3)
    t.assert(int.min(-1, 5) == -1)
    t.assert(int.max(3, 7) == 7)
    t.assert(int.max(-1, 5) == 5)
    t.assert(int.abs(-5) == 5)
    t.assert(int.abs(5) == 5)
    t.assert(int.clamp(5, 0, 10) == 5)
    t.assert(int.clamp(-5, 0, 10) == 0)
    t.assert(int.clamp(15, 0, 10) == 10)
}

func testIntMethodSyntax(t T, c main) {
    t.assert((-3).abs() == 3)
    t.assert((3).min(5) == 3)
    t.assert((3).max(5) == 5)
}

func testFloatMinMaxAbsClamp(t T, c main) {
    t.assert(float.min(1.5, 2.5) == 1.5)
    t.assert(float.max(1.5, 2.5) == 2.5)
    t.assert(float.abs(-3.14) == 3.14)
    t.assert(float.clamp(0.5, 0.0, 1.0) == 0.5)
    t.assert(float.clamp(-0.5, 0.0, 1.0) == 0.0)
    t.assert(float.clamp(1.5, 0.0, 1.0) == 1.0)
}

func testFloatFloorCeilRound(t T, c main) {
    t.assert(float.floor(3.7) == 3)
    t.assert(float.floor(-1.2) == -2)
    t.assert(float.ceil(3.2) == 4)
    t.assert(float.ceil(-1.7) == -1)
    t.assert(float.round(3.5) == 4)
    t.assert(float.round(3.4) == 3)
    t.assert(float.round(-0.5) == -1)
}

func testFloatSqrt(t T, c main) {
    t.assert(float.sqrt(4.0) == 2.0)
    t.assert(float.sqrt(9.0) == 3.0)
    t.assert(float.sqrt(0.0) == 0.0)
}

func testFloatPow(t T, c main) {
    t.assert(float.pow(2.0, 3.0) == 8.0)
    t.assert(float.pow(3.0, 2.0) == 9.0)
    t.assert(float.pow(2.0, 0.0) == 1.0)
}

func testFloatTrig(t T, c main) {
    t.assert(float.sin(0.0) == 0.0)
    t.assert(float.cos(0.0) == 1.0)
    t.assert(float.tan(0.0) == 0.0)
}

func testFloatInverseTrig(t T, c main) {
    t.assert(float.asin(0.0) == 0.0)
    t.assert(float.acos(1.0) == 0.0)
    t.assert(float.atan(0.0) == 0.0)
}

func testStringLength(t T, c main) {
    t.assert(string.length("hello") == 5)
    t.assert(string.length("") == 0)
    t.assert("hello".length() == 5)
}

func testStringMethods(t T, c main) {
    t.assert(string.upper("hello") == "HELLO")
    t.assert(string.lower("HELLO") == "hello")
    t.assert(string.trim("  hi  ") == "hi")
    t.assert(string.replace("hello world", "world", "SNGL") == "hello SNGL")
    t.assert(string.indexOf("hello", "llo") == 2)
    t.assert(string.indexOf("hello", "xyz") == -1)
    t.assert(string.substring("hello", 1, 4) == "ell")
}

func testStringContainsStartsWithEndsWith(t T, c main) {
    t.assert(string.contains("hello world", "world"))
    t.assert(!string.contains("hello", "xyz"))
    t.assert(string.startsWith("hello", "hel"))
    t.assert(!string.startsWith("hello", "xyz"))
    t.assert(string.endsWith("hello", "llo"))
    t.assert(!string.endsWith("hello", "xyz"))
}

func testStringMethodSyntax(t T, c main) {
    t.assert("hello".upper() == "HELLO")
    t.assert("HELLO".lower() == "hello")
    t.assert("  hi  ".trim() == "hi")
}

func testColorAsStruct(t T, c main) {
    t.assert(#ff0000.r == 255)
    t.assert(#ff0000.g == 0)
    t.assert(#ff0000.b == 0)
    t.assert(#ff0000.a == 255)
}

func testColorRgb(t T, c main) {
    t.assert(color.rgb(255, 0, 0).r == 255)
    t.assert(color.rgb(255, 0, 0).g == 0)
    t.assert(color.rgb(0, 128, 255).g == 128)
    t.assert(color.rgb(0, 0, 0).a == 255)
}

func testColorRgba(t T, c main) {
    t.assert(color.rgba(255, 0, 0, 128).r == 255)
    t.assert(color.rgba(255, 0, 0, 128).a == 128)
}

func testColorOpacity(t T, c main) {
    t.assert(color.opacity(#ff0000, 128).r == 255)
    t.assert(color.opacity(#ff0000, 128).a == 128)
}

func testColorHex(t T, c main) {
    t.assert(color.hex(#ff0000) == "#ff0000")
    t.assert(color.hex(color.rgb(0, 255, 0)) == "#00ff00")
}

func testListMethods(t T, c main) {
    t.assert(list.indexOf([1, 2, 3], 2) == 1)
    t.assert(list.indexOf([1, 2, 3], 5) == -1)
    t.assert(list.join(["a", "b", "c"], ", ") == "a, b, c")
    t.assert(list.contains([1, 2, 3], 2))
    t.assert(!list.contains([1, 2, 3], 5))
}
