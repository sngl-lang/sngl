component main {
    text(value="test")
}

test main "int.min/max/abs/clamp" {
    assert(int.min(3, 7) == 3)
    assert(int.min(-1, 5) == -1)
    assert(int.max(3, 7) == 7)
    assert(int.max(-1, 5) == 5)
    assert(int.abs(-5) == 5)
    assert(int.abs(5) == 5)
    assert(int.clamp(5, 0, 10) == 5)
    assert(int.clamp(-5, 0, 10) == 0)
    assert(int.clamp(15, 0, 10) == 10)
}

test main "int method syntax" {
    assert((-3).abs() == 3)
    assert((3).min(5) == 3)
    assert((3).max(5) == 5)
}

test main "float.min/max/abs/clamp" {
    assert(float.min(1.5, 2.5) == 1.5)
    assert(float.max(1.5, 2.5) == 2.5)
    assert(float.abs(-3.14) == 3.14)
    assert(float.clamp(0.5, 0.0, 1.0) == 0.5)
    assert(float.clamp(-0.5, 0.0, 1.0) == 0.0)
    assert(float.clamp(1.5, 0.0, 1.0) == 1.0)
}

test main "float.floor/ceil/round" {
    assert(float.floor(3.7) == 3)
    assert(float.floor(-1.2) == -2)
    assert(float.ceil(3.2) == 4)
    assert(float.ceil(-1.7) == -1)
    assert(float.round(3.5) == 4)
    assert(float.round(3.4) == 3)
    assert(float.round(-0.5) == -1)
}

test main "float.sqrt" {
    assert(float.sqrt(4.0) == 2.0)
    assert(float.sqrt(9.0) == 3.0)
    assert(float.sqrt(0.0) == 0.0)
}

test main "float.pow" {
    assert(float.pow(2.0, 3.0) == 8.0)
    assert(float.pow(3.0, 2.0) == 9.0)
    assert(float.pow(2.0, 0.0) == 1.0)
}

test main "float trig" {
    assert(float.sin(0.0) == 0.0)
    assert(float.cos(0.0) == 1.0)
    assert(float.tan(0.0) == 0.0)
}

test main "float inverse trig" {
    assert(float.asin(0.0) == 0.0)
    assert(float.acos(1.0) == 0.0)
    assert(float.atan(0.0) == 0.0)
}

test main "string methods" {
    assert(string.upper("hello") == "HELLO")
    assert(string.lower("HELLO") == "hello")
    assert(string.trim("  hi  ") == "hi")
    assert(string.replace("hello world", "world", "SNGL") == "hello SNGL")
    assert(string.indexOf("hello", "llo") == 2)
    assert(string.indexOf("hello", "xyz") == -1)
    assert(string.substring("hello", 1, 4) == "ell")
}

test main "string method syntax" {
    assert("hello".upper() == "HELLO")
    assert("HELLO".lower() == "hello")
    assert("  hi  ".trim() == "hi")
}

test main "color.rgb" {
    assert(color.rgb(255, 0, 0) == #ff0000)
    assert(color.rgb(0, 255, 0) == #00ff00)
    assert(color.rgb(0, 0, 255) == #0000ff)
}

test main "list methods" {
    assert(list.indexOf([1, 2, 3], 2) == 1)
    assert(list.indexOf([1, 2, 3], 5) == -1)
    assert(list.join(["a", "b", "c"], ", ") == "a, b, c")
}
