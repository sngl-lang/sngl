A datepicker's value is two-way: a pick writes the var `:value` bound, from
the date the change event carries. testdata/datepicker_two_way.sngl runs that
on the interpreter; this is the code each target generates for it. html builds that payload from the input's
"YYYY-MM-DD" text; gtk4 reads it off the GtkCalendar with
gtk4rt.CalendarGetDate, since the day-selected signal carries nothing.

-- datepicker_two_way.sngl --
import . "sngl:ui"
import time "sngl:time"

// A datepicker's value is a two-way prop: a pick writes the var it is bound to,
// from the date the change event carries, and clearing it writes null.
component picker node {
    var picked option<time.date> = null
    var changes = 0
    vbox {
        datepicker #d(:value=picked, @change { changes += 1 })
        text(value=picked != null ? string(picked) : "none")
    }
}

window {
    picker()
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
