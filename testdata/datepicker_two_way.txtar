A datepicker's value is two-way: a pick writes the var `:value` bound, from
the date the host reports. testdata/datepicker_two_way.sngl runs that on the
interpreter; this is the code each target generates for it. Each override
writes `value` itself, which is the binding's write-back: html builds the date
from the input's "YYYY-MM-DD" text, and gtk4 reads it off the GtkCalendar the
day-selected signal fired on, with gtk4rt.CalendarGetDate.

-- datepicker_two_way.sngl --
import . "sngl:ui"
import time "sngl:time"

// A datepicker's value is a two-way prop: a pick writes the var it is bound to,
// from the date the change event carries, and clearing it writes null.
component picker node {
    var picked option[time.date] = null
    var changes = 0
    vbox {
        datepicker #d(:value=picked, @change { changes += 1 })
        text(value=picked != null ? string(picked) : "none")
    }
}

window {
    picker()
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
