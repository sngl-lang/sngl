// A mark annotates a declaration, and a function or lambda parameter is not
// one, so every mark there is refused — whether or not the name it gives
// resolves to a macro.
//
// A component prop is the exception: #[macro.wildcard] says something about
// one. So a mark written there is resolved first, and a name that names no
// macro is reported as the unknown macro it is rather than as an illegal
// position.

import . "sngl:ui"
import "sngl:ui/draw"
import "sngl:macro"
import app "sngl:app"

func unknownPkg(#[nosuch.mark("x")] a string) => a // ERROR(check) "#[nosuch.mark] cannot mark a parameter"

func unknownName(#[draw.nosuch] a string) => a // ERROR(check) "#[draw.nosuch] cannot mark a parameter"

func realMacro(#[macro.wildcard(".*")] a string) => a // ERROR(check) "#[macro.wildcard] cannot mark a parameter"

func inLambda() => func(#[macro.wildcard(".*")] a int) => a // ERROR(check) "#[macro.wildcard] cannot mark a parameter"

component element(
    tag string,
    #[macro.foreign("go:example.com/api", "Attrs")] attributes map<string, string>, // ERROR(check) "#[macro.foreign] cannot mark a parameter"
    #[nosuch.mark] extra string = "",                                               // ERROR(check) "unknown macro package"
) ui {
    text(value=tag)
}

app.window {
}
