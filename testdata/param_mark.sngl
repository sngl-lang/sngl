// A mark annotates a declaration, and a lambda parameter is not one, so every
// mark there is refused — whether or not the name it gives resolves to a
// macro.
//
// A component prop and a declared function's parameter are the exceptions:
// #[macro.wildcard] says something about the one, #[macro.moves] about the
// other. So a mark written there is resolved first, and a name that names no
// macro is reported as the unknown macro it is rather than as an illegal
// position.

import . "sngl:ui"
import "sngl:ui/draw"
import "sngl:macro"

func unknownPkg(#[nosuch.mark("x")] a string) => a // ERROR(check) "unknown macro package \"nosuch\""

func unknownName(#[draw.nosuch] a string) => a // ERROR(check) "unknown macro \"nosuch\""

func realMacro(#[macro.wildcard(".*")] a string) => a // ERROR(check) "#[macro.wildcard] cannot mark a parameter"

func inLambda() => func(#[macro.wildcard(".*")] a int) => a // ERROR(check) "#[macro.wildcard] cannot mark a parameter"

component element(
    tag string,
    #[macro.foreign("go:example.com/api", "Attrs")] attributes map[string, string], // ERROR(check) "#[macro.foreign] cannot mark a parameter"
    #[nosuch.mark] extra string = "",                                               // ERROR(check) "unknown macro package"
) node {
    text(value=tag)
}

window {
}
