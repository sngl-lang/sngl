Go codegen for i18n.plural/selectordinal/exactly: runtime wiring.

i18n runtime package is imported.

i18n.plural emits i18n.Plural(locale, count, forms) with the locale
threaded from the active context. forms is map[i18n.PluralKey]string.

i18n.exactly(0) emits i18n.Exactly(0).

CLDR keyword constants emit i18n.PluralOne, i18n.PluralOther, etc.

i18n.selectordinal emits i18n.Selectordinal(locale, count, forms).
-- app.sngl --
import . "sngl:ui"
import "sngl:i18n"

output { go { bubbletea } }

component main {
    var count = 5
    var msg = i18n.plural(count, {
        i18n.exactly(0) = "no items",
        i18n.one = "1 item",
        i18n.other = "many items",
    })

    var place = 21
    var ordinal = i18n.selectordinal(place, {
        i18n.one = "1st",
        i18n.two = "2nd",
        i18n.few = "3rd",
        i18n.other = "nth",
    })

    text(value=msg)
    text(value=ordinal)
}
-- out/go/bubbletea/model.go --
