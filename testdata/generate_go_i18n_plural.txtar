Go codegen for `i18n.plural`, `i18n.selectordinal` and `i18n.exactly` -- the
runtime wiring rather than the message text. The generated model imports
pkg/go/i18n and calls i18n.Plural and i18n.Selectordinal with the locale
threaded from the active context (m.__ctx_locale) and the forms as a
map[i18n.PluralKey]string. `i18n.exactly(0)` becomes i18n.Exactly(0), and the
CLDR keywords become the i18n.PluralOne / PluralFew / PluralOther constants.
-- app.sngl --
import . "sngl:ui"
import "sngl:i18n"

output { go { bubbletea } }

component main node {
    var count = 5
    var msg = i18n.plural(count, {
        i18n.exactly(0) = "no items",
        i18n.one = "1 item",
        i18n.other = "many items",
    })

    var place = 21
    var ordinal = i18n.selectordinal(place, {
        i18n.one = "1st",
        i18n.two = "2nd",
        i18n.few = "3rd",
        i18n.other = "nth",
    })

    text(value=msg)
    text(value=ordinal)
}

window {
    main
}
