import . "sngl:ui"

func phase() int {
    enum Phase {
        start
        done
    }
    unit tick { tk, kt = 10tk }

    var p = Phase.done
    var elapsed tick = 3tk
    if p == Phase.done {
        return int(elapsed)
    }
    return 0
}

component main node {
    text(value="${phase()}")
}

window {
    main
}
