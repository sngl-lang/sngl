import . "sngl:ui"
import app "sngl:app"

func phase() int {
    enum Phase {
        start
        done
    }
    unit tick { tk, kt = 10tk }

    var p = Phase.done
    var elapsed tick = 3tk
    if p == Phase.done {
        return elapsed.value
    }
    return 0
}

component main ui {
    text(value="${phase()}")
}

app.window {
    main
}
