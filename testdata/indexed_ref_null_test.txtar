A test null-tests one copy of a node a loop renders under an `if`,
`c.only[1] == null`, on every target. `c.only` is a list with an option per
iteration, so the index names an iteration and the copy is the one carrying
that iteration's key (ir.CopyKey), which passCopyKeys stamps on every id a
test reaches through an index (ir.IndexedRefIDs) -- a null test as well as a
trigger. Each language's test lowerer calls `<id>PresentAt` with the key
(codegen.PresenceAtMethod), as it calls `<id>Present` for a plain ref; html
queries for the key, fyne and gtk4 look in the id's map of copies, and
bubbletea walks the view as View renders it. Kotlin asks the semantics tree
for a node carrying the tag and the key.

cmd/sngl/testdata/indexed_ref_null_test_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component main node {
    var items = ["a", "b", "c"]
    var skip = "a"
    var log = ""
    vbox {
        button #change(text="skip b", @click { skip = "b" })
        for var it = items {
            if it != skip {
                button #only(text=it, @click { log = it })
                checkbox #tick(label=it, @change(on) { log = "{it} {on}" })
            }
        }
        text(value=log)
    }
}

func testOneCopyIsRendered(t Test, c main) {
    t.assert(c.only[0] == null)
    t.assert(c.tick[0] == null)
    if c.only[1] != null {
        c.only[1].click()
    }
    t.assert(c.log == "b")
    t.assert(c.tick[2] != null)
}

func testAfterTheBranchChanges(t Test, c main) {
    c.change.click()
    t.assert(c.only[0] != null)
    t.assert(c.only[1] == null)
    t.assert(c.tick[1] == null)
    t.assert(c.tick[0] != null)
}

window {
    main
}
