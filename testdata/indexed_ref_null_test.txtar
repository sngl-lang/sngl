package main

import "testing"

func TestOneCopyIsRendered(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(!c.onlyPresentAt("0")) { t.Errorf("assert failed: %s", "!c.onlyPresentAt(\"0\")") }
	if !(!c.tickPresentAt("0")) { t.Errorf("assert failed: %s", "!c.tickPresentAt(\"0\")") }
	if c.onlyPresentAt("1") {
		c.onlyClickAt("1")
	}
	if !((c.log == "b")) { t.Errorf("assert failed: %s", "(c.log == \"b\")") }
	if !(c.tickPresentAt("2")) { t.Errorf("assert failed: %s", "c.tickPresentAt(\"2\")") }
}

func TestAfterTheBranchChanges(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.changeClick()
	if !(c.onlyPresentAt("0")) { t.Errorf("assert failed: %s", "c.onlyPresentAt(\"0\")") }
	if !(!c.onlyPresentAt("1")) { t.Errorf("assert failed: %s", "!c.onlyPresentAt(\"1\")") }
	if !(!c.tickPresentAt("1")) { t.Errorf("assert failed: %s", "!c.tickPresentAt(\"1\")") }
	if !(c.tickPresentAt("0")) { t.Errorf("assert failed: %s", "c.tickPresentAt(\"0\")") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
