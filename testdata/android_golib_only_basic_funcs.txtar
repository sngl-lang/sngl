Under `--lang go` android's golib is a gomobile module: it declares no types
and holds no state, and gomobile binds only a basic signature. So a function
is golib's only when its signature is basic, nothing in its body has a type
the module would have to declare, it reads no var but a const, it raises
nothing -- a Go panic through gomobile ends the process -- and every function
it calls is golib's too. Every other function is Kotlin's, in MainScreen.kt.
Here `sum` is golib's and the rest are Kotlin's. Each recurses, so the
inliner cannot fold it away.

deny out/go/android/golib/golib.go `Point` -- golib declares no types, so no function naming one is its
unverifiable out/go/android -- the emitted project consumes a golib.aar produced by a `gomobile bind` step that generation does not perform

-- app.sngl --
import ui "sngl:ui"

output {
    go {
        android
    }
}

struct Point {
    x int = 0
    y int = 0
}

const step = 1

var total = 0

func sum(n int) int {
    if n <= 0 {
        return 0
    }
    return n + sum(n - step)
}

func norm(n int) int {
    if n <= 0 {
        return 0
    }
    var p = Point{x=n, y=n}
    return p.x + norm(n - 1)
}

func risky(n int) int {
    if n > 9 {
        error.raise("too big", "range")
    }
    if n <= 0 {
        return 0
    }
    return risky(n - 1)
}

func withTotal(n int) int {
    if n <= 0 {
        return total
    }
    return withTotal(n - 1)
}

func chained(n int) int {
    if n <= 0 {
        return norm(n + 1)
    }
    return chained(n - 1)
}

ui.window(title="golib") {
    ui.text(value="{sum(total)} {norm(total)} {risky(total)} {withTotal(total)} {chained(total)}")
    ui.button(text="add", @click { total += 1 })
}
