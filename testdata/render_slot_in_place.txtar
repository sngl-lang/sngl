package main

import "testing"

func TestReRenders(t *testing.T) {
	__snglTestComponent := newTestComponent()
	c := __snglTestComponent
	_ = c
	c.flipClick()
	c.flipClick()
	c.moreClick()
	if !(c.a) { t.Errorf("assert failed: %s", "c.a") }
}

