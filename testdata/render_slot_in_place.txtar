A render slot re-renders where it was written.

Each fyne and gtk4 slot removed what it had rendered and appended what it
renders now to the end of its container, so toggling `a` off and on moved A
after B, after the loop's rows and after every static sibling below it. A fyne
slot now keeps a hidden anchor in its container, added by its first render --
which runs while the container is being built, at the slot's own position --
and inserts its entries before it; codegen/platform/fyne/slot_order_run_test.go
reads the order back off the running widget tree. A gtk4 slot keeps an anchor
too (`cgo.SnglSlotAnchor`, the platform's `#[gen.protocol(anchor)]`), and
each entry goes before the one the slot rendered in its place last time, or
before the anchor past those (`cgo.SnglBoxInsertBefore`);
cmd/sngl/testdata/render_slot_keeps_its_place_runs.txt compares the pictures.

deny out/go/fyne/model.go `container\.Add\(` -- a slot inserts before its anchor; appending is what lost the order
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
        gtk4
    }
}

component main node {
    var a = true
    var items = ["x", "y"]

    vbox {
        text(value="head")
        if a {
            text(value="A")
        }
        for var it = items {
            text(value=it)
        }
        text(value="tail")
        button #flip(text="flip", @click { a = !a })
        button #more(text="more", @click { items.push("z") })
    }
}

func testReRenders(t Test, c main) {
    c.flip.click()
    c.flip.click()
    c.more.click()
    t.assert(c.a)
}

window {
    main
}
