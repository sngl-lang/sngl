A render slot re-renders where it was written.

Each fyne and gtk4 slot removed what it had rendered and appended what it
renders now to the end of its container, so toggling `a` off and on moved A
after B, after the loop's rows and after every static sibling below it. A slot
now keeps a hidden anchor in its container, added by its first render -- which
runs while the container is being built, at the slot's own position -- and
inserts its entries before it. codegen/platform/fyne/slot_order_run_test.go
reads the order back off the running widget tree, and pkg/go/gtk4rt's
TestSlotAnchorKeepsASlotInPlace does the same for GTK.

deny out/go/fyne/model.go `container\.Add\(` -- a slot inserts before its anchor; appending is what lost the order
deny out/go/gtk4/model.go `BoxAppend\(parent` -- as above, for the gtk4 box
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
        gtk4
    }
}

component main node {
    var a = true
    var items = ["x", "y"]

    vbox {
        text(value="head")
        if a {
            text(value="A")
        }
        for var it = items {
            text(value=it)
        }
        text(value="tail")
        button #flip(text="flip", @click { a = !a })
        button #more(text="more", @click { items.push("z") })
    }
}

func testReRenders(t Test, c main) {
    c.flip.click()
    c.flip.click()
    c.more.click()
    t.assert(c.a)
}

window {
    main
}
