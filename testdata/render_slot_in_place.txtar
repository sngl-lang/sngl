package main

import "testing"

func TestReRenders(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.flipClick()
	c.flipClick()
	c.moreClick()
	if !(c.a) { t.Errorf("assert failed: %s", "c.a") }
}

