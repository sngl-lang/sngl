package main

import "testing"

func TestSplicedCopies(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(c.onePresent()) { t.Errorf("assert failed: %s", "c.onePresent()") }
	if !(c.alwaysPresent()) { t.Errorf("assert failed: %s", "c.alwaysPresent()") }
	if !(c.rPresent()) { t.Errorf("assert failed: %s", "c.rPresent()") }
	if !(c.thPresentAt("0")) { t.Errorf("assert failed: %s", "c.thPresentAt(\"0\")") }
	if !(!c.thPresentAt("1")) { t.Errorf("assert failed: %s", "!c.thPresentAt(\"1\")") }
	if !(c.wPresentAt("1")) { t.Errorf("assert failed: %s", "c.wPresentAt(\"1\")") }
	if !(!c.wPresentAt("2")) { t.Errorf("assert failed: %s", "!c.wPresentAt(\"2\")") }
	if !(c.pPresentAt("1")) { t.Errorf("assert failed: %s", "c.pPresentAt(\"1\")") }
	if !(!c.pPresentAt("2")) { t.Errorf("assert failed: %s", "!c.pPresentAt(\"2\")") }
	if !(c.sPresentAt("0")) { t.Errorf("assert failed: %s", "c.sPresentAt(\"0\")") }
	if !(!c.sPresentAt("1")) { t.Errorf("assert failed: %s", "!c.sPresentAt(\"1\")") }
	if !(c.ePresentAt("0")) { t.Errorf("assert failed: %s", "c.ePresentAt(\"0\")") }
	if !(!c.ePresentAt("1")) { t.Errorf("assert failed: %s", "!c.ePresentAt(\"1\")") }
	if !(c.fPresentAt("0")) { t.Errorf("assert failed: %s", "c.fPresentAt(\"0\")") }
