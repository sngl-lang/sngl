One copy of a spliced component instance a test null-tests, where the
instance has no node of its own: a body that opens with an `if` or a `for`,
one passNoInlineComponents splices into a block's state record, one under a
boundary, and one rendered once. bubbletea answers from the roots the splice
records (ir.InstancesOf); html, fyne, gtk4 and android from the
`__instance_<id>` prop passCopyKeys stamps on each root node, holding the
copy's key: html's `data-sngl-root-<id>`, fyne's and gtk4's maps of the
instance's copies and its present field, and android's SnglPresent. A node
under a loop with no `if` between is null-tested by copy too, and `c.r`, a
recursive instance html places at a fixed position, carries
`data-sngl-instance` there.

cmd/sngl/testdata/indexed_ref_null_test_spliced_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component plain(label string) node {
    text(value=label)
}

component shouting(label string) node {
    func shout() string {
        return label + "!"
    }
    text(value=shout())
}

component either(label string) node {
    if label == "a" {
        text(value=label)
    } else {
        text(value="z")
    }
}

component each(label string) node {
    for var i = [1, 2] {
        text(value="{label}{i}")
    }
}

component step(n int) node {
    vbox {
        text(value="s{n}")
        if n > 0 {
            step(n=n - 1)
        }
    }
}

component thrower(label string) node {
    func check() {
        if label == "x" {
            error.raise("empty", "validation")
        }
    }
    button(text=label, @click { check() })
}

const ok = true

component main node {
    var depth = 2
    var problem = "none"
    var names = ["a", "b"]
    var skip = "b"
    var shown = true
    vbox {
        button #move(text="m", @click { skip = "a" })
        button #hide(text="h", @click { shown = false })
        if shown {
            either #one(label=skip)
        }
        shouting #always(label="x")
        if ok {
            step #r(n=depth)
        }
        boundary(@error(e) {
            problem = e.message
        }) {
            for var n = ["x", "y"] {
                if n != "y" {
                    thrower #th(label=n)
                }
            }
        }
        for var n = names {
            either #w(label=n)
        }
        for var n = names {
            plain #p(label=n)
            vbox {
                var local = 0
                text(value="{local}")
                if n != skip {
                    shouting #s(label=n)
                    either #e(label=n)
                    each #f(label=n)
                }
            }
        }
    }
}

func testSplicedCopies(t Test, c main) {
    t.assert(c.one != null)
    t.assert(c.always != null)
    t.assert(c.r != null)
    t.assert(c.th[0] != null)
    t.assert(c.th[1] == null)
    t.assert(c.w[1] != null)
    t.assert(c.w[2] == null)
    t.assert(c.p[1] != null)
    t.assert(c.p[2] == null)
    t.assert(c.s[0] != null)
    t.assert(c.s[1] == null)
    t.assert(c.e[0] != null)
    t.assert(c.e[1] == null)
    t.assert(c.f[0] != null)
    t.assert(c.f[1] == null)
    c.move.click()
    t.assert(c.s[0] == null)
    t.assert(c.s[1] != null)
    t.assert(c.e[0] == null)
    t.assert(c.e[1] != null)
    t.assert(c.f[0] == null)
    t.assert(c.f[1] != null)
    c.hide.click()
    t.assert(c.one == null)
}

window {
    main
}
