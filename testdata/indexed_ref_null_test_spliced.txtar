package main

import "testing"

func TestSplicedCopies(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	if !(true) { t.Errorf("assert failed: %s", "true") }
	if !(true) { t.Errorf("assert failed: %s", "true") }
	if !(c.thPresentAt("0")) { t.Errorf("assert failed: %s", "c.thPresentAt(\"0\")") }
	if !(!c.thPresentAt("1")) { t.Errorf("assert failed: %s", "!c.thPresentAt(\"1\")") }
	if !((1 < len(c.names))) { t.Errorf("assert failed: %s", "(1 < len(c.names))") }
	if !(!(2 < len(c.names))) { t.Errorf("assert failed: %s", "!(2 < len(c.names))") }
	if !((1 < len(c.names))) { t.Errorf("assert failed: %s", "(1 < len(c.names))") }
	if !(!(2 < len(c.names))) { t.Errorf("assert failed: %s", "!(2 < len(c.names))") }
	if !(((0 < len(c.names)) && (c.names[0] != c.skip))) { t.Errorf("assert failed: %s", "((0 < len(c.names)) && (c.names[0] != c.skip))") }
	if !(!((1 < len(c.names)) && (c.names[1] != c.skip))) { t.Errorf("assert failed: %s", "!((1 < len(c.names)) && (c.names[1] != c.skip))") }
	if !(((0 < len(c.names)) && (c.names[0] != c.skip))) { t.Errorf("assert failed: %s", "((0 < len(c.names)) && (c.names[0] != c.skip))") }
	if !(!((1 < len(c.names)) && (c.names[1] != c.skip))) { t.Errorf("assert failed: %s", "!((1 < len(c.names)) && (c.names[1] != c.skip))") }
	if !(((0 < len(c.names)) && (c.names[0] != c.skip))) { t.Errorf("assert failed: %s", "((0 < len(c.names)) && (c.names[0] != c.skip))") }
	if !(!((1 < len(c.names)) && (c.names[1] != c.skip))) { t.Errorf("assert failed: %s", "!((1 < len(c.names)) && (c.names[1] != c.skip))") }
	c.moveClick()
	if !(!((0 < len(c.names)) && (c.names[0] != c.skip))) { t.Errorf("assert failed: %s", "!((0 < len(c.names)) && (c.names[0] != c.skip))") }
	if !(((1 < len(c.names)) && (c.names[1] != c.skip))) { t.Errorf("assert failed: %s", "((1 < len(c.names)) && (c.names[1] != c.skip))") }
	if !(!((0 < len(c.names)) && (c.names[0] != c.skip))) { t.Errorf("assert failed: %s", "!((0 < len(c.names)) && (c.names[0] != c.skip))") }
	if !(((1 < len(c.names)) && (c.names[1] != c.skip))) { t.Errorf("assert failed: %s", "((1 < len(c.names)) && (c.names[1] != c.skip))") }
	if !(!((0 < len(c.names)) && (c.names[0] != c.skip))) { t.Errorf("assert failed: %s", "!((0 < len(c.names)) && (c.names[0] != c.skip))") }
	if !(((1 < len(c.names)) && (c.names[1] != c.skip))) { t.Errorf("assert failed: %s", "((1 < len(c.names)) && (c.names[1] != c.skip))") }
	c.hideClick()
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
}


