One copy of a component instance a test null-tests, where the instance has no
node of its own to be found by: a body that opens with an `if` or a `for`, or
one passNoInlineComponents splices into a block's state record. A target that
keeps an instance's state builds such an instance at run time, which carries
its copy's key on its root, and bubbletea answers from the roots its splice
records. A node under a loop with no `if` around it is null-tested by copy too.

cmd/sngl/testdata/indexed_ref_null_test_spliced_runs.txt runs it on all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component plain(label string) node {
    text(value=label)
}

component shouting(label string) node {
    func shout() string {
        return label + "!"
    }
    text(value=shout())
}

component either(label string) node {
    if label == "a" {
        text(value=label)
    } else {
        text(value="z")
    }
}

component each(label string) node {
    for var i = [1, 2] {
        text(value="{label}{i}")
    }
}

component main node {
    var names = ["a", "b"]
    var skip = "b"
    var shown = true
    vbox {
        button #move(text="m", @click { skip = "a" })
        button #hide(text="h", @click { shown = false })
        if shown {
            either #one(label=skip)
        }
        for var n = names {
            plain #p(label=n)
            vbox {
                var local = 0
                text(value="{local}")
                if n != skip {
                    shouting #s(label=n)
                    either #e(label=n)
                    each #f(label=n)
                }
            }
        }
    }
}

func testSplicedCopies(t Test, c main) {
    t.assert(c.one != null)
    t.assert(c.p[1] != null)
    t.assert(c.p[2] == null)
    t.assert(c.s[0] != null)
    t.assert(c.s[1] == null)
    t.assert(c.e[0] != null)
    t.assert(c.e[1] == null)
    t.assert(c.f[0] != null)
    t.assert(c.f[1] == null)
    c.move.click()
    t.assert(c.s[0] == null)
    t.assert(c.s[1] != null)
    t.assert(c.e[0] == null)
    t.assert(c.e[1] != null)
    t.assert(c.f[0] == null)
    t.assert(c.f[1] != null)
    c.hide.click()
    t.assert(c.one == null)
}

window {
    main
}
