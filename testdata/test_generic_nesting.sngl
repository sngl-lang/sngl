import . "sngl:ui"
import . "sngl:test"

func first<T>(items list<T>) T {
    return items[0]
}

func pair<A, B>(a A, b B) list<A> {
    return [a]
}

component main node {
    var matrix list<list<int>> = [[1, 2], [3, 4], [5, 6]]
    var maybes list<option<int>> = [1, null, 3]

    text(value=string(matrix[0][1]))
}

func testNestedListGeneric(t Test, c main) {
    t.assert(c.matrix[1][0] == 3)
    t.assert(c.matrix.length() == 3)
}

func testListOfOption(t Test, c main) {
    t.assert(c.maybes.length() == 3)
}

window {
    main
}
