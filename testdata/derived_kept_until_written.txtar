A derived function that reads only the program's vars keeps what it last
answered with the count of writes it was computed at (internal/lower/memo.go),
and a write of a var it reads moves the count before its updates run. `rows`
is read by a render slot, a text and `greetings`, and each answered by
building the list again: the Pokédex's moves were built six times per answer.

`greetings` reads the locale, which passContext hands it as a parameter, so
the locale it was last asked with is kept beside the answer and compared.
Every var of the program is tracked, so `chosen`, which only a handler reads,
moves the count when that handler writes it, as any other does.

-- app.sngl --
import i18n "sngl:i18n"
import ui "sngl:ui"

output {
    go {
        gtk4
    }
    c {
        gtk4
    }
}

component shelf ui.node {
    var items = ["a"]
    var mark = "!"
    var chosen = ["x"]

    func rows() list[string] {
        return items.map(func(s string) => "{s}{mark}")
    }

    func greetings() list[string] {
        return rows().map(func(r string) => "{$"Hello"} {r}")
    }

    func picked() list[string] {
        return chosen.map(func(s string) => "{s}{mark}")
    }

    ui.vbox {
        for var r = rows() {
            ui.text(value=r)
        }
        ui.text(value="{rows().length()}")
        ui.text(value=greetings().format())
        ui.button(text="add", @click { items.push("b") })
        ui.button(text="mark", @click { mark = "?" })
        ui.button(text="pick", @click { chosen = picked() })
    }
}

ui.window {
    shelf()
}
