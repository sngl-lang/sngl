// A constant that does not fit its sized target is a compile-time error,
// following the untyped-constant model: literals adopt the annotated type,
// but only if they fit. (Runtime *values* wrap; compile-time *constants*
// are rejected — see sized_int_wraparound.sngl for the runtime side.)
component overflows {
    var a int8 = 200 // ERROR(check) "overflows int8"
}
