component errs {
    var count = 0
    var name = "hello"
    var flag = true
    text(value="{count}")
}

test errs "toggle non-bool" { // ERROR(test) "cannot toggle"
    assert(count == 0)
    count!!
}

test errs "toggle undefined" { // ERROR(test) "undefined"
    assert(count == 0)
    unknown!!
}

test errs "unknown function" { // ERROR(test) "unknown function"
    assert(count == 0)
    assert(unknownFunc(1) == 0)
}

test errs "select on non-map" { // ERROR(test) "cannot select"
    assert(count == 0)
    assert(count.field == 0)
}

test errs "index on non-list" { // ERROR(test) "cannot index"
    assert(count == 0)
    assert(count[0] == 0)
}

test errs "division by zero" { // ERROR(test) "division by zero"
    count = 1 / 0
}

component overflow {
    func boom(n int) => 1 + boom(n + 1)
    text(value="x")
}

test overflow "stack overflow" { // ERROR(test) "stack overflow"
    assert(boom(0) == 0)
}
