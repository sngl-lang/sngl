component errs {
    var count = 0
    var name = "hello"
    var flag = true
    text(value="{count}")
}

func testToggleNonBool(t T, c errs) { // ERROR(test) "cannot toggle"
    t.assert(c.count == 0)
    c.count!!
}

func testToggleUndefined(t T, c errs) { // ERROR(test) "undefined"
    t.assert(c.count == 0)
    unknown!!
}

func testUnknownFunction(t T, c errs) { // ERROR(test) "unknown function"
    t.assert(c.count == 0)
    t.assert(unknownFunc(1) == 0)
}

func testSelectOnNonMap(t T, c errs) { // ERROR(test) "cannot select"
    t.assert(c.count == 0)
    t.assert(c.count.field == 0)
}

func testIndexOnNonList(t T, c errs) { // ERROR(test) "cannot index"
    t.assert(c.count == 0)
    t.assert(c.count[0] == 0)
}

func testDivisionByZero(t T, c errs) { // ERROR(test) "division by zero"
    c.count = 1 / 0
}

component overflow {
    func boom(n int) => 1 + boom(n + 1)
    text(value="x")
}

func testStackOverflow(t T, c overflow) { // ERROR(test) "stack overflow"
    t.assert(c.boom(0) == 0)
}
