import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

component errs node {
    var count = 0
    var name = "hello"
    var flag = true
    text(value="{count}")
}

func testToggleNonBool(t Test, c errs) { // ERROR(test) "cannot toggle"
    t.assert(c.count == 0)
    c.count!!
}

func testToggleUndefined(t Test, c errs) { // ERROR(test) "undefined"
    t.assert(c.count == 0)
    unknown!! // ERROR(check) "undefined"
}

func testUnknownFunction(t Test, c errs) { // ERROR(test) "unknown function"
    t.assert(c.count == 0)
    t.assert(unknownFunc(1) == 0) // ERROR(check) "undefined"
}

func testSelectOnNonMap(t Test, c errs) { // ERROR(test) "cannot select"
    t.assert(c.count == 0)
    t.assert(c.count.field == 0)
}

func testIndexOnNonList(t Test, c errs) { // ERROR(test) "cannot index"
    t.assert(c.count == 0)
    t.assert(c.count[0] == 0)
}

func testDivisionByZero(t Test, c errs) { // ERROR(test) "division by zero"
    c.count = 1 / 0
}

component overflow node {
    func boom(n int) int {
        return 1 + boom(n + 1)
    }
    text(value="x")
}

func testStackOverflow(t Test, c overflow) { // ERROR(test) "stack overflow"
    t.assert(c.boom(0) == 0)
}

app.window {
}
