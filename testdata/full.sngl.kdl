data {
    count (int)0
    name (string)"World"
    active (bool)true
}

computed {
    greeting (cel)"'Hello, ' + name"
    doubled (cel)"count * 2"
}

component "Counter" {
    @param "label" (string)""
    hbox {
        text value=(cel)"label"
        button text="+" on:click=(cel)"set(count, count + 1)"
        button text="-" on:click=(cel)"set(count, count - 1)"
    }
}

app {
    vbox style.padding=16 style.gap=12 {
        text value=(cel)"greeting" {
            @style {
                font-size 24
                font-weight "bold"
            }
        }

        text if=(cel)"active" value="Active" style.color="#007700"

        input value=(cel)"name" placeholder="Enter name" on:input=(cel)"set(name, event.value)"

        Counter label="Clicks"

        button text=(cel)"active ? 'Deactivate' : 'Activate'" on:click=(cel)"toggle(active)"
    }
}
