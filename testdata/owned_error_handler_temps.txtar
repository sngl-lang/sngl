A temp in an `@error` handler's body is released as one in any handler's: a
boundary's, and a per-call handler's, whose body hangs off the call rather
than a node and so was reached by no block walk. Unlowered, the per-call
body's call of `size` reached the Go printer, which spelled a function of
that name as the `len` builtin.

deny out/go/bubbletea/model.go `len\(Open` -- the body is lowered like any other

-- app.sngl --
import macro "sngl:macro"
import ui "sngl:ui"

output {
    go {
        bubbletea
    }
}

#[macro.owned(close)]
struct file {
    fd int
}

func close(f file) {
}

func open(fd int) => file{fd=fd}

func size(f file) => f.fd * 10

func check(f file) {
    if f.fd == 0 {
        error.raise("empty", "")
    }
}

component handlers ui.node {
    var fd = 0
    var n = 12
    var caught = 0
    var problem = 0

    ui.boundary(@error(e) {
        problem = size(open(n))
    }) {
        ui.button(text="per call", @click {
            check(open(fd), @error(e) { caught = size(open(n + 1)) })
        })
        ui.button(text="bubbles", @click {
            check(open(fd))
        })
    }
    ui.text(value="{caught} {problem}")
}

ui.window {
    handlers()
}
