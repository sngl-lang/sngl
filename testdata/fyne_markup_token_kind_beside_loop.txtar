A token's color reaches fyne when its write follows a hoisted temp.

A flow holding a `for` among its spans is a render slot, and there the
ternary a token's kind is read from is hoisted between the span's create and
its prop writes rather than before the create. The build reads a span's
constructor props off the writes that follow its create, leaving out one
reading such a temp, so the color was no prop of the constructor's -- and
the Spec gave `SetColor` only to a color the constructor was handed, so the
write was refused as having no setter. Every color but a literal the
constructor bakes in has a setter now. Either token alone hoists nothing
after the create and generated already.

-- main.sngl --
import ui "sngl:ui"
import markup "sngl:ui/markup"

output {
    go {
        fyne
    }
}

struct Run {
    kind markup.Token
    text string
}

ui.window #home(title="t") {
    var runs = [Run{kind=markup.Token.keyword, text="func"}]
    var flag = false

    ui.vbox {
        ui.button(text="flip", @click { flag = !flag })
        markup.richText {
            for var r = runs {
                markup.token(kind=r.kind) {
                    markup.text(r.text)
                }
            }
            markup.token(kind=flag ? markup.Token.string : markup.Token.type) {
                markup.text("t")
            }
        }
    }
}
