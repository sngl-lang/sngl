A handler in content a component built at run time is handed reads a
variable the content binds itself -- here its own loop's index and element.
The content is lifted into a copy of the component (passInstanceSlots) and
the handler into an event of the copy, its body staying at the call site,
where nothing binds the content's loop: html read an unbound name and fyne
and gtk4 did not compile (`undefined: it`). The event now carries each
variable the lifted content binds that the handler reads, as it carries a
population's parameters, and the body reads it as a parameter of its own
(liftHandler).

A local the handler declares itself -- `var s`, or the `__list0` a `map` in
it is hoisted into -- is bound in the body that moves to the site, and is no
variable of the content: the handler under a plain `if` and the one beside
the loop variable read one each.

cmd/sngl/testdata/slot_content_handler_reads_its_loop_runs.txt runs it on
all six.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}

component card(content ...component node) node {
    var open = 0
    vbox {
        button(text="t {open}", @click { open = open + 1 })
        content
    }
}

component main node {
    var rows = [["a", "b"], ["c"]]
    var log = ""
    var shown = true
    vbox {
        button #swap(text="swap", @click { rows = [["d"], ["e", "f", "g"]] })
        for var row = rows {
            card {
                for var i, it = row {
                    button #cell(text=it, @click { log = "{i}{it}" })
                    button #mark(text=it, @click {
                        var s = "!"
                        log = "{it}{s}{row.map(func(x string) => x + "").length()}"
                    })
                }
            }
        }
        if shown {
            button #tag(text="x{log}", @click {
                var s = "q"
                log = log + s
            })
        }
        text(value=log)
    }
}

func testHandlerReadsItsContentsLoop(t Test, c main) {
    c.cell[1][0].click()
    t.assert(c.log == "0c")
    c.cell[0][1].click()
    t.assert(c.log == "1b")
    c.swap.click()
    c.cell[1][2].click()
    t.assert(c.log == "2g")
    c.mark[1][1].click()
    t.assert(c.log == "f!3")
    if c.tag != null {
        c.tag.click()
    }
    t.assert(c.log == "f!3q")
}

window {
    main
}
