-- out/go/fyne/model_test.go --
package main

import "testing"

func TestHandlerReadsItsContentsLoop(t *testing.T) {
	c := newTestComponent()
	_ = c
	c.cellClickAt("1/0")
	if !((c.log == "0c")) { t.Errorf("assert failed: %s", "(c.log == \"0c\")") }
	c.cellClickAt("0/1")
	if !((c.log == "1b")) { t.Errorf("assert failed: %s", "(c.log == \"1b\")") }
	c.swapClick()
	c.cellClickAt("1/2")
	if !((c.log == "2g")) { t.Errorf("assert failed: %s", "(c.log == \"2g\")") }
	c.markClickAt("1/1")
	if !((c.log == "f!3")) { t.Errorf("assert failed: %s", "(c.log == \"f!3\")") }
	if c.tagPresent() {
		c.tagClick()
	}
	if !((c.log == "f!3q")) { t.Errorf("assert failed: %s", "(c.log == \"f!3q\")") }
}

