A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_browser_instances.sngl --
// What a page shows of components built while it runs -- a recursion, an
// instance under a reactive `if`, a row of a loop -- read in the browser.

import "sngl:test/browser"
import . "sngl:test"
import . "sngl:ui"

component chain(depth int) node {
    text(value="<{depth}")
    if depth > 0 {
        chain(depth=depth - 1)
    }
}

// A recursion renders each level and stops at its own condition.
component recursive node {
    vbox #out {
        chain(depth=3)
    }
}

func testARecursionStopsAtItsCondition(t Test, c recursive) {
    t.assert(browser.text(c.out) == "<3\n<2\n<1\n<0")
}

component countdown(n int) node {
    text(value="[{n}]")
    if n > 0 {
        countdown(n=n - 1)
    }
}

// A recursion the build unrolls carries no instance runtime, and the handler
// beside it still runs.
component unrolled node {
    var lbl = "go"
    button #b(text=lbl, @click { lbl = "went" })
    vbox #out {
        countdown(n=3)
    }
}

func testAnUnrolledRecursionRendersEveryLevel(t Test, c unrolled) {
    t.assert(browser.text(c.out) == "[3]\n[2]\n[1]\n[0]")
    c.b.click()
    t.assert(browser.text(c.b) == "went")
}

component row(label string) node {
    var log list[string] = []
    effect(on=label, @mount { log.push("+") }, @unmount { log.push("-") })
    text #shown(value="{label}[{log.join(",")}]")
}

// An instance under a reactive `if` mounts its effect once and is destroyed
// with its branch.
component factory node {
    var on = true
    button #toggle(text="toggle", @click { on = !on })
    vbox #out {
        if on {
            row(label="x")
        }
    }
}

func testAnInstanceLivesWithItsBranch(t Test, c factory) {
    t.assert(browser.text(c.out) == "x[+]")
    c.toggle.click()
    t.assert(browser.text(c.out) == "")
}

// Each row of a loop that reads state through a call repaints when it moves.
component decorated node {
    var items list[string] = ["a", "b"]
    var suffix = "!"

    func decorate() => suffix

    button #bang(text="bang", @click { suffix = "?" })
    vbox #out {
        for var it = items {
            text(value="<{it}{decorate()}>")
        }
    }
}

func testEveryRowRepaintsWhatTheCallReturns(t Test, c decorated) {
    t.assert(browser.text(c.out) == "<a!>\n<b!>")
    c.bang.click()
    t.assert(browser.text(c.out) == "<a?>\n<b?>")
}

component pick(label string, onpick func(string)) node {
    var hits = 0
    button(text="pick {label}:{hits}", @click { onpick(label) })
}

// A func-typed prop's default reads into the bundle: an arrow there used to
// close the `??` expression it stood in, and the page did not build.
component funcProp node {
    var items list[string] = ["a", "b"]
    var picked = ""
    text(value="picked={picked}")
    vbox #out {
        for var item = items {
            pick(label=item, onpick=func(s string) { picked = s })
        }
    }
}

func testAFuncPropDefaultBuilds(t Test, c funcProp) {
    t.assert(browser.text(c.out) == "pick a:0\npick b:0")
}

window {
    recursive
    unrolled
    factory
    decorated
    funcProp
}

output {
    none {
        html
    }
}
-- out/none/html/index.html --
