android declares `navigation` and answers sngl:ui/nav with a Compose NavHost.
Each page is a destination with a typed route of its own: a page with params
is a `@Serializable` data class holding them, so the params struct is
serializable too, and a page with none is an object. The start destination is
the page at "/", with the params its call site wrote.

`pages.go(pkg, …)` is `navigate` to the page's route, holding the params
handed or the page's own; `pages.back()` pops, and does nothing at the
bottom, where the system back is the window's instead. A link is a button
that runs its `@click` and then navigates. The params a page shows are read
back from its entry's route, so `back` restores them, and a page not showing
is not composed, so the counter on the home page starts again.

`pages.current` is read off the back stack: the entry showing, mapped to the
page family's record, which is how the window's title, the meta's label and
the comparison with `about` read it.

deny * `pages__history|^\s*pages__current = ` -- the back stack is the NavHost's, not a lowered history, and nothing writes the current page
deny * `\bnav\.(go|back|stack|page|link)\b|navGo` -- nothing of sngl:ui/nav reaches the Kotlin as written

-- app.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    kotlin {
        android
    }
}

struct Pkg {
    name string
}

struct Meta {
    label string
}

component counter ui.node {
    var hits = 0
    ui.button(text="hits {hits}", @click {
        hits += 1
    })
}

ui.window #main(title="Docs - {pages.current.title}") {
    ui.vbox {
        nav.stack #pages {
            nav.page #home(href="/", title="Home", meta=Meta{label="home"}) {
                counter()
            }
            nav.page #about(href="/about", title="About", meta=Meta{label="about"}) {
                ui.text(value="about")
            }
            nav.page #pkg(href=`/p/{name}`, title="Package", meta=Meta{label="pkg"}, params=Pkg{name="first"}) {
                component content(p) {
                    ui.text(value=p.name)
                }
            }
        }
        ui.text(value=pages.current.meta.label)
        nav.link(to=about, text="About")
        nav.link(to=pkg, params=Pkg{name="sngl"}, text="sngl")
        ui.button(text="First", @click {
            pages.go(pkg)
        })
        ui.button(text="Back", @click {
            pages.back()
        })
        if pages.current == about {
            ui.text(value="on about")
        }
    }
}
