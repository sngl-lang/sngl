import . "sngl:ui"
import . "sngl:test"

struct TreeNode {
    value int = 0
    left dyn = null
    right dyn = null
}

component main {
    // Build a small tree:
    //       5
    //      / \
    //     3   8
    //    / \
    //   1   4
    var leaf1 = TreeNode{value=1}
    var leaf4 = TreeNode{value=4}
    var node3 = TreeNode{value=3, left=leaf1, right=leaf4}
    var node8 = TreeNode{value=8}
    var root = TreeNode{value=5, left=node3, right=node8}

    // Recursive tree sum
    func treeSum(node dyn) int {
        return node == null ? 0 : node.value + treeSum(node.left) + treeSum(node.right)
    }

    // Recursive tree depth
    func treeDepth(node dyn) int {
        return node == null ? 0 : 1 + int.max(treeDepth(node.left), treeDepth(node.right))
    }

    // Recursive tree contains
    func treeContains(node dyn, target int) bool {
        return node == null ? false : node.value == target || treeContains(node.left, target) || treeContains(node.right, target)
    }

    text(value=string(treeSum(root)))
}

func testTreeSum(t Test, c main) {
    t.assert(c.treeSum(c.root) == 21)
    t.assert(c.treeSum(null) == 0)
    t.assert(c.treeSum(c.leaf1) == 1)
    t.assert(c.treeSum(c.node3) == 8)
}

func testTreeDepth(t Test, c main) {
    t.assert(c.treeDepth(null) == 0)
    t.assert(c.treeDepth(c.leaf1) == 1)
    t.assert(c.treeDepth(c.node3) == 2)
    t.assert(c.treeDepth(c.root) == 3)
}

func testTreeContains(t Test, c main) {
    t.assert(c.treeContains(c.root, 5) == true)
    t.assert(c.treeContains(c.root, 1) == true)
    t.assert(c.treeContains(c.root, 8) == true)
    t.assert(c.treeContains(c.root, 99) == false)
    t.assert(c.treeContains(null, 1) == false)
}

func testTreeMutation(t Test, c main) {
    c.node8.left = TreeNode{value=7}
    t.assert(c.treeSum(c.root) == 28)
    t.assert(c.treeDepth(c.root) == 3)
    t.assert(c.treeContains(c.root, 7) == true)
}
