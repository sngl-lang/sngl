// What lands in a slot is components, so its type names a tree. A value type
// there says nothing a caller could satisfy.

import . "sngl:ui"
import tr "sngl:tree"

component bare(slot _ int) { // ERROR(check) "a slot accepts a tree, and int is not one"
    vbox {
        slot
    }
}

// The wrapper is read for its count and its argument still has to be a tree.
component wrapped(slot x option<string>) { // ERROR(check) "a slot accepts a tree, and string is not one"
    vbox {
        x {}
    }
}

component fine(slot ok tr.one) {
    vbox {
        ok {}
    }
}
