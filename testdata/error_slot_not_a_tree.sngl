// What lands in a slot is components, so its type names a tree. A value type
// there says nothing a caller could satisfy.

import . "sngl:ui"
import tr "sngl:tree"
import app "sngl:app"

component bare(children ...component int) ui { // ERROR(check) "a slot accepts a tree, and int is not one"
    vbox {
        children
    }
}

// The wrapper is read for its count and its argument still has to be a tree.
component wrapped(x component option<string>) ui { // ERROR(check) "a slot accepts a tree, and string is not one"
    vbox {
        x {}
    }
}

component fine(ok component tr.one) ui {
    vbox {
        ok {}
    }
}

app.window {
}
