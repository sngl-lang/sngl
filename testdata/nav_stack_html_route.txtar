sngl:ui/nav in html's route mode: one route per page, the window around the
stack the shell every route repeats, as a static site's documents do
(nav_stack_html.txtar). `pages.current` folds per route, since each route
renders one page.

A page whose href names placeholders is served at a pattern, and the params
its content is handed are the request's: the population's parameter is the
route's params cell, each `{name}` read from the path as the field of that
name. A page's params name no field the href does not, since a field with no
placeholder would have nowhere to travel.

A link and a `go` fill the placeholders from the params they pass -- a
constant link's href is written out whole, `/p/linked`, while a link or a
`go` whose params are state builds its path when it runs, each field escaped:
the link's href is the address `nav._href` names, an ordinary reactive prop. A `go` with
no params goes to the page's own.

deny * `pages__current` -- html answers the stack; passNavigation's if-chain never exists
deny * `pages__history` -- the history is the browser's
deny out/go/html/server.go `home body.*pkg body|pkg body.*home body` -- each route renders its own page alone

-- site.sngl --
import nav "sngl:ui/nav"
import ui "sngl:ui"

output {
    go {
        html
    }
}

struct Pkg {
    name string
}

var typed = "typed"

ui.window #main(title="Site - {pages.current.title}") {
    ui.vbox {
        nav.stack #pages {
            nav.page #home(href="/", title="Home") {
                ui.text(value="home body")
            }
            nav.page #pkg(href=`/p/{name}`, title="Package", params=Pkg{name="first"}) {
                component content(p) {
                    ui.text(value="pkg body {p.name}")
                }
            }
        }
        nav.link(to=pkg, params=Pkg{name="linked"}, text="linked")
        nav.link(to=pkg, text="first")
        nav.link(to=pkg, params=Pkg{name=typed}, text="typed")
        ui.button(text="Typed", @click {
            pages.go(pkg, Pkg{name=typed})
        })
        ui.button(text="Back", @click {
            pages.back()
        })
    }
}
-- out/go/html/server.go --
package main

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleHome)
	mux.HandleFunc("GET /p/{name}", handlePkg)
	return mux
}

// Pkg is what route "/p/{name}" takes from the request.
type Pkg struct {
	Name string
}

