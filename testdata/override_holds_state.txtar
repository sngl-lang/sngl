@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainScreen() {
    val rows = remember { mutableStateListOf("a", "b") }
    var shown by remember { mutableStateOf(true) }
    var hits__inst0 by remember { mutableStateOf(0) }
    var visible__inst0 by remember { mutableStateOf(true) }

    if (visible__inst0) {
        val __activity = LocalContext.current as? Activity
        BackHandler {
            visible__inst0 = false
            if (!(visible__inst0)) {
                __activity?.finish()
            }
        }
        Column(modifier = Modifier.safeDrawingPadding()) {
            Button(onClick = {
                hits__inst0 = (hits__inst0 + 1)
            }, modifier = Modifier) {
                Text(text = ("top " + hits__inst0.toString()), modifier = Modifier)
            }
            for (r in rows) {
                Avatar(initials = r, size = SnglSizePreset.MEDIUM, variant = SnglAvatarVariant.CIRCLE, alt = "", style = Style())
            }
            if (shown) {
                Avatar(initials = "if", size = SnglSizePreset.MEDIUM, variant = SnglAvatarVariant.CIRCLE, alt = "", style = Style())
                Button(onClick = {
                    shown = false
                }, modifier = Modifier) {
                    Text(text = "hide", modifier = Modifier)
                }
            }
        }
    }
}

@Composable
fun Avatar(initials: String = "", size: SnglSizePreset, variant: SnglAvatarVariant, alt: String = "", style: Style, src: (@Composable () -> Unit)? = null, fallback: (@Composable () -> Unit)? = null, onClick: (() -> Unit)? = null) {
    var failed by remember { mutableStateOf(false) }
    var hits by remember { mutableStateOf(0) }

    Button(onClick = {
        hits = (hits + 1)
    }, modifier = Modifier.snglStyle(__merge_Style(Style(), __merge_Style(Style(), style)), withBackground = false)) {
        Text(text = ((initials + " ") + hits.toString()), modifier = Modifier)
    }
}
fun Modifier.snglStyle(s: Style, withBackground: Boolean = true): Modifier {
    var m = this
    if (s.padding != Measurement()) m = m.padding(s.padding.px.dp)
    if (s.paddingTop != Measurement()) m = m.padding(top = s.paddingTop.px.dp)
    if (s.paddingBottom != Measurement()) m = m.padding(bottom = s.paddingBottom.px.dp)
    if (s.paddingLeft != Measurement()) m = m.padding(start = s.paddingLeft.px.dp)
    if (s.paddingRight != Measurement()) m = m.padding(end = s.paddingRight.px.dp)
    if (s.width != Measurement()) m = m.width(s.width.px.dp)
    if (s.height != Measurement()) m = m.height(s.height.px.dp)
    if (withBackground && s.background != Color()) m = m.background(ComposeColor(s.background.r, s.background.g, s.background.b, s.background.a))
    if (s.opacity != 0.0) m = m.alpha(s.opacity.toFloat())
    return m
}

