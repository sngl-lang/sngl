An override that does not say const is an ordinary body, and may hold state its
render reads. The overrides here are the program's, which is how a fixture can
write one; a target package's lowers the same way. Its var is a cell of the
instance: spliced once where it is written, and one per copy under a `for` and
under an `if` over state, as a program component's var is. Selecting `style`
hands each instance a ui.Style, which gtk4 declares as a struct whose color
fields need snglcolor imported.

-- app.sngl --
import "sngl:platform/android"
import "sngl:platform/bubbletea"
import "sngl:platform/fyne"
import "sngl:platform/gtk4"
import "sngl:platform/html"
import "sngl:platform/none"
import ui "sngl:ui"

component ui.avatar[android.platform](initials, style) {
    var hits = 0
    ui.button(text="{initials} {hits}", style={...style}, @click { hits = hits + 1 })
}

component ui.avatar[bubbletea.platform](initials, style) {
    var hits = 0
    ui.button(text="{initials} {hits}", style={...style}, @click { hits = hits + 1 })
}

component ui.avatar[fyne.platform](initials, style) {
    var hits = 0
    ui.button(text="{initials} {hits}", style={...style}, @click { hits = hits + 1 })
}

component ui.avatar[gtk4.platform](initials, style) {
    var hits = 0
    ui.button(text="{initials} {hits}", style={...style}, @click { hits = hits + 1 })
}

component ui.avatar[html.platform](initials, style) {
    var hits = 0
    ui.button(text="{initials} {hits}", style={...style}, @click { hits = hits + 1 })
}

component ui.avatar[none.platform](initials, style) {
    var hits = 0
    ui.button(text="{initials} {hits}", style={...style}, @click { hits = hits + 1 })
}

var rows = ["a", "b"]
var shown = true

ui.window(title="t") {
    ui.vbox {
        ui.avatar(initials="top")
        for var r = rows {
            ui.avatar(initials=r)
        }
        if shown {
            ui.avatar(initials="if")
            ui.button(text="hide", @click { shown = false })
        }
    }
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
