and the record saying a host toolchain built that and ran whatever tests it
carries.
-- component_duration_display.sngl --
// A duration displayed bare is its magnitude in milliseconds with the suffix,
// and cast to an int is the number alone, sum and scale alike.

import . "sngl:test"
import "sngl:time"
import . "sngl:ui"

component main node {
    var short time.duration = 100ms
    var long time.duration = 1s
    vbox {
        text #sum(value="{short + long}")
        text #trunc(value="{int(short + long)}")
        text #scaled(value="{int(short * 3)}")
    }
}

func testADurationIsANumberOfMilliseconds(t Test, c main) {
    t.assert(c.sum.value == "1100ms")
    t.assert(c.trunc.value == "1100")
    t.assert(c.scaled.value == "300")
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
