// An `event(...)` hands over what its declaration says it carries. Nothing
// checked that once, so an override body could forward a value of any type
// and the mismatch surfaced as a type error in the generated program rather
// than against the declaration that was wrong.
//
// A struct parameter takes the struct, or the call forwards. A shorthand
// taking the single field of a one-field struct would tie the rule to the
// struct's shape: the day it gained a second field, every such call site would
// stop being checked. The argument is checked against the parameter, so an
// anonymous literal is typed by the declaration and names nothing.
import . "sngl:ui"

struct Payload {
    value string
}

struct Empty {}

component emitter(
    @one(v Payload),
    @none(e Empty),
) node {
    text(value="a", @click { one({value="x"}) })
    text(value="b", @click { one(Payload{value="y"}) })
    text(value="c", @click { none() })
}

// The field's own type is not the payload's, however few fields it has.
component fieldValue(@one(v Payload)) node {
    text(value="d", @click { one("x") }) // ERROR(check) "cannot pass string as Payload"
}

component wrongType(@one(v Payload)) node {
    var flag = false
    text(value="e", @click { one(flag) }) // ERROR(check) "cannot pass bool as Payload"
}

// A struct with no fields is still a struct: an empty literal is one, and a
// value of another type is not.
component emptyPayload(@none(e Empty)) node {
    text(value="f", @click { none({}) })
}

component emptyPayloadWrongType(@none(e Empty)) node {
    text(value="g", @click { none("x") }) // ERROR(check) "cannot pass string as Empty"
}

component tooManyArgs(@one(v Payload)) node {
    text(value="h", @click { one({value="a"}, {value="b"}) }) // ERROR(check) "event \"one\" passes 1 parameter, got 2 arguments"
}

window {
}
