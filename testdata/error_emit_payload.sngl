// An `event(...)` hands over the payload its declaration says it carries.
// Nothing checked that, so an override body could forward a value of any type
// and the mismatch surfaced as a type error in the generated program rather
// than against the declaration that was wrong -- gtk4's checkbox forwarded a
// bool into a ChangeEvent, and android's textarea forwarded an InputEvent into
// one, which is a different declaration and so a different type.
//
// The argument is the payload or there is none. A shorthand taking the single
// field of a one-field payload would tie the rule to the payload's shape: the
// day that struct gained a second field, every such call site would stop being
// checked. The argument is checked against the payload, so an anonymous
// literal is typed by the declaration and names nothing.
import . "sngl:ui"

struct Payload {
    value string
}

component emitter(
    @one Payload,
    @none FocusEvent,
) node {
    text(value="a", @click { one({value="x"}) })
    text(value="b", @click { one(Payload{value="y"}) })
    text(value="c", @click { none() })
}

// The field's own type is not the payload's, however few fields it has.
component fieldValue(@one Payload) node {
    text(value="d", @click { one("x") }) // ERROR(check) "cannot pass string as Payload"
}

component wrongType(@one Payload) node {
    var flag = false
    text(value="e", @click { one(flag) }) // ERROR(check) "cannot pass bool as Payload"
}

// A payload with no fields is still a payload: an empty literal is one, and a
// value of another type is not.
component emptyPayload(@none FocusEvent) node {
    text(value="f", @click { none({}) })
}

component emptyPayloadWrongType(@none FocusEvent) node {
    text(value="g", @click { none("x") }) // ERROR(check) "cannot pass string as FocusEvent"
}

component tooManyArgs(@one Payload) node {
    text(value="h", @click { one({value="a"}, {value="b"}) }) // ERROR(check) "event \"one\" passes 1 parameter, got 2 arguments"
}

window {
}
