// An `event(...)` hands over the payload its declaration says it carries.
// Nothing checked that, so an override body could forward a value of any type
// and the mismatch surfaced as a type error in the generated program rather
// than against the declaration that was wrong -- gtk4's checkbox forwarded a
// bool into a ChangeEvent, and android's textarea forwarded an InputEvent into
// one, which is a different declaration and so a different type.
//
// Two spellings are right, because a platform reaches an event from whichever
// of the two its host handed it: the payload itself, and the value the payload
// carries when it carries exactly one.
import . "sngl://std"

struct Payload {
    value string
}

component emitter(
    @one Payload,
    @none FocusEvent,
) {
    // The payload itself, the value it carries, and neither: all three right.
    text(value="a", @click { one(Payload{value = "x"}) })
    text(value="b", @click { one("x") })
    text(value="c", @click { none() })
}

component wrongType(@one Payload) {
    var flag = false
    text(value="d", @click { one(flag) }) // ERROR(check) "cannot use bool as Payload for event \"one\""
}

component emptyPayloadWithArg(@none FocusEvent) {
    text(value="e", @click { none("x") }) // ERROR(check) "cannot use string as FocusEvent for event \"none\""
}

component tooManyArgs(@one Payload) {
    text(value="f", @click { one("a", "b") }) // ERROR(check) "event \"one\" takes at most one argument, got 2"
}
