// What a family declaration refuses. A family declares the props its members
// share, with a default for the members that omit one, and nothing else: a
// value of the family is a record of those, read and never bound, so a
// two-way or const prop, an event, a slot and a type parameter would each be
// read by nobody. Nothing renders it, so it is
// never placed in a tree; and a body is where how it is generated will be
// written, which nothing reads yet.

import build "sngl:build"
import ui "sngl:ui"

component sized(n int) build.family

component defaulted(n int = 1) build.family

component bound(:n int) build.family // ERROR(check) "component bound is a family, which declares the props its members share and nothing else: \"n\" is two-way"

component fixed(const n int) build.family // ERROR(check) "component fixed is a family, which declares the props its members share and nothing else: \"n\" is const"

component evented(@tick ui.ClickEvent) build.family // ERROR(check) "component evented is a family, which declares the props its members share and nothing else: @tick is an event"

component slotted(content ...component) build.family // ERROR(check) "component slotted is a family, which declares the props its members share and nothing else: content is a slot"

component generic<T>(v T) build.family // ERROR(check) "component generic is a family, which declares the props its members share and nothing else: it takes type parameters"

component bodied build.family { // ERROR(check) "component bodied is a family, and a family has no body yet"
}

component block build.family

component para() block {}

ui.window {
    block() // ERROR(check) "block is a family, which is named in a return position or a slot and never placed in a tree"
}
