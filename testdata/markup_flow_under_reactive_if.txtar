A reactive `if` around a whole flow is an ordinary render slot, not the flow's.

A flow becomes its own render slot on fyne and gtk4 only when a reactive `if`
or `for` sits among its spans (markup_reactive_span.txtar). Here the `if` holds
a paragraph and no span, so it is the vbox's slot like any other. Counting a
span at any depth under the `if` made the vbox the flow, so the whole vbox --
`#flip` included -- moved into `__renderSlot0`, and the test's `c.flip.click()`
named a handler the Model no longer had (`c.flipClick undefined`).
-- app.sngl --
import . "sngl:ui"
import . "sngl:test"
import md "sngl:ui/markup"

output {
    go {
        fyne
        gtk4
    }
}

component main node {
    var on = true

    vbox {
        if on {
            md.paragraph {
                md.text(value="hello")
            }
        }
        button #flip(text="flip", @click { on = !on })
    }
}

func testFlip(t Test, c main) {
    c.flip.click()
    t.assert(!c.on)
}

window {
    main
}
