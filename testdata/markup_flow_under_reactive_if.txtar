package main

import "testing"

func TestFlip(t *testing.T) {
	c := newTestComponent()
	_ = c
	c = mountTestComponent(c, nil)
	c.flipClick()
	if !(!c.on) { t.Errorf("assert failed: %s", "!c.on") }
}

