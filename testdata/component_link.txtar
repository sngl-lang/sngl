A component fixture: the source, the code every target generates from it,
and the record saying a host toolchain built that and ran whatever tests it
carries.

-- component_link.sngl --
import . "sngl:ui"

// link: A-tier — href/target are static literals, no testable
// state-binding contract.
component main node {
    hbox {
        link(href="https://example.com", text="Example")
        link(href="https://example.com", text="New tab", target=blank)
    }
}

window {
    main
}

output {
    go {
        bubbletea
        fyne
        gtk4
    }
    kotlin {
        android
    }
    none {
        html
    }
}
