	if !((Show__Point(c.p) == "<(1, 2)>")) { t.Errorf("assert failed: %s", "(Show__Point(c.p) == \"<(1, 2)>\")") }
	if !((fmt.Sprint(KeyOf__int_Slot(Slot{Key: (c.n + 6)})) == "7")) { t.Errorf("assert failed: %s", "(fmt.Sprint(KeyOf__int_Slot(Slot{Key: (c.n + 6)})) == \"7\")") }
	c.growClick()
	if !((Show__int(c.n) == "<2>")) { t.Errorf("assert failed: %s", "(Show__int(c.n) == \"<2>\")") }
	if !((fmt.Sprint(KeyOf__int_Slot(Slot{Key: (c.n + 6)})) == "8")) { t.Errorf("assert failed: %s", "(fmt.Sprint(KeyOf__int_Slot(Slot{Key: (c.n + 6)})) == \"8\")") }
}

