A constraint named through an alias generates what the constraint it names
would: `show` and `keyOf` are copied per binding where their calls through
the alias need the bound type's own method or field, and `Formattable`'s
format is the int's at an int and Point's at a Point. The tests run on every
target, the interpreter included (testdata/constraint_alias.sngl).

-- constraint_alias.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        fyne
    }
    kotlin {
        android
    }
    none {
        html
    }
}

struct Formattable = methodsOf[struct {
    const func format() string
}]

struct Keyed[K any] = fieldsOf[struct {
    key K
}]

struct Point {
    x int = 0
    y int = 0

    const func format() => "({x}, {y})"
}

struct Slot {
    key int
}

func show[T Formattable](v T) string {
    var s = "<{v}>"
    return s
}

func keyOf[K any, T Keyed[K]](v T) K {
    var k = v.key
    return k
}

component shown node {
    var n = 1
    var p = Point{x=1, y=2}
    text #int(value=show(n))
    text #point(value=show(p))
    text #key(value=string(keyOf(Slot{key=n + 6})))
    button #grow(text="grow", @click {
        n++
    })
}

func testShown(t Test, c shown) {
    t.assert(c.int.value == "<1>")
    t.assert(c.point.value == "<(1, 2)>")
    t.assert(c.key.value == "7")
    c.grow.click()
    t.assert(c.int.value == "<2>")
    t.assert(c.key.value == "8")
}

window {
    shown()
}
