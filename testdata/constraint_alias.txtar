package main

import "fyne.io/fyne/v2/test"

func newTestComponent() *Model {
	test.NewApp()
	return &Model{}
}

func mountTestComponent(m *Model, preset map[string]bool) *Model {
	m.__init(preset)
	m.BuildUI()
	return m
}
