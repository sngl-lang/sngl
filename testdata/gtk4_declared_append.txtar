A child goes into its parent through the #[gen.protocol(append)] function
declgen writes for the parent's GIR class, which passDeclarative splices into
the AppendChild op, and comes out through its #[gen.protocol(remove)], which
the render slot's teardown splices into RemoveChild. Each is the C call GIR
names, its receiver cast to the class that declares the call -- a link button
takes its child through GtkButton's setter -- and the child to GtkWidget. The
canvas keeps the program on the inline-cgo path.
-- app.sngl --
import ui "sngl:ui"
import draw "sngl:ui/draw"
import go "sngl:language/go"
import gtk "gir:Gtk-4.0"

output {
    go {
        gtk4
    }
}

var shown = true

ui.window(title="t") {
    draw.canvas(width=20px, height=20px) {
        draw.line(x1=0.0, y1=0.0, x2=10.0, y2=10.0)
    }
    gtk.GtkBox(spacing=4) {
        gtk.GtkFrame(label="frame") {
            ui.text(value="framed")
        }
        gtk.GtkScrolledWindow() {
            ui.text(value="scrolled")
        }
        gtk.GtkLinkButton(uri="https://example.com") {
            ui.text(value="linked")
        }
        ui.button(text="toggle", @click {
            shown = !shown
        })
        if shown {
            ui.text(value="shown")
        }
    }
}
