// A population's parameter types are optional and must agree with the
// position they name: the compiler holds the slot's signature, the population
// names a position, and a written type is measured against it.

import . "sngl:ui"

struct Row {
    title string
}

component table(rows list<Row>, cell component(Row)) {
    vbox {
        for var r = rows {
            cell(r)
        }
    }
}

component main {
    table(rows=[]) {
        component cell(row string) { // ERROR(check) "cannot use string as Row for parameter \"row\" of slot \"cell\""
            text(value="x")
        }
    }
}
