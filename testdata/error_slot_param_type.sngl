// A slot binding's type is optional and must agree with the position it
// names. One production parses both sites, so the annotation arrives wherever
// the arguments do -- and only a population has a name to annotate.

import . "sngl:ui"

struct Row {
    title string
}

component table(rows list<Row>, slot cell(Row)) {
    vbox {
        for var r = rows {
            cell(r)
        }
    }
}

component main {
    // Not a population: a `slot` outside a call to the declaring component is
    // a declaration written in the wrong place, and there is no signature for
    // a type to agree with.
    slot stray(row Row) { // ERROR(check) "a type annotates the name a population binds"
        text(value="x")
    }

    table(rows=[]) {
        slot cell(row string) { // ERROR(check) "cannot use string as Row for parameter \"row\" of slot \"cell\""
            text(value="x")
        }
    }
}
