  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<button id="$0">
  <span>Run</span>
</button>
<span>hi</span>

<script>
(() => {
  // sngl-entry.js
  var state = {};
  var $0 = document.getElementById("$0");
  $0.addEventListener("click", async function() {
    await handler();
  });
})();
</script>
