// #[gen.native] names the Go generator a build-target node's target is
// generated by, so it belongs on such a node and nowhere else, and says one
// name.

import build "sngl:build"
import gen "sngl:x/gen"
import ui "sngl:ui"

#[gen.name("teststub")]
#[gen.native("teststub")]
component platform() build.platform

#[gen.native("widget")] // ERROR(check) "component widget: #[gen.native] names the Go generator of a build target, and belongs on a build-target node"
component widget() ui.node {}

#[gen.name("other")]
#[gen.native("a")]
#[gen.native("b")] // ERROR(check) "#[gen.native(\"b\")]: already generated by \"a\""
component language(const platforms ...component build.platform) build.language

ui.window {
    widget()
}
