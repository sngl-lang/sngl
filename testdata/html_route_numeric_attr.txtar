An attribute is a string, and a caller holding a number converts -- which is
what html.sngl says three lines below the props that did not. `rows`, `width`
and `height` were declared `int`, so the static render wrote the literal and
the server render had nothing to write and aborted the build.

Both paths on one program, so a divergence shows here as a difference between
the two goldens rather than as a pass in one mode and a failure in the other.
The script fixture this replaces needed two copies of the program to say that,
one per output block; an archive declares both targets from the one source.

-- app.sngl --
import . "sngl:ui"
import "sngl:platform/html"

output {
    go {
        html
    }
    none {
        html
    }
}

window {
    var n string = ""

    textarea(:value=n, rows=4)
    html.img(src="a.png", width="100", height="50") {}
}
-- out/go/html/server.go --
package ui

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleIndex)
	return mux
}

func handleIndex(__w http.ResponseWriter, _ *http.Request) {
	__w.Header().Set("Content-Type", "text/html; charset=utf-8")
	__w.Write([]byte("<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->\n\n<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<textarea id=\"$0\" placeholder=\"\" rows=\"4\"></textarea>\n<img style=\"height:50px;width:100px\" height=\"50\" src=\"a.png\" width=\"100\"/>\n\n<script>\n(() => {\n  // sngl-entry.js\n  var state = { n: \"\" };\n  var $0 = document.getElementById(\"$0\");\n  $0.addEventListener(\"input\", function(e) {\n    state.n = e.target.value;\n  });\n  $0.addEventListener(\"change\", function(e) {\n    state.n = e.target.value;\n  });\n})();\n</script>\n</body></html>\n"))
}

-- out/none/html/index.html --
<!-- Code generated by sngl (html) from app.sngl; DO NOT EDIT. -->

<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<textarea id="$0" placeholder="" rows="4"></textarea>
<img style="height:50px;width:100px" height="50" src="a.png" width="100"/>

<script>
(() => {
  // sngl-entry.js
  var state = { n: "" };
  var $0 = document.getElementById("$0");
  $0.addEventListener("input", function(e) {
    state.n = e.target.value;
  });
  $0.addEventListener("change", function(e) {
    state.n = e.target.value;
  });
})();
</script>
</body></html>
