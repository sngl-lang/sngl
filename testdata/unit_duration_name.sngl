// `duration` is a unit declared in lib/std, and nothing else. It also had a
// hardcoded entry in the builtin scalar registry, which won in type position,
// so every written `duration` annotation got a different type from the one a
// `5s` literal produces -- "cannot initialize duration with duration". Only
// the alias form (`s.duration`) and inference worked.
import . "sngl:ui"
import . "sngl:time"
import . "sngl:app"

var annotated duration = 5s
var zero duration = 0
var inferred = 5s

func takes(d duration) => d

func sum(d duration) => d + 5s

component main {
    var ticks = 0
    var iv duration = 250ms

    timer(interval=iv, @tick {
        ticks = ticks + 1
    })
    text(value="{takes(annotated).string()} {sum(zero).string()} {inferred.string()} {ticks}")
}
