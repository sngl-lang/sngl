-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestPresence(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.bPresent()) { t.Errorf("assert failed: %s", "!c.bPresent()") }
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	c.toggleClick()
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	if !(c.bPresent()) { t.Errorf("assert failed: %s", "c.bPresent()") }
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	if !(c.shown) { t.Errorf("assert failed: %s", "c.shown") }
	c.toggleClick()
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
	if !(!c.shown) { t.Errorf("assert failed: %s", "!c.shown") }
}


func newTestComponent() Model { m := New(); _ = m.View(); return m }
