bubbletea answers a test's null test of a ref with the view's own ifs and
fors down to the node, so a condition reads the temps the view computed it
from, and a spliced instance is present where the roots of its body are --
an instance whose body is itself an instance included. A root may be an
`if`, a `for` or a boundary, and the instance is present where its call site
is whatever that root decides: `gated` folds its `if` once the call site's
constant reaches it, and `guarded`'s boundary is spliced into its parent,
each handing the stamp to what it leaves standing -- or, where `hidden`'s
fold leaves nothing standing, to an `if true` around nothing: an instance
that renders nothing is still present.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
    }
}

component inner node {
    var n = 0
    button #bump(text="{n}", @click { n += 1 })
}

component outer node {
    var m = 0
    inner #qq()
}

component branchy node {
    var on = false
    if on {
        text(value="on")
    } else {
        text(value="off")
    }
}

component loopy node {
    var xs = [1, 2]
    for var x = xs {
        text(value="{x}")
    }
}

component gated(show bool) node {
    var k = 0
    if show {
        text(value="on {k}")
    } else {
        text(value="off")
    }
}

component hidden(show bool) node {
    var k = 0
    if show {
        text(value="on {k}")
    }
}

component guarded node {
    var k = 0
    boundary(@error(e) { k = 1 }) {
        text(value="on {k}")
    }
}

component screen node {
    var shown = false
    var n = 1
    vbox {
        button #toggle(text="t", @click { shown = !shown })
        if shown {
            outer #p()
            branchy #br()
            loopy #lp()
            gated #g(show=true)
            guarded #gd()
            hidden #h(show=false)
        }
        if (shown ? n : 0) > 0 {
            text #b(value="x")
        }
    }
}

func testPresence(t Test, c screen) {
    t.assert(c.p == null)
    t.assert(c.b == null)
    t.assert(c.br == null)
    t.assert(c.lp == null)
    t.assert(c.g == null)
    t.assert(c.gd == null)
    t.assert(c.h == null)
    c.toggle.click()
    t.assert(c.p != null)
    t.assert(c.b != null)
    t.assert(c.br != null)
    t.assert(c.lp != null)
    t.assert(c.g != null)
    t.assert(c.gd != null)
    t.assert(c.h != null)
    c.toggle.click()
    t.assert(c.br == null)
    t.assert(c.lp == null)
    t.assert(c.g == null)
    t.assert(c.gd == null)
    t.assert(c.h == null)
}

window {
    screen
}
