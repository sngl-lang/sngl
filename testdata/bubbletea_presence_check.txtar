bubbletea answers a test's null test of a ref with the view's own ifs and
fors down to the node, so a condition reads the temps the view computed it
from, and a spliced instance is present where the roots of its body are --
an instance whose body is itself an instance included.

-- app.sngl --
import . "sngl:ui"
import . "sngl:test"

output {
    go {
        bubbletea
    }
}

component inner node {
    var n = 0
    button #bump(text="{n}", @click { n += 1 })
}

component outer node {
    var m = 0
    inner #qq()
}

component screen node {
    var shown = false
    var n = 1
    vbox {
        button #toggle(text="t", @click { shown = !shown })
        if shown {
            outer #p()
        }
        if (shown ? n : 0) > 0 {
            text #b(value="x")
        }
    }
}

func testPresence(t Test, c screen) {
    t.assert(c.p == null)
    t.assert(c.b == null)
    c.toggle.click()
    t.assert(c.p != null)
    t.assert(c.b != null)
}

window {
    screen
}
