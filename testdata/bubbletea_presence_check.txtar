-- out/go/bubbletea/model_test.go --
package main

import "testing"

func TestPresence(t *testing.T) {
	c := newTestComponent()
	_ = c
	if !(!c.pPresent()) { t.Errorf("assert failed: %s", "!c.pPresent()") }
	if !(!c.bPresent()) { t.Errorf("assert failed: %s", "!c.bPresent()") }
	c.toggleClick()
	if !(c.pPresent()) { t.Errorf("assert failed: %s", "c.pPresent()") }
	if !(c.bPresent()) { t.Errorf("assert failed: %s", "c.bPresent()") }
}


func newTestComponent() Model { return New() }
