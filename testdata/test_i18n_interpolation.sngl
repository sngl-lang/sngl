import . "sngl://std"

// Simple identifier interpolation.
component i18nInterp {
    var nm = "world"
    var greeting = $"Hello, {nm}!"

    // Struct member access in interpolation.
    struct User {
        name string
        age int
    }
    var user = User{name="Alice", age=30}
    var welcome = $"Welcome back, {user.name}!"

    // Multiple placeholders including an expression.
    var a = 1
    var b = 2
    var sum = $"{a} + {b} = {a + b}"

    text(value=greeting)
}

func testInterpolation(t Test, c i18nInterp) {
    t.setLocale("en")
    t.assert(c.greeting == "Hello, world!")
    t.assert(c.welcome == "Welcome back, Alice!")
    t.assert(c.sum == "1 + 2 = 3")
}
