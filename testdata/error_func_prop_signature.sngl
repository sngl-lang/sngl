// A lambda whose signature is not the prop's is rejected, and the report names
// both signatures: an expression-bodied lambda always returns a value, so it is
// not a callback declared to return none.

import . "sngl:ui"
import app "sngl:app"

component edit(onEdit func(s string)) ui {
    text(value="x")
}

component main ui {
    var log = ""

    edit(onEdit=func(s) => s)             // ERROR(check) "cannot use func(string) string as func(string)"
    edit(onEdit=func(s string, n int) {}) // ERROR(check) "cannot use func(string, int) as func(string)"
}

app.window {
    main
}
