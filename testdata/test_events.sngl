import . "sngl:ui"
import . "sngl:test"
import app "sngl:app"

// The three places the `@` sigil is written, all in this one fixture: an event
// declaration in a parameter list (`@save` on Counter), a handler supplied at a
// call site (`@click { }`, `@save(e) { }`) and a `var` handler (`@change` on
// `touched`). An event *reference* carries no sigil -- `save(count)` below is
// the emit.
// Test event declarations and bidirectional bindings
// Component with an event in ()
component Counter(label = "", @save) ui {
    var count = 0

    button(text="+", @click { count += 1 })
    button(text="Save", @click { save(count) })
    text(value="{label}: {count}")
}

// Component with bidirectional param
component Stepper(:count = 0) ui {
    button(text="+", @click { count += 1 })
    button(text="-", @click { count -= 1 })
    text(value=string(count))
}

component main ui {
    var (
        score = 0
        steps = 0
    )

    // The body is deliberately inert: the fixture asserts that a `var`
    // handler still parses, and this component has no test function to
    // observe a state change with.
    var touched = 0 @change {
        score += 0
    }

    // Use event handler
    Counter(label="Score", @save(e) { score = e })
    // Use bidirectional binding
    Stepper(:count=steps)
    text(value="Score: {score}, Steps: {steps}")
}

app.window {
    main
}
