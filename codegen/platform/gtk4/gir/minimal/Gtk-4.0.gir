        <return-value transfer-ownership="none">
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
      </glib:signal>
      <!-- Void with no arguments: the one shape the trampoline can carry, so
           every class inherits it as a connectable event. -->
      <glib:signal name="destroy">
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
      </glib:signal>
