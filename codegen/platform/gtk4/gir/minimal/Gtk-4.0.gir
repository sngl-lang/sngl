    <!-- Between ApplicationWindow and Widget so the parent chain is two deep:
         close-request is inherited twice over, and carries its own return type
         rather than the one its landing class would suggest. -->
    <class name="Window" c:type="GtkWindow" parent="Widget">
      <constructor name="new" c:identifier="gtk_window_new"/>
      <!-- Takes no arguments and is still unconnectable, because GTK reads a
           gboolean back out of it. -->
