      <!-- Construct-only, so no widget may declare it, and a widget whose
           props all came down the chain must not pick it up. -->
      <property name="css-name" writable="1" construct-only="1">
        <type name="utf8" c:type="gchar*"/>
      </property>
      <!-- Returns a gboolean the (instance, user_data) -> void trampoline
           cannot produce, so it is inherited but not connectable. -->
