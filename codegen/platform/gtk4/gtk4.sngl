// GTK4 platform package.
//
// Each component below overrides the corresponding stdlib abstract component
// with a GTK4-native implementation. The widget types those bodies are written
// against — `GtkButton`, `GtkLabel`, one per GTK class — are the other half of
// this package: the platform generates them from the `Gtk-4.0.gir`
// introspection data installed on the machine, since the widget set is a
// property of the host and not of this repository. A GIR property becomes a
// typed prop, a GLib signal an event, and `#[intrinsic("gtk4:<CType>")]` names
// the C type the emitter reads the class's C API back out of the same GIR
// under. With no GIR file the platform reports itself unavailable and
// contributes nothing, this file included.
//
// Inside a `platform gtk4 { ... }` body a native widget tag needs its `gtk4.`
// prefix (e.g. `gtk4.GtkBox`): the stdlib component it overrides is in scope
// too, and carries a body of its own.
//
// The view renderer walks each component body, finds the root
// VisualNode, reads its widget type and prop/event bindings, and emits the
// corresponding GTK4 Go code.

import ui "sngl:ui"
import time "sngl:time"
import . "sngl:macro"
import tree "sngl:tree"
import build "sngl:build"
import marks "sngl:internal/marks"
import shapes "sngl:ui/draw"
import math "sngl:math"

// The `gtk4` node of a build directive: `output { go { gtk4() } }`.
component gtk4(
    // Go package name for the generated files.
    package string,
    // Emit a standalone main() or a library-style module.
    main bool,
    // Which introspection data to read the widget vocabulary from: "builtin"
    // for the bundled subset, a path to a `Gtk-4.0.gir`, or unset to probe the
    // system locations and fall back to the bundled subset.
    gir string,
) build.platform {}

// --- Leaf widgets ---

component ui.text[platform] {
    gtk4.GtkLabel(label=value, style={...style}) {}
}

component ui.button[platform] {
    gtk4.GtkButton(label=text, style={...style}, @clicked { click() }) {}
}

component ui.checkbox[platform] {
    gtk4.GtkCheckButton(label=label, active=checked, style={...style}, @toggled { change() }) {}
}

component ui.image[platform] {
    gtk4.GtkImage(file=src, style={...style}) {}
}

component ui.input[platform] {
    gtk4.GtkEntry(text=value, style={...style}, @changed { input() }) {}
}

// gtk4 has no lightweight multi-line entry; map textarea to GtkEntry so
// the value binding + changed handler compile and round-trip. (Rich
// multi-line GtkTextView support is a future enhancement.)
component ui.textarea[platform] {
    gtk4.GtkEntry(text=value, style={...style}, @changed { input() }) {}
}

// --- Container widgets ---

component ui.vbox[platform] {
    gtk4.GtkBox(orientation="vertical", spacing=6, style={...style}) {
        children
    }
}

component ui.hbox[platform] {
    gtk4.GtkBox(orientation="horizontal", spacing=6, style={...style}) {
        children
    }
}

component ui.scroll[platform] {
    gtk4.GtkScrolledWindow(style={...style}) {
        content
    }
}

// --- Indicators ---

// GtkProgressBar's fraction is 0.0-1.0, which is the range the stdlib
// `value` carries when `max` is left at its default. A `max` other than 1
// would need `value/max`, and a division nothing guards against a zero
// denominator is worse than the scale being wrong.
component ui.progress[platform] {
    // GTK's fraction is 0..1, so the value is measured against max here
    // rather than passed through as if it already were one.
    gtk4.GtkProgressBar(fraction=value / max, text=label, showText=showValue, style={...style}) {}
}

component ui.spinner[platform] {
    gtk4.GtkSpinner(spinning=true, tooltipText=label, style={...style}) {}
}

// `direction` is not forwarded: orientation is a GtkOrientation, and the
// only SNGL value that reaches a GTK enum is a string literal naming one of
// its members (see enumValueArg) — a prop reference has no compile-time
// member to name. A separator is therefore horizontal, which is what
// `direction` defaults to.
component ui.divider[platform] {
    gtk4.GtkSeparator(style={...style}) {}
}

component ui.link[platform] {
    gtk4.GtkLinkButton(uri=href, label=text, sensitive=(disabled == false), style={...style}, @clicked { click() }) {}
}

// GtkSwitch reports its own changes through `state-set`, which returns a
// gboolean, and through GObject's notify — neither of which the fixed
// (instance, user_data) → void trampoline can carry. So `active` is bound
// one way and `@change` is not connected; a toggle renders and follows the
// model, and a user flip does not reach it.
component ui.toggle[platform] {
    gtk4.GtkSwitch(active=checked, sensitive=(disabled == false), style={...style}) {}
}

// `value`, `min` and `max` are `date`, a builtin struct with no fields, and
// GtkCalendar takes the day, month and year as three separate ints (its own
// `date` property is a GLib.DateTime, which no SNGL expression produces).
// So the calendar is shown and its selection reported, and the bound value
// does not reach it.
component ui.datepicker[platform] {
    gtk4.GtkCalendar(sensitive=(disabled == false), style={...style}, @daySelected { change() }) {}
}

// --- Layout ---

component ui.spacer[platform] {
    gtk4.GtkBox(hexpand=true, vexpand=true, style={...style}) {}
}

// The same shape html uses: a wrapper carrying the tooltip text, with the
// wrapped content inside it.
component ui.tooltip[platform] {
    gtk4.GtkBox(tooltipText=text, style={...style}) {
        trigger
    }
}

component ui.card[platform] {
    gtk4.GtkFrame(style={...style}) {
        content
    }
}

component ui.stack[platform] {
    gtk4.GtkStack(style={...style}) {
        layers
    }
}

// `open` reaches the popover as widget visibility rather than as
// gtk_popover_popup: the emitter has one setter path per property and
// popup/popdown is a pair of calls chosen by the value. `position` is a
// GtkPositionType, so it is unreachable for the same reason as divider's
// orientation.
component ui.popover[platform] {
    gtk4.GtkPopover(visible=open, autohide=true, style={...style}, @closed { close() }) {
        content
    }
}

// --- The timer ---
//
// A recurring deadline, which is not a GTK widget and so is not generated from
// the GIR: it has no C type to read an API back out of. GLib's g_timeout_add is
// what the emitter builds from it.
//
// gtk4 emitted no timer at all before this declaration existed. A program with
// one compiled clean and simply never ticked, because the analysis read a list
// the checker had hoisted every timer onto and this platform never looked at
// it.
#[tree.none]
#[intrinsic("gtk4:Timer")]
component Timer(
    interval time.duration,
    enabled bool,
    @tick,
)

component time.timer[platform] {
    Timer(interval=interval, enabled=enabled, @tick { tick() }) {}
}

// --- Drawing ---
//
// A canvas here is a GtkDrawingArea and its draw callback is handed a
// `cairo_t*`, so cairo's own functions are the drawing vocabulary. Declared
// with `#[cnative(…)]`, which names a C identifier and no language: each is a
// free function taking the context first, which is the shape a native gets by
// default. The backend that can call C supplies the conversions its own ABI
// needs from the declared parameter types -- for the Go one that is
// `C.double`/`C.int`. Nothing here is Go's.
//
// Named as the cgo pointer it is, so a helper that takes the context has the
// right type in its own signature -- the draw function's own parameter type
// comes from this platform, but `paint(ctx, style)` is an ordinary func and
// carries whatever this declaration says.
#[cnative("*C.cairo_t")]
struct CairoContext {}

#[cnative("cairo_save")]
func CairoContext.save()

#[cnative("cairo_restore")]
func CairoContext.restore()

#[cnative("cairo_set_source_rgba")]
func CairoContext.setSourceRgba(r float, g float, b float, a float)

#[cnative("cairo_set_line_width")]
func CairoContext.setLineWidth(w float)

// cairo's cap and join are typedef'd enums, not plain ints, so the
// declarations name those types and a conversion is written where the value is
// produced. An `int` parameter would emit `C.int(...)` and not compile --
// which the emitted-cgo build test says, loudly.
#[cnative("C.cairo_line_cap_t")]
struct LineCapValue {}

#[cnative("C.cairo_line_join_t")]
struct LineJoinValue {}

#[cnative("C.cairo_line_cap_t")]
func toLineCap(v int) LineCapValue

#[cnative("C.cairo_line_join_t")]
func toLineJoin(v int) LineJoinValue

#[cnative("cairo_set_line_cap")]
func CairoContext.setLineCap(cap LineCapValue)

#[cnative("cairo_set_line_join")]
func CairoContext.setLineJoin(join LineJoinValue)

#[cnative("cairo_rectangle")]
func CairoContext.rectangle(x float, y float, w float, h float)

#[cnative("cairo_new_sub_path")]
func CairoContext.newSubPath()

// The angle form, so a partial sweep is writable -- a gauge or a pie wedge,
// which no stdlib shape expresses yet.
#[cnative("cairo_arc")]
func CairoContext.arc(cx float, cy float, r float, start float, end float)

#[cnative("cairo_move_to")]
func CairoContext.moveTo(x float, y float)

#[cnative("cairo_line_to")]
func CairoContext.lineTo(x float, y float)

#[cnative("cairo_curve_to")]
func CairoContext.curveTo(x1 float, y1 float, x2 float, y2 float, x3 float, y3 float)

#[cnative("cairo_close_path")]
func CairoContext.closePath()

#[cnative("cairo_fill")]
func CairoContext.fill()

#[cnative("cairo_fill_preserve")]
func CairoContext.fillPreserve()

#[cnative("cairo_stroke")]
func CairoContext.stroke()

#[cnative("cairo_set_font_size")]
func CairoContext.setFontSize(size float)

#[cnative("cairo_show_text")]
func CairoContext.showText(text string)

// What a `@draw` handler is handed: the context, and the coordinate space the
// shapes were placed in.
struct DrawEvent {
    ctx CairoContext
    width int
    height int
}

#[marks.intrinsic("gtk4:draw:cairo")]
component draw(@draw DrawEvent) shapes.shape

// cairo takes its line cap and join as enum values. The names are SNGL's, the
// numbers are `CAIRO_LINE_CAP_*` and `CAIRO_LINE_JOIN_*`, and mapping them
// here is what makes `lineCap` and `lineJoin` reach this target at all --
// before the overrides, gtk4 read neither (#223).
func lineCap(name string) LineCapValue {
    if name == "round" {
        return toLineCap(1)
    }
    if name == "square" {
        return toLineCap(2)
    }
    return toLineCap(0)
}

func lineJoin(name string) LineJoinValue {
    if name == "round" {
        return toLineJoin(1)
    }
    if name == "bevel" {
        return toLineJoin(2)
    }
    return toLineJoin(0)
}

// cairo wants each channel as 0..1 where SNGL carries 0..255.
func source(ctx CairoContext, c color) {
    ctx.setSourceRgba(float(c.r) / 255.0, float(c.g) / 255.0, float(c.b) / 255.0, float(c.a) / 255.0)
}

// Fill then stroke the current path, preserving it between the two when both
// apply. This is `_snglCairoPaint` written in SNGL rather than spliced in as
// Go text.
func paint(ctx CairoContext, style shapes.CanvasStyle) {
    if style.fill.a > 0 {
        source(ctx, style.fill)
        if style.stroke.a > 0 {
            ctx.fillPreserve()
        } else {
            ctx.fill()
        }
    }
    if style.stroke.a > 0 {
        ctx.setLineWidth(style.strokeWidth)
        ctx.setLineCap(lineCap(style.lineCap))
        ctx.setLineJoin(lineJoin(style.lineJoin))
        source(ctx, style.stroke)
        ctx.stroke()
    }
}

component shapes.rect[platform] {
    draw(@draw(e) {
        e.ctx.save()
        e.ctx.rectangle(x, y, w, h)
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

component shapes.circle[platform] {
    draw(@draw(e) {
        e.ctx.save()
        e.ctx.newSubPath()
        e.ctx.arc(cx, cy, r, 0.0, math.tau)
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

// An ellipse as four cubic segments rather than a scaled circle: `cairo_scale`
// would scale the *stroke* with the axes, so a 2px outline on a wide ellipse
// comes out thicker horizontally than vertically. kappa is the control-point
// offset that makes a cubic match a quarter arc to within a thousandth.
component shapes.ellipse[platform] {
    draw(@draw(e) {
        var k = 0.5522847498307936
        var ox = rx * k
        var oy = ry * k

        e.ctx.save()
        e.ctx.newSubPath()
        e.ctx.moveTo(cx, cy - ry)
        e.ctx.curveTo(cx + ox, cy - ry, cx + rx, cy - oy, cx + rx, cy)
        e.ctx.curveTo(cx + rx, cy + oy, cx + ox, cy + ry, cx, cy + ry)
        e.ctx.curveTo(cx - ox, cy + ry, cx - rx, cy + oy, cx - rx, cy)
        e.ctx.curveTo(cx - rx, cy - oy, cx - ox, cy - ry, cx, cy - ry)
        e.ctx.closePath()
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

// A line has no interior, so `fill` is not read: the declaration says a fill
// on a line is ignored, and here that is the absence of a call rather than a
// special case in the emitter.
component shapes.line[platform] {
    draw(@draw(e) {
        e.ctx.save()
        e.ctx.moveTo(x1, y1)
        e.ctx.lineTo(x2, y2)
        e.ctx.setLineWidth(style.strokeWidth)
        e.ctx.setLineCap(lineCap(style.lineCap))
        e.ctx.setLineJoin(lineJoin(style.lineJoin))
        source(e.ctx, style.stroke)
        e.ctx.stroke()
        e.ctx.restore()
    })
}

component shapes.path[platform] {
    draw(@draw(e) {
        e.ctx.save()
        for var c = cmds {
            if c.op == "moveTo" {
                e.ctx.moveTo(c.x, c.y)
            }
            if c.op == "lineTo" {
                e.ctx.lineTo(c.x, c.y)
            }
            if c.op == "bezierTo" {
                e.ctx.curveTo(c.cx1, c.cy1, c.cx2, c.cy2, c.x, c.y)
            }
            if c.op == "close" {
                e.ctx.closePath()
            }
        }
        paint(e.ctx, style)
        e.ctx.restore()
    })
}

component shapes.canvasText[platform] {
    draw(@draw(e) {
        e.ctx.save()
        e.ctx.setFontSize(style.fontSize)
        source(e.ctx, style.fill)
        e.ctx.moveTo(x, y)
        e.ctx.showText(content)
        e.ctx.restore()
    })
}
