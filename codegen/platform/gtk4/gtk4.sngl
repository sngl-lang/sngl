// GTK4 platform package.
//
// Each component overrides the corresponding stdlib abstract component with a
// GTK4-native implementation. GIR-resolved widget types (GtkButton, GtkLabel,
// etc.) are available as VisualNode identifiers inside component bodies; the
// platform's Resolve() maps them from the Gtk-4.0.gir type registry.
//
// Inside `platform gtk4 { ... }` extension bodies, native widget tags must be
// qualified with `gtk4.` (e.g. `gtk4.GtkBox`) to disambiguate them from the
// stdlib abstract components that they override (which are themselves
// body-bearing under Plan H).
//
// The view renderer (Task 5) walks each component body, finds the root
// VisualNode, reads its widget type and prop/event bindings, and emits the
// corresponding GTK4 Go code.

struct Options {
    package string
    main bool
    gir string
}

// --- Leaf widgets ---

component sngl.text {
    platform gtk4 {
        gtk4.GtkLabel(label=value, style={...style}) {}
    }
}

component sngl.button {
    platform gtk4 {
        gtk4.GtkButton(label=text, style={...style}, @clicked { @click() }) {}
    }
}

component sngl.checkbox {
    platform gtk4 {
        gtk4.GtkCheckButton(label=label, active=checked, style={...style}, @toggled { @change(checked) }) {}
    }
}

component sngl.image {
    platform gtk4 {
        gtk4.GtkImage(file=src, style={...style}) {}
    }
}

component sngl.input {
    platform gtk4 {
        gtk4.GtkEntry(text=value, style={...style}, @changed { @input() }) {}
    }
}

// --- Container widgets ---

component sngl.vbox {
    platform gtk4 {
        gtk4.GtkBox(orientation="vertical", spacing=6, style={...style}) {
            slot
        }
    }
}

component sngl.hbox {
    platform gtk4 {
        gtk4.GtkBox(orientation="horizontal", spacing=6, style={...style}) {
            slot
        }
    }
}

component sngl.scroll {
    platform gtk4 {
        gtk4.GtkScrolledWindow(style={...style}) {
            slot
        }
    }
}

