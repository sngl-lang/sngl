// GTK4 platform package.
//
// Each component overrides the corresponding stdlib abstract component with a
// GTK4-native implementation. GIR-resolved widget types (GtkButton, GtkLabel,
// etc.) are available as VisualNode identifiers inside component bodies; the
// platform's Resolve() maps them from the Gtk-4.0.gir type registry.
//
// The view renderer (Task 5) walks each component body, finds the root
// VisualNode, reads its widget type and prop/event bindings, and emits the
// corresponding GTK4 Go code.

struct Options {
    package string
    main bool
    gir string
}

// --- Leaf widgets ---

component sngl.button {
    platform gtk4 {
        GtkButton(label=text, @clicked { @click() }) {}
    }
}

component sngl.checkbox {
    platform gtk4 {
        GtkCheckButton(label=label, active=checked, @toggled { @change(checked) }) {}
    }
}

component sngl.image {
    platform gtk4 {
        GtkImage(file=src) {}
    }
}

// --- Container widgets ---

component sngl.vbox {
    platform gtk4 {
        GtkBox(orientation="vertical", spacing=6) {
            slot
        }
    }
}

component sngl.hbox {
    platform gtk4 {
        GtkBox(orientation="horizontal", spacing=6) {
            slot
        }
    }
}

component sngl.scroll {
    platform gtk4 {
        GtkScrolledWindow {
            slot
        }
    }
}

