// Android (Jetpack Compose) platform package.
//
// The intrinsics below are the Compose composables compose_ir.go emits from
// their declarations: #[intrinsic] names the composable and keeps the
// inliner off the component, and each prop is named after the Compose
// argument it becomes. They are ordinary components otherwise, so user code
// can reach a composable this package wraps no wrapper for.
//
// A `component ui.X { platform android { ... } }` override is inlined into
// the caller at lower time, so its body is what the codegen sees.
//
// The four `component ui.X()` bodies left below are not read at all — the
// parens form is skipped by mergePlatformExtensions — and those four
// components are still written by name in a switch in compose_ir.go. Each
// needs something the generic intrinsic emitter cannot yet say; the comment
// on each says which.

import ui "sngl:ui"
import time "sngl:time"
import . "sngl:macro"
import . "sngl:internal/marks"
import tree "sngl:tree"
import build "sngl:build"
import shapes "sngl:ui/draw"
import kt "sngl:language/kotlin"

// The `android` node of a build directive:
// `output { kotlin { android(main = true) } }`.
component android(
    // Kotlin package / Android application ID.
    package string,
    // Display name used in AndroidManifest.xml.
    appName string,
    // Path to a launcher icon asset.
    icon string,
    // Emit a full Gradle project or just Compose sources.
    main bool,
    // Include Gradle wrapper + build scripts (default: true; set "false" to skip).
    gradle bool,
    // Theme accent color (hex).
    color string,
    // Absolute path to the project root. Set automatically by `sngl generate`; used to resolve relative asset paths.
    projectDir string,
    // Which Android runtime to test against under `sngl test`.
    //   "robolectric": JVM simulation, fast, no emulator (default).
    //   "device":      APK on a real emulator/device via adb.
    testRunner string,
    // Toolchain combo — a known-good set of Gradle/AGP/Kotlin/Compose/SDK
    // versions (see internal/androidtc). "stable" (default) or "next".
    toolchain string,
    // Override compileSdk / targetSdk (0 = combo default).
    sdk int,
    // Override minSdk (0 = default 26).
    minSdk int,
    // Override the Gradle distribution version (unset = combo default).
    gradleVersion string,
) build.platform {}

// --- The intrinsics ---
//
// A prop's name is the Compose argument it is emitted as, in declaration
// order. Three names are the emitter's own: `modifier` takes a Style and
// becomes the `Modifier` chain built from it, `chain` appends further Modifier
// calls verbatim after those, and `args` is arguments spelled in Kotlin, for a
// value — `Alignment.CenterVertically`, a `MaterialTheme` shape — that SNGL
// has no way to write.
//
// A func-typed prop is a Compose lambda argument, and the override supplies
// the lambda: its body is emitted where the argument goes, so what the callback
// does is ordinary code in this file rather than a case in the codegen. A
// parameter typed as an event payload is the SNGL event, built from the value
// Compose passes; one typed as that value is the value. A callback Compose
// passes nothing to has neither, so the override names the value itself and
// builds the event from the value it does have — `change({value = opt})`
// in radio below. An event is handed its payload, never a value to build one
// from: a shorthand for a single-field payload would stop checking the moment
// that payload gained a second field.
//
// The id is `android:` plus the composable's name — namespaced by the
// platform whose codegen answers to it, so a platform primitive can never
// collide with a stdlib intrinsic or with another platform's. It names no
// Kotlin package: the platform codegen emits the call, not the language
// translator.

#[intrinsic("android:Column")]
component Column(
    modifier ui.Style,
    chain list<string>,
    children ...component,
) ui.node

#[intrinsic("android:Box")]
component Box(
    modifier ui.Style,
    chain list<string>,
    children ...component,
) ui.node

#[intrinsic("android:Row")]
component Row(
    modifier ui.Style,
    chain list<string>,
    args list<string>,
    children ...component,
) ui.node

#[intrinsic("android:Spacer")]
component Spacer(
    modifier ui.Style,
    chain list<string>,
) ui.node

#[intrinsic("android:Text")]
component Text(
    text string,
    modifier ui.Style,
    // Typography, as Compose's own `style` argument: a TextStyle built from
    // the Style's font and colour fields.
    style ui.Style,
    args list<string>,
) ui.node

#[intrinsic("android:HorizontalDivider")]
component HorizontalDivider(
    modifier ui.Style,
) ui.node

#[intrinsic("android:CircularProgressIndicator")]
component CircularProgressIndicator(
    modifier ui.Style,
) ui.node

// `colors` is the same Style the modifier gets. A Button paints its own
// surface, so a background in the modifier lands behind the pill rather than
// on it -- the colour has to go through the widget's own colour set.
#[intrinsic("android:Button")]
component Button(
    onClick func(),
    modifier ui.Style,
    colors ui.Style,
    shape ui.Style,
    children ...component,
) ui.node

#[intrinsic("android:Badge")]
component Badge(
    modifier ui.Style,
    children ...component,
) ui.node

#[intrinsic("android:Card")]
component Card(
    modifier ui.Style,
    children ...component,
) ui.node

#[intrinsic("android:TabRow")]
component TabRow(
    selectedTabIndex int,
    children ...component,
) ui.node

#[intrinsic("android:Checkbox")]
component Checkbox(
    checked bool,
    onCheckedChange func(bool),
) ui.node

#[intrinsic("android:Switch")]
component Switch(
    checked bool,
    onCheckedChange func(bool),
) ui.node

#[intrinsic("android:RadioButton")]
component RadioButton(
    selected bool,
    onClick func(),
) ui.node

#[intrinsic("android:OutlinedTextField")]
component OutlinedTextField(
    value string,
    minLines int,
    modifier ui.Style,
    // Compose passes the new text; the SNGL event a handler reads is built
    // from it at the boundary, which is what declaring the payload says.
    onValueChange func(e ui.InputEvent),
) ui.node

#[intrinsic("android:Dialog")]
component Dialog(
    onDismissRequest func(),
    children ...component,
) ui.node

#[intrinsic("android:Surface")]
component Surface(
    args list<string>,
    children ...component,
) ui.node

// --- Core Layout ---

component ui.vbox[platform] {
    Column(modifier={...style}) {
        children
    }
}

component ui.hbox[platform] {
    Row(modifier={...style}) {
        children
    }
}

component ui.stack[platform] {
    Box(modifier={...style}) {
        layers
    }
}

component ui.spacer[platform] {
    Spacer(modifier={...style}) {}
}

component ui.scroll[platform] {
    Column(
        modifier={...style},
        chain=["verticalScroll(rememberScrollState())"],
    ) {
        content
    }
}

// --- Core Text & Media ---

component ui.text[platform] {
    Text(text=value, modifier={...style}, style={...style}) {}
}

component ui.button[platform] {
    Button(onClick=func() { click() }, modifier={...style}, colors={...style}, shape={...style}) {
        Text(text=text) {}
    }
}

// Compose has no image loader in the box: an `Image` needs a painter, and
// every source SNGL accepts (a URL, an asset path) needs a different one, so
// android draws no image yet. The emitter used to render a TODO comment,
// which draws nothing; an unsized Spacer is the declared spelling of that.
component ui.image[platform] {
    Spacer(modifier={...style}) {}
}

// Not converted. The placeholder becomes Compose's `label`, which takes a
// composable lambda — `label = { Text("...") }`. An intrinsic prop can carry a
// value or a statement lambda, but nothing declares a *composable* lambda
// argument, so the label cannot be written here.
component ui.input() {
    OutlinedTextField(value=value) {}
}

component ui.checkbox[platform] {
    Row(modifier={...style}, args=["verticalAlignment = Alignment.CenterVertically"]) {
        Checkbox(checked=checked, onCheckedChange=func(on) { change() }) {}
        if label != "" {
            Text(text=label) {}
        }
    }
}

// --- Tier 1: Core Input ---

// Compose's RadioButton is one option, so the group is the loop: the
// container is the direction the prop asks for and each option is a button
// beside its label. onClick is passed nothing, so the override builds the
// ChangeEvent itself from the option it looped over.
component ui.radio[platform] {
    if direction == "horizontal" {
        Row(modifier={...style}) {
            for var opt = options {
                Row(args=["verticalAlignment = Alignment.CenterVertically"]) {
                    RadioButton(selected=(value == opt), onClick=func() { change({value=opt}) }) {}
                    Text(text=opt) {}
                }
            }
        }
    } else {
        Column(modifier={...style}) {
            for var opt = options {
                Row(args=["verticalAlignment = Alignment.CenterVertically"]) {
                    RadioButton(selected=(value == opt), onClick=func() { change({value=opt}) }) {}
                    Text(text=opt) {}
                }
            }
        }
    }
}

component ui.toggle[platform] {
    Row(modifier={...style}, args=["verticalAlignment = Alignment.CenterVertically"]) {
        Switch(checked=checked, onCheckedChange=func(on) { change() }) {}
        if label != "" {
            Text(text=label) {}
        }
    }
}

// Not converted, for three reasons. The menu needs per-call-site state
// (`var expanded by remember`), and expandCall hoists an override's vars into
// the enclosing composable, so a select inside a `for` would share one
// `expanded` across every row. DropdownMenuItem's `text` is a composable
// lambda (see input). And the placeholder fallback needs Kotlin's
// `isNotEmpty()`, which SNGL has no spelling for on a bound prop.
component ui.select() {
    OutlinedTextField(value=value, readOnly=true) {}
}

component ui.textarea[platform] {
    OutlinedTextField(
        value=value,
        minLines=3,
        modifier={...style},
        onValueChange=func(e) {
            input(e)
            change({value=e.value})
        },
    ) {}
    // @input carries the InputEvent Compose's text is built into;
    // @change carries a ChangeEvent, a different declaration, so it
    // takes the value rather than the other event.
}

// Not converted. Same composable-lambda `label` as input.
component ui.datepicker() {
    OutlinedTextField(value=value, readOnly=true) {}
}

// --- Tier 2: Feedback & Navigation ---

// Not converted. Compose's determinate/indeterminate split is by *presence* of
// the `progress` argument, and the emitter picks by whether the call site gave
// `value` at all — a distinction an override body cannot draw, since a prop it
// reads is always there. `progress` is also a `() -> Float` lambda, and a
// func-typed prop's body is emitted as statements, not as an expression.
component ui.progress() {
    LinearProgressIndicator {}
}

component ui.spinner[platform] {
    CircularProgressIndicator(modifier={...style}) {}
}

component ui.badge[platform] {
    Badge(modifier={...style}) {
        Text(text=value) {}
    }
}

component ui.divider[platform] {
    HorizontalDivider(modifier={...style}) {}
}

component ui.card[platform] {
    Card(modifier={...style}) {
        content
    }
}

component ui.chip[platform] {
    Text(text=label) {}
}

component ui.link[platform] {
    Text(
        text=text,
        style={...style},
        args=["color = MaterialTheme.colorScheme.primary"],
    ) {}
}

component ui.tabs[platform] {
    TabRow(selectedTabIndex=selected) {
        panels
    }
}

component ui.modal[platform] {
    if open {
        Dialog(onDismissRequest=func() { close() }) {
            Surface(args=["shape = MaterialTheme.shapes.medium"]) {
                Column(modifier={padding=16}) {
                    if title != "" {
                        Text(text=title) {}
                    }
                    content
                }
            }
        }
    }
}

component ui.drawer[platform] {
    Column(modifier={...style}) {
        content
    }
}

component ui.tooltip[platform] {
    Column(modifier={...style}) {
        trigger
    }
}

component ui.popover[platform] {
    Column(modifier={...style}) {
        content
    }
}

component ui.splitview[platform] {
    Column(modifier={...style}) {
        panes
    }
}

component ui.table[platform] {
    Text(text="") {}
}

component ui.tree[platform] {
    Text(text="") {}
}

component ui.menu[platform] {
    Text(text="") {}
}

component ui.menubar[platform] {
    Text(text="") {}
}

component ui.toolbar[platform] {
    Column(modifier={...style}) {
        controls
    }
}

component ui.avatar[platform] {
    Text(text="") {}
}

// --- The timer ---
//
// A recurring deadline. Compose has a shape for it -- LaunchedEffect keyed on
// the gate, with a delay loop inside -- so the primitive is that, and the
// emitter builds it from the declaration.
//
// The gate reaches the emitter as an expression rather than as the bare
// variable name the analysis used to reduce it to. `enabled=true` produced
// `LaunchedEffect() { while () {`, which is not Kotlin, and no golden covered
// an android timer to say so.
#[tree.none]
#[intrinsic("android:Timer")]
component Timer(
    interval time.duration,
    enabled bool,
    @tick,
)

component time.timer[platform] {
    Timer(interval=interval, enabled=enabled, @tick { tick() }) {}
}

// --- Drawing ---
//
// A canvas here is a Compose `Canvas` composable and its body is a
// `DrawScope`, so the drawing functions are the scope's own. They are declared
// receiverless, which is what a scope function is: inside the lambda the
// receiver is implicit and the call names none.
//
// `named` on each, because Compose puts defaults in the middle of its
// parameter lists -- `drawCircle(color, radius, center, alpha, style, …)`
// cannot be reached past `alpha` positionally -- and because the fill variants
// below rely on `style` defaulting to `Fill` when it is simply not passed.

// Compose's own types, opaque here: they are constructed and handed straight
// to a draw call, so nothing needs to read inside one.
#[kt.native("androidx.compose.ui.geometry.Offset")]
struct Offset {}

#[kt.native("androidx.compose.ui.geometry.Size")]
struct Size {}

#[kt.native("androidx.compose.ui.graphics.Color")]
struct ComposeColor {}

#[kt.native("androidx.compose.ui.graphics.drawscope.DrawStyle")]
struct DrawStyle {}

#[kt.native("androidx.compose.ui.graphics.Path")]
struct Path {}

#[kt.native("Offset", "androidx.compose.ui.geometry.Offset")]
func offset(x float, y float) Offset

#[kt.native("Size", "androidx.compose.ui.geometry.Size")]
func size(width float, height float) Size

// Fully qualified rather than imported: this platform's own emitter already
// writes `import androidx.compose.ui.graphics.Color as ComposeColor`, so the
// bare name is not bound and an import of it would collide with that alias.
#[kt.native("androidx.compose.ui.graphics.Color", "", named)]
func composeColor(red int, green int, blue int, alpha int) ComposeColor

#[kt.native("Stroke", "androidx.compose.ui.graphics.drawscope.Stroke", named)]
func strokeStyle(width float) DrawStyle

// SNGL's `float` is a Kotlin `Double` and Compose's geometry is `Float`, so
// the conversion is written where the value crosses. A method native, which
// is exactly what `.toFloat()` is.
#[kt.native("toFloat", "", method)]
func f32(v float) float

// The colour as Compose spells it. SNGL carries 0-255 channels and so does
// this overload, so it is a rename rather than a conversion.
func composeOf(c color) ComposeColor {
    return composeColor(int(c.r), int(c.g), int(c.b), int(c.a))
}

// Each shape below draws at most twice, once per paint that is visible: a
// transparent fill or stroke is not painted at all rather than painted with
// nothing, which is what the alpha tests say. The fill call omits `style`
// entirely and takes Compose's own `Fill` default.
#[kt.native("drawRect", "", named)]
func drawRectFill(color ComposeColor, topLeft Offset, size Size)

#[kt.native("drawRect", "", named)]
func drawRectStroke(color ComposeColor, topLeft Offset, size Size, style DrawStyle)

#[kt.native("drawCircle", "", named)]
func drawCircleFill(color ComposeColor, radius float, center Offset)

#[kt.native("drawCircle", "", named)]
func drawCircleStroke(color ComposeColor, radius float, center Offset, style DrawStyle)

#[kt.native("drawOval", "", named)]
func drawOvalFill(color ComposeColor, topLeft Offset, size Size)

#[kt.native("drawOval", "", named)]
func drawOvalStroke(color ComposeColor, topLeft Offset, size Size, style DrawStyle)

#[kt.native("drawLine", "", named)]
func drawLine(color ComposeColor, start Offset, end Offset, strokeWidth float)

#[kt.native("drawPath", "", named)]
func drawPathFill(path Path, color ComposeColor)

#[kt.native("drawPath", "", named)]
func drawPathStroke(path Path, color ComposeColor, style DrawStyle)

#[kt.native("Path", "androidx.compose.ui.graphics.Path")]
func newPath() Path

#[kt.native("moveTo", "", method)]
func pathMoveTo(p Path, x float, y float)

#[kt.native("lineTo", "", method)]
func pathLineTo(p Path, x float, y float)

#[kt.native("cubicTo", "", method)]
func pathCubicTo(p Path, x1 float, y1 float, x2 float, y2 float, x3 float, y3 float)

#[kt.native("close", "", method)]
func pathClose(p Path)

#[intrinsic("android:draw")]
component draw(@draw DrawEvent) shapes.shape

struct DrawEvent {
    width int
    height int
}

component shapes.rect[platform] {
    draw(@draw(e) {
        if style.fill.a > 0 {
            drawRectFill(composeOf(style.fill), offset(f32(x), f32(y)), size(f32(w), f32(h)))
        }
        if style.stroke.a > 0 {
            drawRectStroke(composeOf(style.stroke), offset(f32(x), f32(y)), size(f32(w), f32(h)), strokeStyle(f32(style.strokeWidth)))
        }
    })
}

component shapes.circle[platform] {
    draw(@draw(e) {
        if style.fill.a > 0 {
            drawCircleFill(composeOf(style.fill), f32(r), offset(f32(cx), f32(cy)))
        }
        if style.stroke.a > 0 {
            drawCircleStroke(composeOf(style.stroke), f32(r), offset(f32(cx), f32(cy)), strokeStyle(f32(style.strokeWidth)))
        }
    })
}

// Compose has no ellipse: `drawOval` takes the bounding box, so the centre and
// radii become a top-left and a size.
component shapes.ellipse[platform] {
    draw(@draw(e) {
        if style.fill.a > 0 {
            drawOvalFill(composeOf(style.fill), offset(f32(cx - rx), f32(cy - ry)), size(f32(rx * 2.0), f32(ry * 2.0)))
        }
        if style.stroke.a > 0 {
            drawOvalStroke(composeOf(style.stroke), offset(f32(cx - rx), f32(cy - ry)), size(f32(rx * 2.0), f32(ry * 2.0)), strokeStyle(f32(style.strokeWidth)))
        }
    })
}

// A line has no interior, so `fill` is not read.
component shapes.line[platform] {
    draw(@draw(e) {
        drawLine(composeOf(style.stroke), offset(f32(x1), f32(y1)), offset(f32(x2), f32(y2)), f32(style.strokeWidth))
    })
}

component shapes.path[platform] {
    draw(@draw(e) {
        var p = newPath()

        for var c = cmds {
            if c.op == "moveTo" {
                pathMoveTo(p, f32(c.x), f32(c.y))
            }
            if c.op == "lineTo" {
                pathLineTo(p, f32(c.x), f32(c.y))
            }
            if c.op == "bezierTo" {
                pathCubicTo(p, f32(c.cx1), f32(c.cy1), f32(c.cx2), f32(c.cy2), f32(c.x), f32(c.y))
            }
            if c.op == "close" {
                pathClose(p)
            }
        }
        if style.fill.a > 0 {
            drawPathFill(p, composeOf(style.fill))
        }
        if style.stroke.a > 0 {
            drawPathStroke(p, composeOf(style.stroke), strokeStyle(f32(style.strokeWidth)))
        }
    })
}

// The two drawings a native declaration cannot describe: text reaches a
// `Paint` by chained property access and an image goes through a safe-call
// chain ending in a `let`. Both are Kotlin the mark cannot spell, so the
// platform emits a `DrawScope` extension for each and these name them --
// receiverless, like every other scope function.
#[kt.native("snglDrawText", "", named)]
func drawTextShim(content string, x float, y float, c ComposeColor, size float)

#[kt.native("snglDrawImage", "", named)]
func drawImageShim(src string, x float, y float, w float, h float)

component shapes.canvasText[platform] {
    draw(@draw(e) {
        if style.fill.a > 0 {
            drawTextShim(content, f32(x), f32(y), composeOf(style.fill), f32(style.fontSize))
        }
    })
}

component shapes.canvasImage[platform] {
    draw(@draw(e) {
        drawImageShim(src, f32(x), f32(y), f32(w), f32(h))
    })
}
