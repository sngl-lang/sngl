// The portable components, implemented for this platform.
//
// Split from android.sngl rather than living in it: the package is embedded as
// `*.sngl`, so a file is a topic and not a compilation unit. The intrinsics
// these are written in terms of are declared there.

import ui "sngl:ui"
import time "sngl:time"
import . "sngl:internal/marks"
// --- Core Layout ---

const component ui.vbox[platform] {
    Column(modifier={...style}) {
        children
    }
}

const component ui.hbox[platform] {
    Row(modifier={...style}) {
        children
    }
}

const component ui.stack[platform] {
    Box(modifier={...style}) {
        layers
    }
}

const component ui.spacer[platform] {
    Spacer(modifier={...style}) {}
}

const component ui.scroll[platform] {
    Column(
        modifier={...style},
        chain=["verticalScroll(rememberScrollState())"],
    ) {
        content
    }
}

// --- Core Text & Media ---

const component ui.text[platform] {
    Text(text=value, modifier={...style}, style={...style}) {}
}

const component ui.button[platform] {
    Button(onClick=func() { click() }, modifier={...style}, colors={...style}, shape={...style}) {
        Text(text=text) {}
    }
}

// Compose has no image loader in the box: an `Image` needs a painter, and
// every source SNGL accepts (a URL, an asset path) needs a different one, so
// android draws no image yet. The emitter used to render a TODO comment,
// which draws nothing; an unsized Spacer is the declared spelling of that.
const component ui.image[platform] {
    Spacer(modifier={...style}) {}
}

// The placeholder is Compose's floating `label`. A field given none must get
// no `label` argument rather than an empty one, so the conditional is the
// slot's whole body: a literal placeholder folds the slot away and a slot that
// renders nothing is not passed. A placeholder only known at run time cannot
// be answered that way and keeps the argument, so an empty one shows as the
// notched, uncaptioned field the fold exists to avoid.
const component ui.input[platform] {
    OutlinedTextField(
        value=value,
        readOnly=readonly,
        modifier={...style},
        onValueChange=func(e) {
            input(e)
            change({value=e.value})
        },
    ) {
        component label {
            if placeholder != "" {
                Text(text=placeholder) {}
            }
        }
    }
}

const component ui.checkbox[platform] {
    Row(modifier={...style}, args=["verticalAlignment = Alignment.CenterVertically"]) {
        Checkbox(checked=checked, onCheckedChange=func(on) { change({checked=on}) }) {}
        if label != "" {
            Text(text=label) {}
        }
    }
}

// --- Tier 1: Core Input ---

// Compose's RadioButton is one option, so the group is the loop: the
// container is the direction the prop asks for and each option is a button
// beside its label. onClick is passed nothing, so the override builds the
// ChangeEvent itself from the option it looped over.
const component ui.radio[platform] {
    if direction == "horizontal" {
        Row(modifier={...style}) {
            for var opt = options {
                Row(args=["verticalAlignment = Alignment.CenterVertically"]) {
                    RadioButton(selected=(value == opt), onClick=func() { change({value=opt}) }) {}
                    Text(text=opt) {}
                }
            }
        }
    } else {
        Column(modifier={...style}) {
            for var opt = options {
                Row(args=["verticalAlignment = Alignment.CenterVertically"]) {
                    RadioButton(selected=(value == opt), onClick=func() { change({value=opt}) }) {}
                    Text(text=opt) {}
                }
            }
        }
    }
}

const component ui.toggle[platform] {
    Row(modifier={...style}, args=["verticalAlignment = Alignment.CenterVertically"]) {
        Switch(checked=checked, onCheckedChange=func(on) { change({checked=on}) }) {}
        if label != "" {
            Text(text=label) {}
        }
    }
}

// Not converted. The menu needs per-call-site state, and an override may
// declare a var -- passInlinePure hoists one onto the enclosing composable
// under a `__instN` suffix. What it does not survive is a `for`: two call
// sites at one level get `__inst0` and `__inst1`, but one inside a loop and
// one outside both get `__inst0`, and the emitted Kotlin then declares the
// same name twice. One cell per call site is one cell for every row of the
// loop besides, which is not what `expanded` means. compose_ir.go numbers
// `expandedN` per rendered node, which is the thing an override cannot ask
// for.
const component ui.select() {
    OutlinedTextField(value=value, readOnly=true) {}
}

const component ui.textarea[platform] {
    OutlinedTextField(
        value=value,
        minLines=3,
        modifier={...style},
        onValueChange=func(e) {
            input(e)
            change({value=e.value})
        },
    ) {}
    // @input carries the InputEvent Compose's text is built into;
    // @change carries a ChangeEvent, a different declaration, so it
    // takes the value rather than the other event.
}

// A read-only field showing the date, not a calendar: Material3's date-picker
// dialog is a second surface with its own open state, which an override cannot
// hold (see select). An unpicked date shows nothing -- the `option` is what
// distinguishes that from the zero date, which would otherwise pre-fill every
// field with the first day of year one. Compose's onValueChange is not
// optional even on a read-only field, so the argument is written and never
// reached.
//
// A ternary here rather than the two calls the other platforms' progress
// overrides write: Kotlin has a conditional expression, so nothing lowers this
// one to a temporary, and duplicating the call would duplicate the label slot
// with it.
const component ui.datepicker[platform] {
    OutlinedTextField(
        value=(value != null ? string(value) : ""),
        readOnly=true,
        modifier={...style},
        onValueChange=func(e) { change({}) },
    ) {
        component label {
            if placeholder != "" {
                Text(text=placeholder) {}
            }
        }
    }
}

// --- Tier 2: Feedback & Navigation ---

// Compose's determinate/indeterminate split is by *presence* of the `progress`
// argument, which is the shape `value` being an `option` gives the override:
// the null test picks the call, and neither branch invents a fraction.
const component ui.progress[platform] {
    if value != null {
        // The null test is repeated inside the lambda because narrowing does
        // not cross into one: a lambda runs later, and the checker will not
        // assume a binding still holds what it held when it was written. The
        // branch the outer `if` already settled is the unreachable one.
        LinearProgressIndicator(
            progress=func() => (value != null ? float32(value / max) : float32(0.0)),
            modifier={...style},
        ) {}
    } else {
        LinearProgressIndicator(modifier={...style}) {}
    }
}

const component ui.spinner[platform] {
    CircularProgressIndicator(modifier={...style}) {}
}

const component ui.badge[platform] {
    Badge(modifier={...style}) {
        Text(text=value) {}
    }
}

const component ui.divider[platform] {
    HorizontalDivider(modifier={...style}) {}
}

const component ui.card[platform] {
    Card(modifier={...style}) {
        content
    }
}

const component ui.chip[platform] {
    Text(text=label) {}
}

const component ui.link[platform] {
    Text(
        text=text,
        style={...style},
        args=["color = MaterialTheme.colorScheme.primary"],
    ) {}
}

const component ui.tabs[platform] {
    TabRow(selectedTabIndex=selected) {
        panels
    }
}

const component ui.modal[platform] {
    if open {
        Dialog(onDismissRequest=func() { close() }) {
            Surface(args=["shape = MaterialTheme.shapes.medium"]) {
                Column(modifier={padding=16}) {
                    if title != "" {
                        Text(text=title) {}
                    }
                    content
                }
            }
        }
    }
}

const component ui.drawer[platform] {
    Column(modifier={...style}) {
        content
    }
}

const component ui.tooltip[platform] {
    Column(modifier={...style}) {
        trigger
    }
}

const component ui.popover[platform] {
    Column(modifier={...style}) {
        content
    }
}

const component ui.splitview[platform] {
    Column(modifier={...style}) {
        panes
    }
}

const component ui.table[platform] {
    Text(text="") {}
}

const component ui.tree[platform] {
    Text(text="") {}
}

const component ui.menu[platform] {
    Text(text="") {}
}

const component ui.menubar[platform] {
    Text(text="") {}
}

const component ui.toolbar[platform] {
    Column(modifier={...style}) {
        controls
    }
}

const component ui.avatar[platform] {
    Text(text="") {}
}

// --- The timer ---
//
// A recurring deadline. Compose has a shape for it -- LaunchedEffect keyed on
// the gate, with a delay loop inside -- so the primitive is that, and the
// emitter builds it from the declaration.
//
// The gate reaches the emitter as an expression rather than as the bare
// variable name the analysis used to reduce it to. `enabled=true` produced
// `LaunchedEffect() { while () {`, which is not Kotlin, and no golden covered
// an android timer to say so.
#[tree.none]
#[intrinsic("android:Timer")]
component Timer(
    interval time.duration,
    enabled bool,
    @tick,
)

const component time.timer[platform] {
    Timer(interval=interval, enabled=enabled, @tick { tick() }) {}
}
