  __n1.addEventListener("keydown", function(e) {
    if (e.key === "Enter") {
      ;
      _snglCommitEdit(e.currentTarget);
    }
    ;
  });
  __n1.addEventListener("blur", function(e) {
    _snglCommitEdit(e.currentTarget);
  });
  $1.addEventListener("click", function() {
    state.name = "";
    __n1.value = state.name;
    __n2.textContent = "Hello, " + state.name + "!";
