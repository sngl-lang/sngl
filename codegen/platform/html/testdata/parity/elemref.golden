<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<div style="display:flex;flex-direction:column">
  <input id="__n0" data-sngl-id="__n0" placeholder="Type here" type=""/>
  <span id="__n1" data-sngl-id="__n1">
  </span>
  <button id="$1">
    <span>Clear</span>
  </button>
</div>

<script>
(() => {
  // sngl-entry.js
  var state = { name: "" };
  var $1 = document.getElementById("$1");
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  var __n1 = document.querySelector('[data-sngl-id="__n1"]');
  __n0.addEventListener("input", function(e) {
    state.name = e.target.value;
    __n0.value = state.name;
    __n1.textContent = "Hello, " + state.name + "!";
  });
  __n0.addEventListener("change", function(e) {
    state.name = e.target.value;
    __n0.value = state.name;
    __n1.textContent = "Hello, " + state.name + "!";
  });
  $1.addEventListener("click", function() {
    state.name = "";
    __n0.value = state.name;
    __n1.textContent = "Hello, " + state.name + "!";
  });
  function __sngl_init() {
    __n0.value = state.name;
    __n1.textContent = "Hello, " + state.name + "!";
  }
  __sngl_init();
})();
</script>
</body></html>
