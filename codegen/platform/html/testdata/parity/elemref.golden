  <span id="__n2" data-sngl-id="__n2">
  </span>
  <button id="$1">
    <span>Clear</span>
  </button>
</div>

<script>
(() => {
  // sngl-entry.js
  var state = { name: "", visible__inst0: true };
  function _snglMarkEdited(el) {
    el.__snglEdited = true;
  }
  function _snglTakeEdit(el) {
