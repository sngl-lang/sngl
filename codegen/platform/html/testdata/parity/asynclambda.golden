<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<div style="display:flex;flex-direction:column">
  <span id="__n1" data-sngl-id="__n1">
  </span>
  <span id="__n2" data-sngl-id="__n2">
  </span>
  <span id="__n3" data-sngl-id="__n3">
  </span>
  <button id="$1">
    <span>Add</span>
  </button>
</div>

<script>
(() => {
  // sngl-entry.js
  var state = { xs: [1, 2, 3, 4, 5], visible__inst0: true };
  function evens() {
    return state.xs.filter((x) => x % 2 === 0);
  }
  function doubled() {
    return state.xs.map((x) => x * 2);
  }
  function total() {
    return state.xs.length;
  }
  function String(v) {
    return "" + v;
  }
  var $1 = document.getElementById("$1");
  var __n1 = document.querySelector('[data-sngl-id="__n1"]');
  var __n2 = document.querySelector('[data-sngl-id="__n2"]');
  var __n3 = document.querySelector('[data-sngl-id="__n3"]');
  $1.addEventListener("click", function() {
    state.xs.push(state.xs.length + 1);
    __n1.textContent = "count: " + String(total());
    __n2.textContent = "evens: " + String(evens().length);
    __n3.textContent = "first doubled: " + String(doubled()[0]);
  });
  function __sngl_init() {
    __n1.textContent = "count: " + String(total());
    __n2.textContent = "evens: " + String(evens().length);
    __n3.textContent = "first doubled: " + String(doubled()[0]);
  }
  __sngl_init();
})();
</script>
</body></html>
