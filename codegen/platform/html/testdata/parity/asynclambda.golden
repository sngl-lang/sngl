<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<div style="display:flex;flex-direction:column">
  <span id="__n0" data-sngl-id="__n0">
  </span>
  <span id="__n1" data-sngl-id="__n1">
  </span>
  <span id="__n2" data-sngl-id="__n2">
  </span>
  <button id="$1">
    <span>Add</span>
  </button>
</div>

<script>
(() => {
  // sngl-entry.js
  var state = { xs: [1, 2, 3, 4, 5] };
  function main_evens(state2) {
    return state2.xs.filter((x) => x % 2 === 0);
  }
  function main_doubled(state2) {
    return state2.xs.map((x) => x * 2);
  }
  function main_total(state2) {
    return state2.xs.length;
  }
  function String(v) {
    return "" + v;
  }
  var $1 = document.getElementById("$1");
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  var __n1 = document.querySelector('[data-sngl-id="__n1"]');
  var __n2 = document.querySelector('[data-sngl-id="__n2"]');
  $1.addEventListener("click", function() {
    state.xs = state.xs.push(state.xs.length + 1);
    __n0.textContent = "count: " + String(main_total(state));
    __n1.textContent = "evens: " + String(main_evens(state).length);
    __n2.textContent = "first doubled: " + String(main_doubled(state)[0]);
  });
  function __sngl_init() {
    __n0.textContent = "count: " + String(main_total(state));
    __n1.textContent = "evens: " + String(main_evens(state).length);
    __n2.textContent = "first doubled: " + String(main_doubled(state)[0]);
  }
  __sngl_init();
})();
</script>
</body></html>
