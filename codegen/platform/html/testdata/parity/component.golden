<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<div style="display:flex;flex-direction:column">
  <span id="__n1" data-sngl-id="__n1">
  </span>
  <div style="display:flex;flex-direction:row">
    <span id="__n2" data-sngl-id="__n2">
    </span>
  </div>
  <div style="display:flex;flex-direction:row">
    <span id="__n3" data-sngl-id="__n3">
    </span>
  </div>
  <button id="$3">
    <span>Click</span>
  </button>
</div>

<script>
(() => {
  // sngl-entry.js
  var state = { clicks: 0, name: "World", visible__inst0: true };
  function greeting() {
    return "Hello, " + state.name + "!";
  }
  function doubled() {
    return state.clicks * 2;
  }
  function String(v) {
    return "" + v;
  }
  var $3 = document.getElementById("$3");
  var __n1 = document.querySelector('[data-sngl-id="__n1"]');
  var __n2 = document.querySelector('[data-sngl-id="__n2"]');
  var __n3 = document.querySelector('[data-sngl-id="__n3"]');
  $3.addEventListener("click", function() {
    state.clicks = state.clicks + 1;
    __n2.textContent = "Clicks: " + String(state.clicks);
    __n3.textContent = "Doubled: " + String(doubled());
  });
  function __sngl_init() {
    __n1.textContent = greeting();
    __n2.textContent = "Clicks: " + String(state.clicks);
    __n3.textContent = "Doubled: " + String(doubled());
  }
  __sngl_init();
})();
</script>
</body></html>
