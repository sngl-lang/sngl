// elemref.sngl — exercises element-ref: value is read in an expression and
// written inside a click handler.

import . "sngl:ui"

component main ui {
    var name string = ""

    vbox {
        input(placeholder="Type here", value=name, @input(e) { name = e.value })
        text(value="Hello, " + name + "!")
        button(text="Clear", @click { name = "" })
    }
}
