<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<vbox>
  <text id="__n0" data-sngl-id="__n0">
  </text>
  <button id="$0" text="+3">
  </button>
  <button id="$1" text="-3">
  </button>
</vbox>

<script>
(() => {
  // ../../../../../../../../../sngl/sngl-entry.js
  var state = { n: 5 };
  function main_display(state2) {
    return "clamped: " + String(clamp(state2.n, 0, 10));
  }
  function clamp(x, lo, hi) {
    let result = x;
    if (x < lo) {
      ;
      result = lo;
    }
    ;
    if (x > hi) {
      ;
      result = hi;
    }
    ;
    return result;
  }
  function String(v) {
    return "" + v;
  }
  var $0 = document.getElementById("$0");
  var $1 = document.getElementById("$1");
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  $0.addEventListener("click", function() {
    state.n = state.n + 3;
    __n0.textContent = main_display(state);
  });
  $1.addEventListener("click", function() {
    state.n = state.n - 3;
    __n0.textContent = main_display(state);
  });
  function __sngl_init() {
    __n0.value = main_display(state);
  }
  __sngl_init();
})();
</script>
</body></html>
