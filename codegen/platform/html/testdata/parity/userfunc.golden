<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<div style="display:flex;flex-direction:column">
  <span id="__n1" data-sngl-id="__n1">
  </span>
  <button id="$1">
    <span>+3</span>
  </button>
  <button id="$2">
    <span>-3</span>
  </button>
</div>

<script>
(() => {
  // sngl-entry.js
  var state = { n: 5, visible__inst0: true };
  function display() {
    return "clamped: " + String(clamp(state.n, 0, 10));
  }
  function clamp(x, lo, hi) {
    let result = x;
    if (x < lo) {
      ;
      result = lo;
    }
    ;
    if (x > hi) {
      ;
      result = hi;
    }
    ;
    return result;
  }
  function String(v) {
    return "" + v;
  }
  var $1 = document.getElementById("$1");
  var $2 = document.getElementById("$2");
  var __n1 = document.querySelector('[data-sngl-id="__n1"]');
  $1.addEventListener("click", function() {
    state.n = state.n + 3;
    __n1.textContent = display();
  });
  $2.addEventListener("click", function() {
    state.n = state.n - 3;
    __n1.textContent = display();
  });
  function __sngl_init() {
    __n1.textContent = display();
  }
  __sngl_init();
})();
</script>
</body></html>
