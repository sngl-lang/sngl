// regex_bool.sngl — exercises regex.matches() and a bool() conversion.

component main {
    var input string = "hello"
    var score float = 0.75

    const ALPHA regex = "^[a-z]+$"

    func isAlpha() => ALPHA.matches(input)
    func isPositive() => bool(score > 0.0)

    vbox {
        text(value=string(isAlpha))
        text(value=string(isPositive))
        button(text="Set digit", @click { input = "abc123" })
    }
}
