<!DOCTYPE html>
<html><head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: system-ui, sans-serif; }
  </style>
</head><body>

<vbox>
  <text id="__n0" data-sngl-id="__n0">
  </text>
  <text id="__n1" data-sngl-id="__n1">
  </text>
  <button id="$0" text="Set digit">
  </button>
</vbox>

<script>
(() => {
  // ../../../../../../../../../sngl/sngl-entry.js
  var state = { input: "hello", score: 0.75, ALPHA: null };
  state.ALPHA = "^[a-z]+$";
  function main_isAlpha(state2) {
    return state2.ALPHA(state2.input);
  }
  function main_isPositive(state2) {
    return Boolean(state2.score > 0);
  }
  var ALPHA = "^[a-z]+$";
  function String(v) {
    return "" + v;
  }
  var $0 = document.getElementById("$0");
  var __n0 = document.querySelector('[data-sngl-id="__n0"]');
  var __n1 = document.querySelector('[data-sngl-id="__n1"]');
  $0.addEventListener("click", function() {
    state.input = "abc123";
    __n0.textContent = String(main_isAlpha(state));
  });
  function __sngl_init() {
    __n0.value = String(main_isAlpha(state));
    __n1.value = String(main_isPositive(state));
  }
  __sngl_init();
})();
</script>
</body></html>
