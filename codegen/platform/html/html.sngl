// HTML output. Any lowercase identifier is a valid tag: `html.div`,
// `html.dialog`.
// The web element set is open — new standards keep adding to it — so a tag
// resolves to the `element` component below rather than to a declaration of
// its own. A tag no identifier can spell is written through that component's
// `tag` prop: `html.element(tag="my-widget")`.
//
// Each `component ui.X` gives a stdlib component its HTML implementation.
// The stdlib declares the props; the body reads them as locals.
//
// Inside a `platform html { ... }` body a native element needs its `html.`
// prefix: the stdlib component of the same name is in scope too, and carries
// a body of its own.

import ui "sngl:ui"
import time "sngl:time"
import js "sngl:language/js"
import . "sngl:macro"
import . "sngl:internal/marks"

#[options]
struct Options {
    // Render in preview mode (iframe-friendly; stable element IDs for live reload).
    preview bool
    // Emit a test harness instead of the normal app bundle.
    test bool
    // Relative path to a CSS file included in every page.
    stylesheet string
    // Absolute path to the project root. Set automatically by `sngl generate`; used to resolve relative asset paths.
    projectDir string
    // Route mode: target Go package name (default "ui", or "main" when main=true).
    package string
    // Route mode: emit a main() that calls ListenAndServe.
    main bool
    // Route mode: HTTP framework (default "net/http").
    framework string
    // Route mode: host:port for `sngl run` to listen on.
    listen string
    // Minify emitted HTML and inline JS via esbuild.
    minify bool
    // Disable content-hash filenames for emitted assets; produce stable paths.
    noCacheBust bool
}

// The element every tag resolves to. The web's element set is open — a new
// standard adds to it, and a custom element is a tag nobody declared — so one
// declaration answers to every tag name rather than one per tag existing.
//
// The typed props are the attributes whose value is not a string; everything
// else is one, which is what the wildcard prop says. A tag-specific numeric
// attribute missing from this list is accepted as a string rather than
// rejected.
// Lowercase, so a typo inside a `platform html { ... }` body -- where a bare
// name reaches this wildcard -- is reported rather than emitted as an element
// nobody has heard of.
//
// This rejects SVG, whose vocabulary is camelCase inside foreign content
// (`linearGradient`, `clipPath`, `feGaussianBlur`). Reaching it by widening the
// pattern would cost the misspelling check for every HTML tag, so SVG is left
// for a tree kind of its own -- `#[tree.kind]` names a family of nodes and
// says which host accepts them, which is what an SVG subtree is. Until then it
// is written through `element(tag=..., attrs={...})`, which the diagnostics
// below point at.
#[wildcard("[a-z][a-z0-9]*", "tag")]
component element(
    // The name this resolved from — `html.div` binds "div" — and the tag to
    // emit. Writing it is how a hyphenated custom element is reached, an
    // identifier holding no hyphen: `html.element(tag="my-widget")`. It names
    // the element rather than describing it, so it is never an attribute.
    tag string,

    style ui.Style,
    class string,
    id string,
    textContent string,
    innerText string,
    innerHTML string,

    disabled bool,
    checked bool,
    readonly bool,
    selected bool,
    hidden bool,
    open bool,

    // An attribute is written as it is emitted, so a caller holding a number
    // converts: `component ui.progress` spells string(value). These were
    // declared `int` and so were written by two paths that disagreed -- the
    // static render rendered the literal and the server render had no string to
    // write, because there is no attribute type here to convert through.
    rows string,
    width string,
    height string,
    value string,
    max string,

    // Every other attribute, keyed by the name it was written under -- an
    // attribute a standard adds after this file was written among them.
    //
    // A hyphenated name (`data-*`, `aria-*`) does not reach the pattern at all:
    // it is not an identifier, so it can only be written as a key of this map,
    // and a key is taken as given. The pattern governs the names written as
    // props, and is lowercase for the reason the tag pattern is: a camelCase
    // name there is a DOM property or a misspelling of one, and the properties
    // an element takes are declared above.
    #[wildcard("[a-z][a-z0-9]*")]
    attrs map<string, string>,

    @click ui.ClickEvent,
    @input ui.InputEvent,
    @change ui.ChangeEvent,
    @focus ui.FocusEvent,
    @blur ui.FocusEvent,
    @submit ui.SubmitEvent,
    @scroll ui.ScrollEvent,
    @load ui.LoadEvent,
    @error ui.ErrorEvent,
    @close ui.DismissEvent,
    @select ui.SelectEvent,

    // Every other DOM event. The event set is as open as the element set and
    // the attribute set, for the same reason: a standard adds to it. The
    // events above are declared for their payload types, not as the whole
    // list, so one that carries nothing SNGL can name reaches a handler here.
    //
    // Void, because a payload this cannot name is one a handler cannot read;
    // an event whose payload matters is declared above.
    //
    // Lowercase, because these are DOM event types and that is how the DOM
    // spells them. A stdlib component's SNGL name for an event -- `@scrollEnd`
    // -- is mapped to the DOM one by the override that wraps it, which is what
    // wrapping an element in SNGL is for. Accepting the SNGL spelling here
    // instead would emit `addEventListener("scrollEnd")`, an event nothing
    // fires.
    #[wildcard("[a-z][a-z0-9]*")]
    @event,
    slot _,
) {}

// --- Core Layout ---

component ui.vbox[platform] {
    html.div(style={...style, display="flex", flexDirection="column"}) {
        slot
    }
}

component ui.hbox[platform] {
    html.div(style={...style, display="flex", flexDirection="row"}) {
        slot
    }
}

component ui.stack[platform] {
    html.div(style={...style, position="relative"}) {
        slot
    }
}

component ui.spacer[platform] {
    html.div(style={...style, flex=1}) {}
}

// `@scrollEnd` is the standard library's name for the event the DOM calls
// `scrollend`. The names differ, so the override maps them: that is the half of
// wrapping an element that a wildcard cannot do for itself.
component ui.scroll[platform] {
    html.div(style={...style, overflow="auto"}, @scroll { scroll() }, @scrollend { scrollEnd() }) {
        slot
    }
}

// --- Core Text & Media ---

component ui.text[platform] {
    html.span(textContent=value, style={...style}) {}
}

// `@longPress` maps to `contextmenu`, which is what a sustained touch press
// fires -- and a right-click, which is not the same gesture. It stands in until
// html synthesizes the real one from pointerdown and a timer; the alternative
// was a declared event that reached nothing.
component ui.button[platform] {
    html.button(disabled=disabled, style={...style}, @click { click() }, @contextmenu { longPress() }) {
        html.span(textContent=text) {}
        slot
    }
}

component ui.image[platform] {
    html.img(src=src, alt=alt, style={...style}) {}
}

component ui.input[platform] {
    html.input(type=type, placeholder=placeholder, value=value, disabled=disabled, readonly=readonly, style={...style}, @input { input() }, @change { change() }) {}
}

component ui.checkbox[platform] {
    html.label(style={display="inline-flex", alignItems="center", gap=4, ...style}) {
        html.input(type="checkbox", checked=checked, disabled=disabled, @change { change() }) {}
        html.span(textContent=label) {}
    }
}

// --- Tier 1: Core Input ---

component ui.radio[platform] {
    html.fieldset(style={display="flex", flexDirection=direction, gap=8, border="none", padding=0, ...style}) {
        for var opt = options {
            html.label(style={display="inline-flex", alignItems="center", gap=4}) {
                html.input(type="radio", value=opt, checked=(opt == value), disabled=disabled, @change { change() })
                html.span(textContent=opt)
            }
        }
    }
}

component ui.toggle[platform] {
    html.label(style={display="inline-flex", alignItems="center", gap=8, ...style}) {
        html.input(type="checkbox", role="switch", checked=checked, disabled=disabled, @change { change() }) {}
        html.span(textContent=label) {}
    }
}

component ui.select[platform] {
    html.select(disabled=disabled, style={...style}, @change { change() }) {
        if placeholder != "" {
            html.option(value="", disabled=true, selected=true, textContent=placeholder)
        }
        for var opt = options {
            html.option(value=opt, selected=(opt == value), textContent=opt)
        }
    }
}

component ui.textarea[platform] {
    html.textarea(placeholder=placeholder, disabled=disabled, readonly=readonly, rows=string(rows), style={...style}, @input { input() }, @change { change() }) {
        slot
    }
}

// --- Tier 2: Feedback & Navigation ---

component ui.progress[platform] {
    html.progress(value=string(value), max=string(max), style={...style}) {}
}

component ui.spinner[platform] {
    html.span(style={display="inline-flex", alignItems="center", gap=8, ...style}) {
        html.span(class="sngl-spinner") {}
        html.span(textContent=label) {}
    }
}

component ui.badge[platform] {
    html.span(style={display="inline-block", padding="2px 8px", borderRadius=12, ...style}) {
        html.span(textContent=value) {}
    }
}

component ui.tabs[platform] {
    html.div(style={...style, display="flex", flexDirection="column"}) {
        html.div(role="tablist", style={display="flex", gap=4, borderBottom="1px solid #ccc"}) {
            for var label = items {
                html.button(role="tab", textContent=label, style={padding="8px 16px", border="none", background="none", cursor="pointer"})
            }
        }
        html.div(role="tabpanel") {
            slot
        }
    }
}

component ui.link[platform] {
    html.a(href=href, style={...style}, @click { click() }) {
        html.span(textContent=text) {}
    }
}

component ui.divider[platform] {
    html.hr(style={...style}) {}
}

// --- Tier 3: Overlays & Layout ---

component ui.modal[platform] {
    html.div(class="modal-overlay", hidden=(open == false), style={...style, position="fixed", top=0, left=0, width="100%", height="100%", background="rgba(0,0,0,0.5)", display="flex", alignItems="center", justifyContent="center", zIndex=1000}) {
        html.div(class="modal-content", style={background="#fff", borderRadius=8, padding=24}) {
            if title != "" {
                html.h3(textContent=title, style={margin="0 0 16px"})
            }
            slot
        }
    }
}

component ui.drawer[platform] {
    html.div(style={...style, position="fixed", top=0, bottom=0, background="#fff", zIndex=1000}) {
        slot
    }
}

component ui.tooltip[platform] {
    html.div(title=text, style={...style}) {
        slot
    }
}

component ui.popover[platform] {
    html.div(style={...style, position="relative"}) {
        slot
    }
}

component ui.splitview[platform] {
    html.div(style={...style, display="flex"}) {
        slot
    }
}

// --- Tier 4: Data & Desktop ---

component ui.table[platform] {
    html.table(style={width="100%", borderCollapse="collapse", ...style}) {
        html.thead {
            html.tr {
                for var col = columns {
                    html.th(textContent=col, style={textAlign="left", padding=8, borderBottom="2px solid #ddd"})
                }
            }
        }
        html.tbody {
            for var row = rows {
                html.tr {
                    for var cell = row {
                        html.td(textContent=cell, style={padding=8, borderBottom="1px solid #eee"})
                    }
                }
            }
        }
    }
}

component ui.tree[platform] {
    html.ul(style={listStyleType="none", paddingLeft=16, ...style}) {
        for var item = items {
            html.li(textContent=item)
        }
    }
}

component ui.menu[platform] {
    html.div(style={...style, position="absolute", background="#fff", border="1px solid #ddd", borderRadius=4, padding=4, zIndex=100}) {
        slot
    }
}

component ui.menubar[platform] {
    html.nav(style={...style, display="flex", gap=4}) {
        slot
    }
}

component ui.toolbar[platform] {
    html.div(style={...style, display="flex", gap=4, alignItems="center"}) {
        slot
    }
}

// --- Tier 5: Mobile & Specialized ---

component ui.datepicker[platform] {
    html.input(type="date", value=value, disabled=disabled, style={...style}, @change { change() }) {}
}

component ui.chip[platform] {
    html.span(style={display="inline-flex", alignItems="center", padding="4px 12px", borderRadius=16, border="1px solid #ccc", ...style}) {
        html.span(textContent=label) {}
    }
}

component ui.avatar[platform] {
    html.div(style={display="inline-flex", alignItems="center", justifyContent="center", borderRadius="50%", width=40, height=40, background="#ccc", overflow="hidden", ...style}) {
        html.span(textContent=initials) {}
    }
}

component ui.card[platform] {
    html.div(style={borderRadius=8, padding=16, ...style}) {
        slot
    }
}

// Force v to run client-side (front-end). For code imported from non-js:
// languages this compiles the dependency to a front-end WASM asset instead of a
// server call. No effect for static-site builds. Build fails if the logic cannot
// run in the browser or depends on server-side values.
#[intrinsic("html.frontend")]
func frontend<T>(v T) T

// Force v to run server-side (back-end). A func value is generated as an HTTP
// route; a constant expression is generated as a lazy-loaded static file.
#[intrinsic("html.backend")]
func backend<T>(v T) T

// --- The timer ---
//
// The web already schedules, so this platform needs no timer primitive: the
// setInterval/clearInterval pair is a lifetime with a thing to release, which
// is what `effect` brackets.
//
// `delay` is a duration rather than an int so the call site converts nothing --
// a duration's magnitude is milliseconds, which is what setInterval wants.
#[js.native("setInterval")]
func setInterval(f func(), delay time.duration) int

#[js.native("clearInterval")]
func clearInterval(handle int)

// `enabled` is the effect's *position*, not part of its key: an effect lives as
// long as the branch it is written in, so `if enabled` is what makes toggling
// the gate a mount and an unmount. `on=interval` is the key, because a running
// schedule is the same schedule for as long as its period is unchanged.
component time.timer[platform] {
    var handle = 0

    if enabled {
        effect(
            on=interval,
            @mount(d) {
                handle = setInterval(
                    func() {
                        tick()
                    },
                    d,
                )
            },
            @unmount(d) {
                clearInterval(handle)
            },
        )
    }
}
