// HTML platform package.
// Raw HTML elements (div, span, button, input, etc.) are implicitly available
// via APIResolver — any identifier is a valid HTML tag.
//
// Each component sngl.X() overrides the stdlib abstract component with an
// HTML-native implementation. Props are inherited from the stdlib definition
// and available as local variables in the body.

struct Options {
    preview bool
    testing bool
    stylesheet string
    projectDir string
    package string    // route mode: target Go package name (default "ui" / "main" if main=true)
    main bool         // route mode: emit a main() that calls ListenAndServe
    framework string  // route mode: HTTP framework (default "net/http")
}

// --- Core Layout ---

component sngl.vbox() {
    div(style={display="flex", flexDirection="column"}) {
        slot
    }
}

component sngl.hbox() {
    div(style={display="flex", flexDirection="row"}) {
        slot
    }
}

component sngl.stack() {
    div(style={position="relative"}) {
        slot
    }
}

component sngl.spacer() {
    div(style={flex=1}) {}
}

component sngl.scroll() {
    div(style={overflow="auto"}) {
        slot
    }
}

// --- Core Text & Media ---

component sngl.text() {
    span(textContent=value) {}
}

component sngl.button() {
    button(disabled=disabled, @click { @click() }) {
        span(textContent=text) {}
        slot
    }
}

component sngl.image() {
    img(src=src, alt=alt) {}
}

component sngl.input() {
    input(type=type, placeholder=placeholder, value=value, disabled=disabled, readonly=readonly, @input { @input() }, @change { @change() }) {}
}

component sngl.checkbox() {
    label(style={display="inline-flex", alignItems="center", gap=4}) {
        input(type="checkbox", checked=checked, disabled=disabled, @change { @change() }) {}
        span(textContent=label) {}
    }
}

// --- Tier 1: Core Input ---

component sngl.radio() {
    fieldset(style={display="flex", flexDirection=direction, gap=8, border="none", padding=0}) {
        slot
    }
}

component sngl.toggle() {
    label(style={display="inline-flex", alignItems="center", gap=8}) {
        input(type="checkbox", role="switch", checked=checked, disabled=disabled, @change { @change() }) {}
        span(textContent=label) {}
    }
}

component sngl.select() {
    select(disabled=disabled, @change { @change() }) {
        slot
    }
}

component sngl.textarea() {
    textarea(placeholder=placeholder, disabled=disabled, readonly=readonly, rows=rows, @input { @input() }, @change { @change() }) {
        slot
    }
}

// --- Tier 2: Feedback & Navigation ---

component sngl.progress() {
    progress(value=value, max=max) {}
}

component sngl.spinner() {
    span(style={display="inline-flex", alignItems="center", gap=8}) {
        span(class="sngl-spinner") {}
        span(textContent=label) {}
    }
}

component sngl.badge() {
    span(style={display="inline-block", padding="2px 8px", borderRadius=12}) {
        span(textContent=value) {}
    }
}

component sngl.tabs() {
    div(style={display="flex", flexDirection="column"}) {
        div(role="tablist", style={display="flex", gap=4}) {
            slot
        }
    }
}

component sngl.link() {
    a(href=href, @click { @click() }) {
        span(textContent=text) {}
    }
}

component sngl.divider() {
    hr {}
}

// --- Tier 3: Overlays & Layout ---

component sngl.modal() {
    div(style={position="fixed", top=0, left=0, width="100%", height="100%", background="rgba(0,0,0,0.5)", display="flex", alignItems="center", justifyContent="center", zIndex=1000}) {
        div(style={background="#fff", borderRadius=8, padding=24}) {
            slot
        }
    }
}

component sngl.drawer() {
    div(style={position="fixed", top=0, bottom=0, background="#fff", zIndex=1000}) {
        slot
    }
}

component sngl.tooltip() {
    div(title=text) {
        slot
    }
}

component sngl.popover() {
    div(style={position="relative"}) {
        slot
    }
}

component sngl.splitview() {
    div(style={display="flex"}) {
        slot
    }
}

// --- Tier 4: Data & Desktop ---

component sngl.table() {
    table(style={width="100%", borderCollapse="collapse"}) {
        slot
    }
}

component sngl.tree() {
    ul(style={listStyleType="none", paddingLeft=16}) {
        slot
    }
}

component sngl.menu() {
    div(style={position="absolute", background="#fff", border="1px solid #ddd", borderRadius=4, padding=4, zIndex=100}) {
        slot
    }
}

component sngl.menubar() {
    nav(style={display="flex", gap=4}) {
        slot
    }
}

component sngl.toolbar() {
    div(style={display="flex", gap=4, alignItems="center"}) {
        slot
    }
}

// --- Tier 5: Mobile & Specialized ---

component sngl.datepicker() {
    input(type="date", value=value, disabled=disabled, @change { @change() }) {}
}

component sngl.chip() {
    span(style={display="inline-flex", alignItems="center", padding="4px 12px", borderRadius=16, border="1px solid #ccc"}) {
        span(textContent=label) {}
    }
}

component sngl.avatar() {
    div(style={display="inline-flex", alignItems="center", justifyContent="center", borderRadius="50%", width=40, height=40, background="#ccc", overflow="hidden"}) {
        span(textContent=initials) {}
    }
}

component sngl.card() {
    div(style={borderRadius=8, padding=16}) {
        slot
    }
}
