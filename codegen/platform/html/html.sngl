// HTML platform package.
// Raw HTML elements (div, span, button, input, etc.) are implicitly available
// via APIResolver — any identifier is a valid HTML tag.
//
// Each component sngl.X() overrides the stdlib abstract component with an
// HTML-native implementation. Props are inherited from the stdlib definition
// and available as local variables in the body.
//
// Inside `platform html { ... }` extension bodies, native HTML elements must
// be qualified with `html.` (e.g. `html.input`) to disambiguate them from the
// stdlib abstract components of the same name (which are themselves
// body-bearing under Plan H).

struct Options {
    // Render in preview mode (iframe-friendly; stable element IDs for live reload).
    preview bool
    // Emit a test harness instead of the normal app bundle.
    test bool
    // Relative path to a CSS file included in every page.
    stylesheet string
    // Absolute path to the project root. Set automatically by `sngl generate`; used to resolve relative asset paths.
    projectDir string
    // Route mode: target Go package name (default "ui", or "main" when main=true).
    package string
    // Route mode: emit a main() that calls ListenAndServe.
    main bool
    // Route mode: HTTP framework (default "net/http").
    framework string
    // Route mode: host:port for `sngl run` to listen on.
    listen string
    // Minify emitted HTML and inline JS via esbuild.
    minify bool
    // Disable content-hash filenames for emitted assets; produce stable paths.
    noCacheBust bool
}

// --- Core Layout ---

component sngl.vbox {
    platform html {
        html.div(style={...style, display="flex", flexDirection="column"}) {
            slot
        }
    }
}

component sngl.hbox {
    platform html {
        html.div(style={...style, display="flex", flexDirection="row"}) {
            slot
        }
    }
}

component sngl.stack {
    platform html {
        html.div(style={...style, position="relative"}) {
            slot
        }
    }
}

component sngl.spacer {
    platform html {
        html.div(style={...style, flex=1}) {}
    }
}

component sngl.scroll {
    platform html {
        html.div(style={...style, overflow="auto"}) {
            slot
        }
    }
}

// --- Core Text & Media ---

component sngl.text {
    platform html {
        html.span(textContent=value, style={...style}) {}
    }
}

component sngl.button {
    platform html {
        html.button(disabled=disabled, style={...style}, @click { @click() }) {
            html.span(textContent=text) {}
            slot
        }
    }
}

component sngl.image {
    platform html {
        html.img(src=src, alt=alt, style={...style}) {}
    }
}

component sngl.input {
    platform html {
        html.input(type=type, placeholder=placeholder, value=value, disabled=disabled, readonly=readonly, style={...style}, @input { @input() }, @change { @change() }) {}
    }
}

component sngl.checkbox {
    platform html {
        html.label(style={display="inline-flex", alignItems="center", gap=4, ...style}) {
            html.input(type="checkbox", checked=checked, disabled=disabled, @change { @change() }) {}
            html.span(textContent=label) {}
        }
    }
}

// --- Tier 1: Core Input ---

component sngl.radio {
    platform html {
        html.fieldset(style={display="flex", flexDirection=direction, gap=8, border="none", padding=0, ...style}) {
            for opt = options {
                html.label(style={display="inline-flex", alignItems="center", gap=4}) {
                    html.input(type="radio", value=opt, checked=(opt == value), disabled=disabled, @change { @change() })
                    html.span(textContent=opt)
                }
            }
        }
    }
}

component sngl.toggle {
    platform html {
        html.label(style={display="inline-flex", alignItems="center", gap=8, ...style}) {
            html.input(type="checkbox", role="switch", checked=checked, disabled=disabled, @change { @change() }) {}
            html.span(textContent=label) {}
        }
    }
}

component sngl.select {
    platform html {
        html.select(disabled=disabled, style={...style}, @change { @change() }) {
            if placeholder != "" {
                html.option(value="", disabled=true, selected=true, textContent=placeholder)
            }
            for opt = options {
                html.option(value=opt, selected=(opt == value), textContent=opt)
            }
        }
    }
}

component sngl.textarea {
    platform html {
        html.textarea(placeholder=placeholder, disabled=disabled, readonly=readonly, rows=rows, style={...style}, @input { @input() }, @change { @change() }) {
            slot
        }
    }
}

// --- Tier 2: Feedback & Navigation ---

component sngl.progress {
    platform html {
        html.progress(value=value, max=max, style={...style}) {}
    }
}

component sngl.spinner {
    platform html {
        html.span(style={display="inline-flex", alignItems="center", gap=8, ...style}) {
            html.span(class="sngl-spinner") {}
            html.span(textContent=label) {}
        }
    }
}

component sngl.badge {
    platform html {
        html.span(style={display="inline-block", padding="2px 8px", borderRadius=12, ...style}) {
            html.span(textContent=value) {}
        }
    }
}

component sngl.tabs {
    platform html {
        html.div(style={...style, display="flex", flexDirection="column"}) {
            html.div(role="tablist", style={display="flex", gap=4, borderBottom="1px solid #ccc"}) {
                for label = items {
                    html.button(role="tab", textContent=label, style={padding="8px 16px", border="none", background="none", cursor="pointer"})
                }
            }
            html.div(role="tabpanel") {
                slot
            }
        }
    }
}

component sngl.link {
    platform html {
        html.a(href=href, style={...style}, @click { @click() }) {
            html.span(textContent=text) {}
        }
    }
}

component sngl.divider {
    platform html {
        html.hr(style={...style}) {}
    }
}

// --- Tier 3: Overlays & Layout ---

component sngl.modal {
    platform html {
        html.div(class="modal-overlay", hidden=(open == false), style={...style, position="fixed", top=0, left=0, width="100%", height="100%", background="rgba(0,0,0,0.5)", display="flex", alignItems="center", justifyContent="center", zIndex=1000}) {
            html.div(class="modal-content", style={background="#fff", borderRadius=8, padding=24}) {
                if title != "" {
                    html.h3(textContent=title, style={margin="0 0 16px"})
                }
                slot
            }
        }
    }
}

component sngl.drawer {
    platform html {
        html.div(style={...style, position="fixed", top=0, bottom=0, background="#fff", zIndex=1000}) {
            slot
        }
    }
}

component sngl.tooltip {
    platform html {
        html.div(title=text, style={...style}) {
            slot
        }
    }
}

component sngl.popover {
    platform html {
        html.div(style={...style, position="relative"}) {
            slot
        }
    }
}

component sngl.splitview {
    platform html {
        html.div(style={...style, display="flex"}) {
            slot
        }
    }
}

// --- Tier 4: Data & Desktop ---

component sngl.table {
    platform html {
        html.table(style={width="100%", borderCollapse="collapse", ...style}) {
            html.thead {
                html.tr {
                    for col = columns {
                        html.th(textContent=col, style={textAlign="left", padding=8, borderBottom="2px solid #ddd"})
                    }
                }
            }
            html.tbody {
                for row = rows {
                    html.tr {
                        for cell = row {
                            html.td(textContent=cell, style={padding=8, borderBottom="1px solid #eee"})
                        }
                    }
                }
            }
        }
    }
}

component sngl.tree {
    platform html {
        html.ul(style={listStyleType="none", paddingLeft=16, ...style}) {
            for item = items {
                html.li(textContent=item)
            }
        }
    }
}

component sngl.menu {
    platform html {
        html.div(style={...style, position="absolute", background="#fff", border="1px solid #ddd", borderRadius=4, padding=4, zIndex=100}) {
            slot
        }
    }
}

component sngl.menubar {
    platform html {
        html.nav(style={...style, display="flex", gap=4}) {
            slot
        }
    }
}

component sngl.toolbar {
    platform html {
        html.div(style={...style, display="flex", gap=4, alignItems="center"}) {
            slot
        }
    }
}

// --- Tier 5: Mobile & Specialized ---

component sngl.datepicker {
    platform html {
        html.input(type="date", value=value, disabled=disabled, style={...style}, @change { @change() }) {}
    }
}

component sngl.chip {
    platform html {
        html.span(style={display="inline-flex", alignItems="center", padding="4px 12px", borderRadius=16, border="1px solid #ccc", ...style}) {
            html.span(textContent=label) {}
        }
    }
}

component sngl.avatar {
    platform html {
        html.div(style={display="inline-flex", alignItems="center", justifyContent="center", borderRadius="50%", width=40, height=40, background="#ccc", overflow="hidden", ...style}) {
            html.span(textContent=initials) {}
        }
    }
}

component sngl.card {
    platform html {
        html.div(style={borderRadius=8, padding=16, ...style}) {
            slot
        }
    }
}
