// BubbleTea (Charm TUI) platform package.
// Raw terminal components are implicitly available via APIResolver.
//
// Components use metadata props to tell the generator how to produce Go code:
//   join="vertical|horizontal"  — layout join direction
//   content=expr                — text content to render via lipgloss
//   focusable=true              — allocates a focus index
//   pkg="pkg/path"           — Go import to add
//   modelType="type.Model"      — model struct field type
//   modelNew="type.New()"       — initialization expression
//   modelView=".View()"         — view method call pattern

struct Options {
    // Go package name for the generated files.
    package string
    // Emit a standalone main() or a library-style module.
    main bool
    // Emit companion test files (default: true; set "false" to skip).
    tests bool
}

// --- Blueprint vocabulary ---
//
// Blueprint records describe how a stdlib component renders through one of the
// three inlined platform primitives (Layout, Styled, Widget). The Go extractor
// in blueprint.go reads these off the inlined NodeInst.

enum JoinDir { vertical, horizontal }

struct Model {
    type string
    new string
    view string
    update string
    init string
    pkg string
}

struct Focus { enabled bool }

struct Bind {
    prop string
    get string
}

struct Event {
    on string
    key string
}

// --- Core Layout ---

component sngl.vbox {
    platform bubbletea {
        Layout(join=JoinDir.vertical, style={...style}) {
            slot
        }
    }
}

component sngl.hbox {
    platform bubbletea {
        Layout(join=JoinDir.horizontal, style={...style}) {
            slot
        }
    }
}

component sngl.stack {
    platform bubbletea {
        Layout(join=JoinDir.vertical, style={...style}) {
            slot
        }
    }
}

component sngl.spacer {
    platform bubbletea {
        Styled(content="", style={...style}) {}
    }
}

component sngl.scroll {
    platform bubbletea {
        Layout(join=JoinDir.vertical, style={...style}) {
            slot
        }
    }
}

// --- Core Text & Media ---

component sngl.text {
    platform bubbletea {
        Styled(content=value, style={...style}) {}
    }
}

component sngl.button {
    platform bubbletea {
        Styled(
            content=text,
            focus=Focus{enabled=true},
            events=[Event{on="click", key="enter"}],
            style={...style}
        ) {}
    }
}

component sngl.image {
    platform bubbletea {
        Styled(content="[image]", style={...style}) {}
    }
}

component sngl.input() {
    TextInput(
        pkg="charm.land/bubbles/v2/textinput",
        modelType="textinput.Model",
        modelNew="textinput.New()",
        modelView=".View()",
        placeholder=placeholder
    ) {}
}

component sngl.checkbox {
    platform bubbletea {
        Styled(
            content=label,
            focus=Focus{enabled=true},
            events=[Event{on="change", key="space"}],
            style={...style}
        ) {}
    }
}

// --- Tier 1: Core Input ---

component sngl.radio {
    platform bubbletea {
        Layout(join=JoinDir.vertical, style={...style}) {
            slot
        }
    }
}

component sngl.toggle {
    platform bubbletea {
        Styled(
            content=label,
            focus=Focus{enabled=true},
            events=[Event{on="change", key="space"}],
            style={...style}
        ) {}
    }
}

component sngl.select {
    platform bubbletea {
        Styled(
            content=value,
            focus=Focus{enabled=true},
            events=[Event{on="change", key="enter"}],
            style={...style}
        ) {}
    }
}

component sngl.textarea() {
    Styled(content=value, focusable=true) {}
}

component sngl.datepicker {
    platform bubbletea {
        Styled(content=value, style={...style}) {}
    }
}

