// BubbleTea (Charm TUI) platform package.
// Raw terminal components are implicitly available via APIResolver.
//
// Components use metadata props to tell the generator how to produce Go code:
//   join="vertical|horizontal"  — layout join direction
//   content=expr                — text content to render via lipgloss
//   focusable=true              — allocates a focus index
//   pkg="pkg/path"           — Go import to add
//   modelType="type.Model"      — model struct field type
//   modelNew="type.New()"       — initialization expression
//   modelView=".View()"         — view method call pattern

struct Options {
    // Go package name for the generated files.
    package string
    // Emit a standalone main() or a library-style module.
    main bool
    // Emit companion test files (default: true; set "false" to skip).
    tests bool
}

// --- Blueprint vocabulary ---
//
// Blueprint records describe how a stdlib component renders through one of the
// three inlined platform primitives (Layout, Styled, Widget). The Go extractor
// in blueprint.go reads these off the inlined NodeInst.

enum JoinDir { vertical, horizontal }

struct Model {
    type string
    new string
    view string
    update string
    init string
    pkg string
}

struct Focus { enabled bool }

struct Bind {
    prop string
    get string
}

struct Event {
    on string
    key string
}

// --- Core Layout ---

component sngl.vbox() {
    VJoin(join="vertical") {
        slot
    }
}

component sngl.hbox() {
    HJoin(join="horizontal") {
        slot
    }
}

component sngl.stack() {
    VJoin(join="vertical") {
        slot
    }
}

component sngl.spacer() {
    Styled(content="") {}
}

component sngl.scroll() {
    VJoin(join="vertical") {
        slot
    }
}

// --- Core Text & Media ---

component sngl.text {
    platform bubbletea {
        Styled(content=value, style={...style}) {}
    }
}

component sngl.button() {
    Styled(content=text, focusable=true) {}
}

component sngl.image() {
    Styled(content="[image]") {}
}

component sngl.input() {
    TextInput(
        pkg="charm.land/bubbles/v2/textinput",
        modelType="textinput.Model",
        modelNew="textinput.New()",
        modelView=".View()",
        placeholder=placeholder
    ) {}
}

component sngl.checkbox() {
    Styled(content=label, focusable=true) {}
}

// --- Tier 1: Core Input ---

component sngl.radio() {
    VJoin(join="vertical") {
        slot
    }
}

component sngl.toggle() {
    Styled(content=label, focusable=true) {}
}

component sngl.select() {
    Styled(content=value, focusable=true) {}
}

component sngl.textarea() {
    Styled(content=value, focusable=true) {}
}

component sngl.datepicker() {
    Styled(content=value) {}
}

// --- Tier 2: Feedback & Navigation ---

component sngl.progress() {
    Styled(content="") {}
}

component sngl.spinner() {
    Styled(content="⣾") {}
}

component sngl.badge() {
    Styled(content=value) {}
}

component sngl.divider() {
    Styled(content="─") {}
}

component sngl.card() {
    VJoin(join="vertical") {
        slot
    }
}

component sngl.chip() {
    Styled(content=label, focusable=true) {}
}

component sngl.link() {
    Styled(content=text) {}
}

component sngl.tabs() {
    HJoin(join="horizontal") {
        slot
    }
}

component sngl.modal() {
    if open {
        VJoin(join="vertical") {
            slot
        }
    }
}

component sngl.drawer() {
    VJoin(join="vertical") {
        slot
    }
}

component sngl.tooltip() {
    VJoin(join="vertical") {
        slot
    }
}

component sngl.popover() {
    VJoin(join="vertical") {
        slot
    }
}

component sngl.splitview() {
    HJoin(join="horizontal") {
        slot
    }
}

component sngl.table() {
    VJoin(join="vertical") {
        slot
    }
}

component sngl.tree() {
    VJoin(join="vertical") {
        slot
    }
}

component sngl.menu() {
    VJoin(join="vertical") {
        slot
    }
}

component sngl.menubar() {
    HJoin(join="horizontal") {
        slot
    }
}

component sngl.toolbar() {
    HJoin(join="horizontal") {
        slot
    }
}

component sngl.avatar() {
    Styled(content=initials) {}
}
