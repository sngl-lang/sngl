// --- Button ---

component sngl.button {
    platform fyne {
        Button(
            constructor=Constructor{
                goFn="widget.NewButton",
                goType="*widget.Button",
                args=[
                    Prop{name="text", transform="fmt.Sprint"},
                    Event{name="click", signature="func()"},
                ],
            },
            bindings=[
                Reactive{prop="text", target=".SetText", transform="fmt.Sprint"},
                Event{prop="click", target=".OnTapped", signature="func()"},
            ],
            fieldPrefix="btn",
        ) {}
    }
}

// --- Hyperlink ---

component sngl.link {
    platform fyne {
        Hyperlink(
            constructor=Constructor{
                goFn="widget.NewHyperlink",
                goType="*widget.Hyperlink",
                imports=["net/url"],
                prelude=[`linkURL${id}, _ := url.Parse(${href})`],
                args=[
                    Prop{name="text"},
                    Raw{value=`linkURL${id}`},
                ],
            },
            fieldPrefix="link",
        ) {}
    }
}

// --- Image ---

component sngl.image {
    platform fyne {
        Image(
            constructor=Constructor{
                goFn="canvas.NewImageFromURI",
                goType="*canvas.Image",
                imports=["fyne.io/fyne/v2/canvas"],
                args=[Raw{value=`nil /* TODO: ${src} */`}],
            },
            transient=true,
        ) {}
    }
}

// --- Checkbox / Toggle ---

component sngl.checkbox {
    platform fyne {
        Check(
            constructor=Constructor{
                goFn="widget.NewCheck",
                goType="*widget.Check",
                args=[
                    Prop{name="label", transform="fmt.Sprint"},
                    Event{name="change", signature="func(b bool)"},
                ],
            },
            fieldPrefix="check",
        ) {}
    }
}

component sngl.toggle {
    platform fyne {
        Check(
            constructor=Constructor{
                goFn="widget.NewCheck",
                goType="*widget.Check",
                args=[
                    Prop{name="label", transform="fmt.Sprint"},
                    Event{name="change", signature="func(b bool)"},
                ],
            },
            fieldPrefix="check",
        ) {}
    }
}

// --- Select ---

component sngl.select {
    platform fyne {
        Select(
            constructor=Constructor{
                goFn="widget.NewSelect",
                goType="*widget.Select",
                args=[
                    Raw{value="nil"},
                    Event{name="change", signature="func(s string)"},
                ],
            },
            fieldPrefix="sel",
        ) {}
    }
}

// --- Modal ---

component sngl.modal {
    platform fyne {
        if open {
            Container(
                constructor=Constructor{
                    goFn="container.NewVBox",
                    goType="*fyne.Container",
                    args=[Raw{value=`${children}...`}],
                },
                transient=true,
            ) {}
        }
    }
}

// --- Entry inputs ---

component sngl.input {
    platform fyne {
        Entry(
            constructor=Constructor{
                goFn="widget.NewEntry",
                goType="*widget.Entry",
                switches=[Switch{prop="type", value="password", goFn="widget.NewPasswordEntry"}],
            },
            bindings=[
                Init{prop="placeholder", target=".SetPlaceHolder", quoted=true},
                Init{prop="value", target=".SetText", transform="fmt.Sprint"},
                Reactive{prop="value", target=".SetText", transform="fmt.Sprint"},
                Event{prop="input", target=".OnChanged", signature="func(s string)", bindParam="s", syncTarget=".SetText"},
            ],
            fieldPrefix="entry",
            updaterPrefix="updateEntry",
        ) {}
    }
}

component sngl.textarea {
    platform fyne {
        Entry(
            constructor=Constructor{
                goFn="widget.NewMultiLineEntry",
                goType="*widget.Entry",
            },
            bindings=[
                Init{prop="placeholder", target=".SetPlaceHolder", quoted=true},
                Init{prop="rows", target=".SetMinRowsVisible"},
                Init{prop="value", target=".SetText", transform="fmt.Sprint"},
                Reactive{prop="value", target=".SetText", transform="fmt.Sprint"},
                Event{prop="input", target=".OnChanged", signature="func(s string)", bindParam="s", syncTarget=".SetText"},
            ],
            fieldPrefix="entry",
            updaterPrefix="updateEntry",
        ) {}
    }
}
