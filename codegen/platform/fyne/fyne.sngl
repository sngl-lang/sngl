// Fyne platform package.
//
// Each component declares a Blueprint — structured render directives the
// codegen reads at platform load. The renderer walks each component body, picks
// the first VisualNode (or the node inside a top-level `if`), and reads its
// `constructor=Constructor{...}` and `bindings=[...]` args. No platform Go
// code branches on component name.
//
// Imports:
//   The renderer always emits "fmt", "fyne.io/fyne/v2", "fyne.io/fyne/v2/widget",
//   "fyne.io/fyne/v2/container" — these baselines cover the BuildUI fallbacks
//   and the multi-root path. Components that need anything else (canvas, layout,
//   net/url, etc.) declare it via the Constructor.imports field; the renderer
//   collects the union across rendered components.
//
// Blueprint:
//   Constructor{goFn, goType, args, prelude, switches, imports}
//     - args items: Prop{name, transform} | Event{name, signature} |
//                   Raw{value}  (template tokens: ${prop}, ${id}, ${children})
//     - prelude: list of raw Go statements emitted in a scope before ctor
//     - switches: Switch{prop, value, goFn} picks alternate goFn at codegen time
//   Init{prop, target, transform, quoted}      one-shot setter
//   Reactive{prop, target, transform}          setter + dep-tracked updater
//   Event{prop, target, signature, bindParam}  closure assigned after ctor
//
// Top-level args on the inner VisualNode:
//   constructor       Constructor{...}
//   bindings          list of Init/Reactive/Event records
//   fieldPrefix       Model field prefix (e.g. "label", "btn")
//   updaterPrefix     reactive updater name prefix (e.g. "updateLabel")
//   condProp          wrap render in `if <prop> { ... }` (modal)
//   transient=true    skip Model storage; assign to caller's resultVar inline

struct Options {
    package string
    main bool
}

// --- VBox-style containers ---

component sngl.vbox {
    platform fyne {
        Container(
            constructor=Constructor{
                goFn="container.NewVBox",
                goType="*fyne.Container",
                args=[Raw{value=`${children}...`}],
            },
            transient=true,
        ) {}
    }
}

component sngl.stack {
    platform fyne {
        Container(
            constructor=Constructor{
                goFn="container.NewVBox",
                goType="*fyne.Container",
                args=[Raw{value=`${children}...`}],
            },
            transient=true,
        ) {}
    }
}

component sngl.scroll {
    platform fyne {
        Container(
            constructor=Constructor{
                goFn="container.NewVScroll",
                goType="*container.Scroll",
                args=[Raw{value=`container.NewVBox(${children}...)`}],
            },
            transient=true,
        ) {}
    }
}

