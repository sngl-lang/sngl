// --- Spacer ---

component sngl.spacer {
    platform fyne {
        Spacer(
            constructor=Constructor{
                goFn="layout.NewSpacer",
                goType="fyne.CanvasObject",
                imports=["fyne.io/fyne/v2/layout"],
                args=[],
            },
            transient=true,
        ) {}
    }
}

// --- Label-rendered widgets ---

component sngl.text {
    platform fyne {
        Label(
            constructor=Constructor{
                goFn="widget.NewLabel",
                goType="*widget.Label",
                args=[Prop{name="value", transform="fmt.Sprint"}],
            },
            bindings=[
                Reactive{prop="value", target=".SetText", transform="fmt.Sprint"},
            ],
            fieldPrefix="label",
            updaterPrefix="updateLabel",
        ) {}
    }
}

component sngl.badge {
    platform fyne {
        Label(
            constructor=Constructor{
                goFn="widget.NewLabel",
