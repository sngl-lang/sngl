// Fyne platform package.
// Raw Fyne widgets and containers are implicitly available via APIResolver.
//
// Components use metadata props to tell the generator how to produce Go code:
//   constructor="widget.NewLabel"          — Go constructor function
//   constructorArgs=[value]                — ordered args; use VariadicChildren{} for variadic
//   importPath="fyne.io/fyne/v2/widget"    — import path for the constructor's package
//   updater=".SetText"                     — updater method for reactive arg
//   updaterProp="value"                    — which prop to watch for updates
//   entry=true                             — use existing entry infrastructure (input/textarea)

// VariadicChildren is a sentinel: when present in constructorArgs, the codegen
// renders all child nodes into a []fyne.CanvasObject slice and spreads them.
struct VariadicChildren {
    values list<dyn>
}

struct Options {
    package string
    main bool
}

// --- Core Layout ---

component sngl.vbox() {
    VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.hbox() {
    HBox(constructor="container.NewHBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.stack() {
    Stack(constructor="container.NewStack", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.spacer() {
    Spacer(constructor="layout.NewSpacer", constructorArgs=[]) {}
}

component sngl.scroll() {
    Scroll(constructor="container.NewVScroll", constructorArgs=[]) {
        slot
    }
}

// --- Core Text & Media ---

component sngl.text() {
    Label(
        constructor="widget.NewLabel",
        constructorArgs=[value],
        updater=".SetText",
        updaterProp="value",
        value=value
    ) {}
}

component sngl.button() {
    Button(
        constructor="widget.NewButton",
        constructorArgs=[text, nil],
        updater=".SetText",
        updaterProp="text",
        text=text
    ) {}
}

component sngl.image() {
    Label(
        constructor="widget.NewLabel",
        constructorArgs=[alt],
        alt=alt
    ) {}
}

component sngl.input() {
    Entry(entry=true) {}
}

component sngl.checkbox() {
    Label(
        constructor="widget.NewLabel",
        constructorArgs=[label],
        label=label
    ) {}
}

// --- Tier 1: Core Input ---

component sngl.radio() {
    VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.toggle() {
    Label(
        constructor="widget.NewLabel",
        constructorArgs=[label],
        label=label
    ) {}
}

component sngl.select() {
    Label(
        constructor="widget.NewLabel",
        constructorArgs=[value],
        value=value
    ) {}
}

component sngl.textarea() {
    Entry(entry=true) {}
}

component sngl.datepicker() {
    Label(
        constructor="widget.NewLabel",
        constructorArgs=[value],
        value=value
    ) {}
}

// --- Tier 2: Feedback & Navigation ---

component sngl.progress() {
    ProgressBar(constructor="widget.NewProgressBar", constructorArgs=[]) {}
}

component sngl.spinner() {
    Activity(constructor="widget.NewActivity", constructorArgs=[]) {}
}

component sngl.badge() {
    Label(
        constructor="widget.NewLabel",
        constructorArgs=[value],
        updater=".SetText",
        updaterProp="value",
        value=value
    ) {}
}

component sngl.divider() {
    Divider(constructor="widget.NewSeparator", constructorArgs=[]) {}
}

component sngl.card() {
    Card(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.chip() {
    Label(
        constructor="widget.NewLabel",
        constructorArgs=[label],
        label=label
    ) {}
}

component sngl.link() {
    Label(
        constructor="widget.NewLabel",
        constructorArgs=[text],
        text=text
    ) {}
}

component sngl.tabs() {
    VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.modal() {
    if open {
        VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
            slot
        }
    }
}

component sngl.drawer() {
    VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.tooltip() {
    VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.popover() {
    VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.accordion() {
    VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.splitview() {
    HBox(constructor="container.NewHBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.table() {
    VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.tree() {
    VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.menu() {
    VBox(constructor="container.NewVBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.menubar() {
    HBox(constructor="container.NewHBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.toolbar() {
    HBox(constructor="container.NewHBox", constructorArgs=[VariadicChildren{}]) {
        slot
    }
}

component sngl.avatar() {
    Label(
        constructor="widget.NewLabel",
        constructorArgs=[initials],
        initials=initials
    ) {}
}
