// Go language package. Declarations here are visible at every output target
// that selects --lang go.

import . "sngl:macro"
import ir "sngl:internal/ir"
import http "sngl:remote/http"
import build "sngl:build"

// The `go` node of a build directive: `output { go { bubbletea() } }`. Its
// props are the build options every Go target accepts, and its slot is the
// platforms built with them.
component go(
    // Go toolchain version emitted in generated go.mod files. Unset takes the
    // host's own go.mod line, and 1.23 where there is none.
    goVersion string,
    // Extra text appended verbatim to temp module go.mod files written by
    // platform test runners. Typical use: a `replace
    // git.duckfam.us/jonathan/sngl => /path/to/repo` directive so generated
    // code that imports SNGL runtime packages (pkg/go/i18n, …) resolves
    // locally instead of via the public proxy.
    goModExtra string,
    platforms ...component build.platform,
) build.language {}

// --- sngl:remote/http ---

// The Go transport. `native` rather than a `go:` import, so the request package
// is pulled in only by a build that actually fetches: an import at the top of
// this file is resolved by every program built for Go.
// Names the Go package-level identifier a declaration *is*. A thin spelling of
// #[foreign(..., native)] in the language it is about, which is where a Go path
// and a Go identifier belong — and which a package can now use on its own
// declarations, since a mark resolves through the scope like any other name.
func native(path string, name string, flags list<NativeFlag> = []) ir.Macro

// Says a call to this function blocks, so a target that draws on one thread
// must not make the call there.
//
// Go has no way to suspend a function: a call runs on the goroutine that made
// it, and on fyne, gtk4 or bubbletea that goroutine is the one drawing the
// screen. The mark is what tells a target to run the call on a goroutine of its
// own and hand the answer back through whatever reaches its thread — `fyne.Do`,
// a GLib idle tick, a message into the Bubble Tea loop.
//
// It is not `#[foreign(..., async)]`. That flag says the declaration *returns a
// promise its caller awaits*, which is what the TypeScript importer reads off a
// `Promise<T>`; a Go function that blocks returns its value directly and has no
// promise, so the flag would be a false statement about the declaration. What
// the two do share is the propagation rule, and so the fact they both record: a
// function that calls one is one.
//
// Only a function carries it — a struct has no call to describe.
func async() ir.Macro

// What a Go declaration's shape says beyond its name.
//
// `fails` says the function returns `(T, error)` where the SNGL declaration
// answers T alone — the shape half of Go's standard library is written in, and
// the one the Go importer reads off a signature it can see. A declaration named
// here has no signature to read, so the mark is where it is said.
//
// It describes a call, so a struct refuses it.
// `method` says the identifier is invoked on its first argument rather than
// handed it, which is what a Go method wants: `c.Circle(1, 2)` rather than the
// method-expression spelling `canvas.Context.Circle(c, 1, 2)`. Both are valid;
// only the API knows which it is.
enum NativeFlag { fails, method }

#[native("git.duckfam.us/jonathan/sngl/pkg/go/remote/http", "http.Get", fails)]
func httpGet(url string) http.Result

// What sngl:remote/http declares and leaves to each target. An override rather
// than an intrinsic: there is no string for a code generator to build here,
// only a call to name.
func http.get[language]() {
    return httpGet(url)
}
