// ==== TestEmitNative ====
package ui

import "testing"

func TestMeasurementArithmetic(t *testing.T) {
	__snglTestComponent := newTestComponent()
	c := __snglTestComponent
	_ = c
	three := Measurement{Px: 3}
	five := Measurement{Px: 5}
	six := Measurement{Px: 6}
	sixteen := Measurement{Px: 16}
	if !((Measurement{Px: three.Px + Measurement{Px: 2}.Px, Em: three.Em + Measurement{Px: 2}.Em, Vw: three.Vw + Measurement{Px: 2}.Vw, Vh: three.Vh + Measurement{Px: 2}.Vh, Pct: three.Pct + Measurement{Px: 2}.Pct} == Measurement{Px: 5})) { t.Errorf("assert failed: %s", "(Measurement{Px: three.Px + Measurement{Px: 2}.Px, Em: three.Em + Measurement{Px: 2}.Em, Vw: three.Vw + Measurement{Px: 2}.Vw, Vh: three.Vh + Measurement{Px: 2}.Vh, Pct: three.Pct + Measurement{Px: 2}.Pct} == Measurement{Px: 5})") }
	if !((Measurement{Px: sixteen.Px + Measurement{Em: 2}.Px, Em: sixteen.Em + Measurement{Em: 2}.Em, Vw: sixteen.Vw + Measurement{Em: 2}.Vw, Vh: sixteen.Vh + Measurement{Em: 2}.Vh, Pct: sixteen.Pct + Measurement{Em: 2}.Pct} == Measurement{Px: Measurement{Em: 2}.Px + Measurement{Px: 16}.Px, Em: Measurement{Em: 2}.Em + Measurement{Px: 16}.Em, Vw: Measurement{Em: 2}.Vw + Measurement{Px: 16}.Vw, Vh: Measurement{Em: 2}.Vh + Measurement{Px: 16}.Vh, Pct: Measurement{Em: 2}.Pct + Measurement{Px: 16}.Pct})) { t.Errorf("assert failed: %s", "(Measurement{Px: sixteen.Px + Measurement{Em: 2}.Px, Em: sixteen.Em + Measurement{Em: 2}.Em, Vw: sixteen.Vw + Measurement{Em: 2}.Vw, Vh: sixteen.Vh + Measurement{Em: 2}.Vh, Pct: sixteen.Pct + Measurement{Em: 2}.Pct} == Measurement{Px: Measurement{Em: 2}.Px + Measurement{Px: 16}.Px, Em: Measurement{Em: 2}.Em + Measurement{Px: 16}.Em, Vw: Measurement{Em: 2}.Vw + Measurement{Px: 16}.Vw, Vh: Measurement{Em: 2}.Vh + Measurement{Px: 16}.Vh, Pct: Measurement{Em: 2}.Pct + Measurement{Px: 16}.Pct})") }
	if !((Measurement{Px: five.Px - Measurement{Px: 2}.Px, Em: five.Em - Measurement{Px: 2}.Em, Vw: five.Vw - Measurement{Px: 2}.Vw, Vh: five.Vh - Measurement{Px: 2}.Vh, Pct: five.Pct - Measurement{Px: 2}.Pct} == Measurement{Px: 3})) { t.Errorf("assert failed: %s", "(Measurement{Px: five.Px - Measurement{Px: 2}.Px, Em: five.Em - Measurement{Px: 2}.Em, Vw: five.Vw - Measurement{Px: 2}.Vw, Vh: five.Vh - Measurement{Px: 2}.Vh, Pct: five.Pct - Measurement{Px: 2}.Pct} == Measurement{Px: 3})") }
	if !((Measurement{Px: 2 * three.Px, Em: 2 * three.Em, Vw: 2 * three.Vw, Vh: 2 * three.Vh, Pct: 2 * three.Pct} == Measurement{Px: 6})) { t.Errorf("assert failed: %s", "(Measurement{Px: 2 * three.Px, Em: 2 * three.Em, Vw: 2 * three.Vw, Vh: 2 * three.Vh, Pct: 2 * three.Pct} == Measurement{Px: 6})") }
	if !((Measurement{Px: six.Px / 2, Em: six.Em / 2, Vw: six.Vw / 2, Vh: six.Vh / 2, Pct: six.Pct / 2} == Measurement{Px: 3})) { t.Errorf("assert failed: %s", "(Measurement{Px: six.Px / 2, Em: six.Em / 2, Vw: six.Vw / 2, Vh: six.Vh / 2, Pct: six.Pct / 2} == Measurement{Px: 3})") }
}


// ==== TestEmitAgent ====
package ui

import "git.duckfam.us/jonathan/sngl/pkg/go/testagent"

func testMeasurementArithmetic(t *testagent.T) {
	__snglTestComponent := newTestComponent()
	setCurrentTestModel(__snglTestComponent)
	c := __snglTestComponent
	_ = c
	three := Measurement{Px: 3}
	five := Measurement{Px: 5}
	six := Measurement{Px: 6}
	sixteen := Measurement{Px: 16}
	if !((Measurement{Px: three.Px + Measurement{Px: 2}.Px, Em: three.Em + Measurement{Px: 2}.Em, Vw: three.Vw + Measurement{Px: 2}.Vw, Vh: three.Vh + Measurement{Px: 2}.Vh, Pct: three.Pct + Measurement{Px: 2}.Pct} == Measurement{Px: 5})) { t.Errorf("assert failed: %s", "(Measurement{Px: three.Px + Measurement{Px: 2}.Px, Em: three.Em + Measurement{Px: 2}.Em, Vw: three.Vw + Measurement{Px: 2}.Vw, Vh: three.Vh + Measurement{Px: 2}.Vh, Pct: three.Pct + Measurement{Px: 2}.Pct} == Measurement{Px: 5})") }
	if !((Measurement{Px: sixteen.Px + Measurement{Em: 2}.Px, Em: sixteen.Em + Measurement{Em: 2}.Em, Vw: sixteen.Vw + Measurement{Em: 2}.Vw, Vh: sixteen.Vh + Measurement{Em: 2}.Vh, Pct: sixteen.Pct + Measurement{Em: 2}.Pct} == Measurement{Px: Measurement{Em: 2}.Px + Measurement{Px: 16}.Px, Em: Measurement{Em: 2}.Em + Measurement{Px: 16}.Em, Vw: Measurement{Em: 2}.Vw + Measurement{Px: 16}.Vw, Vh: Measurement{Em: 2}.Vh + Measurement{Px: 16}.Vh, Pct: Measurement{Em: 2}.Pct + Measurement{Px: 16}.Pct})) { t.Errorf("assert failed: %s", "(Measurement{Px: sixteen.Px + Measurement{Em: 2}.Px, Em: sixteen.Em + Measurement{Em: 2}.Em, Vw: sixteen.Vw + Measurement{Em: 2}.Vw, Vh: sixteen.Vh + Measurement{Em: 2}.Vh, Pct: sixteen.Pct + Measurement{Em: 2}.Pct} == Measurement{Px: Measurement{Em: 2}.Px + Measurement{Px: 16}.Px, Em: Measurement{Em: 2}.Em + Measurement{Px: 16}.Em, Vw: Measurement{Em: 2}.Vw + Measurement{Px: 16}.Vw, Vh: Measurement{Em: 2}.Vh + Measurement{Px: 16}.Vh, Pct: Measurement{Em: 2}.Pct + Measurement{Px: 16}.Pct})") }
	if !((Measurement{Px: five.Px - Measurement{Px: 2}.Px, Em: five.Em - Measurement{Px: 2}.Em, Vw: five.Vw - Measurement{Px: 2}.Vw, Vh: five.Vh - Measurement{Px: 2}.Vh, Pct: five.Pct - Measurement{Px: 2}.Pct} == Measurement{Px: 3})) { t.Errorf("assert failed: %s", "(Measurement{Px: five.Px - Measurement{Px: 2}.Px, Em: five.Em - Measurement{Px: 2}.Em, Vw: five.Vw - Measurement{Px: 2}.Vw, Vh: five.Vh - Measurement{Px: 2}.Vh, Pct: five.Pct - Measurement{Px: 2}.Pct} == Measurement{Px: 3})") }
	if !((Measurement{Px: 2 * three.Px, Em: 2 * three.Em, Vw: 2 * three.Vw, Vh: 2 * three.Vh, Pct: 2 * three.Pct} == Measurement{Px: 6})) { t.Errorf("assert failed: %s", "(Measurement{Px: 2 * three.Px, Em: 2 * three.Em, Vw: 2 * three.Vw, Vh: 2 * three.Vh, Pct: 2 * three.Pct} == Measurement{Px: 6})") }
	if !((Measurement{Px: six.Px / 2, Em: six.Em / 2, Vw: six.Vw / 2, Vh: six.Vh / 2, Pct: six.Pct / 2} == Measurement{Px: 3})) { t.Errorf("assert failed: %s", "(Measurement{Px: six.Px / 2, Em: six.Em / 2, Vw: six.Vw / 2, Vh: six.Vh / 2, Pct: six.Pct / 2} == Measurement{Px: 3})") }
}

func init() {
	testagent.RegisterTest("MeasurementArithmetic", testMeasurementArithmetic)
}
