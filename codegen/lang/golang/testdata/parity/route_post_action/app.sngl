import . "sngl://std"

// HTTP route window whose @click calls a go:// native func (api.Persist),
// exercising html route mode (--lang go) end-to-end through the golang
// HTTP-compiler path. NOTE: this parity harness's optimize+lower inlines the
// handler to client-side JS, so server.golden pins the GET/client output, NOT
// a server-side POST handler body. (The full `sngl` CLI pipeline does emit a
// POST handleAppAction; its mutation body is a separate, pre-existing
// incomplete path — see the known-issue note — and was verified byte-identical
// across the http.go→GoIRContext migration by direct CLI comparison.)
output { go { html } }

import "go://example.com/route-post/api"

component main {
    var count = 0

    window #app(title="t", href="/") {
        vbox {
            button(text="Save", @click {
                count = api.Persist(count + 1)
            })
            text(value="count {count}")
        }
    }
}
