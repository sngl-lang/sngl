import . "sngl:std"

// Client-only HTTP route window: the @click handler mutates SNGL state only
// (no go: native call), so it stays pure client-side JS. This fixture is the
// no-backend route parity baseline (Phase 0): its server.go output must remain
// byte-identical as the front/back-end placement feature lands.
output { go { html } }

component main {
    var count = 0

    window #app(title="t", href="/") {
        vbox {
            button(text="Inc", @click {
                count = count + 1
            })
            text(value="count {count}")
        }
    }
}
