package main

import (
	"net/http"
)

// Handler returns an http.Handler wired with every route.
func Handler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /", handleApp)
	return mux
}

func handleApp(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Write([]byte("<!DOCTYPE html>\n<html><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>t</title>\n  <style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: system-ui, sans-serif; }\n  </style>\n</head><body>\n\n<vbox>\n  <button id=\"$0\" text=\"Inc\">\n  </button>\n  <text id=\"__n0\" data-sngl-id=\"__n0\">\n  </text>\n</vbox>\n\n<script>\n(() => {\n  // ../../../../../../../../../sngl/sngl-entry.js\n  var state = { count: 0 };\n  function String(v) {\n    return \"\" + v;\n  }\n  var $0 = document.getElementById(\"$0\");\n  var __n0 = document.querySelector('[data-sngl-id=\"__n0\"]');\n  $0.addEventListener(\"click\", function() {\n    state.count = state.count + 1;\n    __n0.textContent = \"count \" + String(state.count);\n  });\n  function __sngl_init() {\n    __n0.textContent = \"count \" + String(state.count);\n  }\n  __sngl_init();\n})();\n</script>\n</body></html>\n"))
}


func main() {
	http.ListenAndServe(":8080", Handler())
}
