// JavaScript language package. Declarations here are visible at every output
// target that selects --lang js.
//
// The build node is declared with no props and that is deliberate. An empty
// prop list is a fact — this target takes no build options — so a misspelled or
// misplaced option is reported here rather than accepted and ignored. A target
// with no package at all could not say even that.

import . "sngl:macro"
import ir "sngl:internal/ir"
import build "sngl:build"

// The `js` node of a build directive: `output { js { html() } }`. It carries
// no props, which is a fact rather than an omission -- this target takes no
// build options -- and a misplaced option is reported against it.
component js(platforms ...component build.platform) build.language {}

// Names the JavaScript identifier a declaration *is*, rather than one it
// corresponds to. The JS counterpart of `go.native`, and the same thin spelling
// of #[foreign(...)] in the language it is about.
//
// The name comes first and the module is optional, which is the one place this
// parts company with Go's. A Go identifier is always package-qualified, so
// `go.native` can require a path; a JavaScript one need not come from a module
// at all — `setInterval` is a property of `globalThis`, and there is no path to
// name. An empty module is that: a global, emitted as a bare call.
//
// A declaration marked here is not emitted. The identifier already exists, and
// a call becomes a call to it — which is why the declaration carries no body,
// and why naming one costs nothing until something calls it.
func native(name string, module string = "", flags list<NativeFlag> = []) ir.Macro

// What a JavaScript declaration's shape says beyond its name.
//
// `async` says the function answers a promise, so a call to it is awaited. It
// is the same fact the TypeScript importer reads off a `Promise<T>` return; a
// declaration named here has no signature to read, so the mark is where it is
// said.
//
// Go's `fails` has no counterpart here: `(T, error)` is a Go convention, and a
// JavaScript function that fails throws.
//
// It describes a call, so a struct refuses it.
// `method` says the identifier is a method of its first argument. A DOM API
// has no other shape -- `ctx.arc(x, y, r)` and never `arc(ctx, x, y, r)` --
// so describing one needs this.
enum NativeFlag { async, method }
