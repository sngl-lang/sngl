Maps: a literal, a key written and read, a key missing read as zero or as
the default get is handed, contains, a loop in the order keys were first
set, and keys and values as lists.

-- app.sngl --
func counts(words list[string]) string {
    var m map[string, int] = {"z" = 0}
    for var w = words {
        m[w] = m[w] + 1
    }
    var out = ""
    for var k, v = m {
        out += "{k}={v} "
    }
    return out + "{m.length()} {m.contains("a")} {m.contains("q")} {m.get("q", 7)} {m["q"]}"
}

func words() list[string] {
    return ["a", "b", "a", "z"]
}

func parts() string {
    var m map[int, string] = {3 = "c", 1 = "a"}
    m[2] = "b"
    return "{m.keys()} / {m.values()._join("")}"
}
-- main.c --
#include "program.c"
#include <stdio.h>

static void print(sngl_string s) { printf("%.*s\n", (int)s.len, s.ptr); }

int main(void) {
	print(s_counts(s_words()));
	print(s_parts());
	return 0;
}
-- want --
z=1 a=2 b=1 3 true false 7 0
3, 1, 2 / cab
