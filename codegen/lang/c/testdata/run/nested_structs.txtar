A C struct may hold another C struct by value, as Win32's
NMDATETIMECHANGE holds an NMHDR and a SYSTEMTIME: each crosses field by
field, in and back, by value, by ref and by ref through an integer typedef
(`#[c.type]`), and one a C function answers is read back the same way. A
nested struct holding a string keeps it, as its holder would.

-- app.sngl --
import c "sngl:x/c"

c.link(include="stdio.h", system=true)

#[c.native("test_win *")]
struct Win {}

#[c.native("test_win_new")]
func newWin(code int) Win

#[c.native("test_win.code", field)]
func code(w Win) int

#[c.native("test_word")]
struct Word = int

#[c.native("test_header")]
struct Header {
    from Win
    id   int
    code int
}

#[c.native("test_time")]
struct Time {
    year  Word
    month Word
    day   Word
}

#[c.native("test_change")]
struct Change {
    hdr   Header
    flags int
    st    Time
}

#[c.native("test_label")]
struct Label {
    text string
    n    int
}

#[c.native("test_labeled")]
struct Labeled {
    label Label
    on    bool
}

#[c.native("test_by_value")]
func byValue(ch Change) int

#[c.native("test_by_ref")]
func byRef(ch ref[Change]) int

#[c.native("test_answer")]
func answer(year int) Change

#[c.native("test_param")]
struct Param = int

#[c.native("test_send")]
func send(msg int, #[c.type("test_param")] ch ref[Change]) Param

#[c.native("test_label_ref")]
func labelRef(l ref[Labeled]) int

func change(year int) Change {
    return Change{hdr=Header{from=newWin(4), id=5, code=-760}, flags=1, st=Time{year=year, month=11, day=21}}
}

func shown(ch Change) string {
    return "{code(ch.hdr.from)} {ch.hdr.id} {ch.hdr.code} {ch.flags} {ch.st.year}-{ch.st.month}-{ch.st.day}"
}

func run() string {
    var ch = change(2026)
    var v = byValue(ch)
    var r = byRef(&ch)
    var ch2 = change(2025)
    var s = send(1, &ch2)
    var a = answer(1999)
    var l = Labeled{label=Label{text="kept", n=1}, on=true}
    var n = labelRef(&l)
    return "{v} | {r} {shown(ch)} | {s} {shown(ch2)} | {shown(a)} | {n} {l.label.text} {l.label.n} {l.on}"
}
-- main.c --
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct test_win {
	int code;
} test_win;

static test_win wins[16];

static test_win *test_win_new(int code) {
	wins[code].code = code;
	return &wins[code];
}

typedef unsigned short test_word;

typedef struct test_header {
	test_win *from;
	int id;
	int code;
} test_header;

typedef struct test_time {
	test_word year, month, day;
} test_time;

typedef struct test_change {
	test_header hdr;
	int flags;
	test_time st;
} test_change;

typedef struct test_label {
	const char *text;
	int n;
} test_label;

typedef struct test_labeled {
	test_label label;
	int on;
} test_labeled;

static int test_by_value(test_change ch) {
	return ch.hdr.from->code * 100000 + ch.hdr.id * 10000 + (ch.hdr.code == -760) * 1000 + ch.st.year - 2000 + ch.st.month * 10 + ch.st.day;
}

// Reads ch, then writes a field of each struct it holds.
static int test_by_ref(test_change *ch) {
	int r = test_by_value(*ch);
	ch->hdr.from = test_win_new(9);
	ch->hdr.code = -1;
	ch->flags = 2;
	ch->st.day = 1;
	return r;
}

static test_change test_answer(int year) {
	test_change ch = {{test_win_new(3), 6, 7}, 8, {(test_word)year, 12, 31}};
	return ch;
}

typedef intptr_t test_param;

static test_param test_send(int msg, test_param l) {
	return msg == 1 ? test_by_ref((test_change *)l) : 0;
}

static int test_label_ref(test_labeled *l) {
	int r = (int)strlen(l->label.text) * 10 + l->label.n + l->on * 100;
	l->label.text = "lost";
	l->label.n = 2;
	l->on = 0;
	return r;
}

#include "program.c"

int main(void) {
	sngl_string s = s_run();
	printf("%.*s\n", (int)s.len, s.ptr);
	return 0;
}
-- want --
451157 | 451157 9 5 -1 2 2026-11-1 | 451156 9 5 -1 2 2025-11-1 | 3 6 7 8 1999-12-31 | 141 kept 2 false
