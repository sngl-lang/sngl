Keeping a value walks what it holds, a frame or more of the C stack for
each value nested in another, so the runtime bounds how deep: a closure
capturing the one before it, a thousand deep, is kept, called and given
back, as a tree nested as deep is, and a closure three thousand deep stops
the program with a panic rather than overflow the stack; trees.txtar does
the same with a tree.

A kept environment is shared rather than copied, so a chain of closures
three thousand long, each link kept the turn it is made, keeps one block a
link: keeping a link counts a holder of the one before it, where copying
it copied the chain again, deeper than the bound and quadratic in all.

-- app.sngl --
struct Tree {
    kids list[Tree]
}

func zero(n int) int {
    return 0
}

func wrap(prev func(int) int) func(int) int {
    return func(n int) int {
        return 1 + prev(n)
    }
}

func start() func(int) int {
    return zero
}

func nest(t Tree) Tree {
    return Tree{kids = [t]}
}

func leaf() Tree {
    return Tree{kids = []}
}

func holding(t Tree) func(int) int {
    return func(n int) int {
        return n + t.kids.length
    }
}
-- main.c --
#include "program.c"
#include <stdio.h>
#include <stdlib.h>

static void caught(const char *msg) {
	printf("panic: %s\n", msg);
	exit(0);
}

static sngl_fn_int__int chain(int n) {
	sngl_fn_int__int f = s_start();
	for (int i = 0; i < n; i++) {
		f = s_wrap(f);
	}
	return f;
}

int main(void) {
	sngl_panic_hook = caught;
	sngl_turn_enter();
	sngl_fn_int__int f = chain(1000);
	f.env = sngl_env_keep(f.env);
	sngl_turn_leave();
	sngl_turn_enter();
	printf("%lld\n", (long long)f.fn(f.env, 0));
	sngl_env_drop(f.env);
	sngl_turn_leave();
	printf("%lld kept\n", (long long)sngl_kept_blocks());

	sngl_turn_enter();
	s_Tree t = s_leaf();
	for (int i = 0; i < 1000; i++) {
		t = s_nest(t);
	}
	sngl_fn_int__int h = s_holding(t);
	h.env = sngl_env_keep(h.env);
	sngl_turn_leave();
	sngl_turn_enter();
	sngl_env_drop(h.env);
	sngl_turn_leave();
	printf("%lld kept\n", (long long)sngl_kept_blocks());

	static sngl_fn_int__int links[3000];
	sngl_fn_int__int g = s_start();
	for (int i = 0; i < 3000; i++) {
		sngl_turn_enter();
		g = s_wrap(g);
		g.env = sngl_env_keep(g.env);
		links[i] = g;
		sngl_turn_leave();
	}
	printf("%lld kept\n", (long long)sngl_kept_blocks());
	sngl_turn_enter();
	printf("%lld\n", (long long)g.fn(g.env, 0));
	for (int i = 0; i < 3000; i++) {
		sngl_env_drop(links[i].env);
	}
	sngl_turn_leave();
	printf("%lld kept\n", (long long)sngl_kept_blocks());

	sngl_turn_enter();
	f = chain(3000);
	sngl_env_keep(f.env);
	printf("kept\n");
	return 0;
}
-- want --
1000
0 kept
0 kept
3000 kept
3000
0 kept
panic: a value nests more than 2000 deep
