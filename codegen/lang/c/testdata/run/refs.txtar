A `ref` a C function takes is a pointer it fills: the call hands C the
address of a C temp and hands back what C wrote, as a function with a body
hands back what it wrote (lower.RefParams). It stays a pointer at C's own
type, which no box of passNoRef's is. A scalar's temp is its C type; a
`#[c.native]` struct with fields -- a GtkAllocation, which
gtk_widget_size_allocate reads -- crosses into its temp field by field, each
field as its alias's typedef, and back onto the caller's variable the same
way. A call answering a value as well hands back both, and a struct handed
by value beside a ref crosses as it does in any call.

-- app.sngl --
import c "sngl:x/c"

c.link(include="stdio.h", system=true)

#[c.native("unsigned short")]
struct Tag = int

#[c.native("test_rect")]
struct Rect {
    x      int
    y      int
    width  int
    height int
    tag    Tag
}

#[c.native("test_divide")]
func divide(a int, b int, q ref[int], rem ref[int])

#[c.native("test_move")]
func move(r ref[Rect], by int)

#[c.native("test_grow")]
func grow(r ref[Rect], by int) int

#[c.native("test_add")]
func add(r ref[Rect], by Rect)

func divided() int {
    var q = 0
    var rem = 0
    divide(17, 5, &q, &rem)
    return q * 10 + rem
}

func moved() Rect {
    var r = Rect{x=1, y=2, width=3, height=4, tag=5}
    move(&r, 10)
    return r
}

func grown() int {
    var r = Rect{x=1, y=2, width=3, height=4, tag=65535}
    var area = grow(&r, 1)
    return area * 1000 + r.width * 100 + r.height * 10 + r.tag
}

func added() int {
    var r = Rect{x=1, y=2, width=3, height=4, tag=5}
    add(&r, Rect{x=10, y=20, width=30, height=40, tag=50})
    return r.x + r.y + r.width + r.height + r.tag
}
-- main.c --
#include <stdio.h>

typedef struct {
	int x, y, width, height;
	unsigned short tag;
} test_rect;

static void test_divide(int a, int b, int *q, int *rem) {
	*q = a / b;
	*rem = a % b;
}

static void test_move(test_rect *r, int by) {
	r->x += by;
	r->y += by;
	r->tag++;
}

// Grows *r by by on each side, wraps its tag round, and answers its old
// area.
static int test_grow(test_rect *r, int by) {
	int area = r->width * r->height;
	r->width += 2 * by;
	r->height += 2 * by;
	r->tag++;
	return area;
}

static void test_add(test_rect *r, test_rect by) {
	r->x += by.x;
	r->y += by.y;
	r->width += by.width;
	r->height += by.height;
	r->tag += by.tag;
}

#include "program.c"

int main(void) {
	printf("%d\n", (int)s_divided());
	s_Rect r = s_moved();
	printf("%d %d %d %d %d\n", (int)r.x, (int)r.y, (int)r.width, (int)r.height, (int)r.tag);
	printf("%d\n", (int)s_grown());
	printf("%d\n", (int)s_added());
	return 0;
}
