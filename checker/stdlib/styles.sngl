styles {
    // Sizing
    width measurement
    height measurement
    min-width measurement
    min-height measurement
    max-width measurement
    max-height measurement
    aspect-ratio float

    // Padding
    padding measurement
    padding-top measurement
    padding-right measurement
    padding-bottom measurement
    padding-left measurement
    padding-x measurement
    padding-y measurement

    // Margin
    margin measurement
    margin-top measurement
    margin-right measurement
    margin-bottom measurement
    margin-left measurement
    margin-x measurement
    margin-y measurement

    // Flex
    flex float
    flex-grow float
    flex-shrink float
    flex-basis measurement
    align-self string enum(auto, flex-start, flex-end, center, baseline, stretch)

    // Positioning
    position string enum(static, relative, absolute, fixed, sticky)
    top measurement
    right measurement
    bottom measurement
    left measurement
    z-index int

    // Container Layout
    gap measurement
    row-gap measurement
    column-gap measurement
    align-items string enum(flex-start, flex-end, center, baseline, stretch)
    justify-content string enum(flex-start, flex-end, center, space-between, space-around, space-evenly)
    flex-wrap string enum(nowrap, wrap, wrap-reverse)

    // Visual Properties
    background color
    border-color color
    border-width measurement
    border-radius measurement
    opacity float
    overflow string enum(visible, hidden, scroll, auto)

    // Text-specific style properties
    color color
    font-size measurement
    font-weight string enum(normal, bold, 100, 200, 300, 400, 500, 600, 700, 800, 900)
    font-style string enum(normal, italic, oblique)
    font-family string
    text-align string enum(left, center, right, justify)
    line-height float
    text-overflow string enum(clip, ellipsis)
    max-lines int

    // Input-specific style properties
    placeholder-color color
}
