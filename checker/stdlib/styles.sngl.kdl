styles {
    // Sizing
    width (dyn)null
    height (dyn)null
    min-width (dyn)null
    min-height (dyn)null
    max-width (dyn)null
    max-height (dyn)null
    aspect-ratio (float)null

    // Padding
    padding (dyn)null
    padding-top (dyn)null
    padding-right (dyn)null
    padding-bottom (dyn)null
    padding-left (dyn)null
    padding-x (dyn)null
    padding-y (dyn)null

    // Margin
    margin (dyn)null
    margin-top (dyn)null
    margin-right (dyn)null
    margin-bottom (dyn)null
    margin-left (dyn)null
    margin-x (dyn)null
    margin-y (dyn)null

    // Flex
    flex (float)null
    flex-grow (float)null
    flex-shrink (float)null
    flex-basis (dyn)null
    align-self (string)null {
        @enum "auto" "flex-start" "flex-end" "center" "baseline" "stretch"
    }

    // Positioning
    position (string)null {
        @enum "static" "relative" "absolute" "fixed" "sticky"
    }
    top (dyn)null
    right (dyn)null
    bottom (dyn)null
    left (dyn)null
    z-index (int)null

    // Container Layout
    gap (dyn)null
    row-gap (dyn)null
    column-gap (dyn)null
    align-items (string)null {
        @enum "flex-start" "flex-end" "center" "baseline" "stretch"
    }
    justify-content (string)null {
        @enum "flex-start" "flex-end" "center" "space-between" "space-around" "space-evenly"
    }
    flex-wrap (string)null {
        @enum "nowrap" "wrap" "wrap-reverse"
    }

    // Visual Properties
    background (color)null
    border-color (color)null
    border-width (dyn)null
    border-radius (dyn)null
    opacity (float)null
    overflow (string)null {
        @enum "visible" "hidden" "scroll" "auto"
    }

    // Text-specific style properties
    color (color)null
    font-size (float)null
    font-weight (string)null {
        @enum "normal" "bold" "100" "200" "300" "400" "500" "600" "700" "800" "900"
    }
    font-style (string)null {
        @enum "normal" "italic" "oblique"
    }
    font-family (string)null
    text-align (string)null {
        @enum "left" "center" "right" "justify"
    }
    line-height (float)null
    text-overflow (string)null {
        @enum "clip" "ellipsis"
    }
    max-lines (int)null

    // Input-specific style properties
    placeholder-color (color)null
}
