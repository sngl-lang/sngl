import ui "sngl:ui"
import "./calc"
import "./keypad"
import "./readout"

output(name="Calculator", icon="icon.svg", description="A pocket calculator, on every target SNGL has.") {
    go {
        bubbletea(package="calculator")
        fyne(package="calculator")
    }
    none { html }
    kotlin {
        android(package="us.duckfam.sngl.calculator", color="#f59e0b")
    }
}

component Calculator root {
    var state calc.Calc

    // One key, one method. The calculator never edits itself: each method
    // answers with the next calculator and the assignment is what makes the
    // readout redraw.
    func press(k keypad.Key) {
        if k.action == keypad.Action.digit {
            state = state.digit(k.digit)
        }
        if k.action == keypad.Action.point {
            state = state.point()
        }
        if k.action == keypad.Action.operate {
            state = state.operate(k.op)
        }
        if k.action == keypad.Action.equals {
            state = state.equals()
        }
        if k.action == keypad.Action.clear {
            state = state.clear()
        }
        if k.action == keypad.Action.negate {
            state = state.negate()
        }
        if k.action == keypad.Action.percent {
            state = state.percent()
        }
        if k.action == keypad.Action.backspace {
            state = state.backspace()
        }
    }

    // A key on the keyboard presses the key on the keypad it is a shortcut
    // of, and goes no further: the Enter that means `=` presses no button
    // focus was left on. A key held with Control, Alt or Meta is a shortcut
    // of the system's, and the window leaves it alone, as it does every key
    // no keypad key answers.
    ui.window #calculator(title="Calculator", @key(e, stop) {
        if e.ctrl || e.alt || e.meta {
            return
        }
        var k = keypad.keyFor(e.key)
        if k != null {
            press(k)
            stop()
        }
    }) {
        ui.vbox(style={flex=1, background=#15171c}) {
            readout.Readout(entry=state.entry, pending=state.pending())
            keypad.Keypad(@press(k) { press(k) })
        }
    }
}

Calculator()
