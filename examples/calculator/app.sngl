import ui "sngl:ui"
import "./calc"
import "./keypad"
import "./readout"

output {
    go {
        bubbletea(package="calculator")
        fyne(package="calculator")
    }
    none { html }
    kotlin { android }
}

component main ui.node {
    var state calc.Calc

    // One key, one method. The calculator never edits itself: each method
    // answers with the next calculator and the assignment is what makes the
    // readout redraw.
    func press(k keypad.Key) {
        if k.action == keypad.Action.digit {
            state = state.digit(k.digit)
        }
        if k.action == keypad.Action.point {
            state = state.point()
        }
        if k.action == keypad.Action.operate {
            state = state.operate(k.op)
        }
        if k.action == keypad.Action.equals {
            state = state.equals()
        }
        if k.action == keypad.Action.clear {
            state = state.clear()
        }
        if k.action == keypad.Action.negate {
            state = state.negate()
        }
        if k.action == keypad.Action.percent {
            state = state.percent()
        }
        if k.action == keypad.Action.backspace {
            state = state.backspace()
        }
    }

    ui.vbox(style={flex=1, background=#15171c}) {
        readout.Readout(entry=state.entry, pending=state.pending())
        keypad.Keypad(@press(k) { press(k) })
    }
}

ui.window #calculator(title="Calculator", href="/") {
    main
}
