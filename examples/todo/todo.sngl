output {
    go {
        bubbletea
        fyne
    }
    js { html }
    kotlin { android }
}

struct Todo {
    text string = ""
    done bool = false
}

component main {
    var (
        newTodo = ""
        todos list<Todo> = [
            {text = "Buy groceries", done = false},
            {text = "Walk the dog", done = true},
            {text = "Write SNGL docs", done = false},
        ]
    )

    func status() => "Todo List ({todos.length} items)"

    vbox(style={gap=12, padding=16}) {
        text(value=status, style={fontWeight=bold, fontSize=24})
        hbox(style={alignItems=center, gap=8, textAlign=center}) {
            input(placeholder="Buy eggs", @input(e) { newTodo = e.value })
            button(text="Add", @click { todos.push(Todo{text=newTodo}); newTodo = "" })
        }
        vbox(style={gap=4}) {
            for item, index = todos {
                checkbox(checked=item.done, label=item.text, @change { todos[index].done!! })
            }
        }
        button(text="Remove", @click { todos.remove(todos.length - 1) }, style={alignItems="center"})
    }
}
