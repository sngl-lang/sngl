import ui "sngl:ui"

output {
    go {
        bubbletea
        fyne
    }
    none { html }
    kotlin { android }
}

struct Todo {
    text string = ""
    done bool = false
}

ui.window {
    var (
        newTodo = ""
        todos list<Todo> = [
            {text="Buy groceries", done=false},
            {text="Walk the dog", done=true},
            {text="Write SNGL docs", done=false},
        ]
    )

    func status() => "Todo List ({todos.length} items)"

    ui.vbox(style={gap=12px, padding=16px}) {
        ui.text(value=status, style={fontWeight=bold, fontSize=24px})
        ui.hbox(style={alignItems=center, gap=8px, textAlign=center}) {
            ui.input(placeholder="Buy eggs", :value=newTodo)
            ui.button(text="Add", @click { todos.push(Todo{text=newTodo}); newTodo = "" })
        }
        ui.vbox(style={gap=4px}) {
            for var index, item = todos {
                ui.checkbox(checked=item.done, label=item.text, @change { todos[index].done!! })
            }
        }
        ui.button(text="Remove", @click { todos.remove(todos.length - 1) }, style={alignItems=center})
    }
}
