import ui "sngl:ui"
import draw "sngl:ui/draw"

output {
    none { html }
}

ui.window {
    var radius = 50.0

    func circleStyle() => draw.CanvasStyle{
        fill = color{r=99, g=102, b=241, a=255},
        stroke = color{r=67, g=56, b=202, a=255},
        strokeWidth = 3.0,
    }

    func bgStyle() => draw.CanvasStyle{
        fill = color{r=248, g=250, b=252, a=255},
    }

    func gridStyle() => draw.CanvasStyle{
        stroke = color{r=203, g=213, b=225, a=255},
        strokeWidth = 1.0,
    }

    func labelStyle() => draw.CanvasStyle{
        fill = color{r=255, g=255, b=255, a=255},
        fontSize = 14.0,
        fontFamily = "sans-serif",
    }

    ui.vbox(style={gap=16px, padding=20px}) {
        ui.text(value="Canvas2D Demo", style={fontSize=22px, fontWeight=bold})

        draw.canvas(width=400px, height=280px) {
            draw.rect(x=0.0, y=0.0, w=400.0, h=280.0, style=bgStyle)

            draw.line(x1=0.0, y1=140.0, x2=400.0, y2=140.0, style=gridStyle)
            draw.line(x1=200.0, y1=0.0, x2=200.0, y2=280.0, style=gridStyle)

            draw.circle(cx=200.0, cy=140.0, r=radius, style=circleStyle)

            draw.canvasText(
                x=200.0 - radius * 0.5,
                y=145.0,
                content="r = {string(int(radius))}",
                style=labelStyle,
            )
        }

        ui.hbox(style={gap=8px}) {
            ui.button(text="Grow", @click { radius = radius + 10.0 })
            ui.button(text="Shrink", @click { radius = radius > 10.0 ? radius - 10.0 : radius })
        }

        ui.text(value="radius: {string(int(radius))}")

        ui.text(value="Shapes:", style={fontWeight=bold, marginTop=8px})

        draw.canvas(width=400px, height=120px) {
            draw.rect(x=0.0, y=0.0, w=400.0, h=120.0, style=bgStyle)

            draw.rect(
                x=20.0,
                y=20.0,
                w=80.0,
                h=80.0,
                style=draw.CanvasStyle{
                    fill = color{r=251, g=191, b=36, a=255},
                    stroke = color{r=217, g=119, b=6, a=255},
                    strokeWidth = 2.0,
                },
            )

            draw.ellipse(
                cx=200.0,
                cy=60.0,
                rx=60.0,
                ry=35.0,
                style=draw.CanvasStyle{
                    fill = color{r=52, g=211, b=153, a=255},
                    stroke = color{r=5, g=150, b=105, a=255},
                    strokeWidth = 2.0,
                },
            )

            draw.line(
                x1=320.0,
                y1=20.0,
                x2=380.0,
                y2=100.0,
                style=draw.CanvasStyle{
                    stroke = color{r=239, g=68, b=68, a=255},
                    strokeWidth = 4.0,
                },
            )

            draw.canvasText(
                x=20.0,
                y=115.0,
                content="rect",
                style=draw.CanvasStyle{fill=color{r=120, g=80, b=0, a=255}, fontSize=11.0},
            )

            draw.canvasText(
                x=165.0,
                y=115.0,
                content="ellipse",
                style=draw.CanvasStyle{fill=color{r=0, g=100, b=70, a=255}, fontSize=11.0},
            )

            draw.canvasText(
                x=330.0,
                y=115.0,
                content="line",
                style=draw.CanvasStyle{fill=color{r=180, g=30, b=30, a=255}, fontSize=11.0},
            )
        }
    }
}
