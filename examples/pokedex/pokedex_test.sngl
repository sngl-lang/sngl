func testSpritesLabelEveryPicture(t test.Test, c mouse) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.pictures().map(func(p Sprite) => p.label).join(", ") == "Front, Back, Shiny front, Shiny back, Female front, Female back, Shiny female front, Shiny female back, Official artwork, Shiny official artwork, Home, Shiny Home, Female Home, Shiny female Home")
    t.assert(c.detail.pictures()[5].url == "http://127.0.0.1:47819/dot.png?sprite=back/female/25.png")
    t.assert(c.detail.pictures()[9].url == "http://127.0.0.1:47819/dot.png?sprite=other/official-artwork/shiny/25.png")
    t.assert(c.detail.pictures()[13].url == "http://127.0.0.1:47819/dot.png?sprite=other/home/shiny/female/25.png")
    t.assert(c.detail.spriteLabel[1][0] == null)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(3)
    }
    t.assert(c.detail.spriteLabel[1][0] != null && c.detail.spriteLabel[1][0].value == "Female front")
    t.assert(c.detail.spriteLabel[3][1] != null && c.detail.spriteLabel[3][1].value == "Shiny female Home")
}

func testSpritesLeaveOutAFemaleTheyLack(t test.Test, c seed) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.pictures().map(func(p Sprite) => p.label).join(", ") == "Front, Back, Shiny front, Shiny back, Official artwork, Shiny official artwork, Home, Shiny Home")
    t.assert(c.detail.pictures()[4].url == "http://127.0.0.1:47819/dot.png?sprite=other/official-artwork/1.png")
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(3)
    }
    t.assert(c.detail.spriteLabel[1][0] != null && c.detail.spriteLabel[1][0].value == "Official artwork")
    t.assert(c.detail.spriteLabel[2][0] == null)
    t.assert(c.detail.forms().length() == 0)
}

