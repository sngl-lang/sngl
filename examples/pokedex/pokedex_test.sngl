import poke "openapi:./pokeapi.yml"
import test "sngl:test"
import ui "sngl:ui"

const local = "http://127.0.0.1:47819/examples/pokedex"

// The one picture the harness's server answers, for every card's artwork.
const dot = "http://127.0.0.1:47819/dot.png"

var opened = ""

component home ui.node {
    poke.server(local) {
        artwork(dot) {
            homePage #page(@open(n) { opened = n })
        }
    }
}

component aPage ui.node {
    poke.server(local) {
        detailPage #detail(name="ivysaur", @open(n) { opened = n })
    }
}

component chain ui.node {
    poke.server(local) {
        evolution #evo(species="ivysaur", @open(n) { opened = n })
    }
}

// Every recorded Pokédex, Pokémon, species and chain, each its own query, so a
// recording the document cannot decode leaves its `got` null.
component dexes ui.node {
    var list option[poke.PaginatedPokedexSummaryList] = null

    poke.server(local) {
        poke.pokedexList(limit=dexLimit, offset=0, :value=list)
        dex #national(name="national")
        dex #kanto(name="kanto")
        dex #johto(name="original-johto")
    }
}

component dex(name string) ui.node {
    var got option[poke.PokedexDetail] = null

    poke.pokedexRetrieve(id=name, :value=got)
}

component mons ui.node {
    poke.server(local) {
        mon #bulbasaur(name="bulbasaur")
        mon #ivysaur(name="ivysaur")
        mon #venusaur(name="venusaur")
        mon #charmander(name="charmander")
        mon #charmeleon(name="charmeleon")
        mon #eevee(name="eevee")
        mon #pikachu(name="pikachu")
        mon #vulpix(name="vulpix")
        mon #alola(name="vulpix-alola")
    }
}

component mon(name string) ui.node {
    var got option[poke.PokemonDetail] = null

    poke.pokemonRetrieve(id=name, :value=got)
}

component species ui.node {
    poke.server(local) {
        kind #bulbasaur(name="bulbasaur")
        kind #ivysaur(name="ivysaur")
        kind #venusaur(name="venusaur")
        kind #charmander(name="charmander")
        kind #charmeleon(name="charmeleon")
        kind #eevee(name="eevee")
        kind #pikachu(name="pikachu")
        kind #vulpix(name="vulpix")
    }
}

component kind(name string) ui.node {
    var got option[poke.PokemonSpeciesDetail] = null

    poke.pokemonSpeciesRetrieve(id=name, :value=got)
}

component chains ui.node {
    poke.server(local) {
        line #bulbasaur(id="1")
        line #charmander(id="2")
        line #pikachu(id="10")
        line #vulpix(id="15")
        line #eevee(id="67")
    }
}

component line(id string) ui.node {
    var got option[poke.EvolutionChainDetail] = null

    poke.evolutionChainRetrieve(id=id, :value=got)
}

func testHomeStartsAtTheNationalDex(t test.Test, c home) {
    t.wait(func() => c.page.dex != null, 5000)
    t.assert(c.page.dex != null && c.page.dex.name == "national")
    t.assert(c.page.chosen == "National")
    t.assert(c.page.about != null && c.page.about.value == "National · every region · 40 Pokémon")
    t.assert(c.page.visible()[0].pokemonSpecies.name == "bulbasaur")
}

func testTheSelectSwitchesTheDex(t test.Test, c home) {
    t.wait(func() => c.page.dex != null && c.page.dexes.length() == 3, 5000)
    if c.page.more != null {
        c.page.more.click()
    }
    t.assert(c.page.visible().length() == 40)
    c.page.dexPick.change("Kanto")
    t.wait(func() => c.page.dex != null && c.page.dex.name == "kanto", 5000)
    t.assert(c.page.dexName == "kanto")
    t.assert(c.page.visible().length() == 30)
    t.assert(c.page.about != null && c.page.about.value == "Kanto · Kanto · 40 Pokémon")
}

func testTheGridIsRowsOfThree(t test.Test, c home) {
    t.wait(func() => c.page.dex != null, 5000)
    t.assert(c.page.grid().length() == 10)
    t.assert(c.page.grid()[0].map(func(e poke.PokemonDexNumber) => number(e.entryNumber)).join(",") == "#001,#002,#003")
    t.assert(c.page.grid()[9].map(func(e poke.PokemonDexNumber) => e.pokemonSpecies.name).join(",") == "sandslash,nidoran-f,nidorina")
}

func testShowMoreAddsTheRest(t test.Test, c home) {
    t.wait(func() => c.page.dex != null, 5000)
    t.assert(c.page.visible().length() == 30)
    t.assert(c.page.more != null)
    if c.page.more != null {
        c.page.more.click()
    }
    t.assert(c.page.visible().length() == 40)
    t.assert(c.page.grid().length() == 14)
    t.assert(c.page.grid()[13].length() == 1)
    t.assert(c.page.more == null)
}

func testTheSearchCoversTheWholeDex(t test.Test, c home) {
    t.wait(func() => c.page.dex != null, 5000)
    c.page.searchBox.input("GGLY")
    t.assert(c.page.visible().map(func(e poke.PokemonDexNumber) => e.pokemonSpecies.name).join(",") == "jigglypuff,wigglytuff")
    t.assert(c.page.grid().length() == 1)
}

func testTheDetailPageLoadsByName(t test.Test, c aPage) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.mon != null && c.detail.mon.id == 2)
    t.assert(c.detail.mon != null && c.detail.mon.stats[0].baseStat == 60)
    t.assert(!c.detail.loading)
}

func testTheChainIsTwoRequestsBehind(t test.Test, c chain) {
    t.wait(func() => c.evo.chain != null, 5000)
    t.assert(c.evo.about != null && idOf(c.evo.about.evolutionChain.url) == "1")
    t.assert(c.evo.chain != null && stages(c.evo.chain.chain).join(",") == "bulbasaur,ivysaur,venusaur")
}

func testEveryDexDecodes(t test.Test, c dexes) {
    t.wait(func() => c.list != null && c.national.got != null && c.kanto.got != null && c.johto.got != null, 5000)
    t.assert(c.list != null && c.list.results.map(func(d poke.PokedexSummary) => d.name).join(",") == "national,kanto,original-johto")
    t.assert(c.national.got != null && c.national.got.region == null)
    t.assert(c.kanto.got != null && c.kanto.got.region != null && c.kanto.got.region.name == "kanto")
    t.assert(c.kanto.got != null && c.kanto.got.pokemonEntries.length() == 40)
    t.assert(c.johto.got != null && c.johto.got.pokemonEntries[0].pokemonSpecies.name == "chikorita")
}

func testEveryMonDecodes(t test.Test, c mons) {
    t.wait(func() => c.bulbasaur.got != null && c.ivysaur.got != null && c.venusaur.got != null && c.charmander.got != null && c.charmeleon.got != null && c.eevee.got != null && c.pikachu.got != null && c.vulpix.got != null && c.alola.got != null, 5000)
    t.assert(c.pikachu.got != null && c.pikachu.got.sprites.frontFemale != null)
    t.assert(c.bulbasaur.got != null && c.bulbasaur.got.sprites.frontFemale == null)
    t.assert(c.eevee.got != null && c.eevee.got.sprites.other.officialArtwork.frontShiny != null)
    t.assert(c.eevee.got != null && c.eevee.got.sprites.other.home.frontDefault != null)
    t.assert(c.alola.got != null && c.alola.got.types[0].type.name == "ice")
    t.assert(c.vulpix.got != null && c.vulpix.got.abilities[1].isHidden == true)
}

func testEverySpeciesDecodes(t test.Test, c species) {
    t.wait(func() => c.bulbasaur.got != null && c.ivysaur.got != null && c.venusaur.got != null && c.charmander.got != null && c.charmeleon.got != null && c.eevee.got != null && c.pikachu.got != null && c.vulpix.got != null, 5000)
    t.assert(c.eevee.got != null && c.eevee.got.genera[0].genus == "Evolution Pokémon")
    t.assert(c.pikachu.got != null && c.pikachu.got.genderRate == 4)
    t.assert(c.vulpix.got != null && c.vulpix.got.varieties[1].pokemon.name == "vulpix-alola")
    t.assert(c.bulbasaur.got != null && c.bulbasaur.got.eggGroups.length() == 2)
    t.assert(c.bulbasaur.got != null && c.bulbasaur.got.habitat != null && c.bulbasaur.got.habitat.name == "grassland")
}

func testEveryChainDecodes(t test.Test, c chains) {
    t.wait(func() => c.bulbasaur.got != null && c.charmander.got != null && c.pikachu.got != null && c.vulpix.got != null && c.eevee.got != null, 5000)
    t.assert(c.pikachu.got != null && stages(c.pikachu.got.chain).join(",") == "pichu,pikachu,raichu")
    t.assert(c.eevee.got != null && c.eevee.got.chain.evolvesTo.length() == 8)
    t.assert(c.vulpix.got != null && c.vulpix.got.chain.evolvesTo[0].evolutionDetails[0].item != null)
}

// Takes a component as every test here does: on html a group of tests that
// take none builds the package with no root, and a component built at run
// time in it has no setter for the prop a reactive `if` hands it.
func testNames(t test.Test, c home) {
    t.assert(display("mr-mime") == "Mr Mime")
    t.assert(idOf("http://127.0.0.1:47819/examples/pokedex/api/v2/evolution-chain/2/") == "2")
    t.assert(number(7) == "#007" && number(151) == "#151" && number(1025) == "#1025")
    t.assert(rows([1, 2, 3, 4, 5, 6, 7], 3).map(func(r list[int]) => r.length()).join(",") == "3,3,1")
    t.assert(artworkOf(`https://example.com/{id}.png`, "http://127.0.0.1:47819/examples/pokedex/api/v2/pokemon-species/25/") == "https://example.com/25.png")
}
