func testAboutIsEachSpecies(t test.Test, c mouse) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.gender != null && c.detail.gender.value == "50% male, 50% female")
    t.assert(c.detail.capture != null && c.detail.capture.value == "190")
