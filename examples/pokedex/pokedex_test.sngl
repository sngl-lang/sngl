    c.app.languagePick.change("Español")
    t.assert(c.app.language == "Español")
    t.wait(func() => c.app.homeList != null && c.app.homeList.about != null && c.app.homeList.about.value == "Nacional · todas las regiones · 40 Pokémon", 5000)
    t.assert(c.app.homeList != null && c.app.homeList.about != null && c.app.homeList.about.value == "Nacional · todas las regiones · 40 Pokémon")
    t.assert(c.app.homeList != null && c.app.homeList.searchBox.placeholder == "Buscar en esta Pokédex")
}

// Takes a component as every test here does: on html a group of tests that
// take none builds the package with no root, and a component built at run
// time in it has no setter for the prop a reactive `if` hands it.
func testNames(t test.Test, c home) {
    t.assert(display("mr-mime") == "Mr Mime")
    t.assert(idOf("http://127.0.0.1:47819/examples/pokedex/api/v2/evolution-chain/2/") == "2")
    t.assert(number(7) == "#007" && number(151) == "#151" && number(1025) == "#1025")
    t.assert(rows([1, 2, 3, 4, 5, 6, 7], 3).map(func(r list[int]) => r.length()).join(",") == "3,3,1")
    t.assert(artworkOf(`https://example.com/{id}.png`, "25") == "https://example.com/25.png")
    t.assert(genderOf(-1) == "Genderless" && genderOf(0) == "100% male, 0% female" && genderOf(8) == "0% male, 100% female")
    t.assert(oneLine(" a\nb\x0cc  d ") == "a b c d")
    var store map[string, list[Named]] = {}
    t.assert(statLabel("special-defense", store) == "Special Defense")
    var forms = [
        poke.PokemonSpeciesVariety{isDefault=false, pokemon=poke.PokemonSummary{name="castform-sunny", url=""}},
        poke.PokemonSpeciesVariety{isDefault=true, pokemon=poke.PokemonSummary{name="castform-normal", url=""}},
    ]
    t.assert(defaultVariety(forms, "castform") == "castform-normal")
    t.assert(defaultVariety([], "castform") == "castform")
    var trade = poke.EvolutionTriggerSummary{name="trade", url=""}
    var shed = poke.EvolutionTriggerSummary{name="shed", url=""}
    var coat = poke.ItemSummary{name="metal-coat", url=""}
    t.assert(triggerOf(poke.PokemonEvolution{trigger=trade, heldItem=coat}, store) == "holding Metal Coat, Trade")
    t.assert(triggerOf(poke.PokemonEvolution{trigger=trade, knownMove=poke.MoveSummary{name="ancient-power", url=""}}, store) == "knowing Ancient Power, Trade")
    t.assert(triggerOf(poke.PokemonEvolution{trigger=shed}, store) == "Shed")
    t.assert(evolutionStep([], store) == "")
    var stone = poke.EvolutionTriggerSummary{name="use-item", url=""}
    var thunder = poke.ItemSummary{name="thunder-stone", url=""}
    var alola = poke.PokemonFormSummary{name="raichu-alola", url=""}
    var both = [
        poke.PokemonEvolution{trigger=stone, item=thunder, isDefault=true, evolvedPokemonForm=alola},
        poke.PokemonEvolution{trigger=stone, item=poke.ItemSummary{name="moon-stone", url=""}, isDefault=true},
    ]
    t.assert(evolutionStep(both, store) == "Moon Stone")
    t.assert(formSteps(both, store).map(func(f FormStep) => "{f.form} {f.trigger}").join(",") == "raichu-alola Thunder Stone")
    t.assert(formName([], "Vulpix") == "Vulpix")
    var vulpixes = [
        poke.PokemonSpeciesVariety{isDefault=true, pokemon=poke.PokemonSummary{name="vulpix", url="https://pokeapi.co/api/v2/pokemon/37/"}},
        poke.PokemonSpeciesVariety{isDefault=false, pokemon=poke.PokemonSummary{name="vulpix-alola", url="https://pokeapi.co/api/v2/pokemon/10103/"}},
    ]
    t.assert(varietyId(vulpixes, "vulpix-alola", "37") == "10103" && varietyId(vulpixes, "vulpix-galar", "37") == "37")
    t.assert(otherVarieties(vulpixes, "vulpix").map(func(v poke.PokemonSpeciesVariety) => v.pokemon.name).join(",") == "vulpix-alola")
    var learnedIn = func(group string) => poke.PokemonMoveVersionGroup{levelLearnedAt=1, moveLearnMethod=poke.MoveLearnMethodSummary{name="level-up", url=""}, versionGroup=poke.VersionGroupSummary{name=group, url=""}}
    var tackle = [
        poke.PokemonMove{move=poke.MoveSummary{name="tackle", url=""}, versionGroupDetails=[learnedIn("red-blue"), learnedIn("firered-leafgreen"), learnedIn("scarlet-violet"), learnedIn("blue-japan")]},
    ]
    // blue-japan's id is the highest, and it came out first.
    t.assert(latestGroup([], tackle) == "scarlet-violet")
    t.assert(latestGroup(["red-blue", "yellow", "firered-leafgreen", "red-green-japan", "blue-japan"], tackle) == "firered-leafgreen")
    t.assert(latestGroup(["gold-silver", "crystal"], tackle) == "")
    t.assert(latestGroup([], [poke.PokemonMove{move=poke.MoveSummary{name="tackle", url=""}, versionGroupDetails=[learnedIn("champions"), learnedIn("a-game-to-come")]}]) == "a-game-to-come")
    t.assert(methodNamed("Machine") == "machine" && methodNamed("Nothing") == "level-up")
    t.assert(languageOf("fr_CA.UTF-8") == "fr" && languageOf("C") == "c")
    t.assert(pokeLanguages("ja-JP").join(",") == "ja,ja-hrkt,en" && pokeLanguages("pt-BR").join(",") == "en")
    t.assert(languageLabel("de-AT") == "Deutsch" && languageLabel("C.UTF-8") == "English" && localeLabeled("日本語") == "ja")
}

func testEveryNameDecodes(t test.Test, c named) {
    t.wait(func() => c.grass != null && c.overgrow != null && c.attack != null && c.plant != null && c.grassland != null && c.stone != null && c.doubleEdge != null, 5000)
    t.assert(c.grass != null && typeNamed(c.grass.names).length() == 6)
    t.assert(c.overgrow != null && abilityNamed(c.overgrow.names).length() == 6)
    // A stat and an egg group are named in kana alone of the two Japanese,
    // and a habitat in English, French and Spanish alone.
    t.assert(c.attack != null && statNamed(c.attack.names).length() == 5)
    t.assert(c.plant != null && eggGroupNamed(c.plant.names).length() == 5)
    t.assert(c.grassland != null && habitatNamed(c.grassland.names).length() == 3)
    t.assert(c.stone != null && itemNamed(c.stone.names).length() == 6)
    t.assert(c.doubleEdge != null && moveNamed(c.doubleEdge.names).length() == 6)
}
