func testTappingAFormOpensIt(t test.Test, c roam) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(3)
    }
    t.wait(func() => c.detail.variety[0].got != null, 5000)
    c.detail.variety[0].formLabel.click()
    t.assert(c.name == "vulpix" && c.form == "vulpix-alola")
    t.wait(func() => c.detail.mon != null && c.detail.mon.name == "vulpix-alola", 5000)
    t.assert(c.detail.forms().join(",") == "vulpix")
    // The card keeps the form it showed until the next answer arrives.
    t.wait(func() => c.detail.variety[0].formLabel.text == "Vulpix", 5000)
    c.detail.variety[0].formLabel.click()
    t.assert(c.name == "vulpix" && c.form == "")
}

func testAFormsPageIsTheForm(t test.Test, c alolan) {
    t.wait(func() => c.detail.shape != null, 5000)
    t.assert(c.detail.title != null && c.detail.title.value == "Alolan Vulpix")
    t.assert(c.detail.nationalNo != null && c.detail.nationalNo.value == "#037")
    t.assert(c.detail.types[0] != null && c.detail.types[0].value == "Ice")
    t.setContext(artwork, dotOf)
    t.assert(c.detail.picture() == "http://127.0.0.1:47819/dot.png?id=10103")
    t.assert(c.detail.pictures()[0].url == "http://127.0.0.1:47819/dot.png?sprite=10103.png")
}

// The Moves tab's rows, each its level and the move: "1 Tackle, 1 Growl", or
// the move alone where the way has no level.
func movesLine(rows list[MoveRow]) => rows.map(func(r MoveRow) => r.level == "" ? r.name : "{r.level} {r.name}").join(", ")

func testMovesAreByLevel(t test.Test, c seed) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(movesLine(c.detail.moveRows()) == "1 Tackle, 1 Growl, 3 Vine Whip, 6 Growth, 9 Leech Seed, 12 Razor Leaf, 15 Poison Powder, 15 Sleep Powder, 18 Seed Bomb, 21 Take Down, 24 Sweet Scent, 27 Synthesis, 30 Worry Seed, 33 Power Whip, 36 Solar Beam")
    t.assert(c.detail.moveTable == null)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(4)
    }
    t.assert(c.detail.moveTable != null)
    t.assert(c.detail.movesCount != null && c.detail.movesCount.value == "It learns 15 moves this way.")
}

// A move's row gives its type, power and accuracy once its answer arrives,
// and a power the move has none of as a dash: Growl deals no damage.
func testAMoveGivesItsTypePowerAndAccuracy(t test.Test, c seed) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(4)
    }
    // Tackle's and Growl's answers may be the last of the fifteen moves' to
    // arrive, and the table is drawn again for each.
    t.wait(func() => tackleAndGrowl(c.detail.moveRows()), 5000)
    t.assert(tackleAndGrowl(c.detail.moveRows()))
    // Each move's type is a badge in its own color.
    t.assert(c.detail.moveRows()[0].kindSlug == "normal" && typeColor(c.detail.moveRows()[0].kindSlug) == #a8a77a)
}

// Whether Bulbasaur's first two moves have arrived as the Moves tab gives
// them: Tackle a Normal move of 40 power, and Growl one of none.
func tackleAndGrowl(rows list[MoveRow]) bool {
    if rows.length() < 2 {
        return false
    }
    var tackle = rows[0]
    var growl = rows[1]
    return tackle.name == "Tackle" && tackle.kind == "Normal" && tackle.power == "40" && tackle.accuracy == "100" && growl.name == "Growl" && growl.kind == "Normal" && growl.power == "—" && growl.accuracy == "100"
}

// A type's badge carries PokéAPI's name for the type, which picks its
// color: the type's own, its name dark over a light one and white over the
// rest. No target hands a test the style a badge is drawn with.
func testATypesBadgeTakesItsKindsColor(t test.Test, c seed) {
    t.wait(func() => c.detail.types[0] != null && c.detail.types[1] != null, 5000)
    t.assert(c.detail.types[0] != null && c.detail.types[0].kind == "grass")
    t.assert(c.detail.types[1] != null && c.detail.types[1].kind == "poison")
    t.assert(typeColor("grass") == #7ac74c && typeInk("grass") == #ffffff)
    t.assert(typeColor("electric") == #f7d02c && typeInk("electric") == #222222)
    t.assert(typeColor("stellar") == #68a090)
}

func testTheSelectSwitchesTheMethod(t test.Test, c seed) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(4)
    }
    t.assert(c.detail.methodPick != null)
    if c.detail.methodPick != null {
        c.detail.methodPick.change("Machine")
    }
    t.assert(c.detail.method == "machine")
    t.wait(func() => movesLine(c.detail.moveRows()) == "Body Slam, Curse, Double-Edge, Rest, Seed Bomb, Solar Beam, Swords Dance, Take Down, Toxic", 5000)
    t.assert(movesLine(c.detail.moveRows()) == "Body Slam, Curse, Double-Edge, Rest, Seed Bomb, Solar Beam, Swords Dance, Take Down, Toxic")
    t.assert(c.detail.moveRows()[0].level == "")
    if c.detail.methodPick != null {
        c.detail.methodPick.change("Egg")
    }
    t.assert(movesLine(c.detail.moveRows()) == "Curse, Ingrain, Petal Dance, Toxic")
}

// The way chosen is PokéAPI's name, so the moves stay the machine's in
// another language, whose labels the old one's matches none of. The select's
// label follows the language by an effect keyed on the locale, which a
// test's t.setContext does not move on html or android.
func testTheMethodOutlivesALanguage(t test.Test, c seed) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(4)
    }
    if c.detail.methodPick != null {
        c.detail.methodPick.change("Machine")
    }
    t.setContext(i18n.locale, "fr")
    t.assert(c.detail.method == "machine")
    t.assert(c.detail.moveRows().length() == 9 && c.detail.moveRows()[0].level == "")
    t.assert(methodLabeled("machine") == "CT" && methodLabeled("egg") == "Œuf")
}

func testAMethodWithNoMoves(t test.Test, c seed) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(4)
    }
    if c.detail.methodPick != null {
        c.detail.methodPick.change("Tutor")
    }
    t.assert(c.detail.moveRows().length() == 0)
    t.assert(c.detail.movesCount != null && c.detail.movesCount.value == "It learns no moves this way.")
}

