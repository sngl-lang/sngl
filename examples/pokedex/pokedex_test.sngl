func testTheTabsSwitchToStats(t test.Test, c seed) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.flavor != null && c.detail.total == null)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(1)
    }
    t.assert(c.detail.tab == 1)
    t.assert(c.detail.flavor == null)
    t.assert(c.detail.total != null)
}

func testStatsTotalAndEffort(t test.Test, c seed) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(1)
    }
    t.assert(c.detail.base[0].value == "45" && c.detail.base[3].value == "65")
    t.assert(c.detail.base[6] == null)
    t.assert(c.detail.total != null && c.detail.total.value == "318")
    t.assert(c.detail.effort != null && c.detail.effort.value == "1 Sp. Atk")
}

func testStatsGiveEveryEffort(t test.Test, c bud) {
    t.wait(func() => c.detail.mon != null, 5000)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(1)
    }
    t.assert(c.detail.total != null && c.detail.total.value == "405")
    t.assert(c.detail.effort != null && c.detail.effort.value == "1 Sp. Atk, 1 Sp. Def")
}

// A chain's rows, each its stages and how each is reached, a row a line:
// "bulbasaur, ivysaur Lv. 16, venusaur Lv. 32".
func lineOf(row list[Stage]) => row.map(func(s Stage) => s.trigger == "" ? s.name : "{s.name} {s.trigger}").join(", ")

func testEvolutionIsTheChainByLevel(t test.Test, c seed) {
    t.wait(func() => c.detail.evolution != null, 5000)
    t.assert(c.detail.chainRows().length() == 1)
    t.assert(lineOf(c.detail.chainRows()[0]) == "bulbasaur, ivysaur Lv. 16, venusaur Lv. 32")
    t.assert(c.detail.chainRows()[0][2].id == "3")
}

func testEvolutionIsEachSpeciesChain(t test.Test, c flame) {
    t.wait(func() => c.detail.evolution != null, 5000)
    t.assert(c.detail.chainRows().length() == 1)
    t.assert(lineOf(c.detail.chainRows()[0]) == "charmander, charmeleon Lv. 16, charizard Lv. 36")
}

func testEvolutionByFriendshipAndStone(t test.Test, c mouse) {
    t.wait(func() => c.detail.evolution != null, 5000)
    t.assert(c.detail.chainRows().length() == 1)
    t.assert(lineOf(c.detail.chainRows()[0]) == "pichu, pikachu High Friendship, raichu Thunder Stone")
}

func testEvolutionShowsTheFirstDefaultDetail(t test.Test, c fox) {
    t.wait(func() => c.detail.evolution != null, 5000)
    t.assert(c.detail.chainRows().length() == 1)
    t.assert(lineOf(c.detail.chainRows()[0]) == "vulpix, ninetales Fire Stone")
}

func testABranchingChainIsRows(t test.Test, c fluff) {
    t.wait(func() => c.detail.evolution != null, 5000)
    t.assert(c.detail.chainRows().map(func(r list[Stage]) => lineOf(r)).join("; ") == "eevee, vaporeon Water Stone; eevee, jolteon Thunder Stone; eevee, flareon Fire Stone; eevee, espeon High Friendship, day; eevee, umbreon High Friendship, night; eevee, leafeon Leaf Stone; eevee, glaceon Ice Stone; eevee, sylveon High Friendship, knowing a Fairy move")
}

func testEvolutionTabShowsTheTriggers(t test.Test, c seed) {
    t.wait(func() => c.detail.evolution != null, 5000)
    t.assert(c.detail.trigger[0][1] == null)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(2)
    }
    t.assert(c.detail.trigger[0][1] != null && c.detail.trigger[0][1].value == "Lv. 16")
    t.assert(c.detail.trigger[0][2] != null && c.detail.trigger[0][2].value == "Lv. 32")
}

func testTappingAStageOpensIt(t test.Test, c walk) {
    t.wait(func() => c.detail.evolution != null, 5000)
    t.assert(c.detail.tabs != null)
    if c.detail.tabs != null {
        c.detail.tabs.change(2)
    }
    c.detail.step[0][1].open()
    t.assert(c.name == "ivysaur")
    t.wait(func() => c.detail.about != null && c.detail.about.name == "ivysaur", 5000)
    t.assert(c.detail.title != null && c.detail.title.value == "Ivysaur")
}

func testEveryDexDecodes(t test.Test, c dexes) {
    t.wait(func() => c.list != null && c.national.got != null && c.kanto.got != null && c.johto.got != null, 5000)
    t.assert(c.list != null && c.list.results.map(func(d poke.PokedexSummary) => d.name).join(",") == "national,kanto,original-johto")
    t.assert(c.national.got != null && c.national.got.region == null)
    t.assert(c.kanto.got != null && c.kanto.got.region != null && c.kanto.got.region.name == "kanto")
    t.assert(c.kanto.got != null && c.kanto.got.pokemonEntries.length() == 40)
    t.assert(c.johto.got != null && c.johto.got.pokemonEntries[0].pokemonSpecies.name == "chikorita")
}

func testEveryMonDecodes(t test.Test, c mons) {
    t.wait(func() => c.bulbasaur.got != null && c.ivysaur.got != null && c.venusaur.got != null && c.charmander.got != null && c.charmeleon.got != null && c.eevee.got != null && c.pikachu.got != null && c.vulpix.got != null && c.alola.got != null, 5000)
    t.assert(c.pikachu.got != null && c.pikachu.got.sprites.frontFemale != null)
    t.assert(c.bulbasaur.got != null && c.bulbasaur.got.sprites.frontFemale == null)
    t.assert(c.eevee.got != null && c.eevee.got.sprites.other.officialArtwork.frontShiny != null)
    t.assert(c.eevee.got != null && c.eevee.got.sprites.other.home.frontDefault != null)
    t.assert(c.alola.got != null && c.alola.got.types[0].type.name == "ice")
    t.assert(c.vulpix.got != null && c.vulpix.got.abilities[1].isHidden == true)
}

func testEverySpeciesDecodes(t test.Test, c species) {
    t.wait(func() => c.bulbasaur.got != null && c.ivysaur.got != null && c.venusaur.got != null && c.charmander.got != null && c.charmeleon.got != null && c.eevee.got != null && c.pikachu.got != null && c.vulpix.got != null, 5000)
    t.assert(c.eevee.got != null && c.eevee.got.genera[0].genus == "Evolution Pokémon")
    t.assert(c.pikachu.got != null && c.pikachu.got.genderRate == 4)
    t.assert(c.vulpix.got != null && c.vulpix.got.varieties[1].pokemon.name == "vulpix-alola")
    t.assert(c.bulbasaur.got != null && c.bulbasaur.got.eggGroups.length() == 2)
    t.assert(c.bulbasaur.got != null && c.bulbasaur.got.habitat != null && c.bulbasaur.got.habitat.name == "grassland")
}

func testEveryChainDecodes(t test.Test, c chains) {
    t.wait(func() => c.bulbasaur.got != null && c.charmander.got != null && c.pikachu.got != null && c.vulpix.got != null && c.eevee.got != null, 5000)
    t.assert(c.pikachu.got != null && evolutionRows(c.pikachu.got.chain)[0].map(func(s Stage) => s.name).join(",") == "pichu,pikachu,raichu")
    t.assert(c.eevee.got != null && c.eevee.got.chain.evolvesTo.length() == 8)
    t.assert(c.vulpix.got != null && c.vulpix.got.chain.evolvesTo[0].evolutionDetails[0].item != null)
}

// Takes a component as every test here does: on html a group of tests that
// take none builds the package with no root, and a component built at run
// time in it has no setter for the prop a reactive `if` hands it.
func testNames(t test.Test, c home) {
    t.assert(display("mr-mime") == "Mr Mime")
    t.assert(idOf("http://127.0.0.1:47819/examples/pokedex/api/v2/evolution-chain/2/") == "2")
    t.assert(number(7) == "#007" && number(151) == "#151" && number(1025) == "#1025")
    t.assert(rows([1, 2, 3, 4, 5, 6, 7], 3).map(func(r list[int]) => r.length()).join(",") == "3,3,1")
    t.assert(artworkOf(`https://example.com/{id}.png`, "25") == "https://example.com/25.png")
    t.assert(genderOf(-1) == "Genderless" && genderOf(0) == "100% male, 0% female" && genderOf(8) == "0% male, 100% female")
    t.assert(oneLine(" a\nb\x0cc  d ") == "a b c d")
    t.assert(statLabel("special-defense") == "Sp. Def" && statLabel("accuracy") == "Accuracy")
    var forms = [
        poke.PokemonSpeciesVariety{isDefault=false, pokemon=poke.PokemonSummary{name="castform-sunny", url=""}},
        poke.PokemonSpeciesVariety{isDefault=true, pokemon=poke.PokemonSummary{name="castform-normal", url=""}},
    ]
    t.assert(defaultVariety(forms, "castform") == "castform-normal")
    t.assert(defaultVariety([], "castform") == "castform")
    var trade = poke.EvolutionTriggerSummary{name="trade", url=""}
    var shed = poke.EvolutionTriggerSummary{name="shed", url=""}
    var coat = poke.ItemSummary{name="metal-coat", url=""}
    t.assert(triggerOf(poke.PokemonEvolution{trigger=trade, heldItem=coat}) == "holding Metal Coat, Trade")
    t.assert(triggerOf(poke.PokemonEvolution{trigger=trade, knownMove=poke.MoveSummary{name="ancient-power", url=""}}) == "knowing Ancient Power, Trade")
    t.assert(triggerOf(poke.PokemonEvolution{trigger=shed}) == "Shed")
    t.assert(evolutionStep([]) == "")
}
