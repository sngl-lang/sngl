import async "sngl:async"
import poke "openapi:./pokeapi.yml"
import ui "sngl:ui"

// Every Pokémon, `pageSize` names at a time: the request is keyed on
// `offset`, so "More" asks for the next page by moving it, and each page that
// arrives is appended to what is already shown. The search filters what has
// loaded; PokéAPI has no endpoint that searches.
component listPage(pageSize = 24, @open(name string)) ui.node {
    var offset = 0
    var names list[poke.PokemonSummary] = []
    var count = 0
    var loading = false
    var failure option[async.Failure] = null
    var search = ""

    // The loaded names the search matches.
    func matching() list[poke.PokemonSummary] {
        return names.filter(func(m poke.PokemonSummary) => string.contains(m.name, string.lower(search)))
    }

    poke.pokemonList(limit=pageSize, offset=offset, :pending=loading, :failure=failure, @load(page) {
        for var r = page.results {
            names.push(r)
        }
        count = page.count
    })

    ui.vbox(style={gap=8px, padding=8px}) {
        ui.input #searchBox(placeholder="Search the loaded names", :value=search)
        ui.text #shown(value="{names.length()} of {count}")
        if failure != null {
            ui.text(value="Could not load the list: {failure.message}")
        }
        ui.scroll(style={flex=1}) {
            ui.vbox(style={gap=4px}) {
                for var mon = matching() {
                    card(name=mon.name, @open { open(mon.name) })
                }
            }
        }
        if loading {
            ui.spinner(label="Loading")
        } else if names.length() < count {
            ui.button #more(text="More", @click { offset += pageSize })
        }
    }
}

// One Pokémon of the list. Each card asks for its own Pokémon, keyed on its
// name: the card is the key, so a card scrolled away by a search and back
// asks again, and nothing caches per argument.
component card(name string, @open()) ui.node {
    var mon option[poke.PokemonDetail] = null

    poke.pokemonRetrieve(id=name, :value=mon)

    ui.hbox(style={gap=8px, alignItems=center}) {
        if mon != null && mon.sprites.frontDefault != null {
            ui.image(alt=name, style={width=48px, height=48px}) {
                ui.remote(url=mon.sprites.frontDefault)
            }
        }
        ui.button(text=display(name), @click { open() })
        if mon != null {
            for var t = mon.types {
                ui.badge(value=t.type.name)
            }
        }
    }
}
