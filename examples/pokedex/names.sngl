import i18n "sngl:i18n"
import seq "sngl:seq"
import poke "openapi:./pokeapi.yml"

// The last segment of a PokéAPI resource URL, which is the resource's id:
// "https://pokeapi.co/api/v2/evolution-chain/1/" is "1". A summary names
// what it points at by URL alone, and an id is what the next request asks.
func idOf(url string) string {
    var parts = string.split(url, "/").filter(func(p string) => p != "")
    return parts[parts.length() - 1]
}

// A name as the games print it: "mr-mime" is "Mr Mime".
func display(name string) string {
    var words = string.split(name, "-")
    var out list[string] = []
    for var w = words {
        if string.length(w) > 0 {
            out.push(string.upper(string.substring(w, 0, 1)) + string.substring(w, 1, string.length(w)))
        }
    }
    return out.join(" ")
}

// One stage of an evolution chain as its card shows it: the species, its
// national number, and how the stage before becomes it ("" for the first).
struct Stage {
    name    string
    id      string
    trigger string
}

// An evolution chain as rows, one for each line from its first stage to a
// last: Bulbasaur's is one row of three, Eevee's eight rows of two.
func evolutionRows(link poke.EvolutionChainLink) list[list[Stage]] {
    return rowsFrom(link, Stage{name=link.species.name, id=idOf(link.species.url), trigger=""})
}

// The rows of the chain from `link` on, each starting at `here`, the stage
// `link` is.
func rowsFrom(link poke.EvolutionChainLink, here Stage) list[list[Stage]] {
    if link.evolvesTo.length() == 0 {
        return [[here]]
    }
    var out list[list[Stage]] = []
    for var next = link.evolvesTo {
        var step = Stage{name=next.species.name, id=idOf(next.species.url), trigger=evolutionStep(next.evolutionDetails)}
        for var rest = rowsFrom(next, step) {
            var row = [here]
            for var s = rest {
                row.push(s)
            }
            out.push(row)
        }
    }
    return out
}

// How a stage is reached, from the details of its link: the one marked
// default, or the first where none is. A link has several where games
// differ -- Leafeon by a Leaf Stone or a mossy rock -- and a regional form is
// a second default detail after the first.
func evolutionStep(details list[poke.PokemonEvolution]) string {
    var marked = details.filter(func(d poke.PokemonEvolution) => d.isDefault == true)
    if marked.length() > 0 {
        return triggerOf(marked[0])
    }
    return details.length() > 0 ? triggerOf(details[0]) : ""
}

// What an evolution asks, as the games say it: "Lv. 16", "Thunder Stone",
// "High Friendship, day". Each word is the app's own, to translate; an item,
// a type or a trigger is PokéAPI's name made readable.
func triggerOf(d poke.PokemonEvolution) string {
    var parts list[string] = []
    var level = d.minLevel
    if level != null {
        parts.push($"Lv. {level}")
    }
    var item = d.item
    if item != null {
        parts.push(display(item.name))
    }
    var held = d.heldItem
    if held != null {
        parts.push($"holding {display(held.name)}")
    }
    if d.minHappiness != null {
        parts.push($"High Friendship")
    }
    if d.minAffection != null {
        parts.push($"High Affection")
    }
    var moveType = d.knownMoveType
    if moveType != null {
        parts.push($"knowing a {display(moveType.name)} move")
    }
    var move = d.knownMove
    if move != null {
        parts.push($"knowing {display(move.name)}")
    }
    var time = d.timeOfDay
    if time != null && time != "" {
        parts.push(time == "day" ? $"day" : time == "night" ? $"night" : display(time))
    }
    if d.trigger.name == "trade" {
        parts.push($"Trade")
    }
    if parts.length() == 0 {
        return display(d.trigger.name)
    }
    var text = parts[0]
    for var p = parts.slice(1, parts.length()) {
        text = $"{text}, {p}"
    }
    return text
}

// Where a Pokémon's official artwork is, `{id}` standing for its national
// number. A test provides one with no `{id}` in it, so every picture is the
// one its server answers.
context #artwork(`https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/{id}.png`)

// The official artwork of the species numbered `id`, as `template` says where
// it is. A dex entry names its species by URL, whose last segment is the id.
func artworkOf(template string, id string) => string.replace(template, `{id}`, id)

// A number in a dex as the games print it: 7 is "#007".
func number(n int) string {
    var digits = "{n}"
    for string.length(digits) < 3 {
        digits = "0" + digits
    }
    return "#" + digits
}

// What PokéAPI gives in the reader's language out of `entries`, one per
// language or more -- a name, a genus, a game's description -- `text` of the
// last entry `language` says is in it, or `otherwise` where none is. Every
// name or text the app shows from PokéAPI is picked here; the reader's
// language is English until the app offers others.
func inLanguage[T any](entries list[T], language func(T) string, text func(T) string, otherwise string) string {
    var out = otherwise
    for var e = entries {
        if language(e) == "en" {
            out = text(e)
        }
    }
    return out
}

// A dex's name, or its own name made readable where it has none.
func dexTitle(names list[poke.PokedexName], name string) => inLanguage(names, func(n poke.PokedexName) => n.language.name, func(n poke.PokedexName) => n.name, display(name))

// `items` in rows of `width`, the last holding what is left: a grid, since a
// `Style` neither wraps a row nor lays out columns.
func rows[T any](items list[T], width int) list[list[T]] {
    var out list[list[T]] = []
    for var start = seq.step(0, items.length(), width) {
        out.push(items.slice(start, int.min(start + width, items.length())))
    }
    return out
}

// The Pokémon a species' page shows: its default variety, whose name is not
// always the species' -- the species deoxys is the Pokémon deoxys-normal.
func defaultVariety(varieties list[poke.PokemonSpeciesVariety], species string) string {
    for var v = varieties {
        if v.isDefault {
            return v.pokemon.name
        }
    }
    return species
}

// A species' name, or its own name made readable where it has none.
func speciesName(names list[poke.PokemonSpeciesName], name string) => inLanguage(names, func(n poke.PokemonSpeciesName) => n.language.name, func(n poke.PokemonSpeciesName) => n.name, display(name))

// What kind of Pokémon a species is: "Seed Pokémon".
func genusOf(genera list[poke.PokemonSpeciesGenus]) => inLanguage(genera, func(g poke.PokemonSpeciesGenus) => g.language.name, func(g poke.PokemonSpeciesGenus) => g.genus, "")

// A species' last description, the newest game's, on one line: the games
// break a description where their text box did, with newlines and form
// feeds.
func latestFlavor(entries list[poke.PokemonSpeciesFlavorText]) => oneLine(inLanguage(entries, func(e poke.PokemonSpeciesFlavorText) => e.language.name, func(e poke.PokemonSpeciesFlavorText) => e.flavorText, ""))

// `s` with every run of whitespace a single space, and none at either end.
func oneLine(s string) string {
    var spaced = s
    for var ws = ["\n", "\x0c", "\r", "\t"] {
        spaced = string.replace(spaced, ws, " ")
    }
    return string.split(spaced, " ").filter(func(w string) => w != "").join(" ")
}

// A length in metres.
unit length { m }

// A mass in kilograms.
unit mass { kg }

// A Pokémon's height, which PokéAPI gives in tenths of a metre.
func heightOf(decimetres int) length {
    return 1m * (float(decimetres) / 10.0)
}

// A Pokémon's weight, which PokéAPI gives in tenths of a kilogram.
func weightOf(hectograms int) mass {
    return 1kg * (float(hectograms) / 10.0)
}

// A Pokémon's abilities, a hidden one marked: "Overgrow, Chlorophyll (hidden)".
func abilitiesOf(abilities list[poke.PokemonAbility]) string {
    return abilities.map(func(a poke.PokemonAbility) => a.isHidden == true ? "{display(a.ability.name)} (hidden)" : display(a.ability.name)).join(", ")
}

// Names as the games print them, in a list: "Monster, Plant".
func namesOf(names list[string]) => names.map(func(n string) => display(n)).join(", ")

// The share of a species that is each gender, from its gender rate: how
// many eighths are female, or -1 for a species that has no gender.
func genderOf(rate int) string {
    if rate < 0 {
        return "Genderless"
    }
    var female = float(rate) * 12.5
    return "{100.0 - female}% male, {female}% female"
}

// A base stat's name as the games abbreviate it.
func statLabel(name string) string {
    return match name {
        "hp" => "HP"
        "attack" => "Attack"
        "defense" => "Defense"
        "special-attack" => "Sp. Atk"
        "special-defense" => "Sp. Def"
        "speed" => "Speed"
        else => display(name)
    }
}

// The sum of a Pokémon's base stats.
func statTotal(stats list[poke.PokemonStat]) int {
    var total = 0
    for var s = stats {
        total += s.baseStat
    }
    return total
}

// The effort values defeating a Pokémon gives: "1 Sp. Atk, 1 Sp. Def".
func effortOf(stats list[poke.PokemonStat]) string {
    var given = stats.filter(func(s poke.PokemonStat) => s.effort > 0)
    return given.map(func(s poke.PokemonStat) => "{s.effort} {statLabel(s.stat.name)}").join(", ")
}
