 "flavor_text_entries": [
  {
   "flavor_text": "Its long tail\nserves as a\nground to protect\fitself from its\nown high voltage\npower.",
   "language": {
    "name": "en",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/9/"
   },
   "version": {
    "name": "red",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/1/"
   }
  },
  {
   "flavor_text": "Il se protège des décharges grâce\nà sa queue qui dissipe l’électricité\ndans le sol.",
   "language": {
    "name": "fr",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/5/"
   },
   "version": {
    "name": "black",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/17/"
   }
  },
  {
   "flavor_text": "でんきが　たまってくると\nきんにくが　しげきされ　いつもより\nこうげきてきに　なってしまう。",
   "language": {
    "name": "ja-hrkt",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/1/"
   },
   "version": {
    "name": "x",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/23/"
   }
  },
  {
   "flavor_text": "Wenn es sich auflädt, zucken seine Muskeln\nund es wird aggressiver und kampflustiger.",
   "language": {
    "name": "de",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/6/"
   },
   "version": {
    "name": "x",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/23/"
   }
  },
  {
   "flavor_text": "Cuando se carga de electricidad, sus músculos se\ntensan y se vuelve más agresivo de lo normal.",
   "language": {
    "name": "es",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/7/"
   },
   "version": {
    "name": "x",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/23/"
   }
  },
  {
   "flavor_text": "電気が　たまってくると\n筋肉が　刺激され\nいつもより　攻撃的に　なってしまう。",
   "language": {
    "name": "ja",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/11/"
   },
   "version": {
    "name": "x",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/23/"
   }
  },
  {
   "flavor_text": "でんきぶくろが　からっぽに　なると\nしっぽを　まっすぐ　たてて\nくうきちゅうの　でんきを　あつめる。",
   "language": {
    "name": "ja-hrkt",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/1/"
   },
   "version": {
    "name": "shield",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/34/"
   }
  },
  {
   "flavor_text": "Si ses joues sont à court d’énergie, il lève la queue\net capte l’électricité contenue dans l’atmosphère.",
   "language": {
    "name": "fr",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/5/"
   },
   "version": {
    "name": "shield",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/34/"
   }
  },
  {
   "flavor_text": "Wenn der in seinen Backentaschen gespeicherte\nStrom leer ist, stellt es seinen Schweif auf, um\nElektrizität aus der Luft zu ziehen.",
   "language": {
    "name": "de",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/6/"
   },
   "version": {
    "name": "shield",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/34/"
   }
  },
  {
   "flavor_text": "Cuando ha descargado las bolsas de las mejillas,\nlevanta la cola y absorbe la carga eléctrica que\nhay en el ambiente.",
   "language": {
    "name": "es",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/7/"
   },
   "version": {
    "name": "shield",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/34/"
   }
  },
  {
   "flavor_text": "電気袋が　空っぽに　なると\nしっぽを　まっすぐ　立てて\n空気中の　電気を　集める。",
   "language": {
    "name": "ja",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/11/"
   },
   "version": {
    "name": "shield",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/34/"
   }
  },
  {
   "flavor_text": "It can discharge bursts of electricity exceeding 100,000 volts—\na single strike with that amount of power would incapacitate one\nof the Copperajah of my homeland.",
   "language": {
    "name": "en",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/9/"
   },
   "version": {
    "name": "legends-arceus",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/39/"
   }
  }
 ],
