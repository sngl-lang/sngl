 "flavor_text_entries": [
  {
   "flavor_text": "Very smart and\nvery vengeful.\nGrabbing one of\fits many tails\ncould result in a\n1000-year curse.",
   "language": {
    "name": "en",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/9/"
   },
   "version": {
    "name": "red",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/1/"
   }
  },
  {
   "flavor_text": "On raconte que ses neuf queues\ndétiennent un pouvoir mystique.\nIl peut vivre pendant mille ans.",
   "language": {
    "name": "fr",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/5/"
   },
   "version": {
    "name": "black",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/17/"
   }
  },
  {
   "flavor_text": "おうごんに　かがやく　たいもうと\n９ほんの　ながい　しっぽを　もつ。\n１０００ねんは　いきると　いわれる。",
   "language": {
    "name": "ja-hrkt",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/1/"
   },
   "version": {
    "name": "x",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/23/"
   }
  },
  {
   "flavor_text": "Es hat neun lange Schweife und sein Fell glänzt\ngülden. Man sagt, es soll 1 000 Jahre alt werden.",
   "language": {
    "name": "de",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/6/"
   },
   "version": {
    "name": "x",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/23/"
   }
  },
  {
   "flavor_text": "Tiene nueve colas y un pelaje de color dorado.\nDicen que este Pokémon llega a vivir 1000 años.",
   "language": {
    "name": "es",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/7/"
   },
   "version": {
    "name": "x",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/23/"
   }
  },
  {
   "flavor_text": "黄金に　輝く　体毛と\n９本の　長い　尻尾を　持つ。\n１０００年は　生きると　言われる。",
   "language": {
    "name": "ja",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/11/"
   },
   "version": {
    "name": "x",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/23/"
   }
  },
  {
   "flavor_text": "あたまがよくて　しゅうねんぶかい。\nふざけて　しっぽを　つかむと\n１０００ねん　たたられるという。",
   "language": {
    "name": "ja-hrkt",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/1/"
   },
   "version": {
    "name": "shield",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/34/"
   }
  },
  {
   "flavor_text": "Il est très intelligent et rancunier.\nQuiconque attrape une de ses queues se fera\nmaudire pour 1 000 ans.",
   "language": {
    "name": "fr",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/5/"
   },
   "version": {
    "name": "shield",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/34/"
   }
  },
  {
   "flavor_text": "Dieses Pokémon ist intelligent, aber rachsüchtig.\nWer zum Spaß einen seiner Schweife ergreift,\nkann sich einen tausendjährigen Fluch einhandeln.",
   "language": {
    "name": "de",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/6/"
   },
   "version": {
    "name": "shield",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/34/"
   }
  },
  {
   "flavor_text": "Muy inteligente y vengativo. Agarrar una de sus\ncolas podría traer 1000 años de mala suerte.",
   "language": {
    "name": "es",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/7/"
   },
   "version": {
    "name": "shield",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/34/"
   }
  },
  {
   "flavor_text": "頭が良くて　執念深い。\nふざけて　しっぽを　つかむと\n１０００年　たたられるという。",
   "language": {
    "name": "ja",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/11/"
   },
   "version": {
    "name": "shield",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/34/"
   }
  },
  {
   "flavor_text": "The coat of gleaming golden fur is quite magnificent.\nThis species is said to store sacred power in its nine long tails\nand to live for a millennium.",
   "language": {
    "name": "en",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/language/9/"
   },
   "version": {
    "name": "legends-arceus",
    "url": "http://127.0.0.1:47819/examples/pokedex/api/v2/version/39/"
   }
  }
 ],
