import i18n "sngl:i18n"
import settings "sngl:settings"
import nav "sngl:ui/nav"
import ui "sngl:ui"

// html is served by a Go program (--lang go): a detail page is
// /pokemon/{name}, a pattern a static site cannot serve.
output(name="Pokédex", icon="icon.svg", description="A Pokédex of PokéAPI's Pokémon, in five languages.") {
    go {
        html
        bubbletea(package="pokedex")
        fyne(package="pokedex")
        gtk4(package="pokedex")
    }
    kotlin {
        android(package="us.duckfam.sngl.pokedex", color="#dc0a2d")
    }
}

// Which species a detail page shows.
struct Mon {
    name string
}

// Which species a form's page shows, and which of its varieties: Alolan
// Vulpix is the species vulpix's Pokémon vulpix-alola.
struct Form {
    name string
    form string
}

// A language the app is offered in: its locale, and its name as its readers
// write it.
struct Language {
    locale string
    label  string
}

// The languages the app offers, each named in itself.
const languages = [
    Language{locale="en", label="English"},
    Language{locale="fr", label="Français"},
    Language{locale="de", label="Deutsch"},
    Language{locale="es", label="Español"},
    Language{locale="ja", label="日本語"},
]

// The label of the language of `locale`, English's where the app does not
// offer it.
func languageLabel(locale string) string {
    for var l = languages {
        if l.locale == languageOf(locale) {
            return l.label
        }
    }
    return languages[0].label
}

// The locale of the language labeled `label`, English's where none is.
func localeLabeled(label string) string {
    for var l = languages {
        if l.label == label {
            return l.locale
        }
    }
    return languages[0].locale
}

// The list and a page per Pokémon, and a page per form of one, under a
// choice of language that starts at the process's and is kept from one run to
// the next. A page is named below
// where it is written, so the detail page is written after the form's page,
// which its handler names, and before the list, whose handler names it; the
// stack starts at "/" wherever that is.
component Pokedex ui.node {
    var language = languageLabel(i18n.defaultLocale())

    // Opens the species' page, or its page showing a form where `form` is
    // one of its varieties.
    func show(name string, form string) {
        if form != "" {
            pages.go(variety, Form{name=name, form=form})
        } else {
            pages.go(detail, Mon{name=name})
        }
    }

    ui.vbox(style={gap=4px, flex=1}) {
        settings.kept(name="language", :value=language)
        ui.hbox(style={padding=8px}) {
            ui.select #languagePick(:value=language) {
                for var l = languages {
                    ui.choice(label=l.label)
                }
            }
        }
        i18n.locale(localeLabeled(language)) {
            nav.stack #pages {
                nav.page #variety(href=`/pokemon/{name}/{form}`, title="Pokémon", params=Form{name="vulpix", form="vulpix-alola"}) {
                    component content(p) {
                        detailPage(name=p.name, form=p.form, @back { pages.back() }, @open(name, form) { show(name, form) })
                    }
                }
                nav.page #detail(href=`/pokemon/{name}`, title="Pokémon", params=Mon{name="bulbasaur"}) {
                    component content(p) {
                        detailPage(name=p.name, @back { pages.back() }, @open(name, form) { show(name, form) })
                    }
                }
                nav.page #home(href="/", title="Pokédex") {
                    homePage #homeList(@open(name) { pages.go(detail, Mon{name=name}) })
                }
            }
        }
    }
}

ui.window #pokedex(title="Pokédex") {
    Pokedex()
}
