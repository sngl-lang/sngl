import async "sngl:async"
import i18n "sngl:i18n"
import poke "openapi:./pokeapi.yml"
import settings "sngl:settings"
import nav "sngl:ui/nav"
import ui "sngl:ui"

// html is served by a Go program (--lang go): a detail page is
// /pokemon/{name}, a pattern a static site cannot serve.
output(name="Pokédex", icon="icon.svg", description="A Pokédex of PokéAPI's Pokémon, in five languages.") {
    go {
        html
        bubbletea(package="pokedex")
        fyne(package="pokedex")
        gtk4(package="pokedex")
    }
    kotlin {
        android(package="us.duckfam.sngl.pokedex", color="#dc0a2d")
    }
}

// Which species a detail page shows.
struct Mon {
    name string
}

// Which species a form's page shows, and which of its varieties: Alolan
// Vulpix is the species vulpix's Pokémon vulpix-alola.
struct Form {
    name string
    form string
}

// A language the app is offered in: its locale, and its name as its readers
// write it.
struct Language {
    locale string
    label  string
}

// The languages the app offers, each named in itself.
const languages = [
    Language{locale="en", label="English"},
    Language{locale="fr", label="Français"},
    Language{locale="de", label="Deutsch"},
    Language{locale="es", label="Español"},
    Language{locale="ja", label="日本語"},
]

// The locale of the language the app offers for `locale` -- "fr_CA.UTF-8"
// is "fr" -- English's where it offers none, and the process's while the
// kept choice is still loading.
func offered(locale option[string]) string {
    var want = languageOf(locale != null ? locale : i18n.defaultLocale())
    for var l = languages {
        if l.locale == want {
            return l.locale
        }
    }
    return languages[0].locale
}

// The window: the list and a page per Pokémon, and a page per form of one,
// under a choice of language that starts at the process's and is kept from
// one run to the next. The window's menu chooses the language and the
// Pokédex, its bar is the page's title, and it goes back through the pages.
// A page is named below where it is written, so the detail page is written
// after the form's page, which its handler names, and before the list, whose
// handler names it; the stack starts at "/" wherever that is.
component Pokedex root {
    // The locale chosen, null until the kept one loads.
    var language option[string] = null
    var dexes list[poke.PokedexSummary] = []
    var dexesFailure option[async.Failure] = null

    // Opens the species' page, or its page showing a form where `form` is
    // one of its varieties.
    func show(name string, form string) {
        if form != "" {
            pages.go(variety, Form{name=name, form=form})
        } else {
            pages.go(detail, Mon{name=name})
        }
    }

    // Around the window, so its title and its menu are in the language too.
    i18n.locale(offered(language)) {
        ui.window #pokedex(title=pages.current.title, canGoBack=pages.canGoBack(), @back { pages.back() }) {
            component menu {
                ui.menuItem(label=$"Language") {
                    for var l = languages {
                        ui.menuItem(label=l.label, checked=l.locale == language, @select { language = l.locale })
                    }
                }
                ui.menuItem(label=$"Pokédex") {
                    // A menu holds no sign, so the failure is an item that
                    // asks again when chosen.
                    if dexesFailure != null {
                        ui.menuItem(label=couldNotLoadDexes(whyOf(dexesFailure)), @select { dexesFailure = null })
                    }
                    for var d = dexes {
                        ui.menuItem(label=display(d.name), checked=d.name == dexName, @select { chooseDex(d.name) })
                    }
                }
            }
            settings.kept(name="language", default=offered(null), :value=language)
            settings.kept(name="dexName", default="national", :value=dexName)
            if dexesFailure == null {
                poke.pokedexList(limit=dexLimit, offset=0, :failure=dexesFailure, @load(page) { dexes = page.results })
            }
            nav.stack #pages {
                nav.page #variety(
                    href = `/pokemon/{name}/{form}`,
                    title = "Pokémon",
                    params = Form{name="vulpix", form="vulpix-alola"},
                    titleOf = func(p Form) => display(p.name),
                ) {
                    component content(p) {
                        detailPage(name=p.name, form=p.form, @open(name, form) { show(name, form) })
                    }
                }
                nav.page #detail(href=`/pokemon/{name}`, title="Pokémon", params=Mon{name="bulbasaur"}, titleOf=func(p Mon) => display(p.name)) {
                    component content(p) {
                        detailPage(name=p.name, @open(name, form) { show(name, form) })
                    }
                }
                nav.page #home(href="/", title="Pokédex") {
                    homePage #homeList(@open(name) { pages.go(detail, Mon{name=name}) })
                }
            }
        }
    }
}

Pokedex()
