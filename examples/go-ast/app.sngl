output {
    go {
        fyne
    }
}

// import the go stdlib's AST package for direct usage of the AST types. 
// The language handler makes it so we don't need to redefine these in SNGL.
import "go://go/ast"

component main {
    var (
        source = "package main"
        file ast.File
        parseError = ""
        parse func(string)
    )

    vbox(style={gap=12, padding=16}) {
        text(value="Go AST Explorer", style={fontSize=24, fontWeight="bold"})
        text(value="Enter Go source code and click Parse to see the AST.")
        textarea(placeholder="Enter Go code...", rows=10, value=source, @input(e) { source = e.value })
        button(text="Parse AST", @click { parse(source) })
        if parseError != "" {
            text(value=parseError, style={color=#c62828})
        }
        vbox(style={gap=2}) {
            for decl = file.decls {
                text(value=decl, style={fontSize=13})
            }
        }
    }
}
