import . "sngl:ui"
import app "sngl:app"

output {
    none { html }
}

component main ui {
    var name = "World"

    vbox(style={gap=12, padding=16}) {
        text(value="Hello, {name}!", style={fontSize=24, fontWeight=bold})
        hbox(style={gap=8, alignItems=center}) {
            input(:value=name, placeholder="Enter your name")
        }
    }
}

app.window {
    main
}
