import ui "sngl:ui"

output {
    none { html }
}

ui.window {
    var name = "World"

    ui.vbox(style={gap=12, padding=16}) {
        ui.text(value="Hello, {name}!", style={fontSize=24, fontWeight=bold})
        ui.hbox(style={gap=8, alignItems=center}) {
            ui.input(:value=name, placeholder="Enter your name")
        }
    }
}
