// =====================================================================
// Learn SNGL in Y minutes
//
// SNGL is a declarative UI language that compiles to multiple platforms
// (HTML+JS, BubbleTea TUI, Fyne desktop, Android). One source -> many
// targets. The same file is a tutorial, a playground, and a portability
// test: every section below passes `sngl check` and runs on every
// platform listed in the `output` block.
//
// Read top to bottom. Each section introduces one feature with the
// smallest piece of working code that demonstrates it.
//
//     Project: https://sngl.dev   |   Source: git.duckfam.us/jonathan/sngl
// =====================================================================

import ui "sngl:ui"
import . "sngl:time"
import app "sngl:app"
import . "sngl:dialog"
import test "sngl:test"
import "sngl:i18n"

// ----- 1. Output -----------------------------------------------------
// `output` declares which (language, platform) pairs this file builds
// for. Each pair gets its own generated artifact.
output {
    none { html }
    go {
        bubbletea
        fyne
    }
    kotlin { android }
}

// ----- 2. Constants --------------------------------------------------
// Single const or grouped. Type optional when inferrable.
const APP_NAME = "SNGL Tour"

const (
    MAX_ITEMS = 100
    DEFAULT_USER = "guest"
    PI float = 3.14159
)

// ----- 3. Units ------------------------------------------------------
// User-defined dimensional types. Operations across compatible units
// auto-convert; mixing incompatible units is a type error.
//
//     1s + 500ms == 1500ms
//     2 * 3px    == 6px
//     1rem + 2em == 18em
unit duration { ms, s = 1000ms, m = 60s, h = 60m }
unit length { px, em, rem = 16em, vw, vh, pct }

// ----- 4. Structs ----------------------------------------------------
// Named struct with defaults. Fields without defaults must be provided
// at construction.
struct User {
    name string = ""
    age int = 0
    admin bool = false
}

// Anonymous structs are valid in any type position
// (param/return/var/field) — see `makeBadge` below.

// ----- 5. Enums ------------------------------------------------------
// Named enum, referenced as `Role.admin` or unqualified when context
// fixes the type.
enum Role { guest, member, admin }

// Inline enums are valid in type position too:
//     func ack(level enum { low, med, high }) { ... }

// ----- 6. Free functions --------------------------------------------
// Expression body: `func f(...) => expr`. Return type inferred.
func double(x int) => x * 2

// Block body: `func f(...) [Type] { ... }`. Return type required iff
// the function returns a value.
func factorial(n int) int {
    return n <= 1 ? 1 : n * factorial(n - 1)
}

// `func name(...) -> Type { ... }` is NOT valid syntax. The `->` arrow
// is reserved for func *type* expressions (e.g. `func(int) int`).

// Generic function. Type params after the name, inferred at call sites.
func identity<T>(x T) => x

// Generic with constraints come from operand: `xs.map(f)` binds T from
// xs's element type and U from f's return type.

// ----- 7. Function values & lambdas ---------------------------------
// `func(int) int` is a TYPE. Lambdas use the same `func(params) => ...`
// or `func(params) Type { ... }` syntax.
func apply(x int, f func(int) int) int {
    return f(x)
}
// Usage:  apply(3, func(n int) => n + 1)  // 4

// ----- 8. Anonymous struct in param position ------------------------
func makeBadge(b struct {
    label string
    count int
}) string {
    return "{b.label}: {b.count}"
}

// ----- 9. Child component with prop + event sink -------------------
// Components are declared at top level. Props live in the header.
// `@event` props let the parent receive events emitted by the child.
component LabeledCounter(label = "Clicks", start = 0, @changed) ui.node {
    var n = start

    ui.hbox(style={gap=8, alignItems="center"}) {
        ui.text(value="{label}: {n}")
        ui.button(text="+1", @click {
            n += 1
            changed(n) // emit upward
        })
    }
}

// ----- 10. Recursive components ------------------------------------
// Components can call themselves. Self-referencing struct fields use
// `dyn` so the type can refer to itself.
struct TreeNode {
    value int = 0
    left dyn = null
    right dyn = null
}

component TreeView(node dyn = null) ui.node {
    ui.vbox(style={paddingLeft=12, gap=2}) {
        ui.text(value=string(node.value))
        if node.left != null {
            TreeView(node=node.left)
        }
        if node.right != null {
            TreeView(node=node.right)
        }
    }
}

// ----- 11. i18n (translatable strings) ------------------------------
// `$"..."` marks a translatable string. ICU MessageFormat features:
//
//     plain        $"Hello"
//     interp       $"Hello, {name}"
//     plural       $"{n, plural, =0{none} one{# msg} other{# msgs}}"
//     selectord    $"{p, selectordinal, one{#st} two{#nd} few{#rd} other{#th}}"
//     select       $"{r, select, admin{Admin} other{User}}"
//     number       $"{p, number, currency}"
//     date         $"{d, date, long}"
//
// Translations live in `i18n.manifest.json` next to this file. The
// runtime picks a locale from LC_ALL / LC_MESSAGES / LANG (or the
// platform equivalent on Android).
component I18nDemo ui.node {
    var who = "World"
    var unread = 5
    var role = "admin"
    var price = 1234
    var party date = date("2026-05-09")

    ui.vbox(style={gap=4}) {
        ui.text(value=$"Welcome, {who}!")
        ui.text(value=$"You have {unread, plural,
            =0{no new messages}
            one{1 new message}
            other{# new messages}
        }.")
        ui.text(value=$"Role: {role, select,
            admin{Administrator}
            member{Member}
            other{Guest}
        }")
        ui.text(value=$"Ticket price: {price, number, currency}")
        ui.text(value=$"Party date: {party, date, long}")
    }
}

// ----- 12. Reactive context ----------------------------------------
// `context #name(default)` declares a value that flows down the tree
// without being threaded through every prop. Inside a window or
// component, `name(value) { ... }` provides a value for the subtree;
// any descendant reads it by referencing the bare name. Reads are
// reactive — when a provider's value expression changes, consumers
// below update.
//
// The stdlib `locale` context (used by i18n above) follows the same
// rules; `i18n.locale("xx-YY") { ... }` overrides the active locale for the
// nested subtree only.

context #theme("light")

component ThemedBox(label = "") ui.node {
    ui.text(value="{label}: {theme}", style={padding=8})
}

component ContextDemo ui.node {
    var dark = false
    ui.vbox(style={gap=4}) {
        ui.button(text="toggle theme", @click { dark = !dark })
        theme(dark ? "dark" : "light") {
            ThemedBox(label="outer")
            theme("high-contrast") {
                ThemedBox(label="inner (shadowed)")
            }
            ThemedBox(label="sibling")
        }
    }
}

// ----- 13. The main component: every feature wired up --------------
// State (`var`) is reactive: changing it re-runs computed funcs and
// patches the visual tree. The visual block below mirrors the original
// stdlib-component showcase; the language-feature sections cross-
// reference the relevant earlier section.
component main ui.node {
    // --- Primitive state (with explicit + inferred types) ---------
    var (
        count = 0
        name = "World"
        ratio float = 0.5
        darkMode = false
        showModal = false
        showDrawer = false
        selectedTab = 0
        selectedRadio = "medium"
        toggleOn = false
        selectedOption = ""
        notes = ""
        sliderVal float = 0
        animating = true
        birthday date = date("2000-01-01")
        clicks = 0
    )

    // --- Option / null (§4) --------------------------------------
    // `option<T>` allows null. Compare with `== null` / `!= null`.
    var nickname option<string> = null
    var pickedUser option<User> = null

    // --- Constants inside a component ----------------------------
    const PAGE_TITLE = "Component Showcase"

    // --- Lists & list methods (§ — generic methods) --------------
    var nums list<int> = [1, 2, 3, 4, 5]
    var labels list<string> = ["alpha", "beta", "gamma"]

    // --- Maps (literal disambiguated from struct by context) ----
    var scores map<string, int> = {alice=10, bob=20, carol=30}

    // --- Computed funcs: zero-arg funcs are reactive properties --
    // Reference them WITHOUT parens from interpolation or events:
    // `c.greeting`, not `c.greeting()`.
    func greeting() => "Hello, {name}!"
    func evens() => nums.filter(func(x int) => x % 2 == 0)
    func doubled() => nums.map(func(x int) => x * 2)
    func total() int {
        var sum = 0
        for var x = nums {
            sum = sum + x
        }
        return sum
    }
    func labelCount() => labels.length()

    // A map has no defined iteration order, so a view body may not loop one.
    // Walk it here instead and render the list that comes back.
    func scoreLines() list<string> {
        var lines list<string> = []
        for var k, v = scores {
            lines.push("{k} = {v}")
        }
        return lines
    }

    // --- Mutating methods (block form) ---------------------------
    func increment() { count += 1 }
    func reset() {
        count = 0
        name = "World"
    }

    // --- Timer drives the animated progress bar ------------------
    timer(interval=50ms, enabled=animating, @tick {
        sliderVal = sliderVal >= 1 ? 0 : sliderVal + 0.01
    })

    // --- A sample tree for the recursive component (§10) ---------
    var tree = TreeNode{
        value = 5,
        left = TreeNode{value=3, left=TreeNode{value=1}},
        right = TreeNode{value=8},
    }

    // ============================================================
    //                    VISUAL TREE BELOW
    // ============================================================
    ui.vbox(
        scroll=true,
        refreshing=false,
        @refresh { Alert.toast("Refreshed!", "info") },
        style={gap=24, maxWidth=900, padding=24},
    ) {
        // --- Heading ---------------------------------------------
        ui.text(value=APP_NAME, style={fontSize=32, fontWeight="bold"})
        ui.text(
            value="Every stdlib component + every language feature, one file.",
            style={color=#666666},
        )
        ui.divider

        // --- Text + button + computed (§ — `greeting` is computed) ---
        ui.text(value="Text & Button", style={fontSize=20, fontWeight="bold"})
        ui.hbox(style={alignItems="center", gap=12}) {
            ui.text(value=greeting, style={fontSize=18})
            ui.button(text="Increment", @click { count += 1 })
            ui.button(text="Reset", @click {
                count = 0
                name = "World"
            })
            ui.badge(value=string(count), style={background=#2196f3, color=#ffffff})
        }
        ui.divider

        // --- Input -----------------------------------------------
        ui.text(value="Input", style={fontSize=20, fontWeight="bold"})
        ui.hbox(style={gap=12}) {
            ui.input(
                placeholder="Enter your name",
                value=name,
                @input(e) { name = e.value },
            )
            ui.input(placeholder="Password", type="password")
            ui.input(placeholder="Search...", type="search")
        }
        ui.text(value="Textarea", style={fontSize=20, fontWeight="bold"})
        ui.textarea(
            placeholder="Write some notes...",
            rows=4,
            value=notes,
            @input(e) { notes = e.value },
        )
        ui.divider

        // --- Checkbox / Toggle / Radio (§ — `!!` flips a bool) ---
        ui.text(
            value="Checkbox, Toggle & Radio",
            style={fontSize=20, fontWeight="bold"},
        )
        ui.hbox(style={gap=24}) {
            ui.checkbox(
                checked=darkMode,
                label="Dark mode",
                @change { darkMode!! },
            )
            ui.toggle(checked=toggleOn, label="Notifications")
            ui.radio(
                direction="horizontal",
                options=["small", "medium", "large"],
                value=selectedRadio,
            )
        }
        ui.text(value="Select", style={fontSize=20, fontWeight="bold"})
        ui.select(
            options=["Apple", "Banana", "Cherry", "Date"],
            placeholder="Pick a fruit",
            value=selectedOption,
        )
        ui.divider

        // --- Progress / Spinner / Tabs ---------------------------
        ui.text(
            value="Progress & Spinner",
            style={fontSize=20, fontWeight="bold"},
        )
        ui.hbox(style={alignItems="center", gap=24}) {
            ui.progress(max=1, value=sliderVal)
            ui.spinner(label="Loading...")
        }
        ui.text(value="Tabs", style={fontSize=20, fontWeight="bold"})
        ui.tabs(items=["Overview", "Details", "Settings"], selected=selectedTab) {
            ui.text(value="This is the overview content.")
            ui.text(value="Here are the details.")
            ui.text(value="Settings would go here.")
        }
        ui.divider

        // --- Link / Chip / Avatar --------------------------------
        ui.text(value="Link & Chip", style={fontSize=20, fontWeight="bold"})
        ui.hbox(style={alignItems="center", gap=8}) {
            ui.link(href="https://sngl.dev", text="SNGL Website")
            ui.chip(label="Tag")
            ui.chip(label="Removable", removable=true)
            ui.chip(label="Success", variant="success")
        }
        ui.text(value="Avatar", style={fontSize=20, fontWeight="bold"})
        ui.hbox(style={gap=8}) {
            ui.avatar(initials="JD")
            ui.avatar(initials="AB", variant="square")
            ui.avatar(alt="User")
        }
        ui.divider

        // --- Card ------------------------------------------------
        ui.text(value="Card", style={fontSize=20, fontWeight="bold"})
        ui.hbox(style={gap=16}) {
            ui.card(variant="outlined") {
                ui.text(value="Outlined Card", style={fontWeight="bold"})
                ui.text(value="With a border")
            }
            ui.card(variant="elevated") {
                ui.text(value="Elevated Card", style={fontWeight="bold"})
                ui.text(value="With a shadow")
            }
            ui.card(variant="filled") {
                ui.text(value="Filled Card", style={fontWeight="bold"})
                ui.text(value="With a background")
            }
        }
        ui.divider

        // --- Modal / Drawer / Toast ------------------------------
        ui.text(value="Modal & Drawer", style={fontSize=20, fontWeight="bold"})
        ui.hbox(style={gap=12}) {
            ui.button(text="Open Modal", @click { showModal = true })
            ui.button(text="Open Drawer", @click { showDrawer = true })
            ui.button(
                text="Show Toast",
                @click { Alert.toast("Action completed!", "success") },
            )
        }
        ui.modal(closable=true, open=showModal, title="Example Modal") {
            ui.text(value="This is modal content.")
            ui.button(text="Close", @click { showModal = false })
        }
        ui.drawer(open=showDrawer, side="right") {
            ui.vbox(style={gap=12, padding=16}) {
                ui.text(value="Drawer Content", style={fontWeight="bold"})
                ui.text(value="Slide-out panel")
                ui.button(text="Close", @click { showDrawer = false })
            }
        }
        ui.divider

        // --- Tooltip / Split / Table / Tree ----------------------
        ui.text(value="Tooltip", style={fontSize=20, fontWeight="bold"})
        ui.tooltip(text="This is a tooltip") {
            ui.button(text="Hover me")
        }
        ui.text(value="Split View", style={fontSize=20, fontWeight="bold"})
        ui.splitview(direction="horizontal", style={height=120}) {
            ui.vbox(style={padding=12}) {
                ui.text(value="Left pane")
                ui.text(value="Resizable split")
            }
            ui.vbox(style={padding=12}) {
                ui.text(value="Right pane")
                ui.text(value="Side by side")
            }
        }
        ui.divider
        ui.text(value="Table", style={fontSize=20, fontWeight="bold"})
        ui.table(columns=["Name", "Role", "Status"])
        ui.text(value="Tree", style={fontSize=20, fontWeight="bold"})
        ui.tree(items=["Documents", "Photos", "Music", "Videos"])
        ui.divider

        // --- Menubar / Toolbar / DatePicker ----------------------
        ui.text(value="Menubar", style={fontSize=20, fontWeight="bold"})
        ui.menubar(items=["File", "Edit", "View", "Help"])
        ui.text(value="Toolbar", style={fontSize=20, fontWeight="bold"})
        ui.toolbar {
            ui.button(text="New")
            ui.button(text="Open")
            ui.button(text="Save")
            ui.spacer
            ui.button(text="Settings")
        }
        ui.divider
        ui.text(value="Date Picker", style={fontSize=20, fontWeight="bold"})
        ui.datepicker(placeholder="Select birthday", value=birthday)
        ui.divider

        // --- Composition: child component + event sink (§9) -----
        ui.text(
            value="Composition (child component emits event upward)",
            style={fontSize=20, fontWeight="bold"},
        )
        LabeledCounter(
            label="Clicks",
            start=0,
            @changed(n) { clicks = n },
        )
        ui.text(value="Parent saw clicks = {clicks}")
        ui.divider

        // --- Recursive component (§10) --------------------------
        ui.text(
            value="Recursive component (TreeView calls itself)",
            style={fontSize=20, fontWeight="bold"},
        )
        TreeView(node=tree)
        ui.divider

        // --- For-loops, if, list/map iteration ------------------
        ui.text(
            value="For-loops & if",
            style={fontSize=20, fontWeight="bold"},
        )
        ui.vbox(style={gap=4}) {
            // for with index + nested if-else (loop var deps only,
            // so the inner if doesn't allocate its own reactive slot).
            for var idx, n = nums {
                if n % 2 == 0 {
                    ui.text(value="{idx}: {n} (even)")
                } else {
                    ui.text(value="{idx}: {n} (odd)")
                }
            } else {
                ui.text(value="empty list")
            }
            ui.divider
            // simple iteration over a list of strings
            for var s = labels {
                ui.text(value="- {s}")
            }
            ui.divider
            // a map is walked in a function; the view renders its result
            for var line = scoreLines() {
                ui.text(value=line)
            }
        }
        ui.divider

        // --- Top-level if at component scope -------------------
        ui.text(
            value="If statement",
            style={fontSize=20, fontWeight="bold"},
        )
        if count > 0 {
            ui.text(value="count is positive: {count}")
        } else {
            ui.text(value="count is zero — press Increment")
        }
        ui.divider

        // --- Computed values pulling list methods (§ — generics) ---
        ui.text(
            value="Computed (filter/map/total)",
            style={fontSize=20, fontWeight="bold"},
        )
        ui.text(value="nums   = {nums}")
        ui.text(value="evens  = {evens}")
        ui.text(value="x2     = {doubled}")
        ui.text(value="total  = {total}")
        ui.divider

        // --- i18n showcase (§11) --------------------------------
        ui.text(value="i18n", style={fontSize=20, fontWeight="bold"})
        I18nDemo

        ui.divider

        // --- Reactive context (§12) -----------------------------
        ui.text(value="reactive context", style={fontSize=20, fontWeight="bold"})
        ContextDemo

        ui.divider(label="End of Tour")
    }
}

// ----- 14. Tests (kept minimal) -------------------------------------
// Any platform that implements the TestRunner interface can execute
// these. `go tool verify` runs them via the `none` interpreter; other
// platforms wire them into their own runners. See `internal/testutil`
// for the framework. Per-feature coverage lives in `testdata/`.

func testInitialCount(t test.Test, c main) {
    t.assert(c.count == 0)
}

func testGreetingDefault(t test.Test, c main) {
    t.assert(c.greeting == "Hello, World!")
}
