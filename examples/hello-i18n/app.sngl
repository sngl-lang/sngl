// Hello, world — internationalised.
//
// Exercises the three i18n MessageFormat features that need different
// translations to look right:
//
//   * select  — gendered honorific (Mr./Ms./Mx.) where many languages
//               also need to flip article/agreement on surrounding words.
//   * plural  — guest count, where French/Russian/Polish each split the
//               cases differently from English's "one / other" pair.
//   * number  — ticket price, locale-formatted as currency.
//
// Manifest: i18n.manifest.json next to this file. Translations included
// for English (manifest fallback), French, and Spanish.
//
// Note on shape: every translatable string is wrapped in a `var` and
// reassigned from event handlers. Direct `text(value=$"...")` is not
// yet wired through the html platform's reactive-text path, so the
// var-binding pattern is the working idiom today.

output {
    none { html }
    kotlin { android }
}

component main {
    var name = "Alice"
    var gender = "female"
    var guests = 1
    var price = 1234

    // Static labels — wrapped in vars so the html platform binds the
    // i18n.tr result to the DOM.
    var heading = i18n.tr("Party RSVP", {})
    var nameLabel = i18n.tr("Name", {})
    var honorificLabel = i18n.tr("Honorific", {})
    var guestsLabel = i18n.tr("Guests", {})
    var namePlaceholder = i18n.tr("Enter your name", {})
    var femaleLabel = i18n.tr("female", {})
    var maleLabel = i18n.tr("male", {})
    var otherLabel = i18n.tr("other", {})

    // Dynamic strings — recomputed from event handlers.
    var guestsDisplay = $"{guests, number}"
    var sentence = $"{gender, select, female{Ms.} male{Mr.} other{Mx.}} {name} is bringing {guests, plural, =0{no guests} one{# guest} other{# guests}} to the party."
    var priceLabel = $"Ticket price: {price, number, currency}"

    vbox(style={gap=16, padding=24, maxWidth=480}) {
        text(value=heading, style={fontSize=24, fontWeight=bold})

        vbox(style={gap=8}) {
            text(value=nameLabel)
            input(
                value=name,
                placeholder=namePlaceholder,
                @input(e) {
                    name = e.value
                    sentence = $"{gender, select, female{Ms.} male{Mr.} other{Mx.}} {name} is bringing {guests, plural, =0{no guests} one{# guest} other{# guests}} to the party."
                },
            )
        }

        vbox(style={gap=8}) {
            text(value=honorificLabel)
            hbox(style={gap=8}) {
                button(text=femaleLabel, @click {
                    gender = "female"
                    sentence = $"{gender, select, female{Ms.} male{Mr.} other{Mx.}} {name} is bringing {guests, plural, =0{no guests} one{# guest} other{# guests}} to the party."
                })
                button(text=maleLabel, @click {
                    gender = "male"
                    sentence = $"{gender, select, female{Ms.} male{Mr.} other{Mx.}} {name} is bringing {guests, plural, =0{no guests} one{# guest} other{# guests}} to the party."
                })
                button(text=otherLabel, @click {
                    gender = "other"
                    sentence = $"{gender, select, female{Ms.} male{Mr.} other{Mx.}} {name} is bringing {guests, plural, =0{no guests} one{# guest} other{# guests}} to the party."
                })
            }
        }

        vbox(style={gap=8}) {
            text(value=guestsLabel)
            hbox(style={gap=8, alignItems=center}) {
                button(text="-", @click {
                    guests = guests - 1
                    guestsDisplay = $"{guests, number}"
                    sentence = $"{gender, select, female{Ms.} male{Mr.} other{Mx.}} {name} is bringing {guests, plural, =0{no guests} one{# guest} other{# guests}} to the party."
                })
                text(value=guestsDisplay, style={minWidth=24, textAlign=center})
                button(text="+", @click {
                    guests = guests + 1
                    guestsDisplay = $"{guests, number}"
                    sentence = $"{gender, select, female{Ms.} male{Mr.} other{Mx.}} {name} is bringing {guests, plural, =0{no guests} one{# guest} other{# guests}} to the party."
                })
            }
        }

        text(
            value=sentence,
            style={fontSize=18, padding=12, background="#f5f5f5", borderRadius=8},
        )

        text(
            value=priceLabel,
            style={fontSize=14, color="#555"},
        )
    }
}
