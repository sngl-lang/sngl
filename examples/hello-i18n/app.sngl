// Hello, world — internationalised.
//
// Exercises the i18n MessageFormat features that need different
// translations to look right:
//
//   * select  — gendered honorific (Mr./Ms./Mx.) where many languages
//               also need to flip article/agreement on surrounding words.
//   * plural  — guest count, where French/Russian/Polish each split the
//               cases differently from English's "one / other" pair.
//   * number  — ticket price, locale-formatted as currency.
//   * date    — party date, locale-formatted long form.
//
// Manifest: i18n.manifest.json next to this file. Translations included
// for English (manifest fallback), French, and Spanish.

import . "sngl:ui"
import . "sngl:time"
import "sngl:i18n"
import app "sngl:app"

output {
    none { html }
    kotlin { android }
}

enum Gender { female, male, other }

component main ui {
    var name = "Alice"
    var gender Gender = Gender.female
    var guests = 1
    var price = 1234
    var partyDate date = date("2026-05-09")

    vbox(style={gap=16, padding=24, maxWidth=480}) {
        text(value=$"Party RSVP", style={fontSize=24, fontWeight=bold})

        vbox(style={gap=8}) {
            text(value=$"Name")
            input(
                value=name,
                placeholder=$"Enter your name",
                @input(e) { name = e.value },
            )
        }

        vbox(style={gap=8}) {
            text(value=$"Honorific")
            hbox(style={gap=8}) {
                button(text=$"female", @click { gender = Gender.female })
                button(text=$"male",   @click { gender = Gender.male })
                button(text=$"other",  @click { gender = Gender.other })
            }
        }

        vbox(style={gap=8}) {
            text(value=$"Guests")
            hbox(style={gap=8, alignItems=center}) {
                button(text="-", @click { guests = guests - 1 })
                text(value=$"{guests, number}", style={minWidth=24, textAlign=center})
                button(text="+", @click { guests = guests + 1 })
            }
        }

        text(
            value=$"{gender, select, female{Ms.} male{Mr.} other{Mx.}} {name} is bringing {guests, plural, =0{no guests} one{# guest} other{# guests}} to the party.",
            style={fontSize=18, padding=12, color=#111111, background="#f5f5f5", borderRadius=8},
        )

        text(
            value=$"Ticket price: {price, number, currency}",
            style={fontSize=14, color="#555"},
        )

        text(
            value=$"Party date: {partyDate, date, long}",
            style={fontSize=14, color="#555"},
        )
    }
}

app.window {
    main
}
